// An array literal no slot has typed yet takes its first element's type, and
// an element that does not fit it may still fit what a slot asks: `[[1, 2],
// [3]]` is two lists once a `List<List<int32>>` slot converts it. Such a
// mismatch waits for a slot, and is reported only if none settles the literal
// by the end of the body.

import kf_core.diagnostic.*
import kf_core.span.*

/// A mismatch inside the literal at `literal`, kept until a slot settles it.
@derive(Clone)
pub struct DeferredLiteral {
    pub val literal: Span
    pub val diagnostic: Diagnostic
}

impl TypeCtx {
    /// How many diagnostics have been reported so far.
    pub fun reported(): uint64 {
        return (*self.diags).size()
    }

    /// Moves what was reported since `mark` to wait on the literal at `literal`.
    pub mutating fun defer_since(mark: uint64, literal: Span): void {
        while i in mark..self.reported() {
            val diagnostic = (*self.diags).at(i).clone()
            self.deferred_literals.push(DeferredLiteral { literal: literal, diagnostic: diagnostic })
        }
        while self.reported() > mark { (*self.diags).pop() }
    }

    /// A slot retyped the literal at `literal`, so what it waited on is moot.
    pub mutating fun settle_literal(literal: Span): void {
        var kept = List.new<DeferredLiteral>()
        while deferred in &self.deferred_literals {
            if !deferred.literal.same_as(literal) { kept.push(deferred.clone()) }
        }
        self.deferred_literals = kept
    }

    /// Once, at the end of the body.
    pub mutating fun report_unsettled_literals(): void {
        val unsettled = self.deferred_literals.clone()
        while deferred in &unsettled { self.emit(deferred.diagnostic.clone()) }
    }
}
