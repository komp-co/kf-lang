import core.assert.assert_eq

import kf_core.span.*
import kf_core.ast.intern

/// Gives `table` a source map holding one file, and returns its id.
fun table_over(path: str, content: str, table: &var SigTable): uint32 {
    val smap: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *smap = new_source_map() }
    table.smap = smap
    return unsafe { smap.add_file(new_source_file(String.from(path), String.from(content))) }
}

@test
fun a_place_without_a_source_map_is_unknown(): void {
    val table = new_sig_table()
    val place = table.place_of(Span { file_id: 0, start: 0, end: 1 }, intern("app"))
    assert_eq(place.file_path.as_str(), "", "no file without a map")
}

@test
fun a_root_module_file_sits_in_src(): void {
    var table = new_sig_table()
    val file = table_over("/work/app/src/main.kf", "fun a(): void {}\n", &var table)
    val place = table.place_of(Span { file_id: file, start: 4, end: 5 }, intern("app"))
    assert_eq(place.file_path.as_str(), "src/main.kf", "the root module is src/")
}

@test
fun a_nested_module_file_sits_in_its_directories(): void {
    var table = new_sig_table()
    val file = table_over("/work/app/src/parse/lex/token.kf", "fun a(): void {}\n", &var table)
    val place = table.place_of(Span { file_id: file, start: 4, end: 5 }, intern("app.parse.lex"))
    assert_eq(place.file_path.as_str(), "src/parse/lex/token.kf", "one directory per module segment")
}

@test
fun a_place_names_the_line_of_its_span(): void {
    var table = new_sig_table()
    val file = table_over("/work/app/src/main.kf", "\n\nfun a(): void {}\n", &var table)
    val place = table.place_of(Span { file_id: file, start: 6, end: 7 }, intern("app"))
    assert_eq(place.line, 3, "the third line")
}
