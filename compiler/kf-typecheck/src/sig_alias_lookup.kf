// Calls through a module alias, and functions an export renamed.

import kf_core.ast.*

impl SigTable {
    /// The callee of a plain call, or of a call through a module alias when
    /// `through` is that alias's admission; the caller judges the latter's
    /// `pub`.
    pub fun lookup_callee(name: str, through: Sym, caller_file: uint32, caller_crate: CrateId,
        caller_module: Sym): FnSignature? {
        if through.id != 0 { return self.find_through_alias(name, through, caller_file) }
        return self.find_imported_signature(name, caller_file, caller_crate, caller_module)
    }

    /// In the aliased module, or in one it exports that name from.
    pub fun find_through_alias(name: str, admission: Sym, caller: uint32): FnSignature? {
        val narrowed_prefix = "${admission.as_str()} "
        while i in 0..self.caller_files.size() {
            if self.caller_files.get(i) == caller && i < self.imported_names.size() {
                val admitted = self.imported_names.get(i)
                // The whole module, or one name it exports, maybe renamed.
                var real = ""
                if admitted.id == admission.id {
                    real = String.from(name)
                } else if admitted.id != 0 && admitted.as_str().starts_with(narrowed_prefix.as_str()) {
                    val part = admitted.as_str().substring(narrowed_prefix.byte_len(), admitted.as_str().byte_len())
                    if admission_written(part.as_str()).as_str() == name { real = admission_real(part.as_str()) }
                }
                if real.as_str() != "" {
                    when (self.find_in_module(real.as_str(), self.imported_targets.get(i))) {
                        Some(sig) => return Option.Some(sig)
                        None => { }
                    }
                }
            }
        }
        return Option.None
    }

    /// A function an export renamed, by the name this file writes; `pub` only.
    pub fun find_renamed(written: str, caller: uint32): FnSignature? {
        while i in 0..self.caller_files.size() {
            // CONSTRAINT: poison (a wildcard) has no text, and an owned
            // temporary right of `&&` runs before its guard (#196).
            val entry_of_file = self.caller_files.get(i) == caller && i < self.imported_names.size()
            if entry_of_file && self.imported_names.get(i).id != 0 {
                val admitted = self.imported_names.get(i).as_str()
                val real = admission_real(admitted)
                if !admitted.starts_with("as ") && real.as_str() != written {
                    if admission_written(admitted).as_str() == written {
                        when (self.find_in_module(real.as_str(), self.imported_targets.get(i))) {
                            Some(sig) => { if sig.is_pub { return Option.Some(sig) } }
                            None => { }
                        }
                    }
                }
            }
        }
        return Option.None
    }

    /// Declared in `module`, whatever its visibility.
    pub fun find_in_module(name: str, module: Sym): FnSignature? {
        while s in &self.sigs {
            if s.name.as_str().equals(name) && s.owner_module.id == module.id { return Option.Some(s) }
        }
        return Option.None
    }

    /// The module an alias's admission names in the file's imports, or
    /// poison.
    pub fun alias_target(caller: uint32, admission: Sym): Sym {
        while i in 0..self.caller_files.size() {
            if self.caller_files.get(i) == caller && i < self.imported_names.size() {
                if self.imported_names.get(i).id == admission.id { return self.imported_targets.get(i) }
            }
        }
        return Sym { id: 0 }
    }
}
