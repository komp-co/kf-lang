// Calls through a module alias.

import kf_core.ast.declaration.DeclId
import kf_core.intern.*

impl SigTable {
    /// The callee of a plain call, or of a call through a module alias when
    /// `through` is that alias's admission; the caller judges the latter's
    /// `pub`. `written` is the declaration Resolve stamped on the call, if
    /// any.
    pub fun lookup_callee(name: str, through: Sym, written: DeclId?, caller_file: uint32, caller_crate: CrateId,
        caller_module: Sym): FnSignature? {
        if through.id != 0 {
            val aliased = self.find_through_alias(name, through, caller_file) ?: return null
            if self.hides_from(&aliased, caller_crate) { return null }
            return aliased
        }
        val sig = self.stamped_or_visible(name, written, caller_file, caller_crate, caller_module) ?: return null
        if self.hides_from(&sig, caller_crate) { return null }
        return sig
    }

    /// The signature of the declaration Resolve stamped, else the one the
    /// name means here; a stamped type has none.
    fun stamped_or_visible(name: str, written: DeclId?, caller_file: uint32, caller_crate: CrateId,
        caller_module: Sym): FnSignature? {
        when (written) {
            Some(d) => {
                when (self.sig_of_decl(d)) {
                    Some(sig) => return sig
                    None => { }
                }
            }
            None => { }
        }
        return self.find_imported_signature(name, caller_file, caller_crate, caller_module)
    }

    /// In the aliased module, or in one it exports that name from.
    pub fun find_through_alias(name: str, admission: Sym, caller: uint32): FnSignature? {
        if !self.has_scope() { return null }
        val decl = self.scope().through_alias(name, admission, caller) ?: return null
        return self.sig_of_decl(decl)
    }

    /// The module an alias's admission names in the file's imports, or
    /// poison.
    pub fun alias_target(caller: uint32, admission: Sym): Sym {
        if !self.has_scope() { return Sym { id: 0 } }
        return self.scope().alias_target(caller, admission)
    }
}
