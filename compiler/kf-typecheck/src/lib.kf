// Type checking: writes `Expr.ty` and returns the diagnostics found.

import alloc.list.*

import kf_core.diagnostic.*
import kf_core.ast.*
import kf_resolve.*
import kf_typecheck.check.unknown_bound_diags
import kf_typecheck.check.untyped_receiver_diags

pub mutating fun Module.typecheck_module(table: &var DeclTable): List<Diagnostic> {
    val null_files: Ptr<List<uint32>> = unsafe { 0 as Ptr<List<uint32>> }
    val null_ptr: Ptr<List<Sym>> = unsafe { 0 as Ptr<List<Sym>> }
    return typecheck_module_with_imports(self, table, null_files, null_ptr, null_ptr)
}

pub fun typecheck_module_with_imports(m: &var Module,
                                      table: &var DeclTable,
                                      caller_files: Ptr<List<uint32>>,
                                      imported_targets: Ptr<List<Sym>>,
                                      imported_names: Ptr<List<Sym>>): List<Diagnostic> {
    return typecheck_module_typed(m, table, caller_files, imported_targets, imported_names).diags
}

/// The signature table is where instance argument trees live, so rendering
/// `List<int32>` needs this one.
pub struct TypedModule {
    pub var diags: List<Diagnostic>
    pub var sigs:  Ptr<SigTable>
}

/// `typecheck_module` drops the table; tooling that renders types keeps it.
pub fun typecheck_module_typed(m: &var Module,
                               table: &var DeclTable,
                               caller_files: Ptr<List<uint32>>,
                               imported_targets: Ptr<List<Sym>>,
                               imported_names: Ptr<List<Sym>>): TypedModule {
    val diags = List.new<Diagnostic>()
    val diag_ptr: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *diag_ptr = diags }
    m.validate_annotations(diag_ptr)
    m.reject_colliding_no_mangle(diag_ptr)
    m.reject_duplicate_lang_items(diag_ptr)
    m.prepare_extensions(diag_ptr)
    // Before registration, so derived impls go through every later pass.
    m.expand_derives()
    val sigs = check_decl_module(m, table, diag_ptr, caller_files, imported_targets, imported_names)
    // A private type in a `pub` signature would be defined twice under C17.
    val exposed = m.pub_signature_diags()
    while item in &exposed {
        unsafe { diag_ptr.push(item) }
    }
    // After registration, so a trait declared later still counts.
    val bogus = unknown_bound_diags(sigs)
    while bogu in &bogus {
        unsafe { diag_ptr.push(bogu) }
    }
    // After every body, when every name has resolved.
    val unused = m.unused_import_diags(sigs)
    while item in &unused {
        unsafe { diag_ptr.push(item) }
    }
    // Same timing.
    val wildcards = m.wildcard_import_diags(sigs)
    while wildcard in &wildcards {
        unsafe { diag_ptr.push(wildcard) }
    }
    // Only when nothing else is wrong.
    val untyped = untyped_receiver_diags(sigs, unsafe { &*diag_ptr })
    while item in &untyped {
        unsafe { diag_ptr.push(item) }
    }
    return TypedModule { diags: without_duplicates(unsafe { *diag_ptr }), sigs: sigs }
}

/// A signature's types are resolved twice, at registration and in the body
/// pass, so its errors are found twice; the repeats are dropped.
fun without_duplicates(diags: List<Diagnostic>): List<Diagnostic> {
    var out = List.new<Diagnostic>()
    while d in &diags {
        if !diag_list_contains(&out, &d) { out.push(d) }
    }
    return out
}

fun diag_list_contains(seen: &List<Diagnostic>, d: &Diagnostic): bool {
    while prior in &seen {
        if prior.primary.span.file_id == d.primary.span.file_id {
            if prior.primary.span.start == d.primary.span.start {
                if prior.primary.span.end == d.primary.span.end {
                    if prior.primary.message.as_str().equals(d.primary.message.as_str()) { return true }
                }
            }
        }
    }
    return false
}
