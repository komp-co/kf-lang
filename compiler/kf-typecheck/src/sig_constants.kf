// Top-level `val`s. Each also registers a signature with no parameters, so
// imports and visibility find it the way they find a function.

import alloc.list.*

import kf_core.ast.expression.Expr
import kf_core.ast.types.Type
import kf_core.ast.declaration.TopDecl
import kf_core.intern.Sym

/// The typed literal a use of a top-level `val` becomes.
pub struct ConstantValue {
    pub val name: Sym
    pub val owner_module: Sym
    pub val value: Expr
}

impl SigTable {
    /// `value` is typed as `ty`, its declared type.
    pub mutating fun insert_constant(td: &TopDecl, is_pub: bool, ty: Type, value: Expr): void {
        self.constants.push(ConstantValue { name: td.name, owner_module: td.module_path, value: value })
        if td.is_internal { self.note_internal(td.module_path, td.name.as_str()) }
        self.note_decl_sig(td.decl, self.sigs.size())
        self.insert(FnSignature {
            name: td.name.as_string(), params: List.new<Type>(), ret: ty, generics: List.new<String>(),
            is_static: false, is_mutating: false, owner_module: td.module_path, owner_crate: td.crate,
            is_pub: is_pub, borrows: -1, is_prelude: false, is_extern: false
        })
    }

    /// The literal `sig` stands for, when it is a top-level `val`'s.
    pub fun constant_value(sig: &FnSignature): Expr? {
        while constant in &self.constants {
            if constant.name.as_str() == sig.name.as_str() && constant.owner_module.id == sig.owner_module.id {
                return constant.value.clone()
            }
        }
        return null
    }
}
