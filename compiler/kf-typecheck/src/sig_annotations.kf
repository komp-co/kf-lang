// Finding a user-declared annotation by the name a file writes for it.

import kf_core.intern.CrateId
import kf_core.intern.Sym
import kf_core.lang.AnnotationInfo

/// The annotation `name` as a declaration in `file`, in `crate`'s `module`,
/// sees it: one declared in its own module, a `pub` one its imports admit, or
/// a `pub` one in the prelude. The crate's own declarations shadow a
/// dependency's, and an imported one shadows the prelude's.
pub fun SigTable.find_annotation(name: str, file: uint32, crate: CrateId, module: Sym): uint64? {
    var found: uint64? = null
    var in_prelude: uint64? = null
    while i in 0..self.annotations.size() {
        val declared = self.annotations.at(i)
        if declared.name.as_str() != name { continue }
        // A module path starts with its crate's name, so this is the caller's
        // own module, a template's home module included.
        val own_module = declared.module.id == module.id
        val admitted = declared.is_pub && (!self.gate_visibility || self.file_admits(file, declared.module, name))
        if !own_module && !admitted {
            if declared.is_pub && declared.is_prelude && in_prelude == null { in_prelude = i }
            continue
        }
        if declared.crate.raw == crate.raw { return i }
        if found == null { found = i }
    }
    return if found != null { found } else { in_prelude }
}

/// Whether a use of `kind` is a built-in annotation: one the compiler
/// defines, unless a crate may declare it and the use sees a declaration.
pub fun SigTable.is_built_in_use(kind: str, file: uint32, crate: CrateId, module: Sym): bool {
    if !AnnotationInfo.is_known(kind) { return false }
    return !AnnotationInfo.may_be_declared(kind) || self.find_annotation(kind, file, crate, module) == null
}
