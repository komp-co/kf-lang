import core.assert.assert_eq
import alloc.list.*
import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.intern.intern
import kf_core.intern.CrateId
import kf_resolve.new_decl_table
import kf_typecheck.typecheck_module
import testing.test

fun plain_ref(name: str): TypeRef {
    return TypeRef.new(Span.none(), TypeRefKind.Named(intern(name), List.new<TypeRef>()))
}

fun ref_of(mutable: bool, inner: TypeRef): TypeRef {
    val boxed: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *boxed = inner }
    return TypeRef.new(Span.none(), TypeRefKind.Reference(mutable, boxed))
}

fun inst_ref(name: str, arg: TypeRef): TypeRef {
    var args = List.new<TypeRef>()
    args.push(arg)
    return TypeRef.new(Span.none(), TypeRefKind.Named(intern(name), args))
}

@test
fun str_is_a_borrow(): void {
    assert_eq(plain_ref("str").is_borrow(), true, "`str` borrows the bytes it points at")
}

@test
fun string_is_not_a_borrow(): void {
    assert_eq(plain_ref("String").is_borrow(), false, "`String` owns its buffer")
}

@test
fun both_reference_forms_are_borrows(): void {
    assert_eq((ref_of(false, plain_ref("int32"))).is_borrow(), true, "`&int32`")
    assert_eq((ref_of(true, plain_ref("int32"))).is_borrow(), true, "`&var int32`")
}

// `List<str>` is rejected; `List` itself is fine.
@test
fun a_container_is_not_itself_a_borrow(): void {
    assert_eq((inst_ref("List", plain_ref("str"))).is_borrow(), false, "`List<str>` is a struct")
}

fun diags_for_field(ty: TypeRef): uint64 {
    val ty_ptr: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ty_ptr = ty }
    var fields = List.new<Field>()
    fields.push(Field.new(Span.none(), String.from("slot"), ty_ptr, false, true))
    var declaration = TopDecl.new(Span.none(), String.from("Holder"), TopDeclKind.Struct(fields, false))
    declaration.crate = CrateId.new("application")
    var declarations = List.new<TopDecl>()
    declarations.push(declaration)
    var module = Module { crate: CrateId.new("application"), path: List.new<String>(), decls: declarations, imports: List.new<Import>() }
    var table = new_decl_table()
    // So the fixtures' types resolve.
    table.insert(String.from("List"))
    table.insert(String.from("Option"))
    table.insert(String.from("String"))
    return module.typecheck_module(&var table).size()
}

@test
fun a_str_field_is_rejected(): void {
    assert_eq(diags_for_field(plain_ref("str")) > 0, true, "a stored `str` outlives what it points at")
}

@test
fun a_reference_field_is_rejected(): void {
    assert_eq(diags_for_field(ref_of(false, plain_ref("int32"))) > 0, true, "a stored `&int32` has nothing bounding it")
}

@test
fun an_owning_field_is_accepted(): void {
    assert_eq(diags_for_field(plain_ref("int32")), 0, "an owned field is untouched by the rule")
}

// Box carries the borrow; Ptr is the escape hatch.
@test
fun a_boxed_borrow_field_is_rejected(): void {
    assert_eq(diags_for_field(inst_ref("Box", plain_ref("str"))) > 0, true, "`Box<str>` stores a borrow")
}

@test
fun a_pointer_field_is_accepted(): void {
    assert_eq(diags_for_field(inst_ref("Ptr", plain_ref("str"))), 0, "`Ptr<str>` is the unsafe escape hatch")
}

// A container argument is a storage position.
@test
fun a_container_of_borrows_field_is_rejected(): void {
    assert_eq(diags_for_field(inst_ref("List", plain_ref("str"))) > 0, true, "`List<str>` stores borrows")
}

@test
fun an_optional_borrow_field_is_rejected(): void {
    assert_eq(diags_for_field(inst_ref("Option", ref_of(false, plain_ref("int32")))) > 0, true, "`Option<&int32>` stores a borrow")
}

@test
fun a_container_of_owned_values_is_accepted(): void {
    assert_eq(diags_for_field(inst_ref("List", plain_ref("String"))), 0, "`List<String>` owns its elements")
}

@test
fun a_nested_container_of_borrows_is_rejected(): void {
    assert_eq(diags_for_field(inst_ref("List", inst_ref("Option", plain_ref("str")))) > 0, true, "`List<Option<str>>` stores borrows")
}

@test
fun a_borrow_under_a_pointer_is_accepted(): void {
    assert_eq(diags_for_field(inst_ref("List", inst_ref("Ptr", plain_ref("str")))), 0, "`List<Ptr<str>>` stays exempt")
}
