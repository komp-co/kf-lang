// A static call on a generic type with no written or inferable type
// arguments. Shares lib_test.kf's builders.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.diagnostic.*
import kf_core.intern.CrateId
import kf_core.intern.intern
import kf_resolve.new_decl_table
import kf_resolve.resolve_module
import testing.test

// struct Bag<T> { pub var n: uint64 }
fun mk_bag_decl(): TopDecl {
    var fields = List.new<Field>()
    fields.push(Field.new(Span.none(), String.from("n"), tref_p("uint64"), true, true))
    var td = TopDecl.new(Span.none(), String.from("Bag"), TopDeclKind.Struct(fields, true))
    var tps = List.new<TypeParam>()
    tps.push(TypeParam.new(Span.none(), String.from("T")))
    td.generics = tps
    return td
}

// impl Bag<T> { static fun make(): Bag<T> { return Bag<T> { n: 0 } } }
// No value argument to infer from.
fun mk_bag_impl(): TopDecl {
    var finits = List.new<FieldInit>()
    finits.push(FieldInit.new(Span.none(), String.from("n"), ep(ExprKind.LitInt(0))))
    var slit = Expr.new(Span.none(), ExprKind.StructLit(intern("Bag"), finits))
    var slit_targs = List.new<TypeRef>()
    slit_targs.push(tref_v("T"))
    slit.type_args = slit_targs
    val slit_p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *slit_p = slit }
    var mbody = List.new<Stmt>()
    mbody.push(Stmt.new(Span.none(), StmtKind.Return(ret_op(slit_p))))
    val mk = TopDecl.new(Span.none(), String.from("make"), TopDeclKind.Function(List.new<Param>(), tref_p_generic("Bag", "T"), mbody, true, false, false, true))
    var methods = List.new<TopDecl>()
    methods.push(mk)
    var td = TopDecl.new(Span.none(), String.from("Bag"), TopDeclKind.ImplBlock(methods))
    var tps = List.new<TypeParam>()
    tps.push(TypeParam.new(Span.none(), String.from("T")))
    td.generics = tps
    return td
}

fun bag_module(main_body: List<Stmt>): Module {
    val main_td = TopDecl.new(Span.none(), String.from("main"), TopDeclKind.Function(List.new<Param>(), tref_p("void"), main_body, true, false, false, false))
    var m = Module { crate: CrateId.new_poison(), path: List.new<String>(), decls: List.new<TopDecl>(), imports: List.new<Import>() }
    m.decls.push(mk_bag_decl())
    m.decls.push(mk_bag_impl())
    m.decls.push(main_td)
    return m
}

fun bag_make_call(): Ptr<Expr> {
    return ep(ExprKind.MethodCall(ep(ExprKind.Variable(intern("Bag"))), intern("make"), List.new<Expr>()))
}

// `val b = Bag.make()` is reported.
@test fun an_open_generic_static_call_is_reported(): void {
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.LetVal(intern("b"), null, bag_make_call())))
    var m = bag_module(body)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size() >= 1, true, "an un-inferred receiver type argument is an error")
    assert_eq(diag_mentions(&diags, "cannot tell what `Bag.make()` is over"), true, "the error names the call")
    assert_eq(diag_mentions(&diags, "annotate the binding"), true, "and both repairs")
}

// `val b: Bag<int32> = Bag.make()` takes the slot's arguments.
@test fun a_slot_types_an_open_generic_static_call(): void {
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.LetVal(intern("b"), tref_p_generic("Bag", "int32"), bag_make_call())))
    var m = bag_module(body)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val diags = m.typecheck_module(&var table)
    assert_eq(diags.size(), 0, "the slot supplies the receiver's type argument")
}
