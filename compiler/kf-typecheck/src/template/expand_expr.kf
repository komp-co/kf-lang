// A template's expressions and types for one struct or enum: `T` becomes
// the type, each fact a literal, and `field.of(x)` the field read from `x`. Inside a member loop an
// expression takes the field's span, so an error in it points at the field;
// a variable keeps its own, which the checker keys a binding's uses on.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.new_param

fun TypeRef.expanded_type(x: &var Expansion): TypeRef {
    when (self.kind) {
        Named(name, args) => {
            if name.id == x.marked.id && args.size() == 0 {
                return TypeRef.new(self.span, TypeRefKind.Named(x.type_name, List.new<TypeRef>()))
            }
            return TypeRef.new(self.span, TypeRefKind.Named(x.built(name, self.span), expanded_types(&args, x)))
        }
        Projection(owner, member) => {
            val bound = owner.bound_member(x)
            if bound != null && member.as_str() == "type" && !x.on_enum { return x.fields.at(bound ?: 0).ty.clone() }
            val payload = owner.bound_payload(x)
            if member.as_str() == "type" && payload != null {
                val found = payload ?: return TypeRef.new_poison(self.span)
                return x.fields.at(found.member).payloads.at(found.payload ?: 0).clone()
            }
            return TypeRef.new(self.span, TypeRefKind.Projection(Box.new(owner.expanded_type(x)), member))
        }
        DynTrait(name, args) => return TypeRef.new(self.span, TypeRefKind.DynTrait(name, expanded_types(&args, x)))
        Function(params, ret) => {
            val result = Box.new(ret.expanded_type(x))
            return TypeRef.new(self.span, TypeRefKind.Function(expanded_types(&params, x), result))
        }
        Reference(is_mutable, inner) => {
            return TypeRef.new(self.span, TypeRefKind.Reference(is_mutable, Box.new(inner.expanded_type(x))))
        }
        Array(element, count) => {
            return TypeRef.new(self.span, TypeRefKind.Array(Box.new(element.expanded_type(x)), count))
        }
        Value(v) => return TypeRef.new(self.span, TypeRefKind.Value(v))
        Poison => return TypeRef.new_poison(self.span)
    }
}

/// The field a bare binder in type position stands for, or null.
fun TypeRef.bound_member(x: &Expansion): uint64? {
    return when (self.kind) {
        Named(written, args) => if args.size() == 0 { x.member_of(written) } else { null }
        _ => null
    }
}

/// The payload a bare binder in type position stands for, or null.
fun TypeRef.bound_payload(x: &Expansion): Bound? {
    return when (self.kind) {
        Named(written, args) => if args.size() == 0 { x.payload_of(written) } else { null }
        _ => null
    }
}

fun expanded_types(types: &List<TypeRef>, x: &var Expansion): List<TypeRef> {
    var out = List.new<TypeRef>()
    while ty in &types {
        out.push(ty.expanded_type(x))
    }
    return out
}

fun Expr.expanded(x: &var Expansion): Expr {
    var out = self.expanded_kind(x)
    out.type_args = expanded_types(&out.type_args, x)
    val keeps_span = when (out.kind) {
        Variable(_name) => true
        _ => false
    }
    if x.in_member() && !keeps_span { return out.moved_to(x.field().span) }
    return out
}

/// The same expression, written at `span`.
fun Expr.moved_to(span: Span): Expr {
    var out = Expr.new(span, self.kind.clone())
    out.name_span = self.name_span
    out.coerce = self.coerce
    out.type_args = self.type_args.clone()
    out.type_args_written = self.type_args_written
    out.is_static_call = self.is_static_call
    out.is_safe_call_value = self.is_safe_call_value
    out.is_variant_ctor = self.is_variant_ctor
    return out
}

fun Expr.rekinded(kind: ExprKind): Expr {
    var out = self.clone()
    out.kind = kind
    return out
}

/// A fact's value in place of the expression asking for it, which may have
/// named an annotation in `<...>`.
fun Expr.fact(kind: ExprKind): Expr {
    var out = self.rekinded(kind)
    out.type_args = List.new<TypeRef>()
    return out
}

fun Expr.expanded_kind(x: &var Expansion): Expr {
    when (self.kind) {
        Variable(name) => return self.expanded_name(name, x)
        FieldAccess(owner, member) => return self.expanded_access(&*owner, member, x)
        MethodCall(receiver, method, args) => {
            if receiver.is_variable(x.marked) && method.as_str() == "build" && !x.on_enum {
                return self.built_struct(&args, x)
            }
            val listed = self.field_list_call(&*receiver, method.as_str(), &args, x)
            if listed != null { return listed ?: self.clone() }
            val fact = self.member_fact(&*receiver, method, &args, x)
            if fact != null { return fact ?: self.clone() }
            val called = x.built(method, self.span)
            return self.rekinded(ExprKind.MethodCall(Box.new(receiver.expanded(x)), called, expanded_exprs(&args, x)))
        }
        Binary(left, op, right) => {
            return self.rekinded(ExprKind.Binary(Box.new(left.expanded(x)), op, Box.new(right.expanded(x))))
        }
        Unary(op, inner) => return self.rekinded(ExprKind.Unary(op, Box.new(inner.expanded(x))))
        Deref(inner) => return self.rekinded(ExprKind.Deref(Box.new(inner.expanded(x))))
        Call(name, args) => return self.rekinded(ExprKind.Call(x.built(name, self.span), expanded_exprs(&args, x)))
        Intrinsic(intrinsic, args) => return self.rekinded(ExprKind.Intrinsic(intrinsic, expanded_exprs(&args, x)))
        CallValue(callee, args) => {
            return self.rekinded(ExprKind.CallValue(Box.new(callee.expanded(x)), expanded_exprs(&args, x)))
        }
        IfExpr(condition, then_value, else_value) => {
            val decided = condition.expanded(x)
            val chosen = decided.decided_bool()
            if chosen != null {
                val taken = chosen ?: false
                return if taken { then_value.expanded(x) } else { else_value.expanded(x) }
            }
            val then_out = Box.new(then_value.expanded(x))
            return self.rekinded(ExprKind.IfExpr(Box.new(decided), then_out, Box.new(else_value.expanded(x))))
        }
        WhenExpr(subject, arms) => {
            val decided = subject.expanded(x)
            val arm = decided.decided_arm(&arms)
            if arm != null {
                val index = arm ?: 0
                return self.rekinded(ExprKind.Block(expand_stmts(&arms.at(index).body, x)))
            }
            return self.rekinded(ExprKind.WhenExpr(Box.new(decided), expanded_arms(&arms, x)))
        }
        StructLit(name, inits) => {
            val written = if name.id == x.marked.id { x.type_name } else { x.built(name, self.span) }
            var out = List.new<FieldInit>()
            while init in &inits {
                val field = x.built(init.name, init.span)
                out.push(FieldInit { span: init.span, name: field, value: Box.new(init.value.expanded(x)) })
            }
            return self.rekinded(ExprKind.StructLit(written, out))
        }
        Cast(inner, ty) => return self.rekinded(ExprKind.Cast(Box.new(inner.expanded(x)), Box.new(ty.expanded_type(x))))
        Lambda(params, body) => {
            return self.rekinded(ExprKind.Lambda(expanded_params(&params, x), expand_stmts(&body, x)))
        }
        Block(stmts) => return self.rekinded(ExprKind.Block(expand_stmts(&stmts, x)))
        _ => return self.clone()
    }
}

/// `T` names the type; the member loop's binder is only for facts.
fun Expr.expanded_name(name: Sym, x: &var Expansion): Expr {
    if name.id == x.marked.id { return self.rekinded(ExprKind.Variable(x.type_name)) }
    if x.binding(name) != null {
        val word = if x.payload_of(name) != null { "payload" } else { x.member_word() }
        val facts = "`${name.as_str()}.name`, `.index`, `.has<A>()` or `.get<A>()`"
        val read = "`${name.as_str()}.of(x)`"
        val only = "`${name.as_str()}` is a ${word} only at compile time"
        x.report(self.span, "${only}: use ${facts}, or read it with ${read}")
        return self.fact(ExprKind.Poison)
    }
    return self.rekinded(ExprKind.Variable(x.built(name, self.span)))
}

fun Expr.expanded_access(owner: &Expr, member: Sym, x: &var Expansion): Expr {
    if owner.is_variable(x.marked) {
        if member.as_str() == "name" { return self.fact(ExprKind.LitStr(x.type_name.as_string())) }
        if member.as_str() == x.members_name() {
            val uses = "loop over it, or `map`, `filter`, `all`, `any` or `size()` it"
            x.report(self.span, "`T.${x.members_name()}` is a list only at compile time: ${uses}")
            return self.fact(ExprKind.Poison)
        }
    }
    val payload = owner.bound_payload(x)
    if payload != null {
        val found = payload ?: return self.clone()
        return self.payload_access(&found, member, x)
    }
    val bound = owner.bound_member(x)
    if bound != null {
        val field = x.fields.at(bound ?: 0)
        if member.as_str() == "name" { return self.fact(ExprKind.LitStr(field.name.as_string())) }
        if member.as_str() == "index" { return self.fact(ExprKind.LitInt(field.index as int64)) }
        if member.as_str() == "line" { return self.fact(ExprKind.LitInt(field.line as int64)) }
        val last = if x.on_enum { "payloads" } else { "type" }
        val facts = "`name`, `index`, `line` and `${last}`"
        if x.on_enum && member.as_str() == "payloads" {
            val uses = "loop over it, or `map`, `filter`, `all`, `any` or `size()` it"
            x.report(self.span, "`payloads` is a list only at compile time: ${uses}")
            return self.fact(ExprKind.Poison)
        }
        x.report(self.span, "a ${x.member_word()} has no fact `${member.as_str()}`: it has ${facts}")
        return self.fact(ExprKind.Poison)
    }
    if owner.is_variable(intern("site")) { return self.site_fact(member, x) }
    if owner.is_variable(intern("args")) {
        val value = x.argument(member)
        if value != null { return value ?: self.clone() }
        x.report(self.span, "`@${x.annotation.as_str()}` has no parameter `${member.as_str()}`")
        return self.fact(ExprKind.Poison)
    }
    return self.rekinded(ExprKind.FieldAccess(Box.new(owner.expanded(x)), x.built(member, self.span)))
}

/// `field.has<A>()` or `field.get<A>()` as a literal, `field.of(x)` as `x`'s
/// field; null for any other call.
fun Expr.member_fact(receiver: &Expr, method: Sym, args: &List<Expr>, x: &var Expansion): Expr? {
    val payload = receiver.bound_payload(x)
    if payload != null {
        val found = payload ?: return null
        if method.as_str() == "of" { return self.payload_of(&found, args, x) }
        x.report(self.span, "a payload has no fact `${method.as_str()}()`: it has `of(a)`, `index` and `type`")
        return self.fact(ExprKind.Poison)
    }
    val bound = receiver.bound_member(x) ?: return null
    val binder = when (receiver.kind) {
        Variable(name) => name
        _ => intern("")
    }
    if method.as_str() == "of" && !x.on_enum { return self.field_of(binder, bound, args, x) }
    if method.as_str() == "build" && x.on_enum { return self.built_variant(bound, args, x) }
    val annotation = self.fact_annotation()
    if method.as_str() == "has" && annotation.as_str().byte_len() > 0 {
        return self.fact(ExprKind.LitBool(x.has_member_annotation(bound, annotation)))
    }
    if method.as_str() == "get" && annotation.as_str().byte_len() > 0 {
        val found = x.member_arguments(bound, annotation, self.span)
        if found != null { return found }
        val guard = "guard it with `if ${binder.as_str()}.has<${annotation.as_str()}>()`"
        val named = "${x.member_word()} `${x.fields.at(bound).name.as_str()}`"
        x.report(self.span, "${named} has no `@${annotation.as_str()}`: ${guard}")
        return self.fact(ExprKind.Poison)
    }
    val last = if x.on_enum { "build(|payload| e)" } else { "of(x)" }
    val facts = "it has `has<A>()`, `get<A>()` and `${last}`"
    x.report(self.span, "a ${x.member_word()} has no fact `${method.as_str()}()`: ${facts}")
    return self.fact(ExprKind.Poison)
}

/// `field.of(x)`: `x.name` for the field `field` stands for, a place as well
/// as a value.
fun Expr.field_of(binder: Sym, member: uint64, args: &List<Expr>, x: &var Expansion): Expr {
    if args.size() != 1 {
        x.report(self.span, "`${binder.as_str()}.of(x)` takes the value to read the field from, and nothing else")
        return self.fact(ExprKind.Poison)
    }
    val owner = Box.new(args.at(0).expanded(x))
    return self.fact(ExprKind.FieldAccess(owner, x.fields.at(member).name))
}

/// The field a bare binder stands for, or null.
fun Expr.bound_member(x: &Expansion): uint64? {
    return when (self.kind) {
        Variable(name) => x.member_of(name)
        _ => null
    }
}

/// The payload a bare binder stands for, or null.
fun Expr.bound_payload(x: &Expansion): Bound? {
    return when (self.kind) {
        Variable(name) => x.payload_of(name)
        _ => null
    }
}

/// `A` in `has<A>()`, or "".
fun Expr.fact_annotation(): Sym {
    if self.type_args.size() != 1 { return intern("") }
    return when (self.type_args.at(0).kind) {
        Named(name, args) => if args.size() == 0 { name } else { intern("") }
        _ => intern("")
    }
}

fun Expr.is_variable(name: Sym): bool {
    return when (self.kind) {
        Variable(written) => written.id == name.id
        _ => false
    }
}

fun expanded_exprs(exprs: &List<Expr>, x: &var Expansion): List<Expr> {
    var out = List.new<Expr>()
    while e in &exprs {
        out.push(e.expanded(x))
    }
    return out
}

fun expanded_params(params: &List<Param>, x: &var Expansion): List<Param> {
    var out = List.new<Param>()
    while param in &params {
        val name = x.built(param.name, param.span)
        if !param.is_typed() {
            out.push(new_param(param.span, name.as_string(), ptr_null<TypeRef>()))
            continue
        }
        val ty = Box.new(param.ty.expanded_type(x))
        out.push(Param { span: param.span, name: name, ty: ty, default: param.default.clone() })
    }
    return out
}
