import core.assert.assert_eq
import alloc.list.*

import kf_core.span.Location
import kf_core.intern.intern
import kf_core.span.Span
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import kf_core.ast.annotation.Annotation
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TypeParam
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import testing.test

fun named(name: str): TypeRef {
    return TypeRef.new(Span.none(), TypeRefKind.Named(intern(name), List.new<TypeRef>()))
}

fun variable(name: str): Expr {
    return Expr.new(Span.none(), ExprKind.Variable(intern(name)))
}

fun access(owner: Expr, member: str): Expr {
    return Expr.new(Span.none(), ExprKind.FieldAccess(Box.new(owner), intern(member)))
}

/// `Point { x: int32, label: String }`, the loop on `label`.
fun point_expansion(): Expansion { return point_expansion_with(List.new<FieldInit>()) }

fun point_expansion_with(args: List<FieldInit>): Expansion {
    var fields = List.new<FieldFacts>()
    fields.push(FieldFacts {
        name: intern("x"), index: 0, ty: named("int32"), payloads: List.new<TypeRef>(),
        annotations: List.new<Annotation>(), span: Span.none(), line: 0
    })
    fields.push(FieldFacts {
        name: intern("label"), index: 1, ty: named("String"), payloads: List.new<TypeRef>(),
        annotations: List.new<Annotation>(), span: Span.none(), line: 0
    })
    return Expansion {
        annotation: intern("shown"), marked: intern("T"), type_name: intern("Point"), params: List.new<TypeParam>(),
        on_enum: false,
        home: intern("app"), home_file: 0, site: Location { file_path: String.from("src/main.kf"), line: 3, col: 8 },
        template_at: Span.none(), marked_at: Span.none(), undecided: 0,
        fields: fields, args: args, shapes: List.new<AnnotationShape>(), bound: on_label(),
        rests: List.new<Sym>(), values: List.new<ValueBound>(), diags: List.new<Diagnostic>()
    }
}

/// `field` standing for `label`.
fun on_label(): List<Bound> {
    var bound = List.new<Bound>()
    bound.push(Bound { binder: intern("field"), member: 1, payload: null })
    return bound
}

fun ExprKind.text(): String {
    return when (self) {
        LitStr(s) => "\"${s.as_str()}\""
        LitInt(n) => "${n}"
        LitBool(b) => if b { String.from("true") } else { String.from("false") }
        Variable(name) => name.as_string()
        FieldAccess(owner, member) => "${owner.kind.text().as_str()}.${member.as_str()}"
        Poison => String.from("poison")
        _ => String.from("?")
    }
}

@test fun t_names_the_marked_struct(): void {
    var x = point_expansion()
    val ty = named("T").expanded_type(&var x)
    assert_eq(ty.bare_type_name().as_str(), "Point", "`T` in a type")
}

@test fun field_type_is_the_fields_type(): void {
    var x = point_expansion()
    val written = TypeRef.new(Span.none(), TypeRefKind.Projection(Box.new(named("field")), intern("type")))
    assert_eq(written.expanded_type(&var x).bare_type_name().as_str(), "String", "`field.type` on `label`")
}

fun field_of(args: List<Expr>): Expr {
    return Expr.new(Span.none(), ExprKind.MethodCall(Box.new(variable("field")), intern("of"), args))
}

fun just(e: Expr): List<Expr> {
    var out = List.new<Expr>()
    out.push(e)
    return out
}

@test fun field_of_reads_the_field(): void {
    var x = point_expansion()
    val out = field_of(just(variable("self"))).expanded(&var x)
    assert_eq(out.kind.text().as_str(), "self.label", "`field.of(self)`")
}

@test fun field_of_without_a_value_is_reported(): void {
    var x = point_expansion()
    val _out = field_of(List.new<Expr>()).expanded(&var x)
    assert_eq(x.diags.size(), 1, "`field.of()` reads from nothing")
}

@test fun a_field_fact_is_a_literal(): void {
    var x = point_expansion()
    val out = access(variable("field"), "index").expanded(&var x)
    assert_eq(out.kind.text().as_str(), "1", "`field.index`")
}

@test fun the_type_name_is_a_literal(): void {
    var x = point_expansion()
    val out = access(variable("T"), "name").expanded(&var x)
    assert_eq(out.kind.text().as_str(), "\"Point\"", "`T.name`")
}

@test fun an_unknown_fact_is_reported(): void {
    var x = point_expansion()
    val _out = access(variable("field"), "width").expanded(&var x)
    assert_eq(x.diags.size(), 1, "`field.width`")
}

@test fun the_binder_alone_is_reported(): void {
    var x = point_expansion()
    val _out = variable("field").expanded(&var x)
    assert_eq(x.diags.size(), 1, "`field` is not a value")
}

@test fun a_member_loop_unrolls_once_per_field(): void {
    var x = point_expansion()
    x.bound = List.new<Bound>()
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.Expression(Box.new(access(variable("field"), "name")))))
    var stmts = List.new<Stmt>()
    stmts.push(Stmt.new(Span.none(), StmtKind.ForEach(intern("field"), Box.new(access(variable("T"), "fields")), body)))
    assert_eq(expand_stmts(&stmts, &var x).size(), 2, "one block per field")
}

@test fun a_decided_if_keeps_only_its_branch(): void {
    var x = point_expansion()
    var then_body = List.new<Stmt>()
    then_body.push(Stmt.new(Span.none(), StmtKind.Break))
    var stmts = List.new<Stmt>()
    val condition = Expr.new(Span.none(), ExprKind.LitBool(false))
    stmts.push(Stmt.new(Span.none(), StmtKind.If(Box.new(condition), then_body, List.new<Stmt>())))
    val out = expand_stmts(&stmts, &var x)
    val kept = when (out.at(0).kind) {
        If(_c, taken, _other) => taken.size()
        _ => 9
    }
    assert_eq(kept, 0, "the empty `else` is taken")
}

fun TypeRef.bare_type_name(): String {
    return when (self.kind) {
        Named(name, _args) => name.as_string()
        _ => String.from("")
    }
}

fun member_loop(body: List<Stmt>): List<Stmt> {
    var stmts = List.new<Stmt>()
    stmts.push(Stmt.new(Span.none(), StmtKind.ForEach(intern("field"), Box.new(access(variable("T"), "fields")), body)))
    return stmts
}

@test fun a_decided_break_ends_the_copies(): void {
    var x = point_expansion()
    x.bound = List.new<Bound>()
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.Break))
    val out = expand_stmts(&member_loop(body), &var x)
    assert_eq(out.size(), 1, "the first copy, cut at its `break`, and no second")
}

@test fun a_run_time_break_is_a_flag_and_a_pass_per_copy(): void {
    var x = point_expansion()
    x.bound = List.new<Bound>()
    var jump = List.new<Stmt>()
    jump.push(Stmt.new(Span.none(), StmtKind.Break))
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.If(Box.new(variable("c")), jump, List.new<Stmt>())))
    val out = expand_stmts(&member_loop(body), &var x)
    assert_eq(out.size(), 3, "the flag, then a guarded pass for each of the two fields")
}

@test fun a_break_in_an_inner_loop_stays(): void {
    var x = point_expansion()
    x.bound = List.new<Bound>()
    var inner = List.new<Stmt>()
    inner.push(Stmt.new(Span.none(), StmtKind.Break))
    var body = List.new<Stmt>()
    val always = Expr.new(Span.none(), ExprKind.LitBool(true))
    body.push(Stmt.new(Span.none(), StmtKind.While(Box.new(always), inner)))
    var stmts = List.new<Stmt>()
    stmts.push(Stmt.new(Span.none(), StmtKind.ForEach(intern("field"), Box.new(access(variable("T"), "fields")), body)))
    val _out = expand_stmts(&stmts, &var x)
    assert_eq(x.diags.size(), 0, "`break` leaves its own loop")
}

@test fun a_name_builds_from_the_field(): void {
    var x = point_expansion()
    assert_eq(x.built(intern("with_\${field.name}"), Span.none()).as_str(), "with_label", "`field.name` in a name")
}

@test fun a_name_builds_from_the_struct(): void {
    var x = point_expansion()
    assert_eq(x.built(intern("\${T.name}Builder"), Span.none()).as_str(), "PointBuilder", "`T.name` in a name")
}

@test fun a_name_builds_from_text_arguments(): void {
    val value = Box.new(Expr.new(Span.none(), ExprKind.LitStr(String.from("get"))))
    var args = List.new<FieldInit>()
    args.push(FieldInit { span: Span.none(), name: intern("prefix"), value: value })
    var x = point_expansion_with(args)
    assert_eq(x.built(intern("\${args.prefix}_\${field.name}"), Span.none()).as_str(), "get_label", "two parts")
}

@test fun a_name_from_anything_else_is_reported(): void {
    var x = point_expansion()
    val _name = x.built(intern("with_\${field.index}"), Span.none())
    assert_eq(x.diags.size(), 1, "`field.index` is not text")
}

fun build_call(binder: str, value: Expr): Expr {
    var params = List.new<Param>()
    params.push(Param { span: Span.none(), name: intern(binder), ty: Box.new(named("_")), default: null })
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.Expression(Box.new(value))))
    val lambda = Expr.new(Span.none(), ExprKind.Lambda(params, body))
    return Expr.new(Span.none(), ExprKind.MethodCall(Box.new(variable("T")), intern("build"), just(lambda)))
}

@test fun build_writes_one_field_init_per_field(): void {
    var x = point_expansion()
    x.bound = List.new<Bound>()
    val out = build_call("f", access(variable("f"), "name")).expanded(&var x)
    val shape = when (out.kind) {
        StructLit(name, inits) => "${name.as_str()} ${inits.size()} ${inits.at(1).value.kind.text().as_str()}"
        _ => String.from("")
    }
    assert_eq(shape.as_str(), "Point 2 \"label\"", "`Point { x: \"x\", label: \"label\" }`")
}
