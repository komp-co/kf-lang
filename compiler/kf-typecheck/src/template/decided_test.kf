import core.assert.assert_eq
import alloc.list.*

import kf_core.span.Span
import kf_core.ast.expression.*
import kf_core.ast.statement.Stmt
import testing.test
import kf_core.intern.intern
import kf_core.ast.pattern.*

fun literal(kind: ExprKind): Expr {
    return Expr.new(Span.none(), kind)
}

fun binary(left: ExprKind, op: BinOp, right: ExprKind): Expr {
    return literal(ExprKind.Binary(Box.new(literal(left)), op, Box.new(literal(right))))
}

fun arm_on(kind: PatternKind): Arm {
    return Arm.new(Span.none(), Box.new(Pattern.new(Span.none(), kind)), null, List.new<Stmt>())
}

@test fun equal_names_decide_true(): void {
    val same = binary(ExprKind.LitStr(String.from("id")), BinOp.Eq, ExprKind.LitStr(String.from("id")))
    val decided = same.decided_bool()
    assert_eq(decided ?: false, true, "`\"id\" == \"id\"`")
}

@test fun a_negated_flag_decides(): void {
    val flag = literal(ExprKind.Unary(UnaryOp.Not, Box.new(literal(ExprKind.LitBool(true)))))
    assert_eq(flag.decided_bool() == null, false, "`!true` is known")
}

@test fun an_index_comparison_decides(): void {
    val decided = binary(ExprKind.LitInt(2), BinOp.Lt, ExprKind.LitInt(3)).decided_bool()
    assert_eq(decided ?: false, true, "`2 < 3`")
}

@test fun a_variable_is_decided_at_run_time(): void {
    val decided = binary(ExprKind.Variable(intern("x")), BinOp.Eq, ExprKind.LitInt(3)).decided_bool()
    assert_eq(decided == null, true, "`x == 3` waits for the program")
}

@test fun a_literal_subject_takes_its_arm(): void {
    var arms = List.new<Arm>()
    arms.push(arm_on(PatternKind.LitInt(0)))
    arms.push(arm_on(PatternKind.Identifier(intern("_"))))
    val taken = literal(ExprKind.LitInt(1)).decided_arm(&arms)
    assert_eq(taken ?: 9, 1 as uint64, "`1` passes `0` and takes `_`")
}

@test fun a_binding_arm_is_decided_at_run_time(): void {
    var arms = List.new<Arm>()
    arms.push(arm_on(PatternKind.Identifier(intern("n"))))
    val taken = literal(ExprKind.LitInt(1)).decided_arm(&arms)
    assert_eq(taken == null, true, "a binding is left to run time")
}
