// What a template's names stand for while it adds to one struct or enum:
// `T`, the use's arguments, and the field or variant a member loop is on,
// and the payload a payload loop is on.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import kf_core.ast.declaration.Annotation
import kf_core.diagnostic.*

/// A field or a variant, as a template reads it. A variant has no `ty`,
/// and a field no `payloads`.
struct FieldFacts {
    val name: Sym
    val index: uint64
    val ty: TypeRef
    val payloads: List<TypeRef>
    val annotations: List<Annotation>
    val span: Span
    /// The line it is written on, 0 without a source map.
    val line: uint32
}

/// A binder standing for one field or variant: a member loop's, or
/// `T.build`'s. One standing for a payload has the payload's index too.
struct Bound {
    val binder: Sym
    val member: uint64
    val payload: uint64?
}

/// An annotation's parameter names in order, for `args` and `get<A>()`.
struct AnnotationShape {
    val name: Sym
    val params: List<Sym>
    /// The last parameter takes the positional arguments left over.
    val variadic: bool
}

/// A binder standing for one value of a variadic argument, in a loop over
/// it: `rule` in `while rule in args.rules`.
struct ValueBound {
    val binder: Sym
    val value: Expr
}

struct Expansion {
    /// The template's annotation, as `@name` writes it.
    val annotation: Sym
    /// `T`.
    val marked: Sym
    val type_name: Sym
    /// The template is on an enum: its members are variants.
    val on_enum: bool
    /// The struct's module, which owns what the template adds, and its file.
    val home: Sym
    val home_file: uint32
    /// Where the marked declaration's name is: `site.file`, `.line` and
    /// `.column`.
    val site: Location
    val fields: List<FieldFacts>
    /// `args.p`: each parameter's value at this use.
    val args: List<FieldInit>
    val shapes: List<AnnotationShape>
    /// The binders standing for a field here, innermost last.
    var bound: List<Bound>
    /// The `..a` binders an arm has bound, for `payload.of(a)`.
    var rests: List<Sym>
    /// The binders standing for one value of a variadic argument.
    var values: List<ValueBound>
    var diags: List<Diagnostic>
}

impl Expansion {
    fun in_member(): bool { return self.bound.size() > 0 }

    /// The field the innermost binder stands for.
    fun field(): &FieldFacts { return self.fields.at(self.bound.at(self.bound.size() - 1).member) }

    /// The field or variant `name` stands for, the innermost binder of that
    /// name; null when none is bound here, or it stands for a payload.
    fun member_of(name: Sym): uint64? {
        val found = self.binding(name) ?: return null
        return if found.payload == null { found.member } else { null }
    }

    /// The innermost binder called `name`.
    fun binding(name: Sym): Bound? {
        var i = self.bound.size()
        while i > 0 {
            i = i - 1
            val at = self.bound.at(i)
            if at.binder.id == name.id { return Bound { binder: at.binder, member: at.member, payload: at.payload } }
        }
        return null
    }

    /// The variant and payload `name` stands for, or null.
    fun payload_of(name: Sym): Bound? {
        val found = self.binding(name) ?: return null
        return if found.payload != null { found } else { null }
    }

    /// The variant the innermost binder is on, or null outside a variant.
    fun variant(): uint64? {
        if !self.on_enum || !self.in_member() { return null }
        return self.bound.at(self.bound.size() - 1).member
    }

    /// What one member is called in messages: a field or a variant.
    fun member_word(): str { return if self.on_enum { "variant" } else { "field" } }

    mutating fun bind(binder: Sym, member: uint64): void {
        self.bound.push(Bound { binder: binder, member: member, payload: null })
    }

    mutating fun bind_payload(binder: Sym, member: uint64, payload: uint64): void {
        self.bound.push(Bound { binder: binder, member: member, payload: Option.Some(payload) })
    }

    mutating fun unbind(): void { val _left = self.bound.pop() }

    mutating fun report(at: Span, message: String): void {
        self.diags.push(error_at(at, message))
    }

    /// `field.get<A>()`: `A`'s arguments on the field as a literal of its
    /// argument struct, or null without `@A` there.
    fun member_arguments(member: uint64, annotation: Sym, span: Span): Expr? {
        val params = self.params_of(annotation)
        val variadic = self.is_variadic(annotation)
        while use in &self.fields.at(member).annotations {
            if use.name.id == annotation.id {
                val inits = arguments_by_name(use, &params, span, variadic)
                return Expr.new(span, ExprKind.StructLit(annotation, inits))
            }
        }
        return null
    }

    fun has_member_annotation(member: uint64, annotation: Sym): bool {
        while use in &self.fields.at(member).annotations {
            if use.name.id == annotation.id { return true }
        }
        return false
    }

    fun is_variadic(annotation: Sym): bool {
        while shape in &self.shapes {
            if shape.name.id == annotation.id { return shape.variadic }
        }
        return false
    }

    /// The value `name` stands for in a loop over a variadic argument, the
    /// innermost; null when it stands for none.
    fun value_of(name: Sym): Expr? {
        var i = self.values.size()
        while i > 0 {
            i = i - 1
            if self.values.at(i).binder.id == name.id { return self.values.at(i).value.clone() }
        }
        return null
    }

    fun params_of(annotation: Sym): List<Sym> {
        while shape in &self.shapes {
            if shape.name.id == annotation.id { return shape.params.clone() }
        }
        return List.new<Sym>()
    }

    /// `args.name`'s value, or null when the annotation has no such
    /// parameter.
    fun argument(name: Sym): Expr? {
        while arg in &self.args {
            if arg.name.id == name.id { return (*arg.value).clone() }
        }
        return null
    }
}

/// `use`'s arguments as `name: value`, positional ones by place, and with
/// `variadic` the ones left over as a list literal for the last parameter. A
/// mismatch is left out: checking the use reports it.
fun arguments_by_name(use: &Annotation, params: &List<Sym>, span: Span, variadic: bool): List<FieldInit> {
    var inits = List.new<FieldInit>()
    val single = if variadic && params.size() > 0 { params.size() - 1 } else { params.size() }
    var rest = List.new<Expr>()
    while i in 0..use.args.size() {
        val arg = use.args.at(i)
        val named = arg.name.as_str().byte_len() > 0
        if !named && i >= single {
            if variadic { rest.push((*arg.value).clone()) }
            continue
        }
        val name = if named { arg.name } else { *params.at(i) }
        inits.push(FieldInit { span: span, name: name, value: Box.new((*arg.value).clone()) })
    }
    if variadic && params.size() > 0 {
        val list = Expr.new_list_literal(span, &rest)
        inits.push(FieldInit { span: span, name: *params.at(single), value: Box.new(list) })
    }
    return inits
}
