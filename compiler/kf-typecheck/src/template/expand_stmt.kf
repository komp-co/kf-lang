// A template's statements for one struct or enum. `while field in T.fields`,
// `T.variants` or `variant.payloads`, or a filter of one, becomes one
// `if true { ... }` block per member kept, and an
// `if` or `when` whose condition is facts alone keeps only the branch taken,
// so the other need not check for that field.

import alloc.list.*

import kf_core.intern.Sym
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.intern.intern

fun expand_stmts(stmts: &List<Stmt>, x: &var Expansion): List<Stmt> {
    var out = List.new<Stmt>()
    while stmt in &stmts {
        stmt.expand_into(x, &var out)
    }
    return out
}

fun Stmt.expand_into(x: &var Expansion, out: &var List<Stmt>): void {
    when (self.kind) {
        ForEach(binder, subject, body) => {
            val values = subject.argument_values(x)
            if values != null {
                self.unroll_values(binder, &(values ?: List.new<Expr>()), &body, x, out)
                return
            }
            val listed = subject.selected_fields(x)
            if listed != null {
                val selection = listed ?: return
                self.unroll(binder, &selection, &body, x, out)
                return
            }
            x.undecided = x.undecided + 1
            val repeated = expand_stmts(&body, x)
            x.undecided = x.undecided - 1
            out.push(self.rekinded(StmtKind.ForEach(binder, Box.new(subject.expanded(x)), repeated)))
        }
        If(condition, then_body, else_body) => {
            val decided = condition.expanded(x)
            val chosen = decided.decided_bool()
            if chosen == null {
                x.undecided = x.undecided + 1
                val kind = StmtKind.If(Box.new(decided), expand_stmts(&then_body, x), expand_stmts(&else_body, x))
                x.undecided = x.undecided - 1
                out.push(self.rekinded(kind))
                return
            }
            val taken = if chosen ?: false { expand_stmts(&then_body, x) } else { expand_stmts(&else_body, x) }
            // A lone value stands where the `if` did, so it is still the
            // value of an arm or block that ends with it.
            if taken.is_lone_value() {
                out.push(taken.at(0).clone())
            } else {
                out.push(self.scope(taken))
            }
        }
        When(subject, arms) => {
            val decided = subject.expanded(x)
            val arm = decided.decided_arm(&arms)
            if arm != null {
                val index = arm ?: 0
                out.push(self.scope(expand_stmts(&arms.at(index).body, x)))
                return
            }
            x.undecided = x.undecided + 1
            val kept = expanded_arms(&arms, x)
            x.undecided = x.undecided - 1
            out.push(self.rekinded(StmtKind.When(Box.new(decided), kept)))
        }
        LetVal(name, ty, init) => out.push(self.rekinded(StmtKind.LetVal(x.built(name, self.span),
            expanded_opt_type(&ty, x), expanded_opt_expr(&init, x))))
        LetVar(name, ty, init) => out.push(self.rekinded(StmtKind.LetVar(x.built(name, self.span),
            expanded_opt_type(&ty, x), expanded_opt_expr(&init, x))))
        Assign(name, value) => {
            out.push(self.rekinded(StmtKind.Assign(x.built(name, self.span), Box.new(value.expanded(x)))))
        }
        AssignTo(place, value) => {
            out.push(self.rekinded(StmtKind.AssignTo(Box.new(place.expanded(x)), Box.new(value.expanded(x)))))
        }
        Return(value) => out.push(self.rekinded(StmtKind.Return(expanded_opt_expr(&value, x))))
        While(condition, body) => {
            x.undecided = x.undecided + 1
            val repeated = expand_stmts(&body, x)
            x.undecided = x.undecided - 1
            out.push(self.rekinded(StmtKind.While(Box.new(condition.expanded(x)), repeated)))
        }
        Expression(value) => {
            if x.reported(&value) { return }
            out.push(self.rekinded(StmtKind.Expression(Box.new(value.expanded(x)))))
        }
        _ => out.push(self.clone())
    }
}

/// One block per member kept, the binder standing for it inside. A loop
/// over a variant's payloads may stand inside the loop over variants.
fun Stmt.unroll(binder: Sym, listed: &Selection, body: &List<Stmt>, x: &var Expansion, out: &var List<Stmt>): void {
    if x.in_member() && listed.variant == null {
        x.report(self.span, String.from("a member loop cannot be inside another"))
        return
    }
    var copies = List.new<List<Stmt>>()
    while i in &listed.kept {
        x.bind_in(binder, listed, i)
        val copy = cut_at_jump(&expand_stmts(body, x))
        x.unbind()
        copies.push(copy.kept)
        if copy.jump == Jump.Broke || copy.jump == Jump.Returned { break }
    }
    self.joined_copies(&copies, out)
}

/// `if true { body }`: a block with its own scope.
fun Stmt.scope(body: List<Stmt>): Stmt {
    val always = Expr.new(self.span, ExprKind.LitBool(true))
    return self.rekinded(StmtKind.If(Box.new(always), body, List.new<Stmt>()))
}

fun Stmt.rekinded(kind: StmtKind): Stmt {
    return Stmt { span: self.span, binder: self.binder, kind: kind }
}

fun expanded_opt_expr(value: &Box<Expr>?, x: &var Expansion): Box<Expr>? {
    return when (value) {
        Some(inner) => Option.Some(Box.new(inner.expanded(x)))
        None => null
    }
}

fun expanded_opt_type(ty: &Box<TypeRef>?, x: &var Expansion): Box<TypeRef>? {
    return when (ty) {
        Some(inner) => Option.Some(Box.new(inner.expanded_type(x)))
        None => null
    }
}

fun List<Stmt>.is_lone_value(): bool {
    if self.size() != 1 { return false }
    return when (self.at(0).kind) {
        Expression(_value) => true
        _ => false
    }
}
