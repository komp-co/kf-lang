// `internal` functions and values: registered as `pub`, so every module of
// their crate imports them, and refused to any other crate.

import alloc.hash_map.*

import kf_core.ast.Sym
import kf_core.ast.CrateId

impl SigTable {
    pub mutating fun note_internal(owner_module: Sym, name: str): void {
        self.internal_names.insert("${owner_module.as_str()} ${name}", true)
    }

    /// Another crate's `internal` declaration, which `caller_crate` may not
    /// name.
    pub fun hides_from(sig: &FnSignature, caller_crate: CrateId): bool {
        if sig.owner_crate.raw == caller_crate.raw { return false }
        return self.internal_names.contains(&"${sig.owner_module.as_str()} ${sig.name}")
    }

    /// The crate whose `internal` declaration `name` is, when `caller_crate`
    /// cannot see it; "" otherwise.
    pub fun internal_home(name: str, caller_crate: CrateId): String {
        while sig in &self.sigs {
            if sig.name.as_str() == name && self.hides_from(&sig, caller_crate) {
                return String.from(Sym { id: sig.owner_crate.raw }.as_str())
            }
        }
        return ""
    }
}
