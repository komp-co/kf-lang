import core.assert.assert_eq

import kf_core.ast.intern
import kf_core.ast.lang_equal_key

fun equal_marked_table(): SigTable {
    var sigs = new_sig_table()
    sigs.note_lang_trait(lang_equal_key(), intern("Equal"))
    return sigs
}

@test fun str_is_equal_with_no_impl_written(): void {
    val sigs = equal_marked_table()
    assert_eq(sigs.type_implements("str", "Equal", ""), true, "the runtime compares str")
}

@test fun str_meets_no_other_trait_without_an_impl(): void {
    val sigs = equal_marked_table()
    assert_eq(sigs.type_implements("str", "Compare", ""), false, "only equality is built in")
}

@test fun a_table_with_no_equal_trait_answers_no(): void {
    val sigs = new_sig_table()
    assert_eq(sigs.type_implements("str", "Equal", ""), false, "with no lang Equal trait, nothing is Equal")
}
