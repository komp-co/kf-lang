import alloc.list.*

import kf_core.span.Span
import kf_core.ast.types.Type
import kf_core.intern.CrateId
import kf_core.intern.intern

/// With `Equal`, `impl From<str> for String`, and the `from_literal` a
/// string literal in a `String` slot becomes.
pub fun register_string_with_equal_and_from(sp: Ptr<SigTable>): void {
    unsafe { (*sp).lang_string = intern("String") }
    unsafe { sp.insert_struct(StructLayout { name: String.from("String"), fields: List.new<StructFieldInfo>(),
        is_refcounted: false, owner_crate: CrateId.new_poison() }) }
    unsafe { sp.insert_trait_impl(TraitImplInfo { type_name: String.from("String"), receiver_identity: intern("String"),
        trait_name: String.from("Equal"), trait_args: "", generics: "", arg_count: 0 }) }
    unsafe { sp.insert_trait_impl(TraitImplInfo { type_name: String.from("String"), receiver_identity: intern("String"),
        trait_name: String.from("From"), trait_args: String.from("str"), generics: "", arg_count: 1 }) }
    var params = List.new<Type>()
    params.push(Type.new_str(Span.none()))
    val from_name = String.from("String_from__From__str")
    unsafe { sp.insert(FnSignature { name: from_name, params: params, ret: intern("String").lang_struct_ty(Span.none()),
        generics: List.new<String>(), is_static: true, is_mutating: false, owner_module: intern(""),
        owner_crate: CrateId.new_poison(), is_pub: true, borrows: 0 - 1, is_prelude: false, is_extern: false }) }
    var literal_params = List.new<Type>()
    literal_params.push(Type.new_str(Span.none()))
    unsafe { sp.insert(FnSignature { name: String.from("String_from_literal"), params: literal_params,
        ret: intern("String").lang_struct_ty(Span.none()), generics: List.new<String>(), is_static: true,
        is_mutating: false, owner_module: intern(""), owner_crate: CrateId.new_poison(), is_pub: true, borrows: 0 - 1,
        is_prelude: false, is_extern: false }) }
}
