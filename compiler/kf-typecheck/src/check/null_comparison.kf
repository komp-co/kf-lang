// `x == null` on an optional reads the tag, so its payload needs no `Equal`.

/// The Option method testing the tag for `op`; "" when `op` is not `==`/`!=`.
fun BinOp.null_comparison_method(): str {
    return when (self) {
        Eq => "is_none"
        NotEq => "is_some"
        _ => ""
    }
}
