// A method call nothing answers: named with the type as written, and the
// nearest method offered as a repair.

import kf_core.span.*
import kf_core.diagnostic.*

/// `type_name` finds the near misses; `shown` is how the message names it,
/// `List<int32>` for `List__int32`.
fun emit_no_such_method(type_name: String, shown: String, method_name: String, span: Span, name_span: Span,
    ctx: &var TypeCtx): void {
    var msg = "no method `${method_name.as_str()}` on `${shown}`"
    if method_name.as_str().equals("display") {
        msg.append(" (implement `Display` for it, or interpolate a field instead)")
    }
    msg.append(unimported_extension_note(method_name, ctx).as_str())
    val near = nearest_method(type_name, method_name, ctx)
    if near.name.as_str() != "" { msg.append(" (did you mean `${near.name.as_str()}`?)") }
    val diag = Diagnostic.new(Severity.Error, Label.new(span, msg))
    // The fix spans `name_span`, since the call's span opens at the receiver.
    if near.name.as_str() != "" && !name_span.is_none() {
        val title = "change to `${near.name.as_str()}`"
        // A tie makes the winner arbitrary: named, not written unasked.
        var applic = Applicability.MachineApplicable
        if near.tied { applic = Applicability.MaybeIncorrect }
        ctx.emit(with_fix_applic(diag, name_span, near.name, title, applic))
        return
    }
    ctx.emit(diag)
}
