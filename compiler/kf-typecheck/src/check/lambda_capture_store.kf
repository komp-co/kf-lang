// A lambda assigning a captured name, `calls = calls + 1`: the name is a
// capture, borrowed mutably, and the assignment stores through its field.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Sym
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.Param
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind

fun gather_assignment(target: Sym, value: Ptr<Expr>, params: &List<Param>, ctx: &var TypeCtx,
    found: &var List<LambdaCapture>, locals: &var List<String>): void {
    note_free_name(target, params, ctx, found, locals)
    gather_free_names(value, params, ctx, found, locals)
}

/// The assigned capture is written, so the lambda borrows it mutably.
fun classify_assignment(target: Sym, value: Ptr<Expr>, captures: &var List<LambdaCapture>, ctx: &var TypeCtx): void {
    strengthen_capture(captures, target.as_str(), CaptureMode.Mutable)
    classify_capture_expr(value, true, captures, ctx)
}

/// Each assignment to a capture becomes a store through its field; a name
/// the body declares shadows the capture from there on.
/// CONSTRAINT: runs after `rewrite_captures_in_stmts`, which has already
/// rewritten every assigned value.
pub mutating fun List<Stmt>.store_assigned_captures(captures: &List<LambdaCapture>, span: Span,
    locals: &var List<String>): void {
    var inner = clone_name_list(locals)
    while i in 0..self.size() {
        self.at_mut(i).store_assigned_capture(captures, span, &var inner)
    }
}

mutating fun Stmt.store_assigned_capture(captures: &List<LambdaCapture>, span: Span, locals: &var List<String>): void {
    when (self.kind) {
        LetVal(name, _ty, _init) => locals.push(name.as_string())
        LetVar(name, _ty, _init) => locals.push(name.as_string())
        Assign(target, value) => {
            if name_in_list(locals, target.as_str()) { return }
            if capture_index(captures, target.as_str()) >= captures.size() { return }
            val place = Box.new(Expr.new(self.span, ExprKind.Variable(target)))
            rewrite_captures_to_fields(place, captures, span, locals)
            // A copy: storing the kind drops the old one, value included.
            self.kind = StmtKind.AssignTo(place, Box.new(value.clone()))
        }
        If(_cond, then_body, else_body) => {
            then_body.store_assigned_captures(captures, span, locals)
            else_body.store_assigned_captures(captures, span, locals)
        }
        While(_cond, body) => body.store_assigned_captures(captures, span, locals)
        ForEach(binder, _subject, body) => {
            var inner = clone_name_list(locals)
            inner.push(binder.as_string())
            body.store_assigned_captures(captures, span, &var inner)
        }
        When(_subject, arms) => {
            while i in 0..arms.size() {
                arms.at_mut(i).body.store_assigned_captures(captures, span, locals)
            }
        }
        _ => { }
    }
}

/// An assigned capture stays a borrow of the caller's variable even where
/// the body also reads it by value, as `log = log + "x"` does: owning a copy
/// would leave the caller's unchanged.
pub fun List<Stmt>.pin_assigned_captures(captures: &var List<LambdaCapture>): void {
    while stmt in &self {
        when (stmt.kind) {
            Assign(target, _value) => {
                val i = capture_index(captures, target.as_str())
                if i < captures.size() { captures.at_mut(i).mode = CaptureMode.Mutable }
            }
            If(_cond, then_body, else_body) => {
                then_body.pin_assigned_captures(captures)
                else_body.pin_assigned_captures(captures)
            }
            While(_cond, body) => body.pin_assigned_captures(captures)
            ForEach(_binder, _subject, body) => body.pin_assigned_captures(captures)
            When(_subject, arms) => {
                while arm in &arms { arm.body.pin_assigned_captures(captures) }
            }
            _ => { }
        }
    }
}
