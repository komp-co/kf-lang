import core.assert.assert_eq

@test
fun a_methods_name_follows_its_owners_prefix(): void {
    assert_eq(method_of("Point_sum", "Point_").as_str(), "sum", "`Point_sum` is `sum` of `Point`")
}

@test
fun a_suffix_after_a_double_underscore_is_not_the_name(): void {
    assert_eq(method_of("Widget_make__Producer", "Widget_").as_str(), "make", "the trait suffix is dropped")
}

@test
fun another_owners_method_has_no_name_under_the_prefix(): void {
    assert_eq(method_of("Pointer_sum", "Point_").as_str(), "", "`Pointer_` is not `Point_`")
}

@test
fun a_bare_prefix_names_no_method(): void {
    assert_eq(method_of("Point_", "Point_").as_str(), "", "nothing follows the prefix")
}

@test
fun names_method_agrees_with_method_of(): void {
    assert_eq(names_method("Widget_make__Producer", "Widget_", 7, "make", 4), true, "`make` of `Widget`")
}

@test
fun names_method_wants_the_whole_name(): void {
    assert_eq(names_method("Widget_maker", "Widget_", 7, "make", 4), false, "`make` is only a prefix of `maker`")
}
