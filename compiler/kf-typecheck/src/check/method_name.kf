// A method's name read out of its signature's mangled name: `OWNER_NAME`, or
// `OWNER_NAME__SUFFIX` for a trait's or a generic instance's.

import core.text.byte_at_in

/// `Point_sum` under `Point_` is `sum`; `Widget_make__Producer` is `make`; ""
/// otherwise.
fun method_of(sig_name: str, prefix: str): String {
    val pn = prefix.byte_len()
    val end = method_end(sig_name, sig_name.byte_len(), prefix, pn)
    if end == 0 { return "" }
    return sig_name.substring(pn, end)
}

/// Where the method name `method_of` reads ends in `sig_name`, `n` bytes long:
/// before its first `__`, or at its end. 0 when there is none under `prefix`,
/// `pn` bytes long.
fun method_end(sig_name: str, n: uint64, prefix: str, pn: uint64): uint64 {
    if n <= pn { return 0 }
    while i in 0..pn {
        if sig_name.byte_at_in(n, i) != prefix.byte_at_in(pn, i) { return 0 }
    }
    var j = pn
    while j + 1 < n {
        if sig_name.byte_at_in(n, j) == 95 && sig_name.byte_at_in(n, j + 1) == 95 {
            return if j > pn { j } else { 0 }
        }
        j = j + 1
    }
    return n
}

/// `method_of(sig_name, prefix) == wanted`, without building the name.
fun names_method(sig_name: str, prefix: str, pn: uint64, wanted: str, wn: uint64): bool {
    val n = sig_name.byte_len()
    if method_end(sig_name, n, prefix, pn) != pn + wn { return false }
    while i in 0..wn {
        if sig_name.byte_at_in(n, pn + i) != wanted.byte_at_in(wn, i) { return false }
    }
    return true
}
