import core.assert.assert_eq

@test fun an_intrinsic_base_drops_its_type_arguments(): void {
    assert_eq(intrinsic_base("alloc_array__int32"), "alloc_array", "up to the first `__`")
}

@test fun realloc_array_takes_the_pointer_and_the_length(): void {
    assert_eq(intrinsic_arity("realloc_array"), 2, "two arguments")
}

@test fun sizeof_takes_no_arguments(): void {
    assert_eq(intrinsic_arity("sizeof"), 0, "the type is all it needs")
}

@test fun annotated_is_not_counted_here(): void {
    assert_eq(intrinsic_arity("annotated"), -1, "checked where it is expanded")
}
