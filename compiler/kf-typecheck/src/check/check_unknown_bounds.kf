// A bound naming a nonexistent trait is reported where it is written, not as
// a failure of every caller's argument.

import alloc.list.*

import kf_core.diagnostic.*
import kf_typecheck.note_import_use

/// Also records the bound as a use of the trait's module, since bounds
/// resolve without consulting imports.
pub fun unknown_bound_diags(sigs: Ptr<SigTable>): List<Diagnostic> {
    var out = List.new<Diagnostic>()
    var i = 0
    while i < unsafe { sigs.bounds.size() } {
        val b = unsafe { sigs.bounds.at(i) }
        b.note_bound_as_an_import_use(sigs)
        if b.bound_names_no_trait(sigs) {
            val m = "no trait named `${b.trait_name.as_str()}` — a bound must name a declared trait"
            out.push(Diagnostic.new(Severity.Error, Label.new(b.span, m)))
        } else {
            // Wrong argument count: reported at the declaration too.
            when (unsafe { sigs.find_trait(b.trait_name) }) {
                Some(info) => {
                    if b.arg_names.size() != info.type_params.size() {
                        val expect = info.type_params.size()
                        val found = b.arg_names.size()
                        val m = "trait `${b.trait_name.as_str()}` expects ${expect} argument(s), found ${found}"
                        out.push(Diagnostic.new(Severity.Error, Label.new(b.span, m)))
                    }
                }
                None => { }
            }
        }
        i = i + 1
    }
    return out
}

/// Dependency traits arrive with their interfaces and resolve the same way.
fun BoundInfo.bound_names_no_trait(sigs: Ptr<SigTable>): bool {
    if self.trait_name.as_str().equals("") { return false }
    return unsafe { sigs.find_trait(self.trait_name) }.is_none()
}

fun BoundInfo.note_bound_as_an_import_use(sigs: Ptr<SigTable>): void {
    if self.span.file_id == 0 { return }
    when (unsafe { sigs.find_trait(self.trait_name) }) {
        Some(info) => {
            if info.module.id != 0 {
                note_import_use(sigs, self.span.file_id, info.module)
            }
        }
        None => { }
    }
}
