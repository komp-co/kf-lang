@test fun enum_or_struct_name_returns_owned_str(): void {
    val name: String = TypeKind.EnumTy(intern("Choice")).enum_or_struct_name()
    assert_eq(name.as_str(), "Choice", "pattern lookup names are owned String values")
}

pub fun mk_stmt_ctx(): TypeCtx {
    val table = new_decl_table()
    val sigs = new_sig_table()
    val tab_ptr: Ptr<DeclTable> = unsafe { alloc<DeclTable>() }
    unsafe { *tab_ptr = table }
    val sig_ptr: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sig_ptr = sigs }
    unsafe { (*sig_ptr).insert_struct(StructLayout { name: String.from("String"), fields: List.new<StructFieldInfo>(), is_refcounted: false, owner_crate: CrateId.new_poison() }) }
    unsafe { (*sig_ptr).lang_string = intern("String") }
    unsafe { (*sig_ptr).insert(FnSignature { name: String.from("String_from"), params: str_type_list(), ret: intern("String").lang_struct_ty(Span.none()), generics: List.new<String>(), is_static: true, is_mutating: false, owner_module: intern(""), owner_crate: CrateId.new_poison(), is_pub: true, borrows: -1, is_prelude: false, is_extern: false }) }
    return new_type_ctx(
        Type.new_void(Span.none()), unsafe { &var *leaked_diagnostics() }, Option.Some(tab_ptr), sig_ptr
    )
}

/// No `String` in the table: a crate without alloc.
fun mk_ctx_without_string(): TypeCtx {
    val tab_ptr: Ptr<DeclTable> = unsafe { alloc<DeclTable>() }
    unsafe { *tab_ptr = new_decl_table() }
    val sig_ptr: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sig_ptr = new_sig_table() }
    return new_type_ctx(
        Type.new_void(Span.none()), unsafe { &var *leaked_diagnostics() }, Option.Some(tab_ptr), sig_ptr
    )
}

fun str_type_list(): List<Type> {
    var types = List.new<Type>()
    types.push(Type.new_str(Span.none()))
    return types
}

@test fun let_val_binds_int(): void {
    var ctx = mk_stmt_ctx()
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init_ptr = Expr.new(Span.none(), ExprKind.LitInt(42)) }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("x"), null, init_ptr))
    s.check_stmt(&var ctx)
    val ty = ctx.lookup("x")
    when (ty.kind) {
        Int32 => assert(true, "x is Int32")
        _ => fail("expected x: Int32")
    }
}

@test fun an_unannotated_string_literal_binds_a_str(): void {
    var ctx = mk_stmt_ctx()
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init_ptr = Expr.new(Span.none(), ExprKind.LitStr(String.from("hi"))) }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("s"), null, init_ptr))
    s.check_stmt(&var ctx)
    assert_eq(ctx.lookup("s").kind.kind_tag(), TAG_STR(), "s is a str until a use needs more")
}

// Without `String`, the literal stays `str`.
@test fun let_val_str_literal_stays_str_when_string_is_not_visible(): void {
    var ctx = mk_ctx_without_string()
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init_ptr = Expr.new(Span.none(), ExprKind.LitStr(String.from("hi"))) }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("s"), null, init_ptr))
    s.check_stmt(&var ctx)
    val ty = ctx.lookup("s")
    when (ty.kind) {
        StrTy => assert(true, "s is str")
        _ => fail("expected s: str")
    }
    val node = unsafe { *init_ptr }
    when (node.kind) {
        LitStr(_) => assert(true, "the literal is left as written")
        _ => fail("expected the raw literal, not a String.from call")
    }
}

// A `String` slot decides the binding and rewrites its literal.
@test fun a_string_slot_rewrites_an_open_literal_to_from_literal(): void {
    var ctx = mk_stmt_ctx()
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init_ptr = Expr.new(Span { file_id: 1, start: 4, end: 8 }, ExprKind.LitStr(String.from("hi"))) }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("s"), null, init_ptr))
    s.check_stmt(&var ctx)
    var read = Expr.new(Span { file_id: 1, start: 20, end: 21 }, ExprKind.Variable(intern("s")))
    check_expr(&var read, &var ctx)
    val _decided = read.apply_expected(ctx.string_name().lang_struct_ty(Span.none()), &var ctx)
    val node = unsafe { *init_ptr }
    when (node.kind) {
        MethodCall(_recv, name, _args) => assert_eq(name.as_str(), "from_literal", "pointed at, not copied")
        _ => fail("expected a String.from_literal call")
    }
}

// `val a: str = "hi"`: the node records Coercion.ToCStr.
@test fun let_val_str_annotation_records_cstr_coerce(): void {
    var ctx = mk_stmt_ctx()
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init_ptr = Expr.new(Span.none(), ExprKind.LitStr(String.from("hi"))) }
    val ty_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ty_ref = TypeRef.new(Span.none(), TypeRefKind.Named(intern("str"), List.new<TypeRef>())) }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("a"), ty_ref, init_ptr))
    s.check_stmt(&var ctx)
    val ty = ctx.lookup("a")
    when (ty.kind) {
        StrTy => assert(true, "a is str from annotation")
        _ => fail("expected a: str")
    }
    val node = unsafe { *init_ptr }
    assert_eq(node.coerce == Coercion.ToCStr, true, "literal records Coercion.ToCStr")
}

// `val a: String = "hi"` converts the literal.
@test fun let_val_string_annotation_rewrites_to_from_literal(): void {
    var ctx = mk_stmt_ctx()
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init_ptr = Expr.new(Span.none(), ExprKind.LitStr(String.from("hi"))) }
    val ty_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ty_ref = TypeRef.new(Span.none(), TypeRefKind.Named(intern("String"), List.new<TypeRef>())) }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("a"), ty_ref, init_ptr))
    s.check_stmt(&var ctx)
    val node = unsafe { *init_ptr }
    when (node.kind) {
        MethodCall(_recv, name, _args) => assert_eq(name.as_str(), "from_literal", "a String slot takes the literal")
        _ => fail("expected a String.from_literal call")
    }
}

@test fun variable_use_after_let_resolves(): void {
    var ctx = mk_stmt_ctx()
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init_ptr = Expr.new(Span.none(), ExprKind.LitInt(7)) }
    var let_s = Stmt.new(Span.none(), StmtKind.LetVal(intern("x"), null, init_ptr))
    let_s.check_stmt(&var ctx)

    var use_e = Expr.new(Span.none(), ExprKind.Variable(intern("x")))
    check_expr(&var use_e, &var ctx)
    when (use_e.ty.kind) {
        Int32 => assert(true, "x resolves to Int32")
        _ => fail("expected Int32 for x")
    }
}

@test fun let_val_with_annotation_uses_declared(): void {
    var ctx = mk_stmt_ctx()
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init_ptr = Expr.new(Span.none(), ExprKind.LitInt(42)) }
    val ty_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ty_ref = TypeRef.new(Span.none(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())) }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("x"), ty_ref, init_ptr))
    s.check_stmt(&var ctx)
    val ty = ctx.lookup("x")
    when (ty.kind) {
        Int32 => assert(true, "x is Int32 from annotation")
        _ => fail("expected x: Int32")
    }
}

@test fun let_val_annotation_mismatch_produces_poison(): void {
    var ctx = mk_stmt_ctx()
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init_ptr = Expr.new(Span.none(), ExprKind.LitInt(42)) }
    val ty_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ty_ref = TypeRef.new(Span.none(), TypeRefKind.Named(intern("bool"), List.new<TypeRef>())) }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("x"), ty_ref, init_ptr))
    s.check_stmt(&var ctx)
    val ty = ctx.lookup("x")
    assert_eq(ty.is_poison(), true, "mismatch produces poison")
}

@test fun unknown_variable_remains_poison(): void {
    var ctx = mk_stmt_ctx()
    var e = Expr.new(Span.none(), ExprKind.Variable(intern("ghost")))
    check_expr(&var e, &var ctx)
    assert_eq(e.ty.is_poison(), true, "unknown variable is poison")
}

@test fun return_checks_inner_expr(): void {
    var ctx = mk_stmt_ctx()
    val ep: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ep = Expr.new(Span.none(), ExprKind.LitInt(42)) }
    var s = Stmt.new(Span.none(), StmtKind.Return(ret_op(ep)))
    s.check_stmt(&var ctx)
    // Was poison; now Int32.
    val after = unsafe { *ep }
    when (after.ty.kind) {
        Int32 => assert(true, "ok")
        _ => fail("expected Int32 written to inner expr")
    }
}

@test fun when_variant_arm_binds_payload(): void {
    var ctx = mk_stmt_ctx()
    val sp = ctx.sigs
    // enum R { Ok(int32), Err }
    var vs = List.new<VariantInfo>()
    var ok_p = List.new<Type>()
    ok_p.push(Type.new_int32(Span.none()))
    vs.push(VariantInfo { name: String.from("Ok"), payloads: ok_p })
    vs.push(VariantInfo { name: String.from("Err"), payloads: List.new<Type>() })
    unsafe { sp.insert_enum(EnumLayout { name: String.from("R"), variants: vs, owner_crate: CrateId.new_poison() }) }
    // subject r: R
    ctx.declare(String.from("r"), Type { kind: TypeKind.EnumTy(intern("R")), provenance: Provenance.Declared(Span.none()) })
    val subj_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *subj_ptr = Expr.new(Span.none(), ExprKind.Variable(intern("r"))) }
    // arm: Ok(n) => let x = n
    val pat_ptr: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    var payloads = List.new<Pattern>()
    val n_pat_payload: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *n_pat_payload = Pattern.new(Span.none(), PatternKind.Identifier(intern("n"))) }
    payloads.push(unsafe { *n_pat_payload })
    unsafe { *pat_ptr = Pattern.new(Span.none(), PatternKind.Variant(intern("Ok"), payloads)) }
    val ip: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ip = Expr.new(Span.none(), ExprKind.Variable(intern("n"))) }
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.LetVal(intern("x"), null, ip)))
    var arms = List.new<Arm>()
    arms.push(Arm.new(Span.none(), pat_ptr, null, body))
    // A wildcard arm keeps the `when` exhaustive, so the count only reflects
    // the binder.
    arms.push(catch_all_arm())
    var s = Stmt.new(Span.none(), StmtKind.When(subj_ptr, arms))
    s.check_stmt(&var ctx)
    // Probed through diagnostics: the arm's bindings are gone after it ends.
    // A clean list means `n` was bound.
    assert_eq(ctx.diag_count_of(), 0, "the payload binder `n` resolved inside the arm")
}

// With the subject typed `Struct("R")`, as enums actually resolve.
@test fun when_variant_arm_binds_payload_struct_subject(): void {
    var ctx = mk_stmt_ctx()
    val sp = ctx.sigs
    var vs = List.new<VariantInfo>()
    var ok_p = List.new<Type>()
    ok_p.push(Type.new_int32(Span.none()))
    vs.push(VariantInfo { name: String.from("Ok"), payloads: ok_p })
    vs.push(VariantInfo { name: String.from("Err"), payloads: List.new<Type>() })
    unsafe { sp.insert_enum(EnumLayout { name: String.from("R"), variants: vs, owner_crate: CrateId.new_poison() }) }
    ctx.declare(String.from("r"), Type { kind: TypeKind.Struct(intern("R")), provenance: Provenance.Declared(Span.none()) })
    val subj_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *subj_ptr = Expr.new(Span.none(), ExprKind.Variable(intern("r"))) }
    val pat_ptr: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    var payloads = List.new<Pattern>()
    val n_pat_payload: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *n_pat_payload = Pattern.new(Span.none(), PatternKind.Identifier(intern("n"))) }
    payloads.push(unsafe { *n_pat_payload })
    unsafe { *pat_ptr = Pattern.new(Span.none(), PatternKind.Variant(intern("Ok"), payloads)) }
    val ip: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ip = Expr.new(Span.none(), ExprKind.Variable(intern("n"))) }
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.LetVal(intern("x"), null, ip)))
    var arms = List.new<Arm>()
    arms.push(Arm.new(Span.none(), pat_ptr, null, body))
    arms.push(catch_all_arm())
    var s = Stmt.new(Span.none(), StmtKind.When(subj_ptr, arms))
    s.check_stmt(&var ctx)
    assert_eq(ctx.diag_count_of(), 0, "the payload binder resolved under a Struct-typed subject")
}

/// The control: an unbound name in an arm body does report.
@test fun when_arm_body_reports_an_unbound_name(): void {
    var ctx = mk_stmt_ctx()
    val subj_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *subj_ptr = Expr.new(Span.none(), ExprKind.LitBool(true)) }
    val pat_ptr: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pat_ptr = Pattern.new(Span.none(), PatternKind.Wildcard) }
    val ip: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ip = Expr.new(Span.none(), ExprKind.Variable(intern("nothing_bound_this"))) }
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.LetVal(intern("x"), null, ip)))
    var arms = List.new<Arm>()
    arms.push(Arm.new(Span.none(), pat_ptr, null, body))
    var s = Stmt.new(Span.none(), StmtKind.When(subj_ptr, arms))
    s.check_stmt(&var ctx)
    assert_eq(ctx.diag_count_of() > 0, true, "an unbound name in an arm body is reported")
}

@test fun if_arm_checks_body_stmts(): void {
    var ctx = mk_stmt_ctx()
    val cp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cp = Expr.new(Span.none(), ExprKind.LitBool(true)) }
    val ip: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ip = Expr.new(Span.none(), ExprKind.LitInt(1)) }
    var then_body = List.new<Stmt>()
    then_body.push(Stmt.new(Span.none(), StmtKind.LetVal(intern("y"), null, ip)))
    val else_body = List.new<Stmt>()
    var s = Stmt.new(Span.none(), StmtKind.If(cp, then_body, else_body))
    s.check_stmt(&var ctx)
    val ty = ctx.lookup("y")
    when (ty.kind) {
        Int32 => assert(true, "y declared from then-body")
        _ => fail("expected y: Int32")
    }
}

/// A `_ => {}` arm, so only the diagnostics under test appear. Not
/// `wildcard_arm`, which `exhaustive_test.kf` defines in the same test unit.
fun catch_all_arm(): Arm {
    val pat: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pat = Pattern.new(Span.none(), PatternKind.Wildcard) }
    return Arm.new(Span.none(), pat, null, List.new<Stmt>())
}

fun TypeCtx.diag_count_of(): uint64 {
    return unsafe { (*self.diags).size() }
}

@test fun val_reassign_errors_var_ok(): void {
    var ctx = mk_stmt_ctx()
    ctx.declare_val(String.from("x"), Type.new_int32(Span.none()))
    val rhs: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs = Expr.new(Span.none(), ExprKind.LitInt(2)) }
    var s = Stmt.new(Span.none(), StmtKind.Assign(intern("x"), rhs))
    s.check_stmt(&var ctx)
    assert_eq(ctx.diag_count_of(), 1, "reassigning a val errors")

    var ctx2 = mk_stmt_ctx()
    ctx2.declare(String.from("y"), Type.new_int32(Span.none()))
    val rhs2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs2 = Expr.new(Span.none(), ExprKind.LitInt(2)) }
    var s2 = Stmt.new(Span.none(), StmtKind.Assign(intern("y"), rhs2))
    s2.check_stmt(&var ctx2)
    assert_eq(ctx2.diag_count_of(), 0, "reassigning a var is fine")
}

@test fun list_push_on_val_receiver_errors(): void {
    var ctx = mk_stmt_ctx()
    ctx.declare_val(String.from("xs"), Type { kind: TypeKind.Struct(intern("List__int32")), provenance: Provenance.Declared(Span.none()) })
    val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv = Expr.new(Span.none(), ExprKind.Variable(intern("xs"))) }
    var args = List.new<Expr>()
    args.push(Expr.new(Span.none(), ExprKind.LitInt(1)))
    var e = Expr.new(Span.none(), ExprKind.MethodCall(recv, intern("push"), args))
    check_expr(&var e, &var ctx)
    assert_eq(ctx.diag_count_of(), 1, "push on val receiver errors")

    var ctx2 = mk_stmt_ctx()
    ctx2.declare(String.from("xs"), Type { kind: TypeKind.Struct(intern("List__int32")), provenance: Provenance.Declared(Span.none()) })
    val recv2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv2 = Expr.new(Span.none(), ExprKind.Variable(intern("xs"))) }
    var args2 = List.new<Expr>()
    args2.push(Expr.new(Span.none(), ExprKind.LitInt(1)))
    var e2 = Expr.new(Span.none(), ExprKind.MethodCall(recv2, intern("push"), args2))
    check_expr(&var e2, &var ctx2)
    assert_eq(ctx2.diag_count_of(), 0, "push on var receiver is fine")

    // `get` is fine on a val receiver.
    var ctx3 = mk_stmt_ctx()
    ctx3.declare_val(String.from("xs"), Type { kind: TypeKind.Struct(intern("List__int32")), provenance: Provenance.Declared(Span.none()) })
    val recv3: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv3 = Expr.new(Span.none(), ExprKind.Variable(intern("xs"))) }
    var args3 = List.new<Expr>()
    args3.push(Expr.new(Span.none(), ExprKind.LitInt(0)))
    var e3 = Expr.new(Span.none(), ExprKind.MethodCall(recv3, intern("get"), args3))
    check_expr(&var e3, &var ctx3)
    assert_eq(ctx3.diag_count_of(), 0, "get on val receiver is fine")
}

// A `mutating` method needs a mutable receiver; `&var T` is one even as `val`.
@test fun sig_mutating_method_needs_mutable_receiver(): void {
    var ctx = mk_stmt_ctx()
    val sp = ctx.sigs
    var params = List.new<Type>()
    params.push(Type { kind: TypeKind.Struct(intern("Foo")), provenance: Provenance.Declared(Span.none()) })
    unsafe { sp.insert(FnSignature { name: String.from("Foo_bump"), params: params, ret: Type.new_void(Span.none()), generics: List.new<String>(), is_static: false, is_mutating: true, owner_module: intern(""), owner_crate: CrateId.new_poison(), is_pub: true, borrows: 0 - 1, is_prelude: false, is_extern: false }) }
    ctx.declare_val(String.from("f"), Type { kind: TypeKind.Struct(intern("Foo")), provenance: Provenance.Declared(Span.none()) })
    val recv: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv = Expr.new(Span.none(), ExprKind.Variable(intern("f"))) }
    var e = Expr.new(Span.none(), ExprKind.MethodCall(recv, intern("bump"), List.new<Expr>()))
    check_expr(&var e, &var ctx)
    assert_eq(ctx.diag_count_of(), 1, "mutating method on val receiver errors")

    var ctx2 = mk_stmt_ctx()
    val sp2 = ctx2.sigs
    var params2 = List.new<Type>()
    params2.push(Type { kind: TypeKind.Struct(intern("Foo")), provenance: Provenance.Declared(Span.none()) })
    unsafe { sp2.insert(FnSignature { name: String.from("Foo_bump"), params: params2, ret: Type.new_void(Span.none()), generics: List.new<String>(), is_static: false, is_mutating: true, owner_module: intern(""), owner_crate: CrateId.new_poison(), is_pub: true, borrows: 0 - 1, is_prelude: false, is_extern: false }) }
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = Type { kind: TypeKind.Struct(intern("Foo")), provenance: Provenance.Declared(Span.none()) } }
    ctx2.declare_val(String.from("f"), Type { kind: TypeKind.RefTo(true, inner), provenance: Provenance.Declared(Span.none()) })
    val recv2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv2 = Expr.new(Span.none(), ExprKind.Variable(intern("f"))) }
    var e2 = Expr.new(Span.none(), ExprKind.MethodCall(recv2, intern("bump"), List.new<Expr>()))
    check_expr(&var e2, &var ctx2)
    assert_eq(ctx2.diag_count_of(), 0, "mutating method through &var is fine")
}

// `self.field = v` needs a mutating method.
@test fun assign_to_self_field_respects_mutating(): void {
    var ctx = mk_stmt_ctx()
    ctx.declare_val(String.from("self"), Type { kind: TypeKind.Struct(intern("Foo")), provenance: Provenance.Declared(Span.none()) })
    val svar: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *svar = Expr.new(Span.none(), ExprKind.Variable(intern("self"))) }
    val place: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *place = Expr.new(Span.none(), ExprKind.FieldAccess(svar, intern("n"))) }
    val rhs: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs = Expr.new(Span.none(), ExprKind.LitInt(1)) }
    var s = Stmt.new(Span.none(), StmtKind.AssignTo(place, rhs))
    s.check_stmt(&var ctx)
    assert_eq(ctx.diag_count_of(), 1, "self.field = v errors in non-mutating body")

    var ctx2 = mk_stmt_ctx()
    ctx2.declare(String.from("self"), Type { kind: TypeKind.Struct(intern("Foo")), provenance: Provenance.Declared(Span.none()) })
    val svar2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *svar2 = Expr.new(Span.none(), ExprKind.Variable(intern("self"))) }
    val place2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *place2 = Expr.new(Span.none(), ExprKind.FieldAccess(svar2, intern("n"))) }
    val rhs2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs2 = Expr.new(Span.none(), ExprKind.LitInt(1)) }
    var s2 = Stmt.new(Span.none(), StmtKind.AssignTo(place2, rhs2))
    s2.check_stmt(&var ctx2)
    assert_eq(ctx2.diag_count_of(), 0, "self.field = v is fine in a mutating body")
}

@test fun assign_through_shared_ref_errors(): void {
    var ctx = mk_stmt_ctx()
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = Type.new_int32(Span.none()) }
    ctx.declare(String.from("p"), Type { kind: TypeKind.RefTo(false, inner), provenance: Provenance.Declared(Span.none()) })
    val pvar: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *pvar = Expr.new(Span.none(), ExprKind.Variable(intern("p"))) }
    val place: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *place = Expr.new(Span.none(), ExprKind.Deref(pvar)) }
    val rhs: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs = Expr.new(Span.none(), ExprKind.LitInt(1)) }
    var s = Stmt.new(Span.none(), StmtKind.AssignTo(place, rhs))
    s.check_stmt(&var ctx)
    assert_eq(ctx.diag_count_of(), 1, "store through &T errors")

    var ctx2 = mk_stmt_ctx()
    val inner2: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner2 = Type.new_int32(Span.none()) }
    ctx2.declare(String.from("p"), Type { kind: TypeKind.RefTo(true, inner2), provenance: Provenance.Declared(Span.none()) })
    val pvar2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *pvar2 = Expr.new(Span.none(), ExprKind.Variable(intern("p"))) }
    val place2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *place2 = Expr.new(Span.none(), ExprKind.Deref(pvar2)) }
    val rhs2: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *rhs2 = Expr.new(Span.none(), ExprKind.LitInt(1)) }
    var s2 = Stmt.new(Span.none(), StmtKind.AssignTo(place2, rhs2))
    s2.check_stmt(&var ctx2)
    assert_eq(ctx2.diag_count_of(), 0, "store through &var T is fine")
}

// An unannotated let recovers the borrow from the parser's tag.
fun let_with_tag(tag: Coercion): TypeCtx {
    var ctx = mk_stmt_ctx()
    ctx.declare(String.from("xs"), Type.new_int32(Span.none()))
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    var init = Expr.new(Span.none(), ExprKind.Variable(intern("xs")))
    init.coerce = tag
    unsafe { *init_ptr = init }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("b"), null, init_ptr))
    s.check_stmt(&var ctx)
    return ctx
}

@test fun an_inferred_borrow_binds_a_reference(): void {
    val ctx = let_with_tag(Coercion.WrittenAmp)
    val ty = ctx.lookup("b")
    when (ty.kind) {
        RefTo(m, _inner) => assert_eq(m, false, "`&xs` binds `&T`, not `&var T`")
        _ => fail("expected b: &T")
    }
}

@test fun an_inferred_mutable_borrow_keeps_its_mutability(): void {
    val ctx = let_with_tag(Coercion.WrittenAmpVar)
    val ty = ctx.lookup("b")
    when (ty.kind) {
        RefTo(m, _inner) => assert_eq(m, true, "`&var xs` binds `&var T`")
        _ => fail("expected b: &var T")
    }
}

@test fun an_untagged_binding_still_binds_by_value(): void {
    val ctx = let_with_tag(Coercion.Identity)
    val ty = ctx.lookup("b")
    when (ty.kind) {
        Int32 => assert(true, "no `&` written, no borrow")
        _ => fail("expected b: int32")
    }
}

// The borrow type lands on the init node too, for codegen.
@test fun the_borrow_type_lands_on_the_init_node_too(): void {
    var ctx = mk_stmt_ctx()
    ctx.declare(String.from("xs"), Type.new_int32(Span.none()))
    val init_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    var init = Expr.new(Span.none(), ExprKind.Variable(intern("xs")))
    init.coerce = Coercion.WrittenAmp
    unsafe { *init_ptr = init }
    var s = Stmt.new(Span.none(), StmtKind.LetVal(intern("b"), null, init_ptr))
    s.check_stmt(&var ctx)
    val node = unsafe { *init_ptr }
    when (node.ty.kind) {
        RefTo(_m, _inner) => assert(true, "the init node carries the borrow type")
        _ => fail("expected the init node to be typed &T")
    }
    assert_eq(node.coerce, Coercion.AddrOf, "and codegen is told to take the address")
}

@test fun a_field_place_is_named_by_its_path(): void {
    val holder = Box.new(Expr.new(Span.none(), ExprKind.Variable(intern("h"))))
    val place = Expr.new(Span.none(), ExprKind.FieldAccess(holder, intern("item")))
    assert_eq(place.place_text().as_str(), "h.item", "a field reads as its path")
}

@test fun a_deref_place_is_named_with_its_star(): void {
    val pointer = Box.new(Expr.new(Span.none(), ExprKind.Variable(intern("p"))))
    val place = Expr.new(Span.none(), ExprKind.Deref(pointer))
    assert_eq(place.place_text().as_str(), "*p", "a deref reads as `*p`")
}

@test fun an_unnamed_place_is_this_place(): void {
    val place = Expr.new(Span.none(), ExprKind.LitInt(1))
    assert_eq(place.place_text().as_str(), "this place", "anything else is unnamed")
}
