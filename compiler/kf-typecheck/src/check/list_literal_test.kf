import core.assert.assert_eq

import kf_core.span.Span
import kf_typecheck.types.note_open_call
import kf_typecheck.types.report_open_calls
import testing.test

@test fun an_empty_literal_no_use_types_is_reported_as_a_literal(): void {
    var ctx = mk_ctx()
    val span = Span { file_id: 1, start: 4, end: 6 }
    note_open_call(span, String.from("List"), String.from("new"), &var ctx)
    ctx.list_literals.push(span)
    ctx.report_open_calls()
    val repair = "annotate the binding (`val xs: List<int32> = []`), or push to it first"
    val expected = "cannot tell what `[]` holds — ${repair}"
    assert_eq(unsafe { (*ctx.diags).at(0).primary.message.as_str() }, expected, "the literal, not `List.new()`")
}
