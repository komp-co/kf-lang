// `while x in &xs`: the borrowing loop. `next()` yields `Option<T>`, a deep
// clone and drop per element for move-only elements; `next_ptr()` yields the
// element's address, or null when exhausted, and the binder `*p` is a view.

import kf_core.span.*
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.Coercion
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.diagnostic.Label
import kf_core.diagnostic.Diagnostic
import kf_core.intern.Sym
import kf_core.intern.intern
import kf_typecheck.types.kind_tag
import kf_typecheck.types.TAG_GENERIC

/// From the loop's span, so nested loops do not collide.
pub fun foreach_tag(span: Span): String {
    val fid_str = "${span.file_id}"
    val start_str = "${span.start}"
    val tag = "${fid_str.as_str()}_${start_str.as_str()}"
    return tag
}

/// `while name in &subject { body }` becomes:
///
///     if true {
///         val __forsrc_N = subject          (only for a temporary, which then drops)
///         var __forit_N = (&__forsrc_N).iter()
///         while true {
///             val __forptr_N = __forit_N.next_ptr()
///             if ptr_is_null(__forptr_N) { break }
///             val name = *__forptr_N
///             body
///         }
///     }
/// `temporary` when the subject is a value nothing else owns.
fun expand_foreach_ref(
    binder: Sym, binder_at: Span, subj_ptr: Ptr<Expr>, temporary: bool, body: List<Stmt>, span: Span
): StmtKind {
    val tag = foreach_tag(span)
    val itname = "__forit_${tag}"
    val ptrname = "__forptr_${tag}"
    var outer = List.new<Stmt>()

    var iterated = subj_ptr
    if temporary {
        val srcname = intern("__forsrc_${tag}")
        unsafe { (*subj_ptr).coerce = Coercion.Identity }
        outer.push(Stmt.new(span, StmtKind.LetVal(srcname, null, subj_ptr)))
        var src = Expr.new(span, ExprKind.Variable(srcname))
        src.coerce = Coercion.WrittenAmp
        iterated = unsafe { alloc<Expr>() }
        unsafe { *iterated = src }
    }
    val iter_call_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *iter_call_ptr = Expr.new(span, ExprKind.MethodCall(iterated, intern("iter"), List.new<Expr>())) }
    val let_it = Stmt.new(span, StmtKind.LetVar(intern(itname), null, iter_call_ptr))

    val it_var_box: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *it_var_box = Expr.new(span, ExprKind.Variable(intern(itname))) }
    val next_ptr_call: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *next_ptr_call = Expr.new(span, ExprKind.MethodCall(it_var_box, intern("next_ptr"), List.new<Expr>())) }
    val let_ptr = Stmt.new(span, StmtKind.LetVal(intern(ptrname), null, next_ptr_call))

    // if ptr_is_null(__forptr_N) { break }
    var null_args = List.new<Expr>()
    null_args.push(Expr.new(span, ExprKind.Variable(intern(ptrname))))
    val null_test: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *null_test = Expr.new(span, ExprKind.Call(intern("ptr_is_null"), null_args)) }
    var brk_body = List.new<Stmt>()
    brk_body.push(Stmt.new(span, StmtKind.Break))
    val if_stmt = Stmt.new(span, StmtKind.If(null_test, brk_body, List.new<Stmt>()))

    // val name = *__forptr_N
    val ptr_var_box: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ptr_var_box = Expr.new(span, ExprKind.Variable(intern(ptrname))) }
    val deref: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *deref = Expr.new(span, ExprKind.Deref(ptr_var_box)) }
    // Empty, as the counted loop's: the binding is the compiler's, not written.
    val head = Span { file_id: span.file_id, start: span.start, end: span.start }
    var let_binder = Stmt.new(head, StmtKind.LetVal(binder, null, deref))
    let_binder.binder = binder_at

    var while_body = List.new<Stmt>()
    while_body.push(let_ptr)
    while_body.push(if_stmt)
    while_body.push(let_binder)
    while item in &body {
        while_body.push(item)
    }
    val while_cond: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *while_cond = Expr.new(span, ExprKind.LitBool(true)) }
    val while_stmt = Stmt.new(span, StmtKind.While(while_cond, while_body))

    outer.push(let_it)
    outer.push(while_stmt)
    val outer_cond: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *outer_cond = Expr.new(span, ExprKind.LitBool(true)) }
    return StmtKind.If(outer_cond, outer, List.new<Stmt>())
}

/// A value nothing else owns, which the loop must drop: a call's result that
/// is not a borrow, or a literal.
fun Expr.is_owned_temporary(): bool {
    if self.ty.is_poison() { return false }
    val by_value = when (self.ty.kind) {
        RefTo(_m, _p) => false
        _ => true
    }
    return by_value && when (self.kind) {
        Call(_n, _a) => !self.is_variant_ctor
        MethodCall(_r, _m, _a) => !self.is_variant_ctor
        CallValue(_c, _a) => true
        StructLit(_n, _f) => true
        _ => false
    }
}

/// Asked before expansion, so the diagnostic names the written loop.
pub fun Type.borrowing_iterator_exists(ctx: &var TypeCtx): bool {
    // `next_ptr()` is in no trait, so a bound cannot promise it.
    if self.iterable_subject_ty().kind.kind_tag() == TAG_GENERIC() { return false }
    val iter_name = self.subject_iterator_name(ctx)
    if iter_name.as_str().equals("") { return true }
    val sp = ctx.sigs
    var probe = iter_name.clone()
    probe.append("_next_ptr")
    return unsafe { sp.find_signature(probe) }.is_some()
}

/// "" when the table cannot say, and nothing is claimed.
fun Type.subject_iterator_name(ctx: &var TypeCtx): String {
    val base = ty_base_name(&self.iterable_subject_ty())
    if base.as_str().equals("") { return String.from("") }
    val sp = ctx.sigs
    val bound = unsafe { sp.lookup_assoc_binding(base, "Iter") }
    if bound.is_poison() { return String.from("") }
    return mangle_base_name(bound.ty_base_name())
}

pub fun Type.report_no_borrowing_iterator(binder: Sym, span: Span, ctx: &var TypeCtx): void {
    val subject = self.iterable_subject_ty()
    if subject.kind.kind_tag() == TAG_GENERIC() {
        val why = "`while ${binder.as_str()} in &...` needs a borrowing iterator, which a trait bound"
        val message = "${why} cannot promise; drop the `&` to iterate by value"
        ctx.emit(Diagnostic.new(Severity.Error, Label.new(span, message)))
        return
    }
    val iter_name = self.subject_iterator_name(ctx)
    var msg = String.from("`while ")
    msg.append(binder.as_string().as_str())
    msg.append(" in &...` needs a borrowing iterator, and `")
    msg.append(iter_name)
    msg.append("` has no `next_ptr()`. Give it `mutating fun next_ptr(): Ptr<T>` answering the element's address and null when exhausted, or drop the `&` to iterate by value")
    ctx.emit(Diagnostic.new(Severity.Error, Label.new(span, msg)))
}

/// Iterated through the bound.
pub fun Type.bounded_by_iterable(ctx: &var TypeCtx): bool {
    return when (self.kind) {
        Generic(name) => {
            val iterable = ctx.lang_trait_name(LangItem.Iterable).as_string()
            owner_has_bound(ctx.fn_owner.clone(), name.as_string(), iterable, ctx)
        }
        _ => false
    }
}
