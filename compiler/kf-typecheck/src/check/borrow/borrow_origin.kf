// Where a returned borrow comes from: `self` on an instance method,
// otherwise the single borrow parameter, read off the signature. With no
// borrow parameter the origin is `static` (a literal). A returned borrow of a
// binding the function owns is rejected.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic

/// A literal, or a value from somewhere the caller cannot observe.
pub fun borrow_origin_static(): int32 {
    return 0 - 1
}

/// `str`, `&T` and `&var T`: bounded by another frame.
pub fun Type.type_is_borrow(): bool {
    when (self.kind) {
        StrTy => return true
        RefTo(_, _) => return true
        _ => return false
    }
}

/// An index into `params` (`self` is 0 on an instance method), or static.
pub fun infer_borrow_origin(params: &List<Type>, ret: &Type, has_self: bool): int32 {
    if !ret.type_is_borrow() { return borrow_origin_static() }
    if has_self { return 0 }
    var found = borrow_origin_static()
    while i in 0..params.size() {
        val p = *params.at(i)
        if p.type_is_borrow() {
            // Two candidates: reported by the signature check, which has the
            // span.
            if found != borrow_origin_static() { return borrow_origin_static() }
            found = i as int32
        }
    }
    return found
}

/// Two or more is rejected outright.
pub fun borrow_candidate_count(params: &List<Type>): uint64 {
    var n: uint64 = 0
    while p in &params {
        if p.type_is_borrow() { n = n + 1 }
    }
    return n
}

/// A returned borrow that could come from two parameters cannot be named
/// without lifetime syntax, so it is rejected; return an owned value or an
/// index instead.
pub fun reject_unsayable_origin(params: &List<Type>, ret: &Type, has_self: bool, span: Span, ctx: &var TypeCtx): void {
    if !ret.type_is_borrow() { return }
    if has_self { return }
    if borrow_candidate_count(params) < 2 { return }
    val message = String.from("cannot tell which parameter this borrow comes from: more than one could be its origin, and the origin cannot be written down — return an owned value or an index instead")
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}

/// `return <owned local>` read as a borrow outlives the local. A local that
/// is itself a borrow is fine.
pub fun Expr.check_returned_borrow(span: Span, ctx: &var TypeCtx): void {
    if !ctx.return_ty.type_is_borrow() { return }
    val root = expr_borrow_root(self)
    if root.as_str() == "" { return }
    if ctx.ctx_is_param(root.as_str()) { return }
    if !ctx.is_declared(root.as_str()) { return }
    val bound = ctx.lookup(root.as_str())
    if bound.type_is_borrow() { return }
    val message = "cannot return a borrow of `${root.as_str()}`: it is owned by this function and is dropped at the return"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
}

fun TypeCtx.ctx_is_param(name: str): bool {
    while param in &self.params {
        if param.as_str() == name { return true }
    }
    return false
}
