// Named arguments and defaults: a call's written arguments become one per
// parameter, in the parameters' order, before its arity is checked.

import alloc.list.*

import kf_core.span.Span
import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.empty_list_literal_receiver
import kf_core.ast.CrateId
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.Param
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.display_type

/// The callee whose parameters a call's arguments are arranged against.
pub struct ArgumentTarget {
    /// The signature name the parameters are recorded under.
    pub val callee: String
    /// As the call writes it, for messages.
    pub val shown: String
    /// The arguments the call passes in all, receivers included.
    pub val arity: uint64
    pub val owner_crate: CrateId
    pub val owner_module: Sym
    /// The signature's parameter types, receivers included.
    pub val types: List<Type>
}

/// `args`, with `types` beside them, rearranged to the target's parameters,
/// each one left out filled from its default. False, reported, when an
/// argument names no parameter, a parameter is given twice, a positional
/// argument follows a named one, or one without a default is left out under
/// named arguments. A plain positional call is left to the arity check.
pub fun arrange_arguments(args: &var List<Expr>, types: &var List<Type>, target: &ArgumentTarget, span: Span,
    ctx: &var TypeCtx): bool {
    val names = ctx.take_argument_names(span)
    val named = names.size() > 0
    val recorded = ctx.sig_table().param_lists.get(&target.callee)
    if recorded == null {
        if !named { return true }
        return call_argument_error(span, "`${target.shown}` takes no named arguments", ctx)
    }
    val listed = recorded ?: return true
    val params = listed.clone()
    if args.size() < target.arity - params.size() { return true }
    val receivers = target.arity - params.size()
    val written = args.size() - receivers
    if !named && (written >= params.size() || !params.defaults_cover(written)) { return true }
    var slots = List.new<int64>()
    while _p in &params { slots.push(-1) }
    var next: uint64 = 0
    while i in receivers..args.size() {
        val name = names.name_at(i - receivers)
        val at = args.at(i).span
        if name.as_str().byte_len() == 0 {
            if next != i - receivers {
                return call_argument_error(at, "a positional argument cannot follow a named one", ctx)
            }
            if next >= params.size() { return true }
            slots.set(next, i as int64)
            next = next + 1
            continue
        }
        val found = params.index_named(name)
        if found == null {
            return call_argument_error(at, "`${target.shown}` has no parameter `${name.as_str()}`", ctx)
        }
        val index = found ?: return false
        if slots.get(index) >= 0 { return call_argument_error(at, "`${name.as_str()}` is given twice", ctx) }
        slots.set(index, i as int64)
        next = params.size() + 1
    }
    var arranged = List.new<Expr>()
    var arranged_types = List.new<Type>()
    while i in 0..receivers {
        arranged.push(args.at(i).clone())
        arranged_types.push(types.at(i).clone())
    }
    var missing = List.new<String>()
    while j in 0..params.size() {
        val slot = slots.get(j)
        if slot >= 0 {
            var moved = args.at(slot as uint64).clone()
            moved.arg_name = intern("")
            arranged.push(moved)
            arranged_types.push(types.at(slot as uint64).clone())
        } else {
            val default = params.at(j).default_value(target, receivers + j, ctx)
            if default == null {
                missing.push(params.at(j).name.as_string())
            } else {
                val filled = default ?: continue
                arranged_types.push(filled.ty.clone())
                arranged.push(filled)
            }
        }
    }
    if missing.size() > 0 { return call_argument_error(span, "`${target.shown}` needs ${missing.quoted_list()}", ctx) }
    *args = arranged
    *types = arranged_types
    return true
}

/// `arrange_arguments` against this signature, leaving out `receivers` it
/// counts and the call does not pass.
pub fun FnSignature.arrange_call_arguments(args: &var List<Expr>, types: &var List<Type>, shown: String,
    receivers: uint64, span: Span, ctx: &var TypeCtx): bool {
    val target = ArgumentTarget {
        callee: self.name.clone(), shown: shown, arity: self.params.size() - receivers, owner_crate: self.owner_crate,
        owner_module: self.owner_module, types: self.params.slice_from(receivers)
    }
    return arrange_arguments(args, types, &target, span, ctx)
}

/// A function's parameters as calls may name them: without a receiver, which
/// an extension declares as `self`.
pub mutating fun SigTable.record_params(name: str, params: &List<Param>): void {
    var declared = List.new<Param>()
    while param in params {
        if declared.size() == 0 && param.name.as_str() == "self" { continue }
        declared.push(param.clone())
    }
    self.param_lists.insert(String.from(name), declared)
}

/// Reports a default that is not a constant of the parameter's type `ty`: a
/// literal, `null`, `[]`, an enum variant or a top-level `val`.
pub fun Param.check_default(ty: Type, ctx: &var TypeCtx): void {
    val written = self.default ?: return
    var value = (*written).clone()
    if !value.is_constant_default(ctx) {
        val message = "a default is a constant: a literal, `null`, `[]`, an enum variant or a top-level `val`"
        ctx.emit(new_diagnostic(Severity.Error, new_label(value.span, message)))
        return
    }
    if !value.is_bare_null() { check_local_initializer(&var value, ctx) }
    if value.ty.is_poison() && !value.is_bare_null() { return }
    if value.expect_or_reject(ty.clone(), ctx) { return }
    val name = self.name.as_str()
    val shown = value.ty.display_type(ctx)
    val message = "the default of `${name}` is `${shown}`, but `${name}` is `${ty.display_type(ctx)}`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(value.span, message)))
}

fun Expr.is_constant_default(ctx: &var TypeCtx): bool {
    if self.is_constant_literal() { return true }
    return when (self.kind) {
        Variable(name) => name.as_str() == "null" || name.as_str().names_constant(ctx)
        FieldAccess(owner, _variant) => when (owner.kind) {
            Variable(_type_name) => true
            _ => false
        }
        MethodCall(receiver, _method, _args) => when (receiver.kind) {
            Variable(name) => name.as_str() == empty_list_literal_receiver()
            _ => false
        }
        _ => false
    }
}

/// The default, typed where the callee is declared, so it may name what that
/// module sees and nothing of the caller's. Poison when the declaration
/// reports it.
fun Param.default_value(target: &ArgumentTarget, slot: uint64, ctx: &var TypeCtx): Expr? {
    val written = self.default ?: return null
    var value = (*written).clone()
    if !value.is_constant_default(ctx) || slot >= target.types.size() {
        value.ty = Type.new_poison()
        return value
    }
    val file = ctx.owner_file
    val crate = ctx.owner_crate
    val module = ctx.owner_module
    ctx.owner_file = value.span.file_id
    ctx.owner_crate = target.owner_crate
    ctx.owner_module = target.owner_module
    if !value.is_bare_null() { check_local_initializer(&var value, ctx) }
    val typed = !value.ty.is_poison() || value.is_bare_null()
    if !typed || !value.expect_or_reject(target.types.at(slot).clone(), ctx) { value.ty = Type.new_poison() }
    ctx.owner_file = file
    ctx.owner_crate = crate
    ctx.owner_module = module
    return value
}

fun List<Type>.slice_from(start: uint64): List<Type> {
    var out = List.new<Type>()
    while i in start..self.size() { out.push(self.at(i).clone()) }
    return out
}

pub fun List<Expr>.argument_types(): List<Type> {
    var types = List.new<Type>()
    while argument in &self { types.push(argument.ty.clone()) }
    return types
}

/// A call naming an argument, checked with its names recorded for the callee
/// to arrange; false for anything else, which the caller checks.
pub mutating fun Expr.check_named_call(ctx: &var TypeCtx): bool {
    val names = self.argument_names()
    if names.size() == 0 || ctx.names_arguments(self.span) { return false }
    val span = self.span
    ctx.named_calls.push(NamedCall { span: span, names: names })
    check_expr_kind(self, ctx)
    ctx.reject_unarranged_names(span)
    return true
}

/// The names of a call's written arguments, by position, if any is named.
pub fun Expr.argument_names(): List<Sym> {
    return when (self.kind) {
        Call(_name, args) => names_of_arguments(&args)
        MethodCall(_receiver, _name, args) => names_of_arguments(&args)
        CallValue(_callee, args) => names_of_arguments(&args)
        _ => List.new<Sym>()
    }
}

fun names_of_arguments(args: &List<Expr>): List<Sym> {
    var names = List.new<Sym>()
    var any = false
    while argument in &args {
        if argument.arg_name.as_str().byte_len() > 0 { any = true }
        names.push(argument.arg_name)
    }
    if !any { return List.new<Sym>() }
    return names
}

/// The names `check_expr` recorded for the call at `span`, now arranged; none
/// when it named nothing.
pub mutating fun TypeCtx.take_argument_names(span: Span): List<Sym> {
    var names = List.new<Sym>()
    var kept = List.new<NamedCall>()
    while call in &self.named_calls {
        if call.span.same_as(span) { names = call.names.clone() } else { kept.push(call.clone()) }
    }
    self.named_calls = kept
    return names
}

/// Whether the call at `span` names an argument.
pub fun TypeCtx.names_arguments(span: Span): bool {
    while call in &self.named_calls {
        if call.span.same_as(span) { return true }
    }
    return false
}

fun List<Sym>.name_at(i: uint64): Sym {
    if i < self.size() { return self.get(i) }
    return intern("")
}

/// Whether `callee` declares a default for every parameter from `written` on.
pub fun SigTable.defaults_cover(callee: str, written: uint64): bool {
    val params = self.param_lists.get(&String.from_literal(callee)) ?: return false
    return written < params.size() && params.defaults_cover(written)
}

/// Whether every parameter from `written` on has a default.
fun List<Param>.defaults_cover(written: uint64): bool {
    while j in written..self.size() {
        if self.at(j).default == null { return false }
    }
    return true
}

fun List<Param>.index_named(name: Sym): uint64? {
    while j in 0..self.size() {
        if self.at(j).name.id == name.id { return j }
    }
    return null
}

/// `` `a` `` or `` `a` and `b` `` or `` `a`, `b` and `c` ``.
fun List<String>.quoted_list(): String {
    var out = String.from("")
    while i in 0..self.size() {
        if i > 0 { out.append(if i + 1 == self.size() { " and " } else { ", " }) }
        out.append("`${self.at(i).as_str()}`")
    }
    return out
}

fun call_argument_error(span: Span, message: String, ctx: &var TypeCtx): bool {
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
    return false
}

/// Reported when a call no declared parameter list arranged, such as one
/// through a function value, named an argument.
pub mutating fun TypeCtx.reject_unarranged_names(span: Span): void {
    val names = self.take_argument_names(span)
    while name in &names {
        if name.as_str().byte_len() > 0 {
            val message = "`${name.as_str()} =` names a parameter, but this call takes its arguments by position"
            val _reported = call_argument_error(span, message, self)
            return
        }
    }
}
