import core.assert.assert_eq
import testing.test

@test fun equal_to_null_tests_for_none(): void {
    assert_eq(BinOp.Eq.null_comparison_method(), "is_none", "`== null` is `is_none`")
}

@test fun not_equal_to_null_tests_for_some(): void {
    assert_eq(BinOp.NotEq.null_comparison_method(), "is_some", "`!= null` is `is_some`")
}

@test fun an_ordering_has_no_null_comparison(): void {
    assert_eq(BinOp.Lt.null_comparison_method(), "", "`<` against null is not a tag test")
}
