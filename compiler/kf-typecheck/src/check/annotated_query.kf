// `annotated<bench>()`: every declaration of this crate marked `@bench`,
// private ones included, as a list literal the checker then types. A
// function target lists
//
//     AnnotatedFunction<bench, F> { name, module, args: bench { ... }, function: f }
//
// and a kind target `AnnotatedItem<bench> { name, module, kind, args }`,
// `kind` an `AnnotatedKind` variant.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.note_import_use_named
import kf_typecheck.find_annotation

pub fun annotated_prefix(): str { return "annotated__" }

/// CONSTRAINT: by name until a release's seed knows a lang key for them.
fun entry_type_name(target: &MarkTarget): str {
    return when (target) {
        Function(_ty) => "AnnotatedFunction"
        _ => "AnnotatedItem"
    }
}

pub mutating fun Expr.expand_annotated(args: &List<Expr>, ctx: &var TypeCtx): void {
    val sigs = unsafe { &*ctx.sigs }
    val index = self.queried_annotation(args, sigs, ctx) ?: return
    val declared = sigs.annotations.at(index)
    var elements = List.new<Expr>()
    while listed in &sigs.annotated {
        if listed.annotation == index { elements.push(annotated_entry(&listed, &declared, self.span, ctx)) }
    }
    var new_call = collection_new_call(self.span, ctx.list_name())
    new_call.type_args.push(new_type_ref(self.span, TypeRefKind.Named(intern(entry_type_name(&declared.target)),
        entry_type_args(&declared, self.span))))
    new_call.type_args_written = true
    *self = collection_literal_expr(self.span, &elements, new_call)
    check_expr(self, ctx)
}

/// The queried annotation's index in `SigTable.annotations`; null, reported
/// and typed poison, when the query names none this file sees.
mutating fun Expr.queried_annotation(args: &List<Expr>, sigs: &SigTable, ctx: &var TypeCtx): uint64? {
    val name = self.single_type_name()
    val message = if name.as_str().equals("") {
        String.from("`annotated` takes one annotation name: `annotated<bench>()`")
    } else if args.size() > 0 {
        String.from("`annotated` takes no arguments")
    } else {
        val found = sigs.find_annotation(name.as_str(), ctx.owner_file, ctx.owner_crate, ctx.owner_module)
        if found != null {
            val index = found ?: return null
            val declared = sigs.annotations.at(index)
            note_import_use_named(ctx.sigs, ctx.owner_file, declared.module, declared.name)
            return index
        }
        "cannot find annotation `${name.as_str()}` in this scope"
    }
    ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
    self.ty = poison_ty()
    return null
}

/// The one bare name in `<...>`, or the empty name.
fun Expr.single_type_name(): Sym {
    if self.type_args.size() != 1 { return intern("") }
    return when (self.type_args.at(0).kind) {
        Named(name, args) => if args.size() == 0 { name } else { intern("") }
        _ => intern("")
    }
}

/// `<bench, (Request) -> Response>` for a function target, `<bench>` for a
/// kind target.
fun entry_type_args(declared: &DeclaredAnnotation, span: Span): List<TypeRef> {
    var args = List.new<TypeRef>()
    args.push(new_type_ref(span, TypeRefKind.Named(declared.name, List.new<TypeRef>())))
    when (declared.target) {
        Function(ty) => args.push((*ty).clone())
        _ => {}
    }
    return args
}

/// One entry. A function is named directly, not looked up: a private
/// function of another module is listed too.
fun annotated_entry(listed: &AnnotatedItem, declared: &DeclaredAnnotation, span: Span, ctx: &var TypeCtx): Expr {
    var fields = List.new<FieldInit>()
    fields.push(string_field("name", listed.item.as_str(), span))
    fields.push(string_field("module", listed.module.as_str(), span))
    val arguments = arguments_literal(listed, declared, span)
    fields.push(FieldInit { span: span, name: intern("args"), value: Box.new(arguments) })
    when (declared.target) {
        Function(_ty) => {
            var reference = new_expr(span, ExprKind.FnRef(listed.item))
            reference.ty = declared.function_type.clone()
            ctx.note_fn_type(&reference.ty)
            fields.push(FieldInit { span: span, name: intern("function"), value: Box.new(reference) })
        }
        _ => {
            val kind_type = new_expr(span, ExprKind.Variable(intern("AnnotatedKind")))
            val variant = new_expr(span, ExprKind.FieldAccess(Box.new(kind_type), listed.kind.variant_name()))
            fields.push(FieldInit { span: span, name: intern("kind"), value: Box.new(variant) })
        }
    }
    var entry = new_expr(span, ExprKind.StructLit(intern(entry_type_name(&declared.target)), fields))
    entry.type_args = entry_type_args(declared, span)
    entry.type_args_written = true
    return entry
}

fun string_field(name: str, value: str, span: Span): FieldInit {
    val literal = new_expr(span, ExprKind.LitStr(String.from(value)))
    return FieldInit { span: span, name: intern(name), value: Box.new(literal) }
}

/// `bench { iterations: 1000, label: "sort" }`, each value where the use
/// wrote it, so a type mismatch points there.
fun arguments_literal(listed: &AnnotatedItem, declared: &DeclaredAnnotation, span: Span): Expr {
    var fields = List.new<FieldInit>()
    while i in 0..declared.params.size() {
        val value = listed.args.at(i).clone()
        fields.push(FieldInit { span: value.span, name: declared.params.at(i).name, value: Box.new(value) })
    }
    return new_expr(span, ExprKind.StructLit(declared.name, fields))
}

fun MarkKind.variant_name(): Sym {
    return when (self) {
        Function => intern("Function")
        Struct => intern("Struct")
        Enum => intern("Enum")
        Trait => intern("Trait")
    }
}
