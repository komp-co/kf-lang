// A string literal bound without a type is a `str` until a use needs more: a
// `String` slot or method, a slot of a type converting from `str`, or a store
// of such a value. A `str` use decides nothing, since a `String` serves it,
// but it rules out the other types, which do not.

import kf_core.ast.*
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.type_eq
import kf_typecheck.types.display_type
import kf_typecheck.types.TAG_STR
import kf_typecheck.types.kind_tag

/// What a slot asks of an open string binding; None when a `str` serves it.
fun Type.text_target(ctx: &var TypeCtx): Type? {
    val target = autoderef_ty(self.clone())
    if target.is_lang_struct(ctx.string_name()) { return target }
    if target.is_nominal() && target.implements_from("str", ctx) { return target }
    return null
}

/// A slot deciding an open string binding. True only when it conflicts with
/// an earlier decision; otherwise the caller's coercions run on.
mutating fun Expr.narrow_open_text(expected: Type, ctx: &var TypeCtx): bool {
    val name = self.variable_name()
    if name.byte_len() == 0 { return false }
    if autoderef_ty(expected.clone()).kind.kind_tag() == TAG_STR() {
        if ctx.open_init(name.as_str()) != null { ctx.narrow_binding(name.as_str(), self.span) }
        return false
    }
    val target = expected.text_target(ctx) ?: return false
    val init_ptr = ctx.open_init(name.as_str()) ?: return self.conflicts_with_text_decision(target, ctx)
    if !target.is_lang_struct(ctx.string_name()) && self.conflicts_with_str_use(&target, ctx) { return true }
    self.settle_open_text(init_ptr, target, ctx)
    return false
}

/// A type that is not text, after a use needed a `str`, which it cannot serve.
mutating fun Expr.conflicts_with_str_use(target: &Type, ctx: &var TypeCtx): bool {
    val name = self.variable_name()
    val narrowed_at = ctx.binding_narrowed_at(name.as_str())
    if narrowed_at.is_none() { return false }
    val shown = target.display_type(ctx)
    val message = "`${name}` cannot be `${shown}` here: an earlier use needs it as a `str`, which `${shown}` is not"
    var diagnostic = new_diagnostic(Severity.Error, new_label(self.span, message))
    diagnostic.secondary.push(new_label(narrowed_at, "used as a `str` here"))
    ctx.emit(diagnostic)
    self.ty = poison_ty()
    return true
}

/// `s.append(...)` on an open string binding: a method a `String` has and a
/// `str` does not decides it.
mutating fun Expr.narrow_open_text_receiver(method: str, ctx: &var TypeCtx): void {
    val name = self.variable_name()
    if name.byte_len() == 0 || ctx.string_name().as_str() == "" { return }
    val init_ptr = ctx.open_init(name.as_str()) ?: return
    if type_has_method_named("str", method, ctx) { return }
    if !type_has_method_named(ctx.string_name().as_str(), method, ctx) { return }
    self.settle_open_text(init_ptr, ctx.string_name().lang_struct_ty(self.span), ctx)
}

mutating fun Expr.settle_open_text(init_ptr: Ptr<Expr>, target: Type, ctx: &var TypeCtx): void {
    val init: &var Expr = unsafe { &var *init_ptr }
    if init.string_literal_text() == null || self.ty.type_eq(target) { return }
    if self.decides_on_recheck(init.span, target.clone(), ctx) { return }
    if !init.apply_expected(target.clone(), ctx) || !init.ty.type_eq(target) { return }
    ctx.decide_binding(self.variable_name().as_str(), target.clone(), self.span)
    self.ty = target
}

/// A slot asking another type than the one an earlier use decided.
mutating fun Expr.conflicts_with_text_decision(target: Type, ctx: &var TypeCtx): bool {
    if self.ty.text_target(ctx) == null { return false }
    return self.conflicts_with_decision(target, ctx)
}
