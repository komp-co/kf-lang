// A bound must name a declared trait, and naming one is a use of its module.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_core.ast.intern
import kf_core.diagnostic.*
import kf_typecheck.import_was_used
import kf_typecheck.new_sig_table
import testing.test

fun bounds_table(): Ptr<SigTable> {
    val sp: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sp = new_sig_table() }
    return sp
}

fun declare_trait(sp: Ptr<SigTable>, name: str, module: str): void {
    unsafe { sp.insert_trait(TraitInfo { name: String.from(name), identity: intern(name), module: intern(module), span: no_span(), type_params: List.new<String>(), methods: List.new<TraitMethodReq>(), assoc_types: List.new<TraitAssocReq>(), supertraits: List.new<SuperTraitReq>() }) }
}

fun bind(sp: Ptr<SigTable>, owner: str, param: str, trait_name: str, file: uint32): void {
    unsafe { sp.insert_bound(BoundInfo { owner: String.from(owner), param: String.from(param), trait_name: String.from(trait_name), trait_args: "", arg_names: List.new<String>(), span: Span { file_id: file, start: 10, end: 15 } }) }
}

fun declare_trait_with_params(sp: Ptr<SigTable>, name: str, params: List<String>): void {
    unsafe { sp.insert_trait(TraitInfo {
        name: String.from(name), identity: intern(name), module: intern("core"), span: no_span(),
        type_params: params, methods: List.new<TraitMethodReq>(),
        assoc_types: List.new<TraitAssocReq>(), supertraits: List.new<SuperTraitReq>()
    }) }
}

fun bind_with_args(sp: Ptr<SigTable>, owner: str, param: str, trait_name: str, args: List<String>): void {
    unsafe { sp.insert_bound(BoundInfo {
        owner: String.from(owner), param: String.from(param), trait_name: String.from(trait_name),
        trait_args: "", arg_names: args, span: Span { file_id: 1, start: 10, end: 15 }
    }) }
}

@test fun a_bound_naming_no_trait_is_reported(): void {
    val sp = bounds_table()
    bind(sp, "smaller", "T", "Bogus", 1)
    assert_eq(unknown_bound_diags(sp).size(), 1, "`Bogus` does not exist, and the bound is where it is written")
}

@test fun a_bound_naming_a_declared_trait_is_silent(): void {
    val sp = bounds_table()
    declare_trait(sp, "Compare", "core.compare")
    bind(sp, "smaller", "T", "Compare", 1)
    assert_eq(unknown_bound_diags(sp).size(), 0, "the ordinary case")
}

@test fun the_diagnostic_points_at_the_bound(): void {
    val sp = bounds_table()
    bind(sp, "smaller", "T", "Bogus", 7)
    val d = *unknown_bound_diags(sp).at(0)
    assert_eq(d.primary.span.file_id, 7, "the file the bound was written in, not a call site's")
    assert_eq(d.primary.span.start, 10, "the offset of the bound itself")
}

@test fun the_message_names_the_missing_trait(): void {
    val sp = bounds_table()
    bind(sp, "smaller", "T", "Bogus", 1)
    val d = *unknown_bound_diags(sp).at(0)
    assert_eq(d.primary.message.contains("Bogus"), true, "the typo is what the reader has to find")
}

@test fun each_unknown_bound_is_reported_once(): void {
    val sp = bounds_table()
    bind(sp, "smaller", "T", "Bogus", 1)
    bind(sp, "larger", "U", "AlsoBogus", 1)
    assert_eq(unknown_bound_diags(sp).size(), 2, "two bounds, two typos")
}

@test fun a_bound_marks_its_traits_module_used(): void {
    val sp = bounds_table()
    declare_trait(sp, "Compare", "core.compare")
    bind(sp, "smaller", "T", "Compare", 3)
    val _d = unknown_bound_diags(sp)
    assert_eq(import_was_used(sp, 3, intern("core.compare")), true, "the book tells you to write that import")
}

@test fun a_bound_marks_only_its_own_file(): void {
    val sp = bounds_table()
    declare_trait(sp, "Compare", "core.compare")
    bind(sp, "smaller", "T", "Compare", 3)
    val _d = unknown_bound_diags(sp)
    assert_eq(import_was_used(sp, 4, intern("core.compare")), false, "another file's import is not used by this bound")
}

@test fun an_unknown_bound_marks_nothing_used(): void {
    val sp = bounds_table()
    bind(sp, "smaller", "T", "Bogus", 3)
    val _d = unknown_bound_diags(sp)
    assert_eq(import_was_used(sp, 3, intern("Bogus")), false, "there is no module to have used")
}

@test fun a_bound_with_the_wrong_arity_is_reported(): void {
    val sp = bounds_table()
    var params = List.new<String>()
    params.push(String.from("A"))
    declare_trait_with_params(sp, "Call1", params)
    var args = List.new<String>()
    args.push(String.from("A"))
    args.push(String.from("B"))
    args.push(String.from("C"))
    bind_with_args(sp, "apply", "F", "Call1", args)
    assert_eq(unknown_bound_diags(sp).size(), 1, "a one-argument trait handed three")
}

@test fun a_bound_with_the_right_arity_is_silent(): void {
    val sp = bounds_table()
    var params = List.new<String>()
    params.push(String.from("A"))
    declare_trait_with_params(sp, "Call1", params)
    var args = List.new<String>()
    args.push(String.from("int32"))
    bind_with_args(sp, "apply", "F", "Call1", args)
    assert_eq(unknown_bound_diags(sp).size(), 0, "the ordinary case")
}
