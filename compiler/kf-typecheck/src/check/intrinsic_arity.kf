// How many arguments each memory intrinsic takes. Codegen reads them by
// position, so a call short of one stops here.

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.error_at

/// Reports a call to `intrinsic` with `found` arguments when that is not its
/// arity; true when it did.
fun report_intrinsic_arity(intrinsic: Intrinsic, found: uint64, span: Span, ctx: &var TypeCtx): bool {
    val wanted = intrinsic.arity()
    if wanted < 0 || found == wanted as uint64 { return false }
    ctx.emit(error_at(span, "wrong number of arguments to `${intrinsic.name()}`: expected ${wanted}, found ${found}"))
    return true
}
