import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.diagnostic.*

fun table_with_one_untyped_call(): Ptr<SigTable> {
    val sigs: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sigs = new_sig_table() }
    record_untyped_receiver(no_span(), "get", sigs)
    return sigs
}

@test fun an_untyped_receiver_is_reported_when_nothing_else_was(): void {
    val sigs = table_with_one_untyped_call()
    val nothing = List.new<Diagnostic>()
    val diags = untyped_receiver_diags(sigs, &nothing)
    assert_eq(diags.size(), 1, "the call cannot be emitted, and no error says why")
}

@test fun an_untyped_receiver_is_silent_behind_a_reported_error(): void {
    val sigs = table_with_one_untyped_call()
    var found = List.new<Diagnostic>()
    val label = new_label(no_span(), String.from("no method `next` on `int32`"))
    found.push(new_diagnostic(Severity.Error, label))
    val diags = untyped_receiver_diags(sigs, &found)
    assert_eq(diags.size(), 0, "that error is the explanation")
}
