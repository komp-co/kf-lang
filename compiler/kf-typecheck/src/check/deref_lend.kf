// A value lends itself through its `Deref` or `DerefMut` impl: a receiver
// whose own type lacks the method, and an argument whose slot wants the
// target, read as `x.deref()` or `x.deref_mut()`.

import kf_core.ast.lang_deref_key
import kf_core.ast.lang_deref_mut_key
import kf_core.ast.types.Type
import kf_core.ast.expression.Expr
import kf_core.ast.expression.coerce_none
import kf_typecheck.types.type_eq
import kf_typecheck.types.nominal_name
import kf_typecheck.traits.receiver_declares_trait_method

/// How many lends one receiver may chain through.
val DEREF_CHAIN_LIMIT: uint64 = 8

/// `x.m()` where `x` has no `m` but a deref target down its chain does. The
/// chain is followed on a quiet copy first, so a receiver whose chain ends
/// without `m` is left as written and reported as itself.
mutating fun Expr.lend_receiver_through_deref(method: str, arity: uint64, ctx: &var TypeCtx): void {
    if self.ty.is_poison() || self.ty.answers(method, ctx) { return }
    if !self.ty.deref_one().implements_lang_trait(lang_deref_key(), ctx) &&
        !self.ty.deref_one().implements_lang_trait(lang_deref_mut_key(), ctx) {
        return
    }
    var trial = self.clone()
    val was_quiet = ctx.quiet
    ctx.quiet = true
    val reached = trial.deref_toward(method, arity, false, ctx)
    ctx.quiet = was_quiet
    if reached { self.deref_toward(method, arity, true, ctx) }
}

/// One lend per step until the receiver has `method`; false when the chain
/// ends first. The shared target serves an `m` that does not mutate, the
/// mutable one the rest; a target without `m` is followed further. A mutable
/// lend from a place that cannot lend one is reported only when `checked`.
mutating fun Expr.deref_toward(method: str, arity: uint64, checked: bool, ctx: &var TypeCtx): bool {
    while _ in 0..DEREF_CHAIN_LIMIT {
        if self.ty.is_poison() { return false }
        if self.ty.answers(method, ctx) { return true }
        val shared = self.lends_as(lang_deref_key(), "deref", ctx)
        val exclusive = self.lends_as(lang_deref_mut_key(), "deref_mut", ctx)
        if shared?.reads_through(method, arity, ctx) ?: false {
            self.become_lend_call("deref", ctx)
        } else if exclusive?.answers(method, ctx) ?: false {
            self.lend_mutably_through_deref(checked, ctx)
        } else if shared != null {
            self.become_lend_call("deref", ctx)
        } else if exclusive != null {
            self.lend_mutably_through_deref(checked, ctx)
        } else {
            return false
        }
    }
    return false
}

/// The target has `method`, and calling it leaves the target unchanged.
fun Type.reads_through(method: str, arity: uint64, ctx: &var TypeCtx): bool {
    return self.answers(method, ctx) && !self.method_is_mutating(String.from(method), arity, ctx)
}

/// `method` resolves on this type, through a borrow: its own, a trait's, or
/// an extension's. Every value answers `clone`.
fun Type.answers(method: str, ctx: &var TypeCtx): bool {
    if method == "clone" { return true }
    val base = autoderef_ty(self.clone())
    if base.has_method_named(method, ctx) { return true }
    if receiver_declares_trait_method(base.clone(), String.from(method), ctx) { return true }
    val name = base.kind.nominal_name()
    return name.byte_len() > 0 && type_has_method_named(name, method, ctx)
}

/// An argument whose slot is its deref target, and which no plain coercion
/// already fits: a `String` reaches a `str` slot without a call. True when the
/// node was rewritten.
mutating fun Expr.lend_through_deref(expected: &Type, ctx: &var TypeCtx): bool {
    if self.ty.is_poison() || self.ty.type_eq(*expected) { return false }
    if coerce_code_for(self.ty.clone(), false, expected.clone(), ctx.string_name()) != coerce_none() { return false }
    if self.lends_as(lang_deref_key(), "deref", ctx)?.type_eq(*expected) ?: false {
        self.become_lend_call("deref", ctx)
        return true
    }
    if !(self.lends_as(lang_deref_mut_key(), "deref_mut", ctx)?.type_eq(*expected) ?: false) { return false }
    self.lend_mutably_through_deref(true, ctx)
    return true
}

/// What `self.method()` would be, asked quietly, when the type implements the
/// lang trait `key`; `null` otherwise.
fun Expr.lends_as(key: str, method: str, ctx: &var TypeCtx): Type? {
    if !self.ty.deref_one().implements_lang_trait(key, ctx) { return null }
    var trial = self.clone()
    val was_quiet = ctx.quiet
    ctx.quiet = true
    trial.become_lend_call(method, ctx)
    ctx.quiet = was_quiet
    if trial.ty.is_poison() { return null }
    return trial.ty.clone()
}

/// `deref_mut()` needs a mutable place or a `&var` borrow; when `checked`,
/// anything else is reported and poisons the node.
mutating fun Expr.lend_mutably_through_deref(checked: bool, ctx: &var TypeCtx): void {
    val target = self.lends_as(lang_deref_mut_key(), "deref_mut", ctx) ?: return
    if checked && !self.lends_mutably(&target, ctx) {
        self.ty = Type.new_poison()
        return
    }
    self.become_lend_call("deref_mut", ctx)
}

/// An impl of the lang trait `key` names this type, by its template's name.
fun Type.implements_lang_trait(key: str, ctx: &var TypeCtx): bool {
    val trait_name = ctx.lang_trait_name(key)
    if trait_name.as_str().byte_len() == 0 { return false }
    val written = self.written_type_name(ctx)
    if written.as_str().byte_len() == 0 { return false }
    val base = mangle_base_name(written.as_string())
    while trait_impl in &ctx.sig_table().trait_impls {
        if trait_impl.type_name.as_str() == base.as_str() && trait_impl.trait_name.as_str() == trait_name.as_str() {
            return true
        }
    }
    return false
}

/// Its own method by that name, or an extension that fits it.
fun Type.has_method_named(method: str, ctx: &var TypeCtx): bool {
    if receiver_has_own_method(self.clone(), String.from(method), ctx) { return true }
    return has_extension_named(method, ctx) && fitting_extensions(method, self, ctx).size() > 0
}
