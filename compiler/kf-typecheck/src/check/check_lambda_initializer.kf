// A lambda initializing a local owns its captures. A nested lambda would be
// stored in an aggregate and stays rejected.
mutating fun Expr.check_local_initializer(ctx: &var TypeCtx): void {
    when (self.kind) {
        Lambda(_params, _body) => {
            ctx.in_local_lambda_binding = ctx.in_local_lambda_binding + 1
            check_expr(self, ctx)
            ctx.in_local_lambda_binding = ctx.in_local_lambda_binding - 1
        }
        _ => {
            check_expr(self, ctx)
            self.reject_stored_lambda_transfer("another binding", ctx)
        }
    }
}
