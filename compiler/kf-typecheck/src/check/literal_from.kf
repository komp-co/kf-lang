// A literal where a type converting from it is expected: `[a, b]` becomes the
// type's `from(E[N])` of an array built in place, and `"text"` its `from(str)`.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.subst.subst_type_ref
import kf_typecheck.types.note_open_call_typed
import kf_typecheck.types.resolve_type_ref
import kf_typecheck.types.type_eq
import kf_typecheck.types.type_to_type_ref

fun from_trait_name(): str { return "From" }

/// True when the literal was rewritten into the slot's `from` call.
mutating fun Expr.convert_list_literal_from(expected: Type, ctx: &var TypeCtx): bool {
    if !self.is_list_literal(ctx) || expected.is_poison() || self.ty.type_eq(expected) { return false }
    val element = expected.from_array_element(ctx) ?: return false
    val count = self.literal_elements().size()
    if count == 0 { return false }
    val span = self.span
    val array = array_type_ref(element.type_to_type_ref(span), count, ctx.array_name(), span).resolve_type_ref(ctx)
    if !self.retarget_array_literal(array, ctx) || self.ty.is_poison() { return true }
    note_open_call_typed(span, ctx)
    self.become_from_call(expected, ctx)
    return true
}

/// True when a string literal was rewritten into the slot's `from(str)`. The
/// lang string has its own rewrite.
mutating fun Expr.convert_string_literal_from(expected: Type, ctx: &var TypeCtx): bool {
    if self.string_literal_text() == null || !expected.is_nominal() { return false }
    if expected.str_slot_wants_string(ctx.string_name()) { return false }
    if !expected.implements_from("str", ctx) { return false }
    self.become_from_call(expected, ctx)
    return true
}

/// `Slot.from(self)`, checked.
mutating fun Expr.become_from_call(expected: Type, ctx: &var TypeCtx): void {
    val span = self.span
    var args = List.new<Expr>()
    args.push(self.clone())
    val receiver = Box.new(new_expr(span, ExprKind.Variable(expected.written_type_name(ctx))))
    var call = new_expr(span, ExprKind.MethodCall(receiver, intern("from"), args))
    val inst = expected.expected_inst(ctx)
    if inst != null {
        val found = inst ?: return
        call.type_args = found.args.clone()
        call.type_args_written = true
    }
    *self = call
    check_expr(self, ctx)
}

/// The element of the array `self` converts from through `From<E[N]>`, with
/// the slot's type arguments in place; None when there is no such impl, or
/// two disagree.
fun Type.from_array_element(ctx: &var TypeCtx): Type? {
    val written = self.written_type_name(ctx)
    if written.as_str().byte_len() == 0 { return null }
    val base = mangle_base_name(written.as_string())
    var slot_args = List.new<TypeRef>()
    val inst = self.expected_inst(ctx)
    if inst != null {
        val found = inst ?: return null
        slot_args = found.args.clone()
    }
    var element: Type? = null
    while trait_impl in &ctx.sig_table().trait_impls {
        if trait_impl.type_name.as_str() != base.as_str() || trait_impl.trait_name.as_str() != from_trait_name() {
            continue
        }
        val name = "${written.as_str()}_from__${from_trait_name()}__${trait_impl.trait_args}"
        val sig = ctx.sig_table().find_signature(name.as_str()) ?: continue
        if !sig.is_static || sig.params.size() != 1 { continue }
        val candidate = sig.params.at(0).array_element_for(&sig.generics, &slot_args, ctx) ?: continue
        if element != null {
            val prior = element ?: return null
            if !prior.type_eq(candidate) { return null }
        }
        element = Option.Some(candidate)
    }
    return element
}

/// `self`'s element when it is an array, with the first of `generics` (the
/// receiver's) replaced by `slot_args`.
fun Type.array_element_for(generics: &List<String>, slot_args: &List<TypeRef>, ctx: &var TypeCtx): Type? {
    val inst = self.expected_inst(ctx) ?: return null
    if inst.base.as_str() != ctx.array_name().as_str() || inst.args.size() != 2 { return null }
    if generics.size() < slot_args.size() { return null }
    var names = List.new<String>()
    while i in 0..slot_args.size() { names.push(generics.at(i).clone()) }
    var repls = slot_args.clone()
    return inst.args.at(0).subst_type_ref(&var names, &var repls).resolve_type_ref(ctx)
}

/// `self` implements `From<argument>`, named by its key.
fun Type.implements_from(argument: str, ctx: &var TypeCtx): bool {
    val written = self.written_type_name(ctx)
    if written.as_str().byte_len() == 0 { return false }
    val base = mangle_base_name(written.as_string())
    while trait_impl in &ctx.sig_table().trait_impls {
        if trait_impl.type_name.as_str() != base.as_str() { continue }
        if trait_impl.trait_name.as_str() == from_trait_name() && trait_impl.trait_args.as_str() == argument {
            return true
        }
    }
    return false
}
