import kf_core.span.*
import kf_core.ast.types.Type
import kf_core.diagnostic.Label
import kf_core.diagnostic.Diagnostic
import kf_typecheck.types.TAG_PTR
import kf_typecheck.types.kind_tag
import kf_typecheck.types.mangle_type
import kf_typecheck.types.display_type
import kf_typecheck.types.type_eq
import kf_typecheck.types.TAG_STRUCT
import kf_typecheck.types.struct_name

// Casts `as` refuses although C would perform them.

/// `opt as uint64` is rejected: it reads an enum's representation, and is
/// the shape a null-sentinel test takes after migration to an Option.
fun reject_enum_to_number_cast(from: Type, to: Type, span: Span, ctx: &var TypeCtx): void {
    if from.is_poison() { return }
    if !is_numeric(to) { return }
    if !from.type_is_enum_layout(ctx) { return }
    val msg = "`${mangle_type(from).as_str()}` is an enum and cannot be cast to a number — " +
        "test it with `.is_some()` / `.is_none()`, or match it"
    ctx.emit(Diagnostic.new(Severity.Error, Label.new(span, msg)))
}

/// An integer becomes an address only from `uint64`, the width of one; a
/// narrower integer would be widened into a pointer nobody took.
fun reject_integer_to_pointer_cast(from: &Type, to: &Type, span: Span, ctx: &var TypeCtx): void {
    if to.kind.kind_tag() != TAG_PTR() { return }
    if !is_integer_type(from.clone()) { return }
    val pointer_wide = when (from.kind) {
        UInt64 => true
        _ => false
    }
    if pointer_wide { return }
    val msg = "only a `uint64` casts to a pointer, and this is `${from.display_type(ctx)}`; " +
        "to take an address, write `(&x) as Ptr<T>`"
    ctx.emit(Diagnostic.new(Severity.Error, Label.new(span, msg)))
}

/// A struct is no number, and no number is a struct: C refuses the cast,
/// so it is refused here, with the field to read instead. A cast to the
/// type the value has is `redundant_cast`'s.
fun reject_struct_cast(from: &Type, to: &Type, span: Span, ctx: &var TypeCtx): void {
    if from.is_poison() || to.is_poison() || from.type_eq(to) { return }
    val shown_from = from.display_type(ctx)
    val shown_to = to.display_type(ctx)
    if from.type_is_struct_layout(ctx) {
        val msg = "`${shown_from}` is a struct and cannot be cast to `${shown_to}`: cast one of its fields"
        ctx.emit(Diagnostic.new(Severity.Error, Label.new(span, msg)))
    } else if to.type_is_struct_layout(ctx) {
        val msg = "`${shown_from}` cannot be cast to `${shown_to}`, a struct: construct it instead"
        ctx.emit(Diagnostic.new(Severity.Error, Label.new(span, msg)))
    }
}

/// A struct, not an enum: user types all resolve to `Struct(name)`.
fun Type.type_is_struct_layout(ctx: &var TypeCtx): bool {
    if self.kind.kind_tag() != TAG_STRUCT() { return false }
    val sp = ctx.sigs
    return unsafe { sp.find_struct(self.kind.struct_name(), ctx.owner_crate) }.is_some()
}
