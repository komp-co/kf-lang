// Resolving `recv.f` against a struct layout; on failure the field list can
// be offered.

import kf_core.span.*
import kf_core.ast.types.Type
import kf_core.diagnostic.Label
import kf_core.diagnostic.Diagnostic
import kf_typecheck.types.*

pub fun check_field_access(receiver_ty: Type, field_name: String, _span: Span, ctx: &var TypeCtx): Type {
    if receiver_ty.is_poison() { return Type.new_poison() }
    val recv_ty = autoderef_ty(receiver_ty)
    val tag = recv_ty.kind.kind_tag()
    if tag == TAG_GENERIC() {
        // An unbounded type parameter has no members.
        val lab = Label.new(_span, String.from("generic type parameter has no members (no bound)"))
        ctx.emit(Diagnostic.new(Severity.Error, lab))
        return Type.new_poison()
    }
    // A field read on an enum is decidable and wrong.
    if tag == TAG_ENUM() {
        emit_field_on_enum(recv_ty.kind.coerce_enum_name(), field_name, _span, ctx)
        return Type.new_poison()
    }
    // Asks the declared layout whatever the tag: `String` is a struct.
    val is_struct = when (recv_ty.kind) {
        Struct(_) => true
        _ => false
    }
    if !is_struct { return Type.new_poison() }
    val sname = recv_ty.kind.struct_name()
    val sp = ctx.sigs
    // An instance only ever named inside another's fields, `Pair<I, M>` holding
    // a `Residue<I, M>`, gets its layout on first use.
    recv_ty.register_returned_instance(_span, ctx)
    val layout = unsafe { sp.find_struct(sname, ctx.owner_crate) } ?: {
        // Enums resolve to Struct(name), so a missing struct layout may name a
        // known enum. An unmaterialized layout stays silent.
        if unsafe { sp.find_enum(sname, ctx.owner_crate) }.is_some() {
            emit_field_on_enum(sname, field_name, _span, ctx)
        }
        return Type.new_poison()
    }
    while f in &layout.fields {
        if f.name.as_str().equals(field_name) {
            return f.ty
        }
    }
    // The layout is here without the field: decidable. The earlier exits are
    // states a valid program passes through.
    emit_no_such_field(sname, recv_ty.display_type(ctx), field_name, &layout, _span, ctx)
    return Type.new_poison()
}

/// An enum has variants, not fields. This matters most for an optional: a
/// field read through `T?` must be a compile-time error.
fun emit_field_on_enum(ename: String, field_name: String, span: Span, ctx: &var TypeCtx): void {
    val sp = ctx.sigs
    var optional = false
    when (unsafe { sp.find_inst(ename) }) {
        Some(inst) => { optional = inst.base.as_str().equals(ctx.option_name().as_str()) }
        None => { }
    }
    var msg = String.from("the field `")
    msg.append(field_name)
    if optional {
        msg.append("` is read through an optional — unwrap it first with `?.`, `!!`, or a `when`")
    } else {
        msg.append("` is read on `")
        msg.append(ename)
        msg.append("`, which is an enum — its payload is reached by matching, not by a field")
    }
    ctx.emit(Diagnostic.new(Severity.Error, Label.new(span, msg)))
}

/// Usually a method without parentheses (`xs.size`), in which case the
/// message says so rather than offering a near miss.
/// `type_name` finds its methods; `shown` is how the message names it.
fun emit_no_such_field(type_name: String, shown: String, field_name: String, layout: &StructLayout, span: Span,
    ctx: &var TypeCtx): void {
    var msg = "no field `${field_name.as_str()}` on `${shown}`"
    if type_has_method_named(type_name, field_name, ctx) {
        msg.append(" — `")
        msg.append(field_name)
        msg.append("` is a method; call it as `")
        msg.append(field_name)
        msg.append("()`")
        ctx.emit(Diagnostic.new(Severity.Error, Label.new(span, msg)))
        return
    }
    val near_f = layout.nearest_field(field_name)
    if !near_f.as_str().equals("") {
        msg.append(" (did you mean `")
        msg.append(near_f)
        msg.append("`?)")
    }
    ctx.emit(Diagnostic.new(Severity.Error, Label.new(span, msg)))
}

/// One edit per four characters, as `nearest_method`: a wrong suggestion is
/// worse than none.
fun StructLayout.nearest_field(wanted: str): String {
    val wn = wanted.byte_len()
    if wn == 0 { return "" }
    var budget: uint64 = wn / 4
    if budget == 0 { budget = 1 }
    var best = ""
    var best_d = budget + 1
    while field in &self.fields {
        val cand = field.name
        val d = edit_distance(wanted, cand, best_d)
        if d < best_d {
            best_d = d
            best = cand.clone()
        }
    }
    return best
}
