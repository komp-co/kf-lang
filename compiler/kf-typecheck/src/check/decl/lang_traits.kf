import kf_core.ast.Module
import kf_typecheck.*

/// Which declared trait each `@lang(...)` key names.
pub fun Module.note_lang_traits(sig_ptr: Ptr<SigTable>): void {
    while td in &self.decls {
        when (td.kind) {
            TraitDecl(_members, _is_pub, _supers) => {
                val lkey = (&td).lang_key_of()
                if !lkey.is_empty() { unsafe { (*sig_ptr).note_lang_trait(lkey, td.name) } }
            }
            _ => {}
        }
    }
}
