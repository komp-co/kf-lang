// A default naming a top-level `val` holds its literal instead, so the
// interface carries a value any caller's crate can read.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.Sym
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TopDeclKind

/// A top-level `val` of the crate: where it is declared, and its literal.
struct ConstantLiteral {
    val module: Sym
    val name: Sym
    val value: Expr
}

pub mutating fun Module.inline_constant_defaults(): void {
    val constants = self.own_constants()
    if constants.size() == 0 { return }
    while i in 0..self.decls.size() {
        val td = self.decls.at_mut(i)
        if td.crate.raw != self.crate.raw || td.linkage.is_imported() { continue }
        td.inline_defaults(&constants)
    }
}

fun Module.own_constants(): List<ConstantLiteral> {
    var out = List.new<ConstantLiteral>()
    while td in &self.decls {
        if td.crate.raw != self.crate.raw { continue }
        when (td.kind) {
            Constant(_ty, value, _pub) => out.push(ConstantLiteral { module: td.module_path, name: td.name, value: *value })
            _ => {}
        }
    }
    return out
}

mutating fun TopDecl.inline_defaults(constants: &List<ConstantLiteral>): void {
    val module = self.module_path
    when (self.kind) {
        Function(params, ret, body, is_pub, is_unsafe, is_mutating, is_static) => {
            if params.any_default() {
                val inlined = params.with_constant_defaults(module, constants)
                self.kind = TopDeclKind.Function(inlined, ret, body, is_pub, is_unsafe, is_mutating, is_static)
            }
        }
        AnnotationDecl(params, target, is_pub) => {
            if params.any_default() {
                self.kind = TopDeclKind.AnnotationDecl(params.with_constant_defaults(module, constants), target, is_pub)
            }
        }
        ImplBlock(methods) => {
            var rewritten = methods
            while j in 0..rewritten.size() { rewritten.at_mut(j).inline_defaults(constants) }
            self.kind = TopDeclKind.ImplBlock(rewritten)
        }
        _ => {}
    }
}

fun List<Param>.any_default(): bool {
    while param in &self {
        if param.default != null { return true }
    }
    return false
}

fun List<Param>.with_constant_defaults(module: Sym, constants: &List<ConstantLiteral>): List<Param> {
    var out = List.new<Param>()
    while param in &self {
        var copied = param.clone()
        val written = param.default
        if written != null {
            val value = written ?: continue
            val literal = value.constant_literal(module, constants)
            if literal != null {
                val found = literal ?: continue
                copied.default = Box.new(found)
            }
        }
        out.push(copied)
    }
    return out
}

/// The literal of the constant `self` names: the one in `module`, else the
/// only one in the crate by that name.
fun Expr.constant_literal(module: Sym, constants: &List<ConstantLiteral>): Expr? {
    val name = when (self.kind) {
        Variable(name) => name
        _ => return null
    }
    var found: Expr? = null
    var matches = 0
    while constant in constants {
        if constant.name.id != name.id { continue }
        if constant.module.id == module.id { return constant.value.clone() }
        matches = matches + 1
        found = constant.value.clone()
    }
    return if matches == 1 { found } else { null }
}
