// `annotation bench(iterations: int32)` also declares `struct bench`, one
// field per parameter: the type of a use's arguments, and of the `args` an
// `annotated<bench>()` entry carries.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.declaration.*
import kf_core.ast.types.TypeRef
import kf_core.diagnostic.*
import kf_resolve.DeclTable

/// For every annotation whose struct is not here yet: a dependency's arrives
/// with its interface, unless the dependency is merged in as source. Each
/// struct enters `table` as resolution would have entered it, so a type may
/// name it. CONSTRAINT: before registration, so the struct is laid out like
/// any other.
pub mutating fun Module.expand_annotation_structs(table: &var DeclTable, diags: &var List<Diagnostic>): void {
    var synth = List.new<TopDecl>()
    while td in &self.decls {
        val own = td.crate.raw == self.crate.raw
        when (td.kind) {
            AnnotationDecl(params, _target, is_pub) => {
                if !own {
                    if !self.names_another_declaration(&td) { synth.push(td.argument_struct(&params, is_pub)) }
                } else if self.names_another_declaration(&td) {
                    val why = "an annotation's name is also the type of its arguments"
                    val message = "`${td.name.as_str()}` is already declared in this crate, and ${why}"
                    diags.push(new_diagnostic(Severity.Error, new_label(td.decl_name_span(), message)))
                } else {
                    synth.push(td.argument_struct(&params, is_pub))
                }
            }
            _ => {}
        }
    }
    while item in &synth {
        var registered = item
        registered.decl = table.register(&registered)
        self.decls.push(registered)
    }
}

/// Every name the struct would share C's namespace with: any other
/// declaration of the annotation's crate, in any module.
fun Module.names_another_declaration(annotation: &TopDecl): bool {
    while other in &self.decls {
        if other.crate.raw != annotation.crate.raw || other.name.id != annotation.name.id { continue }
        when (other.kind) {
            AnnotationDecl(_params, _target, _is_pub) => {}
            ImplBlock(_methods) => {}
            TraitImpl(_trait, _methods) => {}
            _ => return true
        }
    }
    return false
}

fun TopDecl.argument_struct(params: &List<Param>, is_pub: bool): TopDecl {
    var fields = List.new<Field>()
    var borrows = false
    while param in &params {
        if (*param.ty).names_str() { borrows = true }
        fields.push(new_field(param.span, param.name.as_string(), Box.new((*param.ty).clone()), false, is_pub))
    }
    var decl = new_top_decl(self.span, self.name.as_string(), TopDeclKind.Struct(fields, is_pub))
    decl.is_view = borrows
    decl.crate = self.crate
    decl.module_path = self.module_path
    decl.name_span = self.name_span
    return decl
}

fun TypeRef.names_str(): bool {
    return when (self.kind) {
        Named(name, args) => args.size() == 0 && name.as_str() == "str"
        _ => false
    }
}
