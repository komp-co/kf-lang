import kf_core.ast.types.Type
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*
import kf_core.span.Span
import kf_resolve.*
import kf_typecheck.*
import kf_typecheck.check.type_as_constant

/// Types a top-level `val` and registers it: a signature for lookup, and the
/// literal its uses become.
pub fun register_constant(td: &var TopDecl, sig_ptr: Ptr<SigTable>, diags: &var Diagnostics,
    table: Ptr<DeclTable>?): void {
    when (td.kind) {
        Constant(written, value, is_pub) => {
            val scope: Ptr<DeclTable>? = if td.linkage.is_imported() { null } else { table }
            var ctx = new_type_ctx(Type.new_void(Span.none()), diags, scope, sig_ptr)
            ctx.owner_crate = td.crate
            ctx.owner_module = td.module_path
            ctx.owner_file = td.span.file_id
            val ty = value.type_as_constant(&var *written, &var ctx)
            unsafe { sig_ptr.insert_constant(&td, is_pub || td.is_internal, ty, (*value).clone()) }
        }
        _ => { }
    }
}
