// A wildcard import supplying few names: writing them out is cheap and
// informative. One supplying many is a prelude and is left alone, so no
// allowlist is needed. A registered lint, so the terminal, `@allow`, kf.toml
// and the editor share one implementation.

import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_core.intern.*
import kf_typecheck.import_uses_of

fun narrow_threshold(): uint64 { return 3 }

/// Only when the rewrite is known to compile: not when the import supplies
/// nothing (`unused_import` owns that), more than the threshold, a name no
/// import line can spell, was written by the parser, or exports — the
/// module's own or the import's, whose names a narrowing would drop.
pub fun Module.wildcard_import_diags(sp: Ptr<SigTable>): List<Diagnostic> {
    var out = List.new<Diagnostic>()
    if self.crate.is_poison() { return out }
    val targets = unsafe { sp.imported_targets.clone() }
    val files = unsafe { sp.caller_files.clone() }
    if files.size() < self.imports.size() || targets.size() < self.imports.size() { return out }
    val own = self.own_files()
    while i in 0..self.imports.size() {
        val target = targets.get(i)
        val file = files.get(i)
        val imp = self.imports.at(i)
        if target.id != 0 && !imp.is_pub && contains_file(&own, file) && imp.wildcard && imp.is_written() {
            if !self.target_reexports(&targets, target) {
                val names = import_uses_of(sp, file, target)
                if narrowable(&names) {
                    out.push(imp.wildcard_import_warning(&names))
                }
            }
        }
    }
    return out
}

/// CONSTRAINT: a poison name is a method or type resolved without the import;
/// narrowing past one would not compile, so the whole import is left alone.
fun narrowable(names: &List<Sym>): bool {
    if names.size() == 0 { return false }
    if names.size() > narrow_threshold() { return false }
    while name in &names {
        if name.id == 0 { return false }
    }
    return true
}

/// `MaybeIncorrect`, as `unused_import`.
fun Import.wildcard_import_warning(names: &List<Sym>): Diagnostic {
    val module = import_path_text(&self.path)
    var msg = String.from("wildcard import `")
    msg.append(module)
    msg.append(".*` supplies ")
    if names.size() == 1 {
        msg.append("one name")
    } else {
        msg.append("${names.size()}".as_str())
        msg.append(" names")
    }
    msg.append("; name ")
    if names.size() == 1 { msg.append("it") } else { msg.append("them") }
    val replacement = named_import_lines(module, names)
    // CONSTRAINT: the title is built from a borrow before the replacement is
    // moved, or the fix carries freed bytes.
    var title = String.from("replace with ")
    title.append(replacement)
    val d = Diagnostic.lint_at("wildcard_import", self.span, msg)
    return with_fix_applic(d, self.span, replacement, title, Applicability.MaybeIncorrect)
}

/// `import a.b.one\nimport a.b.two`, in first-use order.
fun named_import_lines(module: str, names: &List<Sym>): String {
    var out = ""
    while i in 0..names.size() {
        if i > 0 { out.append("\n") }
        out.append("import ")
        out.append(module)
        out.append(".")
        out.append(names.get(i).as_str())
    }
    return out
}
