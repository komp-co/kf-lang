// Validates annotations, and adds the impls `@derive(Clone)` and
// `@derive(Copy)` stand for before registration: the compiler copies, so
// those two are its own, while core's `derive` templates write every other
// trait. The impl builders are in derive_synth.kf.

import kf_core.ast.*
import kf_core.ast.declaration.*
import kf_core.diagnostic.*
import kf_core.intern.*
import kf_core.lang.*
import kf_core.ast.annotation.*

pub fun Module.validate_annotations(diags: &var Diagnostics): void {
    while td in &self.decls {
        // Each annotation is judged on its own.
        while item in &td.annotations {
            td.validate_one_annotation(item, diags)
        }
        if td.crate.raw == self.crate.raw { td.validate_member_annotations(diags) }
    }
}

fun TopDecl.validate_one_annotation(annotation: &Annotation, diags: &var Diagnostics): void {
    val kind = annotation.name
    if kind.as_str().equals("") { return }
    // Any other name is a declared annotation, resolved once imports are.
    val info = AnnotationInfo.named(kind.as_str()) ?: return
    if !info.target.allows(self) {
        val message = "`@${kind.as_str()}` can only annotate ${info.target.phrase().as_str()}"
        diags.emit(Diagnostic.new(Severity.Error, Label.new(self.decl_name_span(), message)))
        return
    }
    when kind.as_str() {
        "lang" => self.validate_lang_annotation(diags)
        "prelude" => self.validate_prelude_annotation(diags)
        "allow" => self.validate_allow_names(&annotation.words(), diags)
        _ => { }
    }
}

/// An `@allow` naming no registered lint suppresses nothing silently.
fun TopDecl.validate_allow_names(names: &List<String>, diags: &var Diagnostics): void {
    while name in &names {
        if !LintInfo.exists(name.as_str()) {
            val message = "`@allow(...)` names no lint `${name}`"
            diags.emit(Diagnostic.new(Severity.Error, Label.new(self.decl_name_span(), message)))
        }
    }
}

pub mutating fun Module.expand_derives(): void {
    val clone_sym = self.lang_trait_name(LangItem.Clone)
    val cloned = self.types_with_impl_of(clone_sym)
    var synth = List.new<TopDecl>()
    while td in &self.decls {
        val options = (&td).annotation_words("derive")
        if !td.derives_copying() { continue }
        val copy = names_option(&options, "Copy")
        // Copy requires Clone, and a bitwise copy is already a correct clone,
        // so `@derive(Copy)` supplies the Clone impl unless one is written.
        if names_option(&options, "Clone") || (copy && !syms_contain(&cloned, td.name)) {
            synth.push(synth_clone_impl(td.name.as_string(), td.span, td.crate, td.module_path, clone_sym))
        }
        if copy {
            val copy_sym = self.lang_trait_name(LangItem.Copy)
            synth.push(synth_copy_impl(td.name.as_string(), td.span, td.decl_name_span(), td.crate, td.module_path,
                copy_sym))
        }
    }
    while item in &synth {
        self.decls.push(item)
    }
}

/// A struct or enum, which is what `Clone` and `Copy` are derived for.
fun TopDecl.derives_copying(): bool {
    return when (self.kind) {
        Struct(_fields, _pub) => true
        EnumDecl(_variants, _pub) => true
        _ => false
    }
}

/// The types in this module that already have an impl of `trait_sym`.
fun Module.types_with_impl_of(trait_sym: Sym): List<Sym> {
    var out = List.new<Sym>()
    while td in &self.decls {
        when (td.kind) {
            TraitImpl(tref, _methods) => {
                when (unsafe { tref.kind }) {
                    Named(name, _args) => { if name.id == trait_sym.id { out.push(td.name) } }
                    _ => { }
                }
            }
            _ => { }
        }
    }
    return out
}

fun names_option(options: &List<String>, name: str): bool {
    while option in options {
        if option.as_str().equals(name) { return true }
    }
    return false
}

fun syms_contain(names: &List<Sym>, name: Sym): bool {
    while each in names {
        if each.id == name.id { return true }
    }
    return false
}
