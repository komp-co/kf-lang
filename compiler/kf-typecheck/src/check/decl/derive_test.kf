// The synthesized impl carries the struct's crate and module path, or
// `T: Clone` misses it.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.annotation.Annotation
import kf_core.diagnostic.*
import testing.test
import kf_core.intern.*

fun derive_of(names: List<String>): Annotation {
    return Annotation.new(Span.none(), "derive", names)
}

fun allow_of(lint: str): Annotation {
    return Annotation.new(Span.none(), "allow", [String.from(lint)])
}

fun derived_struct_module(): Module {
    return derived_struct_module_with_annotation(Annotation.new(Span.none(), "derive", [String.from("Clone")]))
}

fun derived_struct_module_with_annotation(annotation: Annotation): Module {
    var m = Module.new(List.new<String>())
    val fields = List.new<Field>()
    var td = TopDecl.new(Span.none(), String.from("Config"), TopDeclKind.Struct(fields, true))
    td.crate = CrateId.new("app")
    td.module_path = intern("app.settings")
    td.annotations.push(annotation)
    m.decls.push(td)
    return m
}

fun Module.synthesized_impl(): TopDecl {
    while d in &self.decls {
        when (d.kind) {
            TraitImpl(_t, _ms) => { return d }
            _ => {}
        }
    }
    return TopDecl.new(Span.none(), "", TopDeclKind.Poison)
}

@test
fun a_derived_clone_is_synthesized_for_the_struct(): void {
    var m = derived_struct_module()
    m.expand_derives()
    val impl_decl = m.synthesized_impl()
    assert_eq(impl_decl.name.as_str().equals("Config"), true, "the impl is synthesized for the struct")
    assert_eq(impl_decl.module_path.as_str().equals("app.settings"), true, "in the struct's module")
    assert_eq(impl_decl.crate.raw == CrateId.new("app").raw, true, "and its crate")
}

@test
fun a_plain_struct_derives_nothing(): void {
    var m = Module.new(List.new<String>())
    var td = TopDecl.new(Span.none(), String.from("Bare"), TopDeclKind.Struct(List.new<Field>(), true))
    td.crate = CrateId.new("app")
    td.module_path = intern("app.settings")
    m.decls.push(td)
    m.expand_derives()
    assert_eq(m.decls.size(), 1, "no annotation means no synthesized impl")
}

@test
fun core_s_templates_derive_the_rest(): void {
    val written = derive_of([String.from("Default"), String.from("Equal"), String.from("Hash"), String.from("Clone")])
    var m = derived_struct_module_with_annotation(written)
    m.expand_derives()
    assert_eq(m.decls.size(), 2, "only `Clone` is the compiler's; core's templates write the others")
}

@test
fun enum_clone_derive_synthesizes_an_impl(): void {
    var m = Module.new(List.new<String>())
    var td = TopDecl.new(Span.none(), String.from("Token"), TopDeclKind.EnumDecl(List.new<Variant>(), true))
    td.annotations.push(Annotation.new(Span.none(), "derive", [String.from("Clone")]))
    m.decls.push(td)
    m.expand_derives()
    assert_eq(m.decls.size(), 2, "an enum Clone derive adds its impl")
}

@test
fun disabled_test_annotation_is_accepted(): void {
    var m = Module.new(List.new<String>())
    val result: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *result = TypeRef.new(Span.none(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    var td = TopDecl.new(Span.none(), String.from("paused"), TopDeclKind.Function(List.new<Param>(), result, List.new<Stmt>(), false, false, false, false))
    td.annotations.push(Annotation.new(Span.none(), "disabled", [String.from("\"waiting\"")]))
    m.decls.push(td)
    var diags = Diagnostics.new()
    m.validate_annotations(&var diags)
    assert_eq(diags.size(), 0, "the disabled-test marker is accepted")
}

// A function carrying `annotation`, checked through validate_annotations.
fun annotated_function(annotation: Annotation): List<Diagnostic> {
    var m = Module.new(List.new<String>())
    val result: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *result = TypeRef.new(Span.none(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    val kind = TopDeclKind.Function(List.new<Param>(), result, List.new<Stmt>(), false, false, false, false)
    var td = TopDecl.new(Span.none(), String.from("f"), kind)
    td.annotations.push(annotation)
    m.decls.push(td)
    var diags = Diagnostics.new()
    m.validate_annotations(&var diags)
    return diags.items
}

@test
fun an_allow_naming_a_registered_lint_is_accepted(): void {
    assert_eq(annotated_function(allow_of("unused_import")).size(), 0, "a real lint name suppresses cleanly")
}

@test
fun an_allow_naming_an_unknown_lint_is_rejected(): void {
    assert_eq(annotated_function(allow_of("unused_importt")).size() > 0, true, "a typo'd suppression is not accepted")
}
