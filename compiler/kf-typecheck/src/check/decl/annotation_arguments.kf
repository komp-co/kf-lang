// An annotation's arguments: which types a parameter may have, and matching
// a use's arguments, positional then named, to the parameters in order. A
// variadic last parameter takes the positional arguments left over, as a
// list literal.

import alloc.list.*

import kf_core.ast.CrateId
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.Annotation
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.MarkKind
import kf_core.ast.annotation.*
import kf_core.diagnostic.*
import kf_typecheck.*
import kf_typecheck.types.display_type_ref

/// What a parameter's type admits as an argument. Arguments are literals,
/// since nothing evaluates an expression at compile time.
enum ParamKind {
    SignedInt
    UnsignedInt
    Float
    Bool
    Char
    Text
    /// An enum whose variants carry nothing: `Level.High`.
    Enum
    /// The name of a declaration of this kind: `Equal` for `trait`.
    Name(MarkKind)
    Unsupported
}

/// What one argument of a parameter of this type admits: of `T..`, a `T`.
fun TypeRef.param_kind(table: &SigTable, crate: CrateId): ParamKind {
    val element = self.variadic_element()
    if element != null {
        val one = element ?: return ParamKind.Unsupported
        return one.param_kind(table, crate)
    }
    val named = self.named_kind()
    if named != null { return ParamKind.Name(named ?: MarkKind.Trait) }
    val name = when (self.kind) {
        Named(name, args) => if args.size() == 0 { name.as_string() } else { String.from("") }
        _ => String.from("")
    }
    return when name.as_str() {
        "int8" => ParamKind.SignedInt
        "int16" => ParamKind.SignedInt
        "int32" => ParamKind.SignedInt
        "int64" => ParamKind.SignedInt
        "uint8" => ParamKind.UnsignedInt
        "uint16" => ParamKind.UnsignedInt
        "uint32" => ParamKind.UnsignedInt
        "uint64" => ParamKind.UnsignedInt
        "float32" => ParamKind.Float
        "float64" => ParamKind.Float
        "bool" => ParamKind.Bool
        "char" => ParamKind.Char
        "str" => ParamKind.Text
        _ => {
            if name.as_str().equals("") { return ParamKind.Unsupported }
            if name.as_str() == table.lang_string.as_str() { return ParamKind.Text }
            if table.is_plain_enum(name, crate) { ParamKind.Enum } else { ParamKind.Unsupported }
        }
    }
}

fun SigTable.is_plain_enum(name: str, crate: CrateId): bool {
    val layout = self.find_enum(name, crate) ?: return false
    while variant in &layout.variants {
        if variant.payloads.size() > 0 { return false }
    }
    return true
}

/// This crate's annotation parameters, each of a type an argument can be
/// written for.
pub fun check_annotation_params(params: &List<Param>, table: &SigTable, crate: CrateId,
    diags: &var List<Diagnostic>): void {
    while i in 0..params.size() {
        val param = params.at(i)
        val variadic = (*param.ty).variadic_element() != null
        if variadic && i + 1 < params.size() {
            val message = "only the last parameter may be variadic: `${param.name.as_str()}` is followed by others"
            diags.push(error_at(param.span, message))
        }
        val takes_default = !variadic && (*param.ty).named_kind() == null
        if !takes_default && param.default != null {
            val what = if variadic { "a variadic parameter" } else { "a parameter taking a name" }
            diags.push(error_at(param.span, "${what} takes no default: `${param.name.as_str()}`"))
        }
        val kind = (*param.ty).param_kind(table, crate)
        when (kind) {
            Unsupported => {
                val allowed = "a number, `bool`, `char`, `str`, `String`, an enum whose variants carry nothing"
                val names = "or `trait`, `struct`, `enum` or `fun` for a declaration's name"
                val message = "annotation parameter `${param.name.as_str()}` must be ${allowed}, ${names}"
                diags.push(new_diagnostic(Severity.Error, new_label(param.span, message)))
            }
            _ => {
                val written = param.default
                if written != null {
                    val value = written ?: continue
                    if !value.fits_param(kind, &*param.ty, table, crate) {
                        val wanted = "a literal of type `${(*param.ty).display_type_ref().as_str()}`"
                        val message = "the default of `${param.name.as_str()}` must be ${wanted}"
                        diags.push(new_diagnostic(Severity.Error, new_label(value.span, message)))
                    }
                }
            }
        }
    }
}

/// The use's argument values in parameter order, or an empty list with
/// `ok` false once a mismatch is reported.
pub struct OrderedArguments {
    pub val ok: bool
    pub val values: List<Expr>
}

pub fun Annotation.arguments_in_order(params: &List<Param>, table: &SigTable, crate: CrateId,
    diags: &var List<Diagnostic>): OrderedArguments {
    val kind = self.name.as_str()
    var slots = List.new<uint64>()
    var rest = List.new<uint64>()
    val variadic = params.size() > 0 && (*params.at(params.size() - 1).ty).variadic_element() != null
    val single = if variadic { params.size() - 1 } else { params.size() }
    var named_seen = false
    var ok = true
    while i in 0..self.args.size() {
        val arg = self.args.at(i)
        val at = arg.value.span
        if arg.name.as_str().equals("") {
            if named_seen {
                diags.push(error_at(at, "a positional argument of `@${kind}` cannot follow a named one"))
                ok = false
            } else if slots.size() >= single && variadic {
                rest.push(i)
            } else if slots.size() >= params.size() {
                val counts = "takes ${params.size()}, found ${self.args.size()}"
                diags.push(error_at(at, "too many arguments to `@${kind}`: it ${counts}"))
                ok = false
            } else {
                slots.push(slots.size())
            }
            continue
        }
        named_seen = true
        val index = params.position_of(arg.name.as_str())
        if variadic && index == single {
            val how = "give its values positionally, after the others"
            diags.push(error_at(at, "`${arg.name.as_str()}` of `@${kind}` is variadic: ${how}"))
            ok = false
        } else if index >= params.size() {
            diags.push(error_at(at, "`@${kind}` has no parameter `${arg.name.as_str()}`"))
            ok = false
        } else if slots.contains(&index) {
            diags.push(error_at(at, "`${arg.name.as_str()}` is given twice to `@${kind}`"))
            ok = false
        } else {
            slots.push(index)
        }
    }
    if !ok { return OrderedArguments { ok: false, values: List.new<Expr>() } }
    var ordered = self.values_for(&slots, params, table, crate, diags)
    if variadic && ordered.ok { ordered = self.with_rest(ordered, &rest, params.at(single), table, crate, diags) }
    return ordered
}

/// The variadic parameter's value, a list literal of the arguments `rest`
/// indexes, each a literal of its element type.
fun Annotation.with_rest(ordered: OrderedArguments, rest: &List<uint64>, param: &Param, table: &SigTable,
    crate: CrateId, diags: &var List<Diagnostic>): OrderedArguments {
    val element = (*param.ty).argument_type()
    val kind = element.param_kind(table, crate)
    var values = List.new<Expr>()
    var ok = true
    while at in &rest {
        val value = &*self.args.at(at).value
        if !value.fits_param(kind, &element, table, crate) {
            diags.push(error_at(value.span, self.mismatch(param, &element, kind)))
            ok = false
            continue
        }
        values.push(value.clone())
    }
    if !ok { return OrderedArguments { ok: false, values: List.new<Expr>() } }
    var out = ordered.values.clone()
    out.push(Expr.new_list_literal(self.span, &values))
    return OrderedArguments { ok: true, values: out }
}

/// Why `param`'s argument does not fit: it needs a literal, or a name.
fun Annotation.mismatch(param: &Param, ty: &TypeRef, kind: ParamKind): String {
    val wanted = when (kind) {
        Name(named) => "the name of a `${named.word()}`"
        _ => "a literal of type `${ty.display_type_ref().as_str()}`"
    }
    return "`${param.name.as_str()}` of `@${self.name.as_str()}` must be ${wanted}"
}

/// Each parameter's value, once every slot is filled with a literal of its
/// type.
fun Annotation.values_for(slots: &List<uint64>, params: &List<Param>, table: &SigTable, crate: CrateId,
    diags: &var List<Diagnostic>): OrderedArguments {
    val kind = self.name.as_str()
    var ok = true
    var values = List.new<Expr>()
    while p in 0..params.size() {
        val param = params.at(p)
        if (*param.ty).variadic_element() != null { continue }
        val found = slots.index_of(&p)
        if found == null {
            val default = param.default
            if default != null {
                val filled = default ?: continue
                values.push((*filled).clone())
                continue
            }
            diags.push(error_at(self.span, "`@${kind}` is missing `${param.name.as_str()}`"))
            ok = false
            continue
        }
        val at = found ?: continue
        val value = &*self.args.at(at).value
        val admits = (*param.ty).param_kind(table, crate)
        if !value.fits_param(admits, &*param.ty, table, crate) {
            diags.push(error_at(value.span, self.mismatch(param, &*param.ty, admits)))
            ok = false
            continue
        }
        values.push(value.clone())
    }
    if !ok { return OrderedArguments { ok: false, values: List.new<Expr>() } }
    return OrderedArguments { ok: true, values: values }
}

fun Expr.fits_param(kind: ParamKind, ty: &TypeRef, table: &SigTable, crate: CrateId): bool {
    return when (kind) {
        SignedInt => self.is_int_literal() || self.negates(true)
        UnsignedInt => self.is_int_literal()
        Float => self.is_int_literal() || self.is_float_literal() || self.negates(false)
        Bool => when (self.kind) {
            LitBool(_b) => true
            _ => false
        }
        Char => when (self.kind) {
            LitChar(_c) => true
            _ => false
        }
        Text => when (self.kind) {
            LitStr(_s) => true
            _ => false
        }
        Enum => self.names_variant_of(ty, table, crate)
        Name(named) => self.names_declaration(named, table, crate)
        Unsupported => false
    }
}

fun Expr.is_int_literal(): bool {
    return when (self.kind) {
        LitInt(_n) => true
        _ => false
    }
}

fun Expr.is_float_literal(): bool {
    return when (self.kind) {
        LitFloat(_f) => true
        _ => false
    }
}

/// `-3`, or with `ints_only` false also `-2.5`.
fun Expr.negates(ints_only: bool): bool {
    return when (self.kind) {
        Unary(op, inner) => when (op) {
            Neg => inner.is_int_literal() || (!ints_only && inner.is_float_literal())
            Not => false
        }
        _ => false
    }
}

/// `Level.High` for a parameter of type `Level`, naming one of its variants.
fun Expr.names_variant_of(ty: &TypeRef, table: &SigTable, crate: CrateId): bool {
    val enum_name = when (ty.kind) {
        Named(name, _args) => name.as_string()
        _ => String.from("")
    }
    val variant = when (self.kind) {
        FieldAccess(owner, variant) => when (owner.kind) {
            Variable(name) => if name.as_str() == enum_name.as_str() { variant.as_string() } else { String.from("") }
            _ => String.from("")
        }
        _ => String.from("")
    }
    val layout = table.find_enum(enum_name, crate) ?: return false
    while known in &layout.variants {
        if known.name.as_str() == variant.as_str() { return true }
    }
    return false
}

fun List<Param>.position_of(name: str): uint64 {
    while i in 0..self.size() {
        if self.at(i).name.as_str() == name { return i }
    }
    return self.size()
}
