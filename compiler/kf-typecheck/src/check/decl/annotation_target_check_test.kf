import core.assert.assert_eq

import kf_core.span.no_span
import kf_core.ast.*

fun server_ty(): Type {
    return Type { kind: TypeKind.Struct(intern("Server")), provenance: Provenance.Inferred(no_span()) }
}

/// `(<receiver>) -> int32`, the receiver `&Server` or `&var Server`.
fun reader_type(is_mutable: bool): Type {
    var params = new_type_vec()
    params.push(server_ty().borrowed(is_mutable, no_span()))
    return fn_ty(params, int32_ty(no_span()), Provenance.Inferred(no_span()))
}

@test fun a_shared_receiver_fits_a_mutable_target(): void {
    assert_eq(reader_type(false).fits_function_target(&reader_type(true)), true, "lent from `&var`")
}

@test fun a_mutable_receiver_does_not_fit_a_shared_target(): void {
    assert_eq(reader_type(true).fits_function_target(&reader_type(false)), false, "it would write through `&`")
}

@test fun an_exact_type_fits(): void {
    assert_eq(reader_type(true).fits_function_target(&reader_type(true)), true, "the same type")
}

@test fun a_value_does_not_fit_a_borrow(): void {
    var params = new_type_vec()
    params.push(server_ty())
    val by_value = fn_ty(params, int32_ty(no_span()), Provenance.Inferred(no_span()))
    assert_eq(by_value.fits_function_target(&reader_type(true)), false, "only a borrow loosens")
}

@test fun a_different_result_does_not_fit(): void {
    var params = new_type_vec()
    params.push(server_ty().borrowed(false, no_span()))
    val returns_bool = fn_ty(params, bool_ty(no_span()), Provenance.Inferred(no_span()))
    assert_eq(returns_bool.fits_function_target(&reader_type(true)), false, "the result stays exact")
}
