import core.assert.assert_eq

@test
fun a_value_in_range_fits(): void {
    assert_eq(fits_integer_type(255, "uint8"), true, "`uint8` holds 255")
}

@test
fun a_value_past_the_top_does_not_fit(): void {
    assert_eq(fits_integer_type(256, "uint8"), false, "`uint8` stops at 255")
}

@test
fun a_negative_value_does_not_fit_an_unsigned_type(): void {
    assert_eq(fits_integer_type(-1, "uint64"), false, "`uint64` has no negatives")
}

@test
fun the_least_int32_fits(): void {
    assert_eq(fits_integer_type(-2147483648, "int32"), true, "`int32` reaches -2147483648")
}
