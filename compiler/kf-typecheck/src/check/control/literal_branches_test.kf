import core.assert.assert_eq

import kf_core.ast.*
import kf_core.span.no_span

fun if_of(then_kind: ExprKind, else_kind: ExprKind): Expr {
    val condition = Box.new(new_expr(no_span(), ExprKind.LitBool(true)))
    val then_value = Box.new(new_expr(no_span(), then_kind))
    val else_value = Box.new(new_expr(no_span(), else_kind))
    return new_expr(no_span(), ExprKind.IfExpr(condition, then_value, else_value))
}

@test fun an_if_of_two_numbers_yields_only_literals(): void {
    val e = if_of(ExprKind.LitInt(3000000000), ExprKind.LitInt(1))
    assert_eq(e.yields_only_numeric_literals(), true, "both branches are bare numbers")
}

@test fun an_if_with_a_variable_branch_does_not(): void {
    val e = if_of(ExprKind.LitInt(1), ExprKind.Variable(intern("n")))
    assert_eq(e.yields_only_numeric_literals(), false, "a variable has its own type")
}

@test fun a_bare_number_is_not_a_branching_value(): void {
    val e = new_expr(no_span(), ExprKind.LitInt(1))
    assert_eq(e.yields_only_numeric_literals(), false, "only an if or when qualifies")
}
