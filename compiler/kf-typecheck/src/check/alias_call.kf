// `alias.name(args)`: a call through `import a.b as alias`.

import kf_core.ast.*

/// The module this method call's receiver names as an alias in the caller's
/// file, or poison. A local of that name shadows the alias.
fun Expr.alias_call_module(ctx: &var TypeCtx): Sym {
    val alias = when (self.kind) {
        MethodCall(receiver, _method, _args) => receiver.variable_name()
        _ => String.from("")
    }
    if alias.as_str() == "" || ctx.is_declared(alias.as_str()) { return Sym { id: 0 } }
    return unsafe { (*ctx.sigs).alias_target(ctx.owner_file, alias.as_str()) }
}
