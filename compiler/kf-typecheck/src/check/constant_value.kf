// A top-level `val`: its literal, typed once, stands in for each use.

import kf_core.ast.Sym
import kf_core.ast.intern
import kf_core.ast.array_literal_callee
import kf_core.ast.types.Type
import kf_core.span.Span
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.diagnostic.new_label
import kf_core.diagnostic.new_diagnostic
import kf_typecheck.types.display_type
import kf_typecheck.types.resolve_type_ref
import kf_typecheck.traits.validate_dyn_placement
import kf_typecheck.note_import_use_named

/// A number, `char`, `bool` or string literal, a negated number, or an array
/// literal of those.
pub fun Expr.is_constant_literal(): bool {
    return when (self.kind) {
        LitInt(_) => true
        LitFloat(_) => true
        LitChar(_) => true
        LitStr(_) => true
        LitBool(_) => true
        Unary(op, inner) => when (op) {
            Neg => inner.is_number_literal()
            Not => false
        }
        Call(name, elements) => name.as_str() == array_literal_callee() && elements.all_constant_literals()
        _ => false
    }
}

fun Expr.is_number_literal(): bool {
    return when (self.kind) {
        LitInt(_) => true
        LitFloat(_) => true
        _ => false
    }
}

fun List<Expr>.all_constant_literals(): bool {
    while element in &self {
        if !element.is_constant_literal() { return false }
    }
    return true
}

/// Types the literal against the written type, which takes the literal's
/// length when it leaves it out. Poison when either is wrong, reported.
pub mutating fun Expr.type_as_constant(written: &var TypeRef, ctx: &var TypeCtx): Type {
    if !self.is_constant_literal() {
        val message = "a top-level `val` holds a literal; compute anything else in a function"
        ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, message)))
        return Type.new_poison()
    }
    check_expr(self, ctx)
    *written = written.with_initializer_length(self, ctx)
    val declared = written.resolve_type_ref(ctx)
    declared.validate_dyn_placement(written.span, ctx)
    if declared.is_poison() { return declared }
    val found = self.ty.clone()
    if !expect_or_reject(self, declared.clone(), ctx) {
        val types = "`${found.display_type(ctx)}`, but its declared type is `${declared.display_type(ctx)}`"
        ctx.emit(new_diagnostic(Severity.Error, new_label(self.span, "this value is ${types}")))
        return Type.new_poison()
    }
    if self.is_signed_number() { self.cast_to(written) }
    return declared
}

/// Keeps a number at its declared width, where a bare literal would take the
/// width its use asks for.
mutating fun Expr.cast_to(written: &TypeRef): void {
    val ty = self.ty.clone()
    self.kind = ExprKind.Cast(Box.new(self.clone()), Box.new(written.clone()))
    self.ty = ty
}

fun Expr.is_signed_number(): bool {
    return when (self.kind) {
        Unary(_op, inner) => inner.is_number_literal()
        _ => self.is_number_literal()
    }
}

/// A top-level `val` or a function named where a value is wanted.
pub mutating fun Expr.name_top_level_value(name: Sym, ctx: &var TypeCtx): bool {
    if self.name_constant(name, ctx) { return true }
    return self.name_function_value(name, ctx)
}

/// True when `name` is a top-level `val` this file sees, which makes `self`
/// its literal.
mutating fun Expr.name_constant(name: Sym, ctx: &var TypeCtx): bool {
    val sigs = ctx.sig_table()
    val sig = sigs.lookup_callee(name.as_str(), Sym { id: 0 }, self.decl, ctx.owner_file, ctx.owner_crate,
        ctx.owner_module) ?: return false
    val value = sigs.constant_value(&sig) ?: return false
    note_import_use_named(ctx.sigs, ctx.owner_file, sig.owner_module, name)
    self.kind = value.kind
    self.ty = value.ty
    self.constant = intern(sig.name)
    return true
}

/// A top-level `val` written as a call: reported.
pub fun FnSignature.rejects_call_of_constant(span: Span, ctx: &var TypeCtx): bool {
    if ctx.sig_table().constant_value(self).is_none() { return false }
    val message = "`${self.name}` is a top-level `val`, not a function: drop the `()`"
    ctx.emit(new_diagnostic(Severity.Error, new_label(span, message)))
    return true
}

/// True when `name` names a top-level `val` this file sees.
pub fun str.names_constant(ctx: &var TypeCtx): bool {
    val sigs = ctx.sig_table()
    val sig = sigs.lookup_callee(self, Sym { id: 0 }, null, ctx.owner_file, ctx.owner_crate,
        ctx.owner_module) ?: return false
    return sigs.constant_value(&sig).is_some()
}
