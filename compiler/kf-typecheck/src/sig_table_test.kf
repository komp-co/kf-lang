import core.assert.assert_eq

// Where an added import goes. A zero-width fix span is an insertion; these
// pin its offset.

fun fresh_table_ptr(): Ptr<SigTable> {
    val p: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *p = new_sig_table() }
    return p
}

@test fun a_file_with_no_imports_inserts_at_byte_zero(): void {
    val sp = fresh_table_ptr()
    assert_eq(import_insert_at(sp, 1), 0 as uint32, "there is nothing to append to")
}

// After the existing block, the only placement always legal.
@test fun an_import_goes_past_the_last_one_in_the_file(): void {
    val sp = fresh_table_ptr()
    note_import_end(sp, 1, 19)
    note_import_end(sp, 1, 42)
    assert_eq(import_insert_at(sp, 1), 42 as uint32, "past the LAST import, not the first")
}

// The answer is the maximum, whatever the order recorded.
@test fun the_order_imports_are_recorded_in_does_not_matter(): void {
    val sp = fresh_table_ptr()
    note_import_end(sp, 1, 42)
    note_import_end(sp, 1, 19)
    assert_eq(import_insert_at(sp, 1), 42 as uint32, "still the last one")
}

@test fun each_file_gets_its_own_insertion_point(): void {
    val sp = fresh_table_ptr()
    note_import_end(sp, 1, 19)
    note_import_end(sp, 2, 77)
    assert_eq(import_insert_at(sp, 1), 19 as uint32, "file 1 keeps its own")
    assert_eq(import_insert_at(sp, 2), 77 as uint32, "and file 2 keeps its own")
    assert_eq(import_insert_at(sp, 3), 0 as uint32, "a file with none opens at zero")
}
