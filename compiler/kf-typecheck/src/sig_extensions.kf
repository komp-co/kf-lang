// Which registered names are extensions, and what each is called.

import alloc.list.*

impl SigTable {
    /// An extension's own name for its hidden one; others unchanged.
    pub fun surface_name(name: str): String {
        var i: uint64 = 0
        while i < self.ext_links.size() {
            if self.ext_links.get(i).as_str().equals(name) { return self.ext_names.get(i).as_string() }
            i = i + 1
        }
        return String.from(name)
    }

    /// The parameter a trait receiver became, or "".
    pub fun receiver_trait_param(link: str): String {
        var i: uint64 = 0
        while i < self.ext_links.size() {
            if self.ext_links.get(i).as_str().equals(link) { return self.ext_trait_params.get(i).as_string() }
            i = i + 1
        }
        return ""
    }
}
