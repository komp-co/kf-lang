// Where a declaration is written, as an `annotated<A>()` entry reports it.

import kf_core.span.Span
import kf_core.span.Location
import kf_core.span.path_file_stem
import kf_core.ast.Sym
import alloc.text_edit.replace
import alloc.text_edit.substring

/// The file relative to the crate root, `src/parse/lexer_test.kf`, rebuilt
/// from the module path `kf_parse.parse` and the file's stem, and the line
/// of `span`. "" and 0 without a source map.
pub fun SigTable.place_of(span: Span, module: Sym): Location {
    val unknown = Location { file_path: String.from(""), line: 0, col: 0 }
    if ptr_is_null(self.smap) { return unknown }
    val located = unsafe { self.smap.span_to_location(span) } ?: return unknown
    var file = String.from("src/")
    val path = module.as_str()
    val dot = path.index_of(".")
    if dot != null {
        val at = dot ?: return unknown
        file.append(path.substring(at + 1, path.byte_len()).as_str().replace(".", "/").as_str())
        file.append("/")
    }
    file.append("${path_file_stem(located.file_path.as_str())}.kf")
    return Location { file_path: file, line: located.line, col: located.col }
}
