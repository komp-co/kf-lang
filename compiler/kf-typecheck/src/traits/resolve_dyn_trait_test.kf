import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.diagnostic.*
import kf_core.ast.dyn_meta.dyn_trait_type
import kf_core.ast.dyn_meta.dyn_trait_args

fun resolved_test_sink(argument: Type): Type {
    var args = new_type_vec()
    args.push(argument)
    return dyn_trait_type(intern("sample::api::Sink"), args, no_span())
}

fun dyn_test_trait(name: str, identity: str, arity: uint64): TraitInfo {
    var type_parameters = List.new<String>()
    var i: uint64 = 0
    while i < arity {
        type_parameters.push(String.from("T"))
        i = i + 1
    }
    return TraitInfo {
        name: String.from(name),
        identity: intern(identity), module: intern(""),
        span: no_span(),
        type_params: type_parameters,
        methods: List.new<TraitMethodReq>(),
        assoc_types: List.new<TraitAssocReq>(),
        supertraits: List.new<SuperTraitReq>()
    }
}

fun dyn_resolution_message(name: str, args: List<TypeRef>, signatures: SigTable): String {
    val diagnostics: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *diagnostics = List.new<Diagnostic>() }
    val signature_ptr: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signature_ptr = signatures }
    var ctx = new_type_ctx(void_ty(no_span()), diagnostics, Option.None, signature_ptr)
    val object_ref = new_type_ref(no_span(), TypeRefKind.DynTrait(intern(name), args))
    val _resolved = object_ref.resolve_type_ref(&var ctx)
    return unsafe { diagnostics.at(0).primary.message }
}

@test fun dyn_trait_type_equals_its_clone(): void {
    val sink = resolved_test_sink(int32_ty(no_span()))
    assert_eq(sink.type_eq(&sink.clone()), true, "same canonical dynamic type compares equal")
}

@test fun dyn_trait_type_arguments_affect_equality(): void {
    val int_sink = resolved_test_sink(int32_ty(no_span()))
    val str_sink = resolved_test_sink(str_ty(no_span()))
    assert_eq(int_sink.type_eq(&str_sink), false, "different dynamic arguments compare unequal")
}

fun resolve_dyn_trait_keeps_generic_argument(): bool {
    val diagnostics = List.new<Diagnostic>()
    val diagnostic_ptr: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *diagnostic_ptr = diagnostics }
    var signatures = new_sig_table()
    var type_parameters = List.new<String>()
    type_parameters.push(String.from("T"))
    signatures.insert_trait(TraitInfo {
        name: String.from("Sink"),
        identity: intern("sample::api::Sink"), module: intern(""),
        span: no_span(),
        type_params: type_parameters,
        methods: List.new<TraitMethodReq>(),
        assoc_types: List.new<TraitAssocReq>(),
        supertraits: List.new<SuperTraitReq>()
    })
    val signature_ptr: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signature_ptr = signatures }
    var ctx = new_type_ctx(void_ty(no_span()), diagnostic_ptr, Option.None, signature_ptr)
    ctx.generics.push(String.from("T"))

    var object_args = List.new<TypeRef>()
    object_args.push(new_type_ref(no_span(), TypeRefKind.Named(intern("T"), List.new<TypeRef>())))
    val object_ref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *object_ref = new_type_ref(no_span(), TypeRefKind.DynTrait(intern("Sink"), object_args)) }
    val borrowed = new_type_ref(no_span(), TypeRefKind.Reference(false, object_ref))
    val resolved = borrowed.resolve_type_ref(&var ctx)
    when (resolved.kind) {
        RefTo(_, inner) => {
            val dynamic_type = unsafe { *inner }
            val args = dyn_trait_args(&dynamic_type)
            val argument = unsafe { args.get(0) }
            when (argument.kind) {
                Generic(name) => return name.as_str() == "T"
                _ => return false
            }
        }
        _ => return false
    }
}

@test fun resolve_dyn_trait_preserves_generic_argument(): void {
    assert_eq(resolve_dyn_trait_keeps_generic_argument(), true, "dynamic trait arguments resolve in the current generic scope")
}

@test fun resolve_dyn_trait_reports_unknown_trait(): void {
    val message = dyn_resolution_message("Missing", List.new<TypeRef>(), new_sig_table())
    assert_eq(message.as_str(), "unknown trait `Missing` in dynamic trait type", "unknown dynamic principals are named")
}

@test fun resolve_dyn_trait_rejects_struct_principal(): void {
    var signatures = new_sig_table()
    signatures.insert_struct(StructLayout {
        name: String.from("Widget"),
        fields: List.new<StructFieldInfo>(),
        is_refcounted: false,
        owner_crate: crate_id_poison()
    })
    val message = dyn_resolution_message("Widget", List.new<TypeRef>(), signatures)
    assert_eq(message.as_str(), "`Widget` is not a trait", "declared non-traits receive a specific diagnostic")
}

@test fun resolve_dyn_trait_rejects_ambiguous_principal(): void {
    var signatures = new_sig_table()
    signatures.insert_trait(dyn_test_trait("Sink", "one::Sink", 0))
    signatures.insert_trait(dyn_test_trait("Sink", "two::Sink", 0))
    val message = dyn_resolution_message("Sink", List.new<TypeRef>(), signatures)
    assert_eq(message.as_str(), "trait name `Sink` is ambiguous in this scope", "ambiguous dynamic principals are rejected")
}

@test fun resolve_dyn_trait_checks_type_argument_arity(): void {
    var signatures = new_sig_table()
    signatures.insert_trait(dyn_test_trait("Sink", "sample::Sink", 1))
    val message = dyn_resolution_message("Sink", List.new<TypeRef>(), signatures)
    assert_eq(message.as_str(), "trait `Sink` expects 1 type arguments, found 0", "dynamic trait arity is checked")
}

@test fun display_type_renders_dynamic_principal_and_arguments(): void {
    val diagnostics = List.new<Diagnostic>()
    val diagnostic_ptr: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *diagnostic_ptr = diagnostics }
    val signatures = new_sig_table()
    val signature_ptr: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signature_ptr = signatures }
    val ctx = new_type_ctx(void_ty(no_span()), diagnostic_ptr, Option.None, signature_ptr)
    val sink = resolved_test_sink(int32_ty(no_span()))
    assert_eq(sink.display_type(&ctx).as_str(), "dyn Sink<int32>", "dynamic types use source-facing display")
}
