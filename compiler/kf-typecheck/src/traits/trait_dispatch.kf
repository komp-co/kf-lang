import alloc.list.*

import kf_core.ast.*
import kf_typecheck.types.*
import kf_typecheck.check.*
import kf_core.span.no_span
import kf_typecheck.note_import_use

/// Selected by the typed value arguments: `From<int32>` and `From<bool>` on
/// one target are different symbols.
pub fun static_trait_method_callee(type_name: String, method_name: String, args: &List<Expr>, type_args: &List<TypeRef>, ctx: &var TypeCtx): String {
    val base = mangle_base_name(type_name.clone())
    var found = ""
    var i = 0
    while i < unsafe { (*ctx.sigs).trait_impls.size() } {
        val trait_impl = unsafe { *(*ctx.sigs).trait_impls.at(i) }
        if trait_impl.type_name.as_str().equals(base.as_str()) {
            if !ctx.is_auto_trait(trait_impl.trait_name.as_str()) {
                var suffix = trait_impl.trait_name.clone()
                if !trait_impl.trait_args.as_str().equals("") {
                    suffix = suffix + String.from("__") + trait_impl.trait_args.clone()
                }
                val candidate = type_name.clone() + String.from("_") + method_name.clone() + String.from("__") + suffix
                when (unsafe { (*ctx.sigs).find_signature(candidate.as_str()) }) {
                    Some(sig) => {
                        if sig.is_static && sig.params.size() == args.size() {
                            // Substituted; see `static_call_params`.
                            val sparams = sig.static_call_params(type_args, ctx)
                            var fits = true
                            while j in 0..args.size() {
                                val arg = *args.at(j)
                                val expected = *sparams.at(j)
                                if !arg.ty.type_eq(expected) && !ctx.fits(arg.ty, expected) {
                                    // A re-bindable generic call is applicable (see
                                    // the instance path), and so is an argument
                                    // unsizing to a `&dyn Trait` parameter.
                                    if !arg.ty.could_dyn_coerce(&expected, ctx) {
                                        if arg.rebound_call_bindings(&expected, ctx).size() == 0 { fits = false }
                                    }
                                }
                            }
                            if fits {
                                if !found.as_str().equals("") { return "" }
                                found = candidate
                            }
                        }
                    }
                    None => { }
                }
            }
        }
        i = i + 1
    }
    return found
}

/// `Bag.make(5)` with no type arguments written: the receiver's, bound from
/// what the arguments are. Empty when a parameter stays unbound, as in
/// `List.new()`, or when two static methods by that name bind differently.
pub fun static_receiver_args(type_name: String, method_name: String, args: &List<Expr>,
    ctx: &var TypeCtx): List<TypeRef> {
    val arity = type_name.static_recv_arity(ctx)
    var found = List.new<TypeRef>()
    if arity == 0 || args.size() == 0 { return found }
    var names = List.new<String>()
    names.push(type_name.clone() + String.from("_") + method_name.clone())
    val base = mangle_base_name(type_name.clone())
    while trait_impl in &ctx.sig_table().trait_impls {
        if trait_impl.type_name.as_str() != base.as_str() { continue }
        if ctx.is_auto_trait(trait_impl.trait_name.as_str()) { continue }
        val suffix = if trait_impl.trait_args.as_str() == "" {
            trait_impl.trait_name.clone()
        } else {
            "${trait_impl.trait_name}__${trait_impl.trait_args}"
        }
        names.push("${type_name}_${method_name}__${suffix}")
    }
    while name in &names {
        val sig = ctx.sig_table().find_signature(name.as_str()) ?: continue
        if !sig.is_static || sig.params.size() != args.size() || sig.generics.size() < arity { continue }
        val bound = sig.bind_receiver_args(arity, args, ctx) ?: continue
        if found.size() > 0 && !same_type_args(&found, &bound) { return List.new<TypeRef>() }
        found = bound
    }
    return found
}

/// The first `arity` generics, each bound by some argument, or none.
fun FnSignature.bind_receiver_args(arity: uint64, args: &List<Expr>, ctx: &var TypeCtx): List<TypeRef>? {
    var out = List.new<TypeRef>()
    while g in 0..arity {
        val gname = self.generics.at(g)
        var bound = poison_ty()
        while j in 0..args.size() {
            if !bound.is_poison() { break }
            bound = self.params.at(j).bind_generic_from_param(&args.at(j).ty, gname.as_str(), ctx)
        }
        if bound.is_poison() { return null }
        out.push(bound.type_to_type_ref(args.at(0).span))
    }
    return out
}

fun same_type_args(a: &List<TypeRef>, b: &List<TypeRef>): bool {
    if a.size() != b.size() { return false }
    while i in 0..a.size() {
        if a.at(i).tref_name_key().as_str() != b.at(i).tref_name_key().as_str() { return false }
    }
    return true
}

/// `T.from(x)` with a `From<S>` bound keeps `S` in the placeholder, so
/// substitution reaches the concrete trait-method symbol.
pub fun generic_static_trait_callee(gname: String, method_name: String, ctx: &var TypeCtx): String {
    return bounded_trait_callee(gname, method_name, ctx)
}

/// `value.method()` on a bounded generic keeps the trait and its arguments in
/// the placeholder; materialization substitutes both halves.
pub fun generic_instance_trait_callee(gname: String, method_name: String, ctx: &var TypeCtx): String {
    return bounded_trait_callee(gname, method_name, ctx)
}

/// The placeholder callee a method reached through `gname`'s bounds carries
/// until mono substitutes the receiver, or "". Shared by the static and
/// instance forms. The bound's trait first, then its supertraits: the suffix
/// names the trait whose impl defines the method, so `T: Ord2` with
/// `trait Ord2: Eq2` emits `Point_eq2__Eq2`.
fun bounded_trait_callee(gname: String, method_name: String, ctx: &var TypeCtx): String {
    var i = 0
    while i < unsafe { (*ctx.sigs).bounds.size() } {
        val b = unsafe { *(*ctx.sigs).bounds.at(i) }
        if b.owner.as_str().equals(ctx.fn_owner.as_str()) {
            if b.param.as_str().equals(gname.as_str()) {
                val direct = trait_dispatch_suffix(b.trait_name.as_str(), b.trait_args.as_str(), method_name.as_str(), ctx)
                if !direct.as_str().equals("") {
                    return gname + String.from("_") + method_name + String.from("__") + direct
                }
                val required = supertrait_closure_reqs(unsafe { &*ctx.sigs }, b.trait_name.as_str(), b.trait_args.as_str())
                while sreq in &required {
                    val inherited = trait_dispatch_suffix(sreq.name.as_str(), sreq.args.as_str(), method_name.as_str(), ctx)
                    if !inherited.as_str().equals("") {
                        return gname + String.from("_") + method_name + String.from("__") + inherited
                    }
                }
            }
        }
        i = i + 1
    }
    return ""
}

/// "" when this trait does not declare `method_name`, and for Clone, Drop and
/// Equal, whose impl methods are unsuffixed.
fun trait_dispatch_suffix(trait_name: str, trait_args: str, method_name: str, ctx: &var TypeCtx): String {
    if ctx.is_auto_trait(trait_name) {
        return ""
    }
    when (unsafe { (*ctx.sigs).find_trait(trait_name) }) {
        Some(trait_info) => {
            if trait_has_method(trait_info, method_name) {
                var suffix = String.from(trait_name)
                if !trait_args.equals("") {
                    suffix = suffix + String.from("__") + String.from(trait_args)
                }
                return suffix
            }
        }
        None => { }
    }
    return ""
}

/// Both names of a selected trait method, which differ for a monomorphized
/// receiver: the symbol `List__int32_iter__Iterable__int32`, declared as
/// `List_iter__Iterable__T`. Empty when nothing was selected.
pub struct TraitCallee {
    pub val symbol: String
    pub val sig_name: String
}

fun no_trait_callee(): TraitCallee {
    return TraitCallee { symbol: "", sig_name: "" }
}

pub fun instance_trait_method_callee(receiver_ty: Type, method_name: String, args: &List<Expr>, ctx: &var TypeCtx): String {
    return select_instance_trait_method(receiver_ty, method_name, args, ctx).symbol
}

/// Some trait impl declares the name, whether or not the arguments fit.
/// Selection returns nothing in both cases; only the reporting caller cares
/// which, since "no method" would name the wrong thing.
pub fun receiver_declares_trait_method(receiver_ty: Type, method_name: String, ctx: &var TypeCtx): bool {
    val recv = autoderef_ty(receiver_ty)
    val type_name = recv.kind.trait_impl_owner_name()
    if type_name.as_str().equals("") { return false }
    val base = mangle_base_name(type_name.clone())
    var i = 0
    while i < unsafe { (*ctx.sigs).trait_impls.size() } {
        val trait_impl = unsafe { *(*ctx.sigs).trait_impls.at(i) }
        if trait_impl.type_name.as_str().equals(base.as_str()) {
            var suffix = trait_impl.trait_name.clone()
            if !trait_impl.trait_args.as_str().equals("") {
                suffix = suffix + String.from("__") + trait_impl.trait_args.clone()
            }
            val method_prefix = "_${method_name}__"
            val on_receiver = type_name.clone() + method_prefix.clone() + suffix.clone()
            if unsafe { (*ctx.sigs).find_signature(on_receiver.as_str()) }.is_some() { return true }
            val on_template = base.clone() + method_prefix + suffix
            if unsafe { (*ctx.sigs).find_signature(on_template.as_str()) }.is_some() { return true }
        }
        i = i + 1
    }
    return false
}

pub fun select_instance_trait_method(receiver_ty: Type, method_name: String, args: &List<Expr>, ctx: &var TypeCtx): TraitCallee {
    val recv = autoderef_ty(receiver_ty)
    val type_name = recv.kind.trait_impl_owner_name()
    if type_name.as_str().equals("") { return no_trait_callee() }
    val base = mangle_base_name(type_name.clone())
    val binding = recv_type_bindings(type_name.clone(), no_span(), ctx)
    var found = no_trait_callee()
    var i = 0
    while i < unsafe { (*ctx.sigs).trait_impls.size() } {
        val trait_impl = unsafe { *(*ctx.sigs).trait_impls.at(i) }
        if trait_impl.type_name.as_str().equals(base.as_str()) {
            if !ctx.is_auto_trait(trait_impl.trait_name.as_str()) {
                // The template's suffix uses the impl's own `T`; the symbol on
                // a monomorphized receiver uses what `T` stands for.
                var template_suffix = trait_impl.trait_name.clone()
                var suffix = trait_impl.trait_name.clone()
                if !trait_impl.trait_args.as_str().equals("") {
                    template_suffix = template_suffix + String.from("__") + trait_impl.trait_args.clone()
                    // Projections in the impl's arguments resolve through the
                    // receiver, as the definition's suffix does.
                    val subst_args = subst_trait_args(trait_impl.trait_args.as_str(), &binding.names, &binding.types, true)
                    suffix = suffix + String.from("__") + resolved_proj_mangle(subst_args.as_str(), ctx.sigs)
                }
                val method_prefix = "_${method_name}__"
                val candidate = type_name.clone() + method_prefix.clone() + suffix
                var sig_name = candidate.clone()
                var sig_opt = unsafe { (*ctx.sigs).find_signature(candidate.as_str()) }
                if sig_opt.is_none() {
                    // Registered under the template; the symbol stays the
                    // receiver's, which is what mono materializes.
                    sig_name = base.clone() + method_prefix + template_suffix
                    sig_opt = unsafe { (*ctx.sigs).find_signature(sig_name.as_str()) }
                }
                when (sig_opt) {
                    Some(sig) => {
                        note_import_use(ctx.sigs, ctx.owner_file, sig.owner_module)
                        if !sig.is_static && sig.params.size() == args.size() + 1 {
                            var fits = true
                            while j in 0..args.size() {
                                val arg = *args.at(j)
                                val expected = subst_recv(*sig.params.at(j + 1), &binding)
                                if !arg.ty.type_eq(expected) && !ctx.fits(arg.ty, expected) {
                                    // An argument that could become this parameter
                                    // counts as applicable: `b[0..2]` arrives typed
                                    // `Range<int32>`, and rejecting the
                                    // `Index<Range<uint64>>` impl here would remove
                                    // the call before the expectation that fixes the
                                    // argument exists. Unsizing to `&dyn Trait` is the
                                    // same question.
                                    if !arg.ty.could_dyn_coerce(&expected, ctx) {
                                        if arg.rebound_call_bindings(&expected, ctx).size() == 0 { fits = false }
                                    }
                                }
                            }
                            if fits {
                                if !found.symbol.as_str().equals("") { return no_trait_callee() }
                                found = TraitCallee { symbol: candidate, sig_name: sig_name }
                            }
                        }
                    }
                    None => { }
                }
            }
        }
        i = i + 1
    }
    // An interface-loaded method is called by the symbol its archive exports.
    if !found.symbol.as_str().equals("") {
        when (recv.kind) {
            Struct(identity) => {
                val link = unsafe { (*ctx.sigs).lookup_method_link(identity, method_name.as_str()) }
                if !link.as_str().equals("") {
                    return TraitCallee { symbol: link.as_string(), sig_name: found.sig_name }
                }
            }
            _ => {}
        }
    }
    return found
}

/// The name a type has in `impl Trait for <name>`. Primitives carry impls in
/// core too. A struct answers with its declared name, the spelling the
/// registry and symbols use, not its canonical identity.
pub fun TypeKind.trait_impl_owner_name(): String {
    return when (self) {
        Struct(name) => type_identity_display(name)
        // Enums are impl targets too.
        EnumTy(name) => type_identity_display(name)
        StrTy => String.from("str")
        Int8 => String.from("int8")
        Int16 => String.from("int16")
        Int32 => String.from("int32")
        Int64 => String.from("int64")
        UInt8 => String.from("uint8")
        UInt16 => String.from("uint16")
        UInt32 => String.from("uint32")
        UInt64 => String.from("uint64")
        Float32 => String.from("float32")
        Float64 => String.from("float64")
        Bool => String.from("bool")
        Char => String.from("char")
        _ => ""
    }
}

/// `Trait.method(receiver, args...)`: the trait selects one impl even where
/// `receiver.method()` is ambiguous.
pub fun qualified_trait_method_callee(trait_name: String, method_name: String, args: &List<Expr>, ctx: &var TypeCtx): String {
    if args.size() == 0 { return "" }
    val receiver = *args.at(0)
    val recv = autoderef_ty(receiver.ty)
    when (recv.kind) {
        Struct(name) => {
            val type_name = name.as_string()
            val base = mangle_base_name(type_name.clone())
            var found = ""
            var i = 0
            while i < unsafe { (*ctx.sigs).trait_impls.size() } {
                val trait_impl = unsafe { *(*ctx.sigs).trait_impls.at(i) }
                if trait_impl.type_name.as_str().equals(base.as_str()) {
                    if trait_impl.trait_name.as_str().equals(trait_name.as_str()) {
                        var suffix = trait_impl.trait_name.clone()
                        if !trait_impl.trait_args.as_str().equals("") {
                            suffix = suffix + String.from("__") + trait_impl.trait_args.clone()
                        }
                        val candidate = type_name.clone() + String.from("_") + method_name.clone() + String.from("__") + suffix
                        when (unsafe { (*ctx.sigs).find_signature(candidate.as_str()) }) {
                            Some(sig) => {
                                if !sig.is_static && sig.params.size() == args.size() {
                                    if !found.as_str().equals("") { return "" }
                                    found = candidate
                                }
                            }
                            None => { }
                        }
                    }
                }
                i = i + 1
            }
            return found
        }
        _ => return ""
    }
}

pub fun instance_trait_method_is_ambiguous(receiver_ty: Type, method_name: String, args: &List<Expr>, ctx: &var TypeCtx): bool {
    val recv = autoderef_ty(receiver_ty)
    when (recv.kind) {
        Struct(name) => {
            val type_name = name.as_string()
            val base = mangle_base_name(type_name.clone())
            var matches: uint64 = 0
            var i = 0
            while i < unsafe { (*ctx.sigs).trait_impls.size() } {
                val trait_impl = unsafe { *(*ctx.sigs).trait_impls.at(i) }
                if trait_impl.type_name.as_str().equals(base.as_str()) {
                    if !ctx.is_auto_trait(trait_impl.trait_name.as_str()) {
                        var suffix = trait_impl.trait_name.clone()
                        if !trait_impl.trait_args.as_str().equals("") { suffix = suffix + String.from("__") + trait_impl.trait_args.clone() }
                        val candidate = type_name.clone() + String.from("_") + method_name.clone() + String.from("__") + suffix
                        when (unsafe { (*ctx.sigs).find_signature(candidate.as_str()) }) {
                            Some(sig) => {
                                if !sig.is_static && sig.params.size() == args.size() + 1 {
                                    var fits = true
                                    while j in 0..args.size() {
                                        val arg = *args.at(j)
                                        val expected = *sig.params.at(j + 1)
                                        // The same applicability rule as selection,
                                        // so two applicable impls are seen as
                                        // ambiguous.
                                        if !arg.ty.type_eq(expected) && !ctx.fits(arg.ty, expected) && !arg.ty.could_dyn_coerce(&expected, ctx) { fits = false }
                                    }
                                    if fits { matches = matches + 1 }
                                }
                            }
                            None => { }
                        }
                    }
                }
                i = i + 1
            }
            return matches > 1
        }
        _ => return false
    }
}
