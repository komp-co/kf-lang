import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_typecheck.new_sig_table
import testing.test

fun closure_trait(name: str, supers: List<SuperTraitReq>): TraitInfo {
    return TraitInfo {
        name: String.from(name),
        identity: intern(name), module: intern(""),
        span: no_span(),
        type_params: List.new<String>(),
        methods: List.new<TraitMethodReq>(),
        assoc_types: List.new<TraitAssocReq>(),
        supertraits: supers
    }
}

fun closure_super(name: str): SuperTraitReq {
    return SuperTraitReq { name: String.from(name), args: "", span: no_span() }
}

fun closure_supers_of(names: List<String>): List<SuperTraitReq> {
    var out = List.new<SuperTraitReq>()
    while name in &names {
        out.push(closure_super(name.as_str()))
    }
    return out
}

fun closure_names(one: str): List<String> {
    var out = List.new<String>()
    out.push(String.from(one))
    return out
}

@test fun closure_of_a_trait_without_supertraits_is_empty(): void {
    var sigs = new_sig_table()
    sigs.insert_trait(closure_trait("Equal", List.new<SuperTraitReq>()))
    val closed = sigs.supertrait_closure("Equal")
    assert_eq(closed.size(), 0, "Equal requires nothing")
}

@test fun closure_walks_a_chain(): void {
    var sigs = new_sig_table()
    sigs.insert_trait(closure_trait("Equal", List.new<SuperTraitReq>()))
    sigs.insert_trait(closure_trait("Compare", closure_supers_of(closure_names("Equal"))))
    sigs.insert_trait(closure_trait("Sortable", closure_supers_of(closure_names("Compare"))))
    val closed = sigs.supertrait_closure("Sortable")
    assert_eq(closed.size(), 2, "Sortable requires Compare and Equal")
}

@test fun closure_dedupes_a_diamond(): void {
    var sigs = new_sig_table()
    var d_supers = List.new<SuperTraitReq>()
    d_supers.push(closure_super("A"))
    d_supers.push(closure_super("B"))
    sigs.insert_trait(closure_trait("C", List.new<SuperTraitReq>()))
    sigs.insert_trait(closure_trait("A", closure_supers_of(closure_names("C"))))
    sigs.insert_trait(closure_trait("B", closure_supers_of(closure_names("C"))))
    sigs.insert_trait(closure_trait("D", d_supers))
    val closed = sigs.supertrait_closure("D")
    assert_eq(closed.size(), 3, "A, B, C once each")
}

@test fun closure_terminates_on_a_cycle(): void {
    var sigs = new_sig_table()
    sigs.insert_trait(closure_trait("Alpha", closure_supers_of(closure_names("Beta"))))
    sigs.insert_trait(closure_trait("Beta", closure_supers_of(closure_names("Alpha"))))
    val closed = sigs.supertrait_closure("Alpha")
    assert_eq(closed.size(), 1, "Beta once; the walk back to Alpha stops")
}

@test fun cycle_is_reported_from_either_end(): void {
    var sigs = new_sig_table()
    sigs.insert_trait(closure_trait("Alpha", closure_supers_of(closure_names("Beta"))))
    sigs.insert_trait(closure_trait("Beta", closure_supers_of(closure_names("Alpha"))))
    assert_eq(sigs.supertrait_cycle_from("Alpha"), true, "cycle seen from Alpha")
    assert_eq(sigs.supertrait_cycle_from("Beta"), true, "cycle seen from Beta")
}

@test fun a_chain_is_not_a_cycle(): void {
    var sigs = new_sig_table()
    sigs.insert_trait(closure_trait("Equal", List.new<SuperTraitReq>()))
    sigs.insert_trait(closure_trait("Compare", closure_supers_of(closure_names("Equal"))))
    assert_eq(sigs.supertrait_cycle_from("Compare"), false, "a chain terminates cleanly")
}

@test fun closure_of_an_unknown_trait_is_empty(): void {
    val sigs = new_sig_table()
    val closed = sigs.supertrait_closure("Missing")
    assert_eq(closed.size(), 0, "an unregistered trait requires nothing")
}
