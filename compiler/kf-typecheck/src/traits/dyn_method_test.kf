import core.assert.assert_eq
import alloc.list.*

import kf_core.span.Span
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.diagnostic.*
import kf_core.intern.Sym
import kf_core.intern.intern
import kf_typecheck.new_sig_table
import kf_typecheck.new_type_ctx
import kf_typecheck.check.check_expr
import testing.test

struct DynMethodOutcome {
    val result: Type
    val dynamic: bool
    val slot: uint64
    val layout: Sym
    val diagnostics: uint64
    val argument: Type
}

fun dyn_method_req(name: str, params: List<Type>, ret: Type, method_mutates: bool): TraitMethodReq {
    return TraitMethodReq {
        name: String.from(name), span: Span.none(), arity: params.size(),
        has_default: false, has_method_generics: false, is_static: false,
        params: params, ret: ret, is_mutating: method_mutates
    }
}

fun dyn_dispatch_trait(): TraitInfo {
    var parameters = List.new<String>()
    parameters.push(String.from("T"))
    var methods = List.new<TraitMethodReq>()
    methods.push(dyn_method_req("display", List.new<Type>(), Type.new_generic(String.from("T"), Span.none()), false))
    var send_params = List.new<Type>()
    send_params.push(Type.new_generic(String.from("T"), Span.none()))
    methods.push(dyn_method_req("send", send_params, Type.new_void(Span.none()), false))
    methods.push(dyn_method_req("reset", List.new<Type>(), Type.new_bool(Span.none()), true))
    return TraitInfo {
        name: String.from("Dispatch"), identity: intern("Dispatch"), module: intern(""), span: Span.none(),
        type_params: parameters, methods: methods, assoc_types: List.new<TraitAssocReq>(),
        supertraits: List.new<SuperTraitReq>()
    }
}

fun dyn_extra_trait(): TraitInfo {
    var methods = List.new<TraitMethodReq>()
    methods.push(dyn_method_req("hidden", List.new<Type>(), Type.new_bool(Span.none()), false))
    return TraitInfo {
        name: String.from("Extra"), identity: intern("Extra"), module: intern(""), span: Span.none(),
        type_params: List.new<String>(), methods: methods, assoc_types: List.new<TraitAssocReq>(),
        supertraits: List.new<SuperTraitReq>()
    }
}

fun dyn_method_ref(argument: Type, mutable: bool): Type {
    var arguments = List.new<Type>()
    arguments.push(argument)
    val dynamic = Type.new_dyn_trait(intern("Dispatch"), arguments, Span.none())
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = dynamic }
    return Type { kind: TypeKind.RefTo(mutable, inner), provenance: Provenance.Declared(Span.none()) }
}

fun run_dyn_method(method: str, mutable: bool, argument_kind: uint8, include_extra: bool): DynMethodOutcome {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = Diagnostics.new() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait(dyn_dispatch_trait()) }
    if include_extra { unsafe { signatures.insert_trait(dyn_extra_trait()) } }
    var ctx = new_type_ctx(Type.new_void(Span.none()), unsafe { &var *diagnostics }, Option.None, signatures)
    ctx.declare_val(String.from("object"), dyn_method_ref(Type.new_int32(Span.none()), mutable))
    var args = List.new<Expr>()
    if argument_kind == 1 { args.push(Expr.new(Span.none(), ExprKind.LitInt(7))) }
    if argument_kind == 2 { args.push(Expr.new(Span.none(), ExprKind.LitBool(true))) }
    val receiver = Box.new(Expr.new(Span.none(), ExprKind.Variable(intern("object"))))
    var call = Expr.new(Span.none(), ExprKind.MethodCall(receiver, intern(method), args))
    check_expr(&var call, &var ctx)
    var argument = Type.new_poison()
    when (call.kind) {
        MethodCall(_, _, checked_args) => {
            if checked_args.size() > 0 { argument = checked_args.at(0).ty }
        }
        _ => { }
    }
    return DynMethodOutcome {
        result: call.ty, dynamic: call.is_dynamic_call, slot: call.dynamic_slot,
        layout: call.dynamic_layout, diagnostics: unsafe { diagnostics.size() },
        argument: argument
    }
}

fun qualified_dyn_method_message(): String {
    val diagnostics: Ptr<Diagnostics> = unsafe { alloc<Diagnostics>() }
    unsafe { *diagnostics = Diagnostics.new() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    unsafe { signatures.insert_trait(dyn_dispatch_trait()) }
    var ctx = new_type_ctx(Type.new_void(Span.none()), unsafe { &var *diagnostics }, Option.None, signatures)
    ctx.declare_val(String.from("object"), dyn_method_ref(Type.new_int32(Span.none()), false))
    var args = List.new<Expr>()
    args.push(Expr.new(Span.none(), ExprKind.Variable(intern("object"))))
    val receiver = Box.new(Expr.new(Span.none(), ExprKind.Variable(intern("Dispatch"))))
    var call = Expr.new(Span.none(), ExprKind.MethodCall(receiver, intern("display"), args))
    check_expr(&var call, &var ctx)
    return unsafe { diagnostics.at(0).primary.message }
}

@test fun dyn_method_substitutes_declared_result(): void {
    val outcome = run_dyn_method("display", false, 0, false)
    when (outcome.result.kind) {
        Int32 => assert_eq(true, true, "Dispatch<int32>.display returns int32")
        _ => assert_eq(false, true, "the declared result is substituted")
    }
}

@test fun dyn_method_applies_substituted_argument_expectation(): void {
    val outcome = run_dyn_method("send", false, 1, false)
    when (outcome.argument.kind) {
        Int32 => assert_eq(true, true, "Dispatch<int32>.send expects int32")
        _ => assert_eq(false, true, "the argument expectation is substituted")
    }
}

@test fun dyn_method_rejects_wrong_substituted_argument(): void {
    val outcome = run_dyn_method("send", false, 2, false)
    assert_eq(!outcome.dynamic && outcome.diagnostics == 1, true, "Dispatch<int32>.send rejects bool")
}

@test fun dyn_method_rejects_method_from_another_trait(): void {
    val outcome = run_dyn_method("hidden", false, 0, true)
    assert_eq(!outcome.dynamic && outcome.diagnostics == 1, true, "only the principal trait contributes methods")
}

@test fun dyn_method_rejects_unknown_principal_method(): void {
    val outcome = run_dyn_method("missing", false, 0, false)
    assert_eq(!outcome.dynamic && outcome.diagnostics == 1, true, "unknown principal methods are diagnosed")
}

@test fun dyn_method_slot_zero_follows_declaration_order(): void {
    val outcome = run_dyn_method("display", false, 0, false)
    assert_eq(outcome.dynamic && outcome.slot == 0, true, "the first declared method uses slot zero")
}

@test fun dyn_method_slot_one_follows_declaration_order(): void {
    val outcome = run_dyn_method("send", false, 1, false)
    assert_eq(outcome.dynamic && outcome.slot == 1, true, "the second declared method uses slot one")
}

@test fun dyn_method_slot_two_follows_declaration_order(): void {
    val outcome = run_dyn_method("reset", true, 0, false)
    assert_eq(outcome.dynamic && outcome.slot == 2, true, "the third declared method uses slot two")
}

@test fun dyn_method_rejects_mutation_through_shared_object(): void {
    val outcome = run_dyn_method("reset", false, 0, false)
    assert_eq(!outcome.dynamic && outcome.diagnostics == 1, true, "a shared trait object cannot call a mutating method")
}

@test fun dyn_method_accepts_mutation_through_mutable_object(): void {
    val outcome = run_dyn_method("reset", true, 0, false)
    assert_eq(outcome.dynamic && outcome.diagnostics == 0, true, "a mutable trait object can call a mutating method")
}

@test fun dyn_method_records_layout_identity(): void {
    val outcome = run_dyn_method("display", false, 0, false)
    assert_eq(outcome.layout.as_str(), "Dispatch__int32", "the call records its dynamic layout")
}

@test fun dyn_method_rejects_qualified_dynamic_call(): void {
    assert_eq(qualified_dyn_method_message().as_str(), "qualified calls on dynamic trait objects are not supported; call the method on the object value", "qualified dynamic calls are deferred")
}
