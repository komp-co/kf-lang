// Which field types a bitwise copy may duplicate without owning anything twice.

import core.assert.assert_eq
import alloc.list.*

import kf_core.span.Span
import kf_core.ast.types.*
import kf_core.ast.declaration.*
import kf_core.intern.intern
import kf_typecheck.*
import kf_typecheck.leaked_diagnostics
import testing.test

fun ctx_for_copy_test(): TypeCtx {
    val sig_ptr: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *sig_ptr = new_sig_table() }
    val no_table: Ptr<DeclTable>? = Option.None<Ptr<DeclTable>>()
    return new_type_ctx(Type.new_void(Span.none()), unsafe { &var *leaked_diagnostics() }, no_table, sig_ptr)
}

fun pointee(t: Type): Ptr<Type> {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = t }
    return p
}

fun of_kind(kind: TypeKind): Type {
    return Type { kind: kind, provenance: Provenance.Declared(Span.none()) }
}

/// An impl header `impl Copy for Pair<T: bound>`, or unbounded with "".
fun impl_over_t(bound: str): TopDecl {
    var td = TopDecl.new(Span.none(), String.from("Pair"), TopDeclKind.Poison)
    var tp = TypeParam.new(Span.none(), String.from("T"))
    if !bound.equals("") {
        tp.bounds.push(TypeRef.new(Span.none(), TypeRefKind.Named(intern(bound), List.new<TypeRef>())))
    }
    td.generics.push(tp)
    return td
}

fun is_copy(t: Type, td: TopDecl): bool {
    var ctx = ctx_for_copy_test()
    return t.field_is_copy(&td, "Copy", &var ctx)
}

@test
fun a_raw_pointer_field_is_copy(): void {
    val t = of_kind(TypeKind.PtrTo(pointee(Type.new_int32(Span.none()))))
    assert_eq(is_copy(t, impl_over_t("")), true, "a raw pointer owns nothing")
}

@test
fun a_shared_borrow_field_is_copy(): void {
    val t = of_kind(TypeKind.RefTo(false, pointee(Type.new_int32(Span.none()))))
    assert_eq(is_copy(t, impl_over_t("")), true, "two shared borrows of one place are fine")
}

@test
fun a_mutable_borrow_field_is_not_copy(): void {
    val t = of_kind(TypeKind.RefTo(true, pointee(Type.new_int32(Span.none()))))
    assert_eq(is_copy(t, impl_over_t("")), false, "`&var` is exclusive, so it cannot be duplicated")
}

@test
fun a_box_field_is_not_copy(): void {
    val t = of_kind(TypeKind.BoxOf(pointee(Type.new_int32(Span.none()))))
    assert_eq(is_copy(t, impl_over_t("")), false, "a Box owns its pointee")
}

@test
fun a_type_parameter_bounded_by_copy_is_copy(): void {
    val t = of_kind(TypeKind.Generic(intern("T")))
    assert_eq(is_copy(t, impl_over_t("Copy")), true, "`impl Copy for Pair<T: Copy>` may copy a T")
}

@test
fun an_unbounded_type_parameter_is_not_copy(): void {
    val t = of_kind(TypeKind.Generic(intern("T")))
    assert_eq(is_copy(t, impl_over_t("")), false, "nothing says a bare T may be copied")
}

@test
fun a_primitive_without_a_copy_impl_is_not_copy(): void {
    val copies = is_copy(Type.new_int32(Span.none()), impl_over_t(""))
    assert_eq(copies, false, "Copy is an impl, not something the compiler assumes")
}
