import core.assert.assert_eq
import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.intern.intern
import kf_core.intern.CrateId
import kf_resolve.new_decl_table
import kf_typecheck.typecheck_module
import testing.test

// A trait `Score` declaring `fun value(n: int32): int32` and an impl for
// `Fixed` with whatever types a test asks for.

fun sig_tref(name: str): TypeRef {
    return TypeRef.new(Span.none(), TypeRefKind.Named(intern(name), List.new<TypeRef>()))
}

/// One per declaration, since a shared pointer would be dropped by each.
fun sig_tref_ptr(name: str): Ptr<TypeRef> {
    val p: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *p = sig_tref(name) }
    return p
}

fun sig_param(name: str, ty: str): Param {
    return Param.new(Span.none(), String.from(name), sig_tref_ptr(ty))
}

fun sig_method(name: str, param_ty: str, ret_ty: str, body: List<Stmt>): TopDecl {
    var params = List.new<Param>()
    params.push(sig_param("n", param_ty))
    return TopDecl.new(Span.none(), String.from(name), TopDeclKind.Function(params, sig_tref_ptr(ret_ty), body, true, false, false, false))
}

/// Counts only this check's diagnostics; the bare `return` body draws its own.
fun diags_for_impl(param_ty: str, ret_ty: str): uint64 {
    var trait_methods = List.new<TopDecl>()
    trait_methods.push(sig_method("value", "int32", "int32", List.new<Stmt>()))
    var trait_decl = TopDecl.new(
        Span.none(), String.from("Score"), TopDeclKind.TraitDecl(trait_methods, true, List.new<TypeRef>())
    )
    trait_decl.crate = CrateId.new("application")

    var fields = List.new<Field>()
    fields.push(Field.new(Span.none(), String.from("n"), sig_tref_ptr("int32"), false, true))
    var struct_decl = TopDecl.new(Span.none(), String.from("Fixed"), TopDeclKind.Struct(fields, true))
    struct_decl.crate = CrateId.new("application")

    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.Return(Option.None)))
    var impl_methods = List.new<TopDecl>()
    impl_methods.push(sig_method("value", param_ty, ret_ty, body))
    var impl_decl = TopDecl.new(
        Span.none(), String.from("Fixed"), TopDeclKind.TraitImpl(sig_tref_ptr("Score"), impl_methods)
    )
    impl_decl.crate = CrateId.new("application")

    var decls = List.new<TopDecl>()
    decls.push(trait_decl)
    decls.push(struct_decl)
    decls.push(impl_decl)
    var module = Module { crate: CrateId.new("application"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
    var table = new_decl_table()
    val out = module.typecheck_module(&var table)
    var n: uint64 = 0
    while item in &out {
        if (item.primary.message).contains("where trait") { n = n + 1 }
    }
    return n
}

@test
fun a_matching_signature_is_accepted(): void {
    assert_eq(diags_for_impl("int32", "int32"), 0, "the impl declares what the trait declared")
}

@test
fun a_wrong_parameter_type_is_rejected(): void {
    assert_eq(diags_for_impl("bool", "int32") > 0, true, "`value(n: bool)` does not implement `value(n: int32)`")
}

@test
fun a_wrong_return_type_is_rejected(): void {
    assert_eq(diags_for_impl("int32", "bool") > 0, true, "`value(): bool` does not implement `value(): int32`")
}

// The dyn adapter would convert silently between these.
@test
fun a_wider_integer_is_still_a_mismatch(): void {
    assert_eq(diags_for_impl("int64", "int64") > 0, true, "`int64` is not `int32`, however quietly C converts")
}
