import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.diagnostic.*
import kf_resolve.*

fun open_ctx(): TypeCtx {
    val diagnostics: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *diagnostics = List.new<Diagnostic>() }
    val signatures: Ptr<SigTable> = unsafe { alloc<SigTable>() }
    unsafe { *signatures = new_sig_table() }
    return new_type_ctx(void_ty(no_span()), diagnostics, Option.None, signatures)
}

fun at(offset: uint32): Span {
    return Span { file_id: 1, start: offset, end: offset + 1 }
}

fun open_literal(): Ptr<Expr> {
    val init: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init = new_expr(at(4), ExprKind.LitInt(5)) }
    return init
}

@test fun a_node_checked_twice_is_one_use(): void {
    var ctx = open_ctx()
    ctx.declare_flexible(String.from("n"), int32_ty(no_span()), false, open_literal())
    ctx.note_use("n", at(10))
    ctx.note_use("n", at(10))
    assert_eq(ctx.binding_uses("n"), 1 as uint64, "the same place read twice")
}

@test fun a_decided_binding_is_no_longer_open(): void {
    var ctx = open_ctx()
    ctx.declare_flexible(String.from("n"), int32_ty(no_span()), false, open_literal())
    ctx.decide_binding("n", int32_ty(no_span()), at(10))
    assert_eq(ctx.open_init("n") == null, true, "closed once decided")
}

@test fun a_decision_after_earlier_uses_is_kept_for_the_next_check(): void {
    var ctx = open_ctx()
    ctx.declare_flexible(String.from("n"), int32_ty(no_span()), false, open_literal())
    ctx.decide_binding_on_recheck("n", at(4), bool_ty(no_span()), at(20))
    var next = open_ctx()
    next.presets = ctx.decisions.clone()
    assert_eq(next.preset_for(at(4)) != null, true, "found by its initializer")
}

@test fun no_decision_is_kept_for_another_initializer(): void {
    var ctx = open_ctx()
    ctx.decide_binding_on_recheck("n", at(4), bool_ty(no_span()), at(20))
    var next = open_ctx()
    next.presets = ctx.decisions.clone()
    assert_eq(next.preset_for(at(8)) == null, true, "another binding's initializer")
}
