import core.assert.assert_eq
import core.assert.fail
import core.assert.assert
import testing.test

// Bump in the same commit that adds or removes a keyword.
fun expected_keyword_count(): uint64 { return 28 }

fun reachable_keyword_count(): uint64 {
    var i: uint64 = 0
    while true {
        when (keyword_at(i)) {
            Some(_) => { i = i + 1 }
            None => return i
        }
    }
    return i
}

@test fun every_keyword_is_reachable(): void {
    assert_eq(reachable_keyword_count(), expected_keyword_count(), "keyword_at yields every Keyword variant")
}

@test fun every_keyword_round_trips_through_its_spelling(): void {
    var mismatched = ""
    var i: uint64 = 0
    while i < reachable_keyword_count() {
        when (keyword_at(i)) {
            Some(k) => {
                val spelling = kw_str(k)
                when (keyword_from_str(spelling)) {
                    Some(back) => {
                        if !kw_str(back).equals(spelling) {
                            mismatched = mismatched + String.from(spelling)
                        }
                    }
                    None => { mismatched = mismatched + String.from(spelling) }
                }
            }
            None => {}
        }
        i = i + 1
    }
    assert_eq(mismatched.as_str(), "", "kw_str and keyword_from_str agree on every keyword")
}

@test fun an_ordinary_word_is_not_a_keyword(): void {
    when (keyword_from_str("funky")) {
        Some(_) => fail("`funky` is an identifier, not a keyword")
        None => assert(true, "a near-miss on `fun` does not match")
    }
}

@test fun dyn_is_a_reserved_keyword(): void {
    when (keyword_from_str("dyn")) {
        Some(k) => assert_eq(kw_str(k), "dyn", "`dyn` lexes as a keyword")
        None => fail("`dyn` must not lex as an identifier")
    }
}

@test fun keyword_at_ends_rather_than_wrapping(): void {
    when (keyword_at(expected_keyword_count())) {
        Some(_) => fail("one past the end must be null, not the first entry")
        None => assert(true, "the table terminates")
    }
}
