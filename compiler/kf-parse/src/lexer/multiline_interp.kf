// `"""a ${x} b"""`: expands like the single-line form, but ends at a run of
// three or more quotes and keeps its content raw.
//
// CONSTRAINT: raw except for `\$`, so a string whose `${` opens a slot can
// also hold a literal `${`.

import alloc.list.*

import kf_core.span.*
import kf_core.intern.intern
import kf_core.lang.lang_placeholder
import kf_core.lang.LangItem
import core.text.byte_at_in

pub fun raw_literal_body(src: str, from: uint32, to: uint32): String {
    var out = String.from("")
    val n = src.byte_len()
    var i: uint64 = from as uint64
    val end: uint64 = to as uint64
    while i < end {
        val b: uint8 = src.byte_at_in(n, i)
        if b == 92 && i + 1 < end && src.byte_at_in(n, i + 1) == 36 {
            out.push_byte(36 as uint8)
            i = i + 2
        } else {
            out.push_byte(b)
            i = i + 1
        }
    }
    return out
}

/// The receiver of an expansion's `from` and `of` calls: a placeholder the
/// type checker replaces with the lang string.
pub fun lang_string_token(sp: Span): Token {
    return new_token(TokenKind.Identifier(lang_placeholder(LangItem.String)), sp)
}

impl Lexer {
    /// Pure lookahead for a `${`, stopping at the closing run.
    mutating fun multiline_has_slot(): bool {
        var i: uint64 = 3
        while self.peek_at(i) != 0 {
            val b: uint8 = self.peek_at(i)
            if b == 34 {
                var run: uint64 = 0
                while self.peek_at(i + run) == 34 { run = run + 1 }
                if run >= 3 { return false }
                i = i + run
            } else if b == 92 && self.peek_at(i + 1) == 36 {
                i = i + 2
            } else if b == 36 && self.peek_at(i + 1) == 123 {
                return true
            } else {
                i = i + 1
            }
        }
        return false
    }

    /// `<lang string>.from("<raw literal>")`, joined with `+`.
    mutating fun push_raw_segment(toks: &var List<Token>, from: uint32, to: uint32, first: &var bool): void {
        if !(*first) { self.push_op(toks, Operator.Plus) }
        (*first) = false
        val sp = self.here()
        toks.push(lang_string_token(sp))
        self.push_op(toks, Operator.Dot)
        toks.push(new_token(TokenKind.Identifier(intern("from")), sp))
        self.push_op(toks, Operator.LParen)
        toks.push(new_token(TokenKind.StringLiteral(raw_literal_body(self.src.as_str(), from, to)), sp))
        self.push_op(toks, Operator.RParen)
    }

    /// The caller has established this is `"""` with a slot in it.
    pub mutating fun push_interpolated_multiline(toks: &var List<Token>): bool {
        val start: uint32 = self.pos as uint32
        val fid: uint32 = self.file_id
        self.advance_n(3)
        self.push_op(toks, Operator.LParen)
        var seg_start: uint32 = self.pos as uint32
        var first: bool = true
        var closed: bool = false
        while !(self.at_end()) && !closed {
            if self.peek() == 34 {
                // Four or more quotes end with the delimiter.
                val run = self.quote_run_len()
                if run >= 3 {
                    val seg_end: uint32 = (self.pos as uint32) + (run - 3)
                    if seg_end > seg_start || first {
                        self.push_raw_segment(toks, seg_start, seg_end, &var first)
                    }
                    self.advance_n(run as uint64)
                    closed = true
                } else {
                    self.advance_n(run as uint64)
                }
            } else if self.at_slot_open() {
                val seg_end: uint32 = self.pos as uint32
                self.push_raw_segment(toks, seg_start, seg_end, &var first)
                unsafe { self.advance() }
                unsafe { self.advance() }
                self.push_slot_expr(toks)
                seg_start = self.pos as uint32
            } else if self.peek() == 92 && self.peek_at(1) == 36 {
                self.advance_n(2)
            } else {
                unsafe { self.advance() }
            }
        }
        if !closed {
            val err_span = Span { file_id: fid, start: start, end: self.pos as uint32 }
            toks.push(new_token(TokenKind.LexError(String.from("unterminated multiline string literal (no closing `\"\"\"`)")), err_span))
            return true
        }
        self.push_op(toks, Operator.RParen)
        return true
    }
}
