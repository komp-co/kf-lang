// `op_str` cannot miss a variant, but it can give a spelling `read_operator`
// does not accept, or accepts only a prefix of. These guard that.

import core.assert.assert_eq
import core.assert.fail
import core.assert.assert

// Bump in the same commit that adds or removes an operator.
fun expected_operator_count(): uint64 { return 37 }

fun reachable_operator_count(): uint64 {
    var i: uint64 = 0
    while true {
        when (operator_at(i)) {
            Some(_) => { i = i + 1 }
            None => return i
        }
    }
    return i
}

@test fun every_operator_is_reachable(): void {
    assert_eq(reachable_operator_count(), expected_operator_count(), "operator_at yields every Operator variant")
}

// A short read comes back as the wrong variant (`==` read as `Eq`), so the
// identity check covers both failures.
@test fun every_operator_round_trips_through_its_spelling(): void {
    var mismatched = ""
    var i: uint64 = 0
    while i < reachable_operator_count() {
        when (operator_at(i)) {
            Some(o) => {
                val spelling = op_str(o)
                var l = new_lexer(spelling, 0)
                when (l.read_operator()) {
                    Some(back) => {
                        if !op_str(back).equals(spelling) || l.pos != l.len {
                            mismatched = mismatched + String.from(spelling)
                        }
                    }
                    None => { mismatched = mismatched + String.from(spelling) }
                }
            }
            None => {}
        }
        i = i + 1
    }
    assert_eq(mismatched.as_str(), "", "read_operator accepts every op_str spelling whole")
}

@test fun no_two_operators_share_a_spelling(): void {
    var duplicated = ""
    val n: uint64 = reachable_operator_count()
    var i: uint64 = 0
    while i < n {
        var j: uint64 = i + 1
        while j < n {
            when (operator_at(i)) {
                Some(a) => {
                    when (operator_at(j)) {
                        Some(b) => {
                            if op_str(a).equals(op_str(b)) {
                                duplicated = duplicated + String.from(op_str(a))
                            }
                        }
                        None => {}
                    }
                }
                None => {}
            }
            j = j + 1
        }
        i = i + 1
    }
    assert_eq(duplicated.as_str(), "", "every operator spelling is distinct")
}

@test fun operator_at_ends_rather_than_wrapping(): void {
    when (operator_at(expected_operator_count())) {
        Some(_) => fail("one past the end must be null, not the first entry")
        None => assert(true, "the table terminates")
    }
}

fun is_inclusive_range_op(o: Operator): bool {
    when (o) {
        DotDotEq => return true
        _ => return false
    }
}

@test fun tokenize_dotdoteq_is_one_token(): void {
    val toks = tokenize("..=", 1)
    assert_eq(toks.size(), 2, "DotDotEq + EOF")
    when (toks.at(0).kind) {
        Op(o) => assert_eq(is_inclusive_range_op(o), true, "..= lexes to Op(DotDotEq)")
        _ => assert_eq(false, true, "expected Op(DotDotEq) for ..=")
    }
}

// `0..= 3` must not become `0.. = 3`.
@test fun tokenize_inclusive_range_lexes_int_dotdoteq_int(): void {
    val toks = tokenize("0..=3", 1)
    assert_eq(toks.size(), 4, "IntLiteral DotDotEq IntLiteral EOF")
    when (toks.at(1).kind) {
        Op(o) => assert_eq(is_inclusive_range_op(o), true, "the middle token is ..=")
        _ => assert_eq(false, true, "expected Op(DotDotEq) in 0..=3")
    }
}

@test fun tokenize_exclusive_range_is_unaffected_by_the_inclusive_form(): void {
    val toks = tokenize("0..3", 1)
    when (toks.at(1).kind) {
        Op(o) => assert_eq(is_exclusive_range_op(o), true, "0..3 still lexes DotDot")
        _ => assert_eq(false, true, "expected Op(DotDot) in 0..3")
    }
}

fun is_exclusive_range_op(o: Operator): bool {
    when (o) {
        DotDot => return true
        _ => return false
    }
}
