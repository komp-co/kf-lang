// The escape language at its boundaries.

import core.assert.assert_eq
import testing.test

fun decoded(src: str): Escape {
    return decode_escape(src, 0, src.byte_len())
}

@test fun a_named_escape_decodes_to_its_byte(): void {
    assert_eq(decoded("\\n").value, 10 as uint8, "newline")
    assert_eq(decoded("\\n").width, 1 as uint64, "one byte after the backslash")
    assert_eq(decoded("\\t").value, 9 as uint8, "tab")
    // Accepted by both literal forms.
    assert_eq(decoded("\\a").value, 7 as uint8, "bell")
    assert_eq(decoded("\\b").value, 8 as uint8, "backspace")
    assert_eq(decoded("\\f").value, 12 as uint8, "form feed")
    assert_eq(decoded("\\v").value, 11 as uint8, "vertical tab")
}

// `B` is a hex digit, but the escape takes exactly two, so `B` is the next
// character.
@test fun a_hex_escape_takes_exactly_two_digits(): void {
    val e = decoded("\\x41B")
    assert_eq(e.value, 65 as uint8, "`A`, not a value out of range")
    assert_eq(e.width, 3 as uint64, "`x` and two digits — `B` is not part of it")
}

@test fun a_hex_escape_needs_both_digits(): void {
    assert_eq(decoded("\\x4").width, 0 as uint64, "one digit is not an escape")
    assert_eq(decoded("\\xZZ").width, 0 as uint64, "and neither is a non-digit")
}

@test fun an_octal_escape_stops_at_three_digits(): void {
    val esc = decoded("\\033")
    assert_eq(esc.value, 27 as uint8, "ESC")
    assert_eq(esc.width, 3 as uint64, "three digits")

    val short = decoded("\\07")
    assert_eq(short.value, 7 as uint8, "two digits is a whole escape")
    assert_eq(short.width, 2 as uint64, "and stops where the digits do")

    val capped = decoded("\\1011")
    assert_eq(capped.value, 65 as uint8, "`A` from three digits")
    assert_eq(capped.width, 3 as uint64, "the fourth digit is content")
}

@test fun nul_is_the_one_digit_octal_case(): void {
    assert_eq(decoded("\\0").value, 0 as uint8, "NUL")
    assert_eq(decoded("\\0").width, 1 as uint64, "one digit")
}

@test fun an_octal_escape_past_a_byte_is_not_an_escape(): void {
    // 400 octal is 256: refused, not truncated.
    assert_eq(decoded("\\400").width, 0 as uint64, "out of range is not an escape")
}

@test fun an_undefined_escape_is_refused(): void {
    assert_eq(decoded("\\q").width, 0 as uint64, "`\\q` names nothing")
    assert_eq(decoded("\\?").width, 0 as uint64, "the trigraph relic is not carried over")
    assert_eq(decoded("\\").width, 0 as uint64, "a backslash at the end escapes nothing")
}
