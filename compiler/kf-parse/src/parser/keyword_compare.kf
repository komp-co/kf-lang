import kf_parse.lexer.*

fun keyword_eq(a: Keyword, b: Keyword): bool {
    return keyword_tag(a) == keyword_tag(b)
}

fun keyword_tag(k: Keyword): int32 {
    return when (k) {
        Fun => 1
        Val => 2
        Var => 3
        Return => 4
        If => 5
        Else => 6
        While => 7
        True => 8
        False => 9
        Import => 10
        Pub => 11
        Struct => 12
        Enum => 13
        Impl => 14
        Extern => 15
        When => 16
        Mutating => 18
        Static => 19
        Unsafe => 20
        As => 21
        Break => 22
        Continue => 23
        For => 24
        In => 25
        Trait => 26
        TypeKw => 27
        Dyn => 28
        Internal => 29
    }
}
