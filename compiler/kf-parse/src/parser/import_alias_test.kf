import core.assert.assert_eq

@test fun an_import_as_records_its_alias(): void {
    var p = parser_for("import kf_core.diagnostic as diag")
    val imp = p.parse_import()
    assert_eq(imp.alias.as_str(), "diag", "the name after `as`")
}

@test fun an_import_as_keeps_the_module_path(): void {
    var p = parser_for("import kf_core.diagnostic as diag")
    val imp = p.parse_import()
    assert_eq(imp.path.size(), 2, "the alias is not a path segment")
}

@test fun an_import_without_as_has_no_alias(): void {
    var p = parser_for("import kf_core.diagnostic.*")
    val imp = p.parse_import()
    assert_eq(imp.alias.as_str(), "", "no alias")
}

@test fun a_wildcard_import_cannot_take_an_alias(): void {
    var p = parser_for("import kf_core.diagnostic.* as diag")
    val _imp = p.parse_import()
    assert_eq(p.diags.size(), 1, "`as` after `.*` is an error")
}

@test fun an_import_as_needs_a_name(): void {
    var p = parser_for("import kf_core.diagnostic as")
    val _imp = p.parse_import()
    assert_eq(p.diags.size(), 1, "`as` with nothing after it is an error")
}

fun exports_of(src: str): List<Import> {
    var p = parser_for(src)
    return p.parse_module(List.new<String>()).imports
}

fun export_errors(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

@test fun an_export_is_a_pub_import(): void {
    assert_eq(exports_of("export read from kf_core.parse\n").at(0).is_pub, true, "an export marks its import")
}

@test fun an_export_names_the_module_and_the_function(): void {
    assert_eq(exports_of("export read from kf_core.parse\n").at(0).path.size(), 3, "`kf_core.parse.read`")
}

@test fun an_export_of_several_names_gives_one_import_each(): void {
    assert_eq(exports_of("export read, write from kf_core.parse\n").size(), 2, "one per name")
}

@test fun an_export_as_records_the_new_name(): void {
    val imports = exports_of("export read as parse_file, write from kf_core.parse\n")
    assert_eq(imports.at(0).exposed.as_str(), "parse_file", "the name after `as`")
}

@test fun an_export_without_as_keeps_the_name(): void {
    val imports = exports_of("export read as parse_file, write from kf_core.parse\n")
    assert_eq(imports.at(1).exposed.as_str(), "", "no rename")
}

@test fun a_wildcard_export_names_the_module(): void {
    assert_eq(exports_of("export * from kf_core.parse\n").at(0).wildcard, true, "every name of the module")
}

@test fun an_export_is_parsed_before_declarations(): void {
    var p = parser_for("export read from kf_core.parse\n\nfun f(): void { }\n")
    val m = p.parse_module(List.new<String>())
    assert_eq(m.decls.size(), 1, "the export is not taken for a declaration")
}

@test fun an_export_needs_from(): void {
    assert_eq(export_errors("export read kf_core.parse\n"), 1, "`from` is required")
}

@test fun a_pub_import_points_at_export(): void {
    assert_eq(export_errors("pub import kf_core.parse.*\n"), 1, "the re-export syntax is `export`")
}

@test fun export_and_from_are_still_names_elsewhere(): void {
    val src = "fun f(): void {\n    val export = 1\n    val from = export\n}\n"
    assert_eq(export_errors(src), 0, "neither word is reserved")
}
