import core.assert.assert_eq

import kf_core.span.Span
import kf_parse.lexer.*
import testing.test

/// `pub` so the sub-module tests share it.
pub fun parser_for(src: str): Parser {
    return new_parser(tokenize(src, 1))
}

fun kw_token(kw: Keyword): Token {
    return new_token(TokenKind.KeywordTok(kw), Span.none())
}

fun op_token(op: Operator): Token {
    return new_token(TokenKind.Op(op), Span.none())
}

fun nl_token(): Token {
    return new_token(TokenKind.Newline, Span.none())
}

@test fun is_keyword_matches_same(): void {
    assert_eq(is_keyword(kw_token(Keyword.Fun), Keyword.Fun), true, "Fun=Fun")
}

@test fun is_keyword_distinguishes_different(): void {
    assert_eq(is_keyword(kw_token(Keyword.Fun), Keyword.Val), false, "Fun!=Val")
}

@test fun is_keyword_false_on_non_keyword(): void {
    assert_eq(is_keyword(nl_token(), Keyword.Fun), false, "Newline isn't Fun")
}

@test fun is_keyword_false_on_operator(): void {
    assert_eq(is_keyword(op_token(Operator.Plus), Keyword.Fun), false, "Plus isn't Fun")
}

@test fun is_op_matches_same(): void {
    assert_eq(is_op(op_token(Operator.Plus), Operator.Plus), true, "Plus=Plus")
}

@test fun is_op_distinguishes_different(): void {
    assert_eq(is_op(op_token(Operator.Plus), Operator.Minus), false, "Plus!=Minus")
}

@test fun is_op_false_on_keyword(): void {
    assert_eq(is_op(kw_token(Keyword.Fun), Operator.Plus), false, "Fun keyword isn't Plus")
}

@test fun is_op_distinguishes_paren_pairs(): void {
    assert_eq(is_op(op_token(Operator.LParen), Operator.RParen), false, "LParen!=RParen")
    assert_eq(is_op(op_token(Operator.LParen), Operator.LParen), true, "LParen=LParen")
}

@test fun is_op_distinguishes_comparison_ops(): void {
    assert_eq(is_op(op_token(Operator.Lt), Operator.Gt), false, "Lt!=Gt")
    assert_eq(is_op(op_token(Operator.LtEq), Operator.Lt), false, "LtEq!=Lt")
    assert_eq(is_op(op_token(Operator.GtEq), Operator.Gt), false, "GtEq!=Gt")
}
