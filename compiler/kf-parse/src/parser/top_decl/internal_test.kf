import core.assert.assert_eq

import kf_core.ast.declaration.TopDecl
import kf_parse.parser.parser_for
import testing.test

fun internal_decl(src: str): TopDecl {
    var p = parser_for(src)
    return p.parse_top_decl()
}

fun TopDecl.function_is_pub(): bool {
    return when (self.kind) {
        Function(_params, _ret, _body, is_pub, _u, _m, _s) => is_pub
        _ => true
    }
}

fun TopDecl.first_member_internal(): bool {
    return when (self.kind) {
        ImplBlock(methods) => methods.size() > 0 && methods.at(0).is_internal
        _ => false
    }
}

@test fun an_internal_function_is_marked_internal(): void {
    val td = internal_decl("internal fun double(n: int32): int32 { return n * 2 }")
    assert_eq(td.is_internal, true, "`internal` marks the declaration")
}

@test fun an_internal_function_is_not_pub(): void {
    val td = internal_decl("internal fun double(n: int32): int32 { return n * 2 }")
    assert_eq(td.function_is_pub(), false, "it is not exported")
}

@test fun an_internal_extension_is_marked_internal(): void {
    val td = internal_decl("internal fun int32.tripled(): int32 { return self * 3 }")
    assert_eq(td.is_internal, true, "an extension takes it too")
}

@test fun an_internal_val_is_marked_internal(): void {
    val td = internal_decl("internal val LIMIT: int32 = 10")
    assert_eq(td.is_internal, true, "a top-level value takes it too")
}

@test fun an_internal_method_is_marked_internal(): void {
    val td = internal_decl("impl Box2 { internal fun peek(): int32 { return 1 } }")
    assert_eq(td.first_member_internal(), true, "a method takes it in an impl")
}

@test fun a_pub_function_is_not_internal(): void {
    val td = internal_decl("pub fun double(n: int32): int32 { return n * 2 }")
    assert_eq(td.is_internal, false, "`pub` is not `internal`")
}
