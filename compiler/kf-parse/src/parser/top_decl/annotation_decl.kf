import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_parse.parser.*

impl Parser {
    /// `annotation` is a keyword only at the head of a declaration followed
    /// by a name, so it stays usable as an identifier everywhere else.
    fun at_annotation_decl(): bool {
        if !self.at_word("annotation") { return false }
        return when (self.peek_at(1).kind) {
            Identifier(_) => true
            _ => false
        }
    }

    /// `annotation NAME`, with optional `(p: T, ...)` and `on TARGET`,
    /// consuming `annotation`.
    mutating fun parse_annotation_decl(span: Span, is_pub: bool): TopDecl {
        unsafe { self.advance() } // consume `annotation`
        val name_at = self.peek().span
        val name = self.expect_name("annotation")
        unsafe { self.advance() }
        val params = if is_op(self.peek(), Operator.LParen) { self.parse_param_list() } else { List.new<Param>() }
        val target = if self.at_word("on") { self.parse_mark_target() } else { default_mark_target(name_at) }
        var td = new_top_decl(span, name, TopDeclKind.AnnotationDecl(params, target, is_pub))
        td.name_span = name_at
        return td
    }

    /// `on (A) -> R`, or `on struct`, `on enum` or `on type` with an optional
    /// `: Trait + Trait`, consuming `on`.
    mutating fun parse_mark_target(): MarkTarget {
        unsafe { self.advance() } // consume `on`
        val at = self.peek().span
        if is_op(self.peek(), Operator.LParen) {
            val function = self.parse_type_ref_ptr()
            val is_function = when (unsafe { function.kind }) {
                Function(_params, _ret) => true
                _ => false
            }
            if !is_function {
                self.parse_err(at, String.from("expected a function type after `on`, such as `(Request) -> Response`"))
            }
            return MarkTarget.Function(function)
        }
        val kind = when (self.peek().kind) {
            KeywordTok(k) => when (k) {
                Struct => 1
                Enum => 2
                TypeKw => 3
                _ => 0
            }
            _ => 0
        }
        if kind == 0 {
            val found = tok_str(self.peek())
            self.parse_err(at, "expected a function type, `struct`, `enum` or `type` after `on`, found ${found}")
            return default_mark_target(at)
        }
        unsafe { self.advance() }
        val bounds = self.parse_supertraits()
        return when kind {
            1 => MarkTarget.Struct(bounds)
            2 => MarkTarget.Enum(bounds)
            _ => MarkTarget.AnyType(bounds)
        }
    }
}
