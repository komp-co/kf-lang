import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDeclKind
import kf_parse.parser.*

fun parsed_params(src: str): List<Param> {
    var p = parser_for(src)
    val td = p.parse_top_decl()
    return when (td.kind) {
        Function(params, _ret, _body, _pub, _u, _m, _s) => params
        _ => List.new<Param>()
    }
}

@test fun a_parameter_records_its_default(): void {
    val params = parsed_params("fun connect(host: String, port: uint16 = 80): void {}")
    assert_eq(params.at(1).default != null, true, "`port` has a default")
}

@test fun a_parameter_without_default_has_none(): void {
    val params = parsed_params("fun connect(host: String, port: uint16 = 80): void {}")
    assert_eq(params.at(0).default == null, true, "`host` has none")
}

@test fun a_default_does_not_swallow_the_next_parameter(): void {
    val params = parsed_params("fun f(a: int32 = 1, b: int32 = 2): void {}")
    assert_eq(params.size(), 2, "both parameters are read")
}

@test fun a_cloned_parameter_keeps_its_default(): void {
    val params = parsed_params("fun connect(host: String, port: uint16 = 80): void {}")
    val copy = params.at(1).clone()
    assert_eq(copy.default != null, true, "the clone has the default")
}

@test fun a_cloned_module_keeps_the_default(): void {
    var p = parser_for("fun connect(port: uint16 = 80): void {}")
    val m = p.parse_module(List.new<String>())
    val copy = m.clone()
    val params = when (copy.decls.at(0).kind) {
        Function(params, _ret, _body, _pub, _u, _m, _s) => params
        _ => List.new<Param>()
    }
    assert_eq(params.at(0).default != null, true, "the module's clone has the default")
}
