import alloc.list.*

import kf_core.span.*
import kf_core.ast.declaration.*
import kf_core.intern.intern
import kf_core.ast.annotation.*
import kf_parse.parser.*

impl Parser {
    /// `template` is a keyword only at the head of `template NAME on` or
    /// `template NAME(Key) on`, so it stays usable as an identifier
    /// everywhere else.
    fun at_template_decl(): bool {
        if !self.at_word("template") || !self.peek_at(1).is_identifier() { return false }
        if self.peek_at(2).is_word("on") { return true }
        if !is_op(self.peek_at(2), Operator.LParen) || !self.peek_at(3).is_identifier() { return false }
        return is_op(self.peek_at(4), Operator.RParen) && self.peek_at(5).is_word("on")
    }

    /// `template NAME on KIND T { declarations }`, consuming `template`.
    mutating fun parse_template_decl(span: Span): TopDecl {
        self.advance() // consume `template`
        val name_at = self.peek().span
        val name = self.expect_name("template")
        self.advance()
        var key = intern("")
        if self.take_op(Operator.LParen) {
            key = intern(self.expect_name("template key").as_str())
            self.advance()
            self.advance() // consume `)`
        }
        self.advance() // consume `on`
        val kind_at = self.peek().span
        val kind = self.peek_mark_kind()
        if kind == null {
            val found = tok_str(self.peek())
            self.parse_err(kind_at, "expected the kind a template adds to, such as `struct`, found ${found}")
        } else {
            self.advance()
        }
        val marked = self.expect_name("template parameter")
        self.advance()
        self.template_param = intern(marked)
        self.template_members = intern(if (kind ?: MarkKind.Struct) == MarkKind.Enum { "variants" } else { "fields" })
        val body = self.parse_template_body()
        self.template_param = intern("")
        val template = TopDeclKind.Template(kind ?: MarkKind.Struct, intern(marked), body)
        var td = TopDecl.new(span, name, template)
        td.name_span = name_at
        td.template_key = key
        return td
    }

    mutating fun parse_template_body(): List<TopDecl> {
        var body = List.new<TopDecl>()
        if !self.take_op(Operator.LBrace) {
            val found = tok_str(self.peek())
            self.parse_err(self.peek().span, "expected `{` to open the template's declarations, found ${found}")
            return body
        }
        while true {
            self.skip_newlines()
            if is_op(self.peek(), Operator.RBrace) {
                if self.closes_member_loop() { continue }
                self.advance()
                break
            }
            if self.at_eof() {
                self.parse_err(self.peek().span, String.from("unclosed template: missing `}` before the file ends"))
                break
            }
            if self.at_member_loop() {
                self.open_member_loop()
                continue
            }
            var decl = self.parse_top_decl()
            decl.member_loop = self.member_loop.clone()
            body.push(decl)
        }
        return body
    }
}
