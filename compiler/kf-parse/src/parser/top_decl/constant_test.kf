import core.assert.assert_eq

import kf_core.ast.declaration.TopDecl
import kf_parse.parser.parser_for

fun TopDecl.constant_is_pub(): bool? {
    return when (self.kind) {
        Constant(_ty, _value, is_pub) => is_pub
        _ => null
    }
}

fun first_constant_error(src: str): String {
    var p = parser_for(src)
    val _td = p.parse_top_decl()
    if p.diags.size() == 0 { return String.from("") }
    return p.diags.at(0).primary.message.clone()
}

@test fun a_top_level_val_is_a_constant(): void {
    var p = parser_for("val LIMIT: int32 = 9")
    val td = p.parse_top_decl()
    assert_eq(td.constant_is_pub(), false, "a private constant")
}

@test fun a_pub_val_is_a_public_constant(): void {
    var p = parser_for("pub val LIMIT: int32 = 9")
    val td = p.parse_top_decl()
    assert_eq(td.constant_is_pub(), true, "`pub` carries to the constant")
}

@test fun a_top_level_val_keeps_its_name(): void {
    var p = parser_for("val LIMIT: int32 = 9")
    val td = p.parse_top_decl()
    assert_eq(td.name.as_str(), "LIMIT", "the declared name")
}

@test fun a_top_level_val_without_a_type_is_reported(): void {
    val message = first_constant_error("val LIMIT = 9")
    val expected = "a top-level `val` needs its type written: `val LIMIT: Type = ...`"
    assert_eq(message.as_str(), expected, "the type is required")
}

@test fun a_top_level_var_is_reported(): void {
    val message = first_constant_error("var COUNTER: int32 = 0")
    val expected = "a top-level binding cannot be a `var`: there is no global mutable state"
    assert_eq(message.as_str(), expected, "no global state")
}
