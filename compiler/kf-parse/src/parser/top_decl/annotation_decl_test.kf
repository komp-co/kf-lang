import core.assert.assert_eq

import kf_core.ast.*
import kf_parse.parser.parser_for

fun TopDecl.annotation_is_pub(): int32 {
    return when (self.kind) {
        AnnotationDecl(_params, is_pub) => if is_pub { 1 } else { 0 }
        _ => -1
    }
}

@test fun annotation_decl_records_its_name(): void {
    var p = parser_for("annotation bench")
    assert_eq(p.parse_top_decl().name.as_str(), "bench", "the declared name")
}

@test fun annotation_decl_is_private_by_default(): void {
    var p = parser_for("annotation bench")
    assert_eq(p.parse_top_decl().annotation_is_pub(), 0, "a private annotation declaration")
}

@test fun pub_annotation_decl_is_public(): void {
    var p = parser_for("pub annotation bench")
    assert_eq(p.parse_top_decl().annotation_is_pub(), 1, "a public annotation declaration")
}

@test fun annotation_decl_parses_without_error(): void {
    var p = parser_for("pub annotation bench\nfun f(): void {}")
    val _a = p.parse_top_decl()
    assert_eq(p.diags.size(), 0, "no diagnostics")
}

@test fun annotation_stays_an_identifier_in_a_body(): void {
    var p = parser_for("fun f(annotation: str): str { return annotation }")
    val _f = p.parse_top_decl()
    assert_eq(p.diags.size(), 0, "`annotation` as a parameter name")
}

fun TopDecl.annotation_params(): List<Param> {
    return when (self.kind) {
        AnnotationDecl(params, _pub) => params.clone()
        _ => List.new<Param>()
    }
}

@test fun an_annotation_without_parentheses_has_no_parameters(): void {
    var p = parser_for("annotation bench")
    assert_eq(p.parse_top_decl().annotation_params().size(), 0, "a bare declaration")
}

@test fun annotation_parameters_are_recorded_in_order(): void {
    var p = parser_for("pub annotation bench(iterations: int32, label: String)")
    val params = p.parse_top_decl().annotation_params()
    assert_eq(params.at(1).name.as_str(), "label", "the second parameter")
}

@test fun an_annotation_parameter_needs_a_type(): void {
    var p = parser_for("annotation bench(iterations)")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size() > 0, true, "as a function parameter does")
}
