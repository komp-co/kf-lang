import core.assert.assert_eq

import kf_core.ast.*
import kf_parse.parser.parser_for

fun TopDecl.annotation_is_pub(): int32 {
    return when (self.kind) {
        AnnotationDecl(_params, _target, is_pub) => if is_pub { 1 } else { 0 }
        _ => -1
    }
}

@test fun annotation_decl_records_its_name(): void {
    var p = parser_for("annotation bench")
    assert_eq(p.parse_top_decl().name.as_str(), "bench", "the declared name")
}

@test fun annotation_decl_is_private_by_default(): void {
    var p = parser_for("annotation bench")
    assert_eq(p.parse_top_decl().annotation_is_pub(), 0, "a private annotation declaration")
}

@test fun pub_annotation_decl_is_public(): void {
    var p = parser_for("pub annotation bench")
    assert_eq(p.parse_top_decl().annotation_is_pub(), 1, "a public annotation declaration")
}

@test fun annotation_decl_parses_without_error(): void {
    var p = parser_for("pub annotation bench\nfun f(): void {}")
    val _a = p.parse_top_decl()
    assert_eq(p.diags.size(), 0, "no diagnostics")
}

@test fun annotation_stays_an_identifier_in_a_body(): void {
    var p = parser_for("fun f(annotation: str): str { return annotation }")
    val _f = p.parse_top_decl()
    assert_eq(p.diags.size(), 0, "`annotation` as a parameter name")
}

fun TopDecl.annotation_params(): List<Param> {
    return when (self.kind) {
        AnnotationDecl(params, _target, _pub) => params.clone()
        _ => List.new<Param>()
    }
}

@test fun an_annotation_without_parentheses_has_no_parameters(): void {
    var p = parser_for("annotation bench")
    assert_eq(p.parse_top_decl().annotation_params().size(), 0, "a bare declaration")
}

@test fun annotation_parameters_are_recorded_in_order(): void {
    var p = parser_for("pub annotation bench(iterations: int32, label: String)")
    val params = p.parse_top_decl().annotation_params()
    assert_eq(params.at(1).name.as_str(), "label", "the second parameter")
}

@test fun an_annotation_parameter_needs_a_type(): void {
    var p = parser_for("annotation bench(iterations)")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size() > 0, true, "as a function parameter does")
}

/// "function", "struct", "enum" or "type", with the bound count.
fun TopDecl.target_shape(): String {
    when (self.kind) {
        AnnotationDecl(_params, target, _pub) => return target.shape()
        _ => return String.from("none")
    }
}

fun MarkTarget.shape(): String {
    return when (self) {
        Function(_ty) => String.from("function")
        Struct(bounds) => "struct:${bounds.size()}"
        Enum(bounds) => "enum:${bounds.size()}"
        AnyType(bounds) => "type:${bounds.size()}"
    }
}

fun shape_of(src: str): String {
    var p = parser_for(src)
    return p.parse_top_decl().target_shape()
}

@test fun a_bare_annotation_marks_a_function(): void {
    assert_eq(shape_of("annotation bench").as_str(), "function", "`on () -> void` by default")
}

@test fun a_function_type_target_is_recorded(): void {
    val shape = shape_of("annotation route(path: String) on (Request) -> Response")
    assert_eq(shape.as_str(), "function", "after the parameters")
}

@test fun a_struct_target_takes_its_bounds(): void {
    assert_eq(shape_of("annotation plugin on struct: Plugin + Default").as_str(), "struct:2", "two traits")
}

@test fun an_enum_target_may_have_no_bound(): void {
    assert_eq(shape_of("annotation level on enum").as_str(), "enum:0", "any enum")
}

@test fun a_type_target_is_struct_or_enum(): void {
    assert_eq(shape_of("annotation serialize on type: Serialize").as_str(), "type:1", "one trait")
}

@test fun a_target_that_is_not_a_type_kind_is_an_error(): void {
    var p = parser_for("annotation bench on fun")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size() > 0, true, "`fun` is not a target")
}

@test fun a_non_function_type_after_on_is_an_error(): void {
    var p = parser_for("annotation bench on (int32)")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size() > 0, true, "a grouped type is not a function type")
}
