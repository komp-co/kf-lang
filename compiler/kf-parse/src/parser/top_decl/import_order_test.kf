// A misplaced import says imports come first.

import core.assert.assert_eq
import alloc.list.*

import kf_parse.parser.parser_for

fun import_order_first_diag(src: str): String {
    val p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    if p.diags.size() == 0 { return String.from("") }
    return p.diags.at(0).primary.message.clone()
}

fun import_order_diags(src: str): uint64 {
    val p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

@test fun an_import_before_any_declaration_is_accepted(): void {
    assert_eq(import_order_diags("""import alloc.list.*
import core.option.*
fun f(): int32 { return 1 }"""), 0, "the ordinary case")
}

@test fun an_import_after_a_declaration_is_reported(): void {
    assert_eq(import_order_diags("""import alloc.list.*
fun f(): int32 { return 1 }
import core.option.*""") > 0, true, "the restriction still holds")
}

@test fun the_message_states_the_rule_instead_of_listing_import(): void {
    val m = import_order_first_diag("import alloc.list.*\nfun f(): int32 { return 1 }\nimport core.option.*")
    assert_eq(m.as_str().contains("must precede"), true, "the message has to name the rule")
}

@test fun the_message_does_not_offer_import_as_a_remedy(): void {
    val m = import_order_first_diag("import alloc.list.*\nfun f(): int32 { return 1 }\nimport core.option.*")
    assert_eq(m.as_str().contains("expected a declaration"), false, "listing `import` as allowed while rejecting one is the bug")
}
