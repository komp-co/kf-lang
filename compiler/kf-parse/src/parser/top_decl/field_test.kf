// A field must declare `val` or `var`.

import core.assert.assert_eq
import alloc.list.*

import kf_parse.parser.parser_for
import testing.test

fun field_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

@test fun a_val_field_parses(): void {
    assert_eq(field_diags("struct Point { pub val x: float64 }"), 0, "`val` is the ordinary case")
}

@test fun a_var_field_parses(): void {
    assert_eq(field_diags("struct Point { pub var x: float64 }"), 0, "`var` is the ordinary case")
}

@test fun a_non_pub_field_still_needs_the_keyword(): void {
    assert_eq(field_diags("struct Point { val x: float64 }"), 0, "`pub` is independent of `val`/`var`")
}

@test fun a_field_without_val_or_var_is_reported(): void {
    assert_eq(field_diags("struct Point { pub x: float64 }") > 0, true, "an omitted keyword used to become `val` in silence")
}

@test fun a_field_without_pub_or_val_is_reported(): void {
    assert_eq(field_diags("struct Point { x: float64 }") > 0, true, "the same omission without `pub`")
}

@test fun every_undeclared_field_is_reported(): void {
    assert_eq(field_diags("struct Point { pub x: float64\npub y: float64 }"), 2, "one diagnostic per field, not one per struct")
}
