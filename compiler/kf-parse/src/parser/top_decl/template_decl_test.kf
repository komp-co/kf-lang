import core.assert.assert_eq

import kf_core.ast.declaration.TopDecl
import kf_parse.parser.parser_for
import testing.test

fun equal_template(): str {
    return """template equal on struct T {
    impl Equal for T {
        fun equals(other: &T): bool {
            while field in T.fields {
                if field.of(self) != field.of(other) { return false }
            }
            return true
        }
    }
}"""
}

/// `kind T: n` for a template holding `n` declarations, or "".
fun TopDecl.template_shape(): String {
    return when (self.kind) {
        Template(kind, marked, body) => "${kind.word()} ${marked.as_str()}: ${body.size()}"
        _ => String.from("")
    }
}

@test fun a_template_records_its_annotation_kind_and_body(): void {
    var p = parser_for(equal_template())
    val td = p.parse_top_decl()
    val shape = "${td.name.as_str()} ${td.template_shape().as_str()}"
    assert_eq(shape.as_str(), "equal struct T: 1", "name, kind, T, one impl")
}

@test fun a_template_reading_fields_parses_without_error(): void {
    var p = parser_for(equal_template())
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size(), 0, "`field.of(self)` is a method call")
}

@test fun template_stays_an_identifier_elsewhere(): void {
    var p = parser_for("fun f(template: int32): int32 { return template }")
    val _f = p.parse_top_decl()
    assert_eq(p.diags.size(), 0, "`template` as a parameter name")
}

@test fun a_pub_template_is_an_error(): void {
    var p = parser_for("pub template equal on struct T { }")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size(), 1, "visibility comes from the annotation")
}

@test fun field_type_reads_as_a_projection(): void {
    var p = parser_for("fun f(x: field.type): void { }")
    val _td = p.parse_top_decl()
    assert_eq(p.diags.size(), 0, "`type` after `.` in a type")
}

@test fun a_keyed_template_records_its_key(): void {
    var p = parser_for("template deriving(Counted) on struct T { }")
    val td = p.parse_top_decl()
    assert_eq(p.diags.size(), 0, "no errors")
    assert_eq(td.template_key.as_str(), "Counted", "the key")
    assert_eq(td.name.as_str(), "deriving", "the annotation")
}
