import kf_core.span.*
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TopDeclKind
import kf_core.ast.declaration.new_top_decl
import kf_parse.parser.*

impl Parser {
    /// `val NAME: TYPE = VALUE` at top level, the `val` not yet consumed.
    mutating fun parse_constant(span: Span, is_pub: bool): TopDecl {
        self.advance() // consume `val`
        val name_at = self.peek().span
        val name = self.expect_name("value")
        self.advance()
        val ty = if self.take_op(Operator.Colon) {
            self.parse_type_ref_ptr()
        } else {
            self.parse_err(name_at, "a top-level `val` needs its type written: `val ${name}: Type = ...`")
            poison_type_ref_at(span)
        }
        val _eq = self.expect_op(Operator.Eq, "after the type (a top-level `val` needs a value)")
        val value = Box.new(self.parse_value_operand())
        var td = new_top_decl(span, name, TopDeclKind.Constant(ty, value, is_pub))
        td.name_span = name_at
        return td
    }

    /// A top-level `var`: reported, and parsed as a `val` so its uses resolve.
    mutating fun parse_top_var(span: Span, is_pub: bool): TopDecl {
        self.parse_err(span, "a top-level binding cannot be a `var`: there is no global mutable state")
        return self.parse_constant(span, is_pub)
    }
}
