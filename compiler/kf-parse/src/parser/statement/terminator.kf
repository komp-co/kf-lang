// One statement per line. What the expression parser did not take is an
// error, checked once by the block loop.

import kf_parse.parser.*

impl Parser {
    /// Reports the first leftover token and skips the rest, so a typo costs
    /// one diagnostic.
    pub mutating fun require_stmt_terminator(): void {
        if !self.at_stmt_terminator() {
            val t = self.peek()
            val span = t.span
            val msg = "expected end of line after this statement, found ${t.tok_str()}"
            self.parse_err(span, msg)
            while !self.at_stmt_terminator() {
                unsafe { self.advance() }
            }
        }
        if is_op(self.peek(), Operator.Semicolon) { unsafe { self.advance() } }
    }

    /// End of line, `;`, `}` or EOF. The last two belong to whoever opened
    /// them and are not consumed.
    pub mutating fun at_stmt_terminator(): bool {
        if self.at_eof() { return true }
        val t = self.peek()
        if t.tok_is_newline() { return true }
        if t.is_op(Operator.Semicolon) { return true }
        if t.is_op(Operator.RBrace) { return true }
        return false
    }
}
