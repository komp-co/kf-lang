// `if (cond) stmt`: a parenthesised condition may take an unbraced
// statement; an unparenthesised one still needs braces.

import core.assert.assert_eq
import alloc.list.*

import kf_parse.parser.parser_for

fun guard_diags(src: str): uint64 {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    return p.diags.size()
}

@test fun a_parenthesised_condition_takes_an_unbraced_statement(): void {
    assert_eq(guard_diags("""fun f(): int32 {
if (1 == 1) return 0
return 1
}"""), 0, "`if (cond) stmt` is the guard form")
}

@test fun a_guard_may_be_an_assignment(): void {
    assert_eq(guard_diags("""fun f(): int32 {
var a = 1
if (a == 1) a = 2
return a
}"""), 0, "any single statement is a body")
}

@test fun a_run_of_guards_parses(): void {
    assert_eq(guard_diags("""fun f(a: int32): int32 {
if (a == 1) return 1
if (a == 2) return 2
if (a == 3) return 3
return 0
}"""), 0, "the case the feature exists for")
}

@test fun an_unparenthesised_condition_still_requires_braces(): void {
    assert_eq(guard_diags("""fun f(): int32 {
if 1 == 1 return 0
return 1
}""") > 0, true, "`if cond stmt` is still an error")
}

@test fun a_partly_parenthesised_condition_still_requires_braces(): void {
    assert_eq(guard_diags("fun f(a: int32, b: int32): int32 {\nif (a) == (b) return 0\nreturn 1\n}") > 0, true, "the condition must be ONE parenthesised group, not merely start with `(`")
}

@test fun a_trailing_token_after_a_guard_is_reported(): void {
    assert_eq(guard_diags("""fun f(): int32 {
if (1 == 1) return 0 12345
return 1
}"""), 1, "the guard hazard must not reappear here")
}

@test fun a_parenthesised_condition_still_takes_a_block(): void {
    assert_eq(guard_diags("""fun f(): int32 {
if (1 == 1) {
return 0
}
return 1
}"""), 0, "the parenthesised-plus-braced form was always legal")
}

@test fun a_braced_if_still_takes_an_else(): void {
    assert_eq(guard_diags("""fun f(): int32 {
if (1 == 1) {
return 0
} else {
return 1
}
}"""), 0, "`else` is unaffected")
}

@test fun an_unbraced_guard_with_an_else_is_reported(): void {
    assert_eq(guard_diags("fun f(): int32 {\nif (1 == 1) return 0 else return 1\n}") > 0, true, "an `else` needs a braced body, and must say so")
}
