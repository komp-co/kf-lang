import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_parse.parser.parser_for
import testing.test

fun call_arguments(src: str): List<Expr> {
    var p = parser_for(src)
    val e = p.parse_expr()
    return when (e.kind) {
        Call(_name, args) => args
        MethodCall(_receiver, _name, args) => args
        _ => List.new<Expr>()
    }
}

@test fun a_named_argument_records_its_parameter(): void {
    val args = call_arguments("connect(host, retries = 5)")
    assert_eq(args.at(1).arg_name.as_str(), "retries", "the second argument names `retries`")
}

@test fun a_positional_argument_names_nothing(): void {
    val args = call_arguments("connect(host, retries = 5)")
    assert_eq(args.at(0).arg_name.as_str(), "", "the first argument is positional")
}

@test fun a_named_argument_keeps_its_value(): void {
    val args = call_arguments("connect(retries = 5)")
    val is_literal = when (args.at(0).kind) {
        LitInt(_v) => true
        _ => false
    }
    assert_eq(is_literal, true, "the value is the expression after `=`")
}

@test fun a_comparison_argument_is_positional(): void {
    val args = call_arguments("check(a == b)")
    assert_eq(args.at(0).arg_name.as_str(), "", "`==` is not a named argument")
}

@test fun a_method_call_takes_named_arguments(): void {
    val args = call_arguments("server.listen(port = 80)")
    assert_eq(args.at(0).arg_name.as_str(), "port", "a method's argument is named too")
}
