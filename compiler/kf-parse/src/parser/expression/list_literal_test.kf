import core.assert.assert_eq
import testing.test

@test fun an_empty_list_literal_parses(): void {
    assert_eq(expression_syntax_diags("fun f(): void { val xs = [] }"), 0, "[] is a literal")
}

@test fun a_list_literal_may_end_in_a_comma(): void {
    assert_eq(expression_syntax_diags("fun f(): void { val xs = [1, 2,] }"), 0, "a trailing comma is allowed")
}

@test fun a_list_literal_may_span_lines(): void {
    assert_eq(expression_syntax_diags("""fun f(): void { val xs = [
    1,
    2
] }"""), 0, "newlines inside are whitespace")
}

@test fun a_list_literal_takes_a_method_call(): void {
    val diags = expression_syntax_diags("fun f(): void { val n = [1, 2].size() }")
    assert_eq(diags, 0, "postfix parsing continues after the literal")
}

@test fun an_unclosed_list_literal_is_reported(): void {
    assert_eq(expression_syntax_diags("fun f(): void { val xs = [1, 2 }") > 0, true, "the `]` is required")
}
