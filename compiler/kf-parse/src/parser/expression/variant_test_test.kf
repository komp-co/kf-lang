import core.assert.assert_eq
import kf_parse.parser.parser_for
import testing.test

fun is_when_expr(src: str): bool {
    var p = parser_for(src)
    val e = p.parse_expr()
    return when (e.kind) {
        WhenExpr(_subject, arms) => arms.size() == 2
        _ => false
    }
}

fun is_and_of_tests(src: str): bool {
    var p = parser_for(src)
    val e = p.parse_expr()
    return when (e.kind) {
        Binary(lhs, AndAnd, _rhs) => lhs.kind.is_when_expr()
        _ => false
    }
}

fun ExprKind.is_when_expr(): bool {
    return when (self) {
        WhenExpr(_subject, _arms) => true
        _ => false
    }
}

@test fun a_variant_test_is_a_two_armed_when(): void {
    assert_eq(is_when_expr("shape is Circle"), true, "the variant arm, then `_`")
}

@test fun a_variant_test_takes_a_payload_pattern(): void {
    assert_eq(is_when_expr("shape is Rect(_, 3)"), true, "any arm pattern follows `is`")
}

@test fun a_variant_test_binds_tighter_than_and(): void {
    assert_eq(is_and_of_tests("a is Circle && b"), true, "`is` is tested before `&&` joins")
}

@test fun is_stays_an_ordinary_name(): void {
    assert_eq(is_when_expr("is"), false, "`is` is a keyword only after an operand")
}
