// The `?:` diagnostics name the fix: only the braced form bails, and
// `?: <expr>` supplies a default.

import core.assert.assert_eq

import kf_parse.parser.parser_for
import testing.test

fun elvis_msg(src: str): String {
    var p = parser_for(src)
    val _m = p.parse_module(List.new<String>())
    if p.diags.size() == 0 { return String.from("") }
    return p.diags.at(0).primary.message.clone()
}

@test fun a_bare_default_is_not_an_error(): void {
    assert_eq(elvis_msg("""fun f(): int32 {
val v = g() ?: 0
return v
}""").as_str(), "", "`?: <expr>` supplies a default")
}

@test fun a_diverging_braced_bail_is_not_an_error(): void {
    assert_eq(elvis_msg("fun f(): int32 {\nval v = g() ?: { return 0 }\nreturn v\n}").as_str(), "", "a braced bail that diverges is the shape the form is for")
}

@test fun a_non_diverging_braced_bail_names_the_braces(): void {
    val m = elvis_msg("fun f(): int32 {\nval v = g() ?: { h() }\nreturn v\n}")
    assert_eq(m.contains("braced"), true, "the braces are what made it a bail, so the message has to say so")
}

@test fun the_message_offers_the_default_form(): void {
    val m = elvis_msg("fun f(): int32 {\nval v = g() ?: { h() }\nreturn v\n}")
    assert_eq(m.contains("drop the braces"), true, "naming the fix is what ends the search")
}
