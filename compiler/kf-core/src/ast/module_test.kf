import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import testing.test

@test fun string_vec_push_grows(): void {
    var v = []
    v.push("kf_core")
    v.push("ast")
    assert_eq(v.size(), 2, "two pushes")
}

@test fun string_vec_push_past_initial_capacity(): void {
    var v = []
    v.push("a")
    v.push("b")
    v.push("c")
    v.push("d")
    v.push("e")
    assert_eq(v.size(), 5, "grew past initial capacity")
}

@test fun new_import_round_trips_fields(): void {
    val sp = Span { file_id: 2, start: 0, end: 10 }
    val imp = Import.new(sp, [], true)
    assert_eq(imp.span.start, 0, "span start")
    assert_eq(imp.span.end, 10, "span end")
    assert_eq(imp.wildcard, true, "wildcard preserved")
}

@test fun import_vec_push_grows(): void {
    var v = []
    v.push(Import.new(Span.none(), [], false))
    v.push(Import.new(Span.none(), [], true))
    assert_eq(v.size(), 2, "two imports")
}

@test fun new_module_initializes_empty(): void {
    val m = Module.new([])
    assert_eq(m.path.size(), 0, "empty path")
    assert_eq(m.decls.size(), 0, "no decls")
    assert_eq(m.imports.size(), 0, "no imports")
}
