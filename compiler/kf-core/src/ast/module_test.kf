import core.assert.assert_eq
import alloc.list.*

import kf_core.span.*
import testing.test

@test fun string_vec_starts_empty(): void {
    val v = List.new<String>()
    assert_eq(v.size(), 0, "fresh string vec")
}

@test fun string_vec_push_grows(): void {
    var v = List.new<String>()
    v.push(String.from("kf_core"))
    v.push(String.from("ast"))
    assert_eq(v.size(), 2, "two pushes")
}

@test fun string_vec_push_past_initial_capacity(): void {
    var v = List.new<String>()
    v.push(String.from("a"))
    v.push(String.from("b"))
    v.push(String.from("c"))
    v.push(String.from("d"))
    v.push(String.from("e"))
    assert_eq(v.size(), 5, "grew past initial capacity")
}

@test fun new_import_round_trips_fields(): void {
    val sp = Span { file_id: 2, start: 0, end: 10 }
    val imp = new_import(sp, List.new<String>(), true)
    assert_eq(imp.span.start, 0, "span start")
    assert_eq(imp.span.end, 10, "span end")
    assert_eq(imp.wildcard, true, "wildcard preserved")
}

@test fun import_vec_starts_empty(): void {
    val v = List.new<Import>()
    assert_eq(v.size(), 0, "fresh import vec")
}

@test fun import_vec_push_grows(): void {
    var v = List.new<Import>()
    v.push(new_import(no_span(), List.new<String>(), false))
    v.push(new_import(no_span(), List.new<String>(), true))
    assert_eq(v.size(), 2, "two imports")
}

@test fun new_module_initializes_empty(): void {
    val m = new_module(List.new<String>())
    assert_eq(m.path.size(), 0, "empty path")
    assert_eq(m.decls.size(), 0, "no decls")
    assert_eq(m.imports.size(), 0, "no imports")
}

@test fun module_vec_starts_empty(): void {
    val v = List.new<Module>()
    assert_eq(v.size(), 0, "fresh module vec")
}
