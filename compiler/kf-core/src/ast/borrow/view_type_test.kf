import core.assert.assert_eq
import alloc.list.*
import testing.test

fun window_views(): List<String> {
    return ["Window"]
}

@test fun a_view_is_named_as_written(): void {
    assert_eq(names_view(&window_views(), "Window"), true, "the bare name")
}

@test fun a_view_is_named_through_its_module(): void {
    assert_eq(names_view(&window_views(), "geometry.Window"), true, "a qualified use")
}

@test fun a_view_is_named_by_its_identity(): void {
    assert_eq(names_view(&window_views(), "app::geometry::Window"), true, "a resolved struct's identity")
}

@test fun another_type_is_not_a_view(): void {
    assert_eq(names_view(&window_views(), "Windows"), false, "a name is matched whole")
}
