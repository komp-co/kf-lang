import core.assert.*

@test fun new_decl_id_round_trips_raw(): void {
    val id = new_decl_id(42)
    assert_eq(id.raw, 42, "raw round-trip")
}

@test fun zero_is_an_ordinary_id(): void {
    val id: DeclId? = new_decl_id(0)
    assert_eq(id.is_some(), true, "an id of 0 is still present")
    assert_eq(id.unwrap().raw, 0, "and carries its raw")
}
