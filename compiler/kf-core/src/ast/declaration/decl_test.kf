import core.assert.*
import alloc.list.*

import kf_core.span.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import testing.test
import kf_core.intern.intern

@test fun new_param_round_trips_fields(): void {
    val sp = Span { file_id: 1, start: 0, end: 5 }
    val ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ty = TypeRef.new_poison(Span.none()) }
    val p = Param.new(sp, "x", ty)
    assert_eq(p.span.start, 0, "span")
    assert_eq(p.name.as_str(), "x", "name")
}

@test fun param_vec_push_grows(): void {
    var v = []
    val ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ty = TypeRef.new_poison(Span.none()) }
    v.push(Param.new(Span.none(), "a", ty))
    assert_eq(v.size(), 1, "one pushed")
}

@test fun new_field_round_trips(): void {
    val ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ty = TypeRef.new_poison(Span.none()) }
    val f = Field.new(Span.none(), "count", ty, true, true)
    assert_eq(f.is_var, true, "is_var")
    assert_eq(f.is_pub, true, "is_pub")
    assert_eq(f.name.as_str(), "count", "name")
}

@test fun new_variant_round_trips(): void {
    val v = Variant.new(Span.none(), "Some", [])
    assert_eq(v.name.as_str(), "Some", "name")
    assert_eq(v.payloads.size(), 0, "no payloads yet")
}

@test fun new_top_decl_initializes_poison_id(): void {
    val td = TopDecl.new(Span.none(), "add", TopDeclKind.Poison)
    assert_eq(td.decl.is_none(), true, "decl id starts absent")
    assert_eq(td.name.as_str(), "add", "name preserved")
}

@test fun top_decl_vec_push_grows(): void {
    var v = []
    v.push(TopDecl.new(Span.none(), "a", TopDeclKind.Poison))
    v.push(TopDecl.new(Span.none(), "b", TopDeclKind.Poison))
    assert_eq(v.size(), 2, "two pushes")
}

@test fun type_param_unbounded_has_empty_bounds(): void {
    val tp = TypeParam.new(Span.none(), "T")
    assert_eq(tp.name.as_str(), "T", "type param name")
    assert_eq(tp.bounds.size(), 0, "unbounded → no bounds")
}

@test fun top_decl_defaults_to_no_generics(): void {
    val k = TopDeclKind.Struct([], true)
    val td = TopDecl.new(Span.none(), "Foo", k)
    assert_eq(td.generics.size(), 0, "non-generic decl → empty generics")
}

@test fun trait_decl_kind_constructs(): void {
    val k = TopDeclKind.TraitDecl([], true, [])
    val td = TopDecl.new(Span.none(), "Clone", k)
    assert_eq(td.name.as_str(), "Clone", "trait name on outer decl")
    when (td.kind) {
        TraitDecl(methods, is_pub, _) => {
            assert_eq(methods.size(), 0, "no methods")
            assert_eq(is_pub, true, "is_pub")
        }
        _ => assert_eq(false, true, "expected TraitDecl")
    }
}

@test fun trait_impl_kind_constructs(): void {
    val tref: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *tref = TypeRef.new(Span.none(), TypeRefKind.Named(intern("Clone"), [])) }
    val k = TopDeclKind.TraitImpl(tref, [])
    val td = TopDecl.new(Span.none(), "Pair", k)
    assert_eq(td.name.as_str(), "Pair", "impl target on outer decl")
    when (td.kind) {
        TraitImpl(_tref, methods) => assert_eq(methods.size(), 0, "no methods")
        _ => assert_eq(false, true, "expected TraitImpl")
    }
}
