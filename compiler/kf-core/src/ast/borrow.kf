// Which written types are borrows, and where a returned one comes from.
// CONSTRAINT: one rule for TypeCheck, which enforces it, and the interface
// writer, which publishes it.

import alloc.list.*

/// `str`, `&T` and `&var T`: types whose validity is bounded by another frame.
pub fun TypeRef.type_ref_is_borrow(): bool {
    when (self.kind) {
        Reference(_, _) => return true
        Named(name, args) => return args.size() == 0 && name.as_str() == "str"
        _ => return false
    }
}

/// A borrow, or a value of one of `views`.
pub fun TypeRef.type_ref_borrows(views: &List<String>): bool {
    if self.type_ref_is_borrow() { return true }
    when (self.kind) {
        Named(name, _args) => return names_view(views, name.as_str())
        _ => return false
    }
}

/// The parameter index a returned borrow comes from, or -1 when it borrows
/// nothing the caller owns. An instance method borrows from `self`;
/// otherwise the single borrow parameter is the origin. With none, the borrow
/// can only be a literal. With several, the origin cannot be named and the
/// signature is rejected where it is checked.
pub fun type_ref_borrow_origin(param_types: &List<TypeRef>, ret: &TypeRef, has_self: bool,
    views: &List<String>): int32 {
    if !ret.type_ref_borrows(views) { return 0 - 1 }
    if has_self { return 0 }
    var found: int32 = 0 - 1
    while i in 0..param_types.size() {
        val p = *param_types.at(i)
        if p.type_ref_borrows(views) {
            if found != 0 - 1 { return 0 - 1 }
            found = i as int32
        }
    }
    return found
}

/// The binding a borrow ultimately reads from, or "" when it bottoms out in a
/// literal or an owned value. Field reads, derefs, method calls and coercions
/// keep pointing into the same storage, and a call's result into the one
/// argument it was lent.
pub fun Expr.expr_borrow_root(): String {
    when (self.kind) {
        Variable(name) => return name.as_string()
        FieldAccess(base, _) => return expr_borrow_root(unsafe { &*base })
        Deref(inner) => return expr_borrow_root(unsafe { &*inner })
        MethodCall(receiver, _, _) => return expr_borrow_root(unsafe { &*receiver })
        Call(_name, args) => return lent_argument_root(&args)
        DynCoerce(inner, _) => return expr_borrow_root(unsafe { &*inner })
        Cast(inner, _) => return expr_borrow_root(unsafe { &*inner })
        _ => return ""
    }
}

/// A returned borrow comes from the single borrow parameter, so from the one
/// argument passed as a borrow. With none or several there is no one root.
fun lent_argument_root(args: &List<Expr>): String {
    var root = String.from("")
    var lent: uint64 = 0
    while arg in &args {
        if arg.is_lent() {
            lent = lent + 1
            root = arg.expr_borrow_root()
        }
    }
    return if lent == 1 { root } else { String.from("") }
}

/// Passed as a borrow: borrow-typed, or lent with `&` written or implied.
fun Expr.is_lent(): bool {
    val c = self.coerce
    if c == coerce_addr_of() || c == coerce_written_amp() || c == coerce_written_amp_var() { return true }
    when (self.ty.kind) {
        StrTy => return true
        RefTo(_, _) => return true
        _ => return false
    }
}
