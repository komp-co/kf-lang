import core.assert.assert_eq
import core.assert.assert
import core.assert.fail

import kf_core.span.*
import kf_core.intern.intern
import testing.test

@test fun new_type_ref_round_trips_span(): void {
    val sp = Span { file_id: 1, start: 5, end: 9 }
    val type_args = []
    val tr = TypeRef.new(sp, TypeRefKind.Named(intern("int32"), type_args))
    assert_eq(tr.span.start, 5, "span start")
    assert_eq(tr.span.end, 9, "span end")
}

@test fun type_ref_poison_carries_span(): void {
    val sp = Span { file_id: 1, start: 10, end: 20 }
    val tr = TypeRef.new_poison(sp)
    assert_eq(tr.span.start, 10, "poison keeps span")
    when (tr.kind) {
        Poison => assert(true, "ok")
        Named(_, _) => fail("expected Poison, got Named")
        DynTrait(_, _) => fail("expected Poison, got DynTrait")
        Function(_, _) => fail("expected Poison, got Function")
        Reference(_, _) => fail("expected Poison, got Reference")
        Array(_, _) => fail("expected Poison, got Array")
        Projection(_, _) => fail("expected Poison, got Projection")
        Value(_) => fail("expected Poison, got Value")
    }
}

@test fun type_ref_vec_push_increments(): void {
    var v = []
    v.push(TypeRef.new_poison(Span.none()))
    assert_eq(v.size(), 1, "after one push")
    v.push(TypeRef.new_poison(Span.none()))
    assert_eq(v.size(), 2, "after two pushes")
}

@test fun dyn_type_ref_preserves_its_principal(): void {
    val tr = TypeRef.new(Span.none(), TypeRefKind.DynTrait(intern("Display"), []))
    when (tr.kind) {
        DynTrait(name, _) => assert_eq(name.as_str(), "Display", "dynamic type keeps its principal trait")
        _ => fail("expected a dynamic trait type")
    }
}
