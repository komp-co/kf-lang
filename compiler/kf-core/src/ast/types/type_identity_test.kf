import core.assert.assert_eq
import core.assert.fail
import kf_core.intern.intern
import testing.test
import kf_core.span.Span
import kf_core.intern.CrateId

@test
fun same_display_name_has_distinct_crate_identities(): void {
    val left = TypeIdentity.new(CrateId.new("left"), intern("models"), intern("Point"))
    val right = TypeIdentity.new(CrateId.new("right"), intern("models"), intern("Point"))
    assert_eq(left == right, false, "same display name in different crates is distinct")
}
@test
fun resolved_struct_type_retains_its_identity(): void {
    val identity = TypeIdentity.new(CrateId.new("left"), intern("models"), intern("Point"))
    val ty = Type.new_named_struct(identity, Span.none())
    when (ty.kind) {
        Struct(actual) => {
            assert_eq(type_identity_matches(actual, identity), true, "resolved struct retains its semantic identity")
        }
        _ => fail("expected Struct")
    }
}

@test
fun canonical_type_identity_joins_owned_components(): void {
    val identity = TypeIdentity.new(CrateId.new("math"), intern("algebra"), intern("Vector"))
    val canonical = canonical_type_identity(identity)
    assert_eq(canonical.as_str(), "math::algebra::Vector", "canonical identity joins crate module and name")
}

@test
fun type_identity_display_returns_owned_str(): void {
    val display: String = type_identity_display(intern("math::algebra::Vector"))
    assert_eq(display.as_str(), "Vector", "display omits canonical identity prefixes")
}
