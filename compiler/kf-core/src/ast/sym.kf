// An interned name handle, backed by the prelude's immortal interner. Freely
// copyable; equal strings share one Sym, so equality is a u32 compare.
pub extern "C" fun kf_sym_intern(s: str): uint32
pub extern "C" fun kf_sym_resolve(id: uint32): str

@derive(Copy)
pub struct Sym { pub val id: uint32 }

pub fun intern(s: str): Sym { return Sym { id: kf_sym_intern(s) } }
pub fun intern_string(s: String): Sym { return Sym { id: kf_sym_intern(s.as_str()) } }

impl Sym {
    pub fun as_str(): str { return kf_sym_resolve(self.id) }
    pub fun as_string(): String { return String.from(kf_sym_resolve(self.id)) }
}

impl Equal for Sym {
    fun equals(other: &Sym): bool { return self.id == other.id }
}
