import core.assert.assert_eq
import core.display.assert_eq
import testing.test

@test fun intern_roundtrips(): void {
    val s = intern("hello")
    assert_eq(s.as_str(), "hello", "intern/resolve round-trips")
}

@test fun intern_is_canonical(): void {
    val a = intern("dup")
    val b = intern("dup")
    assert_eq(a.id == b.id, true, "same string -> same Sym")
    assert_eq(a.id, b.id, "same string -> same id")
}

@test fun distinct_strings_distinct_syms(): void {
    val a = intern("aaa")
    val b = intern("bbb")
    assert_eq(a.id == b.id, false, "different strings -> different Syms")
}

@test fun intern_string_matches_intern(): void {
    val a = intern("foo")
    val b = intern_string(String.from("foo"))
    assert_eq(a.id == b.id, true, "intern_string canonicalizes like intern")
}

@test
fun test_interner_grows_without_changing_existing_symbols(): void {
    val anchor = intern("growth-anchor")
    var i: uint64 = 0
    while i < 70000 {
        val name = String.of(&(i))
        val _symbol = intern(name)
        i = i + 1
    }
    val same_anchor = intern("growth-anchor")
    val stable = anchor.id == same_anchor.id && anchor.as_str() == "growth-anchor"
    assert_eq(stable, true, "interner growth preserves existing symbol identities")
}
