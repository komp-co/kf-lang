import alloc.list.*

import kf_core.span.Span
import kf_core.ast.types.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.ast.statement.SwitchArm
import kf_core.ast.types.Type
import kf_core.intern.*
import kf_core.ast.pattern.*
import kf_core.ast.expression.view

/// A deep copy: the rebuilt arm and the original both drop their pattern.
pub fun fresh_pattern_box(pp: Ptr<Pattern>): Ptr<Pattern> {
    val np: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *np = (*pp).clone() }
    return np
}

/// Each rebuilt arm gets its own pattern, since both arms are dropped.
fun subst_arm_list(arms: &List<Arm>, subst: &Substitution): List<Arm> {
    var narms = []
    while a in &arms {
        val ng = clone_expr_ptr_opt(a.guard.view(), subst)
        val nbody = subst_stmt_list(a.body, subst)
        narms.push(a.rebuilt(fresh_pattern_box(a.pattern), ng, nbody))
    }
    return narms
}

pub fun subst_stmt_list(stmts: &List<Stmt>, subst: &Substitution): List<Stmt> {
    var out = []
    while stmt in &stmts {
        out.push(stmt.subst_stmt(subst))
    }
    return out
}

/// Carries the binder span across, since the rebuilds below go through
/// `new_stmt`, which has none.
fun Stmt.subst_stmt(subst: &Substitution): Stmt {
    val binder = self.binder
    var out = self.subst_stmt_kinded(subst)
    out.binder = binder
    return out
}

fun Stmt.subst_stmt_kinded(subst: &Substitution): Stmt {
    when (self.kind) {
        LetVal(nm, ty_ptr, init_ptr) => {
            val nty = clone_tref_ptr_opt(ty_ptr.view(), subst)
            // A null init is `var x: T` with no value.
            val ninit = clone_expr_ptr_opt(init_ptr.view(), subst)
            return Stmt.new(self.span, StmtKind.LetVal(nm, nty, ninit))
        }
        LetVar(nm, ty_ptr, init_ptr) => {
            val nty = clone_tref_ptr_opt(ty_ptr.view(), subst)
            // A null init is `var x: T` with no value.
            val ninit = clone_expr_ptr_opt(init_ptr.view(), subst)
            return Stmt.new(self.span, StmtKind.LetVar(nm, nty, ninit))
        }
        Assign(nm, expr_ptr) => {
            val ne = clone_expr_ptr(expr_ptr, subst)
            return Stmt.new(self.span, StmtKind.Assign(nm, ne))
        }
        AssignTo(place_ptr, expr_ptr) => {
            val np = clone_expr_ptr(place_ptr, subst)
            val ne = clone_expr_ptr(expr_ptr, subst)
            return Stmt.new(self.span, StmtKind.AssignTo(np, ne))
        }
        Return(expr_ptr) => {
            val ne = clone_expr_box_opt(expr_ptr.view(), subst)
            return Stmt.new(self.span, StmtKind.Return(ne))
        }
        If(cond_ptr, then_body, else_body) => {
            val nc = clone_expr_ptr(cond_ptr, subst)
            val nt = subst_stmt_list(then_body, subst)
            val nel = subst_stmt_list(else_body, subst)
            return Stmt.new(self.span, StmtKind.If(nc, nt, nel))
        }
        While(cond_ptr, body) => {
            val nc = clone_expr_ptr(cond_ptr, subst)
            val nb = subst_stmt_list(body, subst)
            return Stmt.new(self.span, StmtKind.While(nc, nb))
        }
        ForEach(binder, subj_ptr, body) => {
            val ns = clone_expr_ptr(subj_ptr, subst)
            val nb = subst_stmt_list(body, subst)
            return Stmt.new(self.span, StmtKind.ForEach(binder, ns, nb))
        }
        When(subj_ptr, arms) => {
            val ns = clone_expr_ptr(subj_ptr, subst)
            return Stmt.new(self.span, StmtKind.When(ns, subst_arm_list(&arms, subst)))
        }
        Expression(expr_ptr) => {
            val ne = clone_expr_ptr(expr_ptr, subst)
            return Stmt.new(self.span, StmtKind.Expression(ne))
        }
        Switch(subj_ptr, sarms) => {
            val ns = clone_expr_ptr(subj_ptr, subst)
            var narms = []
            while sa in &sarms {
                val nbody = subst_stmt_list(sa.body, subst)
                val nguard = clone_expr_ptr_opt(sa.guard.view(), subst)
                val nprelude = subst_stmt_list(sa.guard_prelude, subst)
                var narm = SwitchArm.new_guarded(sa.span, sa.tag, sa.binders.clone(), nguard, nprelude, nbody)
                narm.ref_binders = sa.ref_binders.clone()
                narms.push(narm)
            }
            return Stmt.new(self.span, StmtKind.Switch(ns, narms))
        }
        Drop(nm) => return Stmt.new(self.span, StmtKind.Drop(nm))
        Release(nm) => return Stmt.new(self.span, StmtKind.Release(nm))
        Break => return Stmt.new(self.span, StmtKind.Break)
        Continue => return Stmt.new(self.span, StmtKind.Continue)
        Poison => return Stmt.new_poison(self.span)
    }
}

internal fun Type.subst_type(subst: &Substitution): Type {
    when (self.kind) {
        Generic(n) => {
            val r = lookup_repl_type(n.as_string(), subst)
            if r.found { return r.ty }
            return unsafe { *self }
        }
        Struct(n) => return subst_named_type(n.as_string(), self, subst, true)
        EnumTy(n) => return subst_named_type(n.as_string(), self, subst, false)
        DynTraitTy(object) => {
            var args = []
            val source_args = unsafe { object.args }
            var i = 0
            while i < unsafe { source_args.size() } {
                args.push(subst_type(unsafe { source_args.at(i) }, subst))
                i = i + 1
            }
            val rebuilt = Type.new_dyn_trait(unsafe { object.principal }, args, Span.none())
            return Type { kind: rebuilt.kind, provenance: self.provenance }
        }
        PtrTo(p) => {
            val inner = subst_type(unsafe { &*p }, subst)
            val np = type_node(inner)
            return Type { kind: TypeKind.PtrTo(np), provenance: self.provenance }
        }
        BoxOf(p) => {
            val inner = subst_type(unsafe { &*p }, subst)
            val np = type_node(inner)
            return Type { kind: TypeKind.BoxOf(np), provenance: self.provenance }
        }
        RefTo(m, p) => {
            val inner = subst_type(unsafe { &*p }, subst)
            val np = type_node(inner)
            return Type { kind: TypeKind.RefTo(m, np), provenance: self.provenance }
        }
        FnTy(_) => {
            val parts = self.fn_parts() ?: return Type.new_poison()
            var params = []
            while param in &parts.params {
                params.push(param.subst_type(subst))
            }
            return Type.new_fn(params, parts.ret.subst_type(subst), self.provenance)
        }
        // Only the owner is substituted; the impl chooses the member.
        Projection(owner, member) => {
            val inner = subst_type(unsafe { &*owner }, subst)
            val np = type_node(inner)
            return Type { kind: TypeKind.Projection(np, member), provenance: self.provenance }
        }
        _ => return unsafe { *self }
    }
}

// Exactly a parameter: the concrete type. Otherwise its `__` segments are
// rewritten.
fun subst_named_type(n: String, orig: &Type, subst: &Substitution, is_struct: bool): Type {
    val r = lookup_repl_type(n, subst)
    if r.found { return r.ty }
    val nn = subst_mangled_name(n, subst)
    if is_struct {
        return Type { kind: TypeKind.Struct(intern(nn)), provenance: orig.provenance }
    }
    return Type { kind: TypeKind.EnumTy(intern(nn)), provenance: orig.provenance }
}

struct ReplLookup { pub val found: bool pub val ty: Type }

fun lookup_repl_type(n: String, subst: &Substitution): ReplLookup {
    while i in 0..subst.names.size() {
        if subst.names.at(i).as_str() == n.as_str() {
            if i < subst.replacements.size() {
                return ReplLookup { found: true, ty: tref_to_type_shallow(subst.replacements.at(i)) }
            }
        }
    }
    return ReplLookup { found: false, ty: Type.new_poison() }
}

// Sufficient because Mono's replacement type arguments are already concrete.
fun TypeRef.tref_to_type_shallow(): Type {
    when (self.kind) {
        Named(n, args) => {
            val s = n.as_str()
            // A `Box` or `Ptr` stays one, so the instance's code sees a pointer.
            if args.size() == 1 && s == "Box" { return Type.new_box(args.at(0).tref_to_type_shallow(), Span.none()) }
            if args.size() == 1 && s == "Ptr" { return Type.new_ptr(args.at(0).tref_to_type_shallow(), Span.none()) }
            return when s {
                "int8" => Type { kind: TypeKind.Int8, provenance: Provenance.Inferred(Span.none()) }
                "int16" => Type { kind: TypeKind.Int16, provenance: Provenance.Inferred(Span.none()) }
                "int32" => Type { kind: TypeKind.Int32, provenance: Provenance.Inferred(Span.none()) }
                "int64" => Type { kind: TypeKind.Int64, provenance: Provenance.Inferred(Span.none()) }
                "uint8" => Type { kind: TypeKind.UInt8, provenance: Provenance.Inferred(Span.none()) }
                "uint16" => Type { kind: TypeKind.UInt16, provenance: Provenance.Inferred(Span.none()) }
                "uint32" => Type { kind: TypeKind.UInt32, provenance: Provenance.Inferred(Span.none()) }
                "uint64" => Type { kind: TypeKind.UInt64, provenance: Provenance.Inferred(Span.none()) }
                "float32" => Type { kind: TypeKind.Float32, provenance: Provenance.Inferred(Span.none()) }
                "float64" => Type { kind: TypeKind.Float64, provenance: Provenance.Inferred(Span.none()) }
                "bool" => Type { kind: TypeKind.Bool, provenance: Provenance.Inferred(Span.none()) }
                "char" => Type { kind: TypeKind.Char, provenance: Provenance.Inferred(Span.none()) }
                "str" => Type { kind: TypeKind.StrTy, provenance: Provenance.Inferred(Span.none()) }
                _ => Type { kind: TypeKind.Struct(intern(self.mangle_tyref().as_str())), provenance: Provenance.Inferred(Span.none()) }
            }
        }
        Reference(is_mut, inner) => {
            val it = tref_to_type_shallow(unsafe { &*inner })
            val np = type_node(it)
            return Type { kind: TypeKind.RefTo(is_mut, np), provenance: Provenance.Inferred(Span.none()) }
        }
        Function(params, ret) => {
            var values = []
            while param in &params {
                values.push(param.tref_to_type_shallow())
            }
            val result = tref_to_type_shallow(&*ret)
            return Type.new_fn(values, result, Provenance.Inferred(Span.none()))
        }
        Value(v) => return Type { kind: TypeKind.Value(v), provenance: Provenance.Inferred(Span.none()) }
        _ => return Type.new_poison()
    }
}

pub fun subst_dyn_layouts(source: &List<DynTraitLayout>, subst: &Substitution): List<DynTraitLayout> {
    var result = []
    while layout in &source {
        var args = []
        while arg in &layout.args {
            args.push(arg.subst_type(subst))
        }
        var methods = []
        while method in &layout.methods {
            var params = []
            while pi in 0..method.params.size() {
                params.push(subst_type(method.params.at(pi), subst))
            }
            methods.push(DynMethodSlot {
                name: method.name, params: params, ret: method.ret.subst_type(subst),
                is_mutating: method.is_mutating, slot: method.slot
            })
        }
        val identity = subst_mangled_name(layout.identity.as_str(), subst)
        result.push(DynTraitLayout {
            identity: intern(identity), principal: layout.principal, args: args,
            methods: methods, owner: layout.owner, imported: layout.imported
        })
    }
    return result
}

pub fun subst_dyn_vtables(source: &List<DynVTableInstance>, subst: &Substitution): List<DynVTableInstance> {
    var result = []
    while table in &source {
        var adapters = []
        while item in &table.adapters {
            val adapter = subst_static_callee(item.as_str(), subst)
            adapters.push(intern(adapter))
        }
        val layout = subst_mangled_name(table.layout.as_str(), subst)
        val receiver_identity = subst_mangled_name(table.receiver_identity.as_str(), subst)
        val symbol = subst_mangled_name(table.symbol.as_str(), subst)
        result.push(DynVTableInstance {
            layout: intern(layout.as_str()), receiver: table.receiver.subst_type(subst),
            receiver_identity: intern(receiver_identity.as_str()), symbol: intern(symbol.as_str()), adapters: adapters,
            owner: table.owner, linkage: table.linkage
        })
    }
    return result
}
