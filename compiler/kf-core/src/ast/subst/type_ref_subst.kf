import alloc.list.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.types.identity_display_of
import kf_core.names.*

// Generic substitution and monomorphized-name mangling over TypeRef.
// CONSTRAINT: in kf-core because kf-typecheck, upstream of kf-mono,
// instantiates layouts on demand too. Mangling matches mangle.kf's `__`
// convention.

/// `List<int32>` is "List__int32", `Pair<int32,str>` is "Pair__int32__str".
pub fun TypeRef.mangle_tyref(): MangledName {
    return MangledName.from(self.tyref_text())
}

fun TypeRef.tyref_text(): String {
    when (self.kind) {
        Named(n, args) => {
            // A ref written back from a checked type names it by identity
            // (`crate::module::Name`); it is spelled as `Type.mangle_frag`
            // spells that type, or one instance gets two names.
            var result = identity_display_of(n.as_str())
            while item in &args {
                result.append("__")
                val arg = item.tyref_text()
                result.append(arg)
            }
            return result
        }
        DynTrait(n, args) => {
            var result = "Dyn__"
            result.append(n.as_str())
            while item in &args {
                result.append("__")
                val arg = item.tyref_text()
                result.append(arg)
            }
            return result
        }
        Reference(is_mut, inner) => {
            // `&dyn Trait` is a fat value already named `Dyn__Trait`; it is
            // not wrapped as a pointer.
            val pointee_ref = unsafe { *inner }
            when (pointee_ref.kind) {
                DynTrait(_p, _a) => return tyref_text(unsafe { &*inner })
                _ => {}
            }
            // `&T` is not `T`: `List<&A>` and `List<A>` need different names.
            val pointee = tyref_text(unsafe { &*inner })
            return Frag.borrow(is_mut, pointee.as_str())
        }
        Function(params, ret) => {
            var frags = []
            while param in &params {
                frags.push(tyref_text(param))
            }
            return Frag.function(&frags, tyref_text(&*ret).as_str())
        }
        Array(elem, _n) => {
            var result = "Array__"
            val item = tyref_text(unsafe { &*elem })
            result.append(item)
            return result
        }
        // Named by owner and member so substitution can rewrite the owner.
        Projection(owner, member) => {
            val inner = tyref_text(unsafe { &*owner })
            return Frag.projection(inner.as_str(), member.as_str())
        }
        Value(v) => return Frag.value(v)
        Poison => return "poison"
    }
}

/// `Pair`, [int32, str] is "Pair__int32__str"; no args is the bare base.
pub fun monomorphized_type_name(base: String, args: &List<TypeRef>): MangledName {
    var result = base
    while item in &args {
        result.append("__")
        result.append(item.tyref_text().as_str())
    }
    return MangledName.from(result)
}

pub fun subst_tref_list(items: &List<TypeRef>, subst: &Substitution): List<TypeRef> {
    var out = []
    while item in &items {
        out.push(item.subst_type_ref(subst))
    }
    return out
}

/// `names`/`repls` are parallel: parameter name, replacement.
pub fun TypeRef.subst_type_ref(subst: &Substitution): TypeRef {
    when (self.kind) {
        Named(n, args) => {
            if args.size() == 0 {
                while i in 0..subst.names.size() {
                    val nm = *subst.names.at(i)
                    if nm.as_str() == n.as_str() {
                        return subst.replacements.at(i).clone()
                    }
                }
                return self.clone()
            }
            var new_args = []
            while arg in &args {
                new_args.push(arg.subst_type_ref(subst))
            }
            return TypeRef.new(self.span, TypeRefKind.Named(n, new_args))
        }
        DynTrait(n, args) => {
            return TypeRef.new(self.span, TypeRefKind.DynTrait(n, subst_tref_list(&args, subst)))
        }
        Reference(is_mut, inner) => {
            val sub = subst_type_ref(unsafe { &*inner }, subst)
            val q: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *q = sub }
            return TypeRef.new(self.span, TypeRefKind.Reference(is_mut, q))
        }
        Function(params, ret) => {
            val result = Box.new(subst_type_ref(&*ret, subst))
            return TypeRef.new(self.span, TypeRefKind.Function(subst_tref_list(&params, subst), result))
        }
        Array(_elem, _n) => return self.clone()
        Value(v) => return TypeRef.new(self.span, TypeRefKind.Value(v))
        // Only the owner is substituted; the impl chooses the member.
        Projection(owner, member) => {
            val osub = subst_type_ref(unsafe { &*owner }, subst)
            val oq: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
            unsafe { *oq = osub }
            return TypeRef.new(self.span, TypeRefKind.Projection(oq, member))
        }
        Poison => return TypeRef.new_poison(self.span)
    }
}
