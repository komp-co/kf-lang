import alloc.list.*
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import kf_core.intern.Sym
import kf_core.intern.intern
import kf_core.names.Frag

pub fun clone_expr_ptr(p: Ptr<Expr>, subst: &Substitution): Ptr<Expr> {
    val np: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *np = subst_expr(&*p, subst) }
    return np
}

/// An absent operand (a bare `return`) stays absent.
fun clone_expr_box_opt(p: Ptr<Expr>?, subst: &Substitution): Box<Expr>? {
    return when (p) {
        Some(inner) => clone_expr_ptr(inner, subst)
        None => null
    }
}

/// An absent guard stays absent.
pub fun clone_expr_ptr_opt(p_opt: Ptr<Expr>?, subst: &Substitution): Box<Expr>? {
    val p = p_opt ?: return null
    return clone_expr_ptr(p, subst)
}

fun clone_tref_ptr(p: Ptr<TypeRef>, subst: &Substitution): Ptr<TypeRef> {
    val np: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *np = subst_type_ref(&*p, subst) }
    return np
}

fun clone_tref_ptr_opt(popt: Ptr<TypeRef>?, subst: &Substitution): Box<TypeRef>? {
    val p = popt ?: return null
    val np: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *np = subst_type_ref(&*p, subst) }
    return np
}

fun Expr.rebuild_expr(new_kind: ExprKind, subst: &Substitution): Expr {
    return Expr {
        span: self.span,
        name_span: self.name_span,
        kind: new_kind,
        decl: self.decl,
        ty: self.ty.subst_type(subst),
        mangled_callee: self.mangled_callee,
        coerce: self.coerce,
        type_args: subst_tref_list(self.type_args, subst),
        type_args_written: self.type_args_written,
        is_static_call: self.is_static_call,
        is_dynamic_call: self.is_dynamic_call,
        dynamic_slot: self.dynamic_slot,
        dynamic_layout: intern(subst_mangled_name(self.dynamic_layout.as_str(), subst).as_str()),
        is_safe_call_value: self.is_safe_call_value,
        is_variant_ctor: self.is_variant_ctor,
        derefs_at_call: self.derefs_at_call,
        constant: self.constant,
        arg_name: self.arg_name,
        needless_view: self.needless_view,
        scope_module: self.scope_module,
        scope_file: self.scope_file
    }
}

pub fun Expr.subst_expr(subst: &Substitution): Expr {
    when (self.kind) {
        LitInt(v) => return self.rebuild_expr(ExprKind.LitInt(v), subst)
        LitStr(sv) => return self.rebuild_expr(ExprKind.LitStr(sv.clone()), subst)
        LitFloat(fv) => return self.rebuild_expr(ExprKind.LitFloat(fv.clone()), subst)
        LitChar(cv) => return self.rebuild_expr(ExprKind.LitChar(cv), subst)
        LitBool(b) => return self.rebuild_expr(ExprKind.LitBool(b), subst)
        Variable(nm) => {
            // A value parameter is its argument.
            val value = value_argument(nm, subst)
            if value != null { return self.rebuild_expr(ExprKind.LitInt(value ?: 0), subst) }
            return self.rebuild_expr(ExprKind.Variable(nm), subst)
        }
        Binary(lp, op, rp) => {
            val nl = clone_expr_ptr(lp, subst)
            val nr = clone_expr_ptr(rp, subst)
            return self.rebuild_expr(ExprKind.Binary(nl, op, nr), subst)
        }
        Unary(op, ip) => return self.rebuild_expr(ExprKind.Unary(op, clone_expr_ptr(ip, subst)), subst)
        Deref(ip) => return self.rebuild_expr(ExprKind.Deref(clone_expr_ptr(ip, subst)), subst)
        Call(nm, args) => {
            val nnm = subst_mangled_name(nm.as_str(), subst)
            val nargs = subst_expr_list(args, subst)
            var call = self.rebuild_expr(ExprKind.Call(intern(nnm.as_str()), nargs), subst)
            call.mangled_callee = intern(subst_mangled_name(self.mangled_callee.as_str(), subst).as_str())
            return call
        }
        Intrinsic(intrinsic, args) => {
            return self.rebuild_expr(ExprKind.Intrinsic(intrinsic, subst_expr_list(args, subst)), subst)
        }
        MethodCall(recv_ptr, m, args) => {
            val nr = clone_expr_ptr(recv_ptr, subst)
            var nargs = subst_expr_list(args, subst)
            // CONSTRAINT: only here are receiver and argument still both
            // spelled with the same type parameter. When it stands for a
            // borrow, the auto-dereferenced receiver's by-value `Self`
            // arguments must follow it.
            mark_self_shaped_args(unsafe { &(*recv_ptr).ty }, args, &var nargs, subst)
            var mc = self.rebuild_expr(ExprKind.MethodCall(nr, m, nargs), subst)
            // `T.method(...)` carries the placeholder callee `T_method`;
            // substituting `T` gives the real static.
            if self.is_static_call || self.mangled_callee.as_str() != "" {
                mc.mangled_callee = intern(subst_static_callee(self.mangled_callee.as_str(), subst).as_str())
            }
            return mc
        }
        FnRef(nm) => return self.rebuild_expr(ExprKind.FnRef(nm), subst)
        CallValue(callee_ptr, args) => {
            val callee = clone_expr_ptr(callee_ptr, subst)
            return self.rebuild_expr(ExprKind.CallValue(callee, subst_expr_list(args, subst)), subst)
        }
        FieldAccess(obj_ptr, f) => {
            val no = clone_expr_ptr(obj_ptr, subst)
            return self.rebuild_expr(ExprKind.FieldAccess(no, f), subst)
        }
        IfExpr(c_ptr, t_ptr, e_ptr) => {
            val nc = clone_expr_ptr(c_ptr, subst)
            val nt = clone_expr_ptr(t_ptr, subst)
            val nel = clone_expr_ptr(e_ptr, subst)
            return self.rebuild_expr(ExprKind.IfExpr(nc, nt, nel), subst)
        }
        WhenExpr(subj_ptr, arms) => {
            val ns = clone_expr_ptr(subj_ptr, subst)
            return self.rebuild_expr(ExprKind.WhenExpr(ns, subst_arm_list(&arms, subst)), subst)
        }
        StructLit(nm, finits) => {
            var nfi = []
            while fi in &finits {
                val nv = clone_expr_ptr(fi.value, subst)
                nfi.push(FieldInit.new(fi.span, fi.name.as_string(), nv))
            }
            return self.rebuild_expr(ExprKind.StructLit(nm, nfi), subst)
        }
        Cast(ip, tref_ptr) => {
            val ni = clone_expr_ptr(ip, subst)
            val ntref = clone_tref_ptr(tref_ptr, subst)
            return self.rebuild_expr(ExprKind.Cast(ni, ntref), subst)
        }
        DynCoerce(ip, vtable) => {
            val ni = clone_expr_ptr(ip, subst)
            val concrete_vtable = subst_mangled_name(vtable.as_str(), subst)
            return self.rebuild_expr(ExprKind.DynCoerce(ni, intern(concrete_vtable.as_str())), subst)
        }
        Retain(ip) => {
            val ni = clone_expr_ptr(ip, subst)
            return self.rebuild_expr(ExprKind.Retain(ni), subst)
        }
        Release(nm) => return self.rebuild_expr(ExprKind.Release(nm), subst)
        Lambda(ps, b) => return self.rebuild_expr(ExprKind.Lambda(ps.clone(), b.clone()), subst)
        Block(stmts) => return self.rebuild_expr(ExprKind.Block(subst_stmt_list(&stmts, subst)), subst)
        Poison => return self.rebuild_expr(ExprKind.Poison, subst)
    }
}

fun value_argument(name: Sym, subst: &Substitution): int64? {
    while i in 0..subst.names.size() {
        if i < subst.replacements.size() && subst.names.at(i).as_str() == name.as_str() {
            return when (subst.replacements.at(i).kind) {
                Value(v) => v
                _ => null
            }
        }
    }
    return null
}

fun subst_expr_list(args: &List<Expr>, subst: &Substitution): List<Expr> {
    var out = []
    while arg in &args {
        out.push(arg.subst_expr(subst))
    }
    return out
}

// Rewrites the type prefix of a static callee `Type_method` when `Type` is a
// substituted parameter. A concrete prefix is returned unchanged.
pub fun subst_static_callee(callee: str, subst: &Substitution): String {
    val s = callee
    val n = s.byte_len()
    // The boundary is the first single `_`: `__` is the mangle's compound
    // delimiter, so `List__T_push` splits as `List__T` + `push`.
    var us: uint64 = n
    var i = 0
    while i < n {
        if s.byte_at(i) == '_' as uint8 {
            if i + 1 < n && s.byte_at(i + 1) == '_' as uint8 {
                i = i + 2
            } else {
                us = i
                i = n
            }
        } else {
            i = i + 1
        }
    }
    if us == n { return String.from(callee) }
    val prefix = s.substring(0, us)
    val method = s.substring(us + 1, n)
    // The owner prefix and the method tail (which may carry trait arguments)
    // are both rewritten. A bare parameter standing for a borrow contributes
    // its pointee in owner position: impls are registered on `int32`, not
    // `&int32`. Only a bare one; `List__T_push` genuinely is
    // `List__kf__ref__Square`.
    var result = ""
    if subst.binds(prefix) {
        var through = subst.through_borrows()
        result = subst_mangled_name(prefix, &through).display()
    } else {
        result = subst_mangled_name(prefix, subst).display()
    }
    result.append("_")
    val suffix = subst_mangled_name(method, subst)
    result.append(suffix.as_str())
    return result
}

/// See `Expr.derefs_at_call`. Both sides are read before substitution: the
/// receiver must be the bare parameter `P` and the argument spelled `P` too.
fun Type.mark_self_shaped_args(args: &List<Expr>, out: &var List<Expr>, subst: &Substitution): void {
    val pname = self.generic_param_name()
    if pname.as_str() == "" { return }
    if !replacement_is_a_borrow(pname, subst) { return }
    while i in 0..args.size() {
        if i < out.size() {
            val arg_param = generic_param_name(&args.at(i).ty)
            if arg_param.as_str() == pname.as_str() {
                unsafe { out.at_mut(i).derefs_at_call = true }
            }
        }
    }
}

fun Type.generic_param_name(): String {
    return when (self.kind) {
        Generic(n) => n.as_string()
        _ => ""
    }
}

fun replacement_is_a_borrow(pname: str, subst: &Substitution): bool {
    while i in 0..subst.names.size() {
        if subst.names.at(i).as_str() == pname {
            if i < subst.replacements.size() {
                return when (subst.replacements.at(i).kind) {
                    Reference(_m, _inner) => true
                    _ => false
                }
            }
        }
    }
    return false
}

pub fun subst_mangled_name(name: str, subst: &Substitution): MangledName {
    val segments = Frag.segments(name)
    // Only a segment naming a parameter changes; the common case has none.
    if !subst.binds_one_of(&segments) { return MangledName.from(String.from(name)) }
    var out = ""
    while i in 0..segments.size() {
        if i > 0 { out.append("__") }
        val segment = segments.at(i).as_str()
        // A compound can already hold a complete replacement
        // (`List__kf_core__Stmt`); its final segment must not be expanded again.
        if subst.spells_end_of("${out}${segment}") {
            out.append(segment)
        } else {
            out.append(subst.spelling_of(segment).as_str())
        }
    }
    return MangledName.from(out)
}
