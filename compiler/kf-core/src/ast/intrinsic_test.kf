import core.assert.assert_eq

@test
fun a_folded_callee_names_its_intrinsic(): void {
    assert_eq(intrinsic_of_callee("alloc_array__int32")?.name() ?: "", "alloc_array", "the base before `__`")
}

@test
fun a_name_without_type_arguments_is_no_folded_callee(): void {
    assert_eq(intrinsic_of_callee("alloc").is_none(), true, "nothing was folded in")
}

@test
fun a_plain_function_is_no_intrinsic(): void {
    assert_eq(intrinsic_named("helper").is_none(), true, "not in the table")
}

@test
fun the_type_fragment_follows_the_name(): void {
    val fragment = Intrinsic.ReallocArray.type_fragment("realloc_array__List__int32")
    assert_eq(fragment.as_str(), "List__int32", "everything after `realloc_array__`")
}

@test
fun a_crate_qualified_fragment_is_kept_whole(): void {
    assert_eq(Intrinsic.Alloc.type_fragment("alloc__aa__Point").as_str(), "aa__Point", "the crate stays on the type")
}

@test
fun realloc_array_takes_two_arguments(): void {
    assert_eq(Intrinsic.ReallocArray.arity(), 2, "the pointer and the count")
}

@test
fun every_name_round_trips(): void {
    var all_found = true
    val names = ["alloc", "alloc_array", "realloc_array", "dealloc", "sizeof", "take", "drop_in_place",
        "clone_place", "ptr_read", "annotated"]
    while name in &names {
        val found = intrinsic_named(name)?.name() ?: ""
        if found != name { all_found = false }
    }
    assert_eq(all_found, true, "the name a kind gives is the name that finds it")
}

@test
fun sizeof_takes_no_arguments(): void {
    assert_eq(Intrinsic.Sizeof.arity(), 0, "the type is all it needs")
}

@test
fun annotated_leaves_its_arguments_to_the_checker(): void {
    assert_eq(Intrinsic.Annotated.arity(), -1, "checked where it is expanded")
}
