import core.assert.assert_eq

import kf_core.span.Span
import kf_core.ast.types.Type
import testing.test
import kf_core.intern.intern
import kf_core.intern.CrateId

fun metadata_test_slot(name: str, slot: uint64): DynMethodSlot {
    return DynMethodSlot {
        name: intern(name),
        params: [],
        ret: Type.new_void(Span.none()),
        is_mutating: false,
        slot: slot
    }
}

@test fun dyn_metadata_clone_owns_its_method_list(): void {
    var methods = []
    methods.push(metadata_test_slot("show", 0))
    val original = DynTraitLayout {
        identity: intern("sample::Display"),
        principal: intern("sample::Display"),
        args: [],
        methods: methods,
        owner: CrateId.new("sample"),
        imported: false
    }
    var copied = original.clone()
    copied.methods.push(metadata_test_slot("debug", 1))
    assert_eq(original.methods.size(), 1, "cloning dynamic metadata does not alias its method list")
}
