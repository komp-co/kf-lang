import kf_core.ast.declaration.Linkage
import kf_core.ast.types.Type
import kf_core.intern.CrateId
import kf_core.intern.Sym

@derive(Clone)
pub struct DynMethodSlot {
    pub val name: Sym
    pub val params: List<Type>
    pub val ret: Type
    pub val is_mutating: bool
    pub val slot: uint64
}

@derive(Clone)
pub struct DynTraitLayout {
    pub val identity: Sym
    pub val principal: Sym
    pub val args: List<Type>
    pub var methods: List<DynMethodSlot>
    pub val owner: CrateId
    pub val imported: bool
}

@derive(Clone)
pub struct DynVTableInstance {
    pub val layout: Sym
    pub val receiver: Type
    pub val receiver_identity: Sym
    pub val symbol: Sym
    pub val adapters: List<Sym>
    pub val owner: CrateId
    pub val linkage: Linkage
}
