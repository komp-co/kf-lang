import kf_core.span.*
import kf_core.ast.types.*
import kf_core.intern.Sym
import kf_core.intern.intern

impl Type {
    pub static fun new_dyn_trait(principal: Sym, args: List<Type>, span: Span): Type {
        val args_ptr = type_list_node(args)
        val object_ptr = dyn_trait_node(DynTraitType { principal: principal, args: args_ptr })
        return Type { kind: TypeKind.DynTraitTy(object_ptr), provenance: Provenance.Declared(span) }
    }

    pub fun dyn_trait_name(): Sym {
        return when (self.kind) {
            DynTraitTy(object) => unsafe { object.principal }
            _ => intern("")
        }
    }

    pub fun dyn_trait_args(): Ptr<List<Type>> {
        return when (self.kind) {
            DynTraitTy(object) => unsafe { object.args }
            _ => unsafe { 0 as Ptr<List<Type>> }
        }
    }

    pub fun dyn_trait_identity(): Sym {
        var result = self.dyn_trait_name().as_string()
        val args = self.dyn_trait_args()
        if unsafe { args as uint64 } == 0 { return intern(result) }
        var i = 0
        while i < unsafe { args.size() } {
            result.append("__")
            val argument = unsafe { args.get(i) }
            val fragment = argument.dyn_type_mangle()
            result.append(fragment)
            i = i + 1
        }
        return intern(result)
    }

    fun dyn_wrapper_name(): Sym {
        return dyn_prefixed_name("Dyn__", self)
    }
}

fun dyn_prefixed_name(prefix: str, ty: &Type): Sym {
    var result = String.from(prefix)
    result.append(ty.dyn_trait_identity().as_str())
    return intern(result)
}

impl Type {
    // Unlike the shared fragment, a projection is not mangled: a vtable keyed on
    // an unpinned member would name a layout that does not exist.
    fun dyn_type_mangle(): String {
        return when (self.kind) {
            Projection(_, _) => "poison"
            _ => self.mangle_frag().display()
        }
    }
}

/// The method name plus the `__<Trait>` suffix (empty for `Clone`, `Drop`,
/// `Equal`). CONSTRAINT: in kf-core because typecheck records the symbol a
/// dynamic adapter forwards to, and codegen must spell it identically.
pub fun emitted_method_tail(method_name: str, trait_suffix: str): String {
    if trait_suffix == "" { return String.from(method_name) }
    return String.from(method_name) + "__" + String.from(trait_suffix)
}
