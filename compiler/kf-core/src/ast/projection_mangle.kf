// A deferred associated-type projection inside a mangled name:
// `Proj__<owner>__<member>__EndProj`. The owner is its own `__` segment so
// substitution can rewrite it; the closing bracket is needed because
// substitution can make the owner span several segments.

import alloc.list.*

/// `F`, `Out` -> `Proj__F__Out__EndProj`.
pub fun projection_mangle_frag(owner: str, member: str): String {
    val out = "Proj__${owner}__${member}__EndProj"
    return out
}

/// Both names are reserved: a user type called `Proj` would read as one.
pub fun is_projection_open(seg: str): bool {
    return seg.equals("Proj")
}

/// Possibly with a method tail glued on by a single `_` (`...__EndProj_push`).
pub fun is_projection_close(seg: str): bool {
    if seg.equals("EndProj") { return true }
    return projection_close_tail_len(seg) > 0
}

/// What follows the `EndProj` in a closing segment (`_push`), or "".
pub fun projection_close_tail(seg: str): String {
    val n = seg.byte_len()
    val tail = projection_close_tail_len(seg)
    if tail == 0 { return "" }
    return seg.substring(n - tail, n)
}

fun projection_close_tail_len(seg: str): uint64 {
    val n = seg.byte_len()
    if n < 8 { return 0 }
    val head = seg.substring(0, 7)
    if !head.as_str().equals("EndProj") { return 0 }
    if seg.byte_at(7) != 95 { return 0 }
    return n - 7
}

/// The `EndProj` closing the `Proj` at `open`, counting nesting, or `open`
/// when there is none.
pub fun projection_close_index(segs: &List<String>, open: uint64): uint64 {
    var depth: uint64 = 0
    var i: uint64 = open
    while i < segs.size() {
        val seg = *segs.at(i)
        if is_projection_open(seg.as_str()) { depth = depth + 1 }
        if is_projection_close(seg.as_str()) {
            if depth <= 1 { return i }
            depth = depth - 1
        }
        i = i + 1
    }
    return open
}

/// A cheap filter; the segment walk decides.
pub fun name_has_projection_marker(mangled: str): bool {
    val n = mangled.byte_len()
    if n < 4 { return false }
    var i: uint64 = 0
    while i + 3 < n {
        if mangled.byte_at(i) == 80 {
            if mangled.byte_at(i + 1) == 114 {
                if mangled.byte_at(i + 2) == 111 {
                    if mangled.byte_at(i + 3) == 106 { return true }
                }
            }
        }
        i = i + 1
    }
    return false
}

/// Split on `__`; a single `_` stays inside its segment.
pub fun mangle_segments(mangled: str): List<String> {
    var out = List.new<String>()
    val n = mangled.byte_len()
    var seg_start: uint64 = 0
    var i: uint64 = 0
    while i + 1 < n {
        var matched = false
        if mangled.byte_at(i) == 95 {
            if mangled.byte_at(i + 1) == 95 { matched = true }
        }
        if matched {
            out.push(mangled.substring(seg_start, i))
            i = i + 2
            seg_start = i
        } else {
            i = i + 1
        }
    }
    out.push(mangled.substring(seg_start, n))
    return out
}

/// `Owner.Member` in place of the brackets, for diagnostics.
pub fun projection_mangle_display(mangled: str): String {
    if !name_has_projection_marker(mangled) { return String.from(mangled) }
    val segs = mangle_segments(mangled)
    var out = ""
    var emitted = false
    var i = 0
    while i < segs.size() {
        var seg = *segs.at(i)
        var step = 1
        if is_projection_open(seg.as_str()) {
            val close = projection_close_index(&segs, i)
            if close > i + 2 {
                var text = ""
                var j = i + 1
                while j < close - 1 {
                    if j > i + 1 { text.append("__") }
                    text.append(segs.at(j).as_str())
                    j = j + 1
                }
                text.append(".")
                text.append(segs.at(close - 1).as_str())
                text.append(projection_close_tail(segs.at(close).as_str()).as_str())
                seg = text
                step = close + 1 - i
            }
        }
        if emitted { out.append("__") }
        out.append(seg.as_str())
        emitted = true
        i = i + step
    }
    return out
}
