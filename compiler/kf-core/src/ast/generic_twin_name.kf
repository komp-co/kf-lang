// The name a generic call carries when another crate declares a generic of
// the same name: `kf__c<crate>__<name>`, so each crate's instances get their
// own C symbols.

pub fun crate_qualified_generic(crate: CrateId, name: str): String {
    return "kf__c${crate.raw as int64}__${name}"
}

/// The crate a qualified name was minted for, or -1 for an ordinary name.
pub fun qualified_generic_crate(base: str): int64 {
    if !base.starts_with("kf__c") { return -1 }
    val n = base.byte_len()
    var at: uint64 = 5
    var raw: int64 = 0
    while at < n && base.byte_at(at) >= 48 && base.byte_at(at) <= 57 {
        raw = raw * 10 + (base.byte_at(at) - 48) as int64
        at = at + 1
    }
    if at == 5 || !base.substring(at, at + 2).as_str().equals("__") { return -1 }
    return raw
}

/// The declared name inside a qualified one; the name itself otherwise.
pub fun qualified_generic_name(base: str): String {
    if qualified_generic_crate(base) < 0 { return String.from(base) }
    val tail = base.substring(5, base.byte_len())
    val cut = tail.as_str().index_of("__") ?: return String.from(base)
    return tail.as_str().substring(cut + 2, tail.byte_len())
}
