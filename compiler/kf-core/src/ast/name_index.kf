// Positions in an append-only list, by name: each name's in the order they
// were added, so a lookup reads only the entries that can match.

import alloc.list.*
import alloc.hash_map.*

pub struct NameIndex {
    /// Each name's list in `lists`.
    var slots: HashMap<String, uint64>
    var lists: List<List<uint64>>
}

impl NameIndex {
    pub static fun new(): NameIndex {
        return NameIndex { slots: HashMap.new<String, uint64>(), lists: [] }
    }

    pub mutating fun add(name: String, at: uint64): void {
        when (self.slots.get(&name)) {
            Some(slot) => self.lists[*slot].push(at)
            None => {
                self.slots.insert(name, self.lists.size())
                self.lists.push([at])
            }
        }
    }

    pub fun has(name: str): bool {
        return self.slots.contains(&String.from_literal(name))
    }

    /// The positions added under `name`, in order.
    pub fun positions(name: str): List<uint64> {
        return when (self.slots.get(&String.from_literal(name))) {
            Some(slot) => self.lists.at(*slot).clone()
            None => []
        }
    }

    /// The first position added under `name`; None when nothing was.
    pub fun first(name: str): uint64? {
        return when (self.slots.get(&String.from_literal(name))) {
            Some(slot) => Option.Some(self.lists.at(*slot).get(0))
            None => Option.None
        }
    }
}

impl Module {
    /// Each declaration's position in `decls` by its name; an impl block is
    /// filed under its type's name, beside the type.
    pub fun decl_index(): NameIndex {
        var index = NameIndex.new()
        while i in 0..self.decls.size() {
            index.add(self.decls.at(i).name.as_string(), i)
        }
        return index
    }
}
