import core.assert.assert_eq

@test fun a_qualified_generic_names_its_crate(): void {
    assert_eq(crate_qualified_generic(CrateId { raw: 3 }, "max").as_str(), "kf__c3__max", "spelled")
}

@test fun a_qualified_generic_reads_back_its_crate(): void {
    assert_eq(qualified_generic_crate("kf__c12__take_if_ext_T"), 12 as int64, "crate")
}

@test fun a_qualified_generic_reads_back_its_name(): void {
    assert_eq(qualified_generic_name("kf__c12__take_if_ext_T").as_str(), "take_if_ext_T", "name")
}

@test fun an_ordinary_name_has_no_crate(): void {
    assert_eq(qualified_generic_crate("max"), -1 as int64, "not qualified")
}
