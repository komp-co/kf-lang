/// Interned crate identity. Zero means not yet stamped by Assemble.
@derive(Copy)
pub struct CrateId {
    pub val raw: uint32
}

pub fun crate_id_poison(): CrateId {
    return CrateId { raw: 0 }
}

pub fun new_crate_id(name: str): CrateId {
    return CrateId { raw: intern(name).id }
}

impl CrateId {
    pub fun is_poison(): bool {
        return self.raw == 0
    }
}

impl Equal for CrateId {
    fun equals(other: &CrateId): bool {
        return self.raw == other.raw
    }
}
