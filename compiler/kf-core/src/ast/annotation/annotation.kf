// An annotation as written above a declaration, and reading and writing its
// arguments.

import alloc.list.*

import kf_core.span.Span
import kf_core.intern.intern
import kf_core.ast.expression.array_literal_callee
import kf_core.ast.expression.empty_list_literal_receiver
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.span.*
import kf_core.ast.annotation.*
import kf_core.ast.expression.*
import kf_core.intern.*

/// One argument of `@name(...)`: `Clone`, `"string"`, `iterations = 100`.
@derive(Clone)
pub struct AnnotationArg {
    /// Empty for a positional argument.
    pub val name: Sym
    pub val value: Box<Expr>
}

/// `@name` or `@name(args)` above a declaration.
@derive(Clone)
pub struct Annotation {
    pub val name: Sym
    pub var args: List<AnnotationArg>
    /// `@name()` as against `@name`.
    pub val has_parens: bool
    pub val span: Span
}

impl Annotation {
    /// One the compiler writes itself, each word a bare name:
    /// `receiver_params(T, U)`.
    pub static fun new(span: Span, name: str, words: List<String>): Annotation {
        var args = []
        while word in &words {
            val value = Expr.new(span, ExprKind.Variable(intern(word)))
            args.push(AnnotationArg { name: intern(""), value: Box.new(value) })
        }
        return Annotation { name: intern(name), args: args, has_parens: words.size() > 0, span: span }
    }

    /// Each positional argument that is a bare name or a string, as text, in
    /// order: `@derive(Clone, Equal)` gives `["Clone", "Equal"]` and
    /// `@lang("string")` gives `["string"]`.
    pub fun words(): List<String> {
        var out = []
        while arg in &self.args {
            if arg.name.as_str() != "" { continue }
            when (arg.value.kind) {
                Variable(word) => out.push(word.as_string())
                LitStr(text) => out.push(text.clone())
                _ => {}
            }
        }
        return out
    }

    /// As it would be written, without the `@`: `derive(Clone, Equal)`.
    pub fun to_source(): String {
        var out = self.name.as_string()
        if !self.has_parens { return out }
        out.append("(")
        while i in 0..self.args.size() {
            val arg = self.args.at(i)
            if i > 0 { out.append(", ") }
            if arg.name.as_str() != "" { out.append("${arg.name.as_str()} = ") }
            out.append(arg.value.argument_source().as_str())
        }
        out.append(")")
        return out
    }
}

impl Expr {
    /// A name, a literal, a negation, `Enum.Variant` or a list literal of
    /// those; any other expression renders as `_`.
    pub fun argument_source(): String {
        return when (self.kind) {
            Variable(name) => name.as_string()
            LitStr(text) => "\"${escaped(text.as_str(), 34)}\""
            LitChar(c) => "'${escaped(String.of(&(c as char)).as_str(), 39)}'"
            LitInt(n) => String.of(&(n))
            LitFloat(spelling) => spelling.clone()
            LitBool(b) => if b { "true" } else { "false" }
            FieldAccess(owner, member) => "${owner.argument_source().as_str()}.${member.as_str()}"
            Unary(op, inner) => when (op) {
                Neg => "-${inner.argument_source()}"
                Not => "!${inner.argument_source()}"
            }
            Call(name, elements) => if name.as_str() == array_literal_callee() { elements.list_source() } else { "_" }
            MethodCall(receiver, _method, _args) => when (receiver.kind) {
                Variable(name) => if name.as_str() == empty_list_literal_receiver() { "[]" } else { "_" }
                _ => "_"
            }
            _ => "_"
        }
    }
}

fun List<Expr>.list_source(): String {
    var out = String.from("[")
    while i in 0..self.size() {
        if i > 0 { out.append(", ") }
        out.append(self.at(i).argument_source().as_str())
    }
    out.append("]")
    return out
}

/// `text` with `\`, the `quote` byte and a newline escaped.
fun escaped(text: str, quote: uint8): String {
    var out = ""
    while i in 0..text.byte_len() {
        val b = text.byte_at(i)
        if b == '\\' as uint8 || b == quote { out.append("\\") }
        if b == '\n' as uint8 {
            out.append("\\n")
        } else {
            out.append(text.substring(i, i + 1).as_str())
        }
    }
    return out
}
