import kf_core.span.*

// CONSTRAINT: Label shares this file so its typedef, and List<Label>'s, are
// emitted before Diagnostic's; cross-file order follows file names.

/// A span and message. The primary label points at the offending source;
/// secondary labels add context.
pub struct Label {
    pub val span: Span
    pub val message: String
}

impl Label {
    pub static fun new(span: Span, message: String): Label {
        return Label { span: span, message: message }
    }
}

/// How far a fix can be trusted. `komp check --fix` writes only `MachineApplicable`.
///
/// - `MachineApplicable`: the repair is the answer (one candidate).
/// - `MaybeIncorrect`: a guess to confirm (tied candidates).
/// - `HasPlaceholders`: contains something the author must fill in.
pub enum Applicability {
    MachineApplicable
    MaybeIncorrect
    HasPlaceholders
}

/// A repair: exactly what to replace, and with what. The span is the exact
/// extent to overwrite; `Span.none()` means no fix.
pub struct Fix {
    pub val span: Span
    pub val replacement: String
    /// The quick-fix menu entry.
    pub val title: String
    /// Whether `komp check --fix` may write it unasked; editors offer every fix.
    pub val applicability: Applicability
}

impl Fix {
    static fun none(): Fix {
        return Fix { span: Span.none(), replacement: "", title: "", applicability: Applicability.MachineApplicable }
    }

    pub fun is_machine_applicable(): bool {
        return when (self.applicability) {
            MachineApplicable => true
            _ => false
        }
    }

    pub fun has_repair(): bool {
        return !self.span.is_none()
    }
}

/// A structured diagnostic. The renderer and IDE tooling read the same data.
@derive(Clone)
pub struct Diagnostic {
    pub var severity: Severity
    pub val primary: Label
    pub var secondary: List<Label>
    /// `Fix.none()` unless a pass knows the repair.
    pub var fix: Fix
    /// The lint that produced this, or "" for an ordinary diagnostic. Errors
    /// are never optional, so they have no name.
    pub var code: String
}

/// `d` with a repair trusted enough for `komp check --fix` to write.
pub fun with_fix(d: Diagnostic, span: Span, replacement: String, title: String): Diagnostic {
    return with_fix_applic(d, span, replacement, title, Applicability.MachineApplicable)
}

/// `with_fix`, for a repair that may be a guess.
pub fun with_fix_applic(d: Diagnostic, span: Span, replacement: String, title: String, applicability: Applicability): Diagnostic {
    var out = d
    out.fix = Fix { span: span, replacement: replacement, title: title, applicability: applicability }
    return out
}

impl Diagnostic {
    pub static fun new(severity: Severity, primary: Label): Diagnostic {
        return Diagnostic {
            severity: severity,
            primary: primary,
            secondary: [],
            fix: Fix.none(),
            code: ""
        }
    }

    pub static fun error_at(span: Span, message: String): Diagnostic {
        return Diagnostic.new(Severity.Error, Label.new(span, message))
    }

    pub static fun warning_at(span: Span, message: String): Diagnostic {
        return Diagnostic.new(Severity.Warning, Label.new(span, message))
    }

    /// A lint at its registered default level.
    pub static fun lint_at(code: str, span: Span, message: String): Diagnostic {
        var d = Diagnostic.new(LintInfo.default_of(code).severity(), Label.new(span, message))
        d.code = String.from(code)
        return d
    }

    pub fun is_lint(): bool {
        return self.code.byte_len() > 0
    }
}
