// The option values a project gave its lints, over the registry's defaults.

import alloc.list.*

/// `lint.key = value` rows, later rows winning.
@derive(Clone)
pub struct LintOptions {
    var names: List<String>
    var values: List<int64>
    /// How far past its limit each file already is, for the ratchet lints.
    pub var baseline: LintBaseline
}

impl LintOptions {
    pub static fun none(): LintOptions {
        return LintOptions { names: [], values: List.new<int64>(), baseline: LintBaseline.none() }
    }

    pub mutating fun set(lint: str, key: str, value: int64): void {
        val name = "${lint}.${key}"
        while i in 0..self.names.size() {
            if self.names[i].as_str() == name.as_str() {
                self.values.set(i, value)
                return
            }
        }
        self.names.push(name)
        self.values.push(value)
    }

    /// The value set for `lint`'s option `key`, or its registered default.
    pub fun get(lint: str, key: str): int64 {
        val name = "${lint}.${key}"
        while i in 0..self.names.size() {
            if self.names[i].as_str() == name.as_str() { return self.values[i] }
        }
        return LintInfo.option_of(lint, key)?.default ?: 0
    }
}
