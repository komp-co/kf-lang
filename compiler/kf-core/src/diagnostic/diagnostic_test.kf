import core.assert.assert_eq

import kf_core.span.*
import testing.test

@test fun severity_error_distinguishable_from_warning(): void {
    val e: Severity = Severity.Error
    val w: Severity = Severity.Warning
    assert_eq(severity_is_error(e), true, "Error is Error")
    assert_eq(severity_is_error(w), false, "Warning is not Error")
}

@test fun severity_note_not_error(): void {
    assert_eq(severity_is_error(Severity.Note), false, "Note is not Error")
}

fun severity_is_error(s: Severity): bool {
    when (s) {
        Error => return true
        Warning => return false
        Note => return false
    }
}

@test fun new_label_constructs(): void {
    val sp = Span { file_id: 1, start: 10, end: 20 }
    val lbl = Label.new(sp, "type mismatch")
    assert_eq(lbl.span.start, 10, "span start round-trip")
    assert_eq(lbl.span.end, 20, "span end round-trip")
    assert_eq(lbl.message.as_str(), "type mismatch", "message round-trip")
}

@test fun error_at_builds_error_severity(): void {
    val sp = Span { file_id: 2, start: 5, end: 8 }
    val d = Diagnostic.error_at(sp, "bad")
    assert_eq(severity_is_error(d.severity), true, "error_at sets Error")
}

@test fun warning_at_builds_warning_severity(): void {
    val d = Diagnostic.warning_at(Span.none(), "hmm")
    assert_eq(severity_is_error(d.severity), false, "warning_at is not Error")
}

@test fun new_diagnostic_no_secondary(): void {
    // Passed straight in: binding `primary` first and passing it by value
    // double-frees.
    val d = Diagnostic.new(Severity.Error, Label.new(Span.none(), "oops"))
    assert_eq(d.secondary.size(), 0, "no secondary labels initially")
}

@test fun label_vec_push_increments_size(): void {
    var v = []
    v.push(Label.new(Span.none(), "a"))
    assert_eq(v.size(), 1, "after one push")
    v.push(Label.new(Span.none(), "b"))
    assert_eq(v.size(), 2, "after two pushes")
}

@test fun diagnostic_secondary_grows(): void {
    var d = Diagnostic.error_at(Span.none(), "primary")
    d.secondary.push(Label.new(Span.none(), "note 1"))
    d.secondary.push(Label.new(Span.none(), "note 2"))
    assert_eq(d.secondary.size(), 2, "two secondary labels")
}

@test fun a_diagnostic_carries_no_fix_by_default(): void {
    val d = Diagnostic.error_at(Span.none(), "something went wrong")
    assert_eq(d.fix.has_repair(), false, "most diagnostics know of no repair")
}

@test fun with_fix_attaches_the_span_and_the_replacement(): void {
    val where = Span { file_id: 1, start: 179, end: 183 }
    val d = with_fix(Diagnostic.error_at(where, "no method `sunm`"), where, "sum", "change to `sum`")
    assert_eq(d.fix.has_repair(), true, "the repair is present")
    assert_eq(d.fix.replacement.as_str(), "sum", "and says what to write")
    assert_eq(d.fix.span.start, 179 as uint32, "over exactly these bytes")
    assert_eq(d.fix.span.end, 183 as uint32, "and no others")
    assert_eq(d.fix.title.as_str(), "change to `sum`", "with a title a menu can show")
}

// A repair may be in another file, so it carries its own span.
@test fun a_fix_span_is_independent_of_the_diagnostics_own(): void {
    val reported = Span { file_id: 1, start: 10, end: 40 }
    val repair = Span { file_id: 2, start: 5, end: 8 }
    val d = with_fix(Diagnostic.error_at(reported, "m"), repair, "x", "t")
    assert_eq(d.primary.span.start, 10 as uint32, "the diagnostic still points where it did")
    assert_eq(d.fix.span.file_id, 2 as uint32, "and the repair points where IT does")
}

@test fun no_fix_is_the_absent_one(): void {
    val f = Fix.none()
    assert_eq(f.has_repair(), false, "no_fix carries no repair")
    assert_eq(f.replacement.as_str(), "", "and nothing to write")
}

@test
fun an_ordinary_diagnostic_carries_no_code(): void {
    val d = Diagnostic.error_at(Span.none(), "something is wrong")
    assert_eq(d.is_lint(), false, "an ordinary error is not a lint")
    assert_eq(d.code.as_str(), "", "and carries no code")
}

@test
fun a_lint_carries_the_name_it_is_configured_by(): void {
    val d = Diagnostic.lint_at("unused_import", Span.none(), "unused import `x`")
    assert_eq(d.is_lint(), true, "a lint knows what it is")
    assert_eq(d.code.as_str(), "unused_import", "under the name @allow(...) will write")
}

@test
fun a_lints_level_comes_from_the_registry_not_the_call_site(): void {
    val d = Diagnostic.lint_at("unused_import", Span.none(), "m")
    assert_eq(severity_is_warning(d.severity), true, "the registry says Warning")
    assert_eq(severity_is_warning(LintInfo.default_of("unused_import").severity()), true, "and says so directly too")
}

@test
fun the_registry_answers_only_for_lints_that_exist(): void {
    assert_eq(LintInfo.exists("unused_import"), true, "a registered lint is found")
    assert_eq(LintInfo.exists("unused_imports"), false, "a near miss is not")
    assert_eq(LintInfo.named("nope").is_none(), true, "and a miss names no lint")
}

@test
fun every_registered_lint_is_described(): void {
    val all = LintInfo.all()
    assert_eq(all.size() > 0, true, "there is at least one")
    while l in &all {
        assert_eq(l.name.as_str() != "", true, "every entry is named")
        assert_eq(LintInfo.is_group(l.group.as_str()) && l.group.as_str() != "all", true, "and in a group")
        assert_eq(l.description.as_str() != "", true, "and described")
    }
}

fun severity_is_warning(s: Severity): bool {
    return when (s) {
        Warning => true
        _ => false
    }
}
