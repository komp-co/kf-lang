import core.assert.assert_eq

import kf_core.span.*
import testing.test

fun one_file_map(content: str): Ptr<SourceMap> {
    val smp: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *smp = SourceMap.new() }
    val _id = unsafe { smp.add_file(SourceFile.new("t.kf", String.from(content))) }
    return smp
}

@test fun render_head_has_path_line_col(): void {
    // "val x = 1\nval y = true\n" — span on `true` (line 2, col 9).
    val smp = one_file_map("val x = 1\nval y = true\n")
    val sp = Span { file_id: 1, start: 18, end: 22 }
    val d = Diagnostic.error_at(sp, "bad init")
    val out = d.render(smp)
    val s = out.as_str()
    assert_eq(str_starts_with_at(s, "t.kf:2:9: error: bad init", 0), true, "head is path:line:col: error: msg")
}

@test fun render_echoes_line_and_caret(): void {
    val smp = one_file_map("val x = 1\nval y = true\n")
    val sp = Span { file_id: 1, start: 18, end: 22 }
    val d = Diagnostic.error_at(sp, "bad init")
    val out = d.render(smp)
    val s = out.as_str()
    assert_eq(s.contains("\n    val y = true\n"), true, "echoes the offending source line")
    assert_eq(s.contains("\n            ^~~~"), true, "caret at col 9 with tildes under the span")
}

@test fun render_no_span_falls_back_to_bare_message(): void {
    val smp = one_file_map("whatever")
    val d = Diagnostic.error_at(Span.none(), "synthesized")
    val out = d.render(smp)
    assert_eq(out.as_str(), "error: synthesized", "no location -> bare message, no echo")
}

@test fun render_caret_clipped_to_line(): void {
    // The span runs past its line; the tildes must stop at the line's end.
    val smp = one_file_map("ab\ncdef\n")
    val sp = Span { file_id: 1, start: 3, end: 30 }
    val d = Diagnostic.error_at(sp, "long span")
    val out = d.render(smp)
    assert_eq(out.contains("\n    ^~~~"), true, "caret+3 tildes (line is 4 bytes)")
    assert_eq(out.contains("^~~~~"), false, "no tilde past the line end")
}

@test fun render_warning_prefix(): void {
    val smp = one_file_map("val a = 1\n")
    val sp = Span { file_id: 1, start: 4, end: 5 }
    val d = Diagnostic.warning_at(sp, "unused")
    val out = d.render(smp)
    assert_eq(out.contains("warning: unused"), true, "warning severity label")
}

fun with_note(d: Diagnostic, sp: Span, message: str): Diagnostic {
    var out = d
    out.secondary.push(Label.new(sp, String.from(message)))
    return out
}

@test fun a_note_echoes_the_line_it_names(): void {
    val smp = one_file_map("fun f(): void\nval y = true\n")
    val primary = Span { file_id: 1, start: 18, end: 22 }
    val note_at = Span { file_id: 1, start: 4, end: 5 }
    val d = with_note(Diagnostic.error_at(primary, "bad init"), note_at, "first declared here")
    val s = d.render(smp).as_str()
    assert_eq(s.contains("= note: first declared here (at t.kf:1:5)"), true, "the head still names the location")
    assert_eq(s.contains("\n      fun f(): void\n"), true, "and now echoes that line, indented past the primary")
    assert_eq(s.contains("\n          ^"), true, "with a caret under the span it points at")
}

@test fun a_note_with_no_placeable_span_echoes_nothing(): void {
    val smp = one_file_map("val x = 1\n")
    val d = with_note(Diagnostic.error_at(Span { file_id: 1, start: 4, end: 5 }, "bad"), Span.none(), "from a synthesized node")
    val s = d.render(smp).as_str()
    assert_eq(s.contains("= note: from a synthesized node"), true, "the message survives")
    assert_eq(s.contains("(at "), false, "with no location and so no echo")
}

@test fun the_primary_echo_is_unchanged_by_the_note(): void {
    // The note's echo is indented further; the primary's must not move.
    val smp = one_file_map("val x = 1\nval y = true\n")
    val d = with_note(Diagnostic.error_at(Span { file_id: 1, start: 18, end: 22 }, "bad init"),
        Span { file_id: 1, start: 4, end: 5 }, "see here")
    val s = d.render(smp).as_str()
    assert_eq(s.contains("\n    val y = true\n"), true, "primary echo still at four spaces")
}

@test fun several_notes_each_get_their_own_echo(): void {
    val smp = one_file_map("aa\nbb\ncc\n")
    var d = Diagnostic.error_at(Span { file_id: 1, start: 0, end: 1 }, "bad")
    d = with_note(d, Span { file_id: 1, start: 3, end: 4 }, "one")
    d = with_note(d, Span { file_id: 1, start: 6, end: 7 }, "two")
    val s = d.render(smp).as_str()
    assert_eq(s.contains("\n      bb\n"), true, "the first note's line")
    assert_eq(s.contains("\n      cc\n"), true, "and the second's")
}

@test fun with_color_off_nothing_changes(): void {
    val smp = one_file_map("val y = true\n")
    val d = Diagnostic.error_at(Span { file_id: 1, start: 8, end: 12 }, "bad init")
    assert_eq(d.render_colored(smp, false).as_str(), d.render(smp).as_str(), "`render` is the uncolored form")
    assert_eq((d.render(smp).as_str()).contains("\033"), false, "and carries no escape at all")
}

@test fun an_error_is_red_and_a_warning_is_yellow(): void {
    val smp = one_file_map("val y = true\n")
    val sp = Span { file_id: 1, start: 8, end: 12 }
    val e = (Diagnostic.error_at(sp, "bad")).render_colored(smp, true)
    assert_eq(e.contains("\033[1;31merror\033[0m: "), true, "error in red, the colon plain")
    val w = (Diagnostic.warning_at(sp, "odd")).render_colored(smp, true)
    assert_eq(w.contains("\033[1;33mwarning\033[0m: "), true, "warning in yellow")
}

@test fun the_location_is_left_uncolored(): void {
    // Terminals match `path:line:col` as plain text to make a link.
    val smp = one_file_map("val y = true\n")
    val d = Diagnostic.error_at(Span { file_id: 1, start: 8, end: 12 }, "bad")
    val s = d.render_colored(smp, true).as_str()
    assert_eq(str_starts_with_at(s, "t.kf:1:9: ", 0), true, "the head opens with a bare location")
}

@test fun the_echoed_source_line_keeps_its_own_bytes(): void {
    val smp = one_file_map("val y = true\n")
    val d = Diagnostic.error_at(Span { file_id: 1, start: 8, end: 12 }, "bad")
    val s = d.render_colored(smp, true).as_str()
    assert_eq(s.contains("\n    val y = true\n"), true, "the source line, unadorned")
    assert_eq(s.contains("\033[1;31m            ^~~~\033[0m"), true, "the caret in the severity's color")
}

@test fun a_note_is_cyan_and_resets_after_itself(): void {
    val smp = one_file_map("val y = true\n")
    var d = Diagnostic.error_at(Span { file_id: 1, start: 8, end: 12 }, "bad")
    d.secondary.push(Label.new(Span { file_id: 1, start: 4, end: 5 }, "declared here"))
    val s = d.render_colored(smp, true).as_str()
    assert_eq(s.contains("\033[1;36m= note:\033[0m declared here"), true, "the label colored, its message not")
}

@test fun span_line_first_and_last(): void {
    val smp = one_file_map("first\nsecond\nthird")
    val s1 = unsafe { smp.span_line(Span { file_id: 1, start: 2, end: 3 }) }
    assert_eq(s1.as_str(), "first", "line 1 (no trailing newline)")
    val s3 = unsafe { smp.span_line(Span { file_id: 1, start: 15, end: 16 }) }
    assert_eq(s3.as_str(), "third", "last line without a trailing newline")
    val bad = unsafe { smp.span_line(Span { file_id: 9, start: 0, end: 1 }) }
    assert_eq(bad.as_str(), "", "unknown file -> empty")
}

fun str_starts_with_at(haystack: str, needle: str, at: uint64): bool {
    val hn = haystack.byte_len()
    val nn = needle.byte_len()
    if at + nn > hn { return false }
    var j: uint64 = 0
    while j < nn {
        if haystack.byte_at(at + j) != needle.byte_at(j) { return false }
        j = j + 1
    }
    return true
}
