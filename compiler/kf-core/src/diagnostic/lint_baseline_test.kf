import core.assert.assert_eq
import alloc.list.*
import testing.test

@test
fun rows_parse_and_comments_are_skipped(): void {
    var problems: List<String> = []
    val text = "# a comment\n\nlong_file 640 src/a b.kf\nunsafe_block 2 src/c.kf\n"
    val baseline = LintBaseline.parse(text, &var problems)
    assert_eq(problems.size(), 0, "two good rows")
    assert_eq(baseline.rows.size(), 2, "both read")
    assert_eq(baseline.rows[0].path.as_str(), "src/a b.kf", "a path runs to the end of the line")
    assert_eq(baseline.rows[1].count, 2, "the count")
}

@test
fun a_malformed_row_is_a_problem(): void {
    var problems: List<String> = []
    val baseline = LintBaseline.parse("long_file many src/a.kf\nlong_line\n", &var problems)
    assert_eq(baseline.rows.size(), 0, "neither row reads")
    assert_eq(problems.size(), 2, "each is reported")
}

@test
fun a_noted_file_finds_its_row(): void {
    var problems: List<String> = []
    var baseline = LintBaseline.parse("long_line 3 src/a.kf\n", &var problems)
    baseline.note_file(2, "src/a.kf")
    assert_eq(baseline.allowed("long_line", 2) ?: -1, 3, "the row's count")
    assert_eq(baseline.allowed("long_file", 2) ?: -1, -1, "no row for another lint")
    assert_eq(baseline.allowed("long_line", 1) ?: -1, -1, "nor for a file outside it")
}

@test
fun rendering_replaces_the_crates_rows_and_sorts(): void {
    var problems: List<String> = []
    var baseline = LintBaseline.parse("long_line 3 src/a.kf\nlong_line 4 other/b.kf\n", &var problems)
    baseline.crate_prefix = String.from("src/")
    val fresh = [BaselineRow { lint: String.from("long_file"), count: 500, path: String.from("src/a.kf") }]
    val text = baseline.rendered_with(&fresh, "# header\n")
    assert_eq(text.as_str(), "# header\nlong_line 4 other/b.kf\nlong_file 500 src/a.kf\n", "the other crate's row kept")
}
