import core.assert.assert_eq

import testing.test
import kf_core.span.Span

@test
fun a_fresh_sink_has_no_errors(): void {
    assert_eq(Diagnostics.new().has_errors(), false, "nothing reported")
}

@test
fun an_emitted_error_counts(): void {
    var sink = Diagnostics.new()
    sink.emit(Diagnostic.error_at(Span.none(), "broken"))
    assert_eq(sink.error_count(), 1, "one error")
}

@test
fun a_warning_is_not_an_error(): void {
    var sink = Diagnostics.new()
    sink.emit(Diagnostic.new(Severity.Warning, Label.new(Span.none(), "hm")))
    assert_eq(sink.has_errors(), false, "only a warning")
}

@test
fun errors_counted_elsewhere_add_up(): void {
    var sink = Diagnostics.new()
    sink.emit(Diagnostic.error_at(Span.none(), "broken"))
    sink.count_errors(2)
    assert_eq(sink.error_count(), 3, "one kept, two printed")
}

@test
fun a_popped_error_no_longer_counts(): void {
    var sink = Diagnostics.new()
    sink.emit(Diagnostic.error_at(Span.none(), "tried"))
    sink.items.pop()
    assert_eq(sink.has_errors(), false, "the trial was withdrawn")
}
