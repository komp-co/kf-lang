import core.assert.assert_eq
import testing.test

@test
fun crate_id_poison_is_invalid(): void {
    assert_eq(CrateId.new_poison().is_poison(), true, "poison crate id is invalid")
}

@test
fun crate_id_from_name_is_valid(): void {
    assert_eq(CrateId.new("json").is_poison(), false, "named crate id is valid")
}
