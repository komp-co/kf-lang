import core.assert.assert_eq

import kf_core.intern.intern
import testing.test
import kf_core.span.Span
import kf_core.ast.types.Type
import kf_core.ast.types.*

fun struct_named(s: str): Type {
    return Type { kind: TypeKind.Struct(intern(s)), provenance: Provenance.Inferred(Span.none()) }
}

fun ref_to(inner: Type): Type {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = inner }
    return Type { kind: TypeKind.RefTo(false, p), provenance: Provenance.Inferred(Span.none()) }
}

fun mut_ref_to(inner: Type): Type {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = inner }
    return Type { kind: TypeKind.RefTo(true, p), provenance: Provenance.Inferred(Span.none()) }
}

fun ptr_to(inner: Type): Type {
    val p: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *p = inner }
    return Type { kind: TypeKind.PtrTo(p), provenance: Provenance.Inferred(Span.none()) }
}

@test fun a_scalar_mangles_as_its_spelling(): void {
    assert_eq(Type.new_int32(Span.none()).mangle_frag().as_str(), "int32", "int32 mangles as int32")
}

// Any two of these sharing a fragment would be one type.
@test fun a_borrow_keeps_its_pointee(): void {
    assert_eq(ref_to(struct_named("A")).mangle_frag().as_str(), "kf__ref__A", "a borrow carries what it points at")
}

// `Ref__A` is what a user's `Ref<A>` mangles to, so the marker is
// reserved-prefixed.
@test fun a_borrow_does_not_mangle_as_a_declarable_generic(): void {
    val borrowed = ref_to(struct_named("A")).mangle_frag()
    assert_eq(borrowed.as_str() == "Ref__A", false, "`&A` does not take a name a user could declare")
}

// `&A` and `&var A` are one pointer in C and two types in KFlat.
@test fun a_mutable_borrow_differs_from_a_shared_one(): void {
    val shared = ref_to(struct_named("A")).mangle_frag()
    val mutable = mut_ref_to(struct_named("A")).mangle_frag()
    assert_eq(mutable.as_str(), "kf__mut__A", "a mutable borrow says so")
    assert_eq(shared.as_str() == mutable.as_str(), false, "`&A` and `&var A` are not one type")
}

@test fun borrows_of_different_types_differ(): void {
    val a = ref_to(struct_named("A")).mangle_frag()
    val b = ref_to(struct_named("B")).mangle_frag()
    assert_eq(a.as_str() == b.as_str(), false, "`&A` and `&B` are not the same type")
}

@test fun a_borrow_differs_from_its_pointee(): void {
    val borrowed = ref_to(struct_named("A")).mangle_frag()
    val owned = struct_named("A").mangle_frag()
    assert_eq(borrowed.as_str() == owned.as_str(), false, "`&A` and `A` are not the same type")
}

@test fun a_pointer_keeps_its_pointee(): void {
    assert_eq(ptr_to(struct_named("A")).mangle_frag().as_str(), "Ptr__A", "a pointer carries what it points at")
}

@test fun a_nested_pointer_keeps_every_level(): void {
    val nested = ptr_to(ptr_to(struct_named("A")))
    assert_eq(nested.mangle_frag().as_str(), "Ptr__Ptr__A", "nesting survives to the innermost type")
}

@test fun a_borrowed_dyn_trait_keeps_its_dyn_identity(): void {
    val dyn_ty = Type.new_dyn_trait(intern("Score"), [], Span.none())
    val bare = dyn_ty.mangle_frag()
    val borrowed = ref_to(dyn_ty).mangle_frag()
    assert_eq(borrowed.as_str(), bare.as_str(), "a borrowed dyn trait mangles as the dyn trait")
}

@test fun a_scalar_answers_the_scalar_table(): void {
    assert_eq(Type.new_bool(Span.none()).scalar_frag().as_str(), "bool", "bool is a scalar")
}

@test fun a_struct_is_not_a_scalar(): void {
    assert_eq(struct_named("A").scalar_frag().as_str(), "", "a struct owns no scalar spelling")
}
