/// One source file in memory. The line index lives on `SourceMap`: a
/// `SourceFile` is handed out by value, which an owning `List` field would
/// not survive.
@derive(Clone)
pub struct SourceFile {
    pub val path: String
    pub val content: String
}

impl SourceFile {
    pub static fun new(path: String, content: String): SourceFile {
        return SourceFile { path: path, content: content }
    }
}
