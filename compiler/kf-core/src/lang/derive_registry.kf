// The `@derive(...)` options, as data. The expander is a tag that
// kf-typecheck's derive.kf dispatches, since kf-core cannot name its
// functions.

import alloc.list.*

import kf_core.diagnostic.alternatives

pub enum DeriveExpander {
    Default
    Equal
    Clone
    Copy
    Hash
}

pub struct DeriveInfo {
    pub val name: String
    pub val struct_ok: bool
    pub val enum_ok: bool
    pub val expander: DeriveExpander
    /// The trait the synthesized impl names: `@derive(Equal)` writes
    /// `impl <lang("equal")> for X`.
    pub val lang: LangItem
}

impl DeriveInfo {
    /// Every option `@derive(...)` takes. Adding one is an entry here plus a
    /// case in kf-typecheck's `expand_one_derive`.
    static fun all(): List<DeriveInfo> {
        return [
            DeriveInfo {
                name: "Default", struct_ok: true, enum_ok: false,
                expander: DeriveExpander.Default, lang: LangItem.Default
            },
            DeriveInfo {
                name: "Equal", struct_ok: true, enum_ok: true,
                expander: DeriveExpander.Equal, lang: LangItem.Equal
            },
            DeriveInfo {
                name: "Clone", struct_ok: true, enum_ok: true,
                expander: DeriveExpander.Clone, lang: LangItem.Clone
            },
            DeriveInfo {
                name: "Copy", struct_ok: true, enum_ok: true,
                expander: DeriveExpander.Copy, lang: LangItem.Copy
            },
            DeriveInfo {
                name: "Hash", struct_ok: true, enum_ok: false,
                expander: DeriveExpander.Hash, lang: LangItem.Hash
            }
        ]
    }

    /// `Clone` or `Copy`: the compiler copies, so it derives these even where
    /// a declared `derive` expands templates for the rest.
    pub fun is_copying(): bool {
        return when (self.expander) {
            Clone => true
            Copy => true
            _ => false
        }
    }

    /// None when nothing answers to `name`.
    pub static fun named(name: str): DeriveInfo? {
        return DeriveInfo.all().find(|option: &DeriveInfo| option.name.as_str() == name)
    }

    /// What a struct may derive, as the end of an "expected ..." message.
    pub static fun expected_on_structs(): String {
        val names = DeriveInfo.all().filter(|option: DeriveInfo| option.struct_ok)
            .map(|option: DeriveInfo| "`${option.name}`")
        return alternatives(&names)
    }

    /// What an enum may derive, as the end of an "expected ..." message.
    pub static fun expected_on_enums(): String {
        val names = DeriveInfo.all().filter(|option: DeriveInfo| option.enum_ok)
            .map(|option: DeriveInfo| "`${option.name}`")
        return alternatives(&names)
    }
}
