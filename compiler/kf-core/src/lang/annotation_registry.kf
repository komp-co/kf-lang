// The annotations the compiler accepts, as data. Validation and the "unknown
// annotation" message both read this registry.

import alloc.list.*
import kf_core.ast.declaration.*
import kf_core.diagnostic.alternatives

/// The declaration kinds an annotation may sit on.
pub enum AnnotationTarget {
    /// `@test`, `@disabled`.
    Function
    /// `@derive`, `@no_mangle`.
    StructOrEnum
    /// `@lang` — a type or trait the language builds on.
    StructEnumOrTrait
    /// `@receiver_params`, `@receiver_trait` — a declaration written with an
    /// extension receiver (`ext_name` set).
    Extension
    /// `@allow` — any declaration.
    Any
}

pub struct AnnotationInfo {
    pub val name: String
    pub val target: AnnotationTarget
    /// True for `@name(...)`, false for a bare `@name`.
    pub val takes_args: bool
}

impl AnnotationInfo {
    /// Every annotation the compiler defines, in the order of the generated
    /// "expected" list.
    static fun all(): List<AnnotationInfo> {
        return [
            AnnotationInfo { name: "allow", target: AnnotationTarget.Any, takes_args: true },
            AnnotationInfo { name: "derive", target: AnnotationTarget.StructOrEnum, takes_args: true },
            AnnotationInfo { name: "no_mangle", target: AnnotationTarget.StructOrEnum, takes_args: false },
            AnnotationInfo { name: "lang", target: AnnotationTarget.StructEnumOrTrait, takes_args: true },
            AnnotationInfo { name: "prelude", target: AnnotationTarget.Function, takes_args: false },
            AnnotationInfo { name: "receiver_params", target: AnnotationTarget.Extension, takes_args: true },
            AnnotationInfo { name: "receiver_trait", target: AnnotationTarget.Extension, takes_args: true }
        ]
    }

    /// None when the compiler defines no annotation `kind`; a program may
    /// still declare one.
    pub static fun named(kind: str): AnnotationInfo? {
        return AnnotationInfo.all().find(|known: &AnnotationInfo| known.name.as_str() == kind)
    }

    pub static fun is_known(kind: str): bool {
        return AnnotationInfo.named(kind).is_some()
    }

    /// Every one as it is written, as the end of an "expected ..." message.
    pub static fun expected(): String {
        val written = AnnotationInfo.all().map(|known: AnnotationInfo| known.written())
        return alternatives(&written)
    }

    /// `@name`, or `@name(...)` for one that takes arguments.
    fun written(): String {
        return if self.takes_args { "@${self.name}(...)" } else { "@${self.name}" }
    }
}

impl AnnotationTarget {
    /// `declaration` is of a kind this target names.
    pub fun allows(declaration: &TopDecl): bool {
        return when (self) {
            Function => when (declaration.kind) {
                Function(_p, _r, _b, _pub, _u, _m, _s) => true
                _ => false
            }
            StructOrEnum => when (declaration.kind) {
                Struct(_f, _p) => true
                EnumDecl(_v, _p) => true
                _ => false
            }
            StructEnumOrTrait => when (declaration.kind) {
                Struct(_f, _p) => true
                EnumDecl(_v, _p) => true
                TraitDecl(_m, _p, _s) => true
                _ => false
            }
            Extension => declaration.ext_name.as_str() != ""
            Any => true
        }
    }

    /// "a function", "a struct or enum" — the subject of the "can only annotate"
    /// error.
    pub fun phrase(): str {
        return when (self) {
            Function => "a function"
            StructOrEnum => "a struct or enum"
            StructEnumOrTrait => "a struct, enum or trait"
            Extension => "an extension function"
            Any => "any declaration"
        }
    }
}
