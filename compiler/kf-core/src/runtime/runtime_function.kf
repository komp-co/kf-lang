// The functions every generated translation unit can call without a KFlat
// declaration: the runtime header declares most of them, alloc the ones that
// return a `String`. The checker, the header and codegen all read this table.

/// One of them.
view struct RuntimeFunction {
    pub val name: str
    /// Its declaration in the runtime header; "" when alloc declares it.
    pub val prototype: str
    /// What it returns, spelled as in KFlat (`never` for no return); "" when
    /// its calls are typed through the sig table instead.
    pub val returns: str
    /// Taken in every translation unit: no program declaration shadows it.
    pub val reserved: bool
}

/// Entry `index` of the table, None past the end.
fun runtime_function_at(index: uint64): RuntimeFunction? {
    return when index {
        0 => RuntimeFunction {
            name: "kf_alloc", prototype: "void* kf_alloc(size_t size);",
            returns: "", reserved: false
        }
        1 => RuntimeFunction {
            name: "kf_free", prototype: "void kf_free(void* ptr);",
            returns: "", reserved: false
        }
        2 => RuntimeFunction {
            name: "kf_realloc", prototype: "void* kf_realloc(void* ptr, size_t size);",
            returns: "", reserved: false
        }
        3 => RuntimeFunction {
            name: "exit", prototype: "void exit(int status);",
            returns: "void", reserved: true
        }
        4 => RuntimeFunction {
            name: "kf_sym_intern", prototype: "uint32_t kf_sym_intern(const char* s);",
            returns: "uint32", reserved: true
        }
        5 => RuntimeFunction {
            name: "kf_sym_resolve", prototype: "const char* kf_sym_resolve(uint32_t id);",
            returns: "str", reserved: true
        }
        6 => RuntimeFunction {
            name: "kf_fs_dir_open", prototype: "uint64_t kf_fs_dir_open(const char* path);",
            returns: "uint64", reserved: true
        }
        7 => RuntimeFunction {
            name: "kf_fs_dir_next", prototype: "const char* kf_fs_dir_next(uint64_t handle);",
            returns: "str", reserved: true
        }
        8 => RuntimeFunction {
            name: "kf_fs_dir_close", prototype: "void kf_fs_dir_close(uint64_t handle);",
            returns: "void", reserved: true
        }
        9 => RuntimeFunction {
            name: "str_equals", prototype: "bool str_equals(const char* a, const char* b);",
            returns: "bool", reserved: true
        }
        10 => RuntimeFunction {
            name: "str_as_str", prototype: "const char* str_as_str(const char* s);",
            returns: "str", reserved: true
        }
        11 => RuntimeFunction {
            name: "runtime_print", prototype: "void runtime_print(const char* s);",
            returns: "", reserved: true
        }
        12 => RuntimeFunction {
            name: "runtime_println", prototype: "void runtime_println(const char* s);",
            returns: "", reserved: true
        }
        13 => RuntimeFunction {
            name: "panic", prototype: "void panic(const char* s);",
            returns: "never", reserved: false
        }
        14 => RuntimeFunction {
            name: "is_dir", prototype: "bool is_dir(const char* p);",
            returns: "bool", reserved: true
        }
        15 => RuntimeFunction {
            name: "write_file", prototype: "void write_file(const char* path, const char* content);",
            returns: "void", reserved: false
        }
        16 => RuntimeFunction {
            name: "kf_arg_init", prototype: "void kf_arg_init(int argc, char** argv);",
            returns: "void", reserved: true
        }
        17 => RuntimeFunction {
            name: "kf_arg_count", prototype: "int32_t kf_arg_count(void);",
            returns: "int32", reserved: true
        }
        18 => RuntimeFunction {
            name: "kf_arg_get", prototype: "const char* kf_arg_get(int32_t i);",
            returns: "str", reserved: true
        }
        19 => RuntimeFunction {
            name: "kf_str_byte_len", prototype: "uint64_t kf_str_byte_len(const char* s);",
            returns: "uint64", reserved: false
        }
        20 => RuntimeFunction {
            name: "kf_str_byte_at", prototype: "uint8_t kf_str_byte_at(const char* s, uint64_t i);",
            returns: "uint8", reserved: false
        }
        21 => RuntimeFunction {
            name: "kf_file_hash", prototype: "uint64_t kf_file_hash(const char* path);",
            returns: "uint64", reserved: true
        }
        22 => RuntimeFunction {
            name: "kf_create_dir_all", prototype: "int32_t kf_create_dir_all(const char* path);",
            returns: "int32", reserved: true
        }
        23 => RuntimeFunction {
            name: "kf_remove_dir_all", prototype: "int32_t kf_remove_dir_all(const char* path);",
            returns: "int32", reserved: true
        }
        24 => RuntimeFunction {
            name: "kf_process_status",
            prototype: "int32_t kf_process_status(const char*, void*, const char*, void*, const char*);",
            returns: "", reserved: true
        }
        25 => RuntimeFunction {
            name: "int64_display", prototype: "",
            returns: "String", reserved: true
        }
        26 => RuntimeFunction {
            name: "uint64_display", prototype: "",
            returns: "String", reserved: true
        }
        27 => RuntimeFunction {
            name: "join", prototype: "",
            returns: "String", reserved: true
        }
        28 => RuntimeFunction {
            name: "kf_current_dir", prototype: "",
            returns: "String", reserved: true
        }
        29 => RuntimeFunction {
            name: "kf_self_dir", prototype: "",
            returns: "String", reserved: true
        }
        30 => RuntimeFunction {
            name: "kf_temp_dir", prototype: "",
            returns: "String", reserved: true
        }
        31 => RuntimeFunction {
            name: "kf_str_slice_to_string", prototype: "",
            returns: "String", reserved: false
        }
        32 => RuntimeFunction {
            name: "read_file", prototype: "",
            returns: "String", reserved: false
        }
        _ => null
    }
}

fun runtime_function_named(name: str): RuntimeFunction? {
    var index: uint64 = 0
    while true {
        val entry = runtime_function_at(index) ?: return null
        if entry.name == name { return entry }
        index = index + 1
    }
    return null
}

/// Taken in every translation unit: no program declaration shadows it.
pub fun runtime_name_is_reserved(name: str): bool {
    val entry = runtime_function_named(name) ?: return false
    return entry.reserved
}

/// The runtime header declares it.
pub fun runtime_header_declares(name: str): bool {
    val entry = runtime_function_named(name) ?: return false
    return entry.prototype != ""
}

/// What a runtime function returns, spelled as in KFlat; None for a name the
/// table does not type.
pub fun runtime_function_returns(name: str): String? {
    val entry = runtime_function_named(name) ?: return null
    if entry.returns == "" { return null }
    return String.from(entry.returns)
}

/// The header's declarations, one per line, in table order.
pub fun runtime_header_prototypes(): String {
    var out = ""
    var index: uint64 = 0
    while true {
        val entry = runtime_function_at(index) ?: break
        if entry.prototype != "" {
            out.append(entry.prototype)
            out.append("\n")
        }
        index = index + 1
    }
    return out
}
