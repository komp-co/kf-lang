// The functions every generated translation unit can call without a KFlat
// declaration: the runtime header declares most of them, alloc the ones that
// return a `String`. The checker, the header and codegen all read this table.

/// Row `index` as `name|prototype|returns|reserved`, "" past the end.
/// - prototype: its declaration in the runtime header; empty when alloc
///   declares it.
/// - returns: what it returns, spelled as in KFlat (`never` for no return);
///   empty when its calls are typed through the sig table instead.
/// - reserved: `r` when the name is taken in every translation unit, so no
///   program declaration shadows it; `-` otherwise.
fun runtime_function_row(index: uint64): str {
    return when index {
        0 => "kf_alloc|void* kf_alloc(size_t size);||-"
        1 => "kf_free|void kf_free(void* ptr);||-"
        2 => "kf_realloc|void* kf_realloc(void* ptr, size_t size);||-"
        3 => "exit|void exit(int status);|void|r"
        4 => "kf_sym_intern|uint32_t kf_sym_intern(const char* s);|uint32|r"
        5 => "kf_sym_resolve|const char* kf_sym_resolve(uint32_t id);|str|r"
        6 => "kf_fs_dir_open|uint64_t kf_fs_dir_open(const char* path);|uint64|r"
        7 => "kf_fs_dir_next|const char* kf_fs_dir_next(uint64_t handle);|str|r"
        8 => "kf_fs_dir_close|void kf_fs_dir_close(uint64_t handle);|void|r"
        9 => "str_equals|bool str_equals(const char* a, const char* b);|bool|r"
        10 => "str_as_str|const char* str_as_str(const char* s);|str|r"
        11 => "runtime_print|void runtime_print(const char* s);||r"
        12 => "runtime_println|void runtime_println(const char* s);||r"
        13 => "panic|void panic(const char* s);|never|-"
        14 => "is_dir|bool is_dir(const char* p);|bool|r"
        15 => "write_file|void write_file(const char* path, const char* content);|void|-"
        16 => "kf_arg_init|void kf_arg_init(int argc, char** argv);|void|r"
        17 => "kf_arg_count|int32_t kf_arg_count(void);|int32|r"
        18 => "kf_arg_get|const char* kf_arg_get(int32_t i);|str|r"
        19 => "kf_str_byte_len|uint64_t kf_str_byte_len(const char* s);|uint64|-"
        20 => "kf_str_byte_at|uint8_t kf_str_byte_at(const char* s, uint64_t i);|uint8|-"
        21 => "kf_file_hash|uint64_t kf_file_hash(const char* path);|uint64|r"
        22 => "kf_create_dir_all|int32_t kf_create_dir_all(const char* path);|int32|r"
        23 => "kf_remove_dir_all|int32_t kf_remove_dir_all(const char* path);|int32|r"
        24 => "kf_process_status|int32_t kf_process_status(const char*, void*, const char*, void*, const char*);||r"
        25 => "int64_display||String|r"
        26 => "uint64_display||String|r"
        27 => "join||String|r"
        28 => "kf_current_dir||String|r"
        29 => "kf_self_dir||String|r"
        30 => "kf_temp_dir||String|r"
        31 => "kf_str_slice_to_string||String|-"
        32 => "read_file||String|-"
        _ => ""
    }
}

/// The row of `name`, or -1.
fun runtime_function_index(name: str): int64 {
    var index: uint64 = 0
    while true {
        val row = runtime_function_row(index)
        if row == "" { return 0 - 1 }
        if row.starts_with(name) && row.byte_len() > name.byte_len() && row.byte_at(name.byte_len()) == 124 {
            return index as int64
        }
        index = index + 1
    }
    return 0 - 1
}

/// Field `field` of row `index`: 0 name, 1 prototype, 2 returns.
fun runtime_function_field(index: uint64, field: uint64): String {
    val row = runtime_function_row(index)
    var start: uint64 = 0
    var seen: uint64 = 0
    while i in 0..row.byte_len() {
        if row.byte_at(i) == 124 {
            if seen == field { return String.from(row.substring(start, i).as_str()) }
            seen = seen + 1
            start = i + 1
        }
    }
    return ""
}

/// Taken in every translation unit: no program declaration shadows it.
pub fun runtime_name_is_reserved(name: str): bool {
    val index = runtime_function_index(name)
    return index >= 0 && runtime_function_row(index as uint64).ends_with("|r")
}

/// The runtime header declares it.
pub fun runtime_header_declares(name: str): bool {
    val index = runtime_function_index(name)
    if index < 0 { return false }
    return runtime_function_field(index as uint64, 1).as_str() != ""
}

/// What a runtime function returns, spelled as in KFlat; "" for a name the
/// table does not type.
pub fun runtime_function_returns(name: str): String {
    val index = runtime_function_index(name)
    if index < 0 { return "" }
    return runtime_function_field(index as uint64, 2)
}

/// The header's declarations, one per line, in table order.
pub fun runtime_header_prototypes(): String {
    var out = ""
    var index: uint64 = 0
    while runtime_function_row(index) != "" {
        val prototype = runtime_function_field(index, 1)
        if prototype.as_str() != "" {
            out.append(prototype.as_str())
            out.append("\n")
        }
        index = index + 1
    }
    return out
}
