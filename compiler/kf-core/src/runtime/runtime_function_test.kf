import core.assert.assert_eq
import testing.test

@test fun a_header_function_is_declared_by_the_header(): void {
    assert_eq(runtime_header_declares("kf_alloc"), true, "the header declares the allocator")
}

@test fun a_function_alloc_declares_is_not_in_the_header(): void {
    assert_eq(runtime_header_declares("join"), false, "`join` returns a String, which alloc declares")
}

@test fun a_reserved_runtime_name_is_reserved(): void {
    assert_eq(runtime_name_is_reserved("exit"), true, "`exit` is taken in every translation unit")
}

@test fun an_unreserved_runtime_name_is_not_reserved(): void {
    assert_eq(runtime_name_is_reserved("panic"), false, "`panic` resolves through core's declaration")
}

@test fun a_prefix_of_a_runtime_name_is_not_one(): void {
    assert_eq(runtime_name_is_reserved("exi"), false, "the whole name must match")
}

@test fun a_runtime_name_with_a_suffix_is_not_one(): void {
    assert_eq(runtime_name_is_reserved("exit2"), false, "the name ends at the field separator")
}

@test fun a_runtime_function_knows_what_it_returns(): void {
    assert_eq(runtime_function_returns("kf_arg_count").as_str(), "int32", "the KFlat spelling of the result")
}

@test fun an_unknown_name_returns_nothing_the_table_types(): void {
    assert_eq(runtime_function_returns("not_a_runtime_function").as_str(), "", "no row")
}

@test fun the_header_lists_each_prototype(): void {
    val prototypes = runtime_header_prototypes()
    assert_eq(prototypes.as_str().contains("void kf_free(void* ptr);\n"), true, "one declaration per line")
}
