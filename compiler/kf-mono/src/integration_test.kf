import core.assert.assert_eq
import alloc.list.*

import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.intern.*
import kf_resolve.new_decl_table
import kf_resolve.resolve_module
import kf_typecheck.typecheck_module
import testing.test

fun mk_void_ret(): Ptr<TypeRef> {
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rp = TypeRef.new(Span.none(), TypeRefKind.Named(intern("void"), List.new<TypeRef>())) }
    return rp
}

fun mk_lit_int_arg(n: int64): Expr {
    var a = Expr.new(Span.none(), ExprKind.LitInt(n))
    a.ty = Type.new_int32(Span.none())
    return a
}

fun Module.first_body_callee(): String {
    val td = *self.decls.at(0)
    when (td.kind) {
        Function(_, _, body, _, _, _, _) => {
            val stmt = *body.at(0)
            when (stmt.kind) {
                Expression(ep) => return unsafe { ep.mangled_callee.as_string() }
                _ => return ""
            }
        }
        _ => return ""
    }
}

@test fun integration_call_in_fn_body_keeps_bare_name(): void {
    // fun main(): void { foo(42) } — non-generic, so the callee stays bare.
    var args = List.new<Expr>()
    args.push(mk_lit_int_arg(42))
    val call_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *call_ptr = Expr.new(Span.none(), ExprKind.Call(intern("foo"), args)) }
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.Expression(call_ptr)))
    val fn_kind = TopDeclKind.Function(List.new<Param>(), mk_void_ret(), body, true, false, false, false)
    val fn_td = TopDecl.new(Span.none(), String.from("main"), fn_kind)
    var m = Module {
        crate: CrateId.new_poison(),
        path: List.new<String>(),
        decls: List.new<TopDecl>(),
        imports: List.new<Import>()
    }
    m.decls.push(fn_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    val _diags = typecheck_module(&var m, &var table)
    m.mono_module()
    assert_eq(m.first_body_callee().as_str(), "foo", "post-mono callee stays bare")
}

fun mk_list_string_recv(): Expr {
    var r = Expr.new(Span.none(), ExprKind.Variable(intern("xs")))
    r.ty = Type { kind: TypeKind.Struct(intern("List__String")), provenance: Provenance.Inferred(Span.none()) }
    return r
}

@test fun integration_method_call_in_fn_body_gets_mangled(): void {
    // fun main(): void { xs.push() }  with xs typed as List<String>.
    val recv_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *recv_ptr = mk_list_string_recv() }
    val args = List.new<Expr>()
    val method_call_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *method_call_ptr = Expr.new(Span.none(), ExprKind.MethodCall(recv_ptr, intern("push"), args)) }
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.Expression(method_call_ptr)))
    val fn_kind = TopDeclKind.Function(List.new<Param>(), mk_void_ret(), body, true, false, false, false)
    val fn_td = TopDecl.new(Span.none(), String.from("main"), fn_kind)
    var m = Module {
        crate: CrateId.new_poison(),
        path: List.new<String>(),
        decls: List.new<TopDecl>(),
        imports: List.new<Import>()
    }
    m.decls.push(fn_td)
    var table = new_decl_table()
    resolve_module(&var m, &var table)
    // Typecheck is skipped; the receiver type was set by hand above.
    m.mono_module()
    assert_eq(m.first_body_callee().as_str(), "List__String_push", "xs.push() → List__String_push end-to-end")
}
