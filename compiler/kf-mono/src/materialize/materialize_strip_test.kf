import core.assert.assert_eq

import kf_core.span.Span
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*
import testing.test
import kf_core.intern.intern

fun method_named(name: str, generic: bool): TopDecl {
    var m = TopDecl.new(Span.none(), String.from(name), TopDeclKind.Poison)
    if generic { m.generics.push(TypeParam { span: Span.none(), name: intern("U"), bounds: List.new<TypeRef>() }) }
    return m
}

@test fun an_impl_block_keeps_only_its_plain_methods(): void {
    var methods = List.new<TopDecl>()
    methods.push(method_named("map", true))
    methods.push(method_named("size", false))
    methods.push(method_named("fold", true))
    var owner = TopDecl.new(Span.none(), String.from("Bag"), TopDeclKind.ImplBlock(methods))
    owner.drop_method_templates()
    val kept = when (owner.kind) {
        ImplBlock(ms) => if ms.size() == 1 { ms.at(0).name.as_string() } else { "" }
        _ => ""
    }
    assert_eq(kept.as_str(), "size", "the generic methods are gone, the plain one stays")
}
