// Instantiates generic declarations: finds every (template, type args) the
// program uses, clones and substitutes each into a concrete declaration,
// repeats until no new instance appears, then strips the templates.

import alloc.list.*
import alloc.hash_map.*

import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_typecheck.*
import kf_mono.collect.*
import kf_mono.mono_dyn_metadata
import kf_typecheck.types.subst_projections_in_decl
import kf_typecheck.check.mangle_base_name
import kf_typecheck.types.subst_projections_module
import kf_typecheck.check.decl.assoc_projection_registry
import kf_core.ast.subst.monomorphized_type_name
import kf_core.ast.subst.mangle_tyref
import kf_core.intern.*
import kf_core.lang.*
import kf_core.names.GenericTwin

/// A needed instantiation. `owner` is empty for a top-level template and
/// names the receiver type for a generic method, which has no top-level name:
/// `t.draw<DrawProbe>(..)` is `owner: "Terminal", base: "draw"`.
///
/// CONSTRAINT: `pub`, because `free_inst` and `collect_insts_in_decl` are and
/// name it. A public signature naming a private type emits two incompatible
/// C structs.
pub struct Inst {
    val base: String
    val args: List<TypeRef>
    val owner: String
}

pub fun free_inst(base: String, args: List<TypeRef>): Inst {
    return Inst { base: base, args: args, owner: "" }
}

/// Owner-qualified, so `Terminal.draw` and a free `draw` stay distinct.
fun Inst.inst_key(): String {
    val mangled = monomorphized_type_name(String.from(self.base.as_str()), &self.args).display()
    if self.owner.as_str().equals("") { return mangled }
    var key = String.from(self.owner.as_str())
    key.append("_")
    key.append(mangled.as_str())
    return key
}

pub mutating fun Module.materialize_generics(): void {
    var work = List.new<Inst>()
    // Every generic-parameter name in the module; an instantiation mentioning
    // one is abstract. Built once: cloning never introduces new parameters.
    val gps = self.collect_generic_param_names()
    val marities = self.collect_method_arities()
    // Each impl's associated-type bindings as written. Clones below resolve
    // their projections on the spot, since the instance name depends on it;
    // impls the loop mints are caught by the module pass at the end.
    val proj_sigs = assoc_projection_registry(self)
    self.trait_impl_registry(proj_sigs)
    val copy_name = self.lang_trait_name(LangItem.Copy)
    val array_name = self.lang_type_name(LangItem.Array)
    // Seeded from non-generic bodies only; templates are walked once cloned.
    while td in &self.decls {
        if td.generics.size() == 0 {
            td.collect_insts_in_decl(&gps, &marities, &var work)
        }
    }

    var done = HashMap.new<String, bool>()
    var deferred = HashMap.new<String, bool>()
    // Generic declarations by name, caught up as the loop appends.
    var templates = NameIndex.new()
    var indexed: uint64 = 0
    var w = 0
    while w < work.size() {
        val inst = *work.at(w)
        val mangled_name = monomorphized_type_name(String.from(inst.base.as_str()), &inst.args).display()
        val key = inst.inst_key()
        val seen = done.contains(&key)
        // A method whose owner's impl blocks are not minted yet waits, once,
        // behind the instances queued so far: one of them may mint them.
        val waits = !seen && !inst.owner.as_str().equals("") && !self.has_impl_block(inst.owner.as_str()) &&
            !deferred.contains(&key)
        if waits {
            deferred.insert(key.clone(), true)
            work.push(inst.clone())
        } else if !seen {
            done.insert(key.clone(), true)
            // A generic method is materialized inside the impl block `owner`.
            if !inst.owner.as_str().equals("") {
                self.materialize_impl_method(&inst, mangled_name.clone(), &gps, &marities, &var work, proj_sigs)
            } else {
                // Every template named `base` is materialized: the struct and
                // its impl blocks share it. The count is snapshotted so appended
                // decls are not re-scanned as templates.
                val n0 = self.decls.size()
                while indexed < n0 {
                    val d = self.decls.at(indexed)
                    if d.generics.size() > 0 { templates.add(d.name.as_string(), indexed) }
                    indexed = indexed + 1
                }
                val candidates = templates.positions(GenericTwin.name_of(inst.base.as_str()).as_str())
                while c in 0..candidates.size() {
                    val tmpl = *self.decls.at(candidates.get(c))
                    if tmpl.answers_to(inst.base.as_str()) {
                        if tmpl.template_accepts_args(&inst.args, proj_sigs, copy_name) {
                            var newdecl = clone_subst_decl(tmpl, inst.args, mangled_name.clone())
                            if tmpl.name.id == array_name.id { newdecl.add_array_storage(&inst.args) }
                            if !is_poison_decl(newdecl) {
                                // CONSTRAINT: in a separate build every TU that
                                // uses an instance emits its own copy, so it is
                                // stamped GenericTemplate to pass the header's
                                // crate filter.
                                if !self.crate.is_poison() {
                                    newdecl.linkage = Linkage.GenericTemplate
                                }
                                // Scanned before the push consumes it, and its
                                // projections resolved first, since an unresolved
                                // one would be minted into an instance name.
                                subst_projections_in_decl(&var newdecl, proj_sigs)
                                val queued = work.size()
                                newdecl.collect_insts_in_decl(&gps, &marities, &var work)
                                work.own_self_calls(queued, inst.base.as_str(), mangled_name.as_str())
                                self.decls.push(newdecl)
                            }
                        }
                    }
                }
            }
        }
        w = w + 1
    }

    self.strip_templates()
    self.strip_impl_method_templates()
    // CONSTRAINT: projections are resolved here, before normalize_trait_impls
    // turns TraitImpls into ImplBlocks and the bindings are lost.
    subst_projections_module(self, assoc_projection_registry(self))
    // Also before normalization, for the same reason.
    self.mono_dyn_metadata()
    self.normalize_trait_impls()
}

/// Whether an instance of `base` is cloned from this template. A
/// crate-qualified base names one crate's template only.
fun TopDecl.answers_to(base: str): bool {
    val crate = GenericTwin.crate_of(base) ?: return self.name.as_str().equals(base)
    return self.crate.raw as int64 == crate && self.name.as_str().equals(GenericTwin.name_of(base).as_str())
}

/// A generic method has no top-level name, so `strip_templates` would leave
/// it and codegen would emit an unresolved type parameter. The clone is
/// appended to the same impl block; templates stay until
/// `strip_impl_method_templates` removes them.
mutating fun Module.materialize_impl_method(inst: &Inst, mangled: String, gps: &List<String>, marities: &List<MethodArity>, work: &var List<Inst>, proj_sigs: Ptr<SigTable>): void {
    if self.materialize_trait_arg_impl(inst, gps, marities, work, proj_sigs) { return }
    val crate = self.crate
    while i in 0..self.decls.size() {
        if self.decls.at(i).name.as_str().equals(inst.owner.as_str()) {
            self.decls.at_mut(i).add_method_instance(inst, mangled.as_str(), gps, marities, work, proj_sigs, crate)
        }
    }
}

/// On an impl block of `inst`'s owner: appends its template specialized as
/// `mangled`, unless the block already holds it.
mutating fun TopDecl.add_method_instance(inst: &Inst, mangled: str, gps: &List<String>, marities: &List<MethodArity>,
    work: &var List<Inst>, proj_sigs: Ptr<SigTable>, crate: CrateId): void {
    when (self.kind) {
        ImplBlock(methods) => {
            var tmpl_idx: uint64 = 0
            var found = false
            var already = false
            while mi in 0..methods.size() {
                val mth = methods.at(mi)
                if mth.name.as_str().equals(mangled) { already = true }
                if !found && mth.generics.size() > 0 && mth.name.as_str().equals(inst.base.as_str()) {
                    tmpl_idx = mi
                    found = true
                }
            }
            if found && !already {
                var spec = clone_subst_decl(methods.at(tmpl_idx), inst.args, String.from(mangled))
                if !is_poison_decl(&spec) {
                    if !crate.is_poison() {
                        spec.linkage = Linkage.GenericTemplate
                    }
                    // Scanned before the push consumes it.
                    subst_projections_in_decl(&var spec, proj_sigs)
                    val queued = work.size()
                    spec.collect_insts_in_decl(gps, marities, work)
                    val template = mangle_base_name(inst.owner.clone())
                    work.own_self_calls(queued, template.as_str(), inst.owner.as_str())
                    methods.push(spec)
                    // CONSTRAINT: a binder is a copy of the payload, so the
                    // grown list is moved back into place.
                    self.kind = TopDeclKind.ImplBlock(take<List<TopDecl>>(methods))
                }
            }
            self.keep_rebuilt_block_fields()
        }
        _ => { }
    }
}

/// The owner's impl blocks were rebuilt from these fields alone; the rest
/// return to `new_top_decl`'s defaults, which the emitted C depends on.
mutating fun TopDecl.keep_rebuilt_block_fields(): void {
    self.from_trait_impl = false
    self.dyn_layouts = List.new<DynTraitLayout>()
    self.dyn_vtables = List.new<DynVTableInstance>()
    self.name_span = Span.none()
    self.ext_name = intern("")
    self.resolves_in = intern("")
    self.is_sealed = false
    self.is_view = false
    self.implemented_lang_trait = intern("")
    self.is_internal = false
}

/// `from<N>` in `impl<T, N: uint64> From<T[N]> for List<T>`: `N` came from
/// the trait's arguments, so the whole impl is cloned at it, trait argument
/// included. Its methods then lose `N`, and normalization names them for
/// `From<T[3]>` as any impl's. True when `inst` was such a method.
mutating fun Module.materialize_trait_arg_impl(inst: &Inst, gps: &List<String>, marities: &List<MethodArity>,
    work: &var List<Inst>, proj_sigs: Ptr<SigTable>): bool {
    var spec: TopDecl? = null
    while td in &self.decls {
        if td.name.as_str() != inst.owner.as_str() { continue }
        when (td.kind) {
            TraitImpl(tref, methods) => {
                val lifted = tref.lifted_generics_of(&methods, inst.base.as_str()) ?: continue
                var template = td.clone()
                template.generics = lifted
                spec = clone_subst_decl(&template, &inst.args, td.name.as_string())
            }
            _ => { }
        }
    }
    var made = spec ?: return false
    if self.has_trait_impl_like(&made) { return true }
    if !self.crate.is_poison() { made.linkage = Linkage.GenericTemplate }
    subst_projections_in_decl(&var made, proj_sigs)
    made.collect_insts_in_decl(gps, marities, work)
    self.decls.push(made)
    return true
}

/// The generics of method `name` when this trait reference names every one.
fun TypeRef.lifted_generics_of(methods: &List<TopDecl>, name: str): List<TypeParam>? {
    while mth in &methods {
        if mth.name.as_str() != name || mth.generics.size() == 0 { continue }
        while gp in &mth.generics {
            if !self.names_param(gp.name) { return null }
        }
        return mth.generics.clone()
    }
    return null
}

fun TypeRef.names_param(name: Sym): bool {
    when (self.kind) {
        Named(head, args) => {
            if head.id == name.id && args.size() == 0 { return true }
            while arg in &args {
                if arg.names_param(name) { return true }
            }
            return false
        }
        Reference(_mutable, inner) => return inner.names_param(name)
        _ => return false
    }
}

/// Another method of the same impl may have cloned it at these arguments.
fun Module.has_trait_impl_like(made: &TopDecl): bool {
    val wanted = made.trait_ref_spelling()
    while td in &self.decls {
        if td.name.id == made.name.id && td.trait_ref_spelling().as_str() == wanted.as_str() { return true }
    }
    return false
}

fun TopDecl.trait_ref_spelling(): String {
    return when (self.kind) {
        TraitImpl(tref, _methods) => tref.mangle_tyref().display()
        _ => String.from("")
    }
}

/// The method-level mirror of `strip_templates`.
mutating fun Module.strip_impl_method_templates(): void {
    while i in 0..self.decls.size() {
        self.decls.at_mut(i).drop_method_templates()
    }
}

/// An impl block keeps only its non-generic methods, and so does a trait impl
/// whose methods took parameters from its trait's arguments.
mutating fun TopDecl.drop_method_templates(): void {
    when (self.kind) {
        TraitImpl(tref, methods) => {
            var keep = List.new<bool>()
            while mth in &methods { keep.push(mth.generics.size() == 0) }
            if methods.keep_flagged(&keep) { self.kind = TopDeclKind.TraitImpl(tref, take<List<TopDecl>>(methods)) }
        }
        ImplBlock(methods) => {
            var i: uint64 = 0
            var dropped = false
            while i < methods.size() {
                if methods.at(i).generics.size() > 0 {
                    val _template = methods.remove(i)
                    dropped = true
                } else {
                    i = i + 1
                }
            }
            // CONSTRAINT: a binder is a copy of the payload, so the shrunk list
            // is moved back into place.
            if dropped { self.kind = TopDeclKind.ImplBlock(take<List<TopDecl>>(methods)) }
        }
        _ => { }
    }
}

fun str_list_contains(xs: List<String>, target: str): bool {
    while item in &xs {
        if item.as_str().equals(target) {
            return true
        }
    }
    return false
}

pub fun str_name_list_contains(xs: &List<String>, target: str): bool {
    while item in &xs {
        if item.as_str().equals(target) {
            return true
        }
    }
    return false
}

mutating fun Module.collect_generic_param_names(): List<String> {
    var out = List.new<String>()
    while td in &self.decls {
        while item in &td.generics {
            val nm = item.name.as_string()
            if !str_list_contains(out.clone(), nm.as_str()) { out.push(nm) }
        }
        // A generic method declares its parameters on the nested Function.
        when (td.kind) {
            ImplBlock(methods) => {
                while mth in &methods {
                    while item in &mth.generics {
                        val mn = item.name.as_string()
                        if !str_list_contains(out.clone(), mn.as_str()) { out.push(mn) }
                    }
                }
            }
            _ => { }
        }
    }
    return out
}

/// An `Array<T, N>` instance holds its elements in one field, `T items[N]`,
/// which no struct can declare. `Array<T, 0>` has none, since C has no
/// zero-length array.
mutating fun TopDecl.add_array_storage(args: &List<TypeRef>): void {
    if args.size() != 2 { return }
    val length = args.at(1).written_value() ?: return
    if length == 0 { return }
    val storage = TypeRef.new(self.span, TypeRefKind.Array(Box.new(args.at(0).clone()), length as uint64))
    when (self.kind) {
        Struct(fields, _is_pub) => {
            var with_storage = fields
            with_storage.push(Field.new(self.span, String.from("items"), Box.new(storage), true, false))
            self.kind = TopDeclKind.Struct(with_storage, _is_pub)
        }
        _ => { }
    }
}

fun TypeRef.written_value(): int64? {
    when (self.kind) {
        Value(v) => return v
        _ => return null
    }
}
