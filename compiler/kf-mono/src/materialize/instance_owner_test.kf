import core.assert.assert_eq
import alloc.list.*

fun method_inst(owner: str): Inst {
    return Inst { base: String.from("run"), args: List.new<TypeRef>(), owner: String.from(owner) }
}

fun owners_after_owning(from: uint64): String {
    var work = List.new<Inst>()
    work.push(method_inst("Holder"))
    work.push(method_inst("Holder"))
    work.push(method_inst("Other"))
    work.own_self_calls(from, "Holder", "Holder__int32")
    var out = String.from("")
    while inst in &work {
        out.append(inst.owner.as_str())
        out.append(" ")
    }
    return out
}

@test fun a_self_call_in_a_clone_belongs_to_the_instance(): void {
    assert_eq(owners_after_owning(1), "Holder Holder__int32 Other ", "only those queued from the clone on")
}

@test fun another_owner_is_left_alone(): void {
    assert_eq(owners_after_owning(2), "Holder Holder Other ", "a call on another type keeps its owner")
}
