// `kf-editor`: the editor's endpoint, which kf-lsp starts in place of
// `kflatc serve`. It answers the same protocol on stdin and stdout.
//
//   kf-editor          (as `kflatc serve`; `kf-editor serve` too)
//   kf-editor version

import kf_driver.cli.print_version
import kf_query.serve.kflatc_serve

pub fun kf_editor_main(): int32 {
    if is_serve_command(Args.at(0)) { return kflatc_serve() }
    if Args.at(0) == "version" { return print_version("kf-editor") }
    println("usage: kf-editor [serve]")
    println("       kf-editor version")
    return 2
}

/// None, or `serve`, as kflatc spells it: the protocol on stdin.
pub fun is_serve_command(command: str): bool {
    return command == "" || command == "serve"
}
