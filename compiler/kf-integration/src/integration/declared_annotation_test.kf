// A declared annotation crosses modules and crates like any imported name,
// and `annotated` lists only the crate being compiled, private
// functions of other modules included. Needs two crates, so not a
// tests/cases file.

import core.assert.assert_eq
import kf_tool.build.build_project_separate
import std.fs.scratch_root

extern "C" fun system(cmd: str): int32

/// `marks` declares `bench`, `sized(n)`, `route(path) on (Request) -> int32`
/// `plugin(order) on struct: Plugin`, `hook on <struct: Plugin, enum>`,
/// `shown on any`, `flagged on (bool, ..) -> _`, `served on (&var S,
/// Request) -> int32` and `<T: Plugin> started on (&T) -> int32`, all `pub`,
/// and a private `hidden`;
/// the app's `inner` module holds `inner_body`.
fun prepare_annotation_fixture(name: str, main_body: str, inner_body: str): int32 {
    val root = "${scratch_root()}/${name}"
    val cmd = "rm -rf ${root} && mkdir -p ${root}/marks/src ${root}/app/src/inner && cp -r libs ${root}/libs"
    val prep = unsafe { system(cmd.as_str()) }
    if prep != 0 { return prep }
    val libs = """core = { path = "../libs/core" }
alloc = { path = "../libs/alloc" }
"""
    val marks_toml = "[project]\nname = \"marks\"\nkind = \"lib\"\n\n[dependencies]\n${libs}"
    write_file("${root}/marks/kf.toml".as_str(), marks_toml.as_str())
    write_file("${root}/marks/src/lib.kf".as_str(), """pub annotation bench
annotation hidden

@bench
fun measured_in_marks(): void {}

pub fun marked_in_marks(): uint64 { return annotated<bench>().size() }

pub annotation sized(n: int32)

@sized(5)
fun sized_in_marks(): void {}

pub fun sized_total_in_marks(): int32 { return annotated<sized>().at(0).args.n }

pub struct Request {
    pub val body: String
}

pub trait Plugin {
    fun start(): int32
}

pub annotation route(path: String) on (Request) -> int32

pub annotation plugin(order: int32) on struct: Plugin

pub annotation hook on <struct: Plugin, enum>

pub annotation shown on any

pub annotation flagged on (bool, ..) -> _

pub annotation served on (&var S, Request) -> int32

pub annotation <T: Plugin> started on (&T) -> int32
""")
    val app_deps = "${libs}marks = { path = \"../marks\" }\n"
    val app_toml = "[project]\nname = \"app\"\nkind = \"bin\"\n\n[dependencies]\n${app_deps}"
    write_file("${root}/app/kf.toml".as_str(), app_toml.as_str())
    write_file("${root}/app/src/main.kf".as_str(), main_body)
    write_file("${root}/app/src/inner/inner.kf".as_str(), inner_body)
    return 0
}

fun build_and_run_annotated(name: str): int32 {
    val root = "${scratch_root()}/${name}"
    val built = build_project_separate("${root}/app".as_str(), "")
    if built != 0 { return 100 + built }
    return unsafe { system("${root}/app/target/kflat/app".as_str()) }
}

fun build_annotated_app(name: str): int32 {
    return build_project_separate("${scratch_root()}/${name}/app".as_str(), "")
}

fun annotation_counting_main(): str {
    return """import marks.bench
import marks.marked_in_marks

@bench
fun measured_in_main(): void {}

fun main(): int32 {
    if annotated<bench>().size() != 2 { return 1 }
    if marked_in_marks() != 1 { return 2 }
    return 0
}
"""
}

@test
fun an_imported_annotation_lists_this_crates_functions_only(): void {
    val inner = "import marks.bench\n\n@bench\nfun measured_in_inner(): void {}\n"
    assert_eq(prepare_annotation_fixture("kf_ann_count", annotation_counting_main(), inner), 0, "fixture prepared")
    assert_eq(build_and_run_annotated("kf_ann_count"), 0, "two functions in the app, one in marks")
}

@test
fun an_annotation_needs_an_import_in_each_module(): void {
    val inner = "@bench\nfun measured_in_inner(): void {}\n"
    assert_eq(prepare_annotation_fixture("kf_ann_unimported", annotation_counting_main(), inner), 0, "fixture prepared")
    assert_eq(build_annotated_app("kf_ann_unimported") != 0, true, "inner does not import `bench`")
}

@test
fun a_private_annotation_does_not_cross_a_crate(): void {
    val inner = "import marks.hidden\n\n@hidden\nfun measured_in_inner(): void {}\n"
    assert_eq(prepare_annotation_fixture("kf_ann_private", annotation_counting_main(), inner), 0, "fixture prepared")
    assert_eq(build_annotated_app("kf_ann_private") != 0, true, "`hidden` is not `pub`")
}

@test
fun an_imported_annotation_carries_its_arguments(): void {
    val main = """import marks.sized
import marks.sized_total_in_marks

@sized(1000)
fun sized_in_main(): void {}

fun main(): int32 {
    var total = 0
    while entry in &annotated<sized>() {
        total = total + entry.args.n
    }
    return total - 1010 + sized_total_in_marks() - 5
}
"""
    val inner = "import marks.sized\n\n@sized(n = 10)\nfun sized_in_inner(): void {}\n"
    assert_eq(prepare_annotation_fixture("kf_ann_args", main, inner), 0, "fixture prepared")
    assert_eq(build_and_run_annotated("kf_ann_args"), 0, "1000 and 10 in the app, 5 in marks")
}

@test
fun an_imported_annotation_checks_its_arguments(): void {
    val main = "fun main(): int32 { return 0 }\n"
    val inner = "import marks.sized\n\n@sized(\"five\")\nfun sized_in_inner(): void {}\n"
    assert_eq(prepare_annotation_fixture("kf_ann_args_bad", main, inner), 0, "fixture prepared")
    assert_eq(build_annotated_app("kf_ann_args_bad") != 0, true, "`n` is an int32 across the crate boundary too")
}

@test
fun an_imported_annotation_carries_its_target(): void {
    val main = """import marks.Request
import marks.Plugin
import marks.route
import marks.plugin

@plugin(7)
struct Logger {
    val level: int32
}

impl Plugin for Logger {
    fun start(): int32 { return self.level }
}

fun main(): int32 {
    var total = 0
    while r in &annotated<route>() {
        total = total + r.function(Request { body: "abcd" })
    }
    return total + annotated<plugin>().at(0).args.order - 11
}
"""
    val inner = """import marks.Request
import marks.route

@route("/len")
fun length(r: Request): int32 { return r.body.byte_len() as int32 }
"""
    assert_eq(prepare_annotation_fixture("kf_ann_target", main, inner), 0, "fixture prepared")
    assert_eq(build_and_run_annotated("kf_ann_target"), 0, "a route of 4 and a plugin of order 7")
}

@test
fun an_imported_annotation_checks_its_target(): void {
    val main = "fun main(): int32 { return 0 }\n"
    val inner = "import marks.Request\nimport marks.route\n\n@route(\"/x\")\nfun ignore(r: Request): void {}\n"
    assert_eq(prepare_annotation_fixture("kf_ann_target_bad", main, inner), 0, "fixture prepared")
    assert_eq(build_annotated_app("kf_ann_target_bad") != 0, true, "the target's function type crosses the boundary")
}

@test
fun an_imported_kind_list_carries_every_kind(): void {
    val main = """import marks.shown

@shown
trait Named {
    fun name(): int32
}

@shown
enum Speed {
    Fast
}

fun main(): int32 {
    val entries = annotated<shown>()
    if entries.size() != 2 { return 1 }
    if entries.at(0).kind != AnnotatedKind.Trait { return 2 }
    return 0
}
"""
    assert_eq(prepare_annotation_fixture("kf_ann_kinds", main, ""), 0, "fixture prepared")
    assert_eq(build_and_run_annotated("kf_ann_kinds"), 0, "a trait and an enum")
}

@test
fun an_imported_kind_list_checks_its_bounds(): void {
    val main = """import marks.hook

@hook
struct Silent {
    val n: int32
}

fun main(): int32 { return 0 }
"""
    assert_eq(prepare_annotation_fixture("kf_ann_kinds_bad", main, ""), 0, "fixture prepared")
    assert_eq(build_annotated_app("kf_ann_kinds_bad") != 0, true, "the struct's bound crosses the boundary")
}

@test
fun an_imported_kind_list_takes_an_unbounded_kind(): void {
    val main = """import marks.hook

@hook
enum Speed {
    Fast
}

fun main(): int32 { return annotated<hook>().size() as int32 - 1 }
"""
    assert_eq(prepare_annotation_fixture("kf_ann_kinds_enum", main, ""), 0, "fixture prepared")
    assert_eq(build_and_run_annotated("kf_ann_kinds_enum"), 0, "the enum needs no bound")
}

@test
fun an_imported_signature_pattern_matches_each_shape(): void {
    val main = """import marks.flagged

@flagged
fun alone(on: bool): int32 { return 1 }

@flagged
fun with_more(on: bool, label: String): String { return label }

fun main(): int32 { return annotated<flagged>().size() as int32 - 2 }
"""
    assert_eq(prepare_annotation_fixture("kf_ann_pattern", main, ""), 0, "fixture prepared")
    assert_eq(build_and_run_annotated("kf_ann_pattern"), 0, "both shapes listed")
}

@test
fun an_imported_signature_pattern_checks_its_parameters(): void {
    val main = """import marks.flagged

@flagged
fun counted(n: int32): int32 { return n }

fun main(): int32 { return 0 }
"""
    assert_eq(prepare_annotation_fixture("kf_ann_pattern_bad", main, ""), 0, "fixture prepared")
    val built = build_annotated_app("kf_ann_pattern_bad")
    assert_eq(built != 0, true, "the first parameter is a `bool` across the boundary")
}

@test
fun an_imported_type_parameter_is_pinned_by_the_query(): void {
    val main = """import marks.Request
import marks.Plugin
import marks.served
import marks.started

struct Logger {
    var level: int32
}

impl Plugin for Logger {
    fun start(): int32 { return self.level }
}

impl Logger {
    @served
    mutating fun raise(r: Request): int32 {
        self.level = self.level + 1
        return self.level
    }
}

@started
fun begin(l: &Logger): int32 { return l.start() * 10 }

fun main(): int32 {
    var l = Logger { level: 1 }
    val raised = annotated<served<Logger>>().at(0).function(&var l, Request { body: "" })
    return raised + annotated<started<Logger>>().at(0).function(&l) - 22
}
"""
    assert_eq(prepare_annotation_fixture("kf_ann_generic", main, ""), 0, "fixture prepared")
    assert_eq(build_and_run_annotated("kf_ann_generic"), 0, "2 raised, then 20 started")
}

@test
fun an_imported_type_parameter_keeps_its_bound(): void {
    val main = """import marks.started

struct Silent {
    val n: int32
}

@started
fun begin(s: &Silent): int32 { return s.n }

fun main(): int32 { return 0 }
"""
    assert_eq(prepare_annotation_fixture("kf_ann_generic_bad", main, ""), 0, "fixture prepared")
    assert_eq(build_annotated_app("kf_ann_generic_bad") != 0, true, "`Plugin` is required across the boundary")
}
