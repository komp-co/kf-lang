// A trait's supertraits survive the crate boundary: a consumer reading a bare
// `trait Ord2` would accept an impl the defining crate rejects.

import core.assert.assert_eq
import kf_integration.harness.compile_project_separate
import testing.test
import kf_core.diagnostic.Diagnostics

extern "C" fun system(cmd: str): int32

fun write_supertrait_fixtures(app_src: str): void {
    val _mk = unsafe { system("rm -rf ${Dir.scratch_path("kf_st_core")} ${Dir.scratch_path("kf_st_lib")} ${Dir.scratch_path("kf_st_app")} && mkdir -p ${Dir.scratch_path("kf_st_core/src")} ${Dir.scratch_path("kf_st_lib/src")} ${Dir.scratch_path("kf_st_app/src")} && cp -R libs/core/src/. ${Dir.scratch_path("kf_st_core/src/")}") }
    File.write(Dir.scratch_path("kf_st_core/kf.toml"), "[project]\nname = \"core\"\nkind = \"lib\"\n").unwrap()
    File.write(Dir.scratch_path("kf_st_lib/kf.toml"), """[project]
name = "stlib"
kind = "lib"

[dependencies]
core = { path = "../kf_st_core" }
""").unwrap()
    var lib_src = String.from("pub trait Eq2 { fun eq2(other: Self): bool }\n")
    lib_src.append("pub trait Ord2: Eq2 { fun ord2(other: Self): int32 }\n")
    File.write(Dir.scratch_path("kf_st_lib/src/lib.kf"), lib_src).unwrap()
    File.write(Dir.scratch_path("kf_st_app/kf.toml"), """[project]
name = "stapp"
kind = "bin"

[dependencies]
core = { path = "../kf_st_core" }
stlib = { path = "../kf_st_lib" }
""").unwrap()
    File.write(Dir.scratch_path("kf_st_app/src/main.kf"), app_src).unwrap()
}

/// The supertrait's name is asserted, not just an error count.
fun compile_supertrait_app(app_src: str): int32 {
    write_supertrait_fixtures(app_src)
    var errors = Diagnostics.new()
    val _outputs = compile_project_separate(Dir.scratch_path("kf_st_app"), errors)
    return errors.error_count()
}

@test fun an_imported_trait_still_requires_its_supertrait(): void {
    var src = String.from("import stlib.*\n\n")
    src.append("struct Point { var x: int32 }\n\n")
    src.append("impl Ord2 for Point { fun ord2(other: Point): int32 { return 0 } }\n\n")
    src.append("fun main(): int32 { return 0 }\n")
    val errors = compile_supertrait_app(src)
    assert_eq(errors > 0, true, "Ord2 imported from another crate still requires Eq2")
}

@test fun an_imported_trait_is_satisfied_by_both_impls(): void {
    var src = String.from("import stlib.*\n\n")
    src.append("struct Point { var x: int32 }\n\n")
    src.append("impl Ord2 for Point { fun ord2(other: Point): int32 { return 0 } }\n")
    src.append("impl Eq2 for Point { fun eq2(other: Point): bool { return self.x == other.x } }\n\n")
    src.append("fun main(): int32 { return 0 }\n")
    val errors = compile_supertrait_app(src)
    assert_eq(errors, 0, "both impls present across the boundary compiles clean")
}
