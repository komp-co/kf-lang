// Emitted C linked against the real runtime and run; the harness is in
// codegen_link_harness_test.

import core.assert.*
import alloc.list.*
import std.fs.scratch_path

import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.expression.*
import kf_core.ast.declaration.*
import kf_core.ast.statement.*
import kf_core.intern.*
import kf_codegen.empty_main
import kf_codegen.emit_module
import testing.test

fun ty_ptr(s: str): Ptr<TypeRef> {
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    val tr = TypeRef.new(Span.none(), TypeRefKind.Named(intern(s), List.new<TypeRef>()))
    unsafe { *rp = tr }
    return rp
}

pub fun expr_ptr(e: Expr): Ptr<Expr> {
    val ep: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *ep = e }
    return ep
}

pub fun var_p(name: str): Ptr<Expr> {
    return expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern(name))))
}

pub fun lit_i(n: int64): Expr {
    return Expr.new(Span.none(), ExprKind.LitInt(n))
}

fun enum_ty_t(name: str): Type {
    return Type { kind: TypeKind.EnumTy(intern(name)), provenance: Provenance.Inferred(Span.none()) }
}

fun enum_expr(kind: ExprKind, ename: str): Expr {
    var e = Expr.new(Span.none(), kind)
    e.ty = enum_ty_t(ename)
    return e
}

fun arm_ret(variant: str, n: int64): SwitchArm {
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.Return(ret_op(expr_ptr(lit_i(n))))))
    return SwitchArm.new(Span.none(), SwitchTag.Variant(String.from(variant)), List.new<Sym>(), null, body)
}

fun ret_op(p: Ptr<Expr>): Box<Expr>? {
    return p
}

@test fun integration_empty_main_exit_zero(): void {
    val out = empty_main()
    write_scratch(scratch_path("kf_codegen_link/komp_int_1.c"), out.as_str())
    val gcc_rc = gcc_link(scratch_path("kf_codegen_link/komp_int_1.c"), scratch_path("kf_codegen_link/komp_int_1"), false)
    assert_eq(gcc_rc == 0, true, "gcc accepts empty-main output")
    val run_rc = run_program(scratch_path("kf_codegen_link/komp_int_1"))
    assert_eq(run_rc == 0, true, "empty main exits 0")
}

// fun main(): i32 { val x: i32 = 1; val y: i32 = 2; return x + y; }
// → gcc → run → exit 3
// fun main(): void { runtime_print("prefix"); var n: i32 = 0; while n < 3 { runtime_println("tick"); n = n + 1 } }
// → prints a prefix followed by tick three times, exit 0
@test fun integration_runtime_output_newline_contract(): void {
    val n0 = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(0)))
    val let_n = Stmt.new(Span.none(), StmtKind.LetVar(intern("n"), ty_ptr("int32"), n0))
    val nv = expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern("n"))))
    val three = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(3)))
    val cond = Expr.new(Span.none(), ExprKind.Binary(nv, BinOp.Lt, three))
    var pa = List.new<Expr>()
    var print_arg = Expr.new(Span.none(), ExprKind.LitStr(String.from("tick")))
    print_arg.coerce = Coercion.ToCStr
    pa.push(print_arg)
    val pcall = Expr.new(Span.none(), ExprKind.Call(intern("runtime_println"), pa))
    val pstmt = Stmt.new(Span.none(), StmtKind.Expression(expr_ptr(pcall)))
    var prefix_args = List.new<Expr>()
    var prefix_arg = Expr.new(Span.none(), ExprKind.LitStr(String.from("prefix")))
    prefix_arg.coerce = Coercion.ToCStr
    prefix_args.push(prefix_arg)
    val prefix_call = Expr.new(Span.none(), ExprKind.Call(intern("runtime_print"), prefix_args))
    val prefix_stmt = Stmt.new(Span.none(), StmtKind.Expression(expr_ptr(prefix_call)))
    val nv_body = expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern("n"))))
    val one = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(1)))
    val plus = expr_ptr(Expr.new(Span.none(), ExprKind.Binary(nv_body, BinOp.Add, one)))
    val assign = Stmt.new(Span.none(), StmtKind.Assign(intern("n"), plus))
    var body = List.new<Stmt>()
    body.push(pstmt)
    body.push(assign)
    val whl = Stmt.new(Span.none(), StmtKind.While(expr_ptr(cond), body))

    var stmts = List.new<Stmt>()
    stmts.push(prefix_stmt)
    stmts.push(let_n)
    stmts.push(whl)

    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("void"), stmts, true, false, false, false)
    val main_td = TopDecl.new(Span.none(), String.from("main"), fkind)
    var decls = List.new<TopDecl>()
    decls.push(main_td)
    val m = Module { crate: CrateId.new_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_loop_print.c"), out.as_str())
    val gcc_rc = gcc_link(scratch_path("kf_codegen_link/komp_loop_print.c"), scratch_path("kf_codegen_link/komp_loop_print"), false)
    assert_eq(gcc_rc == 0, true, "gcc accepts loop+println program")
    val rc = run_program_to_file(scratch_path("kf_codegen_link/komp_loop_print"), scratch_path("kf_codegen_link/komp_loop_print.out"), false)
    assert_eq(rc == 0, true, "loop exits 0")
    val contents = read_file(scratch_path("kf_codegen_link/komp_loop_print.out"))
    assert_eq(contents.as_str(), "prefixtick\ntick\ntick\n", "print omits and println appends a newline")
}

// fun main(): i32 { var n: i32 = 0; while n < 3 { n = n + 1 } return n }
// → exits 3
@test fun integration_while_counts_to_three(): void {
    val n0 = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(0)))
    val let_n = Stmt.new(Span.none(), StmtKind.LetVar(intern("n"), ty_ptr("int32"), n0))
    // cond: n < 3
    val nv = expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern("n"))))
    val three = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(3)))
    val cond = Expr.new(Span.none(), ExprKind.Binary(nv, BinOp.Lt, three))
    // body: n = n + 1
    val nv_body = expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern("n"))))
    val one = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(1)))
    val plus = expr_ptr(Expr.new(Span.none(), ExprKind.Binary(nv_body, BinOp.Add, one)))
    val assign = Stmt.new(Span.none(), StmtKind.Assign(intern("n"), plus))
    var body = List.new<Stmt>()
    body.push(assign)
    val whl = Stmt.new(Span.none(), StmtKind.While(expr_ptr(cond), body))
    // return n
    val nv_ret = expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern("n"))))
    val ret = Stmt.new(Span.none(), StmtKind.Return(ret_op(nv_ret)))

    var stmts = List.new<Stmt>()
    stmts.push(let_n)
    stmts.push(whl)
    stmts.push(ret)

    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("int32"), stmts, true, false, false, false)
    val main_td = TopDecl.new(Span.none(), String.from("main"), fkind)
    var decls = List.new<TopDecl>()
    decls.push(main_td)
    val m = Module { crate: CrateId.new_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_while.c"), out.as_str())
    val gcc_rc = gcc_link(scratch_path("kf_codegen_link/komp_while.c"), scratch_path("kf_codegen_link/komp_while"), false)
    assert_eq(gcc_rc == 0, true, "gcc accepts while program")
    val run_rc = run_program(scratch_path("kf_codegen_link/komp_while"))
    assert_eq(run_rc == 3, true, "while loop exits 3")
}

// fun main(): void { val s = __kf_v2_str_from_cstr("hi"); runtime_println(s); release(s) }
// → gcc -fsanitize=address → "hi\n", exit 0
@test fun integration_string_println_asan_clean(): void {
    // The runtime constructor directly; String.from is covered elsewhere.
    var init_args = List.new<Expr>()
    init_args.push(Expr.new(Span.none(), ExprKind.LitStr(String.from("hi"))))
    var init = Expr.new(Span.none(), ExprKind.Call(intern("__kf_v2_str_from_cstr"), init_args))
    init.ty = Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(Span.none()) }
    val let_s = Stmt.new(Span.none(), StmtKind.LetVal(intern("s"), ty_ptr("String"), expr_ptr(init)))

    // runtime_println(s.as_str())
    var pargs = List.new<Expr>()
    var print_recv = Expr.new(Span.none(), ExprKind.Variable(intern("s")))
    print_recv.ty = Type { kind: TypeKind.Struct(intern("String")), provenance: Provenance.Inferred(Span.none()) }
    val print_arg = Expr.new(Span.none(), ExprKind.MethodCall(expr_ptr(print_recv), intern("as_str"), List.new<Expr>()))
    pargs.push(print_arg)
    val pcall = Expr.new(Span.none(), ExprKind.Call(intern("runtime_println"), pargs))
    val pstmt = Stmt.new(Span.none(), StmtKind.Expression(expr_ptr(pcall)))

    // Release(s)
    val rel = Stmt.new(Span.none(), StmtKind.Release(intern("s")))

    var stmts = List.new<Stmt>()
    stmts.push(let_s)
    stmts.push(pstmt)
    stmts.push(rel)

    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("void"), stmts, true, false, false, false)
    val main_td = TopDecl.new(Span.none(), String.from("main"), fkind)
    var decls = List.new<TopDecl>()
    decls.push(main_td)
    val m = Module { crate: CrateId.new_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_int_3.c"), out.as_str())

    val gcc_rc = gcc_link(scratch_path("kf_codegen_link/komp_int_3.c"), scratch_path("kf_codegen_link/komp_int_3"), true)
    assert_eq(gcc_rc == 0, true, "gcc asan accepts the program")

    val run_rc = run_program_to_file(scratch_path("kf_codegen_link/komp_int_3"), scratch_path("kf_codegen_link/komp_int_3.out"), true)
    assert_eq(run_rc == 0, true, "asan binary exits 0")

    val contents = read_file(scratch_path("kf_codegen_link/komp_int_3.out"))
    assert_eq(contents.as_str(), "hi\n", "stdout is 'hi'")
}

// struct Point { x: i32; y: i32 }
// fun main(): i32 { val p = Point { x: 7, y: 5 }; return p.x - p.y }
// → exit 2
@test fun integration_struct_lit_and_field_access(): void {
    // struct Point { x: i32; y: i32 }
    var fields = List.new<Field>()
    fields.push(Field.new(Span.none(), String.from("x"), ty_ptr("int32"), false, true))
    fields.push(Field.new(Span.none(), String.from("y"), ty_ptr("int32"), false, true))
    val point_td = TopDecl.new(Span.none(), String.from("Point"), TopDeclKind.Struct(fields, true))

    // val p = Point { x: 7, y: 5 }
    val x_init = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(7)))
    val y_init = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(5)))
    var finits = List.new<FieldInit>()
    finits.push(FieldInit.new(Span.none(), String.from("x"), x_init))
    finits.push(FieldInit.new(Span.none(), String.from("y"), y_init))
    val lit = Expr.new(Span.none(), ExprKind.StructLit(intern("Point"), finits))
    val let_p = Stmt.new(Span.none(), StmtKind.LetVal(intern("p"), null, expr_ptr(lit)))

    // return p.x - p.y
    val pv1 = expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern("p"))))
    val px = Expr.new(Span.none(), ExprKind.FieldAccess(pv1, intern("x")))
    val pv2 = expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern("p"))))
    val py = Expr.new(Span.none(), ExprKind.FieldAccess(pv2, intern("y")))
    val diff = Expr.new(Span.none(), ExprKind.Binary(expr_ptr(px), BinOp.Sub, expr_ptr(py)))
    val ret = Stmt.new(Span.none(), StmtKind.Return(ret_op(expr_ptr(diff))))

    var stmts = List.new<Stmt>()
    stmts.push(let_p)
    stmts.push(ret)

    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("int32"), stmts, true, false, false, false)
    val main_td = TopDecl.new(Span.none(), String.from("main"), fkind)
    var decls = List.new<TopDecl>()
    decls.push(point_td)
    decls.push(main_td)
    val m = Module { crate: CrateId.new_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_struct.c"), out.as_str())
    val gcc_rc = gcc_link(scratch_path("kf_codegen_link/komp_struct.c"), scratch_path("kf_codegen_link/komp_struct"), false)
    assert_eq(gcc_rc == 0, true, "gcc accepts struct program")
    val rc = run_program(scratch_path("kf_codegen_link/komp_struct"))
    assert_eq(rc == 2, true, "7 - 5 returns 2")
}

@test fun integration_add_returns_three(): void {
    // val x: i32 = 1
    val let_x_init = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(1)))
    val let_x = Stmt.new(Span.none(), StmtKind.LetVal(intern("x"), ty_ptr("int32"), let_x_init))
    // val y: i32 = 2
    val let_y_init = expr_ptr(Expr.new(Span.none(), ExprKind.LitInt(2)))
    val let_y = Stmt.new(Span.none(), StmtKind.LetVal(intern("y"), ty_ptr("int32"), let_y_init))
    // return x + y
    val xv = expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern("x"))))
    val yv = expr_ptr(Expr.new(Span.none(), ExprKind.Variable(intern("y"))))
    val sum = Expr.new(Span.none(), ExprKind.Binary(xv, BinOp.Add, yv))
    val ret = Stmt.new(Span.none(), StmtKind.Return(ret_op(expr_ptr(sum))))

    var stmts = List.new<Stmt>()
    stmts.push(let_x)
    stmts.push(let_y)
    stmts.push(ret)

    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("int32"), stmts, true, false, false, false)
    val main_td = TopDecl.new(Span.none(), String.from("main"), fkind)
    var decls = List.new<TopDecl>()
    decls.push(main_td)
    val m = Module { crate: CrateId.new_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_int_2.c"), out.as_str())

    val gcc_rc = gcc_link(scratch_path("kf_codegen_link/komp_int_2.c"), scratch_path("kf_codegen_link/komp_int_2"), false)
    assert_eq(gcc_rc == 0, true, "gcc accepts add program")

    val run_rc = run_program(scratch_path("kf_codegen_link/komp_int_2"))
    assert_eq(run_rc == 3, true, "1 + 2 returns 3")
}

@test fun integration_enum_when_and_construct(): void {
    // enum Color { Red, Green, Blue }
    var variants = List.new<Variant>()
    variants.push(Variant.new(Span.none(), String.from("Red"), List.new<TypeRef>()))
    variants.push(Variant.new(Span.none(), String.from("Green"), List.new<TypeRef>()))
    variants.push(Variant.new(Span.none(), String.from("Blue"), List.new<TypeRef>()))
    val color_td = TopDecl.new(Span.none(), String.from("Color"), TopDeclKind.EnumDecl(variants, true))

    // val c: Color = Color.Green
    val ctor = enum_expr(ExprKind.FieldAccess(var_p("Color"), intern("Green")), "Color")
    val let_c = Stmt.new(Span.none(), StmtKind.LetVal(intern("c"), ty_ptr("Color"), expr_ptr(ctor)))

    // when (c) { Red => return 1; Green => return 2; Blue => return 3 }
    val subj = enum_expr(ExprKind.Variable(intern("c")), "Color")
    var arms = List.new<SwitchArm>()
    arms.push(arm_ret("Red", 1))
    arms.push(arm_ret("Green", 2))
    arms.push(arm_ret("Blue", 3))
    val sw = Stmt.new(Span.none(), StmtKind.Switch(expr_ptr(subj), arms))

    var stmts = List.new<Stmt>()
    stmts.push(let_c)
    stmts.push(sw)
    stmts.push(Stmt.new(Span.none(), StmtKind.Return(ret_op(expr_ptr(lit_i(0))))))
    val fkind = TopDeclKind.Function(List.new<Param>(), ty_ptr("int32"), stmts, true, false, false, false)
    val main_td = TopDecl.new(Span.none(), String.from("main"), fkind)
    var decls = List.new<TopDecl>()
    decls.push(color_td)
    decls.push(main_td)
    val m = Module { crate: CrateId.new_poison(), path: List.new<String>(), decls: decls, imports: List.new<Import>() }

    val out = emit_module(&m)
    write_scratch(scratch_path("kf_codegen_link/komp_enum_when.c"), out.as_str())
    val rc = gcc_link(scratch_path("kf_codegen_link/komp_enum_when.c"), scratch_path("kf_codegen_link/komp_enum_when"), false)
    assert_eq(rc == 0, true, "enum when+construct gcc-compiles")
    val run_rc = run_program(scratch_path("kf_codegen_link/komp_enum_when"))
    assert_eq(run_rc == 2, true, "Color.Green matches Green arm → 2")
}
