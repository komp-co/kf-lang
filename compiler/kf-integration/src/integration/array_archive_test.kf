// Arrays cross a crate boundary: a public struct holding one, a function
// generic over the length, and one returning an array, built and inferred
// in the consumer. Needs two crates, so not a tests/cases file.

import core.assert.assert_eq

import kf_integration.harness.komp_build
import testing.test

extern "C" fun system(cmd: str): int32

fun prepare_array_fixture(app_main: str): int32 {
    val dep = Dir.scratch_path("kf_array_dep")
    val app = Dir.scratch_path("kf_array_app")
    val prep = unsafe { system("rm -rf ${dep} ${app} && mkdir -p ${dep}/src ${app}/src") }
    if prep != 0 { return prep }
    File.write("${dep}/kf.toml".as_str(), "[project]\nname = \"array_dep\"\nkind = \"lib\"\n").unwrap()
    File.write("${dep}/src/lib.kf".as_str(), """pub struct Rgb {
    pub val channels: uint8[3]
}

pub fun brightest(c: &Rgb): uint8 {
    var best: uint8 = 0
    while x in &c.channels {
        if x > best { best = x }
    }
    return best
}

pub fun total<N: uint64>(xs: &int32[N]): int32 {
    var sum = 0
    while x in xs { sum = sum + x }
    return sum
}

pub fun corners(): int32[4] {
    return [1, 2, 3, 4]
}
""").unwrap()
    File.write("${app}/kf.toml".as_str(), """[project]
name = "array_app"
kind = "bin"

[dependencies]
array_dep = { path = "../kf_array_dep" }
""").unwrap()
    File.write("${app}/src/main.kf".as_str(), app_main).unwrap()
    return 0
}

@test
fun an_array_crosses_a_crate(): void {
    val main = """import array_dep.*

fun main(): int32 {
    val c = Rgb { channels: [10, 200, 30] }
    val five: int32[5] = [1, 1, 1, 1, 1]
    if brightest(&c) == 200 && total(&corners()) == 10 && total(&five) == 5 { return 0 }
    return 1
}
"""
    val prep = prepare_array_fixture(main)
    val built = komp_build(Dir.scratch_path("kf_array_app"), "")
    val ran = unsafe { system(Dir.scratch_path("kf_array_app/target/kflat/array_app").as_str()) }
    assert_eq(prep == 0 && built == 0 && ran == 0, true, "a field, a length-generic function and a returned array")
}

@test
fun an_array_literal_is_checked_against_another_crate(): void {
    val main = """import array_dep.*

fun main(): int32 {
    val c = Rgb { channels: [10, 200] }
    return 0
}
"""
    val prep = prepare_array_fixture(main)
    val built = komp_build(Dir.scratch_path("kf_array_app"), "")
    assert_eq(prep == 0 && built != 0, true, "two elements cannot fill the dependency's `uint8[3]`")
}
