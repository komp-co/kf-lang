// What the checker says about a top-level `val`, and a `pub val` used from
// another crate through its interface.

import core.assert.assert_eq
import alloc.path.Path

import kf_core.diagnostic.new_diagnostics
import kf_driver.fresh_source_map
import kf_driver.new_lint_config
import kf_driver.checked_diagnostics
import kf_integration.harness.komp_build
import std.fs.create_dir_all
import std.fs.remove_dir_all
import std.fs.scratch_path
import std.fs.write_text
import kf_integration.harness.assemble_project
import testing.test

extern "C" fun system(cmd: str): int32

/// Whether checking `source` as a one-file crate reports `needle`.
fun constant_reports(source: str, needle: str): bool {
    val dir = scratch_path("kf_constant_probe")
    val _cleared = remove_dir_all(dir)
    val _made = create_dir_all(Path.new("${dir}/src".as_str()))
    val _manifest = write_text("${dir}/kf.toml".as_str(), "[project]\nname = \"constant_probe\"\nkind = \"lib\"\n")
    val _source = write_text("${dir}/src/lib.kf".as_str(), source)
    val smap = fresh_source_map()
    var pdiags = new_diagnostics()
    var merged = assemble_project(dir, smap, &var pdiags)
    val checked = merged.checked_diagnostics(smap, &new_lint_config())
    while d in &checked {
        if d.primary.message.as_str().contains(needle) { return true }
    }
    return false
}

@test
fun a_computed_top_level_val_is_rejected(): void {
    val said = constant_reports("""fun three(): int32 { return 3 }
pub val THREE: int32 = three()
""", "a top-level `val` holds a literal")
    assert_eq(said, true, "nothing runs to compute a top-level value")
}

@test
fun a_top_level_val_of_the_wrong_type_names_both_types(): void {
    val said = constant_reports("pub val LIMIT: int32 = \"nine\"\n",
        "this value is `str`, but its declared type is `int32`")
    assert_eq(said, true, "the literal is checked against the written type")
}

@test
fun calling_a_top_level_val_is_rejected(): void {
    val said = constant_reports("""val LIMIT: int32 = 9
pub fun f(): int32 { return LIMIT() }
""", "`LIMIT` is a top-level `val`, not a function")
    assert_eq(said, true, "a call would link against a function nobody emits")
}

@test
fun assigning_a_top_level_val_says_what_it_is(): void {
    val said = constant_reports("""val LIMIT: int32 = 9
pub fun f(): void { LIMIT = 4 }
""", "cannot assign to `LIMIT`: it is a top-level `val`")
    assert_eq(said, true, "the name is declared, so `not declared` would mislead")
}

/// `vallib` holds a `pub val` and a private one its public generic uses;
/// `valapp` exits 0 when every value arrives.
fun prepare_constant_crates(): int32 {
    val core = scratch_path("kf_val_core")
    val lib = scratch_path("kf_val_lib")
    val app = scratch_path("kf_val_app")
    val dirs = "${core}/src ${core}/native ${lib}/src ${app}/src"
    val natives = "libs/core/native/core.c libs/core/native/core_hosted.c"
    val sources = "cp -R libs/core/src/. ${core}/src/ && cp ${natives} ${core}/native/"
    val prep = unsafe { system("rm -rf ${core} ${lib} ${app} && mkdir -p ${dirs} && ${sources}") }
    if prep != 0 { return prep }
    write_file("${core}/kf.toml".as_str(), """[project]
name = "core"
kind = "lib"

[native]
c_sources = ["native/core.c"]
hosted_c_sources = ["native/core_hosted.c"]
""")
    write_file("${lib}/kf.toml".as_str(), """[project]
name = "vallib"
kind = "lib"

[dependencies]
core = { path = "../kf_val_core" }
""")
    write_file("${lib}/src/api.kf".as_str(), """pub val PRIMES: int32[] = [2, 3, 5]
pub val NAME: str = "lib"
val HIDDEN: int32 = 7

pub fun hidden_of<T>(_x: T): int32 {
    return HIDDEN
}
""")
    write_file("${app}/kf.toml".as_str(), """[project]
name = "valapp"
kind = "bin"

[dependencies]
core = { path = "../kf_val_core" }
vallib = { path = "../kf_val_lib" }
""")
    write_file("${app}/src/main.kf".as_str(), """import vallib.api.*

fun main(): int32 {
    if PRIMES[2] != 5 { return 1 }
    if NAME.byte_len() != 3 { return 2 }
    if hidden_of(true) != 7 { return 3 }
    return 0
}
""")
    return 0
}

@test
fun a_pub_val_reaches_another_crate_with_what_its_generics_use(): void {
    val prepared = prepare_constant_crates()
    val built = komp_build(scratch_path("kf_val_app"), "")
    val ran = unsafe { system(scratch_path("kf_val_app/target/kflat/valapp")) }
    assert_eq(prepared == 0 && built == 0 && ran == 0, true, "the values travel in the interface")
}
