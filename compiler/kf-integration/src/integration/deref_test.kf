// `Deref` and `DerefMut`: a receiver without the method, and an argument in
// its target's slot, lend themselves through the impl. Built against a core
// that declares the two traits.

import core.assert.assert_eq

import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

val DEREF_TRAITS: str = """@lang("deref")
pub trait Deref {
    type Target
    fun deref(): Self.Target
}

@lang("deref_mut")
pub trait DerefMut {
    type TargetMut
    mutating fun deref_mut(): Self.TargetMut
}
"""

/// A `Counter`, a `Holder` lending it shared and mutably, and an `Outer`
/// lending the `Holder`; `body` is `main`'s.
val DEREF_TYPES: str = """struct Counter {
    var hits: int32
}

impl Counter {
    fun total(): int32 { return self.hits }
    fun label(): int32 { return 1 }
    mutating fun bump(): void { self.hits = self.hits + 1 }
}

fun Counter.doubled(): int32 { return self.hits * 2 }

struct Holder {
    var inner: Counter
}

impl Holder {
    fun label(): int32 { return 2 }
}

impl Deref for Holder {
    type Target = &Counter
    fun deref(): &Counter { return &self.inner }
}

impl DerefMut for Holder {
    type TargetMut = &var Counter
    mutating fun deref_mut(): &var Counter { return &var self.inner }
}

trait Ranked {
    fun rank(): int32
}

impl Ranked for Counter {
    fun rank(): int32 { return 1 }
}

impl Ranked for Holder {
    fun rank(): int32 { return 2 }
}

struct Outer {
    val holder: Holder
}

impl Deref for Outer {
    type Target = &Holder
    fun deref(): &Holder { return &self.holder }
}

fun read(c: &Counter): int32 { return c.total() }

fun bump(c: &var Counter): void { c.bump() }

"""

/// Builds `main`, then runs it: its exit code, or -1 when it does not build.
fun run_through_deref(main: str): int32 {
    val core = scratch_path("kf_deref_core")
    val app = scratch_path("kf_deref_app")
    val natives = "libs/core/native/core.c libs/core/native/core_hosted.c"
    val sources = "cp -R libs/core/src/. ${core}/src/ && cp ${natives} ${core}/native/"
    val dirs = "${core}/src ${core}/native ${app}/src"
    val prep = unsafe { system("rm -rf ${core} ${app} && mkdir -p ${dirs} && ${sources}") }
    if prep != 0 { return 0 - 1 }
    write_file("${core}/src/deref.kf".as_str(), DEREF_TRAITS)
    write_file("${core}/kf.toml".as_str(), """[project]
name = "core"
kind = "lib"

[native]
c_sources = ["native/core.c"]
hosted_c_sources = ["native/core_hosted.c"]
""")
    write_file("${app}/kf.toml".as_str(), """[project]
name = "deref_app"
kind = "bin"

[dependencies]
core = { path = "../kf_deref_core" }
""")
    write_file("${app}/src/main.kf".as_str(), "${DEREF_TYPES}fun main(): int32 {\n${main}\n}\n".as_str())
    if build_project_separate(app, "") != 0 { return 0 - 1 }
    return unsafe { system(scratch_path("kf_deref_app/target/kflat/deref_app")) } / 256
}

@test
fun deref_lends_a_method_the_receiver_lacks(): void {
    val code = run_through_deref("    val h = Holder { inner: Counter { hits: 5 } }\n    return h.total()")
    assert_eq(code, 5, "`total` is Counter's, reached through `deref`")
}

@test
fun deref_reaches_an_extension_on_the_target(): void {
    val code = run_through_deref("    val h = Holder { inner: Counter { hits: 5 } }\n    return h.doubled()")
    assert_eq(code, 10, "the target's extensions count as its methods")
}

@test
fun deref_leaves_the_receivers_own_method_first(): void {
    val code = run_through_deref("    val h = Holder { inner: Counter { hits: 5 } }\n    return h.label()")
    assert_eq(code, 2, "Holder's `label`, not Counter's")
}

@test
fun deref_mut_serves_a_mutating_method(): void {
    val code = run_through_deref("""    var h = Holder { inner: Counter { hits: 5 } }
    h.bump()
    return h.total()""")
    assert_eq(code, 6, "`bump` changes the Holder's own Counter")
}

@test
fun deref_mut_needs_a_writable_receiver(): void {
    val code = run_through_deref("    val h = Holder { inner: Counter { hits: 5 } }\n    h.bump()\n    return 0")
    assert_eq(code, 0 - 1, "`deref_mut` needs a writable receiver")
}

@test
fun deref_follows_the_chain(): void {
    val code = run_through_deref("""    val o = Outer { holder: Holder { inner: Counter { hits: 7 } } }
    return o.total()""")
    assert_eq(code, 7, "Outer to Holder to Counter")
}

@test
fun deref_lends_an_argument_its_target(): void {
    val code = run_through_deref("    val h = Holder { inner: Counter { hits: 3 } }\n    return read(&h)")
    assert_eq(code, 3, "`&Holder` fills a `&Counter` slot")
}

@test
fun deref_mut_lends_a_mutable_argument(): void {
    val code = run_through_deref("""    var h = Holder { inner: Counter { hits: 3 } }
    bump(&var h)
    return h.total()""")
    assert_eq(code, 4, "`&var Holder` fills a `&var Counter` slot")
}

@test
fun deref_leaves_a_trait_method_of_the_receiver_first(): void {
    val code = run_through_deref("    val h = Holder { inner: Counter { hits: 5 } }\n    return h.rank()")
    assert_eq(code, 2, "Holder's `Ranked` impl, not Counter's")
}

@test
fun deref_leaves_clone_to_the_receiver(): void {
    val code = run_through_deref("    val h = Holder { inner: Counter { hits: 5 } }\n    return h.clone().inner.hits")
    assert_eq(code, 5, "a Holder clones as a Holder")
}
