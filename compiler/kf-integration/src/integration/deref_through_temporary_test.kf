import core.assert.assert_eq
import alloc.list.*
import testing.test

fun temporary_messages(name: str, body: str): List<String> {
    return extension_messages(name, """struct Node { pub var label: String }
struct Holder { pub var node: Box<Node> }
fun make(): Holder { return Holder { node: Box.new(Node { label: String.from("x") }) } }
fun make_box(): Box<Node> { return Box.new(Node { label: String.from("y") }) }
fun peek(h: &Holder): &Holder { return h }
${body}
""")
}

@test
fun a_deref_through_a_temporary_holder_is_reported(): void {
    val messages = temporary_messages("kf_tmp_field",
        "fun probe(): String { val n = unsafe { *make().node }\n return n.label }")
    assert_eq(says(&messages, "reads through a `Box` owned by a temporary"), true,
        "the holder dies at the end of the statement")
}

@test
fun a_deref_of_a_returned_box_is_reported(): void {
    val messages = temporary_messages("kf_tmp_box",
        "fun probe(): String { val n = unsafe { *make_box() }\n return n.label }")
    assert_eq(says(&messages, "reads through a `Box` owned by a temporary"), true,
        "the box itself is the temporary")
}

@test
fun a_deref_through_a_bound_holder_is_not(): void {
    val messages = temporary_messages("kf_tmp_bound",
        "fun probe(): String { val h = make()\n val n = unsafe { *h.node }\n return n.label.clone() }")
    assert_eq(says(&messages, "owned by a temporary"), false, "a local outlives the statement")
}

@test
fun a_deref_through_a_returned_borrow_is_not(): void {
    val messages = temporary_messages("kf_tmp_borrow",
        "fun probe(h: &Holder): String { val n = unsafe { *peek(h).node }\n return n.label.clone() }")
    assert_eq(says(&messages, "owned by a temporary"), false, "a borrow result owns nothing")
}
