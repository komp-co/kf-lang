// A view type crosses a crate boundary as a borrow, read from the
// interface alone too. Needs two crates, so not a tests/cases file.

import core.assert.assert_eq

import kf_tool.build.build_project_separate
import std.fs.scratch_path
import testing.test

extern "C" fun system(cmd: str): int32

fun prepare_view_fixture(app_main: str): int32 {
    val dep = scratch_path("kf_view_dep")
    val app = scratch_path("kf_view_app")
    val prep = unsafe { system("rm -rf ${dep} ${app} && mkdir -p ${dep}/src ${app}/src") }
    if prep != 0 { return prep }
    write_file("${dep}/kf.toml".as_str(), "[project]\nname = \"view_dep\"\nkind = \"lib\"\n")
    write_file("${dep}/src/lib.kf".as_str(), """pub view struct Window {
    pub val text: str
}

pub struct Text {
    pub var bytes: String
}

impl Text {
    pub fun window(): Window { return Window { text: self.bytes.as_str() } }
    pub mutating fun grow(): void { self.bytes.append("!") }
}
""")
    write_file("${app}/kf.toml".as_str(), """[project]
name = "view_app"
kind = "bin"

[dependencies]
view_dep = { path = "../kf_view_dep" }
""")
    write_file("${app}/src/main.kf".as_str(), app_main)
    return 0
}

fun reading_main(): str {
    return """import view_dep.*

fun main(): int32 {
    val text = Text { bytes: String.from("abc") }
    val w = text.window()
    if w.text.byte_len() == 3 { return 0 }
    return 1
}
"""
}

fun storing_main(): str {
    return """import view_dep.*

struct Holder {
    val window: Window
}

fun main(): int32 { return 0 }
"""
}

fun freezing_main(): str {
    return """import view_dep.*

fun main(): int32 {
    var text = Text { bytes: String.from("abc") }
    val w = text.window()
    text.grow()
    return w.text.byte_len() as int32
}
"""
}

@test
fun another_crate_reads_through_a_view(): void {
    val prep = prepare_view_fixture(reading_main())
    val built = build_project_separate(scratch_path("kf_view_app"), "")
    val ran = unsafe { system(scratch_path("kf_view_app/target/kflat/view_app").as_str()) }
    assert_eq(prep == 0 && built == 0 && ran == 0, true, "the view and its method cross")
}

@test
fun another_crate_cannot_store_a_view(): void {
    val prep = prepare_view_fixture(storing_main())
    val built = build_project_separate(scratch_path("kf_view_app"), "")
    assert_eq(prep == 0 && built != 0, true, "the field is rejected in the consumer")
}

@test
fun a_view_from_another_crate_freezes_its_origin(): void {
    val prep = prepare_view_fixture(freezing_main())
    val built = build_project_separate(scratch_path("kf_view_app"), "")
    assert_eq(prep == 0 && built != 0, true, "the consumer's change is rejected while the view is used")
}

@test
fun a_view_is_read_back_from_the_interface(): void {
    val prep = prepare_view_fixture(reading_main())
    val first = build_project_separate(scratch_path("kf_view_app"), "")
    write_file(scratch_path("kf_view_app/src/main.kf"), storing_main())
    val source = scratch_path("kf_view_dep/src")
    val hidden = unsafe { system("mv ${source} ${source}.hidden") }
    val rebuilt = build_project_separate(scratch_path("kf_view_app"), "")
    val restored = unsafe { system("mv ${source}.hidden ${source}") }
    assert_eq(prep == 0 && first == 0 && hidden == 0 && rebuilt != 0 && restored == 0, true,
        "view_dep.kfi says the type is a view")
}
