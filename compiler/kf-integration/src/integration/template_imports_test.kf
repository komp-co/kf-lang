// A generic crosses the `.kfi` as source and is checked in its user's crate,
// so it must still see what its own file imports from other crates. Needs
// three crates, so not a tests/cases file.

import core.assert.assert_eq
import alloc.path.Path
import kf_tool.build.build_project_separate
import std.fs.create_dir_all
import std.fs.remove_dir_all
import std.fs.scratch_path
import std.fs.write_text

extern "C" fun system(cmd: str): int32

fun crate_dir(name: str): str {
    return scratch_path("kf_template_imports_${name}")
}

fun write_crate(name: str, kind: str, deps: str, source: str): void {
    val dir = crate_dir(name)
    val _cleared = remove_dir_all(dir)
    val _made = create_dir_all(Path.new("${dir}/src".as_str()))
    val file = if kind == "lib" { "lib.kf" } else { "main.kf" }
    val _manifest = write_text("${dir}/kf.toml".as_str(),
        "[project]\nname = \"${name}\"\nkind = \"${kind}\"\n${deps}")
    val _source = write_text("${dir}/src/${file}".as_str(), source)
}

fun depends_on(name: str): String {
    return "\n[dependencies]\n${name} = { path = \"../kf_template_imports_${name}\" }\n"
}

@test
fun a_generic_calls_what_its_file_imports_from_another_crate(): void {
    write_crate("ti_base", "lib", "", "pub fun base(): int32 { return 40 }\n")
    write_crate("ti_mid", "lib", depends_on("ti_base"), """import ti_base.base

pub fun with_base<T>(x: T): int32 { return base() + 2 }

pub struct Wrap<T> { pub val v: T }

impl Wrap<T> {
    pub fun answer(): int32 { return base() + 2 }
}
""")
    write_crate("ti_app", "bin", depends_on("ti_mid"), """import ti_mid.with_base
import ti_mid.Wrap

fun main(): int32 { return with_base<int32>(1) + Wrap { v: 1 }.answer() - 84 }
""")
    val app = crate_dir("ti_app")
    assert_eq(build_project_separate(app, ""), 0, "the generic's call resolves in the app")
    assert_eq(unsafe { system("${app}/target/kflat/ti_app") }, 0, "and runs")
}
