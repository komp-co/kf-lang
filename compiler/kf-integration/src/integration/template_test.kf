// A template in another module adds to a struct: what it adds belongs to
// the struct's module, and its names resolve in the template's own.

import core.assert.assert_eq
import testing.test

fun counted_template(): str {
    return """pub annotation counted on struct

fun doubled(n: int64): int64 { return n * 2 }

template counted on struct T {
    fun T.field_count(): int64 {
        return doubled(T.fields.size()) / 2
    }
}
"""
}

@test
fun a_template_adds_to_a_struct_of_another_module(): void {
    val main = """import app.inner.counted

@counted
struct Pair {
    val a: int32
    val b: int32
}

fun main(): int32 {
    val p = Pair { a: 1, b: 2 }
    return p.field_count() as int32 - 2
}
"""
    assert_eq(prepare_annotation_fixture("kf_template_module", main, counted_template()), 0, "fixture prepared")
    assert_eq(build_and_run_annotated("kf_template_module"), 0, "the extension is the struct module's")
}
