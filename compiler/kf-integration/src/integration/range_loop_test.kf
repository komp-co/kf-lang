// `while i in a..b` through the full pipeline.

import core.assert.assert_eq

import kf_integration.harness.compile_source
import testing.disabled
import testing.test

pub fun run(cmd: str, args: List<str>): int32 {
    var command = Command.new(cmd)
    while item in &args {
        command.arg(item)
    }
    return command.status().exit_code()
}

fun range_build_and_run(src: str, exe: str): int32 {
    val c = compile_source(src)
    File.write(Dir.scratch_path("komp_for.c"), c).unwrap()
    var gargs = List.new<str>()
    gargs.push(Dir.scratch_path("komp_for.c"))
    gargs.push("-o")
    gargs.push(exe)
    val grc = run("gcc", gargs)
    if grc != 0 {
        return 0 - 1
    }
    val rargs = List.new<str>()
    return run(exe, rargs)
}

// 0+1+2 = 3 (exclusive upper bound).
@test fun integration_range_sums_exclusive_range(): void {
    val src = "fun main(): int32 { var sum: int32 = 0\nwhile i in 0..3 { sum = sum + i }\nreturn sum }"
    val code = range_build_and_run(src, Dir.scratch_path("komp_range_sum"))
    assert_eq(code == 3, true, "while i in 0..3 sums to 3")
}

// break exits the loop early: 0+1+2 = 3, then break at i == 3.
@test fun integration_range_break(): void {
    val src = """fun main(): int32 { var sum: int32 = 0
while i in 0..10 { if i == 3 { break }
sum = sum + i }
return sum }"""
    val code = range_build_and_run(src, Dir.scratch_path("komp_range_break"))
    assert_eq(code == 3, true, "break stops the loop at i == 3")
}

// continue skips one iteration: 0+1+3+4 = 8 (i == 2 skipped).
@test fun integration_range_continue(): void {
    val src = """fun main(): int32 { var sum: int32 = 0
while i in 0..5 { if i == 2 { continue }
sum = sum + i }
return sum }"""
    val code = range_build_and_run(src, Dir.scratch_path("komp_range_continue"))
    assert_eq(code == 8, true, "continue skips i == 2")
}

// `while i in 0..xs.size()`: 10+20+12 = 42. Disabled: compile_source merges
// no stdlib, so `List` is unresolved.
@test
@disabled("compile_source merges no stdlib, so `List` is unresolved")
fun integration_range_collection_index(): void {
    val src = """fun main(): int32 { var xs = List.new<int32>()
xs.push(10)
xs.push(20)
xs.push(12)
var total: int32 = 0
while i in 0..xs.size() { total = total + xs.get(i) }
return total }"""
    val code = range_build_and_run(src, Dir.scratch_path("komp_range_coll"))
    assert_eq(code == 42, true, "indexed walk over a List sums to 42")
}
