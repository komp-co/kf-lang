// A `Copy` struct is copied on assignment, not moved: with the move lints
// denied, reading it again after `val b = a` still builds. Needs a
// lint.toml, so not a tests/cases file.

import core.assert.assert_eq

import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

fun build_with_move_lints_denied(main: str): int32 {
    val dir = scratch_path("kf_copy_struct")
    val prep = unsafe { system("rm -rf ${dir} && mkdir -p ${dir}/src") }
    if prep != 0 { return prep }
    write_file("${dir}/kf.toml".as_str(), "[project]\nname = \"copy_struct\"\nkind = \"bin\"\n")
    write_file("${dir}/lint.toml".as_str(), "[lints]\ncopy_after_move = \"deny\"\nimplicit_copy = \"deny\"\n")
    write_file("${dir}/src/main.kf".as_str(), main)
    return build_project_separate(dir, "")
}

@test
fun a_copy_struct_is_copied_not_moved(): void {
    val main = """@derive(Copy)
struct Plain {
    val x: int32
}

fun main(): int32 {
    val a = Plain { x: 1 }
    val b = a
    return a.x + b.x
}
"""
    assert_eq(build_with_move_lints_denied(main), 0, "no move to undo, so nothing to report")
}

@test
fun a_struct_without_copy_still_moves(): void {
    val main = """struct Plain {
    val x: int32
}

fun main(): int32 {
    val a = Plain { x: 1 }
    val b = a
    return a.x + b.x
}
"""
    assert_eq(build_with_move_lints_denied(main) != 0, true, "reading `a` after the move is still reported")
}
