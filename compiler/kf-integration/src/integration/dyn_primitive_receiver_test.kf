// A `&dyn Trait` over a primitive receiver across a crate boundary: the
// coercion and the vtable definition must spell the receiver by type identity
// (`int32`), not C type (`int32_t`). Only a separate core crate reaches this.

import core.assert.assert_eq
import kf_integration.harness.komp_build
import std.fs.scratch_path
import testing.test

extern "C" fun system(cmd: str): int32

fun prepare_dyn_primitive_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_dyn_prim_core")} ${scratch_path("kf_dyn_prim_app")} && mkdir -p ${scratch_path("kf_dyn_prim_core/src")} ${scratch_path("kf_dyn_prim_core/native")} ${scratch_path("kf_dyn_prim_app/src")} && cp -R libs/core/src/. ${scratch_path("kf_dyn_prim_core/src/")}") }
    if prep != 0 { return prep }
    write_file(scratch_path("kf_dyn_prim_core/kf.toml"), """[project]
name = "core"
kind = "lib"

[native]
c_sources = ["native/core.c"]
hosted_c_sources = ["native/core_hosted.c"]
""")
    write_file(scratch_path("kf_dyn_prim_core/native/core.c"), read_file("libs/core/native/core.c").as_str())
    write_file(scratch_path("kf_dyn_prim_core/native/core_hosted.c"), read_file("libs/core/native/core_hosted.c").as_str())
    write_file(scratch_path("kf_dyn_prim_app/kf.toml"), """[project]
name = "dyn_prim_app"
kind = "bin"

[dependencies]
core = { path = "../kf_dyn_prim_core" }
""")

    // The vtable is defined in the dependency, the coercion here.
    var app = String.from("import core.display.*\n\n")
    app.append("struct Wrapper {\n    val n: int32\n}\n\n")
    app.append("impl Display for Wrapper {\n    fun display(out: &var dyn Write): void { out.write_str(\"W\") }\n}\n\n")
    // A counting sink: the fixture depends on core alone.
    app.append("struct Count {\n    pub var bytes: uint64\n}\n\n")
    app.append("""impl Write for Count {
    mutating fun write_str(s: str): void { self.bytes = self.bytes + s.byte_len() }
}

""")
    app.append("""fun through_dyn(value: &dyn Display): uint64 {
    var c = Count { bytes: 0 }
    value.display(&var c)
    return c.bytes
}

""")
    app.append("fun main(): int32 {\n")
    app.append("    if through_dyn(&(7)) != 1 { return 1 }\n")
    app.append("    if through_dyn(&(true)) != 4 { return 2 }\n")
    app.append("    if through_dyn(&(\"hi\")) != 2 { return 3 }\n")
    // A struct receiver, the control.
    app.append("    val w = Wrapper { n: 5 }\n")
    app.append("    if through_dyn(&w) != 1 { return 4 }\n")
    app.append("    return 0\n}\n")
    write_file(scratch_path("kf_dyn_prim_app/src/main.kf"), app)
    return 0
}

@test
fun a_primitive_coerces_to_a_dependencys_trait_object(): void {
    val prepared = prepare_dyn_primitive_fixture()
    val built = komp_build(scratch_path("kf_dyn_prim_app"), "")
    val ran = unsafe { system(scratch_path("kf_dyn_prim_app/target/kflat/dyn_prim_app")) }
    val ok = prepared == 0 && built == 0 && ran == 0
    assert_eq(ok, true, "a coercion names the same vtable the definition does")
}
