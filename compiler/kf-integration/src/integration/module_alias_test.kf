// `import a.b as x` and calls through `x`, across crates and within one.
// Needs two crates, so not a tests/cases file.

import core.assert.assert_eq
import kf_integration.harness.check_project
import kf_integration.harness.komp_build
import std.fs.scratch_path
import testing.test

extern "C" fun system(cmd: str): int32

/// `alias_dep` has `answer` (40) at its root and `two` in `alias_dep.text`;
/// `alias_app.parts` has `seven`. The app's `main.kf` is `main`.
fun prepare_alias_fixture(name: str, main: str): int32 {
    val dep = scratch_path("${name}_dep")
    val app = scratch_path("${name}_app")
    val prep = unsafe { system("rm -rf ${dep} ${app} && mkdir -p ${dep}/src/text ${app}/src/parts") }
    if prep != 0 { return prep }
    write_file("${dep}/kf.toml", "[project]\nname = \"alias_dep\"\nversion = \"0.1.0\"\nkind = \"lib\"\n")
    write_file("${dep}/src/lib.kf", "pub fun answer(): int32 { return 40 }\n")
    write_file("${dep}/src/text/two.kf", "pub fun two(): int32 { return 2 }\n")
    val project = "[project]\nname = \"alias_app\"\nversion = \"0.1.0\"\nkind = \"bin\"\n"
    val toml = "${project}\n[dependencies]\nalias_dep = { path = \"../${name}_dep\" }\n"
    write_file("${app}/kf.toml", toml)
    val parts = "pub fun seven(): int32 { return 7 }\n\nfun private_seven(): int32 { return 7 }\n"
    write_file("${app}/src/parts/seven.kf", parts)
    write_file("${app}/src/main.kf", main)
    return 0
}

fun run_alias_fixture(name: str): int32 {
    val app = scratch_path("${name}_app")
    if komp_build(app, "") != 0 { return 100 }
    return unsafe { system("${app}/target/kflat/alias_app") }
}

@test
fun a_call_through_an_alias_reaches_a_dependency_and_a_sibling_module(): void {
    assert_eq(prepare_alias_fixture("kf_alias_calls", """import alias_dep as dep
import alias_dep.text as text
import alias_app.parts as parts

fun main(): int32 {
    if dep.answer() != 40 { return 1 }
    if text.two() != 2 { return 2 }
    if parts.seven() != 7 { return 3 }
    return 0
}
"""), 0, "fixture prepared")
    assert_eq(run_alias_fixture("kf_alias_calls"), 0, "each call reaches the aliased module's function")
}

@test
fun a_call_through_an_alias_is_not_taken_by_the_callers_own_function(): void {
    assert_eq(prepare_alias_fixture("kf_alias_own", """import alias_dep as dep

fun answer(): int32 { return 5 }

fun main(): int32 {
    if dep.answer() != 40 { return 1 }
    if answer() != 5 { return 2 }
    return 0
}
"""), 0, "fixture prepared")
    assert_eq(run_alias_fixture("kf_alias_own"), 0, "`dep.answer` and `answer` are two functions")
}

@test
fun a_local_shadows_an_alias(): void {
    assert_eq(prepare_alias_fixture("kf_alias_shadow", """import alias_app.parts as parts

struct Parts {
    val v: int32
}

impl Parts {
    fun seven(): int32 { return self.v }
}

fun main(): int32 {
    val first = parts.seven()
    val parts = Parts { v: 3 }
    if first != 7 { return 1 }
    if parts.seven() != 3 { return 2 }
    return 0
}
"""), 0, "fixture prepared")
    assert_eq(run_alias_fixture("kf_alias_shadow"), 0, "after `val parts`, `parts.seven()` is the method")
}

@test
fun an_aliased_import_admits_no_bare_name(): void {
    assert_eq(prepare_alias_fixture("kf_alias_bare", """import alias_app.parts as parts

fun main(): int32 { return seven() - 7 }
"""), 0, "fixture prepared")
    assert_eq(check_project(scratch_path("kf_alias_bare_app")) != 0, true, "`seven` is reached only as `parts.seven`")
}

@test
fun a_private_function_is_not_reached_through_an_alias(): void {
    assert_eq(prepare_alias_fixture("kf_alias_private", """import alias_app.parts as parts

fun main(): int32 { return parts.private_seven() - 7 }
"""), 0, "fixture prepared")
    assert_eq(check_project(scratch_path("kf_alias_private_app")) != 0, true, "an alias does not widen visibility")
}
