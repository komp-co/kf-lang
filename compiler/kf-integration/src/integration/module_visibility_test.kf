// `pub` and an import carry a function across a module boundary, in a crate
// or out of one; files of one module share scope. Needs two modules, so not a
// tests/cases file.

import core.assert.assert_eq
import kf_integration.harness.check_project
import kf_integration.harness.komp_build
import testing.test

extern "C" fun system(cmd: str): int32

/// `outer.inner` holds one `pub` and one private function, and `sibling.kf`,
/// in `main.kf`'s own module, one private function; `main.kf` is `body`.
fun prepare_visibility_fixture(name: str, body: str): int32 {
    val cmd = "rm -rf ${Dir.scratch()}/${name} ${Dir.scratch()}/${name}_libs && mkdir -p ${Dir.scratch()}/${name}/src/outer/inner && cp -r libs ${Dir.scratch()}/${name}_libs"
    val prep = unsafe { system(cmd) }
    if prep != 0 { return prep }

    // The `core` dependency is needed: a dependency-free project rejects the
    // private call on another path.
    var toml = String.from("[package]\nname = \"")
    toml.append(name)
    toml.append("\"\nversion = \"0.1.0\"\n\n[dependencies]\ncore = { path = \"../")
    toml.append(name)
    toml.append("_libs/core\" }\nalloc = { path = \"../")
    toml.append(name)
    toml.append("_libs/alloc\" }\n")
    val toml_path = "${Dir.scratch()}/${name}/kf.toml"
    File.write(toml_path, toml).unwrap()

    val deep_path = "${Dir.scratch()}/${name}/src/outer/inner/deep.kf"
    File.write(deep_path, """fun private_value(): int32 { return 7 }
pub fun public_value(): int32 { return 42 }
""").unwrap()

    val sibling_path = "${Dir.scratch()}/${name}/src/sibling.kf"
    File.write(sibling_path, "fun sibling_value(): int32 { return 3 }\n").unwrap()

    val main_path = "${Dir.scratch()}/${name}/src/main.kf"
    File.write(main_path, body).unwrap()
    return 0
}

fun check_fixture(name: str): int32 {
    var dir = "${Dir.scratch()}/"
    dir.append(name)
    return check_project(dir)
}

@test
fun a_private_function_does_not_cross_a_module_boundary(): void {
    val body = "import kf_vis_private.outer.inner.private_value\n\nfun main(): int32 { return private_value() }\n"
    assert_eq(prepare_visibility_fixture("kf_vis_private", body), 0, "fixture prepared")
    assert_eq(check_fixture("kf_vis_private") != 0, true, "a non-pub function in another module is not callable")
}

@test
fun a_public_function_crosses_a_module_boundary_once_imported(): void {
    assert_eq(prepare_visibility_fixture("kf_vis_public", """import kf_vis_public.outer.inner.public_value

fun main(): int32 {
    if public_value() != 42 { return 1 }
    return 0
}
"""), 0, "fixture prepared")
    assert_eq(check_fixture("kf_vis_public"), 0, "a pub function in another module is callable")
}

@test
fun a_public_function_in_another_module_of_the_crate_needs_an_import(): void {
    val body = "fun main(): int32 { return public_value() - 42 }\n"
    assert_eq(prepare_visibility_fixture("kf_vis_unimported", body), 0, "fixture prepared")
    assert_eq(check_fixture("kf_vis_unimported") != 0, true, "a sibling module's pub function needs an import")
}

@test
fun files_of_one_module_share_scope(): void {
    val body = "fun main(): int32 { return sibling_value() - 3 }\n"
    assert_eq(prepare_visibility_fixture("kf_vis_sibling", body), 0, "fixture prepared")
    assert_eq(check_fixture("kf_vis_sibling"), 0, "a private function in the same directory needs no import")
}

/// A dependency crate holding one `pub fun answer`, and an app crate that
/// calls it. `import_line` is written verbatim above `main`, so passing ""
/// produces a crate with no import anywhere.
fun prepare_dependency_fixture(name: str, import_line: str): int32 {
    val cmd = "rm -rf ${Dir.scratch()}/${name}_dep ${Dir.scratch()}/${name}_app && mkdir -p ${Dir.scratch()}/${name}_dep/src ${Dir.scratch()}/${name}_app/src"
    val prep = unsafe { system(cmd) }
    if prep != 0 { return prep }

    val dep_toml = "${Dir.scratch()}/${name}_dep/kf.toml"
    File.write(dep_toml, "[project]\nname = \"vis_dep\"\nversion = \"0.1.0\"\nkind = \"lib\"\n").unwrap()

    val dep_src = "${Dir.scratch()}/${name}_dep/src/lib.kf"
    File.write(dep_src, "pub fun answer(): int32 { return 42 }\n").unwrap()

    val app_toml_path = "${Dir.scratch()}/${name}_app/kf.toml"
    val app_toml = "[project]\nname = \"vis_app\"\nversion = \"0.1.0\"\nkind = \"bin\"\n\n[dependencies]\nvis_dep = { path = \"../${name}_dep\" }\n"
    File.write(app_toml_path, app_toml).unwrap()

    val main_path = "${Dir.scratch()}/${name}_app/src/main.kf"
    var main_src = String.from(import_line)
    main_src.append("fun main(): int32 { return answer() - 42 }\n")
    File.write(main_path, main_src).unwrap()
    return 0
}

fun build_app_fixture(name: str): int32 {
    val dir = "${Dir.scratch()}/${name}_app"
    return komp_build(dir, "")
}

/// Through `build`: check_project's import table is never empty, so only
/// separate compilation reaches the import-free path.
@test
fun an_import_free_build_still_checks_visibility(): void {
    assert_eq(prepare_dependency_fixture("kf_vis_noimport", ""), 0, "fixture prepared")
    assert_eq(build_app_fixture("kf_vis_noimport") != 0, true, "a dependency call with no import anywhere does not build")
}

@test
fun an_imported_dependency_call_builds(): void {
    assert_eq(prepare_dependency_fixture("kf_vis_import", "import vis_dep.*\n\n"), 0, "fixture prepared")
    assert_eq(build_app_fixture("kf_vis_import"), 0, "the same call builds once the import is written")
}
