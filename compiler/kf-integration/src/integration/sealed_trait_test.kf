// A sealed trait crosses a crate boundary as a bound any crate may use and
// an impl only its own crate may write, read from the interface alone too.
// Needs two crates, so not a tests/cases file.

import core.assert.assert_eq

import kf_integration.harness.komp_build
import testing.test

extern "C" fun system(cmd: str): int32

fun prepare_sealed_fixture(app_main: str): int32 {
    val dep = Dir.scratch_path("kf_sealed_dep")
    val app = Dir.scratch_path("kf_sealed_app")
    val prep = unsafe { system("rm -rf ${dep} ${app} && mkdir -p ${dep}/src ${app}/src") }
    if prep != 0 { return prep }
    File.write("${dep}/kf.toml".as_str(), "[project]\nname = \"sealed_dep\"\nkind = \"lib\"\n").unwrap()
    File.write("${dep}/src/lib.kf".as_str(), """pub sealed trait Endian {
    fun swaps(): bool
}

pub struct Little {}
pub struct Big {}

impl Endian for Little { fun swaps(): bool { return false } }
impl Endian for Big { fun swaps(): bool { return true } }
""").unwrap()
    File.write("${app}/kf.toml".as_str(), """[project]
name = "sealed_app"
kind = "bin"

[dependencies]
sealed_dep = { path = "../kf_sealed_dep" }
""").unwrap()
    File.write("${app}/src/main.kf".as_str(), app_main).unwrap()
    return 0
}

fun bound_only_main(): str {
    return """import sealed_dep.*

fun count<E: Endian>(order: &E): int32 {
    if order.swaps() { return 1 }
    return 0
}

fun main(): int32 {
    if count(&Big {}) + count(&Little {}) == 1 { return 0 }
    return 1
}
"""
}

@test
fun a_sealed_trait_bounds_another_crate(): void {
    val prep = prepare_sealed_fixture(bound_only_main())
    val built = komp_build(Dir.scratch_path("kf_sealed_app"), "")
    val ran = unsafe { system(Dir.scratch_path("kf_sealed_app/target/kflat/sealed_app").as_str()) }
    assert_eq(prep == 0 && built == 0 && ran == 0, true, "a bound and its methods cross; only impls are closed")
}

@test
fun another_crate_cannot_implement_a_sealed_trait(): void {
    val main = """import sealed_dep.*

struct Middle {}

impl Endian for Middle { fun swaps(): bool { return true } }

fun main(): int32 { return 0 }
"""
    val prep = prepare_sealed_fixture(main)
    val built = komp_build(Dir.scratch_path("kf_sealed_app"), "")
    assert_eq(prep == 0 && built != 0, true, "the impl is rejected in the consumer")
}

@test
fun a_sealed_trait_is_read_back_from_the_interface(): void {
    val main = """import sealed_dep.*

struct Middle {}

impl Endian for Middle { fun swaps(): bool { return true } }

fun main(): int32 { return 0 }
"""
    val prep = prepare_sealed_fixture(bound_only_main())
    val first = komp_build(Dir.scratch_path("kf_sealed_app"), "")
    File.write(Dir.scratch_path("kf_sealed_app/src/main.kf"), main).unwrap()
    val source = Dir.scratch_path("kf_sealed_dep/src")
    val hidden = unsafe { system("mv ${source} ${source}.hidden") }
    val rebuilt = komp_build(Dir.scratch_path("kf_sealed_app"), "")
    val restored = unsafe { system("mv ${source}.hidden ${source}") }
    assert_eq(prep == 0 && first == 0 && hidden == 0 && rebuilt != 0 && restored == 0, true,
        "sealed_dep.kfi says the trait is sealed")
}
