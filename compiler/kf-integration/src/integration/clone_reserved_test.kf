// `clone` is reserved for a Self-returning deep copy. check_module returns
// the error count.
import alloc.list.*
import core.assert.assert_eq

import kf_core.span.*
import kf_driver.fresh_source_map
import kf_driver.check_module
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser

fun error_count_for(src: str): int32 {
    var smap = fresh_source_map()
    val fid = unsafe { smap.add_file(new_source_file(String.from("<test>"), String.from(src))) }
    val toks = tokenize(src, fid)
    var p = new_parser(toks)
    var m = p.parse_module(List.new<String>())
    return m.check_module(smap)
}

@test fun non_self_clone_is_rejected(): void {
    val bad = """struct Pair { pub val a: int32 }
impl Pair { fun clone(): int32 { return self.a } }
fun main(): int32 { return 0 }"""
    assert_eq(error_count_for(bad) > 0, true, "a non-Self clone is a typecheck error")
}

@test fun self_returning_clone_is_accepted(): void {
    val good = """struct Pair { pub val a: int32 }
impl Pair { fun clone(): Pair { return Pair { a: self.a } } }
fun main(): int32 { return 0 }"""
    assert_eq(error_count_for(good) == 0, true, "a Self-returning clone is fine")
}

// `take` is a reserved intrinsic as a free function; a `take` method is fine,
// since it mangles with its receiver's prefix.
@test fun free_take_is_rejected(): void {
    val bad = "fun take(a: int32, b: int32): int32 { return b }\nfun main(): int32 { return take(1, 2) }"
    assert_eq(error_count_for(bad) > 0, true, "a free `take` function is a typecheck error")
}

@test fun take_method_is_accepted(): void {
    val good = """struct Cell { pub val a: int32 }
impl Cell { fun take(self): int32 { return self.a } }
fun main(): int32 { return 0 }"""
    assert_eq(error_count_for(good) == 0, true, "a `take` method is fine")
}
