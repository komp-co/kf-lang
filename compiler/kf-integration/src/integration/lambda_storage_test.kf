import core.assert.assert_eq
import kf_integration.harness.komp_build
import testing.test

extern "C" fun system(cmd: str): int32

fun run_stored_lambda_under_asan(): int32 {
    val prep = unsafe { system("rm -rf ${Dir.scratch_path("kf_lambda_storage")} && mkdir -p ${Dir.scratch_path("kf_lambda_storage/src")}") }
    if prep != 0 { return prep }
    File.write(Dir.scratch_path("kf_lambda_storage/kf.toml"), "[project]\nname = \"lambda_storage\"\nkind = \"bin\"\n").unwrap()
    File.write(Dir.scratch_path("kf_lambda_storage/src/main.kf"), """fun main(): int32 {
    val text = String.from("owned")
    val length = || text.len()
    if length() != 5 { return 1 }
    return 0
}
""").unwrap()
    val built = komp_build(Dir.scratch_path("kf_lambda_storage"), "-fsanitize=address")
    if built != 0 { return built }
    return unsafe { system("ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 ${Dir.scratch_path("kf_lambda_storage/target/kflat/lambda_storage")}") }
}

@test
fun stored_lambda_owned_capture_is_asan_clean(): void {
    assert_eq(run_stored_lambda_under_asan(), 0, "stored closure owns and drops its String capture once")
}
