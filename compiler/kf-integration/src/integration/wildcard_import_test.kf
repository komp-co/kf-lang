// A wildcard supplying one or two names is reported; one supplying many is a
// prelude and left alone. Two crates, since `file_admits` gates only across a
// crate boundary.

import core.assert.assert_eq
import kf_core.diagnostic.*
import kf_driver.fresh_source_map
import kf_driver.collect_module_diags
import kf_integration.harness.check_project
import kf_integration.harness.assemble_project
import testing.test

extern "C" fun system(cmd: str): int32

/// A dependency crate exporting four functions and a type, and an app whose
/// `main.kf` opens with `import_line` and returns `body`.
fun prepare_wildcard_fixture(name: str, import_line: str, body: str): int32 {
    var cmd = "rm -rf ${Dir.scratch()}/${name}_dep ${Dir.scratch()}/${name}_app"
    cmd.append(" && mkdir -p ${Dir.scratch()}/${name}_dep/src ${Dir.scratch()}/${name}_app/src")
    val prep = unsafe { system(cmd) }
    if prep != 0 { return prep }

    val dep_toml = "${Dir.scratch()}/${name}_dep/kf.toml"
    File.write(dep_toml, """[project]
name = "wi_dep"
version = "0.1.0"
kind = "lib"
""").unwrap()

    val dep_src = "${Dir.scratch()}/${name}_dep/src/lib.kf"
    File.write(dep_src, """pub struct Pair {
    pub val left:  int32
    pub val right: int32
}

pub fun one(): int32 { return 1 }
pub fun two(): int32 { return 2 }
pub fun three(): int32 { return 3 }
pub fun four(): int32 { return 4 }
""").unwrap()

    val app_toml = "${Dir.scratch()}/${name}_app/kf.toml"
    File.write(app_toml, """[project]
name = "wi_app"
version = "0.1.0"
kind = "bin"

[dependencies]
wi_dep = { path = "../${name}_dep" }
""".as_str()).unwrap()

    val main_path = "${Dir.scratch()}/${name}_app/src/main.kf"
    var main_src = String.from(import_line)
    main_src.append("\nfun main(): int32 { return ")
    main_src.append(body)
    main_src.append(" }\n")
    File.write(main_path, main_src).unwrap()
    return 0
}

fun check_wildcard_fixture(name: str): int32 {
    val dir = "${Dir.scratch()}/${name}_app"
    return check_project(dir)
}

/// As the driver builds them: the lint needs `Module.crate`.
fun wildcard_fixture_diags(name: str): List<Diagnostic> {
    val dir = "${Dir.scratch()}/${name}_app"
    val smap = fresh_source_map()
    var pdiags = Diagnostics.new()
    var merged = assemble_project(dir, smap, &var pdiags)
    return merged.collect_module_diags(smap)
}

/// Read off the diagnostics: a warning exits 0 either way.
fun reports_wildcard(name: str): bool {
    val diags = wildcard_fixture_diags(name)
    while diag in &diags {
        if diag.code.as_str().equals("wildcard_import") { return true }
    }
    return false
}

/// The replacement text the lint's fix carries, or "" when it did not fire.
fun wildcard_fix_text(name: str): String {
    val diags = wildcard_fixture_diags(name)
    while d in &diags {
        if d.code.as_str().equals("wildcard_import") { return d.fix.replacement.clone() }
    }
    return ""
}

@test
fun a_wildcard_supplying_one_name_is_reported(): void {
    assert_eq(prepare_wildcard_fixture("kf_wi_one", "import wi_dep.*", "one() - 1"), 0, "fixture prepared")
    assert_eq(reports_wildcard("kf_wi_one"), true, "one name is cheap to write out")
    assert_eq(check_wildcard_fixture("kf_wi_one"), 0, "and it is a warning, not an error")
}

@test
fun a_wildcard_supplying_more_than_the_threshold_is_left_alone(): void {
    assert_eq(prepare_wildcard_fixture("kf_wi_many", "import wi_dep.*",
        "one() + two() + three() + four() - 10"), 0, "fixture prepared")
    assert_eq(reports_wildcard("kf_wi_many"), false, "four names is a prelude, not a candidate")
}

/// Types resolve globally, so an import list cannot spell one.
@test
fun a_wildcard_carrying_a_type_is_left_alone(): void {
    assert_eq(prepare_wildcard_fixture("kf_wi_type", "import wi_dep.*",
        "Pair { left: 1, right: 0 }.left + one() - 2"), 0, "fixture prepared")
    assert_eq(reports_wildcard("kf_wi_type"), false, "no import line names a type")
}

@test
fun a_named_import_is_not_reported(): void {
    assert_eq(prepare_wildcard_fixture("kf_wi_named", "import wi_dep.one", "one() - 1"), 0, "fixture prepared")
    assert_eq(reports_wildcard("kf_wi_named"), false, "the lint is about `.*`, and this is the fix for it")
}

/// The repair is the import block that replaces the line, not prose about it.
@test
fun the_fix_names_the_names(): void {
    assert_eq(prepare_wildcard_fixture("kf_wi_fix", "import wi_dep.*", "one() + two() - 3"), 0,
        "fixture prepared")
    assert_eq(wildcard_fix_text("kf_wi_fix").as_str(), "import wi_dep.one\nimport wi_dep.two",
        "one line per name, in first-use order")
}

/// `..` makes the parser append `core.range.*`, which has no line in the
/// file to narrow.
@test
fun the_import_a_range_literal_pulls_in_is_not_reported(): void {
    assert_eq(prepare_wildcard_fixture("kf_wi_range", "import wi_dep.one", "one() - 1 + (0..3).end - 3"),
        0, "fixture prepared")
    assert_eq(reports_wildcard("kf_wi_range"), false, "nobody wrote the import `..` pulls in")
    assert_eq(check_wildcard_fixture("kf_wi_range"), 0, "and the fixture still compiles")
}
