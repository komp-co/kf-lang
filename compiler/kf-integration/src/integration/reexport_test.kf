// `pub import`: a module's surface includes what it re-exports, across the
// `.kfi` boundary and within one crate. Needs two crates, so not a
// tests/cases file.

import core.assert.assert_eq
import kf_integration.harness.check_project
import kf_tool.build.build_project_separate
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32

/// `reex_lib`'s root holds only re-exports: all of `reex_lib.emit` and
/// `reex_lib.parse.read`, but not `reex_lib.parse.other`.
fun prepare_reexport_fixture(name: str, main: str): int32 {
    val lib = scratch_path("${name}_lib")
    val app = scratch_path("${name}_app")
    val prep = unsafe { system("rm -rf ${lib} ${app} && mkdir -p ${lib}/src/emit ${lib}/src/parse ${app}/src") }
    if prep != 0 { return prep }
    write_file("${lib}/kf.toml", "[project]\nname = \"reex_lib\"\nversion = \"0.1.0\"\nkind = \"lib\"\n")
    write_file("${lib}/src/lib.kf", "pub import reex_lib.emit.*\npub import reex_lib.parse.read\n")
    write_file("${lib}/src/emit/emit.kf", "pub fun write_it(): int32 { return 10 }\n")
    val parse = "pub fun read(): int32 { return 20 }\n\npub fun other(): int32 { return 30 }\n"
    write_file("${lib}/src/parse/parse.kf", parse)
    val project = "[project]\nname = \"reex_app\"\nversion = \"0.1.0\"\nkind = \"bin\"\n"
    write_file("${app}/kf.toml", "${project}\n[dependencies]\nreex_lib = { path = \"../${name}_lib\" }\n")
    write_file("${app}/src/main.kf", main)
    return 0
}

fun run_reexport_fixture(name: str): int32 {
    val app = scratch_path("${name}_app")
    if build_project_separate(app, "") != 0 { return 100 }
    return unsafe { system("${app}/target/kflat/reex_app") }
}

@test
fun a_wildcard_import_sees_what_the_module_reexports(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_wild", """import reex_lib.*

fun main(): int32 { return write_it() + read() - 30 }
"""), 0, "fixture prepared")
    assert_eq(run_reexport_fixture("kf_reex_wild"), 0, "both re-exported functions are reached")
}

@test
fun a_reexported_name_is_imported_by_name(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_named", """import reex_lib.read
import reex_lib.write_it

fun main(): int32 { return write_it() + read() - 30 }
"""), 0, "fixture prepared")
    assert_eq(run_reexport_fixture("kf_reex_named"), 0, "`reex_lib.read` names the re-export")
}

@test
fun an_alias_reaches_what_the_module_reexports(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_alias", """import reex_lib as lib

fun main(): int32 { return lib.write_it() + lib.read() - 30 }
"""), 0, "fixture prepared")
    assert_eq(run_reexport_fixture("kf_reex_alias"), 0, "calls through the alias follow the re-exports")
}

@test
fun a_name_left_out_of_a_reexport_stays_out(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_hidden", """import reex_lib.*

fun main(): int32 { return other() - 30 }
"""), 0, "fixture prepared")
    val app = scratch_path("kf_reex_hidden_app")
    assert_eq(build_project_separate(app, "") != 0, true, "only `read` was re-exported from `reex_lib.parse`")
}

@test
fun a_reexport_serves_the_crates_own_modules(): void {
    val root = scratch_path("kf_reex_local")
    val prep = unsafe { system("rm -rf ${root} && mkdir -p ${root}/src/api ${root}/src/core_parts") }
    assert_eq(prep, 0, "scratch prepared")
    write_file("${root}/kf.toml", "[project]\nname = \"reex_local\"\nversion = \"0.1.0\"\nkind = \"bin\"\n")
    write_file("${root}/src/core_parts/parts.kf", "pub fun part(): int32 { return 4 }\n")
    write_file("${root}/src/api/api.kf", "pub import reex_local.core_parts.part\n")
    write_file("${root}/src/main.kf", "import reex_local.api.*\n\nfun main(): int32 { return part() - 4 }\n")
    assert_eq(check_project(root), 0, "`reex_local.api` offers `part` to the rest of the crate")
}
