// `export <names> from <module>`: a module's surface includes what it
// exports, across the `.kfi` boundary and within one crate. Needs two crates,
// so not a tests/cases file.

import core.assert.assert_eq
import kf_integration.harness.check_project
import kf_integration.harness.komp_build
import testing.test

extern "C" fun system(cmd: str): int32

/// `reex_lib`'s root holds only exports: all of `reex_lib.emit`,
/// `reex_lib.parse.read`, and `reex_lib.parse.raw` as `parse_raw`, but not
/// `reex_lib.parse.other`.
fun prepare_reexport_fixture(name: str, main: str): int32 {
    val lib = Dir.scratch_path("${name}_lib")
    val app = Dir.scratch_path("${name}_app")
    val prep = unsafe { system("rm -rf ${lib} ${app} && mkdir -p ${lib}/src/emit ${lib}/src/parse ${app}/src") }
    if prep != 0 { return prep }
    File.write("${lib}/kf.toml", "[project]\nname = \"reex_lib\"\nversion = \"0.1.0\"\nkind = \"lib\"\n").unwrap()
    File.write("${lib}/src/lib.kf",
        "export * from reex_lib.emit\nexport read, raw as parse_raw from reex_lib.parse\n").unwrap()
    File.write("${lib}/src/emit/emit.kf", "pub fun write_it(): int32 { return 10 }\n").unwrap()
    val read = "pub fun read(): int32 { return 20 }\n"
    val parse = "${read}\npub fun other(): int32 { return 30 }\n\npub fun raw(): int32 { return 5 }\n"
    File.write("${lib}/src/parse/parse.kf", parse).unwrap()
    val project = "[project]\nname = \"reex_app\"\nversion = \"0.1.0\"\nkind = \"bin\"\n"
    File.write("${app}/kf.toml", "${project}\n[dependencies]\nreex_lib = { path = \"../${name}_lib\" }\n").unwrap()
    File.write("${app}/src/main.kf", main).unwrap()
    return 0
}

fun run_reexport_fixture(name: str): int32 {
    val app = Dir.scratch_path("${name}_app")
    if komp_build(app, "") != 0 { return 100 }
    return unsafe { system("${app}/target/kflat/reex_app") }
}

@test
fun a_wildcard_import_sees_what_the_module_reexports(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_wild", """import reex_lib.*

fun main(): int32 { return write_it() + read() - 30 }
"""), 0, "fixture prepared")
    assert_eq(run_reexport_fixture("kf_reex_wild"), 0, "both re-exported functions are reached")
}

@test
fun a_reexported_name_is_imported_by_name(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_named", """import reex_lib.read
import reex_lib.write_it

fun main(): int32 { return write_it() + read() - 30 }
"""), 0, "fixture prepared")
    assert_eq(run_reexport_fixture("kf_reex_named"), 0, "`reex_lib.read` names the re-export")
}

@test
fun an_alias_reaches_what_the_module_reexports(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_alias", """import reex_lib as lib

fun main(): int32 { return lib.write_it() + lib.read() - 30 }
"""), 0, "fixture prepared")
    assert_eq(run_reexport_fixture("kf_reex_alias"), 0, "calls through the alias follow the re-exports")
}

@test
fun a_name_left_out_of_a_reexport_stays_out(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_hidden", """import reex_lib.*

fun main(): int32 { return other() - 30 }
"""), 0, "fixture prepared")
    val app = Dir.scratch_path("kf_reex_hidden_app")
    assert_eq(komp_build(app, "") != 0, true, "only `read` was re-exported from `reex_lib.parse`")
}

@test
fun a_reexport_serves_the_crates_own_modules(): void {
    val root = Dir.scratch_path("kf_reex_local")
    val prep = unsafe { system("rm -rf ${root} && mkdir -p ${root}/src/api ${root}/src/core_parts") }
    assert_eq(prep, 0, "scratch prepared")
    File.write("${root}/kf.toml", "[project]\nname = \"reex_local\"\nversion = \"0.1.0\"\nkind = \"bin\"\n").unwrap()
    File.write("${root}/src/core_parts/parts.kf", "pub fun part(): int32 { return 4 }\n").unwrap()
    File.write("${root}/src/api/api.kf", "export part from reex_local.core_parts\n").unwrap()
    File.write("${root}/src/main.kf", "import reex_local.api.*\n\nfun main(): int32 { return part() - 4 }\n").unwrap()
    assert_eq(check_project(root), 0, "`reex_local.api` offers `part` to the rest of the crate")
}

@test
fun a_renamed_export_is_called_by_its_new_name(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_rename", """import reex_lib.*
import reex_lib as lib

fun main(): int32 { return parse_raw() + lib.parse_raw() - 10 }
"""), 0, "fixture prepared")
    assert_eq(run_reexport_fixture("kf_reex_rename"), 0, "`parse_raw` calls `raw`, bare and through the alias")
}

@test
fun a_renamed_exports_old_name_is_not_offered(): void {
    assert_eq(prepare_reexport_fixture("kf_reex_oldname", """import reex_lib.*

fun main(): int32 { return raw() - 5 }
"""), 0, "fixture prepared")
    val app = Dir.scratch_path("kf_reex_oldname_app")
    assert_eq(komp_build(app, "") != 0, true, "only `parse_raw` is `reex_lib`'s")
}

@test
fun an_export_does_not_import_into_its_own_file(): void {
    val root = Dir.scratch_path("kf_reex_own_file")
    val prep = unsafe { system("rm -rf ${root} && mkdir -p ${root}/src/parts") }
    assert_eq(prep, 0, "scratch prepared")
    File.write("${root}/kf.toml", "[project]\nname = \"reex_own\"\nversion = \"0.1.0\"\nkind = \"bin\"\n").unwrap()
    File.write("${root}/src/parts/parts.kf", "pub fun part(): int32 { return 4 }\n").unwrap()
    File.write("${root}/src/main.kf",
        "export part from reex_own.parts\n\nfun main(): int32 { return part() - 4 }\n").unwrap()
    assert_eq(check_project(root) != 0, true, "the file writing the export imports `part` separately")
}
