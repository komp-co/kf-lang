// `internal`: visible to every module of its crate, and to no other crate.

import core.assert.assert_eq
import alloc.path.Path

import kf_core.diagnostic.Diagnostics
import kf_driver.fresh_source_map
import kf_driver.new_lint_config
import kf_driver.checked_diagnostics
import kf_integration.harness.komp_build
import std.fs.create_dir_all
import std.fs.remove_dir_all
import std.fs.scratch_path
import std.fs.write_text
import kf_integration.harness.assemble_project
import testing.test

extern "C" fun system(cmd: str): int32

/// Every message checking a crate of `helpers` (module `probe.a`) and `user`
/// (module `probe.b`) reports, one per line.
fun internal_messages(helpers: str, user: str): String {
    val dir = scratch_path("kf_internal_probe")
    val _cleared = remove_dir_all(dir)
    val _made_a = create_dir_all(Path.new("${dir}/src/a".as_str()))
    val _made_b = create_dir_all(Path.new("${dir}/src/b".as_str()))
    val _manifest = write_text("${dir}/kf.toml".as_str(), "[project]\nname = \"probe\"\nkind = \"lib\"\n")
    val _helpers = write_text("${dir}/src/a/helpers.kf".as_str(), helpers)
    val _user = write_text("${dir}/src/b/user.kf".as_str(), user)
    val smap = fresh_source_map()
    var pdiags = Diagnostics.new()
    var merged = assemble_project(dir, smap, &var pdiags)
    val checked = merged.checked_diagnostics(smap, &new_lint_config())
    var out = ""
    while d in &pdiags.items {
        out.append(d.primary.message)
        out.append("\n")
    }
    while d in &checked {
        out.append(d.primary.message)
        out.append("\n")
    }
    return out
}

@test
fun another_module_of_the_crate_calls_an_internal_function(): void {
    val said = internal_messages("internal fun double(n: int32): int32 { return n * 2 }\n",
        "import probe.a.double\n\npub fun quad(n: int32): int32 { return double(double(n)) }\n")
    assert_eq(said.as_str(), "", "the crate's other modules import it")
}

@test
fun a_module_without_an_import_still_cannot_call_it(): void {
    val said = internal_messages("internal fun double(n: int32): int32 { return n * 2 }\n",
        "pub fun quad(n: int32): int32 { return double(n) }\n")
    val widens = said.contains("cannot find function `double`")
    assert_eq(widens, true, "`internal` widens the import, not the scope")
}

@test
fun an_internal_val_reaches_another_module(): void {
    val said = internal_messages("internal val LIMIT: int32 = 10\n",
        "import probe.a.LIMIT\n\npub fun limit(): int32 { return LIMIT }\n")
    assert_eq(said.as_str(), "", "a top-level value takes `internal` too")
}

/// `ilib` holds an `internal` helper, an `internal` value and a public generic
/// using both; `iapp` names what it is given in `main.kf`.
fun prepare_internal_crates(app_main: str): int32 {
    val core = scratch_path("kf_internal_core")
    val lib = scratch_path("kf_internal_lib")
    val app = scratch_path("kf_internal_app")
    val dirs = "${core}/src ${core}/native ${lib}/src/a ${app}/src"
    val natives = "libs/core/native/core.c libs/core/native/core_hosted.c"
    val sources = "cp -R libs/core/src/. ${core}/src/ && cp ${natives} ${core}/native/"
    val prep = unsafe { system("rm -rf ${core} ${lib} ${app} && mkdir -p ${dirs} && ${sources}") }
    if prep != 0 { return prep }
    write_file("${core}/kf.toml".as_str(), """[project]
name = "core"
kind = "lib"

[native]
c_sources = ["native/core.c"]
hosted_c_sources = ["native/core_hosted.c"]
""")
    write_file("${lib}/kf.toml".as_str(), """[project]
name = "ilib"
kind = "lib"

[dependencies]
core = { path = "../kf_internal_core" }
""")
    write_file("${lib}/src/a/helpers.kf".as_str(), """internal fun double(n: int32): int32 {
    return n * 2
}

internal val LIMIT: int32 = 10

pub fun doubled_past_limit<T>(_x: T, n: int32): int32 {
    return double(n) + LIMIT
}
""")
    write_file("${app}/kf.toml".as_str(), """[project]
name = "iapp"
kind = "bin"

[dependencies]
core = { path = "../kf_internal_core" }
ilib = { path = "../kf_internal_lib" }
""")
    write_file("${app}/src/main.kf".as_str(), app_main)
    return 0
}

@test
fun a_shipped_generic_reaches_its_crates_internal_helpers(): void {
    val prepared = prepare_internal_crates("""import ilib.a.doubled_past_limit

fun main(): int32 {
    if doubled_past_limit(true, 1) != 12 { return 1 }
    return 0
}
""")
    val built = komp_build(scratch_path("kf_internal_app"), "")
    val ran = unsafe { system(scratch_path("kf_internal_app/target/kflat/iapp")) }
    assert_eq(prepared == 0 && built == 0 && ran == 0, true, "the helper travels hidden, for the generic alone")
}

@test
fun another_crate_cannot_call_an_internal_function(): void {
    val prepared = prepare_internal_crates("""import ilib.a.double

fun main(): int32 {
    return double(1)
}
""")
    val built = komp_build(scratch_path("kf_internal_app"), "")
    assert_eq(prepared == 0 && built != 0, true, "`internal` stops at the crate")
}
