// A method of another crate's type, named as a value. Needs two crates, so
// not a tests/cases file.

import core.assert.assert_eq
import kf_integration.harness.komp_build
import kf_integration.harness.FixtureGraph
import testing.test

extern "C" fun system(cmd: str): int32

@test
fun a_crate_names_another_crates_methods_as_values(): void {
    val app = """import tally.Tally
import tally.Shown

fun main(): int32 {
    val make = Tally.make
    var t = make()
    val bump = Tally.bump
    bump(&var t)
    val get = Tally.get
    val show = Tally.show
    return get(&t) + show(&t)
}
"""
    val root = "kf_method_value_cross_crate"
    assert_eq(build_method_value_crates(root, app), 0, "the app builds against the library's methods")
    val binary = "${FixtureGraph.of(Dir.scratch_path("${root}/app")).target_dir}/app"
    assert_eq(Command.new(binary.as_str()).status().exit_code(), 33, "3 from get, 30 from show")
}

/// A library `tally` whose `Tally` has a static, a reading and a mutating
/// method and a trait impl, and an app depending on it.
fun build_method_value_crates(name: str, main_source: str): int32 {
    val root = Dir.scratch_path(name)
    val dirs = "${root}/tally/src ${root}/app/src ${root}/libs"
    unsafe { system("rm -rf ${root} && mkdir -p ${dirs} && cp -R libs/core libs/alloc ${root}/libs/") }
    val deps = "core = { path = \"../libs/core\" }\nalloc = { path = \"../libs/alloc\" }\n"
    val tally_manifest = "[project]\nname = \"tally\"\nkind = \"lib\"\n\n[dependencies]\n${deps}"
    File.write("${root}/tally/kf.toml".as_str(), tally_manifest).unwrap()
    File.write("${root}/tally/src/lib.kf".as_str(), """pub struct Tally {
    pub var n: int32
}

pub trait Shown {
    fun show(): int32
}

impl Tally {
    pub static fun make(): Tally { return Tally { n: 2 } }
    pub fun get(): int32 { return self.n }
    pub mutating fun bump(): void { self.n = self.n + 1 }
}

impl Shown for Tally {
    fun show(): int32 { return self.n * 10 }
}
""").unwrap()
    val app_deps = "${deps}tally = { path = \"../tally\" }\n"
    val app_manifest = "[project]\nname = \"app\"\nkind = \"bin\"\n\n[dependencies]\n${app_deps}"
    File.write("${root}/app/kf.toml".as_str(), app_manifest).unwrap()
    File.write("${root}/app/src/main.kf".as_str(), main_source).unwrap()
    return komp_build("${root}/app".as_str(), "")
}
