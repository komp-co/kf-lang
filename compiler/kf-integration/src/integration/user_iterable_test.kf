// A user-defined iterable drives `while x in it`: the cursor's trait methods
// resolve on a receiver typed from a written return type. Needs core's
// Iterator traits, so it builds a project.

import core.assert.assert_eq
import kf_integration.harness.komp_build
import testing.test

extern "C" fun system(cmd: str): int32
extern "C" fun access(path: str, mode: int32): int32

fun prepare_user_iterable_fixture(): int32 {
    val prep = unsafe { system("rm -rf ${Dir.scratch_path("kf_user_iter_core")} ${Dir.scratch_path("kf_user_iter_app")} && mkdir -p ${Dir.scratch_path("kf_user_iter_core/src")} ${Dir.scratch_path("kf_user_iter_core/native")} ${Dir.scratch_path("kf_user_iter_app/src")} && cp -R libs/core/src/. ${Dir.scratch_path("kf_user_iter_core/src/")}") }
    if prep != 0 { return prep }
    File.write(Dir.scratch_path("kf_user_iter_core/kf.toml"), """[project]
name = "core"
kind = "lib"

[native]
c_sources = ["native/core.c"]
hosted_c_sources = ["native/core_hosted.c"]
""").unwrap()
    val core_native = File.read("libs/core/native/core.c").unwrap_or("")
    File.write(Dir.scratch_path("kf_user_iter_core/native/core.c"), core_native).unwrap()
    val core_hosted = File.read("libs/core/native/core_hosted.c").unwrap_or("")
    File.write(Dir.scratch_path("kf_user_iter_core/native/core_hosted.c"), core_hosted).unwrap()
    File.write(Dir.scratch_path("kf_user_iter_app/kf.toml"), """[project]
name = "user_iter_app"
kind = "bin"

[dependencies]
core = { path = "../kf_user_iter_core" }
""").unwrap()

    var app = String.from("import core.*\n\n")
    app.append("struct Span {\n    val start: int32\n    val end: int32\n}\n\n")
    app.append("struct SpanIter {\n    var cur: int32\n    val end: int32\n}\n\n")
    app.append("impl Iterator<int32> for SpanIter {\n")
    app.append("    mutating fun next(): int32? {\n")
    app.append("        if self.cur >= self.end { return null }\n")
    app.append("        val out = self.cur\n")
    app.append("        self.cur = self.cur + 1\n")
    app.append("        return out\n")
    app.append("    }\n}\n\n")
    app.append("impl Iterable<int32> for Span {\n")
    app.append("    type Iter = SpanIter\n")
    app.append("    fun iter(): SpanIter {\n")
    app.append("        return SpanIter { cur: self.start, end: self.end }\n")
    app.append("    }\n}\n\n")
    // Exit 0 only when the loop yields 0 through 4.
    app.append("fun main(): int32 {\n")
    app.append("    val s = Span { start: 0, end: 5 }\n")
    app.append("    var sum: int32 = 0\n")
    app.append("    while i in s {\n        sum = sum + i\n    }\n")
    app.append("    if sum == 10 { return 0 }\n")
    app.append("    return 1\n}\n")
    File.write(Dir.scratch_path("kf_user_iter_app/src/main.kf"), app).unwrap()
    return 0
}

@test
fun a_user_defined_iterable_drives_a_for_loop(): void {
    val prepared = prepare_user_iterable_fixture()
    val built = komp_build(Dir.scratch_path("kf_user_iter_app"), "")
    val binary = unsafe { access(Dir.scratch_path("kf_user_iter_app/target/kflat/user_iter_app"), 0) }
    val ran = unsafe { system(Dir.scratch_path("kf_user_iter_app/target/kflat/user_iter_app")) }
    val ok = prepared == 0 && built == 0 && binary == 0 && ran == 0
    assert_eq(ok, true, "for over a user-defined iterable sums 0..5 to 10")
}
