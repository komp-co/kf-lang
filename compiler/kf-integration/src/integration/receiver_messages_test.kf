// What the checker says about a receiver: a variant it lacks, or a borrow it
// cannot lend.

import core.assert.assert_eq

@test
fun a_val_field_borrowing_mutably_lends_to_a_mutating_call(): void {
    val said = reports("kf_recv_val_ref_field", """import alloc.list.*
pub struct Sink { var items: List<int32> }
impl Sink {
    pub mutating fun emit(x: int32): void { self.items.push(x) }
}
pub view struct Ctx { val sink: &var Sink }
impl Ctx {
    pub mutating fun report(x: int32): void { self.sink.emit(x) }
}
""", "needs a mutable receiver")
    assert_eq(said, false, "the call changes the borrowed sink, not the field")
}

@test
fun a_val_field_borrowing_mutably_still_needs_a_writable_owner(): void {
    val said = reports("kf_recv_ref_field_shared", """import alloc.list.*
pub struct Sink { var items: List<int32> }
impl Sink {
    pub mutating fun emit(x: int32): void { self.items.push(x) }
}
pub view struct Ctx { val sink: &var Sink }
impl Ctx {
    pub fun report(x: int32): void { self.sink.emit(x) }
}
""", "mutating")
    assert_eq(said, true, "a shared `self` cannot lend what it holds mutably")
}
