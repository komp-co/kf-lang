// A value parameter crosses a crate boundary: another crate instantiates and
// infers it, and its argument is checked against the dependency's parameter.
// Needs two crates, so not a tests/cases file.

import core.assert.assert_eq

import kf_tool.build.build_project_separate
import std.fs.scratch_path
import testing.test

extern "C" fun system(cmd: str): int32

fun prepare_value_param_fixture(app_main: str): int32 {
    val dep = scratch_path("kf_value_dep")
    val app = scratch_path("kf_value_app")
    val prep = unsafe { system("rm -rf ${dep} ${app} && mkdir -p ${dep}/src ${app}/src") }
    if prep != 0 { return prep }
    write_file("${dep}/kf.toml".as_str(), "[project]\nname = \"value_dep\"\nkind = \"lib\"\n")
    write_file("${dep}/src/lib.kf".as_str(), """pub struct Residue<I: Integer, M: I> {
    pub val value: I
}

pub fun wrap<I: Integer, M: I>(v: I): Residue<I, M> {
    return Residue<I, M> { value: v % M }
}

pub fun width<N: uint64>(): uint64 { return N }
""")
    write_file("${app}/kf.toml".as_str(), """[project]
name = "value_app"
kind = "bin"

[dependencies]
value_dep = { path = "../kf_value_dep" }
""")
    write_file("${app}/src/main.kf".as_str(), app_main)
    return 0
}

@test
fun a_value_parameter_crosses_a_crate(): void {
    val main = """import value_dep.*

fun main(): int32 {
    val x: Residue<int64, 9> = wrap(20)
    if x.value == 2 && width<12>() == 12 { return 0 }
    return 1
}
"""
    val prep = prepare_value_param_fixture(main)
    val built = build_project_separate(scratch_path("kf_value_app"), "")
    val ran = unsafe { system(scratch_path("kf_value_app/target/kflat/value_app").as_str()) }
    assert_eq(prep == 0 && built == 0 && ran == 0, true, "instantiated and inferred in the consumer")
}

@test
fun a_value_argument_is_checked_against_another_crate(): void {
    val main = """import value_dep.*

fun main(): int32 {
    val w = width<-1>()
    return 0
}
"""
    val prep = prepare_value_param_fixture(main)
    val built = build_project_separate(scratch_path("kf_value_app"), "")
    assert_eq(prep == 0 && built != 0, true, "`-1` does not fit the dependency's `N: uint64`")
}
