// Reading stdin end to end: a built program is fed a file. The case corpus
// runs with no input.

import core.assert.assert_eq
import alloc.path.*
import alloc.list.*
import std.fs.*
import std.process.*
import std.env.*
import kf_tool.build.build_project_separate

fun stdin_dir(): str { return scratch_path("kf_stdin_io") }

/// Echoes each line in brackets, so a blank line is visible, then the count.
fun prepare_reader(): void {
    val _src = create_dir_all(Path.new(scratch_path("kf_stdin_io/reader/src")))
    // `std` is not ambient, and from /tmp only an absolute path reaches the
    // tree under test.
    val root = current_dir()
    var manifest = String.from("[project]\nname = \"reader\"\nversion = \"0.1.0\"\n\n[dependencies]\n")
    manifest.append("core = { path = \"")
    manifest.append(root.as_str())
    manifest.append("/libs/core\" }\nalloc = { path = \"")
    manifest.append(root.as_str())
    manifest.append("/libs/alloc\" }\nstd = { path = \"")
    manifest.append(root.as_str())
    manifest.append("/libs/std\" }\n")
    write_file(scratch_path("kf_stdin_io/reader/kf.toml"), manifest.as_str())
    var app = String.from("import core.display.*\nimport std.io.*\n\n")
    app.append("fun main(): int32 {\n")
    app.append("    var lines: int32 = 0\n")
    app.append("    while true {\n")
    app.append("        when (read_line()) {\n")
    app.append("            Some(l) => { lines = lines + 1\n")
    app.append("print(\"[\")\nprint(l.as_str())\nprintln(\"]\") }\n")
    app.append("            None => { break }\n")
    app.append("        }\n")
    app.append("    }\n")
    app.append("    return lines\n")
    app.append("}\n")
    write_file(scratch_path("kf_stdin_io/reader/src/main.kf"), app.as_str())
}

@test
fun read_line_yields_every_line_and_stops_at_the_end(): void {
    prepare_reader()
    val built = build_project_separate(scratch_path("kf_stdin_io/reader"), "")
    assert_eq(built, 0, "the reader builds")
    // A blank line in the middle: it is a line, not the end of input.
    val _in = create_dir_all(Path.new(stdin_dir()))
    write_file(scratch_path("kf_stdin_io/input.txt"), "alpha\n\nbeta\n")
    // `Command` has no stdin redirect.
    val run = Command.new("/bin/sh")
    run.arg("-c")
    run.arg("${scratch_path("kf_stdin_io/reader/target/kflat/reader")} < ${scratch_path("kf_stdin_io/input.txt")} > ${scratch_path("kf_stdin_io/out.txt")}")
    val code = run.status().exit_code()
    assert_eq(code, 3, "three lines were read, the blank one among them")
    val seen = read_file(scratch_path("kf_stdin_io/out.txt"))
    assert_eq(seen.as_str(), "[alpha]\n[]\n[beta]\n", "each line came back, blank included")
}

@test
fun read_line_on_empty_input_reads_nothing(): void {
    prepare_reader()
    val built = build_project_separate(scratch_path("kf_stdin_io/reader"), "")
    assert_eq(built, 0, "the reader builds")
    val _e = create_dir_all(Path.new(stdin_dir()))
    write_file(scratch_path("kf_stdin_io/empty.txt"), "")
    val run = Command.new("/bin/sh")
    run.arg("-c")
    run.arg("${scratch_path("kf_stdin_io/reader/target/kflat/reader")} < ${scratch_path("kf_stdin_io/empty.txt")}")
    assert_eq(run.status().exit_code(), 0, "no input is zero lines, not one empty one")
}
