// A call reaches the function the checker chose, even when another crate in
// the build declares one of the same name. Needs two crates, so not a
// tests/cases file.

import core.assert.assert_eq
import kf_integration.harness.komp_build
import testing.test

extern "C" fun system(cmd: str): int32

/// `twin_dep.answer` returns 40; the app's private `answer`, in module
/// `twin_app.other`, returns 7 and is called only by `seven`.
fun prepare_twin_fixture(): int32 {
    val dep = Dir.scratch_path("kf_twin_dep")
    val app = Dir.scratch_path("kf_twin_app")
    val prep = unsafe { system("rm -rf ${dep} ${app} && mkdir -p ${dep}/src ${app}/src/other") }
    if prep != 0 { return prep }
    File.write("${dep}/kf.toml", "[project]\nname = \"twin_dep\"\nversion = \"0.1.0\"\nkind = \"lib\"\n").unwrap()
    File.write(Dir.scratch_path("kf_twin_dep/src/lib.kf"), "pub fun answer(): int32 { return 40 }\n").unwrap()
    File.write(Dir.scratch_path("kf_twin_app/kf.toml"), """[project]
name = "twin_app"
version = "0.1.0"
kind = "bin"

[dependencies]
twin_dep = { path = "../kf_twin_dep" }
""").unwrap()
    File.write(Dir.scratch_path("kf_twin_app/src/other/other.kf"), """fun answer(): int32 { return 7 }

pub fun seven(): int32 { return answer() }
""").unwrap()
    File.write(Dir.scratch_path("kf_twin_app/src/main.kf"), """import twin_dep.answer
import twin_app.other.seven

fun main(): int32 {
    if answer() != 40 { return 1 }
    if seven() != 7 { return 2 }
    return 0
}
""").unwrap()
    return 0
}

@test
fun an_imported_function_is_called_though_the_crate_declares_its_name(): void {
    assert_eq(prepare_twin_fixture(), 0, "fixture prepared")
    assert_eq(komp_build(Dir.scratch_path("kf_twin_app"), ""), 0, "the app builds")
    val ran = unsafe { system(Dir.scratch_path("kf_twin_app/target/kflat/twin_app").as_str()) }
    assert_eq(ran, 0, "each call reaches its own crate's `answer`")
}
