// Extension functions: what the checker says about them, and a crate calling
// the extensions another crate exports.

import core.assert.assert_eq
import alloc.list.*
import kf_core.diagnostic.*
import kf_resolve.new_decl_table
import kf_resolve.resolve_module
import kf_typecheck.typecheck_module
import kf_integration.harness.komp_build
import kf_integration.harness.FixtureGraph
import kf_integration.harness.typed_crate_for
import std.fs.scratch_path
import std.process.Command
import testing.test

extern "C" fun system(cmd: str): int32

/// The messages checking `source` as a one-file crate produces.
fun extension_messages(name: str, source: str): List<String> {
    val root = scratch_path(name)
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    write_file("${root}/kf.toml".as_str(), "[project]\nname = \"ext_probe\"\nkind = \"lib\"\n")
    val file = "${root}/src/lib.kf"
    write_file(file, source)
    var crate = typed_crate_for(file)
    var table = new_decl_table()
    resolve_module(&var crate.module, &var table)
    val diags = typecheck_module(&var crate.module, &var table)
    var out = List.new<String>()
    while d in &diags {
        out.push(d.primary.message.clone())
    }
    return out
}

fun says(messages: &List<String>, needle: str): bool {
    while m in &messages {
        if m.contains(needle) { return true }
    }
    return false
}

@test
fun a_receiver_name_close_to_a_type_is_questioned(): void {
    val messages = extension_messages("kf_ext_typo", """struct Point { val x: int32 }
struct Pair<A> { val a: A }
fun Pair<Pont>.first(): int32 { return 0 }
""")
    assert_eq(says(&messages, "did you mean `Point`?"), true, "`Pont` is one edit from a type in scope")
}

@test
fun an_extension_inside_an_impl_is_rejected(): void {
    val messages = extension_messages("kf_ext_nested", """struct Point { val x: int32 }
impl Point {
    fun Point.bad(): int32 { return 1 }
}
""")
    assert_eq(says(&messages, "declared at the top level"), true, "extensions are top-level declarations")
}

@test
fun a_duplicate_extension_is_named_as_written(): void {
    val messages = extension_messages("kf_ext_duplicate", """struct Point { val x: int32 }
fun Point.area(): int32 { return 1 }
fun Point.area(): int32 { return 2 }
""")
    assert_eq(says(&messages, "an extension `area` for this receiver is already defined"), true, "not the hidden name")
}

@test
fun a_method_call_counts_arguments_without_the_receiver(): void {
    val messages = extension_messages("kf_ext_arity", """struct Point { val x: int32 }
fun Point.area(): int32 { return 1 }
fun probe(p: Point): int32 { return p.area(3) }
""")
    val said = says(&messages, "wrong number of arguments to `area`: expected 0, found 1")
    assert_eq(said, true, "the receiver is not an argument")
}

@test
fun two_equally_specific_extensions_are_ambiguous(): void {
    val messages = extension_messages("kf_ext_ambiguous", """struct Point { val x: int32 }
fun T.tag(): int32 { return 1 }
fun U.tag(): int32 { return 2 }
fun probe(p: Point): int32 { return p.tag() }
""")
    assert_eq(says(&messages, "ambiguous extension `tag`"), true, "neither receiver is more specific")
}

@test
fun an_unmet_bound_is_named_when_nothing_else_applies(): void {
    val messages = extension_messages("kf_ext_bound", """trait Loud { fun volume(): int32 }
struct Quiet { val x: int32 }
fun <T: Loud> T.level(): int32 { return self.volume() }
fun probe(q: Quiet): int32 { return q.level() }
""")
    val said = says(&messages, "no method `level` on `Quiet`: `T.level` needs `Loud`, which `Quiet` does not implement")
    assert_eq(said, true, "the extension exists, and its bound is why it does not apply")
}

@test
fun a_near_miss_suggests_an_extension(): void {
    val messages = extension_messages("kf_ext_near", """struct Point { val x: int32 }
fun Point.area(): int32 { return 1 }
fun probe(p: Point): int32 { return p.aree() }
""")
    assert_eq(says(&messages, "did you mean `area`?"), true, "extensions count as the type's methods here")
}

@test
fun an_unimported_extension_is_not_callable(): void {
    val built = build_extension_crates("kf_ext_unimported", "fun main(): int32 { return 2.squared() }\n")
    assert_eq(built != 0, true, "another crate's extension needs an import")
}

@test
fun a_crate_calls_the_extensions_another_exports(): void {
    val app = """import alloc.list.List
import geo.Point
import geo.area
import geo.second_or
import geo.squared
import geo.sum_x
import geo.count_all

fun main(): int32 {
    var ps = List.new<Point>()
    ps.push(Point { x: 2, y: 3 })
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(5)
    return ps.area() + xs.second_or(0) + area(&ps) + 3.squared() + ps.sum_x() + xs.count_all()
}
"""
    val root = "kf_ext_cross_crate"
    assert_eq(build_extension_crates(root, app), 0, "the app builds against the library's extensions")
    val binary = "${FixtureGraph.of(scratch_path("${root}/app")).target_dir}/app"
    assert_eq(Command.new(binary.as_str()).status().exit_code(), 30, "6 + 5 + 6 + 9 + 2 + 2")
}

/// A library `geo` exporting a specific, a generic, a primitive and two trait
/// extensions plus a private one, and an app depending on it.
fun build_extension_crates(name: str, main_source: str): int32 {
    val root = scratch_path(name)
    val dirs = "${root}/geo/src ${root}/app/src ${root}/libs"
    unsafe { system("rm -rf ${root} && mkdir -p ${dirs} && cp -R libs/core libs/alloc ${root}/libs/") }
    val deps = "core = { path = \"../libs/core\" }\nalloc = { path = \"../libs/alloc\" }\n"
    val geo_manifest = "[project]\nname = \"geo\"\nkind = \"lib\"\n\n[dependencies]\n${deps}"
    write_file("${root}/geo/kf.toml".as_str(), geo_manifest)
    write_file("${root}/geo/src/lib.kf".as_str(), """import alloc.list.*

pub struct Point {
    pub val x: int32
    pub val y: int32
}

pub fun List<Point>.area(): int32 {
    var total = 0
    var i: uint64 = 0
    while i < self.size() {
        total = total + self.at(i).x * self.at(i).y
        i = i + 1
    }
    return total
}

pub fun List<T>.second_or(fallback: T): T {
    if self.size() < 2 { return fallback }
    return *self.at(1)
}

pub fun int32.squared(): int32 { return self * self }

pub fun Iterable<Point>.sum_x(): int32 {
    var total = 0
    var it = self.iter()
    while true {
        val p = it.next() ?: break
        total = total + p.x
    }
    return total
}

pub fun Iterable<T>.count_all(): int32 {
    var n = 0
    var it = self.iter()
    while true {
        val _item = it.next() ?: break
        n = n + 1
    }
    return n
}

fun int32.hidden(): int32 { return self }
""")
    val app_deps = "${deps}geo = { path = \"../geo\" }\n"
    val app_manifest = "[project]\nname = \"app\"\nkind = \"bin\"\n\n[dependencies]\n${app_deps}"
    write_file("${root}/app/kf.toml".as_str(), app_manifest)
    write_file("${root}/app/src/main.kf".as_str(), main_source)
    return komp_build("${root}/app".as_str(), "")
}
