// A fixture project's crates as komp resolves them. The harness asks
// `komp metadata`, the contract tools other than komp read, so the compiler's
// tests link no part of the project tool.

import alloc.path.Path
import json.reader.*
import kf_driver.build.CrateSource
import kf_query.serve.read_lint_rows
import kf_query.serve.read_option_rows
import kf_query.serve.read_strings

/// One crate of `komp metadata`'s `crates`.
@derive(Clone)
pub struct FixtureCrate {
    pub val name: String
    /// `lib` or `bin`.
    pub val kind: String
    pub val root: String
    pub val src: String
    pub val deps: List<String>
    pub val loads: List<String>
    /// Which of `deps` only the crate's tests need.
    pub val dev_deps: List<String>
    /// `name=level` rows, in the order they apply.
    pub val lints: List<String>
    /// `name.key=value` rows.
    pub val lint_options: List<String>
}

/// The crates the fixture's root reaches, dependencies first and the root
/// last, or `error` saying why there are none.
pub struct FixtureGraph {
    pub val crates: List<FixtureCrate>
    /// Where komp puts the root's artifacts and program.
    pub val target_dir: String
    pub val error: String
}

impl FixtureCrate {
    pub fun is_bin(): bool {
        return self.kind.as_str() == "bin"
    }

    pub fun source(): CrateSource {
        return CrateSource { name: self.name.clone(), root: self.root.clone(), src: self.src.clone() }
    }
}

impl FixtureGraph {
    /// The project at `root_dir`, its test dependencies included, as the komp
    /// running the tests resolves it. Offline: a fixture's dependencies are
    /// paths, or were fetched by the test that wrote it.
    pub static fun of(root_dir: str): FixtureGraph {
        val temp = TempDir.new("kf-fixture-graph")
        val answer = temp.path().join("metadata.json")
        var command = Command.new(komp_path().as_str())
        command.arg("metadata")
        command.arg(root_dir)
        command.arg("--offline")
        command.stdout_to(answer.clone())
        val ran = command.status().success()
        val text = File.read(answer.as_str()).unwrap_or("")
        val read = FixtureGraph.read(text.as_str(), Dir.current().join(root_dir).normalized().raw.as_str())
        if !ran && read.error.is_empty() { return FixtureGraph.failed("komp metadata ${root_dir} failed") }
        return read
    }

    /// The project around `file_path`: the nearest directory at or above it
    /// holding a kf.toml. No crates when there is none.
    pub static fun around(file_path: str): FixtureGraph {
        var dir = Dir.current().join(file_path).normalized().parent()
        while true {
            if File.exists("${dir.raw}/kf.toml".as_str()) { return FixtureGraph.of(dir.raw.as_str()) }
            val up = dir.parent()
            if up.raw.as_str() == dir.raw.as_str() { break }
            dir = up
        }
        return FixtureGraph.failed("no kf.toml above ${file_path}")
    }

    static fun failed(error: String): FixtureGraph {
        return FixtureGraph { crates: [], target_dir: "", error: error }
    }

    /// From `komp metadata`'s one line: the crate rooted at `root` (the last
    /// one there, a program after its package's library) and the crates it
    /// loads, in the order listed.
    pub static fun read(line: str, root: str): FixtureGraph {
        var reader = JsonReader.new(line)
        if !reader.begin_object() { return FixtureGraph.failed("komp metadata answered `${line}`") }
        var all: List<FixtureCrate> = []
        var target_dir = ""
        while reader.object_has_next() {
            val key = reader.read_key()
            when key.as_str() {
                "error" => return FixtureGraph.failed(reader.read_string())
                "target_dir" => target_dir = reader.read_string()
                "crates" => {
                    if !reader.begin_array() { return FixtureGraph.failed("komp metadata: `crates` is not a list") }
                    while reader.array_has_next() { all.push(read_crate(&var reader)) }
                }
                _ => reader.skip_value()
            }
        }
        if reader.has_error() { return FixtureGraph.failed("komp metadata answered `${line}`") }
        val top = all.filter(|c: FixtureCrate| c.root.as_str() == root).last()
            ?: return FixtureGraph.failed("komp metadata lists no crate at ${root}")
        val loads = top.loads.clone()
        var crates = all.filter(|c: FixtureCrate| loads.contains(&c.name))
        crates.push(top)
        return FixtureGraph { crates: crates, target_dir: target_dir, error: "" }
    }

    /// The crates as kflatc takes them, dependencies first.
    pub fun sources(): List<CrateSource> {
        return self.crates.map(|c: FixtureCrate| c.source())
    }

    pub fun root(): FixtureCrate? {
        return self.crates.last()
    }

    /// As a build sees it, without what only the root's tests need: its
    /// `dev_deps` and the crates only they reach.
    pub fun without_tests(): FixtureGraph {
        val root = self.root() ?: return FixtureGraph.failed(self.error.clone())
        val kept_deps = root.deps.filter(|name: String| !root.dev_deps.contains(&name))
        var kept: List<String> = kept_deps.clone()
        while dep in &kept_deps {
            val reached = self.crate_named(dep) ?: continue
            while name in &reached.loads {
                if !kept.contains(name) { kept.push(name.clone()) }
            }
        }
        var crates = self.crates.filter(|c: FixtureCrate| kept.contains(&c.name))
        crates.push(FixtureCrate {
            name: root.name.clone(), kind: root.kind.clone(), root: root.root.clone(), src: root.src.clone(),
            deps: kept_deps, loads: root.loads.filter(|name: String| kept.contains(&name)), dev_deps: [],
            lints: root.lints.clone(), lint_options: root.lint_options.clone()
        })
        return FixtureGraph { crates: crates, target_dir: self.target_dir.clone(), error: self.error.clone() }
    }

    /// The crate named `name`, as a fetched dependency's cached sources.
    pub fun crate_named(name: str): FixtureCrate? {
        return self.crates.filter(|c: FixtureCrate| c.name.as_str() == name).last()
    }
}

fun read_crate(reader: &var JsonReader): FixtureCrate {
    var name = ""
    var kind = ""
    var root = ""
    var src = ""
    var deps: List<String> = []
    var loads: List<String> = []
    var dev_deps: List<String> = []
    var lints: List<String> = []
    var lint_options: List<String> = []
    if reader.begin_object() {
        while reader.object_has_next() {
            val field = reader.read_key()
            when field.as_str() {
                "name" => name = reader.read_string()
                "kind" => kind = reader.read_string()
                "root" => root = reader.read_string()
                "src" => src = reader.read_string()
                "deps" => deps = read_strings(reader)
                "loads" => loads = read_strings(reader)
                "dev_deps" => dev_deps = read_strings(reader)
                "lints" => lints = read_lint_rows(reader)
                "lint_options" => lint_options = read_option_rows(reader)
                _ => reader.skip_value()
            }
        }
    }
    return FixtureCrate {
        name: name, kind: kind, root: root, src: src, deps: deps, loads: loads, dev_deps: dev_deps, lints: lints,
        lint_options: lint_options
    }
}

/// `KOMP`, which `komp test` hands its test programs, else the komp beside
/// `KFLATC`, else `komp` on `PATH`.
pub fun komp_path(): String {
    val given = Env.get("KOMP") ?: ""
    if !given.is_empty() { return given }
    val kflatc = Env.get("KFLATC") ?: ""
    if !kflatc.is_empty() {
        val beside = "${Path.new(kflatc.as_str()).parent().raw}/komp"
        if File.exists(beside) { return beside }
    }
    return "komp"
}

/// The `core`, `alloc` and `std` the compiler under test ships with:
/// `<dir of KFLATC>/../libs`, else the repository's `libs`.
pub fun bundled_libs(): String {
    val kflatc = Env.get("KFLATC") ?: ""
    if !kflatc.is_empty() {
        val beside = "${Path.new(kflatc.as_str()).parent().raw}/../libs"
        if File.exists("${beside}/core/kf.toml".as_str()) { return Dir.current().join(beside).normalized().raw }
    }
    return Dir.current().join("libs").normalized().raw
}
