// Staging a project tree for a test fixture.

import std.process.Command

/// Copy the tree at `src` to `dst`, by content; the exit code of `cp`.
///
/// CONSTRAINT: `-L` copies through a symlinked source instead of linking it.
pub fun copy_tree_by_content(src: str, dst: str): int32 {
    var copy = Command.new("cp")
    copy.arg("-RL")
    copy.arg(src)
    copy.arg(dst)
    return copy.status().exit_code()
}
