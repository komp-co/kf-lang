// komp run as a program, for tests that build a whole project the way a user
// does: what the compiler emits, compiled, linked and run.

import std.process.Command

/// `komp build <root_dir>` with `KOMP_CFLAGS` set to `cflags`; komp's exit
/// code. The artifacts and the program land under `<root_dir>/target/kflat`.
pub fun komp_build(root_dir: str, cflags: str): int32 {
    return komp_command("build", root_dir, cflags)
}

/// As `komp_build`, into `target_root` (`KOMP_TARGET_DIR`): the case corpus
/// shares one, so `core` is built once for every case.
pub fun komp_build_into(root_dir: str, target_root: str): int32 {
    var komp = komp_process("build", root_dir, "")
    komp.env("KOMP_TARGET_DIR", target_root)
    return komp.status().exit_code()
}

/// `komp build --unity <root_dir>`, the whole program as one C file at
/// `<target_dir>/komp_out.c`; komp's exit code.
pub fun komp_build_unity(root_dir: str): int32 {
    var komp = Command.new(komp_path().as_str())
    komp.arg("build")
    komp.arg("--unity")
    komp.arg(root_dir)
    return komp.status().exit_code()
}

/// `komp run <root_dir>`: the program's exit code once it builds, else
/// komp's.
pub fun komp_run(root_dir: str): int32 {
    return komp_command("run", root_dir, "")
}

/// `komp check <root_dir>`, through kflatc as komp drives it.
pub fun komp_check(root_dir: str): int32 {
    return komp_command("check", root_dir, "")
}

/// `komp test <root_dir>`.
pub fun komp_test(root_dir: str): int32 {
    return komp_command("test", root_dir, "")
}

fun komp_command(command: str, root_dir: str, cflags: str): int32 {
    var komp = komp_process(command, root_dir, cflags)
    return komp.status().exit_code()
}

fun komp_process(command: str, root_dir: str, cflags: str): Command {
    var komp = Command.new(komp_path().as_str())
    komp.arg(command)
    komp.arg(root_dir)
    komp.env("KOMP_CFLAGS", cflags)
    return komp
}
