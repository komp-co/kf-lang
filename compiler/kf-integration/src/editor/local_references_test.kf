// References to parameters and locals: each use reaches the binding in
// scope where it is written, shadowing included.

import kf_integration.harness.typed_crate_for
import core.assert.assert_eq
import std.fs.scratch_path
import kf_driver.editor.render_references_json
import testing.test

fun locals_source(): str {
    return """import alloc.list.*

pub fun shadowed(n: int32): int32 {
    val total = n + 1
    if total > 3 {
        val total = 100
        return total
    }
    return total
}

pub fun summed(xs: &List<int32>): int32 {
    var acc = 0
    while item in xs {
        acc = acc + item
    }
    return acc
}
"""
}

fun locals_path(): String {
    return "${scratch_path("kf_query_local_refs")}/src/lib.kf"
}

/// The declaration written at `needle`.
fun declared_at(needle: str): String {
    return "\"declaration\":{\"file\":\"${locals_path()}\",${local_start(needle, 0)}"
}

fun locals_at(offset: uint64): String {
    val root = scratch_path("kf_query_local_refs")
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    write_file("${root}/kf.toml", "[project]\nname = \"query_local_refs\"\nkind = \"lib\"\n")
    write_file("${root}/src/lib.kf", locals_source())
    val crate = typed_crate_for("${root}/src/lib.kf")
    return render_references_json("lib.kf", offset as uint32, &crate)
}

/// `"byte_start":N` for `needle`, moved `into` it.
fun local_start(needle: str, into: uint64): String {
    return "\"byte_start\":${locals_source().index_of(needle)!! + into}"
}

@test
fun a_local_names_where_it_is_written(): void {
    val json = locals_at(locals_source().index_of("return total\n}")!! + 7)
    assert_eq(json.as_str().contains(declared_at("total = n").as_str()), true, "the outer `total`, not the inner one")
}

@test
fun a_shadowing_local_is_not_a_use_of_the_outer_one(): void {
    val json = locals_at(locals_source().index_of("return total\n}")!! + 7)
    val inner = local_start("total = 100", 0)
    assert_eq(json.as_str().contains(inner.as_str()), false, "the inner `total` is another binding")
}

@test
fun a_shadowing_local_finds_only_its_own_uses(): void {
    val json = locals_at(locals_source().index_of("total = 100")!! + 1)
    assert_eq(json.as_str().contains(local_start("total > 3", 0).as_str()), false, "the condition reads the outer one")
}

@test
fun a_loop_variable_is_declared_at_its_name(): void {
    val json = locals_at(locals_source().index_of("+ item")!! + 3)
    assert_eq(json.as_str().contains(declared_at("item in").as_str()), true, "not the `while` before it")
}

@test
fun an_assignment_is_a_use_of_a_var(): void {
    val json = locals_at(locals_source().index_of("var acc")!! + 5)
    val assigned = local_start("acc = acc", 0)
    assert_eq(json.as_str().contains(assigned.as_str()), true, "the name being assigned")
}
