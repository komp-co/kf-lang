// Two files, so the answer reaches past the asked one.

import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq
import kf_query.editor.render_references_json
import testing.test

fun references_fixture_path(): str {
    return Dir.scratch_path("kf_query_refs/src/lib.kf")
}

/// ```
/// // lib.kf
/// fun helper(n: int32): int32 {
///     return n + 1
/// }
///
/// fun uses_it_twice(): int32 {
///     return helper(1) + helper(2)   // calls at 90 and 102
/// }
///
/// // other.kf
/// fun elsewhere(): int32 {
///     return helper(9)               // call at 36
/// }
/// ```
fun prepare_references_fixture(): void {
    val _cleared = Dir.remove_all(Dir.scratch_path("kf_query_refs"))
    val _made = Dir.create_all(Dir.scratch_path("kf_query_refs/src"))
    File.write(Dir.scratch_path("kf_query_refs/kf.toml"), "[project]\nname = \"query_refs\"\nkind = \"lib\"\n").unwrap()
    var lib = """fun helper(n: int32): int32 {
    return n + 1
}

fun uses_it_twice(): int32 {
    return helper(1) + helper(2)
}
"""
    File.write(references_fixture_path(), lib.as_str()).unwrap()
    val other = "fun elsewhere(): int32 {\n    return helper(9)\n}\n"
    File.write(Dir.scratch_path("kf_query_refs/src/other.kf"), other.as_str()).unwrap()
}

fun references_at(offset: uint32): String {
    prepare_references_fixture()
    val crate = typed_crate_for(references_fixture_path())
    return render_references_json("lib.kf", offset, &crate)
}

@test
fun references_find_the_other_use_in_the_same_file(): void {
    val json = references_at(90)
    assert_eq(json.contains("\"byte_start\":102"), true, "the second call is a reference to the same function")
}

@test
fun references_reach_into_another_file_of_the_crate(): void {
    val json = references_at(90)
    assert_eq(json.contains("other.kf\",\"byte_start\":36"), true, "a use in a sibling file counts")
}

@test
fun references_name_the_declaration(): void {
    val json = references_at(90)
    // `helper` spans 4..10, not the `fun` before it.
    assert_eq(json.contains("\"declaration\":{\"file\":\"${Dir.scratch_path("kf_query_refs/src/lib.kf")}\",\"byte_start\":4,\"byte_end\":10"), true, "the declaration is its name, not its keyword")
}

@test
fun references_answer_from_the_declaration_name(): void {
    val json = references_at(6)
    assert_eq(json.contains("\"declaration\":{\"file\":\"${Dir.scratch_path("kf_query_refs/src/lib.kf")}\",\"byte_start\":4,\"byte_end\":10"), true, "the cursor on `helper` finds `helper`")
    assert_eq(json.contains("\"byte_start\":90"), true, "and every call site")
    assert_eq(json.contains("other.kf\",\"byte_start\":36"), true, "including one in a sibling file")
}

// The declaration is reported once, not in the list of uses.
@test
fun the_declaration_is_not_one_of_its_own_references(): void {
    val json = references_at(6)
    assert_eq(json.contains("\"references\":[{\"file\":\"${Dir.scratch_path("kf_query_refs/src/lib.kf")}\",\"byte_start\":90"), true, "the first reference is the first call, not the declaration")
}

@test
fun a_parameters_use_names_the_parameter(): void {
    // Offset 41 is the `n` of `n + 1`; the parameter is written at 11.
    val json = references_at(41)
    assert_eq(json.contains("\"declaration\":{\"file\":\"${Dir.scratch_path("kf_query_refs/src/lib.kf")}\",\"byte_start\":11"), true, "the parameter in the signature")
}

@test
fun references_are_silent_off_any_name(): void {
    val json = references_at(3)
    assert_eq(json.contains("\"declaration\":null"), true, "the space after `fun` names nothing")
}

fun members_source(): str {
    return """pub struct Point {
    pub val x: int32
}

pub struct Other {
    pub val x: int32
}

impl Point {
    pub fun sum(): int32 {
        return self.x
    }
}

pub fun probe(): int32 {
    val p = Point { x: 1 }
    val o = Other { x: 2 }
    return p.sum() + p.x + o.x
}
"""
}

fun members_at(offset: uint32): String {
    val root = Dir.scratch_path("kf_query_member_refs")
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    File.write("${root}/kf.toml", "[project]\nname = \"query_member_refs\"\nkind = \"lib\"\n").unwrap()
    File.write(Dir.scratch_path("kf_query_member_refs/src/lib.kf"), members_source()).unwrap()
    val crate = typed_crate_for(Dir.scratch_path("kf_query_member_refs/src/lib.kf"))
    return render_references_json("lib.kf", offset, &crate)
}

/// `"byte_start":N` for the first `needle`, moved `into` it.
fun member_start(needle: str, into: uint64): String {
    return "\"byte_start\":${members_source().index_of(needle)!! + into}"
}

@test
fun a_method_call_names_the_method_as_its_declaration(): void {
    val json = members_at((members_source().index_of("p.sum()")!! + 2) as uint32)
    assert_eq(json.contains(member_start("sum(): int32", 0).as_str()), true, "the name in the impl")
}

@test
fun a_methods_declaration_finds_its_calls(): void {
    val json = members_at((members_source().index_of("sum(): int32")!! + 1) as uint32)
    assert_eq(json.contains(member_start("p.sum()", 2).as_str()), true, "the call through a value")
}

@test
fun a_fields_references_include_a_literal_and_self(): void {
    val json = members_at((members_source().index_of("p.x")!! + 2) as uint32)
    val through_self = json.contains(member_start("self.x", 5).as_str())
    val in_a_literal = json.contains(member_start("Point { x", 8).as_str())
    assert_eq(through_self && in_a_literal, true, "`self.x` in a method and `x:` in `Point { x: 1 }`")
}

@test
fun a_same_named_field_of_another_type_is_not_a_reference(): void {
    val json = members_at((members_source().index_of("p.x")!! + 2) as uint32)
    assert_eq(json.contains(member_start("o.x", 2).as_str()), false, "`Other.x` is another field")
}
