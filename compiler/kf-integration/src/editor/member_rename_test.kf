// Renaming a method, a field or a local, and the renames refused because
// they would change what a use means.

import kf_integration.harness.typed_crate_for
import core.assert.assert_eq
import std.fs.scratch_path
import kf_query.editor.render_rename_json
import testing.test

fun member_rename_source(): str {
    return """pub struct Point {
    pub val x: int32
    pub val y: int32
}

impl Point {
    pub fun sum(): int32 {
        return self.x + self.y
    }
}

pub trait Loud {
    fun volume(): int32
}

impl Loud for Point {
    fun volume(): int32 { return self.x }
}

pub fun probe(n: int32): int32 {
    val total = n + 1
    val y = 3
    val p = Point { x: total, y }
    return p.sum() + p.x + total + p.volume()
}
"""
}

/// Renames the name `into` bytes into the first `needle`.
fun member_rename(needle: str, into: uint64, new_name: str): String {
    val root = scratch_path("kf_query_member_rename")
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    write_file("${root}/kf.toml", "[project]\nname = \"query_member_rename\"\nkind = \"lib\"\n")
    write_file("${root}/src/lib.kf", member_rename_source())
    val crate = typed_crate_for("${root}/src/lib.kf")
    val offset = member_rename_source().index_of(needle)!! + into
    return render_rename_json("lib.kf", offset as uint32, new_name, &crate)
}

/// The edit starting `into` bytes into the first `needle`.
fun edit_at(needle: str, into: uint64): String {
    return "\"byte_start\":${member_rename_source().index_of(needle)!! + into},"
}

@test
fun renaming_a_method_edits_its_declaration(): void {
    val json = member_rename("p.sum()", 2, "total_of")
    assert_eq(json.as_str().contains(edit_at("sum(): int32", 0).as_str()), true, "the name in the impl")
}

@test
fun renaming_a_method_edits_its_call(): void {
    val json = member_rename("sum(): int32", 1, "total_of")
    assert_eq(json.as_str().contains(edit_at("p.sum()", 2).as_str()), true, "the call through a value")
}

@test
fun renaming_a_field_edits_its_read_through_self(): void {
    val json = member_rename("p.x", 2, "across")
    assert_eq(json.as_str().contains(edit_at("self.x", 5).as_str()), true, "`self.x` in a method")
}

@test
fun renaming_a_field_to_another_of_its_fields_is_refused(): void {
    val json = member_rename("p.x", 2, "y")
    assert_eq(json.as_str().contains("already has a member named `y`"), true, "`Point.y` is taken")
}

@test
fun renaming_a_trait_method_is_refused(): void {
    val json = member_rename("p.volume()", 2, "loudness")
    assert_eq(json.as_str().contains("belongs to a trait"), true, "the trait and its impls would change together")
}

@test
fun renaming_a_local_edits_its_uses(): void {
    val json = member_rename("+ total", 2, "count")
    assert_eq(json.as_str().contains(edit_at("x: total", 3).as_str()), true, "the use in the literal")
}

@test
fun renaming_a_local_to_another_name_in_its_function_is_refused(): void {
    val json = member_rename("val total", 4, "n")
    assert_eq(json.as_str().contains("is already a name in this function"), true, "`n` is the parameter")
}

@test
fun renaming_a_field_written_as_shorthand_is_refused(): void {
    val json = member_rename("pub val y", 8, "down")
    assert_eq(json.as_str().contains("written once for two"), true, "`Point { x: total, y }` is field and local")
}

@test
fun renaming_a_local_written_as_shorthand_is_refused(): void {
    val json = member_rename("y = 3", 0, "down")
    assert_eq(json.as_str().contains("written once for two"), true, "the same `y` is the field")
}
