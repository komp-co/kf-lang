// Type names where a type goes: definition, references and rename reach a
// struct or trait written in a signature, a field, an impl header or a bound.

import kf_integration.harness.typed_crate_for
import core.assert.assert_eq
import std.fs.scratch_path
import kf_driver.editor.render_references_json
import kf_driver.editor.render_rename_json
import testing.test

fun types_source(): str {
    return """pub struct Point {
    pub val x: int32
}

pub struct Line {
    pub val from: Point
}

pub trait Loud {
    fun volume(): int32
}

impl Point {
    pub fun moved(): Point {
        return Point { x: self.x + 1 }
    }
}

impl Loud for Point {
    fun volume(): int32 { return self.x }
}

pub fun loudest<T: Loud>(a: &T): int32 {
    return a.volume()
}
"""
}

fun types_crate(): TypedCrate {
    val root = scratch_path("kf_query_type_refs")
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    write_file("${root}/kf.toml", "[project]\nname = \"query_type_refs\"\nkind = \"lib\"\n")
    write_file("${root}/src/lib.kf", types_source())
    return typed_crate_for("${root}/src/lib.kf")
}

fun type_references_at(needle: str, into: uint64): String {
    val crate = types_crate()
    val offset = types_source().index_of(needle)!! + into
    return render_references_json("lib.kf", offset as uint32, &crate)
}

/// `"byte_start":N` for the first `needle`, moved `into` it.
fun type_start(needle: str, into: uint64): String {
    return "\"byte_start\":${types_source().index_of(needle)!! + into},"
}

@test
fun a_field_type_names_its_struct(): void {
    val json = type_references_at("from: Point", 7)
    val file = "${scratch_path("kf_query_type_refs")}/src/lib.kf"
    val declared = "\"declaration\":{\"file\":\"${file}\",${type_start("Point {", 0)}"
    assert_eq(json.as_str().contains(declared.as_str()), true, "the struct's own name")
}

@test
fun a_structs_references_include_an_impl_header(): void {
    val json = type_references_at("struct Point", 7)
    assert_eq(json.as_str().contains(type_start("impl Point", 5).as_str()), true, "`impl Point`")
}

@test
fun a_structs_references_include_a_result_type(): void {
    val json = type_references_at("struct Point", 7)
    assert_eq(json.as_str().contains(type_start("(): Point", 4).as_str()), true, "`-> Point` of `moved`")
}

@test
fun a_trait_in_an_impl_header_names_the_trait(): void {
    val json = type_references_at("impl Loud", 5)
    assert_eq(json.as_str().contains(type_start("Loud {", 0).as_str()), true, "the trait's own name")
}

@test
fun a_traits_references_include_a_bound(): void {
    val json = type_references_at("trait Loud", 6)
    assert_eq(json.as_str().contains(type_start("T: Loud", 3).as_str()), true, "`T: Loud`")
}

@test
fun renaming_a_struct_edits_its_type_positions(): void {
    val crate = types_crate()
    val offset = types_source().index_of("struct Point")!! + 7
    val json = render_rename_json("lib.kf", offset as uint32, "Spot", &crate)
    assert_eq(json.as_str().contains(type_start("from: Point", 6).as_str()), true, "the field's type too")
}
