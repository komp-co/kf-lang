import kf_integration.harness.typed_crate_for
import kf_integration.harness.typed_crate_for_overlay
import core.assert.assert_eq
import kf_query.editor.render_tokens_json
import testing.test

fun tokens_fixture_path(): str {
    return Dir.scratch_path("kf_query_tokens/src/lib.kf")
}

/// ```
/// fun helper(n: int32): int32 {
///     return n + 1              // `n` at 41
/// }
///
/// fun uses_it(): int32 {
///     return helper(1)          // the call at 84
/// }
/// ```
fun prepare_tokens_fixture(): void {
    unsafe { system("rm -rf ${Dir.scratch_path("kf_query_tokens")} && mkdir -p ${Dir.scratch_path("kf_query_tokens/src")}") }
    File.write(Dir.scratch_path("kf_query_tokens/kf.toml"), "[project]\nname = \"query_tokens\"\nkind = \"lib\"\n").unwrap()
    val lib = "fun helper(n: int32): int32 {\n    return n + 1\n}\n\nfun uses_it(): int32 {\n    return helper(1)\n}\n"
    File.write(tokens_fixture_path(), lib.as_str()).unwrap()
}

fun tokens_json(): String {
    prepare_tokens_fixture()
    val crate = typed_crate_for(tokens_fixture_path())
    return render_tokens_json("lib.kf", &crate)
}

@test
fun tokens_call_a_call_a_function(): void {
    assert_eq(tokens_json().as_str().contains("\"byte_start\":84,\"byte_end\":90,\"type\":\"function\""), true, "a call is a function, whatever it is spelled like")
}

// The token is the callee's name, not the call's span over its arguments.
@test
fun a_call_token_stops_at_the_callee_name(): void {
    assert_eq(tokens_json().as_str().contains("\"byte_end\":93"), false, "the argument list is not part of the name")
}

@test
fun a_declaration_name_is_a_token(): void {
    val json = tokens_json()
    assert_eq(json.contains("\"byte_start\":4,\"byte_end\":10,\"type\":\"function\""), true, "`helper` in `fun helper(...)` is a function")
    assert_eq(json.contains("\"byte_start\":54,\"byte_end\":61,\"type\":\"function\""), true, "so is `uses_it`")
}

@test
fun tokens_call_a_bare_name_a_variable(): void {
    assert_eq(tokens_json().as_str().contains("\"byte_start\":41,\"byte_end\":42,\"type\":\"variable\""), true, "a name that is not a call reads as a variable")
}

@test
fun tokens_come_in_source_order(): void {
    // Declarations at 4 and 54, the parameter use at 41, the call at 84: the
    // walk visits a body before the next declaration.
    val json = tokens_json()
    assert_eq(json.contains("\"byte_start\":4,\"byte_end\":10,\"type\":\"function\"},{\"byte_start\":41"), true, "the declaration precedes its body")
    assert_eq(json.contains("\"byte_start\":41,\"byte_end\":42,\"type\":\"variable\"},{\"byte_start\":54"), true, "the body precedes the next declaration")
    assert_eq(json.contains("\"byte_start\":54,\"byte_end\":61,\"type\":\"function\"},{\"byte_start\":84"), true, "and that declaration precedes its own body")
}

@test
fun tokens_are_scoped_to_the_one_file(): void {
    prepare_tokens_fixture()
    File.write(Dir.scratch_path("kf_query_tokens/src/other.kf"), "fun far_away(): int32 {\n    return helper(2)\n}\n").unwrap()
    val crate = typed_crate_for(tokens_fixture_path())
    val json = render_tokens_json("lib.kf", &crate)
    assert_eq(json.contains("\"byte_start\":35,"), false, "a sibling file's names are not this file's tokens")
}

fun shapes_source(): str {
    return """pub struct Point {
    pub val x: int32
}

pub enum Color { Red, Green }

impl Point {
    pub static fun at(x: int32): Point { return Point { x: x } }
}

pub fun probe(): int32 {
    val p = Point.at(1)
    val c = Color.Red
    val ys = [p.x, 2]
    return ys[0]
}
"""
}

fun shapes_tokens(): String {
    val root = Dir.scratch_path("kf_query_token_shapes")
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    File.write("${root}/kf.toml", "[project]\nname = \"query_token_shapes\"\nkind = \"lib\"\n").unwrap()
    File.write("${root}/src/lib.kf", shapes_source()).unwrap()
    val crate = typed_crate_for("${root}/src/lib.kf")
    return render_tokens_json("lib.kf", &crate)
}

@test
fun the_type_before_a_static_call_is_a_type_token(): void {
    val start = shapes_source().index_of("Point.at")!!
    val token = "{\"byte_start\":${start},\"byte_end\":${start + 5},\"type\":\"type\""
    assert_eq(shapes_tokens().as_str().contains(token), true, "`Point` of `Point.at(1)`")
}

@test
fun the_enum_before_a_variant_is_a_type_token(): void {
    val start = shapes_source().index_of("Color.Red")!!
    val token = "{\"byte_start\":${start},\"byte_end\":${start + 5},\"type\":\"type\""
    assert_eq(shapes_tokens().as_str().contains(token), true, "`Color` of `Color.Red`")
}

@test
fun a_variant_is_an_enum_member(): void {
    val start = shapes_source().index_of("Red\n")!!
    val token = "{\"byte_start\":${start},\"byte_end\":${start + 3},\"type\":\"enum_member\""
    assert_eq(shapes_tokens().as_str().contains(token), true, "`Red` of `Color.Red`")
}

@test
fun a_list_literal_is_no_token(): void {
    val start = shapes_source().index_of("[p.x")!!
    assert_eq(shapes_tokens().as_str().contains("\"byte_start\":${start},"), false, "the brackets and what they hold")
}

@test
fun an_index_bracket_is_no_token(): void {
    val start = shapes_source().index_of("[0]")!!
    assert_eq(shapes_tokens().as_str().contains("\"byte_start\":${start},"), false, "the `[` of `ys[0]`")
}
