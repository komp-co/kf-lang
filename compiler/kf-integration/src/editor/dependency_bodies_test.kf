// A question about one crate types the crates it depends on as signatures:
// their bodies are not checked, and what calls into them still is.

import kf_integration.harness.typed_crate_for
import core.assert.assert_eq
import kf_core.ast.Module
import kf_query.editor.innermost_expr_at
import kf_query.editor.written_type
import testing.test

extern "C" fun system(cmd: str): int32

fun bodies_app_path(): str {
    return Dir.scratch_path("kf_query_bodies_app/src/main.kf")
}

fun bodies_app_source(): String {
    return String.from("""import bodylib.api.*

fun run(): int32 {
    val got = twice(3)
    return got
}
""")
}

/// `bodylib` declares `twice`, whose body has two statements; `app` calls it.
fun prepare_bodies_fixture(): void {
    val lib = Dir.scratch_path("kf_query_bodies_lib")
    val app = Dir.scratch_path("kf_query_bodies_app")
    unsafe { system("rm -rf ${lib} ${app} && mkdir -p ${lib}/src ${app}/src") }
    File.write(Dir.scratch_path("kf_query_bodies_lib/kf.toml"), """[project]
name = "bodylib"
kind = "lib"
""").unwrap()
    File.write(Dir.scratch_path("kf_query_bodies_lib/src/api.kf"), """pub fun twice(n: int32): int32 {
    val doubled = n * 2
    return doubled
}
""").unwrap()
    File.write(Dir.scratch_path("kf_query_bodies_app/kf.toml"), """[project]
name = "app"
kind = "lib"

[dependencies]
bodylib = { path = "../kf_query_bodies_lib" }
""").unwrap()
    File.write(bodies_app_path(), bodies_app_source().as_str()).unwrap()
}

/// How many statements the function named `name` holds; -1 when none is.
fun Module.body_size_of(name: str): int64 {
    while decl in &self.decls {
        if decl.name.as_str() == name {
            when (decl.kind) {
                Function(_params, _ret, body, _p, _u, _mu, _st) => return body.size() as int64
                _ => { }
            }
        }
    }
    return -1
}

@test
fun a_dependencys_function_bodies_are_left_unchecked(): void {
    prepare_bodies_fixture()
    val crate = typed_crate_for(bodies_app_path())
    assert_eq(crate.module.body_size_of("twice"), 0, "only the queried crate's bodies are typed")
}

@test
fun the_queried_crates_own_bodies_are_kept(): void {
    prepare_bodies_fixture()
    val crate = typed_crate_for(bodies_app_path())
    assert_eq(crate.module.body_size_of("run"), 2, "the crate asked about is typed whole")
}

@test
fun a_call_into_a_dependency_still_has_its_type(): void {
    prepare_bodies_fixture()
    val crate = typed_crate_for(bodies_app_path())
    val at = bodies_app_source().index_of("twice(3)") ?: 0
    val hit = crate.module.innermost_expr_at(crate.file_id, at as uint32)
    assert_eq(hit.ty.written_type(crate.sigs).as_str(), "int32", "the signature is enough to type the call")
}
