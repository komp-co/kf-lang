// The inlay of a binding a later use decided names the decided type, not the
// provisional one its first uses saw.

import kf_integration.harness.typed_crate_for
import core.assert.assert_eq

import kf_query.editor.render_inlays_json
import testing.test

extern "C" fun system(cmd: str): int32

fun decided_fixture_path(): str {
    return Dir.scratch_path("kf_query_decided/src/main.kf")
}

/// `n + n` decides nothing, so `wide(n)` decides `n`, and `doubled` with it.
fun prepare_decided_fixture(): void {
    unsafe { system("rm -rf ${Dir.scratch_path("kf_query_decided")} && mkdir -p ${Dir.scratch_path("kf_query_decided/src")}") }
    File.write(Dir.scratch_path("kf_query_decided/kf.toml"), "[project]\nname = \"query_decided\"\nkind = \"lib\"\n").unwrap()
    val src = """fun wide(x: uint64): uint64 {
    return x
}

fun run(): uint64 {
    val n = 5
    val doubled = n + n
    return wide(n) + doubled
}
"""
    File.write(decided_fixture_path(), src.as_str()).unwrap()
}

@test
fun an_inlay_names_the_type_a_later_use_decided(): void {
    prepare_decided_fixture()
    val crate = typed_crate_for(decided_fixture_path())
    val json = render_inlays_json("main.kf", &crate)
    assert_eq(json.contains("int32"), false, "no binding is left at the provisional int32")
}
