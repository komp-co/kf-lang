// Go to implementation: the impls of a trait or a type, a type's
// extensions, and each impl's version of a trait method.

import kf_integration.harness.typed_crate_for
import core.assert.assert_eq
import std.fs.scratch_path
import kf_query.editor.render_implementations_json
import testing.test

fun impls_source(): str {
    return """/// Marks a type for display.
annotation shown on struct

/// A point in the plane.
@shown
pub struct Point {
    pub val x: int32
}

pub trait Loud {
    fun volume(): int32
}

impl Point {
    pub fun moved(): Point {
        return Point { x: self.x + 1 }
    }
}

impl Loud for Point {
    fun volume(): int32 { return self.x }
}

pub fun Point.area(): int32 {
    return self.x * self.x
}

pub fun probe(p: Point): int32 {
    return p.area()
}
"""
}

fun impls_crate(): TypedCrate {
    val root = scratch_path("kf_query_impls")
    unsafe { system("rm -rf ${root} && mkdir -p ${root}/src") }
    write_file("${root}/kf.toml", "[project]\nname = \"query_impls\"\nkind = \"lib\"\n")
    write_file("${root}/src/lib.kf", impls_source())
    return typed_crate_for("${root}/src/lib.kf")
}

fun offset_of(needle: str, into: uint64): uint32 {
    return (impls_source().index_of(needle)!! + into) as uint32
}

fun impls_at(needle: str, into: uint64): String {
    val crate = impls_crate()
    return render_implementations_json("lib.kf", offset_of(needle, into), &crate)
}

/// `"byte_start":N` for the first `needle`, moved `into` it.
fun impl_start(needle: str, into: uint64): String {
    return "\"byte_start\":${offset_of(needle, into)},"
}

@test
fun a_traits_implementations_are_its_impls(): void {
    val json = impls_at("trait Loud", 6)
    assert_eq(json.contains(impl_start("for Point", 4).as_str()), true, "`impl Loud for Point`")
}

@test
fun a_structs_implementations_include_its_impl_block(): void {
    val json = impls_at("struct Point", 7)
    assert_eq(json.contains(impl_start("impl Point", 5).as_str()), true, "`impl Point`")
}

@test
fun a_structs_implementations_include_an_extension(): void {
    val json = impls_at("struct Point", 7)
    assert_eq(json.contains(impl_start("area()", 0).as_str()), true, "`fun Point.area()`")
}

@test
fun a_trait_methods_implementations_are_each_impls_version(): void {
    val json = impls_at("fun volume(): int32\n", 4)
    assert_eq(json.contains(impl_start("volume(): int32 {", 0).as_str()), true, "the impl's `volume`")
}
