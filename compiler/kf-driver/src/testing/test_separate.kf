// Artifact-backed `komp test`: the test TU lives in the test subdirectory and
// links dependency archives.

import std.fs.*
import std.process.*
import alloc.list.*
import kf_driver.build.*
import kf_shared.crate_artifact_manifest_path
import kf_shared.crate_archive_path
import kf_shared.test_crate_dir
import kf_shared.test_artifact_path

pub fun test_project_separate(root_dir: str, case_filter: str, test_filter: str): int32 {
    val built = build_project_separate(root_dir, "")
    if built != 0 { return built }
    val graph = build_crate_graph(root_dir)
    if graph.crates.size() == 0 { return 1 }

    val artifacts = target_dir(root_dir)
    val root = *graph.crates.at(graph.crates.size() - 1)
    val manifest_path = crate_artifact_manifest_path(artifacts.as_str(), root.name.as_str())
    val parsed = parse_artifact_manifest(read_file(manifest_path.as_str()).as_str())
    if !parsed.ok {
        runtime_println("komp test: root artifact metadata is unavailable")
        return 1
    }

    if root.invoke_kflatc_tests(root_dir, artifacts.as_str(), &parsed.manifest.dep_hashes) != 0 {
        runtime_println("komp test: errors found; test binary not written")
        return 1
    }
    val test_dir = test_crate_dir(artifacts.as_str())
    val source = test_artifact_path(test_dir.as_str(), root.name.as_str(), ".c")
    val object = test_artifact_path(test_dir.as_str(), root.name.as_str(), ".o")
    val binary = test_artifact_path(test_dir.as_str(), root.name.as_str(), "")

    var include_dirs = List.new<String>()
    include_dirs.push(test_dir.clone())
    include_dirs.push(artifacts.clone())
    if !compile_object_with_include_dirs(source.as_str(), object.as_str(), &include_dirs, "") { return 1 }

    var objects = List.new<String>()
    objects.push(object)
    // The root's own C sources, since its archive is not used here.
    if !root.compile_crate_c_sources(artifacts.as_str(), "", &var objects) { return 1 }
    var archives = List.new<String>()
    var i: uint64 = graph.crates.size() - 1
    while i > 0 {
        val dependency = *graph.crates.at(i - 1)
        archives.push(crate_archive_path(artifacts.as_str(), dependency.name.as_str()))
        i = i - 1
    }
    if !link_binary(binary.as_str(), &objects, &archives, "") { return 1 }
    // Command.status(), not system(): a wait status of 256 truncates to 0.
    val run = Command.new(binary.as_str())
    // A test that builds a project runs the compiler this komp would.
    run.env("KFLATC", kflatc_path().as_str())
    if case_filter.byte_len() > 0 {
        run.arg("--case")
        run.arg(case_filter)
    }
    if test_filter.byte_len() > 0 {
        run.arg("--filter")
        run.arg(test_filter)
    }
    return run.status().exit_code()
}
