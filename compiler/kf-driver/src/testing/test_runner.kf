// Data transforms for `komp test`: discover @test decls, generate the test
// main that hands them to core, and parse it back. Orchestration is in
// multi_crate.kf.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.intern
import kf_core.ast.declaration.TopDecl
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser

/// In discovery order.
pub fun collect_test_names(modules: List<Module>): List<String> {
    var out = List.new<String>()
    while m in &modules {
        while td in &m.decls {
            val is_test = (&td).has_annotation("test")
            if is_test {
                out.push(td.name.as_string())
            }
        }
    }
    return out
}

/// The generated main is its own module and must import each module that
/// declares a test.
pub fun gen_test_main_imports(modules: &List<Module>): String {
    var out = ""
    var seen = List.new<String>()
    while m in &modules {
        while td in &m.decls {
            if (&td).has_annotation("test") {
                val path = td.module_path.as_string()
                if !path.as_str().equals("") && !import_seen(&seen, path.as_str()) {
                    out.append("import ")
                    out.append(path.as_str())
                    out.append(".*\n")
                    seen.push(path)
                }
            }
        }
    }
    return out
}

fun import_seen(seen: &List<String>, target: str): bool {
    while item in &seen {
        if item.as_str().equals(target) { return true }
    }
    return false
}

/// The tests as an array of core's entries, run by core's `run_tests`.
///
/// CONSTRAINT: `args` is a placeholder `bool` until the released seed lets
/// core declare `@test`; then the array is `annotated<test>()`.
pub fun gen_test_main_src(names: List<String>): String {
    val entry = "AnnotatedFunction<bool, () -> void>"
    var src = String.from("import core.testing.run_tests\n\nfun main(): int32 {\n")
    src.append("    val tests: ${entry}[${names.size()}] = [\n")
    while name in &names {
        src.append("        ${entry} { name: \"${name}\", module: \"\", args: false, function: ${name} },\n")
    }
    src.append("    ]\n    return run_tests(&tests)\n}\n")
    return src
}

pub fun parse_test_main(src: str, smap: Ptr<SourceMap>): Module {
    val fid = unsafe { smap.add_file(new_source_file(String.from("<test-main>"), String.from(src))) }
    val toks = tokenize(src, fid)
    var p = new_parser(toks)
    var path = List.new<String>()
    path.push(String.from("test_main"))
    return p.parse_module(path)
}

/// Renames any `fun main` to `__user_main`, clear of the generated main.
pub fun rename_main_decls(modules: &var List<Module>): void {
    while mi in 0..modules.size() {
        val m = modules.at_mut(mi)
        while di in 0..m.decls.size() {
            val td = m.decls.at_mut(di)
            if td.is_fn_named_main() { td.name = intern("__user_main") }
        }
    }
}

fun TopDecl.is_fn_named_main(): bool {
    if !self.name.as_str().equals("main") { return false }
    return when (self.kind) {
        Function(_, _, _, _, _, _, _) => true
        _ => false
    }
}
