// The state `kflatc serve` keeps between requests, and the answer to each.

import alloc.list.*
import json.writer.*
import kf_assemble.Overlay
import kf_assemble.no_overlay
import kf_assemble.stage
import kf_assemble.unstage
import kf_core.diagnostic.*
import kf_core.ast.types.TypingNodes
import kf_core.ast.types.restore_type_nodes
import kf_driver.build.CompileUnit
import kf_driver.editor.TypedCrate
import kf_driver.editor.typed_crate_cached
import kf_driver.editor.DependencySignatures
import kf_driver.editor.no_dependency_signatures
import kf_driver.cli.render_json_diag
import kf_driver.count_errors
import kf_driver.kflat_version
import kf_driver.new_lint_config
import kf_driver.apply_option_row
import kf_driver.apply_table_lint
import kf_driver.build.InterfaceLookup
import kf_driver.build.check_crate
import kf_driver.build.interface_from_source
import kf_driver.build.interfaces_in
import std.fs.TempDir
import kf_driver.editor.focus
import kf_driver.editor.declaring_file
import kf_driver.build.crate_source_dir

/// The protocol versions this compiler speaks.
pub fun serve_protocol(): int64 {
    return 1
}

pub struct ServeSession {
    var greeted: bool
    var buffers: Overlay
    /// Typings for typed requests, kept until a buffer changes: the last
    /// for a question about one file, and the last for a search for uses.
    var focused: KeptTyping
    var searched: KeptTyping
    /// The dependencies' signatures, which outlive the typings across edits
    /// to the queried crate.
    var signatures: DependencySignatures
    /// Where `check` writes the interfaces of its `sources`: empty until
    /// the first needs it.
    var staged_interfaces: List<TempDir>
    /// Set by `shutdown`: the loop stops after answering it.
    pub var stopping: bool
}

impl ServeSession {
    pub static fun new(): ServeSession {
        return ServeSession {
            greeted: false, buffers: no_overlay(), focused: no_typing(), searched: no_typing(),
            signatures: no_dependency_signatures(), staged_interfaces: List.new<TempDir>(), stopping: false
        }
    }

    /// The one line answering `line`.
    pub mutating fun answer(line: str): String {
        val request = parse_request(line) ?: return error_line("null", "parse_error", "not a JSON object with a method")
        val id = request.id.as_str()
        val method = request.method.as_str()
        if method == "hello" { return self.hello(id, line) }
        if !self.greeted { return error_line(id, "not_ready", "the first request must be hello") }
        if is_typed_method(method) { return self.typed_answer(id, method, line) }
        return when method {
            "stage" => self.stage(id, line)
            "unstage" => self.unstage(id, line)
            "check" => self.check(id, line)
            "symbols" => outline_answer(id, method, line, &self.buffers)
            "folding" => outline_answer(id, method, line, &self.buffers)
            "selection" => outline_answer(id, method, line, &self.buffers)
            "shutdown" => {
                self.stopping = true
                result_line(id, "null")
            }
            _ => error_line(id, "unknown_method", "no method named `${method}`")
        }
    }

    mutating fun hello(id: str, line: str): String {
        var reader = params_of(line) ?: return invalid_params(id, "hello")
        var protocol: int64 = 0
        if !reader.begin_object() { return invalid_params(id, "hello") }
        while reader.object_has_next() {
            val key = reader.read_key()
            if key.as_str() == "protocol" { protocol = reader.read_int64() } else { reader.skip_value() }
        }
        if reader.has_error() { return invalid_params(id, "hello") }
        if protocol != serve_protocol() {
            val message = "this kflatc speaks protocol ${serve_protocol()}, not ${protocol}"
            return error_line(id, "unsupported_protocol", message.as_str())
        }
        self.greeted = true
        var writer = JsonWriter.object()
        writer.field_int64("protocol", serve_protocol())
        writer.field_string("compiler", kflat_version())
        return result_line(id, writer.finish().as_str())
    }

    mutating fun stage(id: str, line: str): String {
        val staged = read_path_and_text(line) ?: return invalid_params(id, "stage")
        self.buffers.stage(staged.path.as_str(), staged.text.as_str())
        self.focused = no_typing()
        self.searched = no_typing()
        return result_line(id, "null")
    }

    mutating fun unstage(id: str, line: str): String {
        val staged = read_path_and_text(line) ?: return invalid_params(id, "unstage")
        self.buffers.unstage(staged.path.as_str())
        self.focused = no_typing()
        self.searched = no_typing()
        return result_line(id, "null")
    }

    /// Types the crates once and answers every typed question about them
    /// from that, until a buffer changes. A question about one file needs
    /// only its bodies; a search for uses, those of every crate from the one
    /// declaring the target on, since no crate before it can name it.
    mutating fun typed_answer(id: str, method: str, line: str): String {
        val params = read_typed_params(line) ?: return invalid_params(id, method)
        if needs_offset(method) && params.offset < 0 { return invalid_params(id, method) }
        val key = params.key.as_str()
        val path = params.path.as_str()
        if searches_every_body(method) {
            val from = self.declaring_crate(&params)
            if !self.searched.answers(key, path, from, false) {
                // A second search among the same crates types them all, so a
                // third types nothing.
                val start = if self.searched.types(key) { 0 } else { from }
                self.searched = self.typing(&params, start, false)
            }
            return typed_reply(id, method, &params, self.searched.crates.at_mut(0))
        }
        val last = params.crates.size() - 1
        if self.searched.answers(key, path, last, true) {
            return typed_reply(id, method, &params, self.searched.crates.at_mut(0))
        }
        if !self.focused.answers(key, path, last, true) { self.focused = self.typing(&params, last, true) }
        return typed_reply(id, method, &params, self.focused.crates.at_mut(0))
    }

    mutating fun typing(params: &TypedParams, bodies_from: uint64, focus_only: bool): KeptTyping {
        val path = params.path.as_str()
        val crate = typed_crate_cached(
            path, &self.buffers, &params.crates, bodies_from, focus_only, &var self.signatures
        )
        return kept_typing(crate, params.key.clone(), bodies_from, focus_only, params.path.clone())
    }

    /// The place among `params.crates` of the crate declaring what the name
    /// at the offset names, read from a typing of the file alone; 0, every
    /// crate, when that is not found.
    mutating fun declaring_crate(params: &TypedParams): uint64 {
        val last = params.crates.size() - 1
        if !self.focused.answers(params.key.as_str(), params.path.as_str(), last, true) {
            self.focused = self.typing(params, last, true)
        }
        val crate = self.focused.crates.at_mut(0)
        if !crate.focus(params.path.as_str()) { return 0 }
        val file = crate.declaring_file(params.offset as uint32)
        if file.is_empty() { return 0 }
        while i in 0..params.crates.size() {
            val item = params.crates.at(i)
            if file.as_str().starts_with("${crate_source_dir(item.root.as_str(), item.src.as_str())}/".as_str()) {
                return i
            }
        }
        return 0
    }

    mutating fun check(id: str, line: str): String {
        val params = read_check_params(line) ?: return invalid_params(id, "check")
        var config_diags = List.new<Diagnostic>()
        var cfg = new_lint_config()
        while row in &params.lints {
            val eq = row.index_of("=") ?: 0
            val name = row.substring(0, eq)
            val level = row.substring(eq + 1, row.byte_len())
            cfg.apply_table_lint("lint configuration", name.as_str(), level.as_str(), &var config_diags)
        }
        while row in &params.lint_options { cfg.apply_option_row(row.as_str(), &var config_diags) }
        val unit = CompileUnit {
            name: params.name.clone(), root: params.root.clone(), src: params.src.clone(), deps: List.new<String>(),
            dep_hashes: List.new<String>(), loads: params.loads.clone()
        }
        // The check's types are its own, and go when it returns.
        val nodes = TypingNodes.new()
        val previous = nodes.enter()
        val interfaces = self.write_sources(&params)
        val checked = unit.check_crate(&interfaces, &self.buffers, &cfg)
        restore_type_nodes(previous)
        if checked.failure.byte_len() > 0 { return error_line(id, "check_failed", checked.failure.as_str()) }
        var writer = JsonWriter.object()
        writer.field_int64("errors", (config_diags.size() + count_errors(&checked.diagnostics) as uint64) as int64)
        writer.key("diagnostics")
        writer.begin_array()
        while d in &config_diags { writer.write_raw(d.render_json_diag(checked.smap).as_str()) }
        while d in &checked.diagnostics { writer.write_raw(d.render_json_diag(checked.smap).as_str()) }
        writer.end_array()
        return result_line(id, writer.finish().as_str())
    }
}

impl ServeSession {
    /// Writes each of `sources`' interfaces from its staged text, in order,
    /// each read by the ones after it; a source that does not compile keeps
    /// the interface in the target directory.
    mutating fun write_sources(params: &CheckParams): InterfaceLookup {
        var lookup = interfaces_in(params.target_dir.as_str())
        if params.sources.is_empty() { return lookup }
        if self.staged_interfaces.is_empty() { self.staged_interfaces.push(TempDir.new("kflatc-serve")) }
        val dir = String.from(self.staged_interfaces[0].path().as_str())
        while source in &params.sources {
            val unit = CompileUnit {
                name: source.name.clone(), root: source.root.clone(), src: source.src.clone(), deps: List.new<String>(),
                dep_hashes: List.new<String>(), loads: source.loads.clone()
            }
            val staged = unit.interface_from_source(&lookup, &self.buffers)
            if !staged.failure.is_empty() { continue }
            write_file("${dir}/${source.name}.kfi".as_str(), staged.text.as_str())
            lookup = lookup.with_staged(dir.as_str(), source.name.as_str())
        }
        return lookup
    }
}

/// `method`'s answer from `crate`, focused on the file `params` names.
fun typed_reply(id: str, method: str, params: &TypedParams, crate: &var TypedCrate): String {
    if !crate.focus(params.path.as_str()) {
        return error_line(id, "not_in_crate", "`${params.path}` is not a file the last crate compiles")
    }
    val previous = crate.nodes.enter()
    val answer = typed_result(method, params, crate)
    restore_type_nodes(previous)
    return result_line(id, answer.as_str())
}

fun invalid_params(id: str, method: str): String {
    return error_line(id, "invalid_params", "`${method}` got params it cannot read")
}

struct StagedText {
    val path: String
    val text: String
}

/// `path` is required, `text` defaults to "": `unstage` sends none.
fun read_path_and_text(line: str): StagedText? {
    var reader = params_of(line) ?: return null
    if !reader.begin_object() { return null }
    var path = String.from("")
    var text = String.from("")
    while reader.object_has_next() {
        val key = reader.read_key()
        when key.as_str() {
            "path" => path = reader.read_string()
            "text" => text = reader.read_string()
            _ => reader.skip_value()
        }
    }
    if reader.has_error() || path.is_empty() { return null }
    return Option.Some(StagedText { path: path, text: text })
}
