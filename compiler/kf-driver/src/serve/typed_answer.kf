// The questions `kflatc serve` answers from the typed crates around a file.

import kf_driver.editor.TypedCrate
import kf_driver.editor.render_completion_json
import kf_driver.editor.render_hover_json
import kf_driver.editor.render_implementations_json
import kf_driver.editor.render_inlays_json
import kf_driver.editor.render_references_json
import kf_driver.editor.render_rename_json
import kf_driver.editor.render_signature_json
import kf_driver.editor.render_tokens_json

/// Whether `method` is answered from typed crates.
pub fun is_typed_method(method: str): bool {
    return when method {
        "hover" => true
        "signature" => true
        "references" => true
        "implementations" => true
        "completion" => true
        "rename" => true
        "inlays" => true
        "tokens" => true
        _ => false
    }
}

/// Whether `method` searches for uses, which a dependency's bodies hold too.
pub fun searches_every_body(method: str): bool {
    return method == "references" || method == "rename"
}

/// Whether `method` asks about a position, and so needs an `offset`.
pub fun needs_offset(method: str): bool {
    return method != "inlays" && method != "tokens"
}

/// The result for a typed `method`, with `crate` focused on the file.
pub fun typed_result(method: str, params: &TypedParams, crate: &TypedCrate): String {
    val path = params.path.as_str()
    val offset = params.offset as uint32
    return when method {
        "hover" => render_hover_json(path, offset, crate)
        "signature" => render_signature_json(path, offset, crate)
        "references" => render_references_json(path, offset, crate)
        "implementations" => render_implementations_json(path, offset, crate)
        "completion" => render_completion_json(path, offset, crate)
        "rename" => render_rename_json(path, offset, params.new_name.as_str(), crate)
        "inlays" => render_inlays_json(path, crate)
        _ => render_tokens_json(path, crate)
    }
}
