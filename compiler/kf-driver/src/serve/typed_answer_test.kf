import core.assert.assert_eq

@test
fun a_search_for_uses_types_every_crates_bodies(): void {
    assert_eq(searches_every_body("references"), true, "a dependency's bodies can hold uses")
}

@test
fun a_rename_types_every_crates_bodies(): void {
    assert_eq(searches_every_body("rename"), true, "a rename rewrites every use")
}

@test
fun a_hover_types_only_the_queried_crates_bodies(): void {
    assert_eq(searches_every_body("hover"), false, "a hover reads the dependencies' signatures")
}
