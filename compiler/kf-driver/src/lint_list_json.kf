// `kflatc lints --format=json`: the table as data, for an editor completing
// lint.toml.

import json.writer.JsonWriter
import kf_core.diagnostic.*

/// `{"groups": [...], "lints": [{name, group, level, default, description,
/// options: [{key, value, default, description}]}]}`, levels by name, in the
/// table's order.
pub fun lint_list_json(cfg: &LintConfig): String {
    var writer = JsonWriter.object()
    writer.key("groups")
    writer.begin_array()
    val groups = LintInfo.groups()
    while group in &groups { writer.write_string(group) }
    writer.end_array()
    writer.key("lints")
    writer.begin_array()
    val all = LintInfo.all()
    while group in &groups {
        while info in &all {
            if info.group.as_str() != group.as_str() { continue }
            writer.begin_object()
            writer.field_string("name", info.name)
            writer.field_string("group", info.group)
            writer.field_string("level", (cfg.configured_level(info.name)).name())
            writer.field_string("default", info.default.name())
            writer.field_string("description", info.description)
            writer.key("options")
            writer.begin_array()
            while option in &info.options {
                writer.begin_object()
                writer.field_string("key", option.key)
                writer.field_int64("value", cfg.options.get(info.name, option.key))
                writer.field_int64("default", option.default)
                writer.field_string("description", option.description)
                writer.end_object()
            }
            writer.end_array()
            writer.end_object()
        }
    }
    writer.end_array()
    return writer.finish()
}
