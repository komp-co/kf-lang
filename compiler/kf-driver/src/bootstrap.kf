import alloc.path.*
import std.fs.*
import std.process.*
import kf_driver.build.dialect_flags

fun run_checked(command: Command, failure: str): bool {
    val status = command.status()
    if status.success() { return true }
    runtime_println(failure)
    return false
}

fun compile_c(source: Path, output: Path): bool {
    val compiler = Command.new("cc")
    compiler.arg(dialect_flags())
    compiler.arg("-O2")
    compiler.arg(source.as_str())
    compiler.arg("-o")
    compiler.arg(output.as_str())
    return run_checked(compiler, "bootstrap: C compilation failed")
}

fun emit_compiler(compiler: Path, workspace: Path, output: Path): bool {
    val command = Command.new(compiler.as_str())
    command.arg("komp")
    command.arg(output.as_str())
    command.current_dir(workspace)
    return run_checked(command, "bootstrap: self-compilation failed")
}

fun files_equal(left: Path, right: Path): bool {
    val compare = Command.new("cmp")
    compare.arg("-s")
    compare.arg(left.as_str())
    compare.arg(right.as_str())
    return compare.status().success()
}

/// Build from the checked-in C seed and require byte-for-byte self-hosting.
pub fun verify_bootstrap(workspace_root: str): int32 {
    val workspace = Path.new(workspace_root)
    val temporary = TempDir.new("komp-bootstrap")
    val seed_source = workspace.join("bootstrap").join("komp.c")
    val seed_binary = temporary.path().join("komp0")
    val stage_one_source = temporary.path().join("stage1.c")
    val stage_one_binary = temporary.path().join("komp1")
    val stage_two_source = temporary.path().join("stage2.c")

    runtime_println("[1/4] compiling bootstrap seed")
    if !compile_c(seed_source, seed_binary) { return 1 }
    runtime_println("[2/4] compiling the current source with the seed")
    if !emit_compiler(seed_binary, workspace, stage_one_source) { return 1 }
    if !compile_c(stage_one_source, stage_one_binary) { return 1 }
    runtime_println("[3/4] recompiling with the self-hosted compiler")
    if !emit_compiler(stage_one_binary, workspace, stage_two_source) { return 1 }
    runtime_println("[4/4] checking the fixpoint and seed")
    if !files_equal(stage_one_source, stage_two_source) {
        runtime_println("bootstrap: fixpoint broken (stage1.c differs from stage2.c)")
        return 1
    }
    if !files_equal(stage_one_source, seed_source) {
        runtime_println("bootstrap: seed is stale (refresh bootstrap/komp.c)")
        return 1
    }
    runtime_println("bootstrap: fixpoint holds and seed is current")
    return 0
}
