// Member completion on a real crate on disk. Offsets are into the exact
// fixture text.

import kf_driver.build.typed_crate_for
import kf_driver.build.typed_crate_for_overlay
import core.assert.assert_eq
import kf_driver.integration.json_contains
import std.fs.scratch_path


extern "C" fun system(cmd: str): int32

fun completion_fixture_path(): str {
    return scratch_path("kf_query_completion/src/main.kf")
}

/// Two fields, a static and an instance method, and `p.shifted(1).x`.
fun prepare_completion_fixture(): void {
    unsafe { system("rm -rf ${scratch_path("kf_query_completion")} && mkdir -p ${scratch_path("kf_query_completion/src")}") }
    write_file(scratch_path("kf_query_completion/kf.toml"), "[project]\nname = \"query_completion\"\nkind = \"lib\"\n")
    var src = String.from("pub struct Point {\n")
    src.append("    pub val x: int32\n")
    src.append("    pub val y: int32\n")
    src.append("}\n")
    src.append("\n")
    src.append("impl Point {\n")
    src.append("    pub static fun origin(): Point {\n")
    src.append("        return Point { x: 0, y: 0 }\n")
    src.append("    }\n")
    src.append("\n")
    src.append("    pub fun shifted(by: int32): Point {\n")
    src.append("        return Point { x: self.x + by, y: self.y + by }\n")
    src.append("    }\n")
    src.append("}\n")
    src.append("\n")
    src.append("pub fun probe(): int32 {\n")
    src.append("    val p = Point { x: 1, y: 2 }\n")
    src.append("    return p.shifted(1).x\n")
    src.append("}\n")
    write_file(completion_fixture_path(), src.as_str())
}

fun completion_at(offset: uint32): String {
    prepare_completion_fixture()
    val crate = typed_crate_for(completion_fixture_path())
    return render_completion_json("main.kf", offset, &crate)
}

// Just past the `.` in `return p.shifted(1).x`.
fun after_first_dot(): uint32 { return 333 }

@test
fun completion_names_the_receivers_type(): void {
    val json = completion_at(after_first_dot())
    assert_eq(json_contains(json.as_str(), "\"receiver_type\":\"Point\""), true, "the type comes from the checker, not the spelling")
}

@test
fun completion_offers_the_fields(): void {
    val json = completion_at(after_first_dot())
    assert_eq(json_contains(json.as_str(), "\"label\":\"x\",\"kind\":\"field\",\"detail\":\"int32\""), true, "a field carries its written type")
    assert_eq(json_contains(json.as_str(), "\"label\":\"y\",\"kind\":\"field\""), true, "every field, not just the first")
}

@test
fun completion_offers_the_instance_methods(): void {
    val json = completion_at(after_first_dot())
    assert_eq(json_contains(json.as_str(), "\"label\":\"shifted\",\"kind\":\"method\",\"detail\":\"shifted(by: int32): Point\""), true, "a method carries its signature")
}

// A `static fun` is not offered after `p.`.
@test
fun completion_leaves_out_the_static_methods(): void {
    val json = completion_at(after_first_dot())
    assert_eq(json_contains(json.as_str(), "\"label\":\"origin\""), false, "a static is not reachable through a receiver")
}

// Past a partly typed name.
@test
fun completion_answers_past_a_partly_typed_member(): void {
    val json = completion_at(335)
    assert_eq(json_contains(json.as_str(), "\"prefix\":\"sh\""), true, "the partial name is reported back")
    assert_eq(json_contains(json.as_str(), "\"receiver_type\":\"Point\""), true, "and does not change the receiver")
}

// `p.shifted(1).`: the receiver is the call's result.
@test
fun completion_follows_a_chained_call(): void {
    val json = completion_at(344)
    assert_eq(json_contains(json.as_str(), "\"receiver_type\":\"Point\""), true, "a call's result is a receiver like any other")
    assert_eq(json_contains(json.as_str(), "\"label\":\"shifted\""), true, "with the same members")
}

// Off a member position no receiver is claimed; which names come back is
// query_scope_test.kf's question.
@test
fun completion_off_a_member_position_claims_no_receiver(): void {
    val json = completion_at(4)
    assert_eq(json_contains(json.as_str(), "\"receiver_type\":null"), true, "a cursor in a keyword completes no member")
}

@test
fun completion_is_silent_at_the_start_of_a_file(): void {
    val json = completion_at(0)
    assert_eq(json_contains(json.as_str(), "\"receiver_type\":null"), true, "byte 0 cannot follow a receiver")
}

@test
fun completion_is_silent_past_the_end_of_a_file(): void {
    val json = completion_at(9000)
    assert_eq(json_contains(json.as_str(), "\"receiver_type\":null"), true, "an offset past the end reads no dot")
}

@test
fun a_dot_is_found_past_a_partly_typed_name(): void {
    assert_eq(member_dot_before("p.sh", 4), 1 as uint32, "`p.sh|` completes the member after byte 1")
    assert_eq(member_dot_before("p.", 2), 1 as uint32, "so does `p.|`")
}

@test
fun a_name_with_no_dot_is_not_a_member_position(): void {
    assert_eq(member_dot_before("point", 5), 0 as uint32, "a bare name completes no member")
}

@test
fun a_dot_at_byte_zero_is_not_a_receiver(): void {
    // There is nothing before byte 0.
    assert_eq(member_dot_before(".x", 2), 0 as uint32, "a leading dot has no receiver")
}

/// Just past the `: ` of `pub val x: int32` on line 2.
fun at_a_type_annotation(): uint32 { return 33 }

@test
fun a_type_annotation_offers_the_builtin_types(): void {
    val json = completion_at(at_a_type_annotation())
    assert_eq(json_contains(json.as_str(), "\"label\":\"int32\",\"kind\":\"primitive\""), true, "a primitive is declared nowhere, so only this can offer it")
    assert_eq(json_contains(json.as_str(), "\"label\":\"bool\",\"kind\":\"primitive\""), true, "every builtin, not just the numeric ones")
}

@test
fun a_type_annotation_does_not_offer_a_function(): void {
    val json = completion_at(at_a_type_annotation())
    assert_eq(json_contains(json.as_str(), "\"label\":\"probe\""), false, "a function cannot be a type")
}

@test
fun a_type_annotation_still_offers_a_declared_type(): void {
    val json = completion_at(at_a_type_annotation())
    assert_eq(json_contains(json.as_str(), "\"label\":\"Point\",\"kind\":\"struct\""), true, "filtering to types must keep the types")
}

@test
fun the_top_level_offers_item_keywords(): void {
    val json = completion_at(0)
    assert_eq(json_contains(json.as_str(), "\"label\":\"fun\",\"kind\":\"keyword\""), true, "a keyword is the only thing that can start a declaration")
    assert_eq(json_contains(json.as_str(), "\"label\":\"pub\",\"kind\":\"keyword\""), true, "including the modifiers")
}

@test
fun the_top_level_does_not_offer_a_statement_keyword(): void {
    val json = completion_at(0)
    assert_eq(json_contains(json.as_str(), "\"label\":\"return\""), false, "`return` cannot appear between declarations")
}

@test
fun a_colon_puts_the_cursor_in_a_type_position(): void {
    assert_eq(pos_is_type(completion_pos_at("val x: ", 7)), true, "an annotation takes a type")
}

@test
fun a_cast_puts_the_cursor_in_a_type_position(): void {
    // `as` inside a body is still a type position.
    assert_eq(pos_is_type(completion_pos_at("fun f() { val y = x as ", 23)), true, "a cast names a type")
}

@test
fun an_impl_target_is_a_type_position(): void {
    assert_eq(pos_is_type(completion_pos_at("impl ", 5)), true, "an impl target is a type, at brace depth zero")
}

@test
fun an_open_brace_puts_the_cursor_in_an_expression(): void {
    assert_eq(pos_is_expr(completion_pos_at("fun f() {\n    ", 14)), true, "inside a body")
}

@test
fun a_brace_inside_a_string_does_not_open_a_block(): void {
    assert_eq(pos_is_item(completion_pos_at("val s = \"{\"\n", 12)), true, "a brace in a literal is text, not a block")
}
