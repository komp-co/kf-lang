// Selection ranges: the spans covering the offset, innermost outward, ending
// at the declaration. Parse-only, since it is asked on every keystroke.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import json.writer.*

/// `{"schema_version":1,"file":..,"offset":N,"ranges":[..]}`, innermost
/// first; empty outside every declaration.
pub fun render_selection_json(path: str, offset: uint32, m: &Module): String {
    val out = new_json_writer()
    out.field_uint32("schema_version", 1)
    out.field_string("file", path)
    out.field_uint32("offset", offset)
    val chain = m.selection_chain(1, offset)
    val arr = new_json_array_writer()
    while span in &chain {
        val o = new_json_writer()
        o.field_uint32("byte_start", span.start)
        o.field_uint32("byte_end", span.end)
        arr.item_raw(o.finish().as_str())
    }
    out.field_raw("ranges", arr.finish().as_str())
    return out.finish()
}

pub fun run_selection_query(path: str, offset: uint32, overlay_path: str): int32 {
    val m = query_parse_file(path, overlay_path)
    val json = render_selection_json(path, offset, &m)
    runtime_println(json.as_str())
    return 0
}

/// Narrowest first, without duplicates: a parenthesised expression shares
/// its contents' span.
pub fun Module.selection_chain(file_id: uint32, offset: uint32): List<Span> {
    val covering = self.covering_spans(file_id, offset)
    var out = List.new<Span>()
    while true {
        val next = narrowest_span_not_in(&covering, &out)
        if next.end <= next.start { break }
        out.push(next)
    }
    return out
}

/// An empty span when all are taken.
fun narrowest_span_not_in(covering: &List<CoveringSpan>, taken: &List<Span>): Span {
    var best = no_span()
    while c in &covering {
        if !span_list_has(taken, &c.span) {
            if best.span_extent() == 0 || c.span.span_extent() < best.span_extent() {
                best = c.span
            }
        }
    }
    return best
}

fun Span.span_extent(): uint32 {
    if self.end <= self.start { return 0 }
    return self.end - self.start
}

fun span_list_has(spans: &List<Span>, span: &Span): bool {
    while s in &spans {
        if s.start == span.start && s.end == span.end { return true }
    }
    return false
}
