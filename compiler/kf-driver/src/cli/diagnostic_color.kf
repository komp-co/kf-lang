// Whether diagnostics are colored. Decided in the driver, not the renderer,
// which stays tty-free and plain for every existing caller.

extern "C" fun kf_stdout_is_tty(): bool
extern "C" fun kf_env_is_set(name: str): bool

/// Color for a person, plain for a pipe, file or CI log. `NO_COLOR` (set and
/// non-empty) wins even on a tty, which is the case it exists for.
pub fun color_enabled(): bool {
    if unsafe { kf_env_is_set("NO_COLOR") } { return false }
    return unsafe { kf_stdout_is_tty() }
}
