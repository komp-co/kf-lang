// The `kflatc` command line: the compiler on its own, one crate at a time or,
// with `unity`, a list of them. komp works out every argument; see the kflatc
// section of the book's CLI chapter for what each means.
//
//   kflatc compile --name N --root DIR [--src DIR] --out DIR [--project DIR]
//                  [--bin | --tests [--entry-file FILE]]
//                  [--dep NAME=HASH]... [--load NAME]...
//   kflatc check   --name N --root DIR [--src DIR] --out DIR [--project DIR] [--format=json | --summary]
//                  [--dep NAME=HASH]... [--load NAME]...
//   kflatc lints   [--format=json] [-A/-W/-D LINT ...]
//   kflatc unity   --crate NAME=ROOT... [--crate-src NAME=DIR]... --out FILE [--project DIR]
//                  [--bin | --tests] [--entry-file FILE]
//
// A crate's sources are the `.kf` files under `--src`, `<root>/src` without it.
// `--entry-file` adds a file whose `main` is the program's, the crate's own
// set aside: a test program's main comes from whoever builds it.
//   kflatc serve      (kf-query's, dispatched by the kflatc binary)
//   kflatc version
//
// Exit 0 on success, 1 when the crate has errors, 2 on a malformed line.

import kf_core.diagnostic.Diagnostics

import kf_driver.note_crate_being_built
import kf_driver.print_lint_table
import kf_driver.build.*
import kf_driver.kflat_version
import kf_interface.interface_compiler_abi
import kf_interface.interface_runtime_abi
import kf_interface.interface_target

extern "C" fun kf_mute_warnings(on: int32): void

pub fun kflatc_cli(): int32 {
    if Args.count() == 0 { return kflatc_usage() }
    val command = Args.at(0)
    if command == "version" { return print_version("kflatc") }
    if command == "lints" { return print_lint_table() }
    if command != "compile" && command != "check" && command != "unity" { return kflatc_usage() }
    var name: str = ""
    var root: str = ""
    var src: str = ""
    var entry_file: str = ""
    var out: str = ""
    var is_bin = false
    var as_json = false
    var with_tests = false
    var summary = false
    var deps = List.new<String>()
    var hashes = List.new<String>()
    var loads = List.new<String>()
    var crates = List.new<CrateSource>()
    var crate_srcs = List.new<String>()
    var i = 1
    while i < Args.count() {
        val flag = Args.at(i)
        if flag == "--bin" || flag == "--format=json" || flag == "--tests" || flag == "--summary" {
            if flag == "--bin" {
                is_bin = true
            } else if flag == "--format=json" {
                as_json = true
            } else if flag == "--summary" {
                summary = true
            } else {
                with_tests = true
            }
            i = i + 1
            continue
        }
        // Read off the command line by the lint config and the reporter.
        if flag == "-q" || flag == "--quiet" || flag == "--deny-warnings" || flag == "--update-lint-baseline" {
            i = i + 1
            continue
        }
        if flag == "-A" || flag == "-W" || flag == "-D" || flag == "--lint" || flag == "--lint-toml" ||
            flag == "--lint-toml-error" || flag == "--lint-toml-option" || flag == "--lint-baseline" {
            i = i + 2
            continue
        }
        if i + 1 >= Args.count() { return kflatc_usage() }
        val value = Args.at(i + 1)
        when flag {
            "--name" => name = value
            "--root" => root = value
            "--src" => src = value
            "--entry-file" => entry_file = value
            "--out" => out = value
            "--project" => note_crate_being_built(value)
            "--crate" => {
                val eq = value.index_of("=") ?: return kflatc_usage()
                crates.push(CrateSource {
                    name: value.substring(0, eq),
                    root: value.substring(eq + 1, value.byte_len()),
                    src: String.from("")
                })
            }
            "--crate-src" => {
                if value.index_of("=") == null { return kflatc_usage() }
                crate_srcs.push(String.from(value))
            }
            "--load" => loads.push(String.from(value))
            "--dep" => {
                val eq = value.index_of("=") ?: return kflatc_usage()
                deps.push(value.substring(0, eq))
                hashes.push(value.substring(eq + 1, value.byte_len()))
            }
            _ => return kflatc_usage()
        }
        i = i + 2
    }
    if command == "unity" {
        if crates.size() == 0 || out.byte_len() == 0 { return kflatc_usage() }
        crates = with_source_dirs(&crates, &crate_srcs)
        if with_tests { unsafe { kf_mute_warnings(1) } }
        return if compile_unity_crates(&crates, is_bin, with_tests, entry_file, out) == 0 { 0 } else { 1 }
    }
    if name.byte_len() == 0 || root.byte_len() == 0 || out.byte_len() == 0 { return kflatc_usage() }
    val crate = CompileUnit {
        name: String.from(name), root: String.from(root), src: String.from(src), deps: deps, dep_hashes: hashes,
        loads: loads
    }
    if command == "check" {
        return if crate.check_against_interfaces(out, as_json, summary) == 0 { 0 } else { 1 }
    }
    var errors = Diagnostics.new()
    if with_tests {
        unsafe { kf_mute_warnings(1) }
        if !crate.write_test_sources(out, entry_file, &var errors) { return 1 }
        return 0
    }
    if !crate.write_crate_sources(out, is_bin, &var errors) {
        println("kflatc: errors found; ${name} not written")
        return 1
    }
    return 0
}

/// `crates`, each named by a `NAME=DIR` row of `--crate-src` reading its
/// sources from DIR.
fun with_source_dirs(crates: &List<CrateSource>, rows: &List<String>): List<CrateSource> {
    var out = List.new<CrateSource>()
    while item in &crates {
        var src = String.from("")
        while row in &rows {
            val eq = row.index_of("=") ?: 0
            if row.substring(0, eq).as_str() == item.name.as_str() { src = row.substring(eq + 1, row.byte_len()) }
        }
        out.push(CrateSource { name: item.name.clone(), root: item.root.clone(), src: src })
    }
    return out
}

/// One `key value` line each, which komp reads to know what it is running;
/// `tool` names the program, as the first line's key.
pub fun print_version(tool: str): int32 {
    println("${tool} ${kflat_version()}")
    println("abi ${interface_compiler_abi()}")
    println("runtime ${interface_runtime_abi()}")
    println("target ${interface_target()}")
    return 0
}

fun kflatc_usage(): int32 {
    println("usage: kflatc compile --name N --root DIR [--src DIR] --out DIR [--project DIR]")
    println("                      [--bin | --tests [--entry-file FILE]]")
    println("                      [--dep NAME=HASH]... [--load NAME]...")
    println("       kflatc check   --name N --root DIR [--src DIR] --out DIR [--project DIR]")
    println("                      [--format=json | --summary]")
    println("                      [--dep NAME=HASH]... [--load NAME]...")
    println("       kflatc lints   [--format=json]")
    println("       kflatc unity   --crate NAME=ROOT... [--crate-src NAME=DIR]... --out FILE [--project DIR]")
    println("                      [--bin | --tests] [--entry-file FILE]")
    println("       kflatc version")
    println("       kflatc serve")
    return 2
}
