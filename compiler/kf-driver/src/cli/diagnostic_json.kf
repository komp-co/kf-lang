// Diagnostics as JSON for editors, one object per line.

import json.writer.*
import kf_core.diagnostic.*
import kf_core.span.*

/// A stable JSON object. Byte offsets are zero-based and end-exclusive; line
/// and column one-based when known. `schema_version` 2 added `code`, the lint
/// or null; 3 added `secondary`, the supporting labels with their own spans,
/// always an array.
pub fun Diagnostic.render_json_diag(smap: Ptr<SourceMap>): String {
    var writer = JsonWriter.object()
    writer.field_uint32("schema_version", 3)
    writer.field_string("severity", json_severity(self.severity))
    // The lint, or null; clients filter and suppress on it.
    if diag_is_lint(self) {
        writer.field_string("code", self.code.as_str())
    } else {
        writer.field_null("code")
    }
    writer.field_string("message", self.primary.message.as_str())
    writer.field_uint32("byte_start", self.primary.span.start)
    writer.field_uint32("byte_end", self.primary.span.end)
    when (unsafe { smap.span_to_location(self.primary.span) }) {
        Some(location) => {
            writer.field_string("file", location.file_path.as_str())
            writer.field_uint32("line", location.line)
            writer.field_uint32("column", location.col)
        }
        None => {
            writer.field_null("file")
            writer.field_null("line")
            writer.field_null("column")
        }
    }
    writer.field_raw("secondary", self.render_secondary_labels(smap).as_str())
    // Null on most diagnostics.
    if fix_has_repair(&self.fix) {
        writer.field_raw("fix", self.fix.render_fix(smap).as_str())
    } else {
        writer.field_null("fix")
    }
    return writer.finish()
}

/// The supporting labels, in order; each has its own span, often in another
/// file.
fun Diagnostic.render_secondary_labels(smap: Ptr<SourceMap>): String {
    var arr = JsonWriter.array()
    while item in &self.secondary {
        arr.write_raw(item.render_label(smap).as_str())
    }
    return arr.finish()
}

fun Label.render_label(smap: Ptr<SourceMap>): String {
    var w = JsonWriter.object()
    w.field_string("message", self.message.as_str())
    w.field_uint32("byte_start", self.span.start)
    w.field_uint32("byte_end", self.span.end)
    when (unsafe { smap.span_to_location(self.span) }) {
        Some(location) => {
            w.field_string("file", location.file_path.as_str())
            w.field_uint32("line", location.line)
            w.field_uint32("column", location.col)
        }
        None => {
            w.field_null("file")
            w.field_null("line")
            w.field_null("column")
        }
    }
    return w.finish()
}

/// `{"title":"..","replacement":"..","byte_start":N,"byte_end":N,"file":..}`.
/// The exact bytes to overwrite; a fix names its own file.
fun Fix.render_fix(smap: Ptr<SourceMap>): String {
    var w = JsonWriter.object()
    w.field_string("title", self.title.as_str())
    w.field_string("replacement", self.replacement.as_str())
    w.field_string("applicability", json_applicability(self.applicability))
    w.field_uint32("byte_start", self.span.start)
    w.field_uint32("byte_end", self.span.end)
    when (unsafe { smap.span_to_location(self.span) }) {
        Some(location) => w.field_string("file", location.file_path.as_str())
        None => w.field_null("file")
    }
    return w.finish()
}

pub fun Diagnostic.print_json_diag(smap: Ptr<SourceMap>): void {
    val line = self.render_json_diag(smap)
    runtime_println(line.as_str())
}

/// Only `machine-applicable` may be written unattended.
fun json_applicability(a: Applicability): str {
    return when (a) {
        MachineApplicable => "machine-applicable"
        MaybeIncorrect => "maybe-incorrect"
        HasPlaceholders => "has-placeholders"
    }
}

fun json_severity(severity: Severity): str {
    return when (severity) {
        Error => "error"
        Warning => "warning"
        Note => "note"
    }
}
