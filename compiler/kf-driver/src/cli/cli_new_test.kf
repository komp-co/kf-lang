import core.assert.assert_eq
import kf_driver.fresh_source_map
import kf_driver.collect_module_diags
import kf_driver.build.fresh_diag_list
import kf_driver.build.assemble_project
import std.fs.scratch_root

/// Scaffolds `name` under the scratch root, replacing any earlier one.
fun scaffold_in_scratch(name: str): String {
    val dir = "${scratch_root()}/${name}"
    val _rc = system("rm -rf ${dir}".as_str())
    new_project(dir.as_str())
    return dir
}

@test
fun a_new_project_checks_without_a_diagnostic(): void {
    val dir = scaffold_in_scratch("kf_new_clean")
    val smap = fresh_source_map()
    var merged = assemble_project(dir.as_str(), smap, fresh_diag_list())
    assert_eq(merged.collect_module_diags(smap).size(), 0, "the template is the first code a user reads")
}
