// The JSON line for an error with no source span, in the shape of every
// other diagnostic line.

import json.writer.*

/// For an error with no source span.
pub fun render_json_error(message: str): String {
    val writer = new_json_writer()
    writer.field_uint32("schema_version", 3)
    writer.field_string("severity", "error")
    writer.field_null("code")
    writer.field_string("message", message)
    writer.field_uint32("byte_start", 0)
    writer.field_uint32("byte_end", 0)
    writer.field_null("file")
    writer.field_null("line")
    writer.field_null("column")
    writer.field_raw("secondary", "[]")
    writer.field_null("fix")
    return writer.finish()
}
