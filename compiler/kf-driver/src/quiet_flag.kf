// Whether kflatc's command line asks for warnings to be silenced: `-q` or
// `--quiet`, before any `--`.

import core.args.arg_at
import core.args.arg_count

pub fun compiler_warnings_quiet(): bool {
    var i = 0
    var quiet = false
    while i < arg_count() {
        val arg = arg_at(i)
        if arg == "--" { return quiet }
        if arg == "-q" || arg == "--quiet" { quiet = true }
        i = i + 1
    }
    return quiet
}
