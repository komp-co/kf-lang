// What a lint does, resolved outside the pass that found it. Innermost wins:
//
//   1. the lint's registered default
//   2. lint.toml's rows, then kf.toml's [lint] table, which komp passes as
//      `--lint-toml` and `--lint` rows; a group's row sets each of its lints
//   3. CLI flags, -A/-W/-D by lint or group name
//   4. `@allow(<lint>)` on the enclosing declaration
//
// `--deny-warnings` promotes everything that survives.

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*

// Read straight off the command line.

/// kf.toml first, then CLI flags; later entries override.
pub struct LintConfig {
    pub var names: List<String>
    pub var levels: List<LintLevel>
    pub var deny_warnings: bool
    /// lint.toml's option rows, over the registry's defaults.
    pub var options: LintOptions
    /// `--lint-baseline`'s file, absolute; "" for none.
    pub var baseline_path: String
    /// `--update-lint-baseline`: rewrite the checked crate's rows.
    pub var update_baseline: bool
}

pub fun new_lint_config(): LintConfig {
    return LintConfig {
        names: List.new<String>(), levels: List.new<LintLevel>(), deny_warnings: false, options: LintOptions.none(),
        baseline_path: String.from(""), update_baseline: false
    }
}

/// Later callers win, so a CLI flag overrides kf.toml.
pub mutating fun LintConfig.set_lint_level(name: str, level: LintLevel): void {
    var i = 0
    while i < self.names.size() {
        if self.names.at(i).as_str().equals(name) {
            self.levels.set(i, level)
            return
        }
        i = i + 1
    }
    self.names.push(String.from(name))
    self.levels.push(level)
}

/// Every lint `group` names; see `is_lint_group`.
pub mutating fun LintConfig.set_group_level(group: str, level: LintLevel): void {
    val all = LintInfo.all()
    while info in &all {
        if info.in_group(group) { self.set_lint_level(info.name, level) }
    }
}

/// A lint's level, or every lint's in a group.
pub mutating fun LintConfig.set_level_of(name: str, level: LintLevel): void {
    if LintInfo.is_group(name) { self.set_group_level(name, level) } else { self.set_lint_level(name, level) }
}

/// The configured level for `name`, or its registered default.
pub fun LintConfig.configured_level(name: str): LintLevel {
    var i = 0
    while i < self.names.size() {
        if self.names.at(i).as_str().equals(name) { return *self.levels.at(i) }
        i = i + 1
    }
    return default_level_of(name)
}

fun default_level_of(name: str): LintLevel {
    return LintInfo.default_of(name)
}

/// Diagnostics without a code pass through, but `deny_warnings` reaches them
/// too.
pub fun apply_lint_levels(diags: List<Diagnostic>, m: &Module, cfg: &LintConfig): List<Diagnostic> {
    var out = List.new<Diagnostic>()
    while i in 0..diags.size() {
        val d = *diags.at(i)
        if !d.is_lint() {
            out.push(promote_if_denying(d, cfg))
            continue
        }
        val name = d.code.as_str()
        var level = cfg.configured_level(name)
        // The source has the last word.
        if m.declaration_allows(name, d.primary.span) { level = LintLevel.Allow }
        if level.is_allow() {
            continue
        }
        var lowered = d
        lowered.severity = level.severity()
        out.push(promote_if_denying(lowered, cfg))
    }
    return out
}

fun promote_if_denying(d: Diagnostic, cfg: &LintConfig): Diagnostic {
    if !cfg.deny_warnings { return d }
    var out = d
    when (out.severity) {
        Warning => out.severity = Severity.Error
        _ => { }
    }
    return out
}

/// By span: the diagnostic knows where its evidence was. Evidence outside
/// every declaration, such as an unused import, cannot be suppressed this
/// way.
fun Module.declaration_allows(name: str, span: Span): bool {
    if span.is_none() { return false }
    while td in &self.decls {
        if td.decl_covers(span) {
            if td.allows_lint(name) || td.member_allows(name, span) { return true }
        }
    }
    return false
}

/// An `@allow` on the impl or trait method the evidence is in.
fun TopDecl.member_allows(name: str, span: Span): bool {
    return when (self.kind) {
        ImplBlock(methods) => methods.any_allows(name, span)
        TraitImpl(_trait, methods) => methods.any_allows(name, span)
        TraitDecl(members, _pub, _supers) => members.any_allows(name, span)
        _ => false
    }
}

fun List<TopDecl>.any_allows(name: str, span: Span): bool {
    while member in &self {
        if member.decl_covers(span) && member.allows_lint(name) { return true }
    }
    return false
}

/// Between `span.start` (its `@`, `pub` or keyword) and `decl_end`.
fun TopDecl.decl_covers(span: Span): bool {
    if self.span.file_id != span.file_id { return false }
    if self.decl_end == 0 { return false }
    return span.start >= self.span.start && span.start < self.decl_end
}

fun TopDecl.allows_lint(name: str): bool {
    while allowed in &self.annotation_words("allow") {
        if allowed.as_str() == name { return true }
    }
    return false
}

/// `--lint NAME=LEVEL` and `--lint-toml NAME=LEVEL`: the rows of kf.toml's
/// `[lint]` table and of lint.toml, which komp reads and passes in the order
/// they apply. Each is reported as a row of the file it came from, and
/// `--lint-toml-error` as what komp found wrong with lint.toml's shape.
pub mutating fun LintConfig.apply_table_lint_flags(diags: &var List<Diagnostic>): void {
    while i in 0..Args.count() {
        val flag = Args.at(i)
        if flag == "--lint-toml-error" && i + 1 < Args.count() {
            val problem = Args.at(i + 1)
            diags.push(Diagnostic.error_at(Span.none(), String.from(problem)))
            continue
        }
        if flag == "--lint-toml-option" && i + 1 < Args.count() {
            self.apply_option_row(Args.at(i + 1), diags)
            continue
        }
        val origin = if flag == "--lint" { "kf.toml [lint]" } else if flag == "--lint-toml" { "lint.toml" } else { "" }
        if origin == "" || i + 1 >= Args.count() { continue }
        val row = Args.at(i + 1)
        when (row.index_of("=")) {
            Some(eq) => {
                val name = row.substring(0, eq)
                val level = row.substring(eq + 1, row.byte_len())
                self.apply_table_lint(origin, name, level, diags)
            }
            None => diags.push(Diagnostic.error_at(Span.none(), "`${flag} ${row}`: expected NAME=LEVEL"))
        }
    }
}

pub mutating fun LintConfig.apply_table_lint(origin: str, name: str, level: str, diags: &var List<Diagnostic>): void {
    if !LintInfo.exists(name) && !LintInfo.is_group(name) {
        diags.push(Diagnostic.error_at(Span.none(), "${origin}: no lint or lint group named `${name}`"))
    } else if !LintLevel.named(level).is_some() {
        val expected = "expected `allow`, `warn` or `deny`"
        diags.push(Diagnostic.error_at(Span.none(), "${origin}: `${name}` is set to `${level}`; ${expected}"))
    } else {
        self.set_level_of(name, (LintLevel.named(level) ?: LintLevel.Warn))
    }
}

/// `--lint-toml-option NAME.KEY=VALUE`: one of a lint's options, as
/// lint.toml sets it. The lint, the option and a whole-number value are
/// checked here, where the registry is.
pub mutating fun LintConfig.apply_option_row(row: str, diags: &var List<Diagnostic>): void {
    val eq = row.index_of("=") ?: 0
    val dot = row.index_of(".") ?: 0
    if eq == 0 || dot == 0 || dot > eq {
        diags.push(Diagnostic.error_at(Span.none(), "`--lint-toml-option ${row}`: expected NAME.KEY=VALUE"))
        return
    }
    val name = row.substring(0, dot)
    val key = row.substring(dot + 1, eq)
    val text = row.substring(eq + 1, row.byte_len())
    if !LintInfo.exists(name.as_str()) {
        diags.push(Diagnostic.error_at(Span.none(), "lint.toml: no lint named `${name}`"))
    } else if LintInfo.option_of(name.as_str(), key.as_str()).is_none() {
        diags.push(Diagnostic.error_at(Span.none(), "lint.toml: `${name}` has no option `${key}`"))
    } else {
        val value = whole_number(text) ?: {
            diags.push(
                Diagnostic.error_at(Span.none(), "lint.toml: `${name}.${key}` is `${text}`; expected a whole number")
            )
            return
        }
        self.options.set(name, key, value)
    }
}

/// Decimal digits as a number; null for anything else, or none.
fun whole_number(text: str): int64? {
    if text.byte_len() == 0 || text.byte_len() > 18 { return null }
    var value: int64 = 0
    while i in 0..text.byte_len() {
        val byte = text.byte(i)
        if byte < 48 || byte > 57 { return null }
        value = value * 10 + (byte - 48) as int64
    }
    return Option.Some(value)
}

/// `-A/-W/-D <lint>` and `--deny-warnings`, over kf.toml. An unknown lint is
/// reported.
pub mutating fun LintConfig.apply_cli_lint_flags(diags: &var List<Diagnostic>): void {
    val n = Args.count()
    var i = 0
    while i < n {
        val a = Args.at(i)
        if a.equals("--deny-warnings") {
            self.deny_warnings = true
        }
        var level = LintLevel.Warn
        var is_flag = false
        when a {
            "-A" => { level = LintLevel.Allow; is_flag = true }
            "-W" => { level = LintLevel.Warn; is_flag = true }
            "-D" => { level = LintLevel.Deny; is_flag = true }
            _ => { }
        }
        if is_flag {
            if i + 1 >= n {
                diags.push(Diagnostic.error_at(Span.none(), "`${a}` expects a lint name"))
            } else {
                val name = Args.at(i + 1)
                if !LintInfo.exists(name) && !LintInfo.is_group(name) {
                    diags.push(Diagnostic.error_at(Span.none(), "`${a} ${name}`: no lint or lint group by that name"))
                } else {
                    self.set_level_of(name, level)
                }
                i = i + 1
            }
        }
        i = i + 1
    }
}

/// For a build: the `[lint]` rows komp passed as `--lint`, then `-A/-W/-D`.
pub fun build_lint_config(): LintConfig {
    var cfg_diags = List.new<Diagnostic>()
    return project_lint_config(&var cfg_diags)
}

/// `build_lint_config`, keeping the problems the configuration itself has.
pub fun project_lint_config(diags: &var List<Diagnostic>): LintConfig {
    var cfg = new_lint_config()
    cfg.apply_table_lint_flags(diags)
    cfg.apply_cli_lint_flags(diags)
    cfg.load_baseline(diags)
    return cfg
}
