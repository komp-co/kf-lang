// Separate compilation of the real json project at `../json`, copied into
// scratch so the source-unavailable checks never touch it.

import core.assert.assert_eq

import kf_codegen.*
import kf_driver.*
import kf_driver.build.build_project_separate
import kf_driver.build.check_project_with_kflatc
import kf_driver.build.compile_project_separate
import kf_driver.testing.copy_tree_by_content
import std.fs.scratch_path

extern "C" fun system(cmd: str): int32
extern "C" fun access(path: str, mode: int32): int32

fun prepare_real_json_app(): int32 {
    val prep = unsafe { system("rm -rf ${scratch_path("kf_sc4_json_dep")} ${scratch_path("kf_sc4_json_app")} ${scratch_path("kf_sc4_libs")} && mkdir -p ${scratch_path("kf_sc4_json_app/src")} ${scratch_path("kf_sc4_libs")} && cp -R libs/core ${scratch_path("kf_sc4_libs/core")} && cp -R libs/alloc ${scratch_path("kf_sc4_libs/alloc")}") }
    if prep != 0 { return prep }
    // By content: `../json` may be a symlink, which `cp -R` would recreate.
    val copied = copy_tree_by_content("../json", scratch_path("kf_sc4_json_dep"))
    if copied != 0 { return copied }
    write_file(scratch_path("kf_sc4_json_dep/kf.toml"), """[project]
name = "json"
version = "0.1.0"
kind = "lib"

[dependencies]
core = { path = "../kf_sc4_libs/core" }
alloc = { path = "../kf_sc4_libs/alloc" }
""")
    write_file(scratch_path("kf_sc4_json_app/kf.toml"), """[project]
name = "json_app"
kind = "bin"

[dependencies]
json = { path = "../kf_sc4_json_dep" }
""")
    write_file(scratch_path("kf_sc4_json_app/src/main.kf"), """import json.writer.*

fun main(): int32 {
    var writer = new_json_writer()
    writer.field_string("message", "ok")
    val object = writer.finish()
    val escaped = json_quote("say \"hi\"")
    if object.as_str() == "{\"message\":\"ok\"}" && escaped.as_str() == "\"say \\\"hi\\\"\"" { return 0 }
    return 1
}
""")
    return 0
}

fun build_real_json_app(): int32 {
    val prep = prepare_real_json_app()
    if prep != 0 { return prep }
    return build_project_separate(scratch_path("kf_sc4_json_app"), "-fsanitize=address")
}

@test
fun real_json_project_builds_into_archive(): void {
    assert_eq(build_real_json_app(), 0, "real json project builds separately")
}

@test
fun real_json_library_archive_exists(): void {
    val _rc = build_real_json_app()
    assert_eq(unsafe { access(scratch_path("kf_sc4_json_app/target/kflat/libjson.a"), 0) }, 0, "real json produces libjson.a")
}

@test
fun real_json_interface_exists(): void {
    val _rc = build_real_json_app()
    assert_eq(unsafe { access(scratch_path("kf_sc4_json_app/target/kflat/json.kfi"), 0) }, 0, "real json produces json.kfi")
}

@test
fun real_json_consumer_checks_without_dependency_source(): void {
    val first = build_real_json_app()
    // Safe only on the disposable copy, rebuilt by the next prepare.
    val hidden = unsafe { system("mv ${scratch_path("kf_sc4_json_dep/src")} ${scratch_path("kf_sc4_json_dep/src.hidden")}") }
    val checked = check_project_with_kflatc(scratch_path("kf_sc4_json_app"), false)
    val restored = unsafe { system("mv ${scratch_path("kf_sc4_json_dep/src.hidden")} ${scratch_path("kf_sc4_json_dep/src")}") }
    assert_eq(first == 0 && hidden == 0 && checked == 0 && restored == 0, true, "consumer checks from json.kfi with dependency source unavailable")
}

@test
fun real_json_consumer_builds_without_dependency_source(): void {
    val first = build_real_json_app()
    val hidden = unsafe { system("mv ${scratch_path("kf_sc4_json_dep/src")} ${scratch_path("kf_sc4_json_dep/src.hidden")}") }
    // Recompile the consumer against artifacts alone.
    val _fresh = unsafe { system("rm -f ${scratch_path("kf_sc4_json_app/target/kflat/json_app.artifact.toml")}") }
    val rebuilt = build_project_separate(scratch_path("kf_sc4_json_app"), "-fsanitize=address")
    val ran = unsafe { system(scratch_path("kf_sc4_json_app/target/kflat/json_app")) }
    val restored = unsafe { system("mv ${scratch_path("kf_sc4_json_dep/src.hidden")} ${scratch_path("kf_sc4_json_dep/src")}") }
    assert_eq(first == 0 && hidden == 0 && rebuilt == 0 && ran == 0 && restored == 0, true, "consumer rebuilds and runs from compiled json artifacts")
}

@test
fun source_and_interface_consumer_c_are_identical(): void {
    // Against json.kfi and from dependency source.
    val first = build_real_json_app()
    val interface_c = read_file(scratch_path("kf_sc4_json_app/target/kflat/json_app.c"))
    val errp: Ptr<ErrCount> = unsafe { alloc<ErrCount>() }
    unsafe { *errp = ErrCount { n: 0 } }
    val outputs = compile_project_separate(scratch_path("kf_sc4_json_app"), errp)
    val clean = unsafe { errp.n } == 0
    val source_c = outputs.at(outputs.size() - 1).source
    val setup_ok = first == 0 && clean && outputs.size() > 0
    assert_eq(setup_ok && source_c.as_str() == interface_c.as_str(), true, "source and interface semantics emit identical consumer C")
}

@test
fun real_json_quote_runs_from_archive(): void {
    val _rc = build_real_json_app()
    assert_eq(unsafe { system(scratch_path("kf_sc4_json_app/target/kflat/json_app")) }, 0, "json_quote runs from the real archive")
}

@test
fun real_json_consumer_has_no_json_quote_body(): void {
    val _rc = build_real_json_app()
    val app_c = read_file(scratch_path("kf_sc4_json_app/target/kflat/json_app.c"))
    assert_eq(json_contains(app_c.as_str(), "String json__json_quote(const char* __value) {"), false, "consumer contains no dependency body")
}

@test
fun real_json_writer_glue_is_owned_by_the_json_archive(): void {
    val _rc = build_real_json_app()
    val header = read_file(scratch_path("kf_sc4_json_app/target/kflat/json.h"))
    val owner = read_file(scratch_path("kf_sc4_json_app/target/kflat/json.c"))
    val consumer = read_file(scratch_path("kf_sc4_json_app/target/kflat/json_app.c"))
    val prototype = json_contains(header.as_str(), "void json__JsonWriter__glue_drop(json__JsonWriter v);")
    val definition = json_contains(owner.as_str(), "void json__JsonWriter__glue_drop(json__JsonWriter v) {")
    val duplicate = json_contains(consumer.as_str(), "void json__JsonWriter__glue_drop(json__JsonWriter v) {")
    assert_eq(prototype && definition && !duplicate, true, "real json ownership glue lives in its archive")
}

pub fun json_contains(s: str, needle: str): bool {
    val sl = s.byte_len()
    val nl = needle.byte_len()
    if nl == 0 { return true }
    if sl < nl { return false }
    var i: uint64 = 0
    while i + nl <= sl {
        var ok = true
        var j: uint64 = 0
        while j < nl {
            if s.byte_at(i + j) != needle.byte_at(j) { ok = false }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}
