import core.assert.assert_eq
import alloc.list.*

import kf_core.ast.Module
import kf_driver.fresh_source_map
import testing.test

fun entry_module(): Module {
    return parse_entry_source("main_entry.kf", "fun main(): int32 { return 0 }\n", fresh_source_map())
}

@test fun an_entry_file_defines_main(): void {
    val m = entry_module()
    assert_eq(m.decls.at(m.decls.size() - 1).name.as_str(), "main", "its main is the program's")
}

@test fun an_entry_file_is_the_module_entry(): void {
    assert_eq(entry_module().path.at(0).as_str(), "entry", "clear of every module of the crate")
}

@test fun the_crate_main_is_set_aside(): void {
    var modules = List.new<Module>()
    modules.push(parse_entry_source("own.kf", "fun main(): void { }\n", fresh_source_map()))
    rename_main_decls(&var modules)
    assert_eq(modules.at(0).decls.at(0).name.as_str(), "__user_main", "out of the entry's way")
}
