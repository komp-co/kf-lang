// The crate dependency graph for separate builds: walks manifests from the
// root, canonicalizes and deduplicates dependency paths, reports a complete
// cycle, and yields a deterministic dependencies-first order.

import alloc.list.*

import kf_driver.project.*
import kf_shared.absolutize
import kf_shared.normalized_path
import kf_shared.canonicalize_path

extern "C" fun access(path: str, mode: int32): int32
// The compiler binary's directory, to find the bundled stdlib.
extern "C" fun kf_self_dir(): String

pub struct BuildCrate {
    pub val name: String
    pub val root: String
    pub val is_bin: bool
    pub val deps: List<String>
    /// Every crate `deps` reach, dependencies first: the interfaces kflatc
    /// loads to compile this one.
    pub val loads: List<String>
    /// C sources relative to `root`, from `[native] c_sources`.
    pub val c_sources: List<String>
    /// `[native] hosted_c_sources`, as this build uses them: a freestanding
    /// root empties them for every crate, decided once here.
    pub val hosted_c_sources: List<String>
}

/// `crates` is dependencies-first and deterministic, the root last. `cycle` is
/// "" for a DAG, else the full cycle as "a -> b -> a".
pub struct BuildGraph {
    pub val crates: List<BuildCrate>
    pub val cycle: String
    /// The root's `freestanding = true`: a property of the program, since a
    /// library cannot know whether what links it has an operating system.
    pub val freestanding: bool
    pub val error: String
}

pub fun build_crate_graph(root_dir: str): BuildGraph {
    var crates = List.new<BuildCrate>()
    var cycle = ""
    var error = ""
    var in_progress = List.new<String>()
    var done = List.new<String>()
    val root = canonicalize_path(absolutize(root_dir).as_str())
    val freestanding = root_is_freestanding(root.as_str())
    visit_crate(root, freestanding, &var crates, &var cycle, &var error, &var in_progress, &var done)
    if error.as_str() != "" { crates = List.new<BuildCrate>() }
    return BuildGraph { crates: crates, cycle: cycle, freestanding: freestanding, error: error }
}

/// From the root manifest alone.
fun root_is_freestanding(root: str): bool {
    var manifest_path = String.from(root)
    manifest_path.append("/kf.toml")
    if unsafe { access(manifest_path.as_str(), 0) } != 0 { return false }
    return parse_manifest(read_file(manifest_path.as_str()).as_str()).freestanding
}

fun visit_crate(root: String, freestanding: bool, crates: &var List<BuildCrate>, cycle: &var String, error: &var String, in_progress: &var List<String>, done: &var List<String>): void {
    if error.as_str() != "" { return }
    if cycle.cycle_found() { return }
    if path_list_has(done, root.as_str()) { return }
    if path_list_has(in_progress, root.as_str()) {
        cycle.record_cycle(in_progress, root.as_str())
        return
    }
    val manifest_path = root.clone() + String.from("/kf.toml")
    if unsafe { access(manifest_path.as_str(), 0) } != 0 {
        (*error) = "error: no kf.toml manifest found at ${manifest_path}"
        return
    }
    val manifest_src = read_file(manifest_path.as_str())
    val mf = parse_manifest(manifest_src.as_str())
    if mf.error.as_str() != "" {
        (*error) = "error: invalid manifest ${manifest_path}: ${mf.error}"
        return
    }
    in_progress.push(root.clone())
    val eff_deps = mf.effective_deps(root.as_str())
    var dep_names = List.new<String>()
    while eff_dep in &eff_deps {
        // Cloned: `get` aliases the dependency's Strings.
        val dep_path = eff_dep.path.clone()
        val dep_root = resolve_dep_root(root.as_str(), dep_path.as_str())
        // The crate name comes from its own manifest; the dependency key is an
        // alias.
        val dep_manifest = dep_root.clone() + String.from("/kf.toml")
        visit_crate(dep_root.clone(), freestanding, crates, cycle, error, in_progress, done)
        if cycle.cycle_found() || error.as_str() != "" { return }
        if unsafe { access(dep_manifest.as_str(), 0) } == 0 {
            val dep_mf = parse_manifest(read_file(dep_manifest.as_str()).as_str())
            dep_names.push(String.from(dep_mf.name.as_str()))
        }
    }
    in_progress.pop()
    done.push(root.clone())
    val is_bin = mf.kind.as_str() == "bin"
    val c_sources = manifest_c_sources(manifest_src.as_str())
    // A freestanding program takes no crate's hosted half.
    var hosted_c_sources = List.new<String>()
    if !freestanding { hosted_c_sources = manifest_hosted_c_sources(manifest_src.as_str()) }
    val loads = crates.closure_of(&dep_names)
    crates.push(BuildCrate {
        name: String.from(mf.name.as_str()), root: root, is_bin: is_bin, deps: dep_names, loads: loads,
        c_sources: c_sources, hosted_c_sources: hosted_c_sources
    })
}

/// The crates `names` reach, in graph order, which puts each after its own
/// dependencies. Every one of them is already in the list.
fun List<BuildCrate>.closure_of(names: &List<String>): List<String> {
    var wanted = List.new<String>()
    while name in &names {
        wanted.push(name.clone())
    }
    while item in &self {
        if name_listed(&wanted, item.name.as_str()) {
            while dep in &item.loads {
                if !name_listed(&wanted, dep.as_str()) { wanted.push(dep.clone()) }
            }
        }
    }
    var ordered = List.new<String>()
    while item in &self {
        if name_listed(&wanted, item.name.as_str()) { ordered.push(item.name.clone()) }
    }
    return ordered
}

fun name_listed(names: &List<String>, name: str): bool {
    while item in &names {
        if item.as_str() == name { return true }
    }
    return false
}

// Declared dependencies, plus `core` and `alloc` for a dependency-free hosted
// crate from the bundled sysroot (`<self_dir>/../libs`). A crate with
// dependencies inherits their tier; injecting another core would duplicate
// trait impls. A crate naming `core` or `alloc` manages its own tier.
fun Manifest.effective_deps(crate_root: str): List<Dependency> {
    var out = List.new<Dependency>()
    val cname = self.name.as_str()
    val declares_stdlib = deps_have_alias(&self.deps, "core") || deps_have_alias(&self.deps, "alloc")
    if cname != "core" && cname != "alloc" && !declares_stdlib && self.deps.size() == 0 {
        val libs = bundled_libs_root(crate_root)
        if libs.as_str().byte_len() > 0 {
            out.push(new_dependency(String.from("core"), libs.clone() + String.from("/core")))
            out.push(new_dependency(String.from("alloc"), libs.clone() + String.from("/alloc")))
        }
    }
    while dep in &self.deps {
        out.push(new_dependency(dep.name.clone(), dep.path.clone()))
    }
    return out
}

// Beside the executable when installed; the repository's `libs` for a
// compiler running from elsewhere during development.
pub fun bundled_libs_root(crate_root: str): String {
    val base = kf_self_dir()
    if base.as_str().byte_len() > 0 {
        val beside = base + String.from("/../libs")
        val manifest = beside.clone() + String.from("/core/kf.toml")
        if unsafe { access(manifest.as_str(), 0) } == 0 {
            return canonicalize_path(beside.as_str())
        }
    }
    if unsafe { access("libs/core/kf.toml", 0) } == 0 {
        return canonicalize_path(absolutize("libs").as_str())
    }
    // Normalized, so `komp check .` does not collapse to "".
    var here = normalized_path(crate_root)
    var depth = 0
    while depth < 16 {
        val candidate = here.clone() + String.from("/libs")
        val manifest = candidate.clone() + String.from("/core/kf.toml")
        if unsafe { access(manifest.as_str(), 0) } == 0 {
            return canonicalize_path(candidate.as_str())
        }
        val parent = parent_path(here.as_str())
        if parent.as_str() == here.as_str() { return "" }
        here = parent
        depth = depth + 1
    }
    return ""
}

fun deps_have_alias(deps: &List<Dependency>, alias: str): bool {
    while dep in &deps {
        if dep.name.as_str() == alias { return true }
    }
    return false
}

mutating fun String.cycle_found(): bool {
    return self.as_str().byte_len() > 0
}

// Every stack entry from `target`'s first occurrence, closed by `target`.
mutating fun String.record_cycle(in_progress: &var List<String>, target: str): void {
    var out = ""
    var started = false
    while p in &in_progress {
        if p.as_str() == target { started = true }
        if started {
            out = out + p + String.from(" -> ")
        }
    }
    out = out + String.from(target)
    (*self) = out
}

fun path_list_has(paths: &var List<String>, target: str): bool {
    while path in &paths {
        if path.as_str() == target { return true }
    }
    return false
}

// A relative path resolves against the depending crate's canonical root.
fun resolve_dep_root(base: str, rel: str): String {
    val rn = rel.byte_len()
    if rn > 0 {
        if rel.byte_at(0) == 47 {
            return canonicalize_path(rel)
        }
    }
    val joined = String.from(base) + String.from("/") + String.from(rel)
    return canonicalize_path(joined.as_str())
}
