// What kflatc calls the files it writes into `--out`, and where it reads a
// dependency's interface. Part of its command line: komp reads them by
// these names, as the book's kflatc section lists them.

pub fun crate_interface_path(dir: str, crate_name: str): String {
    return "${dir}/${crate_name}.kfi"
}

pub fun crate_header_path(dir: str, crate_name: str): String {
    return "${dir}/${crate_name}.h"
}

pub fun crate_source_path(dir: str, crate_name: str): String {
    return "${dir}/${crate_name}.c"
}

pub fun runtime_header_path(dir: str): String {
    return "${dir}/kf_runtime.h"
}

/// Where `--tests` writes a crate's test translation unit.
pub fun test_crate_dir(dir: str): String {
    return "${dir}/test"
}

pub fun test_artifact_path(test_dir: str, crate_name: str, extension: str): String {
    return "${test_dir}/${crate_name}_tests${extension}"
}
