import core.assert.assert_eq

import kf_core.ast.*
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TopDeclKind
import testing.test
import kf_core.span.Span
import kf_core.intern.*

@test
fun appended_modules_outlive_the_loaded_interface_list(): void {
    var path = List.new<String>()
    path.push(String.from("owned.path"))
    var input = List.new<Module>()
    input.push(
        Module { crate: CrateId.new("dependency"), path: path, decls: List.new<TopDecl>(), imports: List.new<Import>() }
    )
    var output = List.new<Module>()
    append_modules(&var output, &input)
    input.pop()
    var churn = List.new<String>()
    var i: uint64 = 0
    while i < 128 {
        churn.push(String.from("replacement"))
        i = i + 1
    }
    assert_eq(output.at(0).path.at(0).as_str(), "owned.path", "appended modules own their fields")
}

@test
fun merged_modules_outlive_the_source_containers(): void {
    var path = List.new<String>()
    path.push(String.from("owned.path"))
    var import_path = List.new<String>()
    import_path.push(String.from("owned.import"))
    var decls = List.new<TopDecl>()
    decls.push(TopDecl.new(Span.none(), String.from("owned_decl"), TopDeclKind.Poison))
    var imports = List.new<Import>()
    imports.push(Import.new(Span.none(), import_path, true))
    var input = List.new<Module>()
    input.push(Module { crate: CrateId.new("dependency"), path: path, decls: decls, imports: imports })
    val merged = merge_module_list(input.clone())
    input.pop()
    var churn = List.new<String>()
    var i: uint64 = 0
    while i < 128 {
        churn.push(String.from("replacement"))
        i = i + 1
    }
    val owned = merged.path.at(0).as_str() == "owned.path" && merged.decls.at(0).name.as_str() == "owned_decl" && merged.imports.at(0).path.at(0).as_str() == "owned.import"
    assert_eq(owned, true, "merged modules own their nested containers")
}
