// Compiling or checking one crate against its dependencies' interfaces;
// dependency source is never opened.

import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_assemble.*
import kf_codegen.*
import kf_interface.export_closure_diagnostics

import kf_driver.*
import kf_interface.emit.emit_interface_full
import kf_driver.testing.*
import kf_codegen.emit.glue.deep_clone_module

/// kflatc's `check`: the crate, its tests included, type-checked against its
/// dependencies' interfaces in `tdir`. Nothing is written. Returns the number
/// of errors.
pub fun CompileUnit.check_against_interfaces(tdir: str, as_json: bool): int32 {
    val smap = fresh_source_map()
    val diagnostics = fresh_diag_list()
    var modules = List.new<Module>()
    while dependency in &self.loads {
        val path = crate_interface_path(tdir, dependency.as_str())
        val loaded = load_compiled_crate(path.as_str(), smap)
        if !loaded.ok {
            val message = "failed to load ${path}: ${loaded.error}"
            if as_json { println(render_json_error(message.as_str())) } else { println("kflatc check: ${message}") }
            return 1
        }
        append_modules(&var modules, &loaded.modules)
    }
    val source_crate = assemble_crate_tests(self.root.as_str(), String.from(self.name.as_str()), smap, diagnostics)
    append_modules(&var modules, &source_crate.modules)
    val parse_errors = report_parse_errors(diagnostics, smap, as_json)
    if parse_errors > 0 { return parse_errors }
    var merged = merge_module_list(modules)
    // The checked crate, or every "is this file mine?" lint returns nothing.
    merged.crate = new_crate_id(self.name.as_str())
    var cfg_diags = List.new<Diagnostic>()
    var cfg = project_lint_config(&var cfg_diags)
    val cfg_errors = report_config_diags(&cfg_diags, smap, as_json)
    if as_json { return cfg_errors + merged.check_module_json_leveled(smap, &cfg) }
    return cfg_errors + merged.check_module_leveled(smap, &cfg)
}

fun append_modules(output: &var List<Module>, input: &List<Module>): void {
    while item in &input {
        output.push(deep_clone_module(item))
    }
}

/// Per-crate C plus the interface it produced, whose hash consumers record.
pub struct CrateCompileResult {
    pub val output: CrateCodegenOutput
    pub val interface_text: String
}

/// The loaded interfaces stand in for the dependencies; the crate's own
/// `.kfi` is emitted between TypeCheck and Mono, as on the source path.
pub fun CompileUnit.compile_crate_against_interfaces(artifacts: str, is_bin_root: bool,
                                                     errp: Ptr<ErrCount>): CrateCompileResult {
    return self.compile_crate_mode(artifacts, is_bin_root, false, errp)
}

/// With `_test.kf` files and a synthetic test main; dependencies stay
/// bodyless interfaces.
pub fun CompileUnit.compile_test_crate_against_interfaces(artifacts: str, errp: Ptr<ErrCount>): CrateCompileResult {
    return self.compile_crate_mode(artifacts, true, true, errp)
}

fun CompileUnit.compile_crate_mode(artifacts: str, is_bin_root: bool, include_tests: bool,
                                   errp: Ptr<ErrCount>): CrateCompileResult {
    val smap = fresh_source_map()
    val diagnostics: Ptr<List<Diagnostic>> = unsafe { alloc<List<Diagnostic>>() }
    unsafe { *diagnostics = List.new<Diagnostic>() }
    var modules = List.new<Module>()
    while dependency in &self.loads {
        val path = crate_interface_path(artifacts, dependency.as_str())
        val loaded = load_compiled_crate(path.as_str(), smap)
        if !loaded.ok {
            val message = "kflatc: failed to load ${path.as_str()}: ${loaded.error.as_str()}"
            runtime_println(message.as_str())
            unsafe { errp.n = errp.n + 1 }
            return empty_compile_result()
        }
        append_modules(&var modules, &loaded.modules)
    }
    val source_crate = if include_tests {
        assemble_crate_tests(self.root.as_str(), String.from(self.name.as_str()), smap, diagnostics)
    } else {
        assemble_crate(self.root.as_str(), String.from(self.name.as_str()), smap, diagnostics)
    }
    append_modules(&var modules, &source_crate.modules)
    var diagnostic_index = 0
    while diagnostic_index < unsafe { diagnostics.size() } {
        val diagnostic = unsafe { diagnostics.at(diagnostic_index) }
        diagnostic.print_diag(smap)
        unsafe { errp.n = errp.n + 1 }
        diagnostic_index = diagnostic_index + 1
    }
    if include_tests {
        val names = collect_test_names(modules)
        rename_main_decls(&var modules)
        var main_src = gen_test_main_imports(&modules)
        main_src.append(gen_test_main_src(names).as_str())
        var main_module = parse_test_main(main_src.as_str(), smap)
        stamp_module_owner(&var main_module, new_crate_id(self.name.as_str()))
        modules.push(main_module)
    }
    var merged = merge_module_list(modules)
    // Separate mode: instances become this TU's static support.
    merged.crate = new_crate_id(self.name.as_str())
    merged.run_interface_passes(errp, smap)
    val own = new_crate_id(self.name.as_str())
    val closure_errors = export_closure_diagnostics(&merged, own)
    while closure_error in &closure_errors {
        runtime_println(closure_error.as_str())
        unsafe { errp.n = errp.n + 1 }
    }
    val interface_text = emit_interface_full(&merged, String.from(self.name.as_str()), &self.deps, &self.dep_hashes, smap)
    merged.run_separate_after_typecheck(errp, smap)
    // The test TU includes `<crate>_tests.h`, not the library header.
    val artifact = if include_tests {
        String.from(self.name.as_str()) + String.from("_tests")
    } else {
        String.from(self.name.as_str())
    }
    val output = emit_crate_named(&merged, String.from(self.name.as_str()), artifact, self.deps.clone(), is_bin_root)
    return CrateCompileResult { output: output, interface_text: interface_text }
}

fun empty_compile_result(): CrateCompileResult {
    return CrateCompileResult { output: empty_codegen_output(), interface_text: "" }
}

fun empty_codegen_output(): CrateCodegenOutput {
    return CrateCodegenOutput {
        crate_name: "",
        header: "",
        source: "",
        needs_runtime: false,
        dep_headers: List.new<String>(),
        exported_symbols: List.new<String>()
    }
}
