// The crates komp hands kflatc as `--crate NAME=ROOT`, dependencies first and
// the root last, and their modules assembled from source.

import alloc.list.*
import core.args.arg_at
import core.args.arg_count

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_core.span.*
import kf_assemble.Overlay
import kf_assemble.assemble_crate_inc


/// A crate named on kflatc's command line: its name and source root.
pub struct CrateSource {
    pub val name: String
    pub val root: String
}

/// Every `--crate NAME=ROOT` on the command line, in order.
pub fun crate_sources_from_args(): List<CrateSource> {
    var crates = List.new<CrateSource>()
    while i in 0..arg_count() {
        if arg_at(i) == "--crate" && i + 1 < arg_count() {
            val row = arg_at(i + 1)
            when (row.index_of("=")) {
                Some(eq) => {
                    crates.push(CrateSource { name: row.substring(0, eq), root: row.substring(eq + 1, row.byte_len()) })
                }
                None => { }
            }
        }
    }
    return crates
}

/// Each crate's modules in order. `root_tests` includes the last crate's
/// `_test.kf` files; `overlay` stands in for a file an editor has open.
pub fun assemble_crate_list(crates: &List<CrateSource>, smap: Ptr<SourceMap>, pdiags: Ptr<List<Diagnostic>>,
                            root_tests: bool, overlay: &Overlay): List<Module> {
    var modules = List.new<Module>()
    while i in 0..crates.size() {
        val item = crates.at(i)
        val tests = root_tests && i + 1 == crates.size()
        val assembled = assemble_crate_inc(item.root.as_str(), item.name.clone(), smap, pdiags, tests, overlay)
        while module in &assembled.modules {
            modules.push(module.clone())
        }
    }
    return modules
}
