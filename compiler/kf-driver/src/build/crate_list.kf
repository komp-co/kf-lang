// The crates komp hands kflatc as `--crate NAME=ROOT`, dependencies first and
// the root last, and their modules assembled from source.

import kf_core.ast.Module
import kf_core.diagnostic.*
import kf_core.span.*
import kf_assemble.Overlay
import kf_assemble.assemble_crate_sources

/// A crate named on kflatc's command line: its name, root and the directory
/// holding its sources ("" for `<root>/src`).
@derive(Clone)
pub struct CrateSource {
    pub val name: String
    pub val root: String
    pub val src: String
}

/// Each crate's modules in order. `root_tests` includes the last crate's
/// `_test.kf` files; `overlay` stands in for a file an editor has open.
pub fun assemble_crate_list(crates: &List<CrateSource>, smap: Ptr<SourceMap>, pdiags: &var Diagnostics,
    root_tests: bool, overlay: &Overlay): List<Module> {
    var modules = List.new<Module>()
    while i in 0..crates.size() {
        val item = crates.at(i)
        val tests = root_tests && i + 1 == crates.size()
        val sources = crate_source_dir(item.root, item.src)
        val assembled = assemble_crate_sources(sources, item.name.clone(), smap, pdiags, tests, overlay)
        while module in &assembled.modules {
            modules.push(module.clone())
        }
    }
    return modules
}
