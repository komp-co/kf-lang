// `--entry-file`: a file the caller adds to the crate whose `main` is the
// program's. A `main` of the crate's own is set aside as `__user_main`.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.intern
import kf_core.ast.new_crate_id
import kf_core.ast.declaration.TopDecl
import kf_parse.lexer.tokenize
import kf_parse.parser.new_parser
import kf_assemble.stamp_module_owner

/// `modules` with any `main` set aside and the entry file appended as the
/// module `entry`, owned by `crate_name`; a crate's own modules all start with
/// its name, so this one cannot clash. Nothing changes when
/// `entry_file` is "".
pub fun add_entry_file(modules: &var List<Module>, entry_file: str, crate_name: str, smap: Ptr<SourceMap>): void {
    if entry_file.byte_len() == 0 { return }
    rename_main_decls(modules)
    var entry = parse_entry_source(entry_file, read_file(entry_file).as_str(), smap)
    stamp_module_owner(&var entry, new_crate_id(crate_name))
    modules.push(entry)
}

pub fun parse_entry_source(path: str, src: str, smap: Ptr<SourceMap>): Module {
    val fid = unsafe { smap.add_file(new_source_file(String.from(path), String.from(src))) }
    var parser = new_parser(tokenize(src, fid))
    var module_path = List.new<String>()
    module_path.push(String.from("entry"))
    return parser.parse_module(module_path)
}

/// Renames any `fun main` to `__user_main`, clear of the entry file's.
pub fun rename_main_decls(modules: &var List<Module>): void {
    while mi in 0..modules.size() {
        val m = modules.at_mut(mi)
        while di in 0..m.decls.size() {
            val td = m.decls.at_mut(di)
            if td.is_fn_named_main() { td.name = intern("__user_main") }
        }
    }
}

fun TopDecl.is_fn_named_main(): bool {
    if !self.name.as_str().equals("main") { return false }
    return when (self.kind) {
        Function(_, _, _, _, _, _, _) => true
        _ => false
    }
}
