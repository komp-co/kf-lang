// One crate as kflatc compiles it: what its command line names.

import alloc.list.*

pub struct CompileUnit {
    pub val name: String
    pub val root: String
    /// The directory holding its `.kf` files; "" for `<root>/src`.
    pub val src: String
    /// Direct dependencies, recorded in the crate's interface with the hash
    /// of each one's `.kfi` at the same index.
    pub val deps: List<String>
    pub val dep_hashes: List<String>
    /// Every interface to load, dependencies first: the closure of `deps`.
    pub val loads: List<String>
}

pub fun CompileUnit.source_dir(): String {
    return crate_source_dir(self.root, self.src)
}

/// `src`, or `<root>/src` when it is "".
pub fun crate_source_dir(root: str, src: str): String {
    return if src.byte_len() > 0 { String.from(src) } else { "${root}/src" }
}
