// Find references: every name in the crate referring to what the cursor's
// name refers to: a top-level declaration, a member by its `Owner.name` key,
// or a parameter or local by where its binder is written.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.declaration.DeclId
import json.writer.*

/// `{"schema_version":1,"file":..,"offset":N,"declaration":..,"references":[..]}`
///
/// Every entry names its own file.
pub fun render_references_json(path: str, offset: uint32, crate: &TypedCrate): String {
    var out = JsonWriter.object()
    out.field_uint32("schema_version", 1)
    out.field_string("file", path)
    out.field_uint32("offset", offset)

    val names = crate.module.every_name_span()
    val target = names.target_at(crate.file_id, offset) ?: {
        out.field_null("declaration")
        out.field_raw("references", "[]")
        return out.finish()
    }
    val declared = crate.module.target_declaration(&names, &target)
    if declared.end > declared.start {
        out.field_raw("declaration", declared.span_object(crate.smap).as_str())
    } else {
        out.field_null("declaration")
    }
    var arr = JsonWriter.array()
    while n in &names {
        if !n.is_decl && n.same_target(&target) { arr.write_raw(n.span.span_object(crate.smap).as_str()) }
    }
    out.field_raw("references", arr.finish().as_str())
    return out.finish()
}

/// Top-level names and members, type names in type positions, then
/// parameters and locals.
pub fun Module.every_name_span(): List<NameSpan> {
    var names = self.all_name_spans()
    while written in &self.type_name_spans() { names.push(written) }
    while local in &self.local_name_spans() { names.push(local) }
    return names
}

/// The narrowest name at `offset` that refers to something.
fun List<NameSpan>.target_at(file_id: uint32, offset: uint32): NameSpan? {
    var best: NameSpan? = null
    var best_width: uint32 = 0
    while n in &self {
        if n.span.name_covers(file_id, offset) && n.refers() {
            val width = n.span.end - n.span.start
            if best.is_none() || width <= best_width {
                best = Option.Some(n)
                best_width = width
            }
        }
    }
    return best
}

fun NameSpan.refers(): bool {
    return self.decl.is_some() || self.member.as_str() != ""
}

/// The same declaration, or else the same member.
fun NameSpan.same_target(other: &NameSpan): bool {
    when (self.decl) {
        Some(mine) => {
            val theirs = other.decl ?: return false
            return mine.raw == theirs.raw
        }
        None => { }
    }
    return self.member.as_str() != "" && self.member.as_str() == other.member.as_str()
}

/// Where the target is declared: a member's name inside its struct or impl.
fun Module.target_declaration(names: &List<NameSpan>, target: &NameSpan): Span {
    val decl = target.decl ?: {
        while n in &names {
            if n.is_decl && n.same_target(target) { return n.span }
        }
        return no_span()
    }
    return self.declaration_span(decl)
}

pub fun Span.span_object(smap: Ptr<SourceMap>): String {
    var o = JsonWriter.object()
    o.field_string("file", path_for_file_id(smap, self.file_id).as_str())
    o.field_uint32("byte_start", self.start)
    o.field_uint32("byte_end", self.end)
    return o.finish()
}

/// Poison off a name that resolves to one. Narrowest first: in
/// `outer(inner())` the cursor on `inner` must not answer `outer`.
pub fun Module.decl_at_offset(file_id: uint32, offset: uint32): DeclId? {
    val names = self.all_name_spans()
    var best: DeclId? = null
    var best_width = 0
    while n in &names {
        if n.span.name_covers(file_id, offset) && n.decl.is_some() {
            val width = n.span.end - n.span.start
            if best.is_none() || width <= best_width {
                best = n.decl
                best_width = width
            }
        }
    }
    return best
}

fun Span.name_covers(file_id: uint32, offset: uint32): bool {
    if self.file_id != file_id { return false }
    if self.end <= self.start { return false }
    return self.start <= offset && offset < self.end
}

/// The declaration's name when recorded, else its full span.
pub fun Module.declaration_span(decl: DeclId): Span {
    var found = no_span()
    while i in 0..self.decls.size() {
        val td = self.decls.at(i)
        val td_decl = td.decl ?: {
            continue
        }
        if td_decl.raw == decl.raw {
            found = td.span
            if !td.name_span.is_none() { found = td.name_span }
            return found
        }
    }
    return found
}
