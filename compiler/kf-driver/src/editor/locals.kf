// Parameters and locals: which binding each bare name refers to, found by
// walking scopes the way the checker does. A parameter covers its function,
// a `val` or `var` what follows it in its block, a loop or pattern binder its
// body; the innermost binding of a name wins. Each is keyed by where its
// binder is written.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import kf_core.ast.statement.Stmt

struct Binding {
    val name: Sym
    val key: Sym
}

/// Every binder of a parameter or local, and every use that refers to one.
pub fun Module.local_name_spans(): List<NameSpan> {
    var found = List.new<NameSpan>()
    while decl in &self.decls {
        decl.local_decl(&var found)
    }
    return found
}

fun TopDecl.local_decl(found: &var List<NameSpan>): void {
    when (self.kind) {
        Function(params, _r, body, _pub, _u, _mut, _st) => {
            var scope = List.new<Binding>()
            bind_params(&params, &var scope, found)
            local_block(&body, &var scope, found)
        }
        ImplBlock(methods) => {
            while method in &methods { method.local_decl(found) }
        }
        TraitDecl(methods, _pub, _supers) => {
            while method in &methods { method.local_decl(found) }
        }
        TraitImpl(_trait_ref, methods) => {
            while method in &methods { method.local_decl(found) }
        }
        _ => {}
    }
}

fun bind_params(params: &List<Param>, scope: &var List<Binding>, found: &var List<NameSpan>): void {
    while param in &params {
        bind(param.name, param.span, scope, found)
    }
}

/// A binder written at `at`; nothing for one the compiler made up.
fun bind(name: Sym, at: Span, scope: &var List<Binding>, found: &var List<NameSpan>): void {
    if at.is_none() || at.end <= at.start { return }
    val key = intern("local ${at.file_id}:${at.start}")
    scope.push(Binding { name: name, key: key })
    found.push(NameSpan { span: at, decl: null, role: intern("variable"), is_decl: true, member: key })
}

/// A use of `name` at `at`, when a binding in scope has that name.
fun use_name(name: Sym, at: Span, scope: &List<Binding>, found: &var List<NameSpan>): void {
    var i = scope.size()
    while i > 0 {
        i = i - 1
        val binding = scope.at(i)
        if binding.name.as_str() == name.as_str() {
            found.push(NameSpan { span: at, decl: null, role: intern("variable"), is_decl: false, member: binding.key })
            return
        }
    }
}

/// Bindings made inside go when it ends.
fun local_block(stmts: &List<Stmt>, scope: &var List<Binding>, found: &var List<NameSpan>): void {
    val depth = scope.size()
    while stmt in &stmts {
        stmt.local_stmt(scope, found)
    }
    while scope.size() > depth {
        val _left = scope.pop()
    }
}

fun Stmt.local_stmt(scope: &var List<Binding>, found: &var List<NameSpan>): void {
    when (self.kind) {
        // The initializer first: in `val x = x + 1` the right `x` is the outer one.
        LetVal(name, _ann, init) => {
            local_opt(&init, scope, found)
            bind(name, self.binder, scope, found)
        }
        LetVar(name, _ann, init) => {
            local_opt(&init, scope, found)
            bind(name, self.binder, scope, found)
        }
        Assign(name, value) => {
            use_name(name, self.span, scope, found)
            value.local_expr(scope, found)
        }
        AssignTo(place, value) => {
            place.local_expr(scope, found)
            value.local_expr(scope, found)
        }
        Return(value) => local_opt(&value, scope, found)
        If(cond, then_body, else_body) => {
            cond.local_expr(scope, found)
            local_block(then_body, scope, found)
            local_block(else_body, scope, found)
        }
        While(cond, body) => {
            cond.local_expr(scope, found)
            local_block(body, scope, found)
        }
        ForEach(name, subject, body) => {
            subject.local_expr(scope, found)
            val depth = scope.size()
            bind(name, self.binder, scope, found)
            local_block(body, scope, found)
            while scope.size() > depth {
                val _left = scope.pop()
            }
        }
        When(subject, arms) => {
            subject.local_expr(scope, found)
            local_arms(&arms, scope, found)
        }
        Expression(e) => e.local_expr(scope, found)
        _ => {}
    }
}

fun local_opt(e: &Box<Expr>?, scope: &var List<Binding>, found: &var List<NameSpan>): void {
    when (e) {
        Some(inner) => inner.local_expr(scope, found)
        None => { }
    }
}

/// Each arm's pattern binds for its guard and body.
fun local_arms(arms: &List<Arm>, scope: &var List<Binding>, found: &var List<NameSpan>): void {
    while arm in &arms {
        val depth = scope.size()
        arm.pattern.bind_pattern(scope, found)
        local_opt(&arm.guard, scope, found)
        local_block(&arm.body, scope, found)
        while scope.size() > depth {
            val _left = scope.pop()
        }
    }
}

fun Pattern.bind_pattern(scope: &var List<Binding>, found: &var List<NameSpan>): void {
    when (self.kind) {
        Identifier(name) => bind(name, self.span, scope, found)
        Variant(_name, subs) => {
            while sub in &subs { sub.bind_pattern(scope, found) }
        }
        StructPat(_name, _fields, subs) => {
            while sub in &subs { sub.bind_pattern(scope, found) }
        }
        _ => {}
    }
}

fun Expr.local_expr(scope: &var List<Binding>, found: &var List<NameSpan>): void {
    when (self.kind) {
        Variable(name) => use_name(name, self.span, scope, found)
        Binary(l, _op, r) => {
            l.local_expr(scope, found)
            r.local_expr(scope, found)
        }
        Unary(_op, inner) => inner.local_expr(scope, found)
        Deref(inner) => inner.local_expr(scope, found)
        Call(_name, args) => local_list(&args, scope, found)
        Intrinsic(_intrinsic, args) => local_list(&args, scope, found)
        MethodCall(recv, _m, args) => {
            recv.local_expr(scope, found)
            local_list(&args, scope, found)
        }
        CallValue(callee, args) => {
            callee.local_expr(scope, found)
            local_list(&args, scope, found)
        }
        FieldAccess(obj, _f) => obj.local_expr(scope, found)
        IfExpr(cond, then_value, else_value) => {
            cond.local_expr(scope, found)
            then_value.local_expr(scope, found)
            else_value.local_expr(scope, found)
        }
        WhenExpr(subject, arms) => {
            subject.local_expr(scope, found)
            local_arms(&arms, scope, found)
        }
        StructLit(_name, fields) => {
            while field in &fields { field.value.local_expr(scope, found) }
        }
        Cast(inner, _target) => inner.local_expr(scope, found)
        DynCoerce(inner, _vtable) => inner.local_expr(scope, found)
        Lambda(params, body) => {
            val depth = scope.size()
            bind_params(&params, scope, found)
            local_block(&body, scope, found)
            while scope.size() > depth {
                val _left = scope.pop()
            }
        }
        Block(stmts) => local_block(&stmts, scope, found)
        Retain(inner) => inner.local_expr(scope, found)
        _ => {}
    }
}

fun local_list(args: &List<Expr>, scope: &var List<Binding>, found: &var List<NameSpan>): void {
    while arg in &args {
        arg.local_expr(scope, found)
    }
}
