// Rename: find-references plus the reasons to refuse. A rename that changes
// which declaration a name refers to still compiles and means something else,
// so anything not provably safe is refused with a reason. The checks for
// members and locals are rename_scope.kf.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.declaration.DeclId
import kf_core.ast.declaration.TopDecl
import kf_parse.lexer.*
import json.writer.*
import kf_shared.absolutize
import kf_shared.starts_with_path

/// `{"schema_version":1,"file":..,"offset":N,"new_name":"..","ok":bool,
///   "error":null|"..","range":null|{..},"edits":[{..}]}`
///
/// `edits` includes the declaration's own name. An empty `new_name` asks
/// only whether a rename is possible, and answers with `range`, the name
/// under the cursor.
pub fun render_rename_json(path: str, offset: uint32, new_name: str, crate: &TypedCrate): String {
    var out = JsonWriter.object()
    out.field_uint32("schema_version", 1)
    out.field_string("file", path)
    out.field_uint32("offset", offset)
    out.field_string("new_name", new_name)

    val names = crate.module.every_name_span()
    val target = names.target_at(crate.file_id, offset)
    val refusal = why_not(new_name, crate, &names, target)
    if refusal.as_str() != "" {
        out.field_bool("ok", false)
        out.field_string("error", refusal.as_str())
        out.field_null("range")
        out.field_raw("edits", "[]")
        return out.finish()
    }
    out.field_bool("ok", true)
    out.field_null("error")
    val named = target ?: {
        out.field_null("range")
        out.field_raw("edits", "[]")
        return out.finish()
    }
    out.field_raw("range", named.span.span_object(crate.smap).as_str())
    if new_name.byte_len() == 0 {
        out.field_raw("edits", "[]")
        return out.finish()
    }
    var arr = JsonWriter.array()
    while e in &crate.module.rename_edits(&names, &named) {
        arr.write_raw(e.span_object(crate.smap).as_str())
    }
    out.field_raw("edits", arr.finish().as_str())
    return out.finish()
}

/// The declaration's name, then every use.
fun Module.rename_edits(names: &List<NameSpan>, target: &NameSpan): List<Span> {
    var out = List.new<Span>()
    val home = self.target_declaration(names, target)
    if !home.is_none() { out.push(home) }
    while n in &names {
        if !n.is_decl && n.same_target(target) { out.push(n.span) }
    }
    return out
}

/// Why this rename must not happen, or "". The reader's own input is checked
/// before the program.
fun why_not(new_name: str, crate: &TypedCrate, names: &List<NameSpan>, target: NameSpan?): String {
    // An empty name: every check that needs no name still applies.
    val validate_only = new_name.byte_len() == 0
    if !validate_only && !is_single_identifier(new_name) {
        val m = "`${new_name}` is not a name: a rename target must lex as a single identifier"
        return m
    }
    val named = target ?: return String.from("nothing to rename here: the offset is not on a name that resolves to a declaration")
    val home = crate.module.target_declaration(names, &named)
    val old = crate.text_at(home)
    if !validate_only && old.as_str() == new_name {
        return String.from("the new name is the old name")
    }
    if !owned_by_this_crate(home, crate) {
        val m = "`${old.as_str()}` is declared outside this crate; rename it where it is declared"
        return m
    }
    val two_names = crate.module.name_written_twice(names, &named)
    if two_names.as_str() != "" { return two_names }
    val kind_refusal = when (named.decl) {
        Some(decl) => {
            if validate_only { String.from("") } else { crate.module.colliding_decl(new_name, decl) }
        }
        None => {
            if named.member.as_str().starts_with("local ") {
                if validate_only { String.from("") } else { crate.local_clash(names, &named, new_name) }
            } else if named.member.as_str().starts_with("trait ") {
                if validate_only { String.from("") } else { crate.module.colliding_name(new_name) }
            } else {
                crate.member_refusal(names, &named, old.as_str(), new_name)
            }
        }
    }
    return kind_refusal
}

/// Asks the real lexer rather than restating its rules.
pub fun is_single_identifier(text: str): bool {
    val n = text.byte_len()
    if n == 0 { return false }
    val toks = tokenize(text, 1)
    if toks.size() == 0 { return false }
    val first = *toks.at(0)
    var named = false
    when (first.kind) {
        Identifier(_s) => named = true
        _ => {}
    }
    if !named { return false }
    // `a b` and `a+` lex but are not one name.
    return first.span.start == 0 && (first.span.end as uint64) == n
}

/// Why a top-level rename would collide, or "".
fun Module.colliding_decl(new_name: str, target: DeclId): String {
    while i in 0..self.decls.size() {
        val td = self.decls.at(i)
        val td_decl = td.decl ?: {
            continue
        }
        if td.name.as_str() == new_name && td_decl.raw != target.raw {
            val m = "`${new_name}` is already declared in this crate (${td.decl_noun()}); renaming would change which one a use refers to"
            return m
        }
    }
    return ""
}

/// Why a trait cannot take `new_name`, which any top-level declaration
/// already has, or "".
fun Module.colliding_name(new_name: str): String {
    while td in &self.decls {
        if td.name.as_str() == new_name && td.ext_name.as_str() == "" {
            val m = "`${new_name}` is already declared in this crate (${td.decl_noun()})"
            return "${m}; renaming would change which one a use refers to"
        }
    }
    return ""
}

fun TopDecl.decl_noun(): String {
    var noun = String.from("a declaration")
    when (self.kind) {
        Function(_p, _r, _b, _pu, _u, _m, _s) => noun = String.from("a function")
        Struct(_f, _p) => noun = String.from("a struct")
        EnumDecl(_v, _p) => noun = String.from("an enum")
        TraitDecl(_m, _p, _s) => noun = String.from("a trait")
        Extern(_p, _r, _pu, _u) => noun = String.from("an extern")
        _ => {}
    }
    return noun
}

/// The assembled crate holds every dependency; rename must not edit theirs.
fun owned_by_this_crate(home: Span, crate: &TypedCrate): bool {
    if home.is_none() { return false }
    val decl_file = path_for_file_id(crate.smap, home.file_id)
    val here = path_for_file_id(crate.smap, crate.file_id)
    if decl_file.as_str() == "" || here.as_str() == "" { return false }
    if crate.root.as_str() == "" { return false }
    return starts_with_path(decl_file.as_str(), absolutize(crate.root.as_str()).as_str())
}
