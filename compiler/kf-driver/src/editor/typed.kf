// The typed questions' crate: types come from the checker, which needs
// the whole crate, so the crates the client names are assembled around the file and
// the signature table kept.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.new_module
import kf_core.ast.types.Type
import kf_assemble.Overlay
import kf_assemble.no_overlay
import kf_assemble.overlay_for
import kf_assemble.staged_under
import kf_resolve.*
import kf_typecheck.*
import kf_typecheck.types.display_type
import kf_driver.fresh_source_map
import kf_driver.build.merge_module_list
import kf_driver.build.merge_module_lists
import kf_driver.build.crate_source_dir
import kf_driver.build.CrateSource
import kf_driver.build.assemble_crate_list
import kf_core.diagnostic.Diagnostics
import kf_core.diagnostic.new_diagnostics
import kf_core.ast.types.TypingNodes
import kf_core.ast.types.restore_type_nodes
import std.fs.absolute

/// `ok` is false for a file with no crate above it.
pub struct TypedCrate {
    pub var ok: bool
    pub var file_id: uint32
    pub var module: Module
    /// A view of `typing`'s table, which owns it.
    pub var sigs: Ptr<SigTable>
    pub var typing: TypedModule
    pub var source: String
    /// The queried crate's source root; files under it are its own.
    pub var root: String
    /// For answers spanning several files.
    pub var smap: Box<SourceMap>
    /// Where the typing's type children live; they go with the crate.
    pub var nodes: TypingNodes
}

/// `staged` marks absence: an emptied buffer is still a document. `crates`
/// run dependencies first, the queried crate last.
pub fun typed_crate_staged(file_path: str, buffer: str, staged: bool, crates: &List<CrateSource>,
    every_body: bool): TypedCrate {
    // Keyed to the path the assembly will spell.
    val abs_file = absolute(file_path).raw
    val overlay = if staged { overlay_for(abs_file.as_str(), buffer) } else { no_overlay() }
    return typed_crate_with(file_path, &overlay, crates, every_body)
}

/// `crates` typed, with `overlay` standing in for any file it stages, and
/// focused on `file_path`. Without `every_body`, only the queried crate's
/// bodies are checked, which every answer but a search for uses needs.
pub fun typed_crate_with(file_path: str, overlay: &Overlay, crates: &List<CrateSource>, every_body: bool): TypedCrate {
    var signatures = no_dependency_signatures()
    val bodies_from = if every_body { 0 } else { crates.size() - 1 }
    return typed_crate_cached(file_path, overlay, crates, bodies_from, false, &var signatures)
}

/// Crates assembled to their signatures, in the order typings list them,
/// each kept while neither its place nor a staged file in it changes. A
/// typing takes any prefix of them.
pub struct DependencySignatures {
    /// Per crate: what it was assembled from, and where its modules and its
    /// files end in `modules` and `smap`.
    var keys: List<String>
    var module_ends: List<uint64>
    var file_ends: List<uint64>
    var modules: List<Module>
    /// The files their spans name.
    var smap: SourceMap
}

pub fun no_dependency_signatures(): DependencySignatures {
    return DependencySignatures {
        keys: List.new<String>(), module_ends: List.new<uint64>(), file_ends: List.new<uint64>(),
        modules: List.new<Module>(), smap: new_source_map()
    }
}

/// A crate by name and place, and the text of any file of its `overlay`
/// stages.
fun crate_key(item: &CrateSource, overlay: &Overlay): String {
    var dirs = List.new<String>()
    dirs.push(crate_source_dir(item.root.as_str(), item.src.as_str()))
    return "${item.name}=${item.root}:${item.src}\n${overlay.staged_under(&dirs)}"
}

/// `crates` typed as `typed_crate_with` does, with the ones before
/// `bodies_from` reduced to their signatures, held in `signatures` across
/// typings. With `focus_only`, the rest keep only `file_path`'s bodies.
pub fun typed_crate_cached(file_path: str, overlay: &Overlay, crates: &List<CrateSource>, bodies_from: uint64,
    focus_only: bool, signatures: &var DependencySignatures): TypedCrate {
    if crates.size() == 0 {
        val typing = TypedModule { diags: List.new<Diagnostic>(), sigs: Box.new(new_sig_table()) }
        val empty: Ptr<SigTable> = typing.sigs
        return TypedCrate {
            ok: false, file_id: 0, module: new_module(List.new<String>()), sigs: empty, typing: typing, source: "",
            smap: fresh_source_map(), root: "", nodes: TypingNodes.new()
        }
    }
    val nodes = TypingNodes.new()
    val previous = nodes.enter()
    var pdiags = new_diagnostics()
    signatures.hold(crates, bodies_from, overlay)
    val smap = Box.new(signatures.smap.copy_files(signatures.file_count(bodies_from)))
    var with_bodies = List.new<CrateSource>()
    while i in bodies_from..crates.size() {
        with_bodies.push(crates.at(i).clone())
    }
    // With the root's tests, since the buffer is often a `_test.kf`.
    val own = assemble_crate_list(&with_bodies, smap, &var pdiags, true, overlay)
    var merged = merge_module_lists(&signatures.modules, signatures.module_count(bodies_from), &own)
    if focus_only {
        val focused = file_id_for_path(smap, absolute(file_path).raw.as_str())
        if focused != 0 { drop_bodies_outside(&var merged.decls, focused) }
    }

    // Diagnostics are dropped: they would interleave with the answer on
    // stdout, and the editor has them from `komp check`.
    val callers = new_import_files()
    val targets = new_import_syms()
    val names = new_import_syms()
    val _import_diags = validate_imports_per_module(&var merged, callers, targets, names, smap)
    var table = new_decl_table()
    resolve_module(&var merged, &var table)
    val typed = typecheck_module_typed(&var merged, &var table, callers, targets, names, smap)
    // The table stays where its box put it when `typed` moves into the crate.
    val sigs: Ptr<SigTable> = typed.sigs

    val root = crates.at(crates.size() - 1).root.clone()
    restore_type_nodes(previous)
    var crate = TypedCrate {
        ok: false, file_id: 0, module: merged, sigs: sigs, typing: typed, source: "", smap: smap, root: root,
        nodes: nodes
    }
    val _found = crate.focus(file_path)
    return crate
}

/// Points the answers at `file_path`, one of the typed crates' files: false,
/// and `ok` false, when it is not one.
pub mutating fun TypedCrate.focus(file_path: str): bool {
    val abs_file = absolute(file_path).raw
    val fid = file_id_for_path(self.smap, abs_file.as_str())
    var text = ""
    when (unsafe { self.smap.get_file(fid) }) {
        Some(f) => text = f.content.clone()
        None => {}
    }
    self.ok = fid != 0
    self.file_id = fid
    self.source = text
    return self.ok
}

/// As its author wrote it.
pub fun Type.written_type(sigs: Ptr<SigTable>): String {
    var sink = new_diagnostics()
    val ctx = new_type_ctx(Type.new_poison(), &var sink, null, sigs)
    return display_type(self, &ctx)
}

/// "" when the map has no such file.
pub fun path_for_file_id(smap: Ptr<SourceMap>, file_id: uint32): String {
    when (unsafe { smap.get_file(file_id) }) {
        Some(f) => return f.path.clone()
        None => return ""
    }
}

/// 0 when the walk never read it: outside `src/`, or a `_test.kf`.
fun file_id_for_path(smap: Ptr<SourceMap>, path: str): uint32 {
    var i = 0
    while i < unsafe { smap.files.size() } {
        val f = unsafe { *smap.files.at(i) }
        if f.path.as_str() == path { return (i + 1) as uint32 }
        i = i + 1
    }
    return 0
}

impl DependencySignatures {
    /// Holds the first `count` of `crates`, keeping what it holds of them
    /// and assembling the rest.
    mutating fun hold(crates: &List<CrateSource>, count: uint64, overlay: &Overlay): void {
        var kept: uint64 = 0
        while kept < count && kept < self.keys.size() &&
            self.keys[kept].as_str() == crate_key(crates.at(kept), overlay).as_str() {
            kept = kept + 1
        }
        if kept < count && kept < self.keys.size() { self.forget_from(kept) }
        while i in self.keys.size()..count {
            val item = crates.at(i)
            var one = List.new<CrateSource>()
            one.push(item.clone())
            var pdiags = new_diagnostics()
            var modules = assemble_crate_list(&one, &var self.smap, &var pdiags, false, overlay)
            drop_bodies(&var modules)
            while module in &modules { self.modules.push(module.clone()) }
            self.keys.push(crate_key(item, overlay))
            self.module_ends.push(self.modules.size())
            self.file_ends.push(self.smap.files.size())
        }
    }

    /// Keeps only the first `count` crates.
    mutating fun forget_from(count: uint64): void {
        val modules = self.module_count(count)
        while self.modules.size() > modules { self.modules.pop() }
        self.smap = self.smap.copy_files(self.file_count(count))
        while self.keys.size() > count {
            self.keys.pop()
            self.module_ends.pop()
            self.file_ends.pop()
        }
    }

    /// How many modules, and files, the first `count` crates take.
    fun module_count(count: uint64): uint64 {
        return if count == 0 { 0 } else { self.module_ends.get(count - 1) }
    }

    fun file_count(count: uint64): uint64 {
        return if count == 0 { 0 } else { self.file_ends.get(count - 1) }
    }
}
