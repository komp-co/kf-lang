// A crate the focused one depends on, reduced to what a question about the
// focused crate reads of it: its signatures. Its function bodies cannot
// mention the focused crate, so no answer about it comes from them.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.declaration.TopDecl
import kf_core.ast.statement.Stmt

/// Empties every function body in `modules`, methods and trait defaults
/// included. A template keeps its body: it expands into whichever crate
/// uses it.
pub fun drop_bodies(modules: &var List<Module>): void {
    while i in 0..modules.size() {
        val module = modules.at_mut(i)
        drop_bodies_in(&var module.decls)
    }
}

fun drop_bodies_in(decls: &var List<TopDecl>): void {
    while i in 0..decls.size() {
        decls.at_mut(i).drop_body()
    }
}

mutating fun TopDecl.drop_body(): void {
    when (self.kind) {
        Function(_params, _ret, body, _p, _u, _mu, _st) => empty_body(&var body)
        ImplBlock(methods) => drop_bodies_in(&var methods)
        TraitImpl(_trait, methods) => drop_bodies_in(&var methods)
        TraitDecl(members, _pub, _supers) => drop_bodies_in(&var members)
        _ => { }
    }
}

fun empty_body(body: &var List<Stmt>): void {
    *body = List.new<Stmt>()
}
