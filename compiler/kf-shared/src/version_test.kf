import core.assert.assert_eq

/// Digits in three groups, split by two dots, none of them empty.
fun names_a_release(version: str): bool {
    var dots = 0
    var digits_in_group = 0
    while i in 0..version.byte_len() {
        val byte = version.byte_at(i)
        if byte == 46 {
            if digits_in_group == 0 { return false }
            dots = dots + 1
            digits_in_group = 0
        } else if byte >= 48 && byte <= 57 {
            digits_in_group = digits_in_group + 1
        } else {
            return false
        }
    }
    return dots == 2 && digits_in_group > 0
}

@test
fun the_version_names_a_release(): void {
    assert_eq(names_a_release(kflat_version()), true, "major.minor.patch, as a `vX.Y.Z` tag names it")
}

@test
fun a_two_part_version_is_not_a_release(): void {
    assert_eq(names_a_release("0.21"), false, "the patch is missing")
}
