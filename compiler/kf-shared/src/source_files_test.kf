import core.assert.assert_eq
import alloc.list.*
import std.fs.scratch_path

extern "C" fun kf_create_dir_all(p: str): int32
extern "C" fun write_file(path: str, content: str): void

@test fun a_plain_kf_file_is_source(): void {
    assert_eq(is_kf_source_file("foo.kf"), true, "foo.kf is source")
}

@test fun a_test_file_is_not_source(): void {
    assert_eq(is_kf_source_file("foo_test.kf"), false, "_test.kf excluded")
}

@test fun a_test_prefix_is_still_source(): void {
    assert_eq(is_kf_source_file("test_foo.kf"), true, "only the _test suffix counts")
}

@test fun another_extension_is_not_source(): void {
    assert_eq(is_kf_source_file("README.md"), false, ".md is not source")
}

@test fun any_kf_file_includes_tests(): void {
    assert_eq(is_kf_file_any("foo_test.kf"), true, "_test.kf is a .kf file")
}

/// `src/zeta.kf`, `src/alpha.kf`, `src/mid/inner.kf` and `src/alpha_test.kf`
/// under a scratch root.
fun source_tree(name: str): String {
    val root = String.from(scratch_path(name))
    val _made = unsafe { kf_create_dir_all("${root}/src/mid".as_str()) }
    write_file("${root}/src/zeta.kf".as_str(), "")
    write_file("${root}/src/alpha.kf".as_str(), "")
    write_file("${root}/src/mid/inner.kf".as_str(), "")
    write_file("${root}/src/alpha_test.kf".as_str(), "")
    return root
}

@test fun the_walk_is_in_byte_order(): void {
    val root = source_tree("kf_shared_walk_order")
    var paths = List.new<String>()
    walk_kf_files("${root}/src".as_str(), &var paths)
    var listed = ""
    while path in &paths { listed.append("${path} ".as_str()) }
    val expected = "${root}/src/alpha.kf ${root}/src/mid/inner.kf ${root}/src/zeta.kf "
    assert_eq(listed.as_str(), expected.as_str(), "sorted, recursive, tests left out")
}

@test fun the_walk_can_include_tests(): void {
    val root = source_tree("kf_shared_walk_tests")
    var paths = List.new<String>()
    walk_kf_files_inc("${root}/src".as_str(), &var paths, true)
    assert_eq(paths.size(), 4, "the _test.kf file too")
}
