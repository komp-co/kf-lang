// Version and ABI tags and the build target, shared by the writer and reader.

// CONSTRAINT: records are read key-by-key in a fixed order and an unexpected
// key poisons the record, so any added field is a hard version bump.
pub fun interface_format_version(): int64 {
    return 11
}

pub fun interface_compiler_abi(): str {
    return "komp-1"
}

pub fun interface_runtime_abi(): str {
    return "kflat-runtime-1"
}

pub fun interface_target(): str {
    return "x86_64-linux-gnu"
}
