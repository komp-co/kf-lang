// An `annotation` record: its name, and what it may mark.

import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import json.reader.*
import kf_interface.parse.*

mutating fun JsonReader.load_annotation(crate: CrateId, path: str, hidden: bool): TopDecl {
    if !self.expect_key("name") { return poison_decl() }
    val name = self.read_string()
    if !self.expect_key("pub") { return poison_decl() }
    val is_pub = self.read_bool()
    if !self.expect_key("on") { return poison_decl() }
    val word = self.read_string()
    if !self.expect_key("types") { return poison_decl() }
    var types = List.new<TypeRef>()
    if !self.begin_array() { return poison_decl() }
    while self.array_has_next() {
        // CONSTRAINT: kept in a local. The parsed tokens slice this buffer, so
        // a temporary would be freed while the parse result still reads it.
        val source = self.read_string()
        val parsed = parse_type_ptr(source.as_str())
        types.push(unsafe { *parsed })
    }
    if self.object_has_next() { return poison_decl() }
    val target = mark_target_of(word.as_str(), types, no_span())
    val decl = new_top_decl(no_span(), name, TopDeclKind.AnnotationDecl(List.new<Param>(), target, is_pub))
    return stamp_imported(decl, crate, path, "", hidden)
}
