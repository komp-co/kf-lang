// An `annotation` record: its name, and what it may mark.

import alloc.list.*

import kf_core.span.Span
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*
import kf_core.ast.annotation.mark_kind_of
import kf_core.intern.CrateId
import kf_core.ast.annotation.*
import json.reader.*
import kf_interface.parse.*

mutating fun JsonReader.load_annotation(crate: CrateId, path: str, hidden: bool): TopDecl {
    if !self.expect_key("name") { return poison_decl() }
    val name = self.read_string()
    if !self.expect_key("pub") { return poison_decl() }
    val is_pub = self.read_bool()
    if !self.expect_key("function") { return poison_decl() }
    // CONSTRAINT: kept in a local. The parsed tokens slice this buffer, so a
    // temporary would be freed while the parse result still reads it.
    val function = self.read_string()
    if !self.expect_key("kinds") { return poison_decl() }
    val kinds = self.read_kind_targets() ?: return poison_decl()
    if !self.expect_key("params") { return poison_decl() }
    val type_params = self.read_type_params() ?: return poison_decl()
    var defaults = List.new<Param>()
    var key = if self.object_has_next() { self.read_key() } else { String.from("") }
    if key.as_str() == "defaults" {
        defaults = self.load_params()
        key = if self.object_has_next() { self.read_key() } else { String.from("") }
    }
    if key.as_str() == "shaped" {
        val shaped = self.load_shaped_params() ?: return poison_decl()
        while param in &shaped {
            defaults.push(param.clone())
        }
        key = if self.object_has_next() { self.read_key() } else { String.from("") }
    }
    var is_prelude = false
    if key.as_str() == "prelude" {
        is_prelude = self.read_bool()
        key = if self.object_has_next() { self.read_key() } else { String.from("") }
    }
    var is_unique = false
    if key.as_str() == "unique" {
        is_unique = self.read_bool()
        key = if self.object_has_next() { self.read_key() } else { String.from("") }
    }
    if key.byte_len() > 0 { return poison_decl() }
    val target = if function.byte_len() > 0 {
        parse_signature_source(function)
    } else if kinds.size() > 0 {
        MarkTarget.Kinds(kinds)
    } else {
        MarkTarget.new_default(Span.none())
    }
    var decl = TopDecl.new(Span.none(), name, TopDeclKind.AnnotationDecl(defaults, target, is_pub))
    decl.generics = type_params
    decl.is_unique = is_unique
    if is_prelude { decl.annotations.push(Annotation.new(Span.none(), "prelude", List.new<String>())) }
    return stamp_imported(decl, crate, path, "", hidden)
}

/// `[{"name":"rules","type":"fun","variadic":true}]`: the parameters taking
/// a name, or variadic; null when malformed.
mutating fun JsonReader.load_shaped_params(): List<Param>? {
    var params = List.new<Param>()
    if !self.begin_array() { return null }
    while self.array_has_next() {
        if !self.begin_object() || !self.expect_key("name") { return null }
        val name = self.read_string()
        if !self.expect_key("type") { return null }
        // CONSTRAINT: a local, as for the function type above.
        val written = self.read_string()
        if !self.expect_key("variadic") { return null }
        val variadic = self.read_bool()
        if self.object_has_next() { return null }
        var ty = when (mark_kind_of(written)) {
            Some(kind) => name_param_type(Span.none(), kind)
            None => parse_type_value(written)
        }
        if variadic { ty = variadic_param_type(Span.none(), ty) }
        params.push(Param.new(Span.none(), name, Box.new(ty)))
    }
    return params
}

/// `[{"kind":"struct","bounds":["Plugin"]}]`; null when malformed.
mutating fun JsonReader.read_kind_targets(): List<KindTarget>? {
    var kinds = List.new<KindTarget>()
    if !self.begin_array() { return null }
    while self.array_has_next() {
        if !self.begin_object() || !self.expect_key("kind") { return null }
        val word = self.read_string()
        val kind = mark_kind_of(word) ?: return null
        if !self.expect_key("bounds") || !self.begin_array() { return null }
        var bounds = List.new<TypeRef>()
        while self.array_has_next() {
            // CONSTRAINT: a local, as for the function type above.
            val source = self.read_string()
            bounds.push(parse_type_value(source))
        }
        if self.object_has_next() { return null }
        kinds.push(KindTarget { kind: kind, bounds: bounds })
    }
    return kinds
}

/// `[{"name":"T","bounds":["Display"]}]`; null when malformed.
mutating fun JsonReader.read_type_params(): List<TypeParam>? {
    var params = List.new<TypeParam>()
    if !self.begin_array() { return null }
    while self.array_has_next() {
        if !self.begin_object() || !self.expect_key("name") { return null }
        var param = TypeParam.new(Span.none(), self.read_string())
        if !self.expect_key("bounds") || !self.begin_array() { return null }
        while self.array_has_next() {
            // CONSTRAINT: a local, as for the function type above.
            val source = self.read_string()
            param.bounds.push(parse_type_value(source))
        }
        if self.object_has_next() { return null }
        params.push(param)
    }
    return params
}

/// A field's or a variant's annotation uses; empty, and the record poisoned
/// by the caller's next key check, when the array is malformed.
mutating fun JsonReader.load_annotation_uses(): List<Annotation> {
    var uses = List.new<Annotation>()
    if !self.begin_array() { return uses }
    while self.array_has_next() {
        // CONSTRAINT: a local, as for the function type above.
        val source = self.read_string()
        uses.push(parse_annotation_source(source))
    }
    return uses
}
