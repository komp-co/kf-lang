// A generic template crosses the interface as its own source text, sliced from
// the SourceMap, with its file's imports of other crates and its annotations in
// front; the consumer re-parses it.

import kf_core.span.*
import kf_core.intern.CrateId
import kf_core.ast.Module
import kf_core.intern.Sym
import kf_core.ast.declaration.TopDecl
import json.writer.*

/// "" when the declaration cannot be sliced (synthesized, or its span is
/// outside the map).
pub fun TopDecl.template_source_slice(smap: Ptr<SourceMap>): String {
    if self.decl_end == 0 as uint32 { return "" }
    val span = self.span
    val found = unsafe { smap.get_file(span.file_id) }
    when (found) {
        Some(file) => {
            val content = file.content.as_str()
            val len = content.byte_len()
            val start = span.start as uint64
            val end = self.decl_end as uint64
            if end <= start { return "" }
            if end > len { return "" }
            var out = ""
            // Every annotation, in source order, `@test` and `@allow` included.
            while item in &self.annotations {
                out.append("@")
                out.append(item.to_source().as_str())
                out.append("\n")
            }
            val piece = content.substring(start, end)
            out.append(piece)
            return out
        }
        None => return ""
    }
}

/// `{"kind":"generic","hidden":...,"name":...,"src":...}`
pub fun TopDecl.emit_template_entry(hidden: bool, m: &Module, crate: CrateId, smap: Ptr<SourceMap>): String {
    var o = JsonWriter.object()
    o.field_string("kind", "generic")
    o.field_bool("hidden", hidden)
    o.field_string("name", self.name.as_str())
    val slice = self.template_source_slice(smap)
    val src = if slice.byte_len() == 0 { slice } else { self.foreign_imports_source(m, crate) + slice }
    o.field_string("src", src)
    return o.finish()
}

/// The declaring file's imports of other crates, one line each. Every crate
/// the body can name is loaded wherever the template is used; the crate's own
/// modules need not cross the interface, so its own imports stay behind.
fun TopDecl.foreign_imports_source(m: &Module, crate: CrateId): String {
    val own = Sym { id: crate.raw }.as_str()
    var out = ""
    while imp in &m.imports {
        if imp.is_pub || imp.span.file_id != self.span.file_id { continue }
        if imp.path.size() == 0 || imp.path.at(0).as_str() == own { continue }
        out.append("import ")
        while i in 0..imp.path.size() {
            if i > 0 { out.append(".") }
            out.append(imp.path.at(i).as_str())
        }
        if imp.wildcard { out.append(".*") }
        if imp.alias.byte_len() > 0 { out.append(" as ${imp.alias}") }
        out.append("\n")
    }
    return out
}
