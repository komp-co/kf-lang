import alloc.list.*
import core.assert.assert_eq

import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import kf_core.ast.annotation.MarkTarget
import kf_core.intern.*
import kf_core.ast.annotation.*
import kf_interface.parse.parse_interface
import testing.test

fun annotation_module(is_pub: bool): Module {
    return targeted_module(is_pub, MarkTarget.new_default(Span.none()))
}

fun targeted_module(is_pub: bool, target: MarkTarget): Module {
    val kind = TopDeclKind.AnnotationDecl(List.new<Param>(), target, is_pub)
    var decl = TopDecl.new(Span.none(), String.from("bench"), kind)
    decl.crate = CrateId.new("sample")
    decl.module_path = intern("sample.api")
    var decls = List.new<TopDecl>()
    decls.push(decl)
    return Module { crate: CrateId.new("sample"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun loaded_annotation_count(is_pub: bool): uint64 {
    val out = annotation_module(is_pub).emit_interface(String.from("sample"), &List.new<String>())
    val loaded = parse_interface(out)
    var count: uint64 = 0
    while m in &loaded.modules {
        while td in &m.decls {
            when (td.kind) {
                AnnotationDecl(_params, _target, _pub) => { if td.name.as_str() == "bench" { count = count + 1 } }
                _ => {}
            }
        }
    }
    return count
}

@test
fun pub_annotation_round_trips_through_the_interface(): void {
    assert_eq(loaded_annotation_count(true), 1 as uint64, "a public annotation crosses")
}

@test
fun private_annotation_stays_out_of_the_interface(): void {
    assert_eq(loaded_annotation_count(false), 0 as uint64, "a private annotation does not cross")
}

fun named(name: str): TypeRef {
    return TypeRef.new(Span.none(), TypeRefKind.Named(intern(name), List.new<TypeRef>()))
}

/// The target of the one annotation `m` reads back as.
fun round_trip_target(m: Module): MarkTarget {
    val out = m.emit_interface(String.from("sample"), &List.new<String>())
    val loaded = parse_interface(out)
    while module in &loaded.modules {
        while td in &module.decls {
            when (td.kind) {
                AnnotationDecl(_params, target, _pub) => return target.clone()
                _ => {}
            }
        }
    }
    return MarkTarget.Kinds(List.new<KindTarget>())
}

fun MarkTarget.function_text(): String {
    return when (self) {
        Function(ty) => (*ty).tyref_to_source()
        Signature(params, has_rest, ret) => "pattern ${signature_source(&params, has_rest, &*ret)}"
        _ => String.from("kinds")
    }
}

/// `struct:Plugin+Default,enum:`, each kind with its bounds.
fun MarkTarget.kinds_text(): String {
    var out = String.from("")
    val kinds = self.kinds()
    while listed in &kinds {
        if out.byte_len() > 0 { out.append(",") }
        out.append("${listed.kind.word()}:")
        while i in 0..listed.bounds.size() {
            if i > 0 { out.append("+") }
            out.append(listed.bounds.at(i).tyref_to_source().as_str())
        }
    }
    return out
}

fun kind(kind: MarkKind, bounds: List<TypeRef>): KindTarget {
    return KindTarget { kind: kind, bounds: bounds }
}

@test
fun a_function_target_crosses_with_its_type(): void {
    val target = round_trip_target(targeted_module(true, MarkTarget.new_default(Span.none())))
    assert_eq(target.function_text().as_str(), "() -> void", "the function type is written and read back")
}

@test
fun kinds_cross_with_their_bounds(): void {
    var bounds = List.new<TypeRef>()
    bounds.push(named("Plugin"))
    bounds.push(named("Default"))
    var kinds = List.new<KindTarget>()
    kinds.push(kind(MarkKind.Struct, bounds))
    kinds.push(kind(MarkKind.Enum, List.new<TypeRef>()))
    val target = round_trip_target(targeted_module(true, MarkTarget.Kinds(kinds)))
    assert_eq(target.kinds_text().as_str(), "struct:Plugin+Default,enum:", "each kind and its bounds")
}

@test
fun any_crosses_as_every_kind(): void {
    val target = round_trip_target(targeted_module(true, MarkTarget.new_any_kind()))
    assert_eq(target.kinds_text().as_str(), "fun:,struct:,enum:,trait:", "all four")
}

fun wildcard(): TypeRef { return named("_") }

@test
fun a_signature_pattern_crosses_with_its_wildcards(): void {
    var params = List.new<TypeRef>()
    params.push(named("bool"))
    params.push(wildcard())
    val target = round_trip_target(targeted_module(true, MarkTarget.Signature(params, true, Box.new(wildcard()))))
    assert_eq(target.function_text().as_str(), "pattern (bool, _, ..) -> _", "each wildcard and the rest")
}

@test
fun rest_alone_crosses(): void {
    val pattern = MarkTarget.Signature(List.new<TypeRef>(), true, Box.new(named("bool")))
    val target = round_trip_target(targeted_module(true, pattern))
    assert_eq(target.function_text().as_str(), "pattern (..) -> bool", "no parameters before it")
}

/// Each type parameter the one annotation of `m` reads back with, `T:Display`.
fun round_trip_params(m: Module): String {
    val out = m.emit_interface(String.from("sample"), &List.new<String>())
    val loaded = parse_interface(out)
    var shown = String.from("")
    while module in &loaded.modules {
        while td in &module.decls {
            while tp in &td.generics {
                if shown.byte_len() > 0 { shown.append(",") }
                shown.append(tp.name.as_str())
                while bound in &tp.bounds {
                    shown.append(":${bound.tyref_to_source().as_str()}")
                }
            }
        }
    }
    return shown
}

@test
fun type_parameters_cross_with_their_bounds(): void {
    var m = targeted_module(true, MarkTarget.new_default(Span.none()))
    var shown = TypeParam.new(Span.none(), String.from("T"))
    shown.bounds.push(named("Display"))
    m.decls.at_mut(0).generics.push(shown)
    m.decls.at_mut(0).generics.push(TypeParam.new(Span.none(), String.from("S")))
    assert_eq(round_trip_params(m).as_str(), "T:Display,S", "in order, with the bound")
}

/// Whether the one `bench` annotation reads back `unique`.
fun unique_round_trips(unique: bool): bool {
    val kind = TopDeclKind.AnnotationDecl(List.new<Param>(), MarkTarget.new_default(Span.none()), true)
    var decl = TopDecl.new(Span.none(), String.from("bench"), kind)
    decl.crate = CrateId.new("sample")
    decl.module_path = intern("sample.api")
    decl.is_unique = unique
    val m = Module {
        crate: CrateId.new("sample"), path: List.new<String>(), decls: [decl], imports: List.new<Import>()
    }
    val loaded = parse_interface(m.emit_interface(String.from("sample"), &List.new<String>()))
    while each in &loaded.modules {
        while td in &each.decls {
            if td.name.as_str() == "bench" { return td.is_unique }
        }
    }
    return false
}

@test
fun a_unique_annotation_stays_unique_across_the_interface(): void {
    assert_eq(unique_round_trips(true), true, "`unique` crosses with its annotation")
    assert_eq(unique_round_trips(false), false, "and is not invented")
}

/// Whether the one `bench` annotation reads back marked `@prelude`.
fun prelude_round_trips(marked: bool): bool {
    val kind = TopDeclKind.AnnotationDecl(List.new<Param>(), MarkTarget.new_default(Span.none()), true)
    var decl = TopDecl.new(Span.none(), String.from("bench"), kind)
    decl.crate = CrateId.new("sample")
    decl.module_path = intern("sample.api")
    if marked { decl.annotations.push(Annotation.new(Span.none(), "prelude", List.new<String>())) }
    val m = Module {
        crate: CrateId.new("sample"), path: List.new<String>(), decls: [decl], imports: List.new<Import>()
    }
    val loaded = parse_interface(m.emit_interface(String.from("sample"), &List.new<String>()))
    while each in &loaded.modules {
        while td in &each.decls {
            if td.name.as_str() == "bench" { return (&td).has_annotation("prelude") }
        }
    }
    return false
}

@test
fun a_prelude_annotation_stays_one_across_the_interface(): void {
    assert_eq(prelude_round_trips(true), true, "@prelude crosses with its annotation")
    assert_eq(prelude_round_trips(false), false, "no @prelude is invented")
}
