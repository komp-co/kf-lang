import alloc.list.*
import kf_core.intern.intern
import alloc.hash_map.*

import kf_core.ast.*
import kf_core.ast.declaration.DeclId
import kf_core.ast.declaration.TopDecl

/// Top-level names and the DeclIds they were registered under, with what
/// each declaration shows the rest of the program (see scope.kf).
///
/// The lists record every registration, duplicates included; `index` answers
/// `lookup` and holds only the FIRST id each name got. `insert` mints a fresh
/// id even for a name already present.
pub struct DeclTable {
    pub var names: List<String>
    pub var decl_ids: List<DeclId>
    pub var index: HashMap<String, DeclId>
    pub var next_id: uint32
    /// One per id, at `raw - 1`.
    pub var entries: List<ScopeEntry>
    /// The entries a name can be called or read by, in registration order.
    var callables: NameIndex
    /// The structs and enums, by name, in registration order.
    var types: NameIndex
    /// Each file's imports, in import order, by the file id's decimal text.
    var file_imports: NameIndex
    var import_targets: List<Sym>
    var import_names: List<Sym>
    /// Imports gate visibility; without them every declaration is admitted.
    pub var gated: bool
    /// Each lookup's answer, per place by name; 0 for none.
    var answers: List<HashMap<String, uint32>>
    /// Each place's slot in `answers`, by file, crate and module.
    var places: HashMap<String, uint64>
    /// The last place asked about and its slot, which most lookups repeat.
    var last_file: uint32
    var last_crate: uint32
    var last_module: uint32
    var last_slot: uint64
    /// Where the body being stamped is written.
    var here_file: uint32
    var here_crate: CrateId
    var here_module: Sym
}

/// What a declaration shows the rest of the program.
@derive(Copy)
pub struct ScopeEntry {
    pub val name: Sym
    pub val crate: CrateId
    pub val module: Sym
    /// The name an import admits it by: an extension's written name.
    pub val surface: Sym
    /// A function, extern or constant, which a name calls or reads; a type
    /// is reached through types, and anything else not by a bare name.
    pub val callable: bool
    /// A struct or enum.
    pub val is_type: bool
    pub val is_pub: bool
    /// `@prelude`: usable without an import.
    pub val is_prelude: bool
}

pub fun new_decl_table(): DeclTable {
    return DeclTable {
        names: List.new<String>(),
        decl_ids: List.new<DeclId>(),
        index: HashMap.new<String, DeclId>(),
        next_id: 1,
        entries: List.new<ScopeEntry>(),
        callables: new_name_index(),
        types: new_name_index(),
        file_imports: new_name_index(),
        import_targets: List.new<Sym>(),
        import_names: List.new<Sym>(),
        gated: false,
        answers: List.new<HashMap<String, uint32>>(),
        places: HashMap.new<String, uint64>(),
        last_file: 0,
        last_crate: 0,
        last_module: 0,
        last_slot: none_index(),
        here_file: 0,
        here_crate: CrateId { raw: 0 },
        here_module: Sym { id: 0 }
    }
}

impl DeclTable {
    /// A name with nothing known about its declaration.
    pub mutating fun insert(name: String): DeclId {
        val entry = ScopeEntry {
            name: intern(name.as_str()), crate: CrateId { raw: 0 }, module: Sym { id: 0 },
            surface: intern(name.as_str()), callable: false, is_type: false, is_pub: false, is_prelude: false
        }
        return self.declare(name, entry)
    }

    /// `td`'s name, with what it shows the rest of the program.
    pub mutating fun register(td: &TopDecl): DeclId {
        return self.declare(td.name.as_string(), td.scope_entry())
    }

    /// A declaration described by `entry`.
    pub mutating fun declare(name: String, entry: ScopeEntry): DeclId {
        val id: uint32 = self.next_id
        self.next_id = self.next_id + 1
        val d = DeclId.new(id)
        val key = String.from(name.as_str())
        if !self.index.contains(&key) {
            self.index.insert(key, d)
        }
        if entry.callable { self.callables.add(name.clone(), self.entries.size()) }
        if entry.is_type { self.types.add(name.clone(), self.entries.size()) }
        self.names.push(name)
        self.decl_ids.push(d)
        self.entries.push(entry)
        self.forget_answers()
        return d
    }

    /// A declaration or import added after a lookup may change its answer.
    mutating fun forget_answers(): void {
        if self.answers.size() == 0 { return }
        self.answers = List.new<HashMap<String, uint32>>()
        self.places = HashMap.new<String, uint64>()
        self.last_slot = none_index()
    }

    /// The slot in `answers` of lookups from `file` in `crate`'s `module`.
    mutating fun place_slot(file: uint32, crate: CrateId, module: Sym): uint64 {
        val same_place = file == self.last_file && crate.raw == self.last_crate && module.id == self.last_module
        if self.last_slot != none_index() && same_place { return self.last_slot }
        val place = "${file} ${crate.raw} ${module.id}"
        var slot = none_index()
        when (self.places.get(&place)) {
            Some(found) => slot = *found
            None => { }
        }
        if slot == none_index() {
            slot = self.answers.size()
            self.answers.push(HashMap.new<String, uint32>())
            self.places.insert(place, slot)
        }
        self.last_file = file
        self.last_crate = crate.raw
        self.last_module = module.id
        self.last_slot = slot
        return slot
    }

    /// None for anything that is not a top-level declaration: a parameter,
    /// a local, a method.
    pub fun lookup(name: str): DeclId? {
        when (self.index.get(&String.from_literal(name))) {
            Some(d) => { return *d }
            None => { return null }
        }
    }

    pub fun entry(decl: DeclId): ScopeEntry {
        return *self.entries.at((decl.raw - 1) as uint64)
    }

    /// Gates visibility by the imports `import_validation` recorded: per
    /// import, the file it is written in, the module it reached, and what it
    /// admits (poison for every name).
    pub mutating fun note_imports(files: &List<uint32>, targets: &List<Sym>, admitted: &List<Sym>): void {
        self.gated = true
        while i in 0..files.size() {
            self.file_imports.add("${files.get(i)}", self.import_targets.size())
            self.import_targets.push(if i < targets.size() { targets.get(i) } else { Sym { id: 0 } })
            // No name recorded admits the whole module, as a wildcard does.
            self.import_names.push(if i < admitted.size() { admitted.get(i) } else { Sym { id: 0 } })
        }
        self.forget_answers()
    }

    /// The positions of `name`'s callable entries, in registration order.
    fun callables_named(name: str): List<uint64> {
        return self.callables.positions(name)
    }

    /// The positions of `file`'s imports, in import order.
    fun imports_of(file: uint32): List<uint64> {
        return self.file_imports.positions("${file}".as_str())
    }
}

fun TopDecl.scope_entry(): ScopeEntry {
    var callable = false
    var is_type = false
    var is_pub = false
    var is_prelude = false
    when (self.kind) {
        Function(_p, _r, _b, written_pub, _u, _m, _s) => {
            callable = true
            // Test runners are a separate module calling @test functions by
            // name.
            is_pub = written_pub || self.is_internal || self.has_annotation("test")
            is_prelude = self.has_annotation("prelude")
        }
        Extern(_p, _r, written_pub, _v) => {
            callable = true
            is_pub = written_pub || self.is_internal
            is_prelude = self.has_annotation("prelude")
        }
        Constant(_t, _v, written_pub) => {
            callable = true
            is_pub = written_pub || self.is_internal
        }
        Struct(_f, written_pub) => {
            is_type = true
            is_pub = written_pub
        }
        EnumDecl(_v, written_pub) => {
            is_type = true
            is_pub = written_pub
        }
        _ => { }
    }
    val surface = if self.ext_name.as_str() == "" { self.name } else { self.ext_name }
    return ScopeEntry {
        name: self.name, crate: self.crate, module: self.module_path, surface: surface, callable: callable,
        is_type: is_type, is_pub: is_pub, is_prelude: is_prelude
    }
}
