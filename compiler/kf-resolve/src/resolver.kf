import kf_core.ast.Module
import kf_core.ast.declaration.TopDecl

/// Register every top-level declaration, then stamp each name in each body
/// with the declaration it refers to. Registering first is what lets a
/// function call one declared later in the file.
pub fun resolve_module(m: &var Module, table: &var DeclTable): void {
    var i = 0
    while i < m.decls.size() {
        register_decl(&var m.decls, i, table)
        i = i + 1
    }

    while j in 0..m.decls.size() {
        val td = m.decls.at_mut(j)
        table.stand_in(td.span.file_id, td.crate, td.module_path)
        resolve_decl_body(td, table)
    }
}

fun register_decl(decls: &var List<TopDecl>, idx: uint64, table: &var DeclTable): void {
    if !decls.at(idx).should_register_decl() { return }
    val id = table.register(decls.at(idx))
    decls.at_mut(idx).decl = id
}

/// Impls, traits and associated types are reached through the type or trait
/// they belong to, never by a bare name, so they take no table entry.
pub fun TopDecl.should_register_decl(): bool {
    return when (self.kind) {
        Function(_, _, _, _, _, _, _) => true
        Struct(_, _) => true
        EnumDecl(_, _) => true
        Extern(_, _, _, _) => true
        ImplBlock(_) => false
        TraitDecl(_, _, _) => false
        TraitImpl(_, _) => false
        AssocType(_) => false
        AssocTypeBinding(_) => false
        AnnotationDecl(_params, _target, _pub) => false
        Template(_kind, _marked, _body) => false
        Constant(_ty, _value, _pub) => true
        Poison => false
    }
}
