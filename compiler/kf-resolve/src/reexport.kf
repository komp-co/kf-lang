// `export <names> from <module>`: what an export names is part of the
// surface of the module it is written in, so importing that module admits it
// too.

import alloc.list.*

import kf_core.ast.*
import kf_core.diagnostic.*
import kf_core.intern.*

/// One resolved export: `owner` offers `offered` from `target` under the name
/// `exposed`. A poison `offered` (and `exposed`) is every name, unrenamed.
struct Reexport {
    val owner: Sym
    val target: Sym
    val offered: Sym
    val exposed: Sym
}

/// Every export, resolved against the declared names and against each other.
/// Each adds the names it offers to its owner's `(module, name)` pairs, so a
/// named import of an exported name resolves like any other.
fun Module.resolve_reexports(module_paths: &var List<Sym>, decl_names: &var List<Sym>,
    file_paths: &List<Sym>, diags: &var List<Diagnostic>): List<Reexport> {
    var out = List.new<Reexport>()
    var resolved = List.new<uint64>()
    var progress = true
    while progress {
        progress = false
        while k in 0..self.imports.size() {
            val imp = self.imports.at(k)
            if imp.is_pub && !resolved.contains(&k) {
                val target = if imp.wildcard {
                    imp.resolve_wildcard(module_paths, file_paths)
                } else {
                    imp.resolve_specific(module_paths, decl_names, file_paths)
                }
                if target.id != 0 {
                    out.push(self.reexport_of(imp, target, diags))
                    resolved.push(k)
                    progress = true
                }
            }
        }
        if spread_reexported_names(&out, module_paths, decl_names) { progress = true }
    }
    return out
}

/// An extension is called by its receiver, so it keeps its name.
fun Module.reexport_of(imp: &Import, target: Sym, diags: &var List<Diagnostic>): Reexport {
    val owner = intern(imp.owner)
    if imp.wildcard { return Reexport { owner: owner, target: target, offered: Sym { id: 0 }, exposed: Sym { id: 0 } } }
    val offered = import_admitted_name(&imp.path)
    if imp.exposed.as_str() == "" {
        return Reexport { owner: owner, target: target, offered: offered, exposed: offered }
    }
    if self.declares_extension(target, offered) {
        val why = "is an extension, which is called by its receiver: export it without `as`"
        diags.push(Diagnostic.error_at(imp.span, "`${offered.as_str()}` ${why}"))
    }
    return Reexport { owner: owner, target: target, offered: offered, exposed: intern(imp.exposed) }
}

fun Module.declares_extension(module: Sym, name: Sym): bool {
    while d in &self.decls {
        if d.module_path.id == module.id && d.ext_name.id == name.id { return true }
    }
    return false
}

/// Gives each owner the names its exports offer; true when one was added.
fun spread_reexported_names(reexports: &List<Reexport>, module_paths: &var List<Sym>,
    decl_names: &var List<Sym>): bool {
    var added = false
    while r in &reexports {
        if r.exposed.id != 0 {
            if !has_pair(module_paths, decl_names, r.owner, r.exposed) {
                module_paths.push(r.owner)
                decl_names.push(r.exposed)
                added = true
            }
        } else {
            val count = module_paths.size()
            while i in 0..count {
                val name = decl_names.get(i)
                if module_paths.get(i).id == r.target.id && !has_pair(module_paths, decl_names, r.owner, name) {
                    module_paths.push(r.owner)
                    decl_names.push(name)
                    added = true
                }
            }
        }
    }
    return added
}

/// Import-table entries: parallel lists of file, target module and admitted
/// name.
struct ImportEntries {
    var files: List<uint32>
    var targets: List<Sym>
    var names: List<Sym>
}

fun new_import_entries(): ImportEntries {
    return ImportEntries { files: List.new<uint32>(), targets: List.new<Sym>(), names: List.new<Sym>() }
}

mutating fun ImportEntries.add(file: uint32, target: Sym, name: Sym): void {
    self.files.push(file)
    self.targets.push(target)
    self.names.push(name)
}

fun ImportEntries.holds(file: uint32, target: Sym, name: Sym): bool {
    while i in 0..self.files.size() {
        val same_place = self.files.get(i) == file && self.targets.get(i).id == target.id
        if same_place && self.names.get(i).id == name.id { return true }
    }
    return false
}

/// One entry per module an import reaches through exports, admitting
/// what the import admits there, for the imports' own `entries`.
fun forwarded_entries(reexports: &List<Reexport>, entries: &ImportEntries): ImportEntries {
    var out = new_import_entries()
    if reexports.size() == 0 { return out }
    while i in 0..entries.files.size() {
        val target = entries.targets.get(i)
        if target.id != 0 {
            forward_from(reexports, entries.files.get(i), target, entries.names.get(i), &var out, 0)
        }
    }
    return out
}

fun forward_from(reexports: &List<Reexport>, file: uint32, module: Sym, admitted: Sym, out: &var ImportEntries,
    depth: uint64): void {
    if depth > 16 || admitted.id == export_admission().id { return }
    while r in &reexports {
        if r.owner.id == module.id {
            when (forwarded_admission(admitted, r)) {
                Some(name) => {
                    if !out.holds(file, r.target, name) {
                        out.add(file, r.target, name)
                        forward_from(reexports, file, r.target, name, out, depth + 1)
                    }
                }
                None => { }
            }
        }
    }
}

/// What an import admitting `admitted` from `r.owner` admits from `r.target`,
/// or None. Admitted names are poison (every name), `written` or
/// `written=real` (one function, `real` in the module the entry names), and
/// each of those behind `as x ` for an alias.
fun forwarded_admission(admitted: Sym, r: &Reexport): Sym? {
    if r.offered.id == 0 { return Option.Some(admitted) }
    val text = if admitted.id == 0 { "" } else { admitted.as_str() }
    var alias = ""
    var part = text
    if text.starts_with("as ") {
        val cut = second_space_at(text)
        alias = if cut < 0 { String.from(text) } else { String.from(text.substring(0, cut as uint64).as_str()) }
        part = if cut < 0 { "" } else { text.substring(cut as uint64 + 1, text.byte_len()).as_str() }
    }
    var written = String.from(r.exposed.as_str())
    if part != "" {
        if admission_real(part).as_str() != r.exposed.as_str() { return Option.None }
        written = admission_written(part)
    }
    val next = renamed_admission(written, r.offered.as_str())
    if alias.as_str() == "" { return Option.Some(next) }
    return Option.Some(intern("${alias.as_str()} ${next.as_str()}"))
}

/// The second space's offset, or -1: `as x` holds one, `as x name` two.
fun second_space_at(text: str): int64 {
    var seen = 0
    while i in 0..text.byte_len() {
        if text.byte_at(i) == 32 {
            seen = seen + 1
            if seen == 2 { return i as int64 }
        }
    }
    return 0 - 1
}
