import core.assert.assert_eq

import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import kf_core.ast.declaration.*
import testing.test
import kf_core.span.Span
import kf_core.intern.*

fun module_with_nested_decl(): Module {
    return module_at_path_with_nested_decl(List.new<String>())
}

fun module_at_path_with_nested_decl(path: List<String>): Module {
    var methods = List.new<TopDecl>()
    methods.push(TopDecl.new(Span.none(), String.from("nested"), TopDeclKind.Poison))
    var module = Module.new(path)
    module.decls.push(TopDecl.new(Span.none(), String.from("Thing"), TopDeclKind.ImplBlock(methods)))
    return module
}

@test
fun stamp_module_owner_sets_module_owner(): void {
    var module = module_with_nested_decl()
    stamp_module_owner(&var module, CrateId.new("json"))
    assert_eq(module.crate.raw == CrateId.new("json").raw, true, "module gets its crate owner")
}

@test
fun stamp_module_owner_sets_top_decl_owner(): void {
    var module = module_with_nested_decl()
    stamp_module_owner(&var module, CrateId.new("json"))
    assert_eq(module.decls.at(0).crate.raw == CrateId.new("json").raw, true, "top declaration gets its crate owner")
}

@test
fun stamp_module_owner_sets_nested_decl_owner(): void {
    var module = module_with_nested_decl()
    stamp_module_owner(&var module, CrateId.new("json"))
    val outer = *module.decls.at(0)
    when (outer.kind) {
        ImplBlock(methods) => assert_eq(methods.at(0).crate.raw == CrateId.new("json").raw, true, "nested declaration gets its crate owner")
        _ => assert_eq(false, true, "fixture has an impl block")
    }
}

@test
fun stamp_module_owner_preserves_impl_methods(): void {
    var module = module_with_nested_decl()
    stamp_module_owner(&var module, CrateId.new("json"))
    var replacement = List.new<TopDecl>()
    replacement.push(TopDecl.new(Span.none(), String.from("replacement"), TopDeclKind.Poison))
    assert_eq(module.module_has_valid_ownership(), true, "stamping keeps nested methods live")
}

@test
fun stamp_module_owner_sets_decl_module_path(): void {
    var path = List.new<String>()
    path.push(String.from("json"))
    path.push(String.from("model"))
    path.push(String.from("point"))
    var module = module_at_path_with_nested_decl(path)
    stamp_module_owner(&var module, CrateId.new("json"))
    assert_eq(module.decls.at(0).module_path.as_str(), "json.model", "top declaration retains its module path")
}

@test
fun stamp_module_owner_preserves_struct_fields(): void {
    val ty: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *ty = TypeRef.new(Span.none(), TypeRefKind.Named(intern("int32"), List.new<TypeRef>())) }
    var fields = List.new<Field>()
    fields.push(Field.new(Span.none(), String.from("value"), ty, false, true))
    var module = Module.new(List.new<String>())
    module.decls.push(TopDecl.new(Span.none(), String.from("Item"), TopDeclKind.Struct(fields, true)))
    stamp_module_owner(&var module, CrateId.new("json"))
    when (module.decls.at(0).kind) {
        Struct(stamped, _) => assert_eq(stamped.at(0).name.as_str(), "value", "stamping keeps struct fields live")
        _ => assert_eq(false, true, "fixture has a struct")
    }
}
