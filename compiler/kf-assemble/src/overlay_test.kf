import core.assert.assert_eq
import testing.test

extern "C" fun system(cmd: str): int32

fun prepare_overlay_fixture(): void {
    unsafe { system("rm -rf ${Dir.scratch_path("kf_overlay")} && mkdir -p ${Dir.scratch_path("kf_overlay")}") }
    File.write(Dir.scratch_path("kf_overlay/on_disk.kf"), "fun f(): int32 { return 1 }\n").unwrap()
}

@test
fun an_overlay_answers_for_the_file_it_names(): void {
    prepare_overlay_fixture()
    val ov = overlay_for(Dir.scratch_path("kf_overlay/on_disk.kf"), "fun f(): int32 { return 2 }\n")
    assert_eq(ov.overlay_read(Dir.scratch_path("kf_overlay/on_disk.kf")).as_str(), "fun f(): int32 { return 2 }\n",
        "the buffer is the authority on its own text")
}

@test
fun a_file_the_overlay_does_not_name_is_read_from_disk(): void {
    prepare_overlay_fixture()
    val ov = overlay_for(Dir.scratch_path("kf_overlay/elsewhere.kf"), "fun g(): int32 { return 3 }\n")
    assert_eq(ov.overlay_read(Dir.scratch_path("kf_overlay/on_disk.kf")).as_str(), "fun f(): int32 { return 1 }\n",
        "one file is staged; the rest of the crate is still on disk")
}

@test
fun no_overlay_reads_every_file_from_disk(): void {
    prepare_overlay_fixture()
    val ov = no_overlay()
    assert_eq(ov.overlay_read(Dir.scratch_path("kf_overlay/on_disk.kf")).as_str(), "fun f(): int32 { return 1 }\n",
        "a batch compile has no buffer behind it")
}

@test
fun an_overlay_may_stage_an_empty_buffer(): void {
    // An emptied buffer is not the same as no overlay.
    prepare_overlay_fixture()
    val ov = overlay_for(Dir.scratch_path("kf_overlay/on_disk.kf"), "")
    assert_eq(ov.overlay_read(Dir.scratch_path("kf_overlay/on_disk.kf")).as_str(), "",
        "an emptied buffer reads empty, not as what disk still holds")
}

@test
fun several_files_can_be_staged_at_once(): void {
    prepare_overlay_fixture()
    var ov = overlay_for(Dir.scratch_path("kf_overlay/on_disk.kf"), "one")
    ov.stage(Dir.scratch_path("kf_overlay/other.kf"), "two")
    assert_eq(ov.overlay_read(Dir.scratch_path("kf_overlay/on_disk.kf")).as_str(), "one", "the first stays staged")
}

@test
fun staging_a_path_again_replaces_its_text(): void {
    prepare_overlay_fixture()
    var ov = overlay_for(Dir.scratch_path("kf_overlay/on_disk.kf"), "old")
    ov.stage(Dir.scratch_path("kf_overlay/on_disk.kf"), "new")
    assert_eq(ov.overlay_read(Dir.scratch_path("kf_overlay/on_disk.kf")).as_str(), "new", "the latest edit wins")
}

@test
fun an_unstaged_file_is_read_from_disk_again(): void {
    prepare_overlay_fixture()
    var ov = overlay_for(Dir.scratch_path("kf_overlay/on_disk.kf"), "edited")
    ov.unstage(Dir.scratch_path("kf_overlay/on_disk.kf"))
    assert_eq(ov.overlay_read(Dir.scratch_path("kf_overlay/on_disk.kf")).as_str(), "fun f(): int32 { return 1 }\n",
        "closing the buffer drops its text")
}
