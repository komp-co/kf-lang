import core.assert.assert_eq

import kf_core.span.*
import std.fs.scratch_path

fun test_source_map(): Ptr<SourceMap> {
    val smap: Ptr<SourceMap> = unsafe { alloc<SourceMap>() }
    unsafe { *smap = new_source_map() }
    return smap
}

@test
fun compiled_interface_file_loads_modules(): void {
    write_file(scratch_path("kf_valid.kfi"), "{\"kfi\":11,\"crate\":\"dep\",\"compiler_abi\":\"komp-1\",\"runtime_abi\":\"kflat-runtime-1\",\"target\":\"x86_64-linux-gnu\",\"deps\":[],\"glue\":[],\"dyn_traits\":[],\"dyn_vtables\":[],\"modules\":[{\"path\":\"dep.api\",\"files\":[],\"decls\":[]}]}")
    val loaded = load_compiled_crate(scratch_path("kf_valid.kfi"), test_source_map())
    assert_eq(loaded.modules.size(), 1, "interface file restores one module")
}

@test
fun malformed_compiled_interface_reports_error(): void {
    write_file(scratch_path("kf_bad.kfi"), "{")
    val loaded = load_compiled_crate(scratch_path("kf_bad.kfi"), test_source_map())
    assert_eq(loaded.error.as_str(), "malformed interface JSON", "malformed interface is diagnosed")
}
