import core.assert.assert_eq

import testing.test
import kf_core.intern.CrateId

@test
fun ownership_validation_rejects_poison_module(): void {
    val module = module_with_nested_decl()
    assert_eq(module.module_has_valid_ownership(), false, "unstamped module is invalid")
}

@test
fun ownership_validation_accepts_stamped_module(): void {
    var module = module_with_nested_decl()
    stamp_module_owner(&var module, CrateId.new("json"))
    assert_eq(module.module_has_valid_ownership(), true, "stamped module is valid")
}
