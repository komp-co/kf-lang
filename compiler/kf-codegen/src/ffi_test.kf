import std.fs.*
import std.process.*
import core.assert.assert_eq

@test fun ffi_run_echo_returns_zero(): void {
    var command = Command.new("/bin/echo")
    command.arg("hello")
    val rc = command.status().exit_code()
    assert_eq(rc == 0, true, "echo /bin/echo runs and returns 0")
}

@test fun ffi_write_then_read_file_roundtrip(): void {
    val path = scratch_path("kf_codegen_ffi_smoke.txt")
    write_file(path, "hi from komp\n")
    val contents = read_file(path)
    assert_eq(contents.as_str(), "hi from komp\n", "file contents roundtrip")
}

@test fun ffi_command_redirects_output_to_file(): void {
    val temp = TempDir.new("kf-codegen-ffi")
    val out_path = temp.path().join("output.txt")
    var command = Command.new("/bin/echo")
    command.arg("asdf")
    command.stdout_to(out_path)
    val rc = command.status().exit_code()
    assert_eq(rc == 0, true, "echo returned 0")
    val contents = read_file(out_path.as_str())
    assert_eq(contents.as_str(), "asdf\n", "redirected output was written")
}
