// String concatenation. Each helper takes its Strings by value and owns them,
// so `concat` appends into `a`'s buffer instead of copying it.

/// Concatenate two Strings into one owning value, reusing `a`'s buffer.
pub fun concat(a: String, b: String): String {
    var out = a
    out.append(b.as_str())
    return out
}

pub fun concat3(a: String, b: String, c: String): String {
    var out = a
    out.append(b.as_str())
    out.append(c.as_str())
    return out
}

pub fun concat4(a: String, b: String, c: String, d: String): String {
    var out = a
    out.append(b.as_str())
    out.append(c.as_str())
    out.append(d.as_str())
    return out
}

/// `at(i)`, since `get` on a move-only element would auto-clone it.
pub fun concat_all(parts: List<String>): String {
    var acc = ""
    while part in &parts {
        acc.append(part.as_str())
    }
    return acc
}
