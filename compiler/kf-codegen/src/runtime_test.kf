import core.assert.assert_eq
import kf_codegen.runtime.emit_runtime_header
import kf_core.runtime.runtime_header_declares

// `String` is defined once, in core, beside the prototypes that pass it by
// value.
@test
fun the_prelude_does_not_define_the_string_layout(): void {
    val header = emit_runtime_header()
    assert_eq(header.as_str().contains("uint8_t* data; uint64_t len; uint64_t cap;"), false, "the layout belongs to core, which declares it once")
}

// So the prelude carries no prototype passing or returning `String` by value;
// an incomplete type cannot be passed by value.
@test
fun the_prelude_declares_no_string_by_value(): void {
    val header = emit_runtime_header()
    val by_value = header.as_str().contains("String __kf_v2_str_concat") || header.as_str().contains("String read_file")
    assert_eq(by_value, false, "a by-value String prototype drags the layout back into the prelude")
}

@test
fun runtime_interner_reserves_zero_for_poison(): void {
    val source = read_file("compiler/kf-core/native/compiler.c")
    assert_eq(source.as_str().contains("static uint32_t kf_sym_count = 1;"), true, "runtime interner starts after poison")
}

@test
fun runtime_header_declares_std_process_and_fs_helpers(): void {
    val header = emit_runtime_header()
    val has_mkdir = header.as_str().contains("int32_t kf_create_dir_all(const char* path);")
    val has_remove = header.as_str().contains("int32_t kf_remove_dir_all(const char* path);")
    val has_process = header.as_str().contains("int32_t kf_process_status(")
    assert_eq(has_mkdir && has_remove && has_process, true, "runtime header exposes std helpers across crate units")
    // String-returning helpers live in `core.runtime_string_hosted`.
    val moved = header.as_str().contains("kf_current_dir") || header.as_str().contains("kf_temp_dir")
    assert_eq(moved, false, "a String-returning helper is declared beside the struct")
}

@test
fun runtime_header_declares_exit_without_stdlib(): void {
    val header = emit_runtime_header()
    val has_prototype = header.as_str().contains("void exit(int status);")
    assert_eq(has_prototype && runtime_header_declares("exit"), true, "runtime header makes exit available to every generated unit")
}
