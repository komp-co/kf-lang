import core.assert.assert_eq
import alloc.list.*

@test
fun copied_list_elements_are_owned(): void {
    var source = List.new<String>()
    source.push(String.from("hello"))
    val copied = source.clone()
    source.pop()
    assert_eq(copied.at(0).as_str(), "hello", "list clone owns its elements")
}

@test
fun copied_list_nested_buffers_are_owned(): void {
    var inner = List.new<String>()
    inner.push(String.from("nested"))
    var source = List.new<List<String>>()
    source.push(inner)
    val copied = source.clone()
    source.pop()
    val copied_inner = *copied.at(0)
    assert_eq(copied_inner.at(0).as_str(), "nested", "nested list clone owns inner buffers")
}
