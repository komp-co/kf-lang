// Declarations shared by generated C and native translation units. It is in
// every generated TU, so it includes only the three type-only standard
// headers: pulling in <stdio.h> would make a user's fixed-arity
// `extern "C" fun printf` binding contradict the real prototype.

pub fun emit_runtime_header(): String {
    // A raw literal, so the header reads as a header.
    return String.from("""// generated by komp
#ifndef KF_RUNTIME_H
#define KF_RUNTIME_H

#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>

void* kf_alloc(size_t size);
void kf_free(void* ptr);
void* kf_realloc(void* ptr, size_t size);
void exit(int status);

// The unit value. `void` is a type with exactly one value, and a value needs a
// place to live wherever one is STORED — a local, a parameter, a field, a
// variant payload. In RETURN position `void` stays C `void`, the same erasure
// Rust applies to `()`.
#ifndef KF_UNIT_LAYOUT
#define KF_UNIT_LAYOUT
typedef struct kf_unit { uint8_t _u; } kf_unit;
#endif

uint32_t kf_sym_intern(const char* s);
const char* kf_sym_resolve(uint32_t id);
uint64_t kf_fs_dir_open(const char* path);
const char* kf_fs_dir_next(uint64_t handle);
void kf_fs_dir_close(uint64_t handle);
bool str_equals(const char* a, const char* b);
const char* str_as_str(const char* s);
void runtime_print(const char* s);
void runtime_println(const char* s);
void panic(const char* s);
bool is_dir(const char* p);
void write_file(const char* path, const char* content);
void kf_arg_init(int argc, char** argv);
int32_t kf_arg_count(void);
const char* kf_arg_get(int32_t i);
uint64_t kf_str_byte_len(const char* s);
uint8_t kf_str_byte_at(const char* s, uint64_t i);
uint64_t kf_file_hash(const char* path);

int32_t kf_create_dir_all(const char* path);
int32_t kf_remove_dir_all(const char* path);
int32_t kf_process_status(const char* program, void* args, const char* cwd, void* environment, const char* stdout_path);

#endif
""")
}

/// Whether the header above declares `name`, so no second prototype is
/// emitted for a source-local extern. String-returning entry points are
/// declared in `alloc.runtime_string*` instead, beside the struct.
///
/// CONSTRAINT: keep in step with the emitted text.
pub fun runtime_header_declares(name: str): bool {
    // Allocation ABI.
    if name.equals("kf_alloc")                  { return true }
    if name.equals("kf_free")                   { return true }
    if name.equals("kf_realloc")                { return true }
    if name.equals("exit")                      { return true }
    // symbol interning
    if name.equals("kf_sym_intern")             { return true }
    if name.equals("kf_sym_resolve")            { return true }
    // directory walk
    if name.equals("kf_fs_dir_open")            { return true }
    if name.equals("kf_fs_dir_next")            { return true }
    if name.equals("kf_fs_dir_close")           { return true }
    // io / string helpers
    if name.equals("write_file")                { return true }
    if name.equals("str_equals")                { return true }
    if name.equals("str_as_str")                { return true }
    if name.equals("runtime_print")             { return true }
    if name.equals("runtime_println")           { return true }
    if name.equals("panic")                     { return true }
    if name.equals("is_dir")                    { return true }
    if name.equals("kf_str_byte_len")           { return true }
    if name.equals("kf_str_byte_at")            { return true }
    if name.equals("kf_file_hash")              { return true }
    // process / environment
    if name.equals("kf_arg_init")               { return true }
    if name.equals("kf_arg_count")              { return true }
    if name.equals("kf_arg_get")                { return true }
    if name.equals("kf_create_dir_all")         { return true }
    if name.equals("kf_remove_dir_all")         { return true }
    if name.equals("kf_process_status")         { return true }
    return false
}
