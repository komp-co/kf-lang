import core.assert.assert_eq

@test fun a_subject_read_by_address_is_a_pointer(): void {
    val decl = when_subject_decl(String.from("Opt"), String.from("x"), true)
    assert_eq(decl.as_str(), "Opt* __when_subj = &(x);\n", "by address")
}

@test fun a_subject_read_by_value_is_a_copy(): void {
    val decl = when_subject_decl(String.from("Opt"), String.from("x"), false)
    assert_eq(decl.as_str(), "Opt __when_subj = x;\n", "by value")
}

@test fun a_reference_binder_takes_the_payload_address(): void {
    assert_eq(binder_init(String.from("s->u.V_Some._0"), true).as_str(), "&(s->u.V_Some._0)", "the address")
}

@test fun a_copy_binder_reads_the_payload(): void {
    assert_eq(binder_init(String.from("s.u.V_Some._0"), false).as_str(), "s.u.V_Some._0", "the value")
}

@test fun a_reference_catch_all_over_an_address_is_the_pointer(): void {
    assert_eq(whole_subject_read(true, true).as_str(), "__when_subj", "already an address")
}

@test fun a_copy_catch_all_over_an_address_reads_through_it(): void {
    assert_eq(whole_subject_read(false, true).as_str(), "(*__when_subj)", "the value behind it")
}
