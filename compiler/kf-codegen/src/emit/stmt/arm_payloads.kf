// The release function for each enum payload, so a `when` arm binder emitted
// as `__auto_type __b = __when_subj.u.V_X._0;` can be dropped. Built once per
// module and carried on `LocalEnv`.

import kf_core.ast.Module
import kf_codegen.emit.glue.is_box_tref
import kf_codegen.emit.c_type
import kf_codegen.emit.release_fn_for_ctype

/// Keyed "<Enum>/<Variant>/<index>", each payload's release function ("" for
/// none). The first view to add a key answers for it.
pub struct ArmPayloads {
    var rels: HashMap<String, String>
}

pub fun no_arm_payloads(): ArmPayloads {
    return ArmPayloads { rels: HashMap.new<String, String>() }
}

pub fun arm_payload_key(ename: str, vname: str, idx: uint64): String {
    val n = "${idx}"
    return String.from(ename) + String.from("/") + String.from(vname) + String.from("/") + n
}

/// Primitives and raw pointers answer "". So does a `Box<T>` payload, which
/// needs pointee-then-free: it leaks rather than double-frees.
pub fun Module.build_arm_payloads(): ArmPayloads {
    var out = no_arm_payloads()
    out.add_arm_payloads(self)
    return out
}

/// Crate and unity builds hold the declarations in different views, so the
/// caller adds every view it has.
pub mutating fun ArmPayloads.add_arm_payloads(m: &Module): void {
    val decls = m.decls
    while td in &decls {
        val k = td.kind
        when (k) {
            EnumDecl(variants, _p) => {
                val ename = td.name.as_string()
                while v in &variants {
                    var pj = 0
                    while pj < v.payloads.size() {
                        val pt = *v.payloads.at(pj)
                        // A binder rc owns releases as its `Box` would: pointee, then box.
                        val rel = pt.boxed_release() ?: release_fn_for_ctype(pt.c_type().as_str())
                        val key = arm_payload_key(ename, v.name.as_string().as_str(), pj)
                        if !self.rels.contains(&key) { self.rels.insert(key, rel) }
                        pj = pj + 1
                    }
                }
            }
            _ => {}
        }
    }
}

/// "" when none is needed or the enum is unknown.
pub fun ArmPayloads.arm_payload_release(ename: str, vname: str, idx: uint64): String {
    when (self.rels.get(&arm_payload_key(ename, vname, idx))) {
        Some(rel) => return rel.clone()
        None => return ""
    }
}

/// A `Box<Inner>`'s release sentinel, or null for any other type.
fun TypeRef.boxed_release(): String? {
    if !is_box_tref(*self) { return null }
    when (self.kind) {
        Named(_n, args) => if args.size() == 1 {
            return "__BOX__${release_fn_for_ctype(args.at(0).c_type().as_str())}"
        }
        _ => { }
    }
    return null
}
