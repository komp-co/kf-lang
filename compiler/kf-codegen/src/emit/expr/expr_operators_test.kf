import core.assert.assert_eq

@test fun int64_equals_takes_self_by_pointer(): void {
    assert_eq(self_is_by_value("int64_equals"), false, "a trait impl on int64 takes a pointer")
}

@test fun a_str_method_takes_self_by_value(): void {
    assert_eq(self_is_by_value("str_equals"), true, "str is passed as a view")
}

@test fun a_synthesized_clone_takes_self_by_pointer(): void {
    assert_eq(self_is_by_value("str_clone"), false, "clone takes a pointer at every type")
}
