// Applies crate-qualified renames to a merged module in two phases:
//
//   qualify_type_symbols      after TypeCheck, before Mono, so every name
//                             Mono derives is built from qualified types.
//   qualify_function_symbols  after Lower, through each call's
//                             mangled_callee, which is assignable in place.
//
// Unity builds call neither, only qualify_taken_type_symbols for the types
// C's own names would collide with. Folded intrinsic callees (`alloc__T`) keep
// unqualified fragments, and generic templates are not qualified.

import alloc.list.*

import kf_core.ast.Module
import kf_core.ast.types.TypeRef
import kf_core.ast.declaration.*

import kf_core.ast.subst.subst_dyn_layouts
import kf_core.ast.subst.subst_dyn_vtables
import kf_core.ast.subst.subst_type_ref
import kf_core.intern.intern_string

/// Structs and enums become `<crate>__<name>`, and every reference to them
/// is respelled.
pub mutating fun Module.qualify_type_symbols(): void {
    var subst = Substitution.new()
    self.collect_type_renames(&var subst)
    if subst.names.size() == 0 { return }
    while i in 0..self.decls.size() {
        qualify_decl(self.decls.at_mut(i), &subst, true)
    }
}

/// A unity build's types keep their bare names, except one C has taken: a
/// struct named `main` beside the program's `int main`.
pub mutating fun Module.qualify_taken_type_symbols(): void {
    var subst = Substitution.new()
    self.collect_taken_type_renames(&var subst)
    if subst.names.size() == 0 { return }
    while i in 0..self.decls.size() {
        qualify_decl(self.decls.at_mut(i), &subst, true)
    }
}

/// Free functions become `<crate>__<name>`, with matching Call callees.
pub mutating fun Module.qualify_function_symbols(): void {
    var subst = Substitution.new()
    self.collect_fn_renames(&var subst)
    if subst.names.size() == 0 { return }
    while i in 0..self.decls.size() {
        qualify_decl(self.decls.at_mut(i), &subst, false)
    }
}

// Signatures and bodies are walked in both phases; a table entry only
// matches its own phase's names.
mutating fun TopDecl.qualify_decl(subst: &Substitution, rename_types: bool): void {
    if rename_types {
        self.dyn_layouts = subst_dyn_layouts(&self.dyn_layouts, subst)
        self.dyn_vtables = subst_dyn_vtables(&self.dyn_vtables, subst)
    }
    when (self.kind) {
        Struct(fields, _pub) => {
            if !rename_types { return }
            self.rename_decl_if_mapped(subst)
            qualify_field_list(fields, subst)
        }
        EnumDecl(variants, _pub) => {
            if !rename_types { return }
            self.rename_decl_if_mapped(subst)
            qualify_variant_list(&var variants, subst)
        }
        Function(params, ret, body, _pub, _u, _mut, _st) => {
            if rename_types {
                qualify_param_list(params, subst)
                qualify_tyref_ptr(ret, subst)
            } else {
                self.rename_decl_if_mapped(subst)
            }
            qualify_stmt_list(body, subst, rename_types)
        }
        Extern(params, ret, _pub, _u) => {
            if !rename_types { return }
            qualify_param_list(params, subst)
            qualify_tyref_ptr(ret, subst)
        }
        ImplBlock(methods) => {
            if rename_types { self.rename_decl_if_mapped(subst) }
            qualify_method_list(methods, subst, rename_types)
        }
        TraitImpl(tref, methods) => {
            if rename_types { self.rename_decl_if_mapped(subst) }
            // The trait reference is a type position, and a literal argument
            // (`impl Call1<Point> for GetX`) is spelled only here. Mono builds
            // the dispatch suffix from it, so it must match the qualified call
            // sites.
            if rename_types { qualify_tyref_ptr(tref, subst) }
            qualify_method_list(methods, subst, rename_types)
        }
        AssocType(_bounds) => return
        AssocTypeBinding(_chosen) => return
        AnnotationDecl(_params, _target, _pub) => return
        Template(_kind, _marked, _body) => return
        Constant(_ty, _value, _pub) => return
        TraitDecl(_meths, _pub, _) => return
        Poison => return
    }
}

mutating fun TopDecl.rename_decl_if_mapped(subst: &Substitution): void {
    val hit = rename_lookup(self.name.as_str(), subst)
    if hit.byte_len() == 0 { return }
    self.name = intern_string(hit)
}

fun qualify_method_list(methods: &List<TopDecl>, subst: &Substitution, rename_types: bool): void {
    while mth in &methods {
        when (mth.kind) {
            Function(params, ret, body, _pub, _u, _mut, _st) => {
                if rename_types {
                    qualify_param_list(params, subst)
                    qualify_tyref_ptr(ret, subst)
                }
                qualify_stmt_list(body, subst, rename_types)
            }
            // A binding subst.names a type, and Mono reads it after this pass.
            AssocTypeBinding(chosen) => { if rename_types { qualify_tyref_ptr(chosen, subst) } }
            _ => {}
        }
    }
}

fun qualify_field_list(fields: &List<Field>, subst: &Substitution): void {
    while f in &fields {
        qualify_tyref_ptr(f.ty, subst)
    }
}

fun qualify_variant_list(variants: &var List<Variant>, subst: &Substitution): void {
    while vi in 0..variants.size() {
        val v = variants.at_mut(vi)
        while j in 0..v.payloads.size() {
            val pp: Ptr<TypeRef> = unsafe { v.payloads.at_mut(j) as Ptr<TypeRef> }
            qualify_tyref_ptr(pp, subst)
        }
    }
}

fun qualify_param_list(params: &List<Param>, subst: &Substitution): void {
    while p in &params {
        qualify_tyref_ptr(p.ty, subst)
    }
}

/// A null (inferred) annotation passes through.
pub fun qualify_tyref_ptr(popt: Ptr<TypeRef>?, subst: &Substitution): void {
    val p = popt ?: return
    val next = subst_type_ref(unsafe { &*p }, subst)
    unsafe { *p = next }
}
