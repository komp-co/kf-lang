// Rewrites one function body so every type spelling matches the renamed
// declarations, and in the function phase retargets Call mangled_callees.
// Mutates in place; only a type-name Variable receiver is replaced whole.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.statement.Stmt

import kf_core.ast.subst.subst_mangled_name
import kf_core.ast.subst.subst_static_callee
import kf_core.intern.*
import kf_core.names.CName
import kf_core.ast.expression.*
import kf_core.ast.types.*

pub fun qualify_stmt_list(stmts: &var List<Stmt>, subst: &Substitution, rename_types: bool): void {
    while i in 0..stmts.size() {
        // In place, so the module sees the rewrite.
        (stmts.at_mut(i)).qualify_stmt(subst, rename_types)
    }
}

mutating fun Stmt.qualify_stmt(subst: &Substitution, rename_types: bool): void {
    when (self.kind) {
        LetVal(_n, ty_p, init_p) => {
            if rename_types { qualify_tyref_ptr(ty_p.view(), subst) }
            qualify_expr_ptr_opt(init_p.view(), subst, rename_types)
        }
        LetVar(_n, ty_p, init_p) => {
            if rename_types { qualify_tyref_ptr(ty_p.view(), subst) }
            qualify_expr_ptr_opt(init_p.view(), subst, rename_types)
        }
        Assign(_n, ep) => qualify_expr_ptr(ep, subst, rename_types)
        AssignTo(pp, ep) => {
            qualify_expr_ptr(pp, subst, rename_types)
            qualify_expr_ptr(ep, subst, rename_types)
        }
        Return(ep) => {
            val p = ep ?: return
            qualify_expr_ptr(p, subst, rename_types)
        }
        If(cp, then_body, else_body) => {
            qualify_expr_ptr(cp, subst, rename_types)
            qualify_stmt_list(then_body, subst, rename_types)
            qualify_stmt_list(else_body, subst, rename_types)
        }
        While(cp, body) => {
            qualify_expr_ptr(cp, subst, rename_types)
            qualify_stmt_list(body, subst, rename_types)
        }
        When(subj, arms) => {
            qualify_expr_ptr(subj, subst, rename_types)
            while i in 0..arms.size() {
                var a = arms.at_mut(i)
                qualify_expr_ptr_opt(a.guard.view(), subst, rename_types)
                qualify_stmt_list(&var a.body, subst, rename_types)
            }
        }
        Switch(subj, sarms) => {
            qualify_expr_ptr(subj, subst, rename_types)
            while i in 0..sarms.size() {
                var sa = sarms.at_mut(i)
                qualify_expr_ptr_opt(sa.guard.view(), subst, rename_types)
                qualify_stmt_list(&var sa.guard_prelude, subst, rename_types)
                qualify_stmt_list(&var sa.body, subst, rename_types)
            }
        }
        Expression(ep) => qualify_expr_ptr(ep, subst, rename_types)
        _ => return
    }
}

fun qualify_expr_ptr_opt(p_opt: Ptr<Expr>?, subst: &Substitution, rename_types: bool): void {
    val p = p_opt ?: return
    qualify_expr_ptr(p, subst, rename_types)
}

fun qualify_expr_ptr(ep: Ptr<Expr>, subst: &Substitution, rename_types: bool): void {
    val e = unsafe { *ep }
    // Types were respelled in the type phase; a function name never subst.names one.
    if rename_types {
        unsafe { ep.ty = qualify_type(e.ty, subst) }
        qualify_type_args(unsafe { &var ep.type_args }, subst)
    }
    if rename_types && e.is_dynamic_call {
        val layout = subst_mangled_name(e.dynamic_layout.as_str(), subst)
        unsafe { ep.dynamic_layout = intern(layout.as_str()) }
    }
    when (e.kind) {
        Variable(vn) => {
            // A local of a type's name has a type of its own; only a
            // type-name receiver, which the checker leaves untyped, is a type.
            if !rename_types || !e.ty.is_poison() { return }
            val hit = rename_lookup(vn.as_str(), subst)
            if hit.byte_len() == 0 { return }
            // A type-name receiver is respelled so codegen's receiver-name
            // comparison still matches.
            val sp: Span = e.span
            unsafe { *ep = Expr.new(sp, ExprKind.Variable(intern_string(hit))) }
        }
        Binary(lp, _op, rp) => {
            qualify_expr_ptr(lp, subst, rename_types)
            qualify_expr_ptr(rp, subst, rename_types)
        }
        Unary(_o, ip) => qualify_expr_ptr(ip, subst, rename_types)
        Deref(ip) => qualify_expr_ptr(ip, subst, rename_types)
        FnRef(n) => {
            if rename_types { return }
            val lookup_name = if e.mangled_callee.as_str() == "" { n.as_string() } else { e.mangled_callee.as_string() }
            val hit = rename_lookup(lookup_name, subst)
            if hit.byte_len() > 0 {
                unsafe { ep.mangled_callee = intern_string(hit) }
            }
        }
        CallValue(callee, args) => {
            qualify_expr_ptr(callee, subst, rename_types)
            qualify_expr_args(args, subst, rename_types)
        }
        Intrinsic(_intrinsic, args) => qualify_expr_args(args, subst, rename_types)
        Call(_n, args) => {
            qualify_expr_args(args, subst, rename_types)
            if rename_types {
                if CName.is_mangled(e.mangled_callee.as_str()) {
                    unsafe { ep.mangled_callee = intern(subst_mangled_name(e.mangled_callee.as_str(), subst).as_str()) }
                }
            } else {
                val lookup_name = if e.mangled_callee.as_str() == "" { _n.as_string() } else { e.mangled_callee.as_string() }
                val hit = rename_lookup(lookup_name, subst)
                if hit.byte_len() > 0 {
                    unsafe { ep.mangled_callee = intern_string(hit) }
                }
            }
        }
        MethodCall(rp, _mn, args) => {
            // Read before qualifying: compared against the callee's
            // unqualified owner.
            val recv_before = static_recv_variable_name(rp)
            val recv_ty_before = qualified_method_owner(unsafe { rp.ty })
            val recv_param = bound_method_owner(unsafe { rp.ty }, e.mangled_callee.as_str())
            val via_bound = recv_param.byte_len() > 0 &&
                callee_method_tail(e.mangled_callee.as_str(), recv_param, _mn.as_str()).matched
            qualify_expr_ptr(rp, subst, rename_types)
            qualify_expr_args(args, subst, rename_types)
            if rename_types && e.is_static_call {
                if callee_targets_receiver(e.mangled_callee.as_str(), recv_before, _mn.as_str()) {
                    rebuild_static_callee(ep, rp, _mn, &recv_before, subst)
                } else {
                    // A trait-qualified receiver subst.names the trait; only the
                    // callee's type segment is respelled.
                    unsafe { ep.mangled_callee = intern(subst_static_callee(e.mangled_callee.as_str(), subst).as_str()) }
                }
            } else if rename_types && !e.mangled_callee.as_str().equals("") && !CName.is_mangled(e.mangled_callee.as_str()) {
                unsafe { ep.mangled_callee = intern(subst_static_callee(e.mangled_callee.as_str(), subst).as_str()) }
            } else if rename_types && instance_callee_targets_receiver(e.mangled_callee.as_str(), _mn.as_str(), recv_ty_before) {
                // A trait-impl method through an instance call: rebuilt around
                // the qualified receiver type, trait tail kept.
                val owner = qualified_method_owner(unsafe { rp.ty })
                if owner.as_str() != "" {
                    // The tail's types take the prefix too.
                    val split = callee_method_tail(e.mangled_callee.as_str(), recv_ty_before, _mn.as_str())
                    val tail = subst_mangled_name(split.tail, subst)
                    var callee = owner
                    callee.append("_")
                    callee.append(_mn.as_str())
                    callee.append(tail)
                    unsafe { ep.mangled_callee = intern(callee) }
                }
            } else if rename_types && via_bound {
                // Through a parameter's or associated type's bound: the owner is
                // left for Mono; the tail's trait arguments are qualified.
                val split = callee_method_tail(e.mangled_callee.as_str(), recv_param, _mn.as_str())
                val tail = subst_mangled_name(split.tail, subst)
                val callee = "${recv_param}_${_mn.as_str()}${tail}"
                unsafe { ep.mangled_callee = intern(callee) }
            } else if rename_types && (e.mangled_callee.as_str() == "" || e.mangled_callee.as_str() == _mn.as_str()) {
                val receiver = unsafe { *rp }
                val owner = qualified_method_owner(receiver.ty)
                if owner.as_str() != "" {
                    var callee = owner
                    callee.append("_")
                    callee.append(_mn.as_str())
                    unsafe { ep.mangled_callee = intern(callee) }
                }
            } else if !rename_types && (e.mangled_callee.as_str() == "" || e.mangled_callee.as_str() == _mn.as_str()) {
                val hit = rename_lookup(_mn.as_str(), subst)
                if hit.as_str() != "" {
                    unsafe { ep.mangled_callee = intern_string(hit) }
                }
            }
        }
        FieldAccess(rp, _f) => qualify_expr_ptr(rp, subst, rename_types)
        IfExpr(cp, tp, ep2) => {
            qualify_expr_ptr(cp, subst, rename_types)
            qualify_expr_ptr(tp, subst, rename_types)
            qualify_expr_ptr(ep2, subst, rename_types)
        }
        // Qualification runs before Lower, so the expression form is still here.
        WhenExpr(subj, arms) => {
            qualify_expr_ptr(subj, subst, rename_types)
            while i in 0..arms.size() {
                var a = arms.at_mut(i)
                qualify_expr_ptr_opt(a.guard.view(), subst, rename_types)
                qualify_stmt_list(&var a.body, subst, rename_types)
            }
        }
        // Block values are still expressions here too.
        Block(stmts) => {
            while i in 0..stmts.size() {
                (stmts.at_mut(i)).qualify_stmt(subst, rename_types)
            }
        }
        StructLit(sn, finits) => {
            while fi in &finits {
                qualify_expr_ptr(fi.value, subst, rename_types)
            }
            // The renamed constructor goes through the mangled_callee override.
            // An existing value is looked up too: `Self { ... }` arrives with
            // the unqualified impl target. A Mono mangle never hits the table.
            if rename_types {
                var key = String.from(sn.as_str())
                if e.mangled_callee.as_str() != "" { key = e.mangled_callee.as_string() }
                val hit = rename_lookup(key, subst)
                if hit.byte_len() > 0 {
                    unsafe { ep.mangled_callee = intern_string(hit) }
                }
            }
        }
        Cast(ip, tp) => {
            qualify_expr_ptr(ip, subst, rename_types)
            if rename_types { qualify_tyref_ptr(tp, subst) }
        }
        DynCoerce(ip, vtable) => {
            // The vtable identity is a type name; the value is qualified. The
            // raw store keeps the old kind, so the value moves across as is.
            val concrete_vtable = subst_mangled_name(vtable.as_str(), subst)
            val value: Ptr<Expr> = ip
            qualify_expr_ptr(value, subst, rename_types)
            unsafe { ep.kind = ExprKind.DynCoerce(value, intern(concrete_vtable.as_str())) }
        }
        Retain(ip) => qualify_expr_ptr(ip, subst, rename_types)
        _ => return
    }
}
