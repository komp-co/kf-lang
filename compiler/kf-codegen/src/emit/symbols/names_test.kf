import core.assert.assert_eq

import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.types.*
import kf_core.ast.declaration.*
import kf_core.ast.statement.Stmt
import testing.test
import kf_core.intern.*
import kf_core.names.*

fun test_ty_ptr(s: str): Ptr<TypeRef> {
    val rp: Ptr<TypeRef> = unsafe { alloc<TypeRef>() }
    unsafe { *rp = TypeRef.new(Span.none(), TypeRefKind.Named(intern(s), List.new<TypeRef>())) }
    return rp
}

fun owned_struct_decl(name: str): TopDecl {
    var td = TopDecl.new(Span.none(), String.from(name), TopDeclKind.Struct(List.new<Field>(), true))
    td.crate = CrateId.new("aa")
    td.module_path = intern("aa.geo")
    return td
}

fun owned_fn_decl(name: str): TopDecl {
    val fkind = TopDeclKind.Function(List.new<Param>(), test_ty_ptr("int32"), List.new<Stmt>(), true, false, false, false)
    var td = TopDecl.new(Span.none(), String.from(name), fkind)
    td.crate = CrateId.new("aa")
    td.module_path = intern("aa.lib")
    return td
}

fun module_of_one(td: TopDecl): Module {
    var decls = List.new<TopDecl>()
    decls.push(td)
    return Module { crate: CrateId.new("aa"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

@test
fun poison_crate_has_no_prefix(): void {
    assert_eq(CrateId.new_poison().symbol_prefix().as_str(), "", "poison owner keeps bare names")
}

@test
fun crate_prefix_is_double_underscored(): void {
    assert_eq(CrateId.new("sc1a").symbol_prefix().as_str(), "sc1a__", "crate prefix is <crate>__")
}

@test
fun crate_prefix_sanitizes_non_identifier_bytes(): void {
    assert_eq(CrateId.new("kf-core").symbol_prefix().as_str(), "kf_core__", "'-' becomes '_' in a C symbol")
}

@test
fun double_underscore_marks_a_mangled_name(): void {
    assert_eq(CName.is_mangled("List__int32"), true, "mono mangles are detected")
}

@test
fun single_underscores_are_ordinary_names(): void {
    assert_eq(CName.is_mangled("json_quote"), false, "ordinary names are not mangles")
}

@test
fun type_renames_key_bare_and_canonical_names(): void {
    val m = module_of_one(owned_struct_decl("Point"))
    var subst = Substitution.new()
    m.collect_type_renames(&var subst)
    assert_eq(subst.names.size() == 3, true, "one struct yields stable, bare, and canonical keys")
}

@test
fun bare_type_name_maps_to_qualified(): void {
    val m = module_of_one(owned_struct_decl("Point"))
    var subst = Substitution.new()
    m.collect_type_renames(&var subst)
    assert_eq(rename_lookup("Point", &subst).as_str(), "aa__Point", "bare name maps to <crate>__<name>")
}

@test
fun canonical_identity_maps_to_qualified(): void {
    val m = module_of_one(owned_struct_decl("Point"))
    var subst = Substitution.new()
    m.collect_type_renames(&var subst)
    val canon = canonical_type_identity(TypeIdentity.new(CrateId.new("aa"), intern("aa.geo"), intern("Point")))
    assert_eq(rename_lookup(canon.as_str(), &subst).as_str(), "aa__Point", "canonical identity maps to the same symbol")
}

@test
fun generic_templates_are_not_renamed(): void {
    var td = owned_struct_decl("Wrap")
    var generics = List.new<TypeParam>()
    generics.push(TypeParam.new(Span.none(), String.from("T")))
    td.generics = generics
    val m = module_of_one(td)
    var subst = Substitution.new()
    m.collect_type_renames(&var subst)
    assert_eq(subst.names.size() == 0, true, "template subst.names stay bare until SC-6")
}

@test
fun unstamped_decls_are_not_renamed(): void {
    var td = owned_struct_decl("Point")
    td.crate = CrateId.new_poison()
    val m = module_of_one(td)
    var subst = Substitution.new()
    m.collect_type_renames(&var subst)
    assert_eq(subst.names.size() == 0, true, "poison owners keep bare subst.names")
}

@test
fun free_functions_rename_with_their_crate(): void {
    val m = module_of_one(owned_fn_decl("answer"))
    var subst = Substitution.new()
    m.collect_fn_renames(&var subst)
    assert_eq(rename_lookup("answer", &subst).as_str(), "aa__answer", "free function maps to <crate>__<name>")
}

@test
fun main_is_never_renamed(): void {
    val m = module_of_one(owned_fn_decl("main"))
    var subst = Substitution.new()
    m.collect_fn_renames(&var subst)
    assert_eq(subst.names.size() == 0, true, "the C entry point keeps its name")
}

@test
fun rename_lookup_misses_with_empty_string(): void {
    var subst = Substitution.new()
    assert_eq(rename_lookup("unknown", &subst).as_str(), "", "a miss returns the empty sentinel")
}

/// `impl Counter { fun get() }` in crate "aa", its owner already renamed as
/// qualify_type_symbols leaves it.
fun module_with_method(owner_name: str): Module {
    var methods = List.new<TopDecl>()
    methods.push(owned_fn_decl("get"))
    var impl_decl = TopDecl.new(Span.none(), String.from(owner_name), TopDeclKind.ImplBlock(methods))
    impl_decl.crate = CrateId.new("aa")
    impl_decl.module_path = intern("aa.lib")
    return module_of_one(impl_decl)
}

@test
fun a_method_value_renames_to_its_symbol(): void {
    val m = module_with_method("aa__Counter")
    var subst = Substitution.new()
    m.collect_fn_renames(&var subst)
    assert_eq(rename_lookup("Counter_get", &subst).as_str(), "aa__Counter_get", "keyed unprefixed")
}

@test
fun an_unprefixed_owner_keeps_its_name(): void {
    val owner = owned_struct_decl("Counter")
    assert_eq(owner.unprefixed_name().as_str(), "Counter", "nothing to strip")
}

@test
fun a_prefixed_owner_loses_its_prefix(): void {
    val owner = owned_struct_decl("aa__Counter")
    assert_eq(owner.unprefixed_name().as_str(), "Counter", "the crate's prefix goes")
}
