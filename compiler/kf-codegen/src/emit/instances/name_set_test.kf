import core.assert.assert_eq

@test fun a_name_added_twice_is_kept_once(): void {
    var set = NameSet.new()
    set.add(String.from("List__int32"))
    set.add(String.from("List__int32"))
    assert_eq(set.names.size(), 1, "the repeat is dropped")
}

@test fun names_keep_the_order_they_arrived_in(): void {
    var set = NameSet.new()
    set.add(String.from("b"))
    set.add(String.from("a"))
    assert_eq(set.names.at(0).as_str(), "b", "first added comes first")
}

@test fun an_added_name_is_found(): void {
    var set = NameSet.new()
    set.add(String.from("Pair__int32"))
    assert_eq(set.has("Pair__int32"), true, "it was added")
}

@test fun a_name_never_added_is_not_found(): void {
    var set = NameSet.new()
    set.add(String.from("Pair__int32"))
    assert_eq(set.has("Pair"), false, "a prefix is a different name")
}

@test fun add_all_skips_names_already_held(): void {
    var set = NameSet.new()
    set.add(String.from("a"))
    var more = NameSet.new()
    more.add(String.from("a"))
    more.add(String.from("b"))
    set.add_all(&more)
    assert_eq(set.names.size(), 2, "a is not added again")
}
