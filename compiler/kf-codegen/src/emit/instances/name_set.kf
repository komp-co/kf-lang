// A set of names that keeps the order they were first added in.

import alloc.list.*
import alloc.hash_map.HashMap

pub struct NameSet {
    /// In first-added order, without repeats.
    pub var names: List<String>
    var index: HashMap<String, bool>
}

impl NameSet {
    pub static fun new(): NameSet {
        return NameSet { names: List.new<String>(), index: HashMap.new<String, bool>() }
    }

    pub fun has(name: str): bool {
        return self.index.contains(&String.from(name))
    }

    pub mutating fun add(name: String): void {
        if self.index.contains(&name) { return }
        self.index.insert(name.clone(), true)
        self.names.push(name)
    }

    pub mutating fun add_all(other: &NameSet): void {
        while name in &other.names {
            self.add(name.clone())
        }
    }
}
