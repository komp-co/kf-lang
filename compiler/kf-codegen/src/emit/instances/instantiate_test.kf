import core.assert.assert_eq

import kf_core.span.no_span
import kf_core.ast.*

import kf_codegen.emit.expr.struct_ty_name

@test fun codegen_type_mangle_returns_owned_str(): void {
    val name: String = type_mangle(int32_ty(no_span()))
    assert_eq(name.as_str(), "int32", "codegen type mangles are owned String values")
}

@test fun enum_name_of_type_returns_owned_str(): void {
    val ty = Type { kind: TypeKind.EnumTy(intern("Choice")), provenance: Provenance.Inferred(no_span()) }
    val name: String = enum_name_of_type(ty)
    assert_eq(name.as_str(), "Choice", "enum names are owned String values")
}

@test fun struct_ty_name_returns_owned_str(): void {
    val ty = Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Inferred(no_span()) }
    val name: String = struct_ty_name(ty)
    assert_eq(name.as_str(), "Point", "struct expression names are owned String values")
}

@test fun type_mangle_nests_a_pointer_through_its_pointee(): void {
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = int32_ty(no_span()) }
    val ty = Type { kind: TypeKind.PtrTo(inner), provenance: Provenance.Inferred(no_span()) }
    assert_eq(type_mangle(ty).as_str(), "Ptr__int32", "a pointer mangles around its pointee")
}
