import alloc.list.*

import kf_core.ast.*

import kf_codegen.emit.mangle_named

fun TopDecl.scan_decl_references(callees: &var List<String>, type_refs: &var List<String>): void {
    when (self.kind) {
        Function(params, ret, body, _pub, _u, _m, _s) => {
            while param in &params {
                scan_tyref_ptr(param.ty, type_refs)
            }
            scan_tyref_ptr(unsafe { ret as Ptr<TypeRef> }, type_refs)
            scan_stmt_list(body, callees, type_refs)
        }
        Struct(fields, _p) => {
            while field in &fields {
                scan_tyref_ptr(field.ty, type_refs)
            }
        }
        EnumDecl(variants, _p) => {
            while v in &variants {
                while j in 0..v.payloads.size() {
                    (v.payloads.at(j)).scan_tyref(type_refs)
                }
            }
        }
        ImplBlock(methods) => {
            while method in &methods {
                method.scan_decl_references(callees, type_refs)
            }
        }
        _ => {}
    }
}

fun scan_tyref_ptr(popt: Ptr<TypeRef>?, type_refs: &var List<String>): void {
    val p = popt ?: return
    (unsafe { &*p }).scan_tyref(type_refs)
}

fun TypeRef.scan_tyref(type_refs: &var List<String>): void {
    when (self.kind) {
        Named(n, args) => {
            if args.size() == 0 {
                support_add_unique(type_refs, n.as_string())
                return
            }
            support_add_unique(type_refs, mangle_named(n.as_string(), args))
            while arg in &args {
                (arg).scan_tyref(type_refs)
            }
        }
        Reference(_m, inner) => scan_tyref_ptr(unsafe { inner as Ptr<TypeRef> }, type_refs)
        _ => {}
    }
}

fun Type.scan_type(type_refs: &var List<String>): void {
    val mangled = type_mangle(unsafe { *self })
    support_add_unique(type_refs, String.from(mangled.as_str()))
    when (self.kind) {
        PtrTo(p) => scan_type(unsafe { &*p }, type_refs)
        BoxOf(p) => scan_type(unsafe { &*p }, type_refs)
        RefTo(_m, p) => scan_type(unsafe { &*p }, type_refs)
        _ => {}
    }
}

fun scan_stmt_list(stmts: &List<Stmt>, callees: &var List<String>, type_refs: &var List<String>): void {
    while stmt in &stmts {
        (stmt).scan_stmt(callees, type_refs)
    }
}

fun Stmt.scan_stmt(callees: &var List<String>, type_refs: &var List<String>): void {
    when (self.kind) {
        LetVal(_n, ann, init) => {
            scan_tyref_ptr(ann, type_refs)
            when (init) {
                Some(p) => scan_expr(unsafe { &*p }, callees, type_refs)
                None => { }
            }
        }
        LetVar(_n, ann, init) => {
            scan_tyref_ptr(ann, type_refs)
            // A null init has nothing to scan.
            when (init) {
                Some(p) => scan_expr(unsafe { &*p }, callees, type_refs)
                None => { }
            }
        }
        Assign(_n, e) => scan_expr(unsafe { &*e }, callees, type_refs)
        AssignTo(place, e) => {
            scan_expr(unsafe { &*place }, callees, type_refs)
            scan_expr(unsafe { &*e }, callees, type_refs)
        }
        Return(e) => {
            val ep = e ?: return
            scan_expr(unsafe { &*ep }, callees, type_refs)
        }
        If(c, then_body, else_body) => {
            scan_expr(unsafe { &*c }, callees, type_refs)
            scan_stmt_list(then_body, callees, type_refs)
            scan_stmt_list(else_body, callees, type_refs)
        }
        While(c, body) => {
            scan_expr(unsafe { &*c }, callees, type_refs)
            scan_stmt_list(body, callees, type_refs)
        }
        When(subj, arms) => {
            scan_expr(unsafe { &*subj }, callees, type_refs)
            while arm in &arms {
                when (arm.guard) {
                    Some(guard) => scan_expr(unsafe { &*guard }, callees, type_refs)
                    None => { }
                }
                scan_stmt_list(&arm.body, callees, type_refs)
            }
        }
        Switch(subj, sarms) => {
            scan_expr(unsafe { &*subj }, callees, type_refs)
            while arm in &sarms {
                when (arm.guard) {
                    Some(guard) => scan_expr(unsafe { &*guard }, callees, type_refs)
                    None => { }
                }
                scan_stmt_list(&arm.guard_prelude, callees, type_refs)
                scan_stmt_list(&arm.body, callees, type_refs)
            }
        }
        Expression(e) => scan_expr(unsafe { &*e }, callees, type_refs)
        _ => {}
    }
}

fun Expr.scan_expr(callees: &var List<String>, type_refs: &var List<String>): void {
    self.ty.scan_type(type_refs)
    val mc = self.mangled_callee
    if mc.as_str().byte_len() > 0 {
        support_add_unique(callees, mc.as_string())
    }
    while type_arg in &self.type_args {
        (type_arg).scan_tyref(type_refs)
    }
    when (self.kind) {
        Call(name, args) => {
            support_add_unique(callees, name.as_string())
            scan_expr_list(args, callees, type_refs)
        }
        StructLit(name, finits) => {
            if self.type_args.size() > 0 {
                var refs = List.new<TypeRef>()
                while type_arg in &self.type_args {
                    refs.push(type_arg)
                }
                support_add_unique(type_refs, mangle_named(name.as_string(), refs))
            } else {
                support_add_unique(type_refs, name.as_string())
            }
            while fi in &finits {
                val vp: Ptr<Expr> = fi.value
                scan_expr(unsafe { &*vp }, callees, type_refs)
            }
        }
        Binary(lp, _op, rp) => {
            scan_expr(unsafe { &*lp }, callees, type_refs)
            scan_expr(unsafe { &*rp }, callees, type_refs)
        }
        Unary(_op, ip) => scan_expr(unsafe { &*ip }, callees, type_refs)
        Deref(ip) => scan_expr(unsafe { &*ip }, callees, type_refs)
        MethodCall(recv, _m, args) => {
            scan_expr(unsafe { &*recv }, callees, type_refs)
            scan_expr_list(args, callees, type_refs)
        }
        FieldAccess(obj, _f) => scan_expr(unsafe { &*obj }, callees, type_refs)
        IfExpr(c, t, el) => {
            scan_expr(unsafe { &*c }, callees, type_refs)
            scan_expr(unsafe { &*t }, callees, type_refs)
            scan_expr(unsafe { &*el }, callees, type_refs)
        }
        Cast(ip, target) => {
            scan_expr(unsafe { &*ip }, callees, type_refs)
            scan_tyref_ptr(unsafe { target as Ptr<TypeRef> }, type_refs)
        }
        DynCoerce(ip, _vtable) => scan_expr(unsafe { &*ip }, callees, type_refs)
        Retain(ip) => scan_expr(unsafe { &*ip }, callees, type_refs)
        _ => {}
    }
}

fun scan_expr_list(args: &List<Expr>, callees: &var List<String>, type_refs: &var List<String>): void {
    while arg in &args {
        arg.scan_expr(callees, type_refs)
    }
}

// `Pair__gen_app__Score_get` references its owning instance type.
fun callee_prefix_matches(callees: &List<String>, type_name: str): bool {
    val n = type_name.byte_len()
    while callee in &callees {
        val cn = callee.as_str().byte_len()
        if cn > n + 1 {
            if callee.as_str().starts_with(type_name) {
                if callee.as_str().byte_at(n) == 95 {
                    return true
                }
            }
        }
    }
    return false
}

pub fun support_name_in(names: &List<String>, name: str): bool {
    while item in &names {
        if item.as_str() == name { return true }
    }
    return false
}

fun support_add_unique(names: &var List<String>, name: String): void {
    if support_name_in(names, name.as_str()) { return }
    names.push(name)
}
