// A layout the header defines must not be defined again in the source.

import alloc.list.*
import core.assert.assert_eq

import kf_core.span.Span
import kf_core.ast.*
import kf_core.ast.declaration.*
import testing.test
import kf_core.intern.CrateId

// `Point` is public, so the header owns it; `Secret` stays here.
fun src_view(): Module {
    var point_fields = List.new<Field>()
    point_fields.push(Field.new(Span.none(), String.from("x"), hdr_ty_ptr("int32"), false, true))
    var secret_fields = List.new<Field>()
    secret_fields.push(Field.new(Span.none(), String.from("v"), hdr_ty_ptr("int32"), false, true))
    var decls = List.new<TopDecl>()
    decls.push(TopDecl.new(Span.none(), String.from("Point"), TopDeclKind.Struct(point_fields, true)))
    decls.push(TopDecl.new(Span.none(), String.from("Secret"), TopDeclKind.Struct(secret_fields, false)))
    return Module { crate: CrateId.new("cc"), path: List.new<String>(), decls: decls, imports: List.new<Import>() }
}

fun emit_src(): String {
    val view = src_view()
    return view.emit_crate_source(String.from("cc"), false)
}

// Checked on the emitted text: C23 accepts a compatible redefinition silently.
@test
fun source_omits_a_layout_the_header_defines(): void {
    val c = emit_src()
    assert_eq(hdr_contains(c.as_str(), "typedef struct Point {"), false, "the header owns the public layout")
}

@test
fun source_keeps_its_implementation_only_layouts(): void {
    val c = emit_src()
    assert_eq(hdr_contains(c.as_str(), "typedef struct Secret {"), true, "a type the header omits is defined here")
}
