// What makes renaming a member or a local unsafe: a new name already in the
// way, a use the rename could not see, or one written once for two names.

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.declaration.TopDecl

/// The text `span` covers: the buffer for the queried file, the disk for
/// another.
pub fun TypedCrate.text_at(span: Span): String {
    if span.is_none() { return "" }
    val text = if span.file_id == self.file_id {
        self.source.clone()
    } else {
        File.read(path_for_file_id(self.smap, span.file_id).as_str()).unwrap_or("")
    }
    if (span.end as uint64) > text.byte_len() { return "" }
    return text.substring(span.start as uint64, span.end as uint64)
}

/// Why an edit would land on one name written for two, as `x` in
/// `Point { x }`, or "".
fun Module.name_written_twice(names: &List<NameSpan>, target: &NameSpan): String {
    while e in &self.rename_edits(names, target) {
        while n in &names {
            val same_place = n.span.file_id == e.file_id && n.span.start == e.start && n.span.end == e.end
            if same_place && !n.same_target(target) && n.role.as_str() != target.role.as_str() {
                return "a name here is written once for two, as `x` in `Point { x }`; write it out as `x: x` first"
            }
        }
    }
    return ""
}

/// Why a parameter or local cannot take `new_name`, or "": anything else of
/// that name in its function could be captured or shadowed.
fun TypedCrate.local_clash(names: &List<NameSpan>, target: &NameSpan, new_name: str): String {
    val home = self.module.target_declaration(names, target)
    val seen = self.module.names_in_function_of(target)
    while n in &seen {
        if n.span.file_id == home.file_id && self.text_at(n.span).as_str() == new_name {
            return "`${new_name}` is already a name in this function; renaming would change which one a use refers to"
        }
    }
    return ""
}

/// Every name in the function, method or lambda's enclosing function that
/// binds or uses `target`.
fun Module.names_in_function_of(target: &NameSpan): List<NameSpan> {
    var functions = List.new<TopDecl>()
    while td in &self.decls {
        when (td.kind) {
            Function(_p, _r, _b, _pub, _u, _mut, _st) => functions.push(td.clone())
            _ => {
                while member in &td.impl_members() { functions.push(member) }
            }
        }
    }
    while function in &functions {
        var locals = List.new<NameSpan>()
        function.local_decl(&var locals)
        if locals.any_same(target) {
            function.name_decl(&var locals)
            return locals
        }
    }
    return List.new<NameSpan>()
}

fun List<NameSpan>.any_same(target: &NameSpan): bool {
    while n in &self {
        if n.same_target(target) { return true }
    }
    return false
}

/// Why a method or field cannot be renamed, or cannot take `new_name`; "".
fun TypedCrate.member_refusal(names: &List<NameSpan>, target: &NameSpan, old: str, new_name: str): String {
    val home = self.module.target_declaration(names, target)
    if self.module.declared_in_trait(home) {
        return "`${old}` belongs to a trait; it would have to change in the trait and every impl at once"
    }
    if self.has_untyped_use(names, old) {
        val why = "a use of `${old}` has a receiver the checker could not type, so it would be left behind"
        return "${why}; fix the errors around it first"
    }
    if new_name.byte_len() == 0 { return "" }
    val key = target.member.as_str()
    val owner = key.substring(0, key.index_of(".") ?: 0)
    val taken = "${owner}.${new_name}"
    while n in &names {
        if n.is_decl && n.member.as_str() == taken.as_str() {
            val m = "`${owner}` already has a member named `${new_name}`"
            return "${m}; renaming would change which one a use refers to"
        }
    }
    while td in &self.module.decls {
        if td.is_extension() && td.ext_name.as_str() == new_name {
            return "an extension named `${new_name}` exists; a call of it could start reaching the renamed member"
        }
    }
    return ""
}

/// Declared inside a trait or a trait's impl.
fun Module.declared_in_trait(home: Span): bool {
    while td in &self.decls {
        val in_trait = when (td.kind) {
            TraitDecl(_m, _pub, _supers) => true
            TraitImpl(_trait_ref, _m) => true
            _ => false
        }
        if in_trait {
            while member in &td.impl_members() {
                if member.name_span.start == home.start && member.name_span.file_id == home.file_id { return true }
            }
        }
    }
    return false
}

/// A method call or field read named `old` in this crate whose receiver has no
/// type, and so no key.
fun TypedCrate.has_untyped_use(names: &List<NameSpan>, old: str): bool {
    var owned = List.new<uint32>()
    var foreign = List.new<uint32>()
    while n in &names {
        val member_role = n.role.as_str() == "method" || n.role.as_str() == "field"
        if !n.is_decl && member_role && n.member.as_str() == "" && self.owns_file(n.span, &var owned, &var foreign) {
            if self.text_at(n.span).as_str() == old { return true }
        }
    }
    return false
}

/// Whether `span`'s file is this crate's, remembering each answer.
fun TypedCrate.owns_file(span: Span, owned: &var List<uint32>, foreign: &var List<uint32>): bool {
    while id in &owned {
        if id == span.file_id { return true }
    }
    while id in &foreign {
        if id == span.file_id { return false }
    }
    val mine = owned_by_this_crate(span, self)
    if mine { owned.push(span.file_id) } else { foreign.push(span.file_id) }
    return mine
}
