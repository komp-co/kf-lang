// Type names written where a type goes: parameters, results, fields,
// `val` annotations, impl headers, bounds, casts. Each refers to the struct,
// enum or trait of that name, found as Resolve finds a name: the first
// top-level declaration that has it. A trait has no DeclId and is keyed
// `trait Name`, as a member is keyed `Owner.name`.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.expression.Expr
import kf_core.ast.declaration.DeclId
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import kf_core.ast.statement.Stmt
import kf_core.ast.types.TypeRef

struct TypeTarget {
    val name: Sym
    val decl: DeclId?
    val key: Sym
}

/// Every type name in a type position, and each trait's own name.
pub fun Module.type_name_spans(): List<NameSpan> {
    val types = self.type_targets()
    var found = List.new<NameSpan>()
    while decl in &self.decls {
        decl.type_names_decl(&types, &var found)
    }
    return found
}

/// The first struct, enum or trait of each name.
fun Module.type_targets(): List<TypeTarget> {
    var out = List.new<TypeTarget>()
    while td in &self.decls {
        val target = td.as_type_target() ?: {
            continue
        }
        if out.target_named(td.name.as_str()).is_none() { out.push(target) }
    }
    return out
}

fun TopDecl.as_type_target(): TypeTarget? {
    return when (self.kind) {
        Struct(_f, _p) => Option.Some(TypeTarget { name: self.name, decl: self.decl, key: intern("") })
        EnumDecl(_v, _p) => Option.Some(TypeTarget { name: self.name, decl: self.decl, key: intern("") })
        TraitDecl(_m, _p, _s) => {
            Option.Some(TypeTarget { name: self.name, decl: null, key: intern("trait ${self.name.as_str()}") })
        }
        _ => null
    }
}

fun List<TypeTarget>.target_named(name: str): TypeTarget? {
    while t in &self {
        if t.name.as_str() == name { return Option.Some(t) }
    }
    return null
}

/// A use of `name` written at `at`, when it names a type.
fun type_use(name: Sym, at: Span, types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    if at.is_none() { return }
    val target = types.target_named(name.as_str()) ?: return
    val span = Span { file_id: at.file_id, start: at.start, end: at.start + name.as_str().byte_len() as uint32 }
    found.push(NameSpan { span: span, decl: target.decl, role: intern("type"), is_decl: false, member: target.key })
}

fun TopDecl.type_names_decl(types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    while generic in &self.generics {
        while bound in &generic.bounds { bound.type_names(types, found) }
    }
    when (self.kind) {
        Function(params, ret, body, _pub, _u, _mut, _st) => {
            param_types(&params, types, found)
            ret.type_names(types, found)
            type_names_block(&body, types, found)
        }
        Extern(params, ret, _pub, _u) => {
            param_types(&params, types, found)
            ret.type_names(types, found)
        }
        Struct(fields, _pub) => {
            while field in &fields { field.ty.type_names(types, found) }
        }
        EnumDecl(variants, _pub) => {
            while variant in &variants {
                while payload in &variant.payloads { payload.type_names(types, found) }
            }
        }
        ImplBlock(methods) => {
            type_use(self.name, self.name_span, types, found)
            while method in &methods { method.type_names_decl(types, found) }
        }
        TraitImpl(trait_ref, methods) => {
            trait_ref.type_names(types, found)
            type_use(self.name, self.name_span, types, found)
            while method in &methods { method.type_names_decl(types, found) }
        }
        TraitDecl(methods, _pub, supers) => {
            if !self.name_span.is_none() {
                val key = intern("trait ${self.name.as_str()}")
                val role = intern("type")
                found.push(NameSpan { span: self.name_span, decl: null, role: role, is_decl: true, member: key })
            }
            while sup in &supers { sup.type_names(types, found) }
            while method in &methods { method.type_names_decl(types, found) }
        }
        _ => {}
    }
}

fun param_types(params: &List<Param>, types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    while param in &params { param.ty.type_names(types, found) }
}

fun TypeRef.type_names(types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    when (self.kind) {
        Named(head, args) => {
            type_use(head, self.span, types, found)
            while arg in &args { arg.type_names(types, found) }
        }
        DynTrait(head, args) => {
            // `dyn ` comes first.
            val at = Span { file_id: self.span.file_id, start: self.span.start + 4, end: self.span.end }
            type_use(head, at, types, found)
            while arg in &args { arg.type_names(types, found) }
        }
        Function(params, ret) => {
            while param in &params { param.type_names(types, found) }
            ret.type_names(types, found)
        }
        Reference(_mutable, inner) => inner.type_names(types, found)
        Array(element, _n) => element.type_names(types, found)
        Projection(base, _name) => base.type_names(types, found)
        _ => {}
    }
}

fun type_names_block(stmts: &List<Stmt>, types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    while stmt in &stmts { stmt.type_names_stmt(types, found) }
}

fun Stmt.type_names_stmt(types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    when (self.kind) {
        LetVal(_n, ann, init) => {
            type_names_opt(&ann, types, found)
            type_names_value(&init, types, found)
        }
        LetVar(_n, ann, init) => {
            type_names_opt(&ann, types, found)
            type_names_value(&init, types, found)
        }
        Assign(_n, value) => value.type_names_expr(types, found)
        AssignTo(place, value) => {
            place.type_names_expr(types, found)
            value.type_names_expr(types, found)
        }
        Return(value) => type_names_value(&value, types, found)
        If(cond, then_body, else_body) => {
            cond.type_names_expr(types, found)
            type_names_block(then_body, types, found)
            type_names_block(else_body, types, found)
        }
        While(cond, body) => {
            cond.type_names_expr(types, found)
            type_names_block(body, types, found)
        }
        ForEach(_n, subject, body) => {
            subject.type_names_expr(types, found)
            type_names_block(body, types, found)
        }
        When(subject, arms) => {
            subject.type_names_expr(types, found)
            while arm in &arms { type_names_block(&arm.body, types, found) }
        }
        Expression(e) => e.type_names_expr(types, found)
        _ => {}
    }
}

fun type_names_opt(ty: &Box<TypeRef>?, types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    when (ty) {
        Some(inner) => inner.type_names(types, found)
        None => { }
    }
}

fun type_names_value(e: &Box<Expr>?, types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    when (e) {
        Some(inner) => inner.type_names_expr(types, found)
        None => { }
    }
}

/// Only what holds a statement or a written type: a cast, a lambda's
/// parameters, a block; and whatever contains one.
fun Expr.type_names_expr(types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    when (self.kind) {
        Cast(inner, target) => {
            inner.type_names_expr(types, found)
            target.type_names(types, found)
        }
        Lambda(params, body) => {
            param_types(&params, types, found)
            type_names_block(&body, types, found)
        }
        Block(stmts) => type_names_block(&stmts, types, found)
        Binary(l, _op, r) => {
            l.type_names_expr(types, found)
            r.type_names_expr(types, found)
        }
        Unary(_op, inner) => inner.type_names_expr(types, found)
        Deref(inner) => inner.type_names_expr(types, found)
        Call(_name, args) => type_names_list(&args, types, found)
        MethodCall(recv, _m, args) => {
            recv.type_names_expr(types, found)
            type_names_list(&args, types, found)
        }
        CallValue(callee, args) => {
            callee.type_names_expr(types, found)
            type_names_list(&args, types, found)
        }
        FieldAccess(obj, _f) => obj.type_names_expr(types, found)
        IfExpr(cond, then_value, else_value) => {
            cond.type_names_expr(types, found)
            then_value.type_names_expr(types, found)
            else_value.type_names_expr(types, found)
        }
        WhenExpr(subject, arms) => {
            subject.type_names_expr(types, found)
            while arm in &arms { type_names_block(&arm.body, types, found) }
        }
        StructLit(_name, fields) => {
            while field in &fields { field.value.type_names_expr(types, found) }
        }
        _ => {}
    }
}

fun type_names_list(args: &List<Expr>, types: &List<TypeTarget>, found: &var List<NameSpan>): void {
    while arg in &args { arg.type_names_expr(types, found) }
}
