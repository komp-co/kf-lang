// `@name` where an annotation is used, referring to the `annotation name`
// that declares it, keyed `annotation name`. A built-in one, which nothing
// declares, refers to nothing.

import alloc.list.*

import kf_core.span.*
import kf_core.ast.*
import kf_core.ast.annotation.Annotation
import kf_core.ast.declaration.TopDecl
import kf_core.intern.*

/// Each declared annotation's own name, and each use of one.
pub fun Module.annotation_name_spans(): List<NameSpan> {
    var declared = List.new<String>()
    var found = List.new<NameSpan>()
    while td in &self.decls {
        when (td.kind) {
            AnnotationDecl(_params, _target, _pub) => {
                declared.push(td.name.as_string())
                if !td.name_span.is_none() {
                    found.push(NameSpan {
                        span: td.name_span, decl: null, role: intern("annotation"), is_decl: true,
                        member: annotation_key(td.name.as_str())
                    })
                }
            }
            _ => { }
        }
    }
    while td in &self.decls {
        td.annotation_uses(&declared, &var found)
    }
    return found
}

fun annotation_key(name: str): Sym {
    return intern("annotation ${name}")
}

/// On the declaration, its fields and variants, and its methods.
fun TopDecl.annotation_uses(declared: &List<String>, found: &var List<NameSpan>): void {
    annotation_list_uses(&self.annotations, declared, found)
    when (self.kind) {
        Struct(fields, _pub) => {
            while field in &fields { annotation_list_uses(&field.annotations, declared, found) }
        }
        EnumDecl(variants, _pub) => {
            while variant in &variants { annotation_list_uses(&variant.annotations, declared, found) }
        }
        _ => {
            while member in &self.impl_members() { member.annotation_uses(declared, found) }
        }
    }
}

fun annotation_list_uses(annotations: &List<Annotation>, declared: &List<String>, found: &var List<NameSpan>): void {
    while a in &annotations {
        val name = a.name.as_str()
        var known = false
        while d in &declared {
            if d.as_str() == name { known = true }
        }
        if known && !a.span.is_none() {
            val end = a.span.start + name.byte_len() as uint32
            val at = Span { file_id: a.span.file_id, start: a.span.start, end: end }
            val role = intern("annotation")
            found.push(NameSpan { span: at, decl: null, role: role, is_decl: false, member: annotation_key(name) })
        }
    }
}
