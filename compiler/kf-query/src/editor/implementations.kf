// Go to implementation: what implements the name at the cursor. A trait
// answers with each impl of it and each extension written on it; a struct or
// enum with its impl blocks, the trait impls for it and the extensions on it;
// a trait's method with each impl's version of it.

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.declaration.TopDecl
import kf_core.ast.types.TypeRef
import json.writer.*

/// `{"schema_version":1,"file":..,"offset":N,"implementations":[{..}]}`
///
/// Each span is the name an implementation is written under: the type in
/// `impl Loud for Point`, the method's name in an impl, an extension's name.
pub fun render_implementations_json(path: str, offset: uint32, crate: &TypedCrate): String {
    var out = JsonWriter.object()
    out.field_uint32("schema_version", 1)
    out.field_string("file", path)
    out.field_uint32("offset", offset)
    var arr = JsonWriter.array()
    val names = crate.module.every_name_span()
    when (names.target_at(crate.file_id, offset)) {
        Some(target) => {
            while at in &crate.module.implementations_of(&target) {
                arr.write_raw(at.span_object(crate.smap).as_str())
            }
        }
        None => { }
    }
    out.field_raw("implementations", arr.finish().as_str())
    return out.finish()
}

fun Module.implementations_of(target: &NameSpan): List<Span> {
    val key = target.member.as_str()
    if key.starts_with("trait ") {
        return self.implementations_of_trait(key.substring(6, key.byte_len()).as_str())
    }
    val decl = target.decl ?: {
        return self.implementations_of_method(key)
    }
    while td in &self.decls {
        if td.decl.is_some() && td.decl!!.raw == decl.raw && td.is_type() {
            return self.implementations_of_type(td.name.as_str())
        }
    }
    return List.new<Span>()
}

fun TopDecl.is_type(): bool {
    return when (self.kind) {
        Struct(_f, _p) => true
        EnumDecl(_v, _p) => true
        _ => false
    }
}

/// `impl Name`, `impl Trait for Name` and `fun Name.ext()`.
fun Module.implementations_of_type(name: str): List<Span> {
    var out = List.new<Span>()
    while td in &self.decls {
        val implements = when (td.kind) {
            ImplBlock(_m) => td.name.as_str() == name
            TraitImpl(_t, _m) => td.name.as_str() == name
            _ => td.is_extension() && td.extension_receiver().head_name().as_str() == name
        }
        if implements && !td.name_span.is_none() { out.push(td.name_span) }
    }
    return out
}

/// `impl Name for T` and an extension on `Name`.
fun Module.implementations_of_trait(name: str): List<Span> {
    var out = List.new<Span>()
    while td in &self.decls {
        val implements = when (td.kind) {
            TraitImpl(trait_ref, _m) => trait_ref.head_name().as_str() == name
            _ => td.is_extension() && td.extension_receiver().head_name().as_str() == name
        }
        if implements && !td.name_span.is_none() { out.push(td.name_span) }
    }
    return out
}

/// For `Trait.method`, each impl's version of it; nothing for a method of a
/// type, which is its own implementation.
fun Module.implementations_of_method(key: str): List<Span> {
    var out = List.new<Span>()
    val dot = key.index_of(".") ?: return out
    val owner = key.substring(0, dot)
    val method = key.substring(dot + 1, key.byte_len())
    while td in &self.decls {
        when (td.kind) {
            TraitImpl(trait_ref, methods) => {
                if trait_ref.head_name().as_str() == owner.as_str() {
                    while m in &methods {
                        if m.name.as_str() == method.as_str() && !m.name_span.is_none() { out.push(m.name_span) }
                    }
                }
            }
            _ => { }
        }
    }
    return out
}

/// `Loud` of `Loud<A>`; "" for anything not named.
fun TypeRef.head_name(): String {
    return when (self.kind) {
        Named(head, _args) => head.as_string()
        DynTrait(head, _args) => head.as_string()
        _ => String.from("")
    }
}
