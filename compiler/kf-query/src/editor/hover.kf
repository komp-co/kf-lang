// Hover answers twice: the type of the narrowest expression at the offset,
// and the declaration the name there refers to. Computed independently: a
// declaration's own name and a static receiver cover no expression.

import json.writer.*

/// `{"schema_version":2,"file":..,"offset":N,"type":..,"signature":..,
///   "documentation":..,"byte_start":..,"byte_end":..}`
///
/// `type` is null off an expression and for a poison type. `signature` and
/// `documentation` are null off a declaration; `documentation` also when it
/// has no `///` run.
pub fun render_hover_json(path: str, offset: uint32, crate: &TypedCrate): String {
    var out = JsonWriter.object()
    out.field_uint32("schema_version", 2)
    out.field_string("file", path)
    out.field_uint32("offset", offset)

    val hit = crate.module.innermost_expr_at(crate.file_id, offset)
    // A template's binder has the type core declares for it. What covers it
    // is an expansion's copy, typed for one marked declaration.
    val word = word_at(crate.source, offset)
    val bound = crate.template_binder_type(word, offset)
    if bound.byte_len() > 0 {
        out.field_string("type", bound)
    } else if hit.found && !hit.ty.is_poison() {
        out.field_string("type", hit.ty.written_type(crate.sigs).as_str())
    } else {
        out.field_null("type")
    }

    val decl = crate.hover_decl_at(offset)
    if decl.found && decl.label.as_str() != "" {
        out.field_string("signature", decl.label)
    } else {
        out.field_null("signature")
    }
    if decl.found && decl.doc.as_str() != "" {
        out.field_string("documentation", decl.doc)
    } else {
        out.field_null("documentation")
    }

    if bound.byte_len() > 0 {
        val start = word_start_at(crate.source, offset)
        out.field_uint32("byte_start", start)
        out.field_uint32("byte_end", start + word.byte_len() as uint32)
    } else if hit.found && !hit.ty.is_poison() {
        out.field_uint32("byte_start", hit.span.start)
        out.field_uint32("byte_end", hit.span.end)
    } else {
        out.field_uint32("byte_start", 0)
        out.field_uint32("byte_end", 0)
    }
    return out.finish()
}
