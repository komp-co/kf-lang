import core.assert.*
import alloc.list.*

import kf_core.span.Span
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.Coercion
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.intern.intern
import kf_lower.refcount.new_rc_ctx
import kf_lower.refcount.rc_insert_stmts
import kf_lower.refcount.push_frame
import testing.test

fun lower_dyn_ref(): Type {
    val dynamic = Type.new_dyn_trait(intern("Show"), List.new<Type>(), Span.none())
    val inner: Ptr<Type> = unsafe { alloc<Type>() }
    unsafe { *inner = dynamic }
    return Type { kind: TypeKind.RefTo(false, inner), provenance: Provenance.Declared(Span.none()) }
}

fun lowered_dyn_body(): List<Stmt> {
    var source = Expr.new(Span.none(), ExprKind.Variable(intern("point")))
    source.ty = Type { kind: TypeKind.Struct(intern("Point")), provenance: Provenance.Declared(Span.none()) }
    source.coerce = Coercion.AddrOf
    val source_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *source_ptr = source }
    var coercion = Expr.new(Span.none(), ExprKind.DynCoerce(source_ptr, intern("DynVTableInstance__Point__Show")))
    coercion.ty = lower_dyn_ref()
    val coercion_ptr: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *coercion_ptr = coercion }
    var body = List.new<Stmt>()
    body.push(Stmt.new(Span.none(), StmtKind.LetVal(intern("object"), null, coercion_ptr)))
    var ctx = new_rc_ctx(String.from("use_show"))
    val _frame = ctx.push_frame(false)
    rc_insert_stmts(&var body, &var ctx)
    return body
}

@test fun dyn_trait_lower_preserves_coercion(): void {
    val body = lowered_dyn_body()
    when (body.at(0).kind) {
        LetVal(_, _, init) => when (unsafe { (init!!).kind }) {
            DynCoerce(_, vtable) => assert_eq(vtable.as_str(), "DynVTableInstance__Point__Show", "lower preserves the dynamic coercion")
            _ => assert_eq(false, true, "expected dynamic coercion")
        }
        _ => assert_eq(false, true, "expected local binding")
    }
}

@test fun dyn_trait_lower_inserts_no_ownership_operations(): void {
    val body = lowered_dyn_body()
    when (body.at(0).kind) {
        LetVal(_, _, init) => when (unsafe { (init!!).kind }) {
            DynCoerce(inner, _) => assert_eq(body.size() == 1 && unsafe { inner.coerce } == Coercion.AddrOf, true, "fat borrows add no retain, release, drop, or clone")
            _ => assert_eq(false, true, "expected dynamic coercion")
        }
        _ => assert_eq(false, true, "expected local binding")
    }
}
