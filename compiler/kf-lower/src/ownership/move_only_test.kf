import core.assert.assert_eq

import kf_core.span.Span
import kf_core.ast.types.TypeRef
import kf_core.ast.types.TypeRefKind
import testing.test
import kf_core.intern.intern

fun storage_of(element: str): TypeRef {
    val inner = TypeRef.new(Span.none(), TypeRefKind.Named(intern(element), List.new<TypeRef>()))
    return TypeRef.new(Span.none(), TypeRefKind.Array(Box.new(inner), 2))
}

@test
fun array_storage_owns_what_its_elements_own(): void {
    var names = new_type_name_set()
    names.add(String.from("Owned"))
    assert_eq(storage_of("Owned").tref_infects(&names, intern("List")), true, "two `Owned`s move with the array")
}

@test
fun array_storage_of_scalars_owns_nothing(): void {
    assert_eq(storage_of("int32").tref_infects(&new_type_name_set(), intern("List")), false, "copied with the array")
}
