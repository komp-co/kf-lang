// A `when` over an owned local whose arm moves a payload out consumes the
// local: the arms own the payloads, and the local is moved from there on.

import kf_core.ast.expression.Expr
import kf_core.ast.pattern.*
import kf_lower.refcount.stmts_move_out

/// True when this subject is a local owned outright and some arm moves one
/// of its binders out. A binder an arm writes through is a reference into
/// the subject, passed on as itself, and never moves.
/// CONSTRAINT: decided by `stmts_move_out`, the test rc_insert consumes the
/// subject by, so the move check and the drops agree on who owns a payload.
fun Expr.local_moved_out_by(arms: &List<Arm>, ctx: &var MoveCtx): bool {
    val name = when (self.kind) {
        Variable(n) => n
        _ => return false
    }
    if name.as_str() == "self" { return false }
    if !ctx.contains_owned(name) || ctx.contains_borrowed(name) { return false }
    if !self.ty.mc_is_move_only(ctx.move_only_names) { return false }
    while arm in &arms {
        if !arm.pattern.is_flat_variant() { continue }
        when (arm.pattern.kind) {
            Variant(_name, payloads) => {
                while payload in &payloads {
                    when (payload.kind) {
                        Identifier(binder) => {
                            val lent = arm.ref_binders.contains(&binder)
                            if !lent && stmts_move_out(&arm.body, binder.as_str()) { return true }
                        }
                        _ => { }
                    }
                }
            }
            _ => { }
        }
    }
    return false
}

/// The consumed subject: a later use is a use after move.
fun Expr.mark_subject_moved(node: Ptr<Expr>, ctx: &var MoveCtx): void {
    when (self.kind) {
        Variable(n) => ctx.mark_moved(n, self.span, node)
        _ => { }
    }
}
