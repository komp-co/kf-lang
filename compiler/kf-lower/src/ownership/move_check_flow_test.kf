// Move dataflow across control flow: branches, `when` binders, loops, joins,
// argument positions. Helpers come from move_check_test.kf.

import core.assert.*
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*
import kf_core.diagnostic.*

fun mk_if_stmt(then_body: List<Stmt>, else_body: List<Stmt>): Stmt {
    val cond = new_expr(no_span(), ExprKind.LitBool(true))
    val cp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cp = cond }
    return new_stmt(no_span(), StmtKind.If(cp, then_body, else_body))
}

@test fun branch_both_move_no_diag(): void {
    // if (true) { val y = x } else { val z = x }  → 0 divergence diags
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))

    var then_body = List.new<Stmt>()
    then_body.push(mk_letval(String.from("y"), mk_str_var(String.from("x"))))
    var else_body = List.new<Stmt>()
    else_body.push(mk_letval(String.from("z"), mk_str_var(String.from("x"))))
    var s = mk_if_stmt(then_body, else_body)
    s.move_check_stmt(&var ctx)

    val result = unsafe { *dp }
    assert_eq(result.size() == 0, true, "both-branches-move is consistent")
}

@test fun branch_only_then_moves_emits_divergence(): void {
    // if (true) { val y = x } else { /* nothing */ }  → 1 divergence diag
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))

    var then_body = List.new<Stmt>()
    then_body.push(mk_letval(String.from("y"), mk_str_var(String.from("x"))))
    val else_body = List.new<Stmt>()
    var s = mk_if_stmt(then_body, else_body)
    s.move_check_stmt(&var ctx)

    val result = unsafe { *dp }
    assert_eq(result.size() == 1, true, "exactly one BranchMoveDivergence emitted")
}

@test fun when_arm_bind_owns_payload(): void {
    // when (opt) { Some(x) => { val y = x } None => {} }  → 0 diags
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)

    val inner = new_pattern(no_span(), PatternKind.Identifier(intern("x")))
    var payloads = List.new<Pattern>()
    payloads.push(inner)
    val some_pat = new_pattern(no_span(), PatternKind.Variant(intern("Some"), payloads))
    val pp: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *pp = some_pat }

    var arm_body = List.new<Stmt>()
    arm_body.push(mk_letval(String.from("y"), mk_str_var(String.from("x"))))
    val arm = new_arm(no_span(), pp, null, arm_body)

    val none_pat = new_pattern(no_span(), PatternKind.Variant(intern("None"), List.new<Pattern>()))
    val np: Ptr<Pattern> = unsafe { alloc<Pattern>() }
    unsafe { *np = none_pat }
    val none_arm = new_arm(no_span(), np, null, List.new<Stmt>())

    var arms = List.new<Arm>()
    arms.push(arm)
    arms.push(none_arm)

    val subj = new_expr(no_span(), ExprKind.Variable(intern("opt")))
    val sp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *sp = subj }
    var w = new_stmt(no_span(), StmtKind.When(sp, arms))
    w.move_check_stmt(&var ctx)

    val result = unsafe { *dp }
    assert_eq(result.size() == 0, true, "Some(x) arm moves bound x cleanly")
}

@test fun call_arg_is_borrow_no_move(): void {
    // val x: String = ...; foo(x); foo(x)  → 0 diags
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))

    var args1 = List.new<Expr>()
    args1.push(mk_str_var(String.from("x")))
    val c1 = new_expr(no_span(), ExprKind.Call(intern("foo"), args1))
    val c1p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *c1p = c1 }
    var s1 = new_stmt(no_span(), StmtKind.Expression(c1p))
    s1.move_check_stmt(&var ctx)

    var args2 = List.new<Expr>()
    args2.push(mk_str_var(String.from("x")))
    val c2 = new_expr(no_span(), ExprKind.Call(intern("foo"), args2))
    val c2p: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *c2p = c2 }
    var s2 = new_stmt(no_span(), StmtKind.Expression(c2p))
    s2.move_check_stmt(&var ctx)

    val result = unsafe { *dp }
    assert_eq(result.size() == 0, true, "double-borrow is clean")
}

fun mk_while_stmt(body: List<Stmt>): Stmt {
    val cond = new_expr(no_span(), ExprKind.LitBool(true))
    val cp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cp = cond }
    return new_stmt(no_span(), StmtKind.While(cp, body))
}

@test fun loop_no_move_no_diag(): void {
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    val body = List.new<Stmt>()
    var w = mk_while_stmt(body)
    w.move_check_stmt(&var ctx)
    val result = unsafe { *dp }
    assert_eq(result.size() == 0, true, "empty loop body is clean")
}

@test fun loop_body_moves_emits_loop_leak(): void {
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    var body = List.new<Stmt>()
    body.push(mk_letval(String.from("y"), mk_str_var(String.from("x"))))
    var w = mk_while_stmt(body)
    w.move_check_stmt(&var ctx)
    val result = unsafe { *dp }
    assert_eq(result.size() == 1, true, "loop body moving x emits one LoopMoveLeak")
}

@test fun branch_join_propagates_move(): void {
    // x moved on both branches stays moved after the `if`, so a later use
    // auto-clones.
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))

    var then_body = List.new<Stmt>()
    then_body.push(mk_letval(String.from("y"), mk_str_var(String.from("x"))))
    var else_body = List.new<Stmt>()
    else_body.push(mk_letval(String.from("z"), mk_str_var(String.from("x"))))
    var s = mk_if_stmt(then_body, else_body)
    s.move_check_stmt(&var ctx)

    val result = unsafe { *dp }
    assert_eq(result.size() == 0, true, "both-branch move joins without error")
    assert_eq(ctx.contains_moved(intern("x")), true, "x stays moved after the if (union propagates)")
}

fun mk_call_stmt_one_arg(callee: str, arg: Expr): Stmt {
    var args = List.new<Expr>()
    args.push(arg)
    var c = new_expr(no_span(), ExprKind.Call(intern(callee), args))
    c.mangled_callee = intern(callee)
    c.ty = void_ty(no_span())
    val cp: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *cp = c }
    return new_stmt(no_span(), StmtKind.Expression(cp))
}

// Registers `callee`'s single param as a by-value move-sink.
mutating fun MoveCtx.register_move_sink(callee: str): void {
    var sinks = List.new<bool>()
    sinks.push(false)
    var muts = List.new<bool>()
    muts.push(false)
    var lends = List.new<bool>()
    lends.push(false)
    unsafe {
        (*self.ptable).push(ParamEntry {
            name: String.from(callee), sinks: sinks, muts: muts, lends: lends, is_extern: false
        })
    }
}

@test fun byvalue_arg_is_a_consume(): void {
    // foo(x) then val y = x: the argument is auto-cloned, so both own a copy.
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.register_move_sink("foo")
    ctx.declare_owned(intern("x"))
    var s1 = mk_call_stmt_one_arg("foo", mk_str_var(String.from("x")))
    s1.move_check_stmt(&var ctx)
    assert_eq(ctx.contains_moved(intern("x")), true, "by-value arg marks x moved")
    var s2 = mk_letval(String.from("y"), mk_str_var(String.from("x")))
    s2.move_check_stmt(&var ctx)
    when (s1.kind) {
        Expression(cp) => {
            val call = unsafe { *cp }
            when (call.kind) {
                Call(_, args) => {
                    val a0 = *args.at(0)
                    assert_eq(a0.coerce == coerce_clone(), true, "prior arg consume auto-cloned")
                }
                _ => assert_eq(false, true, "expected Call")
            }
        }
        _ => assert_eq(false, true, "expected Expression")
    }
}

@test fun addr_of_arg_is_not_a_consume(): void {
    // foo(&x) → borrow, x stays owned.
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    var xv = mk_str_var(String.from("x"))
    xv.coerce = coerce_addr_of()
    var s1 = mk_call_stmt_one_arg("foo", xv)
    s1.move_check_stmt(&var ctx)
    assert_eq(ctx.contains_moved(intern("x")), false, "&-arg does not consume")
}

@test fun borrowed_local_return_auto_clones(): void {
    // A local bound from `get` does not own; returning it must copy.
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_borrowed(intern("x"))
    var s = mk_return(mk_str_var(String.from("x")))
    s.move_check_stmt(&var ctx)
    when (s.kind) {
        Return(ep) => {
            // Asserted first, so a missing operand cannot pass vacuously.
            assert_eq(ep.is_some(), true, "the return keeps its operand")
            val rp = ep ?: return
            val returned = unsafe { *rp }
            assert_eq(returned.coerce == coerce_clone(), true, "return of borrowed local auto-clones")
        }
        _ => assert_eq(false, true, "expected Return")
    }
}

fun first_init_copies(body: &List<Stmt>): bool {
    return when (body.at(0).kind) {
        LetVal(_n, _t, init) => (unsafe { (init!!).coerce }) == coerce_clone()
        _ => false
    }
}

fun branches_moving_x(): Stmt {
    var then_body = List.new<Stmt>()
    then_body.push(mk_letval(String.from("y"), mk_str_var(String.from("x"))))
    var else_body = List.new<Stmt>()
    else_body.push(mk_letval(String.from("z"), mk_str_var(String.from("x"))))
    return mk_if_stmt(then_body, else_body)
}

@test fun a_move_on_both_branches_copies_neither(): void {
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    var s = branches_moving_x()
    s.move_check_stmt(&var ctx)
    val copies = when (s.kind) {
        If(_c, t, e) => first_init_copies(&t) || first_init_copies(&e)
        _ => true
    }
    assert_eq(copies, false, "only one branch runs, so each moves `x`")
}

@test fun a_use_after_both_branches_copies_each(): void {
    val dp = fresh_diag_ptr()
    var ctx = fresh_ctx(dp)
    ctx.declare_owned(intern("x"))
    var s = branches_moving_x()
    s.move_check_stmt(&var ctx)
    var after = mk_letval(String.from("w"), mk_str_var(String.from("x")))
    after.move_check_stmt(&var ctx)
    val copies = when (s.kind) {
        If(_c, t, e) => first_init_copies(&t) && first_init_copies(&e)
        _ => false
    }
    assert_eq(copies, true, "`x` is read after the `if`, so both branch moves become copies")
}

