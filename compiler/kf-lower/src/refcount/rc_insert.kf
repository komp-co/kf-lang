// Scope-exit releases as inline `Release(name)` statements at the end of each
// scope, plus retain wrapping at alias stores.

import kf_core.ast.*
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.*
import kf_core.ast.declaration.Param
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TopDeclKind
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_lower.ownership.build_param_table
import kf_lower.ownership.compute_move_only_names
import kf_core.intern.*
import kf_core.lang.*
import kf_core.ast.types.*
pub mutating fun Module.rc_insert_module(list_name: Sym): void {
    var param_table = self.build_param_table()
    var payloads = self.variant_payloads_of()
    var ctx = new_rc_ctx(String.from(""))
    ctx.move_only_names = self.compute_move_only_names(list_name)
    ctx.string_name = self.lang_type_name(LangItem.String)
    ctx.borrow_free = self.borrow_free_names(ctx.string_name, list_name)
    ctx.use_tables(&var param_table, &var payloads)
    while i in 0..self.decls.size() {
        rc_insert_top_decl_pv(self.decls.at_mut(i), &var ctx)
    }
}

/// `ctx` holds the module's tables, shared by every function it walks;
/// each function starts with no frames and its own block numbering.
pub fun rc_insert_top_decl_pv(td: &var TopDecl, ctx: &var RcCtx): void {
    when (td.kind) {
        Function(params, ret, body, p, u, m, s) => {
            ctx.fn_name = td.name.as_string()
            ctx.frame_stack = List.new<RcFrame>()
            ctx.block_counter = 0
            val _idx = ctx.push_frame(false)
            track_value_params(&params, ctx)
            rc_insert_stmts(&var body, ctx)
            append_releases(&var body, ctx.pop_frame())
            // CONSTRAINT: a binder is a copy of the payload, so the grown body
            // is moved back into place.
            td.kind = TopDeclKind.Function(take<List<Param>>(params), take<Box<TypeRef>>(ret), take<List<Stmt>>(body),
                p, u, m, s)
        }
        ImplBlock(methods) => {
            while i in 0..methods.size() {
                rc_insert_top_decl_pv(methods.at_mut(i), ctx)
            }
        }
        Struct(_, _) => return
        EnumDecl(_, _) => return
        Extern(_, _, _, _) => return
        AssocType(_bounds) => return
        AssocTypeBinding(_chosen) => return
        AnnotationDecl(_params, _target, _pub) => return
        Template(_kind, _marked, _body) => return
        Constant(_ty, _value, _pub) => return
        TraitDecl(_, _, _) => return
        TraitImpl(_, _) => return
        Poison => return
    }
}

enum BorrowMode { Value, Borrow }

/// Names moved into the returned value, as opposed to borrowed to compute a
/// fresh one; only these escape the pre-return drop. Receivers, deref and
/// operator operands are borrows; bare variables, fields, arguments and
/// branches are value positions.
fun Expr.collect_moved_names(mode: BorrowMode, out: &var List<String>): void {
    when (self.kind) {
        Variable(name) => {
            // Lending, a byte view or a clone moves nothing into the result.
            if self.coerce == Coercion.AddrOf { return }
            if self.coerce == Coercion.ToCStr { return }
            if self.coerce == Coercion.Clone { return }
            when (mode) { Value => out.push(name.as_string()) Borrow => {} }
        }
        Release(name) => {
            when (mode) { Value => out.push(name.as_string()) Borrow => {} }
        }
        Call(_n, args) => collect_moved_names_list(args, BorrowMode.Value, out)
        Intrinsic(_i, args) => collect_moved_names_list(args, BorrowMode.Value, out)
        CallValue(callee, args) => {
            collect_moved_names(*callee, BorrowMode.Borrow, out)
            collect_moved_names_list(args, BorrowMode.Value, out)
        }
        StructLit(_n, finits) => {
            while fi in &finits {
                val vp: Ptr<Expr> = fi.value
                collect_moved_names(unsafe { *vp }, BorrowMode.Value, out)
            }
        }
        Binary(lp, _op, rp) => {
            collect_moved_names(unsafe { *lp }, BorrowMode.Borrow, out)
            collect_moved_names(unsafe { *rp }, BorrowMode.Borrow, out)
        }
        Unary(_op, ip) => collect_moved_names(unsafe { *ip }, BorrowMode.Borrow, out)
        Deref(ip) => collect_moved_names(unsafe { *ip }, BorrowMode.Borrow, out)
        MethodCall(recv_ptr, _m, args) => {
            collect_moved_names(unsafe { *recv_ptr }, BorrowMode.Borrow, out)
            collect_moved_names_list(args, BorrowMode.Value, out)
        }
        FieldAccess(obj_ptr, _f) => collect_moved_names(unsafe { *obj_ptr }, BorrowMode.Borrow, out)
        IfExpr(c, t, el) => {
            collect_moved_names(unsafe { *c }, BorrowMode.Borrow, out)
            collect_moved_names(unsafe { *t }, BorrowMode.Value, out)
            collect_moved_names(unsafe { *el }, BorrowMode.Value, out)
        }
        // Already a statement: the when-expression desugar ran first.
        WhenExpr(_, _) => { }
        Cast(ip, _t) => collect_moved_names(unsafe { *ip }, BorrowMode.Borrow, out)
        DynCoerce(ip, _vtable) => collect_moved_names(unsafe { *ip }, BorrowMode.Borrow, out)
        Retain(ip) => collect_moved_names(unsafe { *ip }, BorrowMode.Borrow, out)
        LitInt(_v) => return
        LitStr(_s) => return
        LitFloat(_) => return
        LitChar(_) => return
        FnRef(_) => return
        LitBool(_b) => return
        Lambda(_, _) => return
        Block(_) => return
        Poison => return
    }
}

fun collect_moved_names_list(args: &List<Expr>, mode: BorrowMode, out: &var List<String>): void {
    while item in &args {
        item.collect_moved_names(mode, out)
    }
}

/// Every variable name in `e`, excluded from an early exit's drops: dropping
/// what the return still reads is a use-after-free. Conservative: an
/// unmoved name leaks rather than crashes.
fun Expr.collect_var_names_in_expr(out: &var List<String>): void {
    when (self.kind) {
        Variable(name) => out.push(name.as_string())
        Release(name) => out.push(name.as_string())
        Call(_n, args) => collect_var_names_in_list(args, out)
        Intrinsic(_i, args) => collect_var_names_in_list(args, out)
        CallValue(callee, args) => {
            collect_var_names_in_expr(*callee, out)
            collect_var_names_in_list(args, out)
        }
        StructLit(_n, finits) => {
            while fi in &finits {
                val vp: Ptr<Expr> = fi.value
                collect_var_names_in_expr(unsafe { *vp }, out)
            }
        }
        Binary(lp, _op, rp) => {
            collect_var_names_in_expr(unsafe { *lp }, out)
            collect_var_names_in_expr(unsafe { *rp }, out)
        }
        Unary(_op, ip) => collect_var_names_in_expr(unsafe { *ip }, out)
        Deref(ip) => collect_var_names_in_expr(unsafe { *ip }, out)
        MethodCall(recv_ptr, _m, args) => {
            if !self.is_static_call && !self.is_variant_ctor { collect_var_names_in_expr(unsafe { *recv_ptr }, out) }
            collect_var_names_in_list(args, out)
        }
        FieldAccess(obj_ptr, _f) => collect_var_names_in_expr(unsafe { *obj_ptr }, out)
        IfExpr(c, t, el) => {
            collect_var_names_in_expr(unsafe { *c }, out)
            collect_var_names_in_expr(unsafe { *t }, out)
            collect_var_names_in_expr(unsafe { *el }, out)
        }
        // Already a statement: the when-expression desugar ran first.
        WhenExpr(_, _) => { }
        Cast(ip, _t) => collect_var_names_in_expr(unsafe { *ip }, out)
        DynCoerce(ip, _vtable) => collect_var_names_in_expr(unsafe { *ip }, out)
        Retain(ip) => collect_var_names_in_expr(unsafe { *ip }, out)
        LitInt(_v) => return
        LitStr(_s) => return
        LitFloat(_) => return
        LitChar(_) => return
        FnRef(_) => return
        LitBool(_b) => return
        Lambda(_, _) => return
        Block(_) => return
        Poison => return
    }
}

fun collect_var_names_in_list(args: &List<Expr>, out: &var List<String>): void {
    while item in &args {
        item.collect_var_names_in_expr(out)
    }
}

/// For a primitive return only escaping names are excluded; for a heap
/// return every named local the value may still read is.
fun returned_var_names(expr_ptr: Ptr<Expr>?, ctx: &var RcCtx): List<String> {
    var out = List.new<String>()
    val ep = expr_ptr ?: return out
    val re = unsafe { *ep }
    if is_heap_ty_rc(re.ty) {
        re.collect_escaping_names(ctx, &var out)
    } else {
        re.collect_moved_names(BorrowMode.Value, &var out)
    }
    return out
}

fun digit_str(d: uint64): String {
    if d == 1 { return String.from("1") }
    if d == 2 { return String.from("2") }
    if d == 3 { return String.from("3") }
    if d == 4 { return String.from("4") }
    if d == 5 { return String.from("5") }
    if d == 6 { return String.from("6") }
    if d == 7 { return String.from("7") }
    if d == 8 { return String.from("8") }
    if d == 9 { return String.from("9") }
    return String.from("0")
}

fun u64_to_str(n: uint64): String {
    if n < 10 { return digit_str(n) }
    return u64_to_str(n / 10) + digit_str(n % 10)
}

fun ty_is_struct_value(t: Type): bool {
    return when (t.kind) {
        Struct(_n) => true
        _ => false
    }
}

/// `return <expr>` that must drop locals after evaluating the value, which
/// may read through them: this becomes `val __retval_N = <expr>`, and the
/// answer is the `return __retval_N` to follow the drops.
mutating fun Stmt.bind_return_value(ctx: &var RcCtx): Stmt {
    val tmp_id = ctx.block_counter
    ctx.block_counter = tmp_id + 1
    val tmp_name = intern("__retval_${u64_to_str(tmp_id)}")
    var v = Expr.new(self.span, ExprKind.Variable(tmp_name))
    when (self.kind) {
        Return(value) => {
            val rp = value.view() ?: return Stmt.new(self.span, StmtKind.Return(null))
            v.ty = unsafe { &*rp }.ty.clone()
            self.kind = StmtKind.LetVal(tmp_name, null, take<Box<Expr>?>(value))
        }
        _ => { }
    }
    return Stmt.new(self.span, StmtKind.Return(Box.new(v)))
}
