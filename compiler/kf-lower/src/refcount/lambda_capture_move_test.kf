import core.assert.assert_eq
import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.*

@test fun stored_lambda_takes_ownership_of_heap_capture(): void {
    var ctx = new_rc_ctx(String.from("main"))
    val _frame = ctx.push_frame(false)
    ctx.add_heap_local(String.from("captured"))

    val value: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *value = new_expr(no_span(), ExprKind.Variable(intern("captured"))) }
    unsafe { value.ty = intern("String").lang_struct_ty(no_span()) }
    var fields = List.new<FieldInit>()
    fields.push(new_field_init(no_span(), String.from("captured"), value))
    val init: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init = new_expr(no_span(), ExprKind.StructLit(intern("Lambda_main_0"), fields)) }
    unsafe { init.ty = Type { kind: TypeKind.Struct(intern("Lambda_main_0")), provenance: Provenance.Inferred(no_span()) } }

    var stmt = new_stmt(no_span(), StmtKind.LetVal(intern("closure"), null, init))
    stmt.rc_insert_stmt(&var ctx)
    val releases = ctx.pop_frame()

    assert_eq(releases.size() == 1, true, "only the closure remains an owner")
}
