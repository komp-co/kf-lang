import core.assert.assert_eq

import kf_core.span.Span
import kf_core.ast.types.Provenance
import kf_core.ast.types.Type
import kf_core.ast.types.TypeKind
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.expression.FieldInit
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import testing.test
import kf_core.intern.intern

@test fun stored_lambda_takes_ownership_of_heap_capture(): void {
    var ctx = new_rc_ctx(String.from("main"))
    val _frame = ctx.push_frame(false)
    ctx.add_heap_local(String.from("captured"))

    val value: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *value = Expr.new(Span.none(), ExprKind.Variable(intern("captured"))) }
    unsafe { value.ty = intern("String").lang_struct_ty(Span.none()) }
    var fields = List.new<FieldInit>()
    fields.push(FieldInit.new(Span.none(), String.from("captured"), value))
    val init: Ptr<Expr> = unsafe { alloc<Expr>() }
    unsafe { *init = Expr.new(Span.none(), ExprKind.StructLit(intern("Lambda_main_0"), fields)) }
    unsafe { init.ty = Type { kind: TypeKind.Struct(intern("Lambda_main_0")), provenance: Provenance.Inferred(Span.none()) } }

    var stmt = Stmt.new(Span.none(), StmtKind.LetVal(intern("closure"), null, init))
    stmt.rc_insert_stmt(&var ctx)
    val releases = ctx.pop_frame()

    assert_eq(releases.size() == 1, true, "only the closure remains an owner")
}
