// A value some branches move and others keep: each branch is walked from the
// same owners, the ones that kept it drop it at their end, and after the
// branches nothing owns it. A branch that always leaves (returns, breaks,
// continues, or calls something that never returns) moves nothing for the
// code after it, which may still use what it moved.

import alloc.list.*

import kf_core.span.no_span
import kf_core.ast.intern
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_core.ast.statement.SwitchArm
import kf_lower.ownership.names_contains

/// An `if`'s two branches, each walked from the owners before it.
mutating fun RcCtx.rc_insert_branches(then_body: &var List<Stmt>, else_body: &var List<Stmt>): void {
    val owners = self.frame_stack.clone()
    val before = self.owned_heap_locals()
    rc_insert_scope(then_body, self)
    val then_moved = self.moved_past(then_body, &before)
    self.frame_stack = owners.clone()
    rc_insert_scope(else_body, self)
    val else_moved = self.moved_past(else_body, &before)
    self.frame_stack = owners
    var moved = then_moved.clone()
    add_moved(&var moved, &else_moved)
    release_kept(then_body, &then_moved, &moved)
    release_kept(else_body, &else_moved, &moved)
    self.forget_moved(&moved)
}

/// Every name an enclosing frame owns.
fun RcCtx.owned_heap_locals(): List<String> {
    var out = List.new<String>()
    while f in &self.frame_stack {
        while name in &f.heap_locals { out.push(name.clone()) }
    }
    return out
}

/// What `before` owned that the frames own no longer.
fun RcCtx.moved_since(before: &List<String>): List<String> {
    val now = self.owned_heap_locals()
    var out = List.new<String>()
    while name in &before {
        if !names_contains(&now, name.as_str()) { out.push(name.clone()) }
    }
    return out
}

/// Adds the names in `moved` that `into` lacks.
fun add_moved(into: &var List<String>, moved: &List<String>): void {
    while name in &moved {
        if !names_contains(into, name.as_str()) { into.push(name.clone()) }
    }
}

/// Drops, at the end of a branch, what another branch moved and this one kept.
fun release_kept(body: &var List<Stmt>, moved_here: &List<String>, moved_anywhere: &List<String>): void {
    var releases = List.new<Stmt>()
    while name in &moved_anywhere {
        if !names_contains(moved_here, name.as_str()) {
            releases.push(Stmt.new(no_span(), StmtKind.Release(intern(name.as_str()))))
        }
    }
    append_releases(body, releases)
}

/// Whether control never runs past the end of `body`.
fun List<Stmt>.always_leaves(): bool {
    if self.is_empty() { return false }
    val last = self.at(self.size() - 1)
    return when (last.kind) {
        Return(_r) => true
        Break => true
        Continue => true
        Expression(e) => when (e.ty.kind) {
            Never => true
            _ => false
        }
        If(_c, then_body, else_body) => then_body.always_leaves() && else_body.always_leaves()
        Switch(_s, arms) => !arms.is_empty() && arms.all_leave()
        _ => false
    }
}

fun List<SwitchArm>.all_leave(): bool {
    while arm in &self {
        if !arm.body.always_leaves() { return false }
    }
    return true
}

/// What a branch moved, as far as the code after it sees: nothing when it
/// always leaves.
fun RcCtx.moved_past(body: &List<Stmt>, before: &List<String>): List<String> {
    if body.always_leaves() { return List.new<String>() }
    return self.moved_since(before)
}

/// After every branch is walked: nothing owns what any branch moved.
mutating fun RcCtx.forget_moved(moved_anywhere: &List<String>): void {
    while name in &moved_anywhere { self.rc_mark_moved(name.clone()) }
}
