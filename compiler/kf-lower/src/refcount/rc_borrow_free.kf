// Which values cannot hold a borrow. A temporary below one is consumed
// within the statement, so it can be dropped at the statement's end.

import kf_core.ast.Module
import kf_core.ast.types.Type
import kf_core.ast.types.TypeRef
import kf_core.ast.types.type_identity_display
import kf_core.ast.declaration.TopDecl
import kf_lower.ownership.TypeNameSet
import kf_lower.ownership.new_type_name_set
import kf_core.intern.Sym
import kf_core.lang.LangItem
import kf_lower.ownership.names_contains

/// Every struct and enum whose fields, transitively, are scalars, the lang
/// string, a `Box` of such, or such types. The lang string owns its buffer,
/// and a lang list the elements behind its pointer.
pub fun Module.borrow_free_names(string_name: Sym, list_name: Sym): TypeNameSet {
    var free = new_type_name_set()
    while td in &self.decls {
        if td.is_struct_or_enum() { free.add(td.name.as_string()) }
    }
    // A name two declarations share stays only while both hold no borrow, and
    // each round drops at least one name, so the loop ends.
    var changed = true
    while changed {
        var dropped = new_type_name_set()
        changed = false
        while td in &self.decls {
            if td.is_struct_or_enum() && free.contains(td.name.as_str()) && !dropped.contains(td.name.as_str()) {
                if td.name != string_name && !td.fields_hold_no_borrow(&free, string_name, list_name) {
                    dropped.add(td.name.as_string())
                    changed = true
                }
            }
        }
        if changed { free = self.free_names_without(&free, &dropped) }
    }
    return free
}

fun Module.free_names_without(free: &TypeNameSet, dropped: &TypeNameSet): TypeNameSet {
    var kept = new_type_name_set()
    while td in &self.decls {
        val name = td.name.as_str()
        if td.is_struct_or_enum() && free.contains(name) && !dropped.contains(name) { kept.add(td.name.as_string()) }
    }
    return kept
}

fun TopDecl.is_struct_or_enum(): bool {
    return when (self.kind) {
        Struct(_fields, _p) => true
        EnumDecl(_variants, _p) => true
        _ => false
    }
}

fun TopDecl.fields_hold_no_borrow(free: &TypeNameSet, string_name: Sym, list_name: Sym): bool {
    val owns_pointees = self.lang_key_of().as_str().equals(LangItem.List.key())
    when (self.kind) {
        Struct(fields, _p) => {
            while f in &fields {
                if !f.ty.holds_no_borrow(free, string_name, list_name, owns_pointees) { return false }
            }
            return true
        }
        EnumDecl(variants, _p) => {
            while v in &variants {
                while payload in &v.payloads {
                    if !payload.holds_no_borrow(free, string_name, list_name, false) { return false }
                }
            }
            return true
        }
        _ => return false
    }
}

/// `owns_pointees`: a `Ptr` here owns what it points at, as a list's does.
fun TypeRef.holds_no_borrow(free: &TypeNameSet, string_name: Sym, list_name: Sym, owns_pointees: bool): bool {
    when (self.kind) {
        Named(n, args) => {
            if is_scalar_type_name(n.as_str()) || n == string_name { return true }
            val owns_args = n.as_str().equals("Box") || n == list_name || (owns_pointees && n.as_str().equals("Ptr"))
            if owns_args {
                while a in &args {
                    if !a.holds_no_borrow(free, string_name, list_name, false) { return false }
                }
                return true
            }
            return args.size() == 0 && free.contains(n.as_str())
        }
        _ => return false
    }
}

fun is_scalar_type_name(s: str): bool {
    return when s {
        "bool" => true
        "char" => true
        "void" => true
        "int8" => true
        "int16" => true
        "int32" => true
        "int64" => true
        "uint8" => true
        "uint16" => true
        "uint32" => true
        "uint64" => true
        "float32" => true
        "float64" => true
        _ => false
    }
}

/// A scalar, or a struct or enum in `borrow_free`.
fun Type.holds_no_borrow(ctx: &RcCtx): bool {
    return when (self.kind) {
        Int8 => true
        Int16 => true
        Int32 => true
        Int64 => true
        UInt8 => true
        UInt16 => true
        UInt32 => true
        UInt64 => true
        Float32 => true
        Float64 => true
        Bool => true
        Char => true
        Void => true
        Struct(n) => ctx.borrow_free.contains(type_identity_display(n).as_str())
        EnumTy(n) => ctx.borrow_free.contains(type_identity_display(n).as_str())
        _ => false
    }
}
