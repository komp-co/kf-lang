// Rewrites a block used as a value into ordinary statements:
//
//   val x = if c { val t = f()      ->   var __blkN: T
//                  t + 1 }               if c { val t = f()
//           else { 2 }                          __blkN = t + 1 }
//                                        else { __blkN = 2 }
//                                        val x = __blkN
//
//   return if c { ... a } else { b }  ->  if c { ...  return a } else { return b }
//
// C expressions cannot introduce a statement, so this cannot wait for codegen.
//
// CONSTRAINT: runs first in lower_module, before the when-expression desugar
// and alpha_rename, so the temporary is renamed and refcounted like any local.

import alloc.list.*

import kf_core.ast.*
import kf_core.ast.types.TypeRef
import kf_core.ast.expression.Expr
import kf_core.ast.expression.ExprKind
import kf_core.ast.declaration.TopDecl
import kf_core.ast.declaration.TopDeclKind
import kf_core.ast.statement.Stmt
import kf_core.ast.statement.StmtKind
import kf_typecheck.types.type_to_type_ref

/// Per-function counter, so two block values get distinct temporaries.
pub struct BlockTemps {
    pub var n: uint64
}

pub mutating fun Module.desugar_block_expr_module(): void {
    while i in 0..self.decls.size() {
        block_expr_top_decl(self.decls.at_mut(i))
    }
}

mutating fun TopDecl.block_expr_top_decl(): void {
    when (self.kind) {
        Function(_params, _ret, body, _p, _u, _mu, _st) => {
            if !stmts_carry_a_block(&body) { return }
            var temps = BlockTemps { n: 0 }
            val new_body = block_expr_stmt_list(&body, &var temps)
            replace_stmts(&var body, new_body)
        }
        ImplBlock(methods) => block_expr_methods(&var methods)
        Struct(_, _) => return
        EnumDecl(_, _) => return
        Extern(_, _, _, _) => return
        AssocType(_bounds) => return
        AssocTypeBinding(_chosen) => return
        AnnotationDecl(_params, _target, _pub) => return
        Template(_kind, _marked, _body) => return
        Constant(_ty, _value, _pub) => return
        TraitDecl(_, _, _) => return
        TraitImpl(_, _) => return
        Poison => return
    }
}

fun block_expr_methods(methods: &var List<TopDecl>): void {
    while i in 0..methods.size() {
        block_expr_top_decl(methods.at_mut(i))
    }
}

fun block_expr_stmt_list(stmts: &List<Stmt>, temps: &var BlockTemps): List<Stmt> {
    var out = List.new<Stmt>()
    while stmt in &stmts {
        block_expr_stmt(stmt, temps, &var out)
    }
    return out
}

/// Whether any `return` or binding, at any depth, has a block value to expand.
fun stmts_carry_a_block(stmts: &List<Stmt>): bool {
    while s in &stmts {
        if s.carries_a_block_value() { return true }
    }
    return false
}

fun Stmt.carries_a_block_value(): bool {
    return when (self.kind) {
        Return(value) => value_carries_a_block(&value)
        LetVal(_n, _ty, init) => value_carries_a_block(&init)
        LetVar(_n, _ty, init) => value_carries_a_block(&init)
        Assign(_n, value) => value.carries_a_block()
        AssignTo(_place, value) => value.carries_a_block()
        If(_c, then_body, else_body) => stmts_carry_a_block(&then_body) || stmts_carry_a_block(&else_body)
        While(_c, body) => stmts_carry_a_block(&body)
        ForEach(_b, _s, body) => stmts_carry_a_block(&body)
        When(_s, arms) => arms.any_arm_carries_a_block()
        _ => false
    }
}

fun value_carries_a_block(value: &Box<Expr>?): bool {
    return when (value) {
        Some(e) => e.carries_a_block()
        None => false
    }
}

fun List<Arm>.any_arm_carries_a_block(): bool {
    while a in &self {
        if stmts_carry_a_block(&a.body) { return true }
    }
    return false
}

/// Appends, because a block value expands into several statements.
fun block_expr_stmt(s: Stmt, temps: &var BlockTemps, out: &var List<Stmt>): void {
    when (s.kind) {
        Return(value) => {
            if !value_carries_a_block(&value) {
                out.push(s)
                return
            }
            val returned = value ?: return
            out.extend(returned.value_stmts(true, intern(""), temps))
        }
        // `var __blkN: T`, emitted by this pass, has nothing to look inside.
        LetVal(name, ty_ptr, init) => {
            if !value_carries_a_block(&init) {
                out.push(s)
                return
            }
            expand_block_let(s.span, name, ty_ptr.duplicate(), &init, true, temps, out)
        }
        LetVar(name, ty_ptr, init) => {
            if !value_carries_a_block(&init) {
                out.push(s)
                return
            }
            expand_block_let(s.span, name, ty_ptr.duplicate(), &init, false, temps, out)
        }
        If(cond_ptr, then_body, else_body) => {
            val nt = block_expr_stmt_list(&then_body, temps)
            val ne = block_expr_stmt_list(&else_body, temps)
            out.push(Stmt.new(s.span, StmtKind.If(cond_ptr, nt, ne)))
        }
        While(cond_ptr, body) => {
            out.push(Stmt.new(s.span, StmtKind.While(cond_ptr, block_expr_stmt_list(&body, temps))))
        }
        ForEach(binder, subj_ptr, body) => {
            out.push(Stmt.new(s.span, StmtKind.ForEach(binder, subj_ptr, block_expr_stmt_list(&body, temps))))
        }
        When(subj_ptr, arms) => {
            var new_arms = List.new<Arm>()
            while a in &arms {
                new_arms.push(a.rebuilt(a.pattern, a.guard.duplicate(), block_expr_stmt_list(&a.body, temps)))
            }
            out.push(Stmt.new(s.span, StmtKind.When(subj_ptr, new_arms)))
        }
        Assign(name, value_ptr) => {
            if !value_ptr.carries_a_block() {
                out.push(s)
                return
            }
            val value = value_ptr.expand_block_value(s.span, temps, out)
            out.push(Stmt.new(s.span, StmtKind.Assign(name, value)))
        }
        AssignTo(place, value_ptr) => {
            if !value_ptr.carries_a_block() {
                out.push(s)
                return
            }
            val value = value_ptr.expand_block_value(s.span, temps, out)
            out.push(Stmt.new(s.span, StmtKind.AssignTo(place, value)))
        }
        Expression(_) => out.push(s)
        Switch(_, _) => out.push(s)
        Drop(_) => out.push(s)
        Release(_) => out.push(s)
        Break => out.push(s)
        Continue => out.push(s)
        Poison => out.push(s)
    }
}

fun expand_block_let(span: Span, name: Sym, ty: Box<TypeRef>?, init: &Box<Expr>?, is_val: bool,
    temps: &var BlockTemps, out: &var List<Stmt>): void {
    when (init) {
        Some(e) => {
            val value = e.expand_block_value(span, temps, out)
            val kind = if is_val { StmtKind.LetVal(name, ty, value) } else { StmtKind.LetVar(name, ty, value) }
            out.push(Stmt.new(span, kind))
        }
        None => { }
    }
}

/// `var __blkN: T` and the statements that fill it from the value; the
/// temporary's name, as an expression, takes the value's place.
fun Expr.expand_block_value(span: Span, temps: &var BlockTemps, out: &var List<Stmt>): Box<Expr> {
    val temp = temps.fresh_block_temp()
    // Declared without a value; the annotation is required.
    val annotation = Box.new(type_to_type_ref(&self.ty, span))
    out.push(Stmt.new(span, StmtKind.LetVar(temp, annotation, null)))
    out.extend(self.value_stmts(false, temp, temps))
    var v = Expr.new(span, ExprKind.Variable(temp))
    v.ty = self.ty.clone()
    return Box.new(v)
}

/// A block anywhere the value can come from, through if-expression branches.
/// `if c { 1 } else { 2 }` does not count and stays a C ternary.
fun Expr.carries_a_block(): bool {
    when (self.kind) {
        Block(_) => return true
        IfExpr(_c, t, el) => return t.carries_a_block() || el.carries_a_block()
        // A `when` value belongs to the when-expression desugar, except an arm
        // whose tail is itself an `if` or `when`, which has no single value
        // pointer to read.
        WhenExpr(_s, arms) => return some_arm_tail_branches(&arms)
        _ => return false
    }
    return false
}

fun some_arm_tail_branches(arms: &List<Arm>): bool {
    while a in &arms {
        val n = a.body.size()
        if n > 0 {
            if stmt_value_expr(a.body.at(n - 1)).is_none() {
                if list_yields_value(&a.body) { return true }
            }
        }
    }
    return false
}

/// The statements the value becomes when it goes to a `return` or to
/// `temp`. A block contributes its statements then sinks its tail; an
/// if-expression becomes an `if` statement whose branches do the same.
fun Expr.value_stmts(to_return: bool, temp: Sym, temps: &var BlockTemps): List<Stmt> {
    var out = List.new<Stmt>()
    when (self.kind) {
        Block(stmts) => return sink_into_list(&stmts, to_return, temp, temps)
        IfExpr(c, t, e) => {
            val then_body = t.value_stmts(to_return, temp, temps)
            val else_body = e.value_stmts(to_return, temp, temps)
            out.push(Stmt.new(self.span, StmtKind.If(Box.new(c.clone()), then_body, else_body)))
        }
        WhenExpr(subject, arms) => {
            // Only the branching-tail arm reaches here; each arm sinks its tail.
            out.push(Stmt.new(self.span, StmtKind.When(Box.new(subject.clone()), arms.sunk(to_return, temp, temps))))
        }
        _ => out.push(self.sink_stmt(to_return, temp))
    }
    return out
}

/// Each arm with its tail sunk.
fun List<Arm>.sunk(to_return: bool, temp: Sym, temps: &var BlockTemps): List<Arm> {
    var out = List.new<Arm>()
    while a in &self {
        val body = sink_into_list(&a.body, to_return, temp, temps)
        out.push(a.rebuilt(Box.new(a.pattern.clone()), a.guard.duplicate(), body))
    }
    return out
}

/// Everything before the tail runs as written; the tail sinks.
fun sink_into_list(stmts: &List<Stmt>, to_return: bool, temp: Sym, temps: &var BlockTemps): List<Stmt> {
    var out = List.new<Stmt>()
    val n = stmts.size()
    if n == 0 { return out }
    while i in 0..n - 1 {
        block_expr_stmt(stmts.at(i).clone(), temps, &var out)
    }
    out.extend(stmts.at(n - 1).sink_tail_stmt(to_return, temp, temps))
    return out
}

/// An `if` or `when` sinks through every branch. Anything else yields
/// nothing; typecheck has already rejected a block whose paths do not all
/// yield.
fun Stmt.sink_tail_stmt(to_return: bool, temp: Sym, temps: &var BlockTemps): List<Stmt> {
    var out = List.new<Stmt>()
    when (self.kind) {
        Expression(value) => out.push(value.sink_stmt(to_return, temp))
        If(cond, then_body, else_body) => {
            if else_body.size() == 0 { return out }
            val nt = sink_into_list(&then_body, to_return, temp, temps)
            val ne = sink_into_list(&else_body, to_return, temp, temps)
            out.push(Stmt.new(self.span, StmtKind.If(Box.new(cond.clone()), nt, ne)))
        }
        When(subject, arms) => {
            val sunk = arms.sunk(to_return, temp, temps)
            out.push(Stmt.new(self.span, StmtKind.When(Box.new(subject.clone()), sunk)))
        }
        _ => {
            if self.is_jump() { out.push(self.clone()) }
        }
    }
    return out
}

/// The value as the statement that delivers it, holding its own copy.
fun Expr.sink_stmt(to_return: bool, temp: Sym): Stmt {
    val value = Box.new(self.clone())
    if self.ty.is_never() {
        return Stmt.new(self.span, StmtKind.Expression(value))
    }
    if to_return {
        return Stmt.new(self.span, StmtKind.Return(Option.Some(value)))
    }
    return Stmt.new(self.span, StmtKind.Assign(temp, value))
}

mutating fun BlockTemps.fresh_block_temp(): Sym {
    var name = String.from("__blk")
    val n: int64 = self.n as int64
    name.append(String.of(&(n)).as_str())
    self.n = self.n + 1
    return intern(name.as_str())
}
