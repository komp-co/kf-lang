// The lints that read the source as written: every declaration of the crate
// being checked, and every file it comes from.

import kf_core.span.*
import kf_core.ast.Module
import kf_core.ast.declaration.TopDecl
import kf_core.diagnostic.*

/// What the lints find in `m`'s own declarations and files, at each lint's
/// default severity; the caller applies the configured levels. Declarations
/// from other crates, loaded from their interfaces, are left alone.
pub fun lint_module(m: &Module, smap: &SourceMap, options: &LintOptions): List<Diagnostic> {
    var walk = new_lint_walk(options)
    var files = List.new<uint32>()
    while decl in &m.decls {
        if decl.crate.raw != m.crate.raw || decl.linkage.is_imported() || decl.linkage.is_template() { continue }
        decl.lint_decl(smap, &var walk)
        val file = decl.span.file_id
        if file != 0 && !files.contains_file(file) { files.push(file) }
    }
    while file in &files {
        val source = smap.files[(file - 1) as uint64]
        check_source_text(file, source.content, options, &var walk.found)
        check_unsafe_blocks(file, source.path, source.content, options, &var walk.found)
    }
    report_gone_rows(&files.baseline_keys(options), options, &var walk.found)
    return walk.found
}

/// What each ratchet lint counts in each of `m`'s own files, for a baseline
/// to record.
pub fun ratchet_counts(m: &Module, smap: &SourceMap, options: &LintOptions): List<RatchetCount> {
    var out: List<RatchetCount> = []
    val files = m.linted_files()
    while file in &files {
        val source = smap.files[(file - 1) as uint64]
        while count in &source_ratchet_counts(file, source.content, options) { out.push(count.clone()) }
        when (unsafe_block_count(file, source.path, source.content, options)) {
            Some(count) => out.push(count)
            None => { }
        }
    }
    return out
}

/// The files `m`'s own declarations are written in, in order of first use.
fun Module.linted_files(): List<uint32> {
    var files = List.new<uint32>()
    while decl in &self.decls {
        if decl.crate.raw != self.crate.raw || decl.linkage.is_imported() || decl.linkage.is_template() { continue }
        val file = decl.span.file_id
        if file != 0 && !files.contains_file(file) { files.push(file) }
    }
    return files
}

/// Each file's path as the baseline writes it.
fun List<uint32>.baseline_keys(options: &LintOptions): List<String> {
    var out: List<String> = []
    while file in &self { out.push(String.from(options.baseline.key_of(file))) }
    return out
}

/// What the lints that read types find in `m`'s own functions, once `m`
/// has been type-checked without errors.
pub fun lint_typed_module(m: &Module): List<Diagnostic> {
    var walk = TypedWalk { found: List.new<Diagnostic>(), copy_types: m.copy_types(), in_test: false }
    while decl in &m.decls {
        if decl.crate.raw != m.crate.raw || decl.linkage.is_imported() || decl.linkage.is_template() { continue }
        decl.lint_typed_decl(&var walk)
    }
    return walk.found
}

/// Every struct and enum, from any crate, that derives `Copy`.
fun Module.copy_types(): List<String> {
    var out = List.new<String>()
    while decl in &self.decls {
        val copies = (&decl).derives_copy()
        when (decl.kind) {
            Struct(_fields, _pub) => { if copies { out.push(decl.name.as_string()) } }
            EnumDecl(_variants, _pub) => { if copies { out.push(decl.name.as_string()) } }
            _ => {}
        }
    }
    return out
}

/// `@derive(..., Copy, ...)` is written on it.
fun TopDecl.derives_copy(): bool {
    while name in &self.annotation_words("derive") {
        if name.as_str() == "Copy" { return true }
    }
    return false
}

fun TopDecl.lint_typed_decl(walk: &var TypedWalk): void {
    when (self.kind) {
        Function(_params, _ret, body, _pub, _unsafe, _mutating, _static) => {
            walk.in_test = self.has_annotation("test")
            body.visit_typed(walk)
        }
        ImplBlock(methods) => {
            while method in &methods { method.lint_typed_decl(walk) }
        }
        TraitDecl(methods, _pub, _supers) => {
            while method in &methods { method.lint_typed_decl(walk) }
        }
        TraitImpl(_trait, methods) => {
            while method in &methods { method.lint_typed_decl(walk) }
        }
        _ => {}
    }
}

fun TopDecl.lint_decl(smap: &SourceMap, walk: &var LintWalk): void {
    val name = if self.ext_name.as_str().is_empty() { self.name.as_str() } else { self.ext_name.as_str() }
    val at = if self.name_span.is_none() { self.span } else { self.name_span }
    when (self.kind) {
        Function(params, _ret, body, is_pub, _unsafe, _mutating, _static) => {
            val is_constant = params.is_empty() && is_upper_snake_case(name)
            if !self.from_trait_impl { check_function_name(name, params.is_empty(), at, walk) }
            if is_pub && !self.from_trait_impl { self.check_docs(name, at, smap, walk) }
            check_parameter_count(name, at, &params, walk)
            check_function_length(name, at, self, smap, walk)
            walk.function(&params, &body, !self.from_trait_impl, is_constant || self.has_annotation("test"))
        }
        Struct(fields, is_pub) => {
            check_type_name(name, at, walk)
            check_field_count(name, at, &fields, walk)
            if is_pub { self.check_docs(name, at, smap, walk) }
        }
        EnumDecl(variants, is_pub) => {
            check_type_name(name, at, walk)
            if is_pub { self.check_docs(name, at, smap, walk) }
            while variant in &variants { check_variant_name(variant.name.as_str(), variant.span, walk) }
        }
        ImplBlock(methods) => lint_members(&methods, smap, walk)
        TraitDecl(methods, is_pub, _supers) => {
            check_type_name(name, at, walk)
            if is_pub { self.check_docs(name, at, smap, walk) }
            lint_members(&methods, smap, walk)
        }
        TraitImpl(_trait, methods) => lint_members(&methods, smap, walk)
        _ => {}
    }
}

fun TopDecl.check_docs(name: str, at: Span, smap: &SourceMap, walk: &var LintWalk): void {
    val file = self.span.file_id
    if file == 0 || file as uint64 > smap.files.size() { return }
    check_missing_docs(name, at, smap.files[(file - 1) as uint64].content, self.span.start as uint64, walk)
}

fun lint_members(methods: &List<TopDecl>, smap: &SourceMap, walk: &var LintWalk): void {
    while method in &methods { method.lint_decl(smap, walk) }
}

fun List<uint32>.contains_file(file: uint32): bool {
    while item in &self {
        if item == file { return true }
    }
    return false
}
