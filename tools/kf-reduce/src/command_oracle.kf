// The oracle `kf-reduce` runs: a command judging a candidate written to disk.

import alloc.list.*
import alloc.path.*
import std.fs.*
import std.process.*

/// Runs `program args... candidate`; exit 0 means interesting. Each
/// improvement is written to `best_path` as it is found, so an interrupted
/// run keeps what it reached.
pub struct CommandOracle {
    pub var program: String
    pub var args: List<String>
    /// Where each candidate is written, named like the input.
    pub var candidate_path: String
    pub var best_path: String
    pub var tries: uint64
    pub var kept: uint64
}

impl Oracle for CommandOracle {
    mutating fun interesting(lines: &List<String>): bool {
        self.tries = self.tries + 1
        val text = lines.join("\n")
        if write_text(self.candidate_path.as_str(), text.as_str()).is_err() {
            println("kf-reduce: cannot write ${self.candidate_path}")
            return false
        }
        var command = Command.new(self.program.as_str())
        while arg in &self.args { command.arg(arg.as_str()) }
        command.arg(self.candidate_path.as_str())
        command.stdout_to(Path.new("/dev/null"))
        if !command.status().success() { return false }
        self.kept = self.kept + 1
        val _saved = write_text(self.best_path.as_str(), text.as_str())
        println("kf-reduce: ${lines.size()} lines (try ${self.tries})")
        return true
    }
}
