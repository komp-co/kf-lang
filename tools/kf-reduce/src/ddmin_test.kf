import testing.test

/// Interesting while every needle is one of the lines; counts its calls.
struct NeedleOracle {
    var needles: List<String>
    var calls: uint64
}

impl Oracle for NeedleOracle {
    mutating fun interesting(lines: &List<String>): bool {
        self.calls = self.calls + 1
        while needle in &self.needles {
            var found = false
            while line in &lines {
                if line.as_str() == needle.as_str() { found = true }
            }
            if !found { return false }
        }
        return true
    }
}

fun numbered(n: uint64): List<String> {
    var lines = List.new<String>()
    while i in 0..n { lines.push("line ${i}") }
    return lines
}

fun needles(words: &List<String>): NeedleOracle {
    return NeedleOracle { needles: words.clone(), calls: 0 }
}

@test
fun without_chunk_drops_the_range(): void {
    val kept = without_chunk(&numbered(5), 1, 2)
    assert_eq(kept.join(","), "line 0,line 3,line 4", "lines 1 and 2 are gone")
}

@test
fun without_chunk_past_the_end_keeps_the_head(): void {
    val kept = without_chunk(&numbered(3), 2, 5)
    assert_eq(kept.join(","), "line 0,line 1", "only the tail is cut")
}

@test
fun one_needed_line_is_all_that_is_left(): void {
    var words = List.new<String>()
    words.push("line 13")
    var oracle = needles(&words)
    val reduced = reduce_lines(numbered(40), &var oracle)
    assert_eq(reduced.join(","), "line 13", "only line 13 survives")
}

@test
fun two_distant_lines_both_survive_in_order(): void {
    var words = List.new<String>()
    words.push("line 31")
    words.push("line 2")
    var oracle = needles(&words)
    val reduced = reduce_lines(numbered(40), &var oracle)
    assert_eq(reduced.join(","), "line 2,line 31", "both kept, in their order")
}

@test
fun nothing_needed_removes_everything(): void {
    var oracle = needles(&List.new<String>())
    val reduced = reduce_lines(numbered(9), &var oracle)
    assert_eq(reduced.size(), 0, "every line was removable")
}

@test
fun an_empty_input_is_returned_without_asking(): void {
    var oracle = needles(&List.new<String>())
    val _reduced = reduce_lines(List.new<String>(), &var oracle)
    assert_eq(oracle.calls, 0, "the oracle was never asked")
}

@test
fun a_single_needle_takes_logarithmically_many_calls(): void {
    var words = List.new<String>()
    words.push("line 700")
    var oracle = needles(&words)
    val _reduced = reduce_lines(numbered(1024), &var oracle)
    assert_eq(oracle.calls < 100, true, "far fewer calls than lines")
}
