// kf-reduce FILE [-o OUT] -- PREDICATE [ARGS...]
//
// Shrinks FILE by whole lines while `PREDICATE ARGS... CANDIDATE` exits 0,
// and writes the result to OUT, `FILE.reduced` by default. FILE is never
// changed. The candidate keeps FILE's name, in a directory of its own.

import alloc.list.*
import alloc.path.*
import std.fs.*

fun usage(): int32 {
    println("usage: kf-reduce FILE [-o OUT] -- PREDICATE [ARGS...]")
    return 2
}

fun main(): int32 {
    var input = String.from("")
    var output = String.from("")
    var predicate = List.new<String>()
    var i: uint64 = 0
    while i < arg_count() {
        val arg = arg_at(i)
        if arg == "--" {
            while rest in i + 1..arg_count() { predicate.push(String.from(arg_at(rest))) }
            break
        }
        if arg == "-o" && i + 1 < arg_count() {
            output = String.from(arg_at(i + 1))
            i = i + 1
        } else if input.is_empty() {
            input = String.from(arg)
        } else {
            return usage()
        }
        i = i + 1
    }
    if input.is_empty() || predicate.is_empty() { return usage() }
    if output.is_empty() { output = "${input}.reduced" }

    val read = read_to_string(input)
    if read.is_err() {
        println("kf-reduce: cannot read ${input}")
        return 2
    }
    val source = read.unwrap()
    val work = TempDir.new("kf-reduce")
    val program = predicate.remove(0) ?: return usage()
    var oracle = CommandOracle {
        program: program,
        args: predicate,
        candidate_path: String.from(work.path().join(Path.new(input.as_str()).file_name().as_str()).as_str()),
        best_path: output.clone(),
        tries: 0,
        kept: 0,
    }
    val lines = source.split("\n")
    val before = lines.size()
    if !oracle.interesting(&lines) {
        println("kf-reduce: the predicate rejects ${input} itself; nothing to reduce")
        return 1
    }
    val reduced = reduce_lines(lines, &var oracle)
    println("kf-reduce: ${before} -> ${reduced.size()} lines in ${oracle.tries} tries; wrote ${output}")
    return 0
}
