// Delta debugging over lines: the smallest subsequence an oracle still finds
// interesting, one line removable at a time.

/// Judges a candidate. `interesting` is called with the lines in order, never
/// with the empty list unless every line was removable.
pub trait Oracle {
    mutating fun interesting(lines: &List<String>): bool
}

/// `lines` without the `count` starting at `start`.
pub fun without_chunk(lines: &List<String>, start: uint64, count: uint64): List<String> {
    var kept = List.new<String>()
    while i in 0..lines.size() {
        if i < start || i >= start + count { kept.push(lines.at(i).clone()) }
    }
    return kept
}

/// Removes chunks of lines while the oracle holds, halving the chunk size each
/// time a whole pass removes nothing, down to one line. The result is
/// 1-minimal: removing any single line of it loses the property.
pub fun reduce_lines<O: Oracle>(lines: List<String>, oracle: &var O): List<String> {
    var best = lines
    var chunk = (best.size() + 1) / 2
    while chunk > 0 && best.size() > 0 {
        var removed = false
        var start: uint64 = 0
        while start < best.size() {
            val candidate = without_chunk(&best, start, chunk)
            if oracle.interesting(&candidate) {
                best = candidate
                removed = true
            } else {
                start = start + chunk
            }
        }
        if !removed {
            if chunk == 1 { break }
            chunk = (chunk + 1) / 2
        } else if chunk > best.size() {
            chunk = (best.size() + 1) / 2
        }
    }
    return best
}
