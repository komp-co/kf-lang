fun sample(): str {
    return "# filed\n\n216 panic: type vec index out of bounds\n  301   hang  \n"
}

@test
fun known_lines_skip_comments_and_blanks(): void {
    assert_eq(parse_known(sample()).size(), 2, "two entries")
}

@test
fun a_known_signature_names_its_issue(): void {
    val known = parse_known(sample())
    assert_eq(issue_for(&known, "panic: type vec index out of bounds"), "216", "the issue in front")
}

@test
fun surrounding_space_is_ignored(): void {
    val known = parse_known(sample())
    assert_eq(issue_for(&known, "hang"), "301", "trimmed on both sides")
}

@test
fun an_unknown_signature_is_new(): void {
    val known = parse_known(sample())
    assert_eq(issue_for(&known, "signal SIGSEGV"), "", "nothing filed")
}

@test
fun a_frameless_crash_matches_a_framed_entry(): void {
    val known = parse_known("402 signal SIGSEGV in type_has_user_drop\n")
    assert_eq(issue_for(&known, "signal SIGSEGV"), "402", "no gdb, still known")
}

@test
fun a_crash_in_another_frame_is_new(): void {
    val known = parse_known("402 signal SIGSEGV in type_has_user_drop\n")
    assert_eq(issue_for(&known, "signal SIGSEGV in import_name_not_found"), "", "a different place")
}

@test
fun a_placeless_hang_matches_a_placed_entry(): void {
    val known = parse_known("403 hang in Parser_parse_generic_ctor_call\n")
    assert_eq(issue_for(&known, "hang"), "403", "no gdb, still known")
}
