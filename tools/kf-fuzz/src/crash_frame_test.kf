import testing.test

fun crash_log(): String {
    val signal = "Program received signal SIGSEGV, Segmentation fault."
    val libc = "#0  0x00007ffff7cadd69 in __GI___libc_free (mem=0x55) at ./malloc/malloc.c:3359"
    val own = "#1  0x00005555555abab7 in type_has_user_drop ()\n#2  0x00005555555f07fe in ty_needs_drop ()"
    return "${signal}\n${libc}\n${own}\n#9  0x0000555555556990 in main ()\n"
}

fun overflow_log(): String {
    val top = "#0  0x01 in __GI___libc_free ()\n#1  0x02 in List__TypeRef_clone ()\n#2  0x03 in ty_needs_drop_deep ()"
    val cycle = "#3  0x04 in declared_type_owns_heap ()\n#4  0x05 in ty_needs_drop_deep ()\n#5  0x06 in declared_type_owns_heap ()"
    return "${top}\n${cycle}\n#87001 0x07 in main ()\n"
}

@test
fun a_crash_is_named_by_its_first_frame_outside_libc(): void {
    assert_eq(crash_place_in(crash_log().as_str()), "type_has_user_drop", "libc's free is skipped")
}

@test
fun an_overflow_is_named_by_its_cycle(): void {
    assert_eq(crash_place_in(overflow_log().as_str()), "recursion through declared_type_owns_heap", "first by name")
}

@test
fun a_frame_without_an_address_is_read(): void {
    assert_eq(crash_place_in("#0  import_name_not_found (x=1) at a.c:3\n"), "import_name_not_found", "frame 0")
}

@test
fun no_backtrace_names_nothing(): void {
    assert_eq(crash_place_in("No stack.\n"), "", "nothing to name")
}

@test
fun a_hang_is_named_by_the_innermost_shared_frame(): void {
    val first = "#0  0x1 in String_from ()\n#1  0x2 in Parser_parse_ctor ()\n#2  0x3 in main ()\n"
    val second = "#0  0x9 in Lexer_next ()\n#1  0x8 in Parser_parse_ctor ()\n#2  0x7 in main ()\n"
    assert_eq(hang_place_in("${first}---\n${second}".as_str()), "Parser_parse_ctor", "where both samples are")
}

@test
fun a_hang_without_two_samples_is_unnamed(): void {
    assert_eq(hang_place_in("#0  0x1 in f ()\n"), "", "one sample says nothing")
}

@test
fun a_hang_skips_a_helper_every_sample_is_in(): void {
    val sample = "#0  0x1 in String_from__From__str ()\n#1  0x2 in Parser_parse_ctor ()\n#2  0x3 in main ()\n"
    assert_eq(hang_place_in("${sample}---\n${sample}---\n${sample}".as_str()), "Parser_parse_ctor", "past the helper")
}

@test
fun a_frame_drops_its_crate_prefix(): void {
    assert_eq(crash_place_in("#0  0x1 in kf_codegen.emit_free ()\n"), "emit_free", "as the bootstrap build names it")
}
