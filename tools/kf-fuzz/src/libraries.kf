// The libraries a fixture builds against, compiled once per run so each
// mutant costs one crate's compile.

pub fun library_names(): List<String> {
    var names = List.new<String>()
    names.push(String.from("core"))
    names.push(String.from("alloc"))
    names.push(String.from("std"))
    return names
}

/// Compiles core, alloc and std from `libs` into `out`; false, having said
/// why, when one does not compile cleanly.
pub fun Limits.build_libraries(libs: str, out: str): bool {
    var built = List.new<String>()
    while name in &library_names() {
        val run = CrateRun {
            name: name.clone(), root: "${libs}/${name}", out: String.from(out), deps: built.clone(), is_bin: false,
            log: "${out}/${name}.log"
        }
        val verdict = self.run_now(&run)
        if !verdict.fine || !File.exists("${out}/${name}.kfi".as_str()) {
            println("kf-fuzz: ${name} does not compile; see ${run.log}")
            return false
        }
        built.push(name.clone())
    }
    return true
}

/// The interface texts in `library_names` order.
pub fun read_interfaces(out: str): List<String> {
    var texts = List.new<String>()
    while name in &library_names() {
        val read = File.read("${out}/${name}.kfi".as_str())
        texts.push(if read.is_ok() { read.unwrap() } else { String.from("") })
    }
    return texts
}

/// Writes every interface into `out`, with the one named `replaced` given
/// `text` instead.
pub fun write_interfaces(out: str, originals: &List<String>, replaced: str, text: str): bool {
    val names = library_names()
    while i in 0..names.size() {
        val body = if names.at(i).as_str() == replaced { text } else { originals.at(i).as_str() }
        if File.write("${out}/${names.at(i)}.kfi".as_str(), body).is_err() { return false }
    }
    return true
}
