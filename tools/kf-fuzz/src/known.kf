// The findings already filed: `known.txt`, one per line, the issue number and
// then the signature exactly as a run prints it. A finding matched here is
// counted, not failed; deleting the line when the issue closes makes a
// recurrence fail again.
//
//     # comment
//     216 panic: type vec index out of bounds

import alloc.list.*

pub struct KnownFinding {
    pub val issue: String
    pub val signature: String
}

pub fun parse_known(text: str): List<KnownFinding> {
    var known = List.new<KnownFinding>()
    while raw in &text.split("\n") {
        val line = raw.trim()
        if line.is_empty() || line.starts_with("#") { continue }
        val space = line.index_of(" ") ?: continue
        known.push(KnownFinding {
            issue: line.substring(0, space),
            signature: line.slice_from(space + 1).trim()
        })
    }
    return known
}

/// The issue filed for `signature`, or "" for a new finding. A crash or hang
/// named without its place, where there is no gdb, matches an entry for it
/// with one, so it is never new for want of a debugger.
pub fun issue_for(known: &List<KnownFinding>, signature: str): String {
    val framed = "${signature} in "
    while entry in &known {
        if entry.signature.as_str() == signature { return entry.issue.clone() }
    }
    val placeable = signature.starts_with("signal ") || signature == "hang"
    if placeable && !signature.contains(" in ") {
        while entry in &known {
            if entry.signature.starts_with(framed) { return entry.issue.clone() }
        }
    }
    return String.from("")
}
