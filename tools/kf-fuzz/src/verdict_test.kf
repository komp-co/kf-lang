import alloc.text_edit.repeat

@test
fun a_clean_compile_is_fine(): void {
    assert_eq(judge(0, "").fine, true, "exit 0")
}

@test
fun a_diagnosed_program_is_fine(): void {
    val output = "src/main.kf:1:5: error: oops\n    x\nkflatc: errors found; case not written\n"
    assert_eq(judge(1, output).fine, true, "errors, then the closing line")
}

@test
fun exit_one_with_another_last_line_is_a_panic(): void {
    val output = "src/main.kf:1:5: error: oops\nOption.unwrap called on a None\n"
    assert_eq(judge(1, output).signature, "panic: Option.unwrap called on a None", "the last line names it")
}

@test
fun exit_one_with_nothing_said_is_a_silent_panic(): void {
    assert_eq(judge(1, "\n").signature, "panic without a message", "no last line")
}

@test
fun a_timeout_is_a_hang(): void {
    assert_eq(judge(124, "anything").signature, "hang", "timeout's own exit")
}

@test
fun a_segfault_is_named(): void {
    assert_eq(judge(139, "").signature, "signal SIGSEGV", "128 + 11")
}

@test
fun an_unexpected_exit_keeps_its_code(): void {
    assert_eq(judge(2, "usage: kflatc").signature, "exit 2: usage: kflatc", "a usage error is a finding")
}

@test
fun normalize_folds_numbers(): void {
    assert_eq(normalize("index 12 of 3"), "index N of N", "each run is one N")
}

@test
fun normalize_folds_paths(): void {
    assert_eq(normalize("cannot read /tmp/x/core.kfi now"), "cannot read PATH now", "the path goes")
}

@test
fun normalize_caps_the_length(): void {
    assert_eq(normalize("a".repeat(300).as_str()).byte_len(), 100, "100 bytes at most")
}

@test
fun last_line_skips_trailing_blanks(): void {
    assert_eq(last_line("one\ntwo  \n\n  \n"), "two", "trimmed, blanks skipped")
}
