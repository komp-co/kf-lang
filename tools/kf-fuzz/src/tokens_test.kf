import alloc.list.*
import testing.test

fun kinds_of(text: str): String {
    var out = String.from("")
    while piece in &cut_pieces(text) {
        val letter = when (piece.kind) {
            Word => "w"
            Quoted => "q"
            Space => "s"
            Comment => "c"
            Mark => "m"
        }
        out.append(letter)
    }
    return out
}

@test
fun pieces_join_back_to_the_text(): void {
    val text = "fun main(): int32 { val s = \"a \\\" b\" // done\n return 0 }"
    assert_eq(join_pieces(&cut_pieces(text)), String.from(text), "nothing is lost or added")
}

@test
fun a_declaration_cuts_into_words_marks_and_spaces(): void {
    assert_eq(kinds_of("val x = 1;"), "wswsmswm", "val, x, =, 1, ;")
}

@test
fun an_escaped_quote_stays_inside_its_string(): void {
    assert_eq(kinds_of("\"a\\\"b\" x"), "qsw", "one quoted piece, then x")
}

@test
fun an_unclosed_string_ends_at_its_line(): void {
    assert_eq(kinds_of("\"abc\nx"), "qsw", "the newline is not swallowed")
}

@test
fun a_comment_runs_to_the_end_of_its_line(): void {
    assert_eq(kinds_of("a // b c\nd"), "wscsw", "the comment is one piece")
}

@test
fun a_lone_slash_is_a_mark(): void {
    assert_eq(kinds_of("a/b"), "wmw", "division is not a comment")
}

@test
fun bytes_past_ascii_join_a_word(): void {
    assert_eq(kinds_of("café x"), "wsw", "the accented letter stays in its word")
}
