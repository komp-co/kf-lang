// Cutting source text into pieces a mutation moves as a whole. Not KFlat's
// lexer: a mutated program must still be cut, so nothing here can fail, and
// concatenating the pieces gives the text back byte for byte.

pub enum PieceKind {
    /// Letters, digits and `_`: a name, a keyword or a number.
    Word
    /// `"..."` or `'.'`, to its closing quote or the end of the line.
    Quoted
    /// Spaces, tabs and newlines.
    Space
    /// `// ...` to the end of the line.
    Comment
    /// Any other single byte.
    Mark
}

pub struct Piece {
    pub val kind: PieceKind
    pub val text: String
}

fun is_word_byte(b: uint8): bool {
    return (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128
}

fun is_space_byte(b: uint8): bool {
    return b == 32 || b == 9 || b == 10 || b == 13
}

/// The end of the quoted run opening at `start`: past its closing quote, or
/// at the end of the line when it is never closed.
fun quoted_end(text: str, start: uint64): uint64 {
    val quote = text.byte_at(start)
    var i = start + 1
    while i < text.byte_len() {
        val b = text.byte_at(i)
        if b == 92 && i + 1 < text.byte_len() {
            i = i + 2
            continue
        }
        if b == quote { return i + 1 }
        if b == 10 { return i }
        i = i + 1
    }
    return text.byte_len()
}

pub fun cut_pieces(text: str): List<Piece> {
    var pieces = List.new<Piece>()
    val n = text.byte_len()
    var i: uint64 = 0
    while i < n {
        val b = text.byte_at(i)
        var end = i + 1
        var kind = PieceKind.Mark
        if is_word_byte(b) {
            while end < n && is_word_byte(text.byte_at(end)) { end = end + 1 }
            kind = PieceKind.Word
        } else if is_space_byte(b) {
            while end < n && is_space_byte(text.byte_at(end)) { end = end + 1 }
            kind = PieceKind.Space
        } else if b == 34 || b == 39 {
            end = quoted_end(text, i)
            kind = PieceKind.Quoted
        } else if b == 47 && i + 1 < n && text.byte_at(i + 1) == 47 {
            while end < n && text.byte_at(end) != 10 { end = end + 1 }
            kind = PieceKind.Comment
        }
        pieces.push(Piece { kind: kind, text: text.substring(i, end) })
        i = end
    }
    return pieces
}

pub fun join_pieces(pieces: &List<Piece>): String {
    var out = String.from("")
    while piece in &pieces { out.append(piece.text) }
    return out
}

/// Whether the piece is worth mutating: not whitespace.
pub fun Piece.is_solid(): bool {
    return when (self.kind) {
        Space => false
        _ => true
    }
}
