// The command line, read into one struct. Paths default to where they sit in
// the repository, so a run from its root needs no flags.

pub struct Options {
    pub var command: String
    pub var first_seed: uint64
    pub var last_seed: uint64
    pub var jobs: uint64
    pub var timeout_seconds: uint64
    pub var memory_mb: uint64
    pub var budget_seconds: int64
    pub var kflatc: String
    pub var libs: String
    pub var cases: String
    pub var known: String
    pub var save_dir: String
    pub var emit_dir: String
    pub var expect: String
    /// `NAME=FILE`: judge against FILE as library NAME's interface.
    pub var interface: String
    pub var file: String
    /// Empty when the line was understood.
    pub var problem: String
}

pub fun default_options(): Options {
    return Options {
        command: "", first_seed: 1, last_seed: 500, jobs: 4, timeout_seconds: 10, memory_mb: 2048,
        budget_seconds: 0, kflatc: "bin/kflatc", libs: "libs", cases: "tests/cases",
        known: "tools/kf-fuzz/known.txt", save_dir: "", emit_dir: "", expect: "", interface: "", file: "",
        problem: ""
    }
}

/// Digits only; `null` for anything else, or nothing.
pub fun parse_count(text: str): uint64? {
    if text.is_empty() { return null }
    var n: uint64 = 0
    while i in 0..text.byte_len() {
        val b = text.byte_at(i)
        if b < 48 || b > 57 { return null }
        n = n * 10 + (b - 48) as uint64
    }
    return n
}

pub struct SeedRange {
    pub val first: uint64
    pub val last: uint64
}

/// `A..B`, or one seed `A`; `null` for anything else, or `B` below `A`.
pub fun parse_seeds(text: str): SeedRange? {
    val dots = text.index_of("..")
    if dots == null {
        val one = parse_count(text) ?: return null
        return SeedRange { first: one, last: one }
    }
    val at = dots!!
    val first = parse_count(text.substring(0, at).as_str()) ?: return null
    val last = parse_count(text.slice_from(at + 2).as_str()) ?: return null
    if last < first { return null }
    return SeedRange { first: first, last: last }
}

mutating fun Options.fail(problem: str): void {
    if self.problem.is_empty() { self.problem = String.from(problem) }
}

pub fun parse_options(args: &List<String>): Options {
    var options = default_options()
    if args.size() == 0 {
        options.fail("no command")
        return options
    }
    options.command = args.at(0).clone()
    var i: uint64 = 1
    while i < args.size() {
        val flag = args.at(i).as_str()
        if !flag.starts_with("--") {
            options.file = String.from(flag)
            i = i + 1
            continue
        }
        if i + 1 >= args.size() {
            options.fail("${flag} needs a value".as_str())
            break
        }
        val value = args.at(i + 1).as_str()
        when flag {
            "--seeds" => {
                val range = parse_seeds(value)
                if range == null {
                    options.fail("--seeds wants A..B or A, with A <= B")
                } else {
                    options.first_seed = range!!.first
                    options.last_seed = range!!.last
                }
            }
            "--jobs" => options.jobs = parse_count(value) ?: 0
            "--timeout" => options.timeout_seconds = parse_count(value) ?: 0
            "--memory" => options.memory_mb = parse_count(value) ?: 0
            "--budget" => options.budget_seconds = (parse_count(value) ?: 0) as int64
            "--kflatc" => options.kflatc = String.from(value)
            "--libs" => options.libs = String.from(value)
            "--cases" => options.cases = String.from(value)
            "--known" => options.known = String.from(value)
            "--save" => options.save_dir = String.from(value)
            "--emit" => options.emit_dir = String.from(value)
            "--expect" => options.expect = String.from(value)
            "--interface" => options.interface = String.from(value)
            _ => options.fail("unknown flag ${flag}".as_str())
        }
        i = i + 2
    }
    if options.jobs == 0 { options.fail("--jobs wants a count above 0") }
    if options.timeout_seconds == 0 { options.fail("--timeout wants seconds above 0") }
    return options
}
