// SplitMix64: one seed gives one sequence on every platform, so a seed in a
// report reproduces the program it found.

pub struct Rng {
    var state: uint64
}

impl Rng {
    pub static fun seeded(seed: uint64): Rng {
        return Rng { state: seed }
    }

    pub mutating fun next(): uint64 {
        self.state = self.state + 0x9E3779B97F4A7C15
        var z = self.state
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
        z = (z ^ (z >> 27)) * 0x94D049BB133111EB
        return z ^ (z >> 31)
    }

    /// In `0..n`; 0 when `n` is 0.
    pub mutating fun below(n: uint64): uint64 {
        if n == 0 { return 0 }
        return self.next() % n
    }

    /// True once in `n` draws, on average.
    pub mutating fun one_in(n: uint64): bool {
        return self.below(n) == 0
    }
}
