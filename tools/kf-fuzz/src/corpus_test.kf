import testing.test

@test
fun std_brings_its_own_dependencies(): void {
    val deps = deps_of("//! run: exit 0\n//! deps: core, std\nfun main(): int32 { return 0 }\n")
    assert_eq(deps.join(","), "core,alloc,std", "alloc comes with std")
}

@test
fun names_are_put_in_build_order(): void {
    assert_eq(deps_of("//! deps: alloc, core\n").join(","), "core,alloc", "core first")
}

@test
fun no_header_means_no_libraries(): void {
    assert_eq(deps_of("fun main(): int32 { return 0 }\n").size(), 0, "nothing named")
}

@test
fun the_header_ends_at_the_first_other_line(): void {
    assert_eq(deps_of("//! run: exit 0\nfun f() {}\n//! deps: core\n").size(), 0, "a later line is not header")
}
