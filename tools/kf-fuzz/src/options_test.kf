import alloc.list.*

fun line(text: str): List<String> {
    return text.split(" ")
}

@test
fun a_bare_command_takes_the_defaults(): void {
    val options = parse_options(&line("front"))
    assert_eq(options.last_seed, 500, "seeds 1..500")
}

@test
fun a_seed_range_is_read(): void {
    val options = parse_options(&line("front --seeds 20..30"))
    assert_eq(options.first_seed * 100 + options.last_seed, 2030, "20 to 30")
}

@test
fun one_seed_is_a_range_of_one(): void {
    val options = parse_options(&line("kfi --seeds 7"))
    assert_eq(options.first_seed == 7 && options.last_seed == 7, true, "7..7")
}

@test
fun a_backwards_range_is_a_problem(): void {
    assert_eq(parse_options(&line("front --seeds 9..3")).problem.is_empty(), false, "reported")
}

@test
fun a_word_without_dashes_is_the_file(): void {
    val options = parse_options(&line("judge --expect hang crash.kf"))
    assert_eq(options.file, "crash.kf", "the program to judge")
}

@test
fun an_unknown_flag_is_a_problem(): void {
    assert_eq(parse_options(&line("front --speed 3")).problem, "unknown flag --speed", "named")
}

@test
fun parse_count_rejects_a_sign(): void {
    assert_eq(parse_count("-3") == null, true, "digits only")
}
