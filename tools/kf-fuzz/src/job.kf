// What one seed makes: a mutated fixture, or an intact fixture built against
// a mutated library interface.

import alloc.path.Path

@derive(Equal, Clone, Copy)
pub enum Mode {
    /// Each fixture as it is, the seed its index: a `build: fail` fixture
    /// passes on a crash, so this is what keeps a fixed crash fixed.
    Corpus
    /// Mutate the program.
    Source
    /// Mutate the interface of a library the program uses.
    Interface
}

pub fun Mode.label(): str {
    return when (*self) {
        Corpus => "corpus"
        Source => "front"
        Interface => "kfi"
    }
}

@derive(Clone)
pub struct Job {
    pub val seed: uint64
    pub val fixture: String
    pub val deps: List<String>
    pub val mutation: String
    /// The program to compile.
    pub val program: String
    /// In `Interface` mode, the library whose interface is `interface`.
    pub val library: String
    pub val interface: String
}

/// The seed decides everything, so a seed in a report rebuilds its job.
/// Interface jobs draw from the fixtures that use a library. `pieces` holds each interface cut, in `library_names` order, since an
/// interface is long and cutting it is most of an edit's cost. An interface
/// gets one edit, which is all most need to break.
pub fun make_job(mode: Mode, seed: uint64, corpus: &List<Fixture>, interfaces: &List<String>,
    pieces: &List<List<Piece>>): Job {
    var rng = Rng.seeded(seed)
    when (mode) {
        Corpus => {
            val fixture = corpus.at(seed % corpus.size())
            return Job {
                seed: seed, fixture: fixture.name.clone(), deps: fixture.deps.clone(), mutation: "none",
                program: fixture.source.clone(), library: "", interface: ""
            }
        }
        Source => {
            val fixture = corpus.at(rng.below(corpus.size()))
            val mutant = mutate(fixture.source, &var rng)
            return Job {
                seed: seed, fixture: fixture.name.clone(), deps: fixture.deps.clone(), mutation: mutant.name.clone(),
                program: mutant.text.clone(), library: "", interface: ""
            }
        }
        Interface => {
            var users = List.new<uint64>()
            while i in 0..corpus.size() {
                if corpus.at(i).deps.size() > 0 { users.push(i) }
            }
            val fixture = corpus.at(*users.at(rng.below(users.size())))
            val library = fixture.deps.at(rng.below(fixture.deps.size())).clone()
            val index = library_names().position(|name: String| name.as_str() == library.as_str()) ?: 0
            val mutant = mutate_cut(interfaces.at(index).as_str(), pieces.at(index), &var rng)
            return Job {
                seed: seed, fixture: fixture.name.clone(), deps: fixture.deps.clone(), mutation: mutant.name.clone(),
                program: fixture.source.clone(), library: library, interface: mutant.text.clone()
            }
        }
    }
}

/// `slot/case/src/main.kf`, and in `Interface` mode the interfaces in
/// `slot/out`, ready for `crate_run`.
pub fun Job.stage(slot: str, originals: &List<String>): bool {
    if Dir.create_all("${slot}/case/src".as_str()).is_err() { return false }
    if Dir.create_all("${slot}/out".as_str()).is_err() { return false }
    if File.write("${slot}/case/src/main.kf".as_str(), self.program).is_err() { return false }
    return write_interfaces("${slot}/out".as_str(), originals, self.library, self.interface)
}

pub fun Job.crate_run(slot: str): CrateRun {
    return CrateRun {
        name: "case", root: "${slot}/case", out: "${slot}/out", deps: self.deps.clone(), is_bin: true,
        log: "${slot}/kflatc.log"
    }
}

/// The program as `NAME.kf`, and a mutated interface beside it as
/// `NAME.LIBRARY.kfi`, in `dir`.
pub fun Job.save(dir: str, name: str): void {
    val _made = Dir.create_all(dir)
    val _program = File.write("${dir}/${name}.kf".as_str(), self.program)
    if !self.library.is_empty() {
        val _interface = File.write("${dir}/${name}.${self.library}.kfi".as_str(), self.interface)
    }
}
