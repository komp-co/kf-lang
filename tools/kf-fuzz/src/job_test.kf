import testing.test

fun fixture(name: str, source: str): Fixture {
    return Fixture { name: String.from(name), source: String.from(source), deps: List.new<String>() }
}

@test
fun a_corpus_job_is_its_fixture_unchanged(): void {
    var corpus = List.new<Fixture>()
    corpus.push(fixture("a.kf", "fun main(): int32 { return 0 }"))
    corpus.push(fixture("b.kf", "fun main(): int32 { return 1 }"))
    val job = make_job(Mode.Corpus, 1, &corpus, &List.new<String>(), &List.new<List<Piece>>())
    assert_eq(job.program, "fun main(): int32 { return 1 }", "fixture 1, as written")
}
