// What a kflatc run means. Rejecting a broken program is the point, so only a
// run that does not end the way kflatc ends is a finding, and its signature
// groups it with the runs that failed the same way.
//
//     exit 0                                       fine
//     exit 1, last line `kflatc: errors found...`  fine
//     exit 124 or 137                              hang (killed by `timeout`)
//     exit 128+N                                   killed by signal N
//     exit 1, last line `panic[<code>]: ...`       that line
//     exit 1, any other last line                  panic, that line
//     any other exit                               that exit and last line

pub struct Verdict {
    pub val fine: bool
    /// Empty when fine.
    pub val signature: String
}

fun fine(): Verdict {
    return Verdict { fine: true, signature: "" }
}

fun finding(signature: str): Verdict {
    return Verdict { fine: false, signature: String.from(signature) }
}

pub fun judge(exit_code: int32, output: str): Verdict {
    val last = last_line(output)
    if exit_code == 0 { return fine() }
    if exit_code == 1 && last.starts_with("kflatc: errors found") { return fine() }
    if exit_code == 124 || exit_code == 137 { return finding("hang") }
    if exit_code > 128 { return finding("signal ${signal_name(exit_code - 128)}".as_str()) }
    if exit_code == 1 {
        if last.is_empty() { return finding("panic without a message") }
        if last.starts_with("panic[") { return finding(normalize(last).as_str()) }
        return finding("panic: ${normalize(last.as_str())}".as_str())
    }
    return finding("exit ${exit_code}: ${normalize(last.as_str())}".as_str())
}

pub fun signal_name(n: int32): String {
    return when (n) {
        4 => String.from("SIGILL")
        6 => String.from("SIGABRT")
        7 => String.from("SIGBUS")
        8 => String.from("SIGFPE")
        11 => String.from("SIGSEGV")
        _ => "${n}"
    }
}

/// The last line with anything on it, trimmed.
pub fun last_line(output: str): String {
    val lines = output.split("\n")
    var i = lines.size()
    while i > 0 {
        i = i - 1
        val line = lines.at(i).trim()
        if !line.is_empty() { return line }
    }
    return String.from("")
}

/// Runs of digits become `N` and a word holding `/` becomes `PATH`, so two
/// runs that fail the same way share a signature. At most 100 bytes.
pub fun normalize(line: str): String {
    var out = String.from("")
    var word = String.from("")
    var i: uint64 = 0
    while i <= line.byte_len() {
        val b: uint8 = if i < line.byte_len() { line.byte_at(i) } else { 32 }
        if b == 32 {
            if word.contains("/") { out.append("PATH") } else { out.append(word) }
            if i < line.byte_len() { out.append(" ") }
            word = String.from("")
        } else if b >= 48 && b <= 57 {
            if word.is_empty() || word.byte_at(word.byte_len() - 1) != 78 { word.push_byte(78) }
            while i + 1 < line.byte_len() && line.byte_at(i + 1) >= 48 && line.byte_at(i + 1) <= 57 { i = i + 1 }
        } else {
            word.push_byte(b)
        }
        i = i + 1
    }
    if out.byte_len() > 100 { return out.take_bytes(100) }
    return out
}
