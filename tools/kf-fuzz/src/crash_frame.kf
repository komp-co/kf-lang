// Where kflatc crashed or hung, so two failures in different places get
// different signatures. A failing program is run again under gdb, when there
// is one; failures are rare, so the rerun costs little.
//
//     a crash          its first frame outside the C library
//     a stack overflow `recursion through F`, F the first by name of the
//                      functions repeating at the top, wherever it overflowed
//     a hang           the innermost frame three backtraces, taken apart,
//                      share, leaving out library helpers

/// Deeper than this, a crash is a stack overflow.
fun overflow_depth(): uint64 { return 5000 }

/// Whether `gdb` is on PATH.
pub fun gdb_available(): bool {
    var probe = Command.new("sh")
    probe.arg("-c")
    probe.arg("command -v gdb > /dev/null")
    return probe.status().success()
}

pub struct Frame {
    pub val number: uint64
    pub val name: String
}

/// The frames of each backtrace in `text`, innermost first, in the order
/// gdb printed them.
pub fun parse_frames(text: str): List<Frame> {
    var frames = List.new<Frame>()
    while raw in &text.split("\n") {
        val line = raw.trim()
        if !line.starts_with("#") { continue }
        val space = line.index_of(" ") ?: continue
        val number = parse_count(line.substring(1, space).as_str()) ?: continue
        var rest = line.slice_from(space).trim()
        if rest.starts_with("0x") {
            val marker = rest.index_of(" in ") ?: continue
            rest = rest.slice_from(marker + 4)
        }
        val open = rest.index_of(" (") ?: rest.byte_len()
        val written = rest.substring(0, open)
        // A crate-at-a-time build names `kf_codegen.emit_free` what the
        // bootstrap names `emit_free`.
        val dot = written.last_index_of(".")
        val name = if dot == null { written } else { written.slice_from(dot!! + 1) }
        frames.push(Frame { number: number, name: name })
        continue
    }
    return frames
}

fun is_library_frame(name: str): bool {
    return name.starts_with("_") || name == "malloc" || name == "free" || name == "realloc" ||
        name == "calloc" || name == "memcpy" || name == "memmove" || name == "memset" || name == "strlen" ||
        name == "abort" || name == "raise" || name == "??" || name.contains("libc")
}

/// From one backtrace of the top frames, then `bt -1` for the outermost.
pub fun crash_place_in(text: str): String {
    val frames = parse_frames(text)
    var depth: uint64 = 0
    while frame in &frames {
        if frame.number > depth { depth = frame.number }
    }
    if depth >= overflow_depth() {
        var repeated = String.from("")
        while i in 0..frames.size() {
            val name = frames.at(i).name.as_str()
            if is_library_frame(name) { continue }
            var seen = 0
            while frame in &frames {
                if frame.name.as_str() == name { seen = seen + 1 }
            }
            if seen >= 2 && (repeated.is_empty() || String.from(name) < repeated) { repeated = String.from(name) }
        }
        if !repeated.is_empty() { return "recursion through ${repeated}" }
    }
    while frame in &frames {
        if !is_library_frame(frame.name) { return frame.name.clone() }
    }
    return String.from("")
}

/// A library function a loop calls on every turn, such as `String.from`,
/// says nothing about which loop: anything generic or from core and alloc.
fun is_helper_frame(name: str): bool {
    return is_library_frame(name) || name.contains("__") || name.starts_with("String_") ||
        name.starts_with("str_") || name.starts_with("List_") || name.starts_with("kf_")
}

/// From whole backtraces with `---` between them: the innermost frame all
/// share, counting from the outermost, that is not a helper.
pub fun hang_place_in(text: str): String {
    var samples = List.new<List<Frame>>()
    while part in &text.split("---") { samples.push(parse_frames(part)) }
    if samples.size() < 2 { return String.from("") }
    var shared = String.from("")
    var depth: uint64 = 0
    while true {
        val first = samples.at(0)
        if depth >= first.size() { break }
        val name = first.at(first.size() - 1 - depth).name.as_str()
        var all = true
        while sample in &samples {
            if depth >= sample.size() || sample.at(sample.size() - 1 - depth).name.as_str() != name { all = false }
        }
        if !all { break }
        if !is_helper_frame(name) { shared = String.from(name) }
        depth = depth + 1
    }
    return shared
}

// `$3` is the timeout and kflatc's command line follows; see `scripted`.
fun crash_script(): String {
    val gdb = "gdb -batch -ex run -ex 'bt 40' -ex 'bt -1' --args"
    return "log=\"$2\"; t=\"$3\"; shift 3; timeout -k 1 \"$((t * 3))\" ${gdb} \"$@\" > \"$log\" 2>&1"
}

/// gdb runs kflatc as its child, so attaching needs no ptrace permission;
/// each SIGINT stops it for a backtrace, and `continue` runs it on.
fun hang_script(): String {
    val sample = "-ex bt -ex 'echo ---\\n' -ex continue"
    val gdb = "gdb -batch -ex run ${sample} ${sample} -ex bt --args \"$@\" > \"$log\" 2>&1 & g=$!"
    val poke = "for i in 1 2 3; do p=$(pgrep -P \"$g\" | head -1); [ -n \"$p\" ] && kill -INT \"$p\"; sleep 0.3; done"
    val stop = "sleep 1; pkill -9 -P \"$g\"; kill -9 \"$g\"; wait; exit 0"
    return "exec 2>/dev/null; log=\"$2\"; t=\"$3\"; shift 3; ${gdb}; sleep \"$t\"; ${poke}; ${stop}"
}

/// Reruns `run` under gdb. Without the memory limit, which gdb would exhaust.
pub fun Limits.crash_place(run: &CrateRun): String {
    val _status = self.scripted(crash_script().as_str(), run, 0).status()
    return crash_place_in(read_log(run.log).as_str())
}

/// Reruns `run`, and once it has run past the timeout, samples where it is
/// three times.
pub fun Limits.hang_place(run: &CrateRun): String {
    val _status = self.scripted(hang_script().as_str(), run, 0).status()
    return hang_place_in(read_log(run.log).as_str())
}
