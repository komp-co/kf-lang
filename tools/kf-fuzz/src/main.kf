// kf-fuzz: the front-end fuzzer. kflatc must end every run with diagnostics,
// however broken its input; a crash, panic or hang is a finding.
//
//   kf-fuzz front [--seeds A..B] [--jobs N] [--timeout S] [--memory MB] [--budget S]
//                 [--kflatc PATH] [--libs DIR] [--cases DIR] [--known FILE] [--save DIR]
//   kf-fuzz kfi   ... the same, mutating a library's interface instead
//   kf-fuzz corpus ... every fixture once, unmutated
//   kf-fuzz front|kfi --seeds A..B --emit DIR      write the seeds' jobs, run nothing
//   kf-fuzz judge [--expect SIG] [--interface NAME=FILE] FILE
//
// `judge` prints a program's signature, or `fine`; with `--expect`, it exits 0
// only for that signature, which makes it a predicate for kf-reduce.
//
// Exit 0 when nothing new was found, 1 when something was, 2 when the run
// could not start.

import alloc.list.*
import std.fs.TempDir
import std.fs.read_to_string
import std.fs.create_dir_all
import std.time.Instant

fun usage(problem: str): int32 {
    println("kf-fuzz: ${problem}")
    println("usage: kf-fuzz front|kfi|corpus [--seeds A..B] [--jobs N] [--timeout S] [--memory MB] [--budget S]")
    println("                         [--kflatc PATH] [--libs DIR] [--cases DIR] [--known FILE]")
    println("                         [--save DIR] [--emit DIR]")
    println("       kf-fuzz judge [--expect SIGNATURE] [--interface NAME=FILE] FILE")
    return 2
}

fun read_or_empty(path: str): String {
    val read = read_to_string(path)
    return if read.is_ok() { read.unwrap() } else { String.from("") }
}

fun main(): int32 {
    var args = List.new<String>()
    while i in 0..arg_count() { args.push(String.from(arg_at(i))) }
    val options = parse_options(&args)
    if !options.problem.is_empty() { return usage(options.problem) }
    val limits = Limits {
        kflatc: options.kflatc.clone(), timeout_seconds: options.timeout_seconds, memory_mb: options.memory_mb,
        use_gdb: gdb_available()
    }
    val work = TempDir.new("kf-fuzz")
    val libraries = "${work.path().as_str()}/libs"
    val _made = create_dir_all(work.path().join("libs"))
    when options.command.as_str() {
        "corpus" => return campaign(Mode.Corpus, &options, limits, &work, libraries)
        "front" => return campaign(Mode.Source, &options, limits, &work, libraries)
        "kfi" => return campaign(Mode.Interface, &options, limits, &work, libraries)
        "judge" => return judge_one(&options, limits, &work, libraries)
        _ => return usage("unknown command ${options.command}".as_str())
    }
}

fun campaign(mode: Mode, options: &Options, limits: Limits, work: &TempDir, libraries: str): int32 {
    val corpus = load_corpus(options.cases)
    if corpus.size() == 0 { return usage("no fixtures in ${options.cases}".as_str()) }
    if !options.emit_dir.is_empty() {
        if !limits.build_libraries(options.libs, libraries) { return 2 }
        val interfaces = read_interfaces(libraries)
        val pieces = cut_all(&interfaces)
        while seed in options.first_seed..=options.last_seed {
            val name = "${mode.label()}-seed${seed}"
            make_job(mode, seed, &corpus, &interfaces, &pieces).save(options.emit_dir, name)
        }
        return 0
    }
    if !limits.build_libraries(options.libs, libraries) { return 2 }
    val started = Instant.now()
    val interfaces = read_interfaces(libraries)
    val pieces = cut_all(&interfaces)
    val run = Campaign {
        mode: mode, limits: limits, corpus: corpus, interfaces: interfaces, pieces: pieces,
        known: parse_known(read_or_empty(options.known).as_str()), jobs: options.jobs,
        budget_seconds: options.budget_seconds, save_dir: options.save_dir.clone()
    }
    // Every fixture once, whatever the seeds say.
    val first = if mode == Mode.Corpus { 0 } else { options.first_seed }
    val last = if mode == Mode.Corpus { run.corpus.size() - 1 } else { options.last_seed }
    val tally = run.run(first, last, work)
    run.report(&tally, started.elapsed().as_seconds())
    return if tally.new_count() > 0 { 1 } else { 0 }
}

fun cut_all(texts: &List<String>): List<List<Piece>> {
    var all = List.new<List<Piece>>()
    while text in &texts { all.push(cut_pieces(text)) }
    return all
}

fun judge_one(options: &Options, limits: Limits, work: &TempDir, libraries: str): int32 {
    if options.file.is_empty() { return usage("judge needs a FILE") }
    if !limits.build_libraries(options.libs, libraries) { return 2 }
    val program = read_or_empty(options.file)
    var library = String.from("")
    var interface = String.from("")
    if !options.interface.is_empty() {
        val eq = options.interface.index_of("=") ?: return usage("--interface wants NAME=FILE")
        library = options.interface.substring(0, eq)
        interface = read_or_empty(options.interface.slice_from(eq + 1).as_str())
    }
    val job = Job {
        seed: 0, fixture: options.file.clone(), deps: deps_of(program), mutation: "", program: program,
        library: library, interface: interface
    }
    val slot = "${work.path().as_str()}/judge"
    if !job.stage(slot, &read_interfaces(libraries)) { return usage("cannot write ${slot}".as_str()) }
    val verdict = limits.run_now(&job.crate_run(slot))
    println(if verdict.fine { "fine" } else { verdict.signature.as_str() })
    if !options.expect.is_empty() { return if verdict.signature.as_str() == options.expect.as_str() { 0 } else { 1 } }
    return if verdict.fine { 0 } else { 1 }
}
