// The programs the fuzzer starts from: `tests/cases` fixtures, each with the
// libraries its `//! deps:` header names.

pub struct Fixture {
    pub val name: String
    pub val source: String
    /// In build order, each after what it uses: `core`, `alloc`, `std`.
    pub val deps: List<String>
}

/// The libraries a fixture builds against: those its header names, and what
/// they use, in build order. Unknown names are left out.
pub fun deps_of(source: str): List<String> {
    var named = String.from("")
    while line in &source.split("\n") {
        if !line.starts_with("//!") { break }
        val body = line.slice_from(3).trim()
        if body.starts_with("deps:") { named = body.slice_from(5) }
    }
    var wanted = List.new<String>()
    while part in &named.split(",") { wanted.push(part.trim()) }
    val has_std = wanted.contains(&String.from("std"))
    val has_alloc = has_std || wanted.contains(&String.from("alloc"))
    val has_core = has_alloc || wanted.contains(&String.from("core"))
    var deps = List.new<String>()
    if has_core { deps.push(String.from("core")) }
    if has_alloc { deps.push(String.from("alloc")) }
    if has_std { deps.push(String.from("std")) }
    return deps
}

/// Every `.kf` directly in `dir`, by name.
pub fun load_corpus(dir: str): List<Fixture> {
    var fixtures = List.new<Fixture>()
    val listing = Dir.entries(dir)
    if listing.is_err() { return fixtures }
    while name in &listing.unwrap() {
        if !name.ends_with(".kf") { continue }
        val read = File.read("${dir}/${name}".as_str())
        if read.is_err() { continue }
        val text = read.unwrap()
        fixtures.push(Fixture { name: name.clone(), deps: deps_of(text), source: text })
    }
    return fixtures
}
