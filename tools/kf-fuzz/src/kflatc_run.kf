// Running kflatc on one crate under a time and memory limit, its output to a
// file. Through `sh`, for `ulimit` and the redirection, and `timeout`, which
// exits 124 when the limit is reached. `sh` waits rather than execs, so a
// signal that kills kflatc reaches us as 128 + its number.

pub struct Limits {
    pub val kflatc: String
    pub val timeout_seconds: uint64
    /// 0 for no limit, which an ASan-built kflatc needs.
    pub val memory_mb: uint64
    /// Rerun a crash under gdb to name where it struck.
    pub val use_gdb: bool
}

/// One crate to compile: `name` at `root`, against the interfaces in `out`.
pub struct CrateRun {
    pub val name: String
    pub val root: String
    pub val out: String
    pub val deps: List<String>
    pub val is_bin: bool
    pub val log: String
}

fun shell_script(): String {
    val limit = "[ \"$1\" = 0 ] || ulimit -v $(($1 * 1024)) 2>/dev/null"
    val run = "log=\"$2\"; shift 2; timeout -k 1 \"$@\" > \"$log\" 2>&1"
    return "${limit}; ${run}"
}

pub fun Limits.command(run: &CrateRun): Command {
    return self.scripted(shell_script().as_str(), run, self.memory_mb)
}

/// `sh -c script` with `$1` the memory limit in MB, `$2` the log, `$3` the
/// timeout, and kflatc's command line for `run` after them.
pub fun Limits.scripted(script: str, run: &CrateRun, memory_mb: uint64): Command {
    var command = Command.new("sh")
    command.arg("-c")
    command.arg(script)
    command.arg("kf-fuzz")
    command.arg("${memory_mb}".as_str())
    command.arg(run.log)
    command.arg("${self.timeout_seconds}".as_str())
    command.arg(self.kflatc)
    command.arg("compile")
    command.arg("--name")
    command.arg(run.name)
    command.arg("--root")
    command.arg(run.root)
    command.arg("--out")
    command.arg(run.out)
    command.arg("--project")
    command.arg(run.root)
    if run.is_bin { command.arg("--bin") }
    while dep in &run.deps {
        command.arg("--dep")
        command.arg("${dep}=0".as_str())
        command.arg("--load")
        command.arg(dep)
    }
    return command
}

pub fun Limits.start(run: &CrateRun): Result<Child, IoError> {
    return self.command(run).spawn()
}

/// Runs to the end and judges it.
pub fun Limits.run_now(run: &CrateRun): Verdict {
    val code = self.command(run).status().exit_code()
    return self.refine(run, judge(code, read_log(run.log).as_str()))
}

/// A crash's or hang's signature, with where it happened when gdb can tell.
pub fun Limits.refine(run: &CrateRun, verdict: Verdict): Verdict {
    if !self.use_gdb { return verdict }
    val is_signal = verdict.signature.starts_with("signal ")
    if !is_signal && verdict.signature.as_str() != "hang" { return verdict }
    val place = if is_signal { self.crash_place(run) } else { self.hang_place(run) }
    if place.is_empty() { return verdict }
    return Verdict { fine: false, signature: "${verdict.signature} in ${place}" }
}

pub fun read_log(path: str): String {
    val read = File.read(path)
    if read.is_err() { return String.from("") }
    return read.unwrap()
}
