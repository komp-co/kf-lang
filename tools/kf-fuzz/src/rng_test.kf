@test
fun splitmix_matches_its_reference_sequence(): void {
    var rng = Rng.seeded(1234567)
    assert_eq(rng.next(), 6457827717110365317, "the first output of the published reference")
}

@test
fun one_seed_gives_one_sequence(): void {
    var a = Rng.seeded(42)
    var b = Rng.seeded(42)
    val _skip = a.next()
    val _skip_too = b.next()
    assert_eq(a.next(), b.next(), "the second draws agree")
}

@test
fun below_stays_below(): void {
    var rng = Rng.seeded(7)
    var ok = true
    while _i in 0..1000 {
        if rng.below(13) >= 13 { ok = false }
    }
    assert_eq(ok, true, "every draw is under 13")
}

@test
fun below_zero_is_zero(): void {
    var rng = Rng.seeded(7)
    assert_eq(rng.below(0), 0, "an empty range draws 0")
}
