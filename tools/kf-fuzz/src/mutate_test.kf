import testing.test

fun program(): str { return "fun main(): int32 {\n    val xs = [1, 2]\n    return xs.size() as int32\n}\n" }

@test
fun one_seed_makes_one_mutant(): void {
    var a = Rng.seeded(99)
    var b = Rng.seeded(99)
    assert_eq(mutate(program(), &var a).text, mutate(program(), &var b).text, "the same edits")
}

@test
fun a_mutant_differs_from_its_program_for_most_seeds(): void {
    var changed: uint64 = 0
    while seed in 0..100 {
        var rng = Rng.seeded(seed as uint64)
        if mutate(program(), &var rng).text.as_str() != program() { changed = changed + 1 }
    }
    assert_eq(changed > 90, true, "nearly every seed edits something")
}

@test
fun every_edit_kind_is_reached(): void {
    var seen = String.from("")
    while seed in 0..400 {
        var rng = Rng.seeded(seed as uint64)
        val step = mutate_once(program(), &var rng)
        if !seen.contains(step.name.as_str()) { seen.append("${step.name} ") }
    }
    val kinds = ["delete", "duplicate", "swap", "splice", "truncate", "bytes", "keyword", "unbalance"]
    var missing = String.from("")
    while kind in &kinds {
        if !seen.contains(kind) { missing.append(kind) }
    }
    assert_eq(missing, "", "each edit appears within 400 seeds")
}

@test
fun an_empty_program_gets_bytes(): void {
    var rng = Rng.seeded(5)
    val step = mutate_once("", &var rng)
    assert_eq(step.name, "bytes", "nothing to cut, so bytes go in")
}

@test
fun unbalance_removes_one_delimiter(): void {
    var found = false
    while seed in 0..400 {
        var rng = Rng.seeded(seed as uint64)
        val step = mutate_once("f(x)", &var rng)
        if step.name.as_str() == "unbalance" {
            found = true
            assert_eq(step.text.as_str() == "fx)" || step.text.as_str() == "f(x", true, "one paren gone")
        }
    }
    assert_eq(found, true, "some seed unbalances")
}
