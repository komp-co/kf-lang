// A run over a range of seeds: up to `jobs` kflatc processes at once, each
// finding grouped by its signature.

import alloc.list.*
import std.fs.TempDir
import std.process.Child
import std.time.*

pub struct Campaign {
    pub val mode: Mode
    pub val limits: Limits
    pub val corpus: List<Fixture>
    /// The libraries' interfaces, in `library_names` order.
    pub val interfaces: List<String>
    /// Each of `interfaces` cut into pieces.
    pub val pieces: List<List<Piece>>
    pub val known: List<KnownFinding>
    pub val jobs: uint64
    /// Stop starting jobs after this many seconds; 0 for no budget.
    pub val budget_seconds: int64
    /// Where the first job of each new signature is saved; "" for nowhere.
    pub val save_dir: String
}

/// Every run that failed one way.
pub struct Bucket {
    pub val signature: String
    pub val issue: String
    pub var count: uint64
    pub val first: Job
}

pub struct Tally {
    pub var runs: uint64
    pub var buckets: List<Bucket>
}

struct Running {
    val slot: uint64
    val job: Job
    var child: Child
}

pub mutating fun Tally.record(job: &Job, verdict: &Verdict, known: &List<KnownFinding>): void {
    self.runs = self.runs + 1
    if verdict.fine { return }
    while i in 0..self.buckets.size() {
        val bucket = self.buckets.at_mut(i)
        if bucket.signature.as_str() == verdict.signature.as_str() {
            bucket.count = bucket.count + 1
            return
        }
    }
    val issue = issue_for(known, verdict.signature)
    self.buckets.push(Bucket { signature: verdict.signature.clone(), issue: issue, count: 1, first: job.clone() })
}

pub fun Tally.new_count(): uint64 {
    var n: uint64 = 0
    while bucket in &self.buckets {
        if bucket.issue.is_empty() { n = n + 1 }
    }
    return n
}

pub fun Campaign.run(first: uint64, last: uint64, work: &TempDir): Tally {
    var tally = Tally { runs: 0, buckets: List.new<Bucket>() }
    val started = Instant.now()
    var free = List.new<uint64>()
    while slot in 0..self.jobs { free.push(self.jobs - 1 - slot) }
    var running = List.new<Running>()
    var next = first
    while true {
        val in_budget = self.budget_seconds == 0 || started.elapsed().as_seconds() < self.budget_seconds
        while next <= last && in_budget && free.size() > 0 {
            val slot = free.take_last() ?: break
            val dir = "${work.path().as_str()}/slot${slot}"
            val job = make_job(self.mode, next, &self.corpus, &self.interfaces, &self.pieces)
            next = next + 1
            if !job.stage(dir, &self.interfaces) {
                println("kf-fuzz: cannot write ${dir}")
                free.push(slot)
                continue
            }
            when (self.limits.start(&job.crate_run(dir))) {
                Ok(child) => running.push(Running { slot: slot, job: job, child: child })
                Err(_) => {
                    println("kf-fuzz: cannot start ${self.limits.kflatc}")
                    return tally
                }
            }
        }
        if running.size() == 0 { break }
        var finished = false
        var i: uint64 = 0
        while i < running.size() {
            val status = running.at_mut(i).child.try_wait()
            if status == null {
                i = i + 1
                continue
            }
            val done = running.remove(i) ?: break
            val dir = "${work.path().as_str()}/slot${done.slot}"
            val first_verdict = judge(status!!.exit_code(), read_log("${dir}/kflatc.log".as_str()).as_str())
            val verdict = self.limits.refine(&done.job.crate_run(dir), first_verdict)
            tally.record(&done.job, &verdict, &self.known)
            free.push(done.slot)
            finished = true
        }
        if !finished { sleep(Duration.from_millis(2)) }
    }
    return tally
}

/// One line per signature, new ones first, and the new ones' first jobs
/// saved.
pub fun Campaign.report(tally: &Tally, seconds: int64): void {
    println("kf-fuzz ${self.mode.label()}: ${tally.runs} runs in ${seconds}s, ${tally.buckets.size()} signatures")
    while bucket in &tally.buckets {
        if !bucket.issue.is_empty() { continue }
        val job = &bucket.first
        val name = "${self.mode.label()}-seed${job.seed}"
        val what = if job.library.is_empty() { job.mutation.clone() } else { "${job.mutation} of ${job.library}.kfi" }
        println("  NEW    ${bucket.signature}  x${bucket.count}")
        println("         first: --seeds ${job.seed}..${job.seed} (${job.fixture}, ${what})")
        if !self.save_dir.is_empty() {
            job.save(self.save_dir, name)
            println("         saved ${self.save_dir}/${name}.kf")
        }
    }
    while bucket in &tally.buckets {
        if bucket.issue.is_empty() { continue }
        println("  known  #${bucket.issue} ${bucket.signature}  x${bucket.count}")
    }
}
