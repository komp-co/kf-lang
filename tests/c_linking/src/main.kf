extern "C" fun runtime_println(s: str): void
extern "C" fun answer(): int32
extern "C" fun pair_sum(p: Ptr<Pair>): int32

/// Named `Pair` in C too, so answer.c can take one.
@no_mangle
pub struct Pair {
    pub val a: int32
    pub val b: int32
}

// `answer` and `pair_sum` are implemented in answer.c, linked via [native]
// c_sources. The exit code shows the shim linked.
fun main(): int32 {
    val p = Pair { a: 40, b: 2 }
    if answer() == 42 && pair_sum(p) == 42 {
        runtime_println("C-LINK OK")
        return 42
    }
    runtime_println("C-LINK FAIL")
    return 1
}
