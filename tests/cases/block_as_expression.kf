//! run: exit 0
//! deps: core, alloc

// An if-expression branch may hold statements; its value is the last
// statement. A branch of one expression is not a block and keeps the C
// ternary.
//
// The block's locals drop after the value is taken; the String case fails if
// the order is wrong.

fun double(n: int32): int32 { return n * 2 }

// A block in `return` position needs no temporary: each branch returns.
fun pick(c: bool): String {
    return if c {
        val prefix = String.from("heap ")
        prefix + String.from("payload")
    } else {
        String.from("none")
    }
}

fun main(): int32 {
    val c = true

    val x = if c {
        val t = double(3)
        t + 1
    } else { 2 }
    if x != 7 { return 1 }

    // Blocks on both sides, and the else taken.
    val y = if !c {
        val t = double(3)
        t + 1
    } else {
        val u = 5
        u - 3
    }
    if y != 2 { return 2 }

    // Single-expression branches are untouched.
    val z = if c { 1 } else { 2 }
    if z != 1 { return 3 }

    // `else if` nests as the else branch, so the recursion reaches it.
    val n = 7
    val w = if n < 5 { 0 } else if n < 10 {
        val m = n * 2
        m
    } else { 99 }
    if w != 14 { return 4 }

    // A block whose tail is an if-expression, reached through a binding.
    val q = if c {
        val a = 1
        val inner = if c { val b = a + 1
            b } else { 0 }
        inner
    } else { 0 }
    if q != 2 { return 5 }

    // Move-only: a String built from a block-local and handed out.
    val s = pick(true)
    if s.byte_len() != 12 { return 6 }
    val s2 = pick(false)
    if s2.byte_len() != 4 { return 7 }

    return if c {
        val f = 0
        f
    } else { 9 }
}
