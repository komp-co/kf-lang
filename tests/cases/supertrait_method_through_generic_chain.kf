//! run: exit 0
//! deps: core
// A two-hop requirement chain rewriting type arguments at each hop: `Basin<B>`
// requires `Sink<B>`, which requires `Drain<X>`. The parameters are named
// differently so an inert substitution cannot pass. The inherited `drain`
// takes an `int32`.

trait Drain<X> { fun drain(a: X): int32 }
trait Sink<A>: Drain<A> { fun sink(a: A): int32 }
trait Basin<B>: Sink<B> { fun basin(a: B): int32 }

struct Bin { var n: int32 }

impl Drain<int32> for Bin { fun drain(a: int32): int32 { return a + self.n } }
impl Sink<int32> for Bin { fun sink(a: int32): int32 { return a * 2 } }
impl Basin<int32> for Bin { fun basin(a: int32): int32 { return a * 3 } }

fun pour<T: Basin<int32>>(t: T): int32 { return t.drain(40) + t.sink(1) }

fun main(): int32 {
    val b = Bin { n: 0 }
    return pour(b) - 42
}
