//! run: exit 0
//! deps: core, alloc
// `@derive(Default)` gives each field its natural default (0 / false / "" /
// nested `.default()`). A generic bounded on Default calls it through the
// type parameter.
extern "C" fun runtime_println(s: str): void

@derive(Default)
pub struct Config {
    var count: int32
    var enabled: bool
    var name: String
}

@derive(Default)
pub struct Wrapper {
    var cfg: Config
    var id: uint64
}

fun make<T: Default>(): T { return T.default() }

fun main(): void {
    val c = Config.default()
    if c.count == 0 { runtime_println("count OK") } else { runtime_println("FAIL count") }
    if !c.enabled { runtime_println("enabled OK") } else { runtime_println("FAIL enabled") }
    if c.name.equals("") { runtime_println("name OK") } else { runtime_println("FAIL name") }
    val w = Wrapper.default()          // nested: Wrapper.default calls Config.default
    if w.cfg.count == 0 { runtime_println("nested OK") } else { runtime_println("FAIL nested") }
    val g = make<Config>()             // generic Default bound + dispatch
    if g.count == 0 { runtime_println("generic OK") } else { runtime_println("FAIL generic") }
    runtime_println("ALL OK")
}
