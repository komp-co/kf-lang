//! deps: core
//! broken: #23 — `impl Trait for T` parses and registers but applies to nothing, so the method does not exist
// A blanket impl, whose receiver is an unbound parameter, should add a method
// to every type. Dispatch is keyed on the receiver's spelling, which a blanket
// impl lacks; the registry needs a fallback entry any type satisfies,
// materialized per concrete receiver.

trait Piped {
    fun tag(): uint64
}

impl Piped for T {
    fun tag(): uint64 { return 7 }
}

struct Widget {
    pub var v: int32
}

fun main(): int32 {
    val w = Widget { v: 1 }
    if w.tag() != 7 { return 1 }
    return 0
}
