//! run: exit 0
//! deps: core

// Each use of a top-level `val` is its literal, typed as declared: a number,
// text, an array iterated or searched, and a use inside a lambda.

val LIMIT: int32 = 9
val OFFSET: int64 = -5000000000
val RATIO: float64 = 2.5
val GREETING: str = "hello"
val ON: bool = true
val DIGITS: char[] = "0123456789"
val PRIMES: int32[] = [2, 3, 5, 7]

fun sum_primes(): int32 {
    var total = 0
    while p in &PRIMES {
        total = total + p
    }
    return total
}

fun main(): int32 {
    if LIMIT + 1 != 10 { return 1 }
    if OFFSET + 5000000000 != 0 { return 2 }
    if RATIO < 2.4 || RATIO > 2.6 { return 3 }
    if GREETING.byte_len() != 5 { return 4 }
    if !ON { return 5 }
    val seven = '7'
    if !DIGITS.contains(&seven) { return 6 }
    if PRIMES.size() != 4 || PRIMES[3] != 7 { return 7 }
    if sum_primes() != 17 { return 8 }
    val add_limit = |n: int32| n + LIMIT
    if add_limit(1) != 10 { return 9 }
    return 0
}
