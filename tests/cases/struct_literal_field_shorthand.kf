//! run: exit 0
//! deps: core

// `Point { x, y }` is `Point { x: x, y: y }`, bound by name: the fields share
// a type, so a positional binding would swap them silently.

pub struct Point {
    val x: int32
    val y: int32
}

pub struct Mixed {
    val first: int32
    val second: int32
    val third: int32
}

fun main(): int32 {
    val x = 1
    val y = 2
    val p = Point { y, x }
    if p.x != 1 { return 1 }
    if p.y != 2 { return 2 }

    // Shorthand and written fields in one literal, in neither's order.
    val second = 20
    val m = Mixed { third: 30, second, first: 10 }
    if m.first != 10 { return 3 }
    if m.second != 20 { return 4 }
    if m.third != 30 { return 5 }
    return 0
}
