//! run: exit 37
// A trailing `if` is the value of the block it ends: its tails are walked,
// and every path must yield. `when` likewise; `else if` chains recurse.

fun pick(c: bool): int32 {
    // The reported shape.
    val q = if c {
        val a = 1
        if c { a + 1 } else { 0 }
    } else { 0 }
    return q
}

fun via_when(k: int32): int32 {
    val v = if k > 0 {
        val base = 10
        when (k) {
            1 => { base + 1 }
            _ => { base + 2 }
        }
    } else { 0 }
    return v
}

fun chained(c: bool, d: bool): int32 {
    // An `else if` chain: reaching the third arm proves the walk recurses.
    val q = if c {
        val a = 1
        if c && d { a + 1 } else if d { a + 5 } else { a + 9 }
    } else { 0 }
    return q
}

fun main(): int32 {
    var acc: int32 = 0
    acc = acc + pick(true)              // 2
    acc = acc + pick(false)             // 0
    acc = acc + via_when(1)             // 11
    acc = acc + via_when(5)             // 12
    acc = acc + chained(true, true)     // 2
    acc = acc + chained(true, false)    // 10
    return acc                          // 37
}
