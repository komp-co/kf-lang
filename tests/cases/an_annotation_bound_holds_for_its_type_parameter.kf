// `T` stands for `Point` here, which does not implement `Shown`.

struct Point {
    val x: int32
}

trait Shown {
    fun show(): int32
}

annotation <T: Shown> shown on (&T) -> int32

@shown
fun peek(p: &Point): int32 { return p.x }

fun main(): int32 { return 0 }
