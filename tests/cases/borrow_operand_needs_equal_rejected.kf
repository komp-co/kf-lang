//! build: fail
//! deps: core
// Two borrows compare their pointees, so the pointee needs `Equal`; there is
// no silent address comparison.

struct P { val x: int32 }

fun same(a: &P, b: &P): bool { return a == b }

fun main(): int32 {
    val p = P { x: 1 }
    if same(&p, &p) { return 0 }
    return 1
}
