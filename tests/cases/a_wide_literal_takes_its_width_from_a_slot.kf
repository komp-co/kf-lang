//! run: exit 0
//! deps: core
// A literal wider than `int32` is fine once something sizes it: an annotation,
// a negation, a cast, a parameter, an assignment target, a first use, or the
// other operand.

fun wide(n: int64): int64 { return n }

fun main(): int32 {
    val a: int64 = 3000000000
    val b: int64 = -3000000000
    val c: int32 = -2147483648
    val d = 3000000000 as int64
    val e = wide(5000000000)
    val f: uint64 = 18446744073709551615
    val g = 4000000000
    val h: int64 = g
    var k: int64 = 0
    k = 7000000000
    val m: int64 = a + 3000000000
    if a + b != 0 { return 1 }
    if d != 3000000000 { return 2 }
    if e != 5000000000 { return 3 }
    if h != 4000000000 { return 4 }
    return c + 2147483647 + 1
}
