//! build: fail
//! deps: core, alloc
// While a view of `text` is still used, `text` may not be changed.

view struct Window {
    val text: str
}

struct Text {
    var bytes: String
}

impl Text {
    fun window(): Window { return Window { text: self.bytes.as_str() } }
    mutating fun grow(): void { self.bytes.append("!") }
}

fun main(): int32 {
    var text = Text { bytes: String.from("hi") }
    val w = text.window()
    text.grow()
    return w.text.byte_len() as int32
}
