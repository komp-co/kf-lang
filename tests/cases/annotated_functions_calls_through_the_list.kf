//! run: exit 1
//! deps: core, alloc
// Each entry carries the function as a value; this one stops the program, so
// the exit code proves it was called.

annotation probe

@probe
fun stop(): void { panic("called through the list") }

fun main(): int32 {
    while entry in &annotated_functions<probe>() {
        entry.function()
    }
    return 0
}
