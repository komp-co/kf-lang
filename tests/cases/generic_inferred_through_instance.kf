//! run: exit 0
//! deps: core, alloc
// A type parameter mentioned only inside another generic still binds from the
// argument, so the call is monomorphized without spelling its type arguments.

import alloc.list.*

fun filter<T, F: Call1<T>>(xs: List<T>, keep: F): List<T> {
    var out = List.new<T>()
    var i: uint64 = 0
    while i < xs.size() {
        if keep.call(*xs.at(i)) {
            out.push(*xs.at(i))
        }
        i = i + 1
    }
    return out
}

fun map_same<T, F: Call1<T>>(xs: List<T>, f: F): List<T> {
    var out = List.new<T>()
    var i: uint64 = 0
    while i < xs.size() {
        out.push(f.call(*xs.at(i)))
        i = i + 1
    }
    return out
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    xs.push(3)

    val zs = filter(xs.clone(), |x: int32| x > 1)
    if zs.size() != 2 { return 1 }
    if zs.get(0) != 2 { return 2 }

    // The lambda captures, so the struct bound to F carries a field.
    val factor: int32 = 10
    val ys = map_same(xs.clone(), |x: int32| x * factor)
    if ys.size() != 3 { return 3 }
    if ys.get(2) != 30 { return 4 }
    return 0
}
