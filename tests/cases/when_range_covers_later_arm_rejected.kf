//! build: fail
// `5` lies inside the earlier `0..10`, so its arm is unreachable.
//
// CONSTRAINT: `build: fail` cannot tell a typecheck diagnostic from a C error,
// so the message is asserted by the kf-typecheck unit test
// `a_value_inside_an_earlier_range_is_covered`.

fun main(): int32 {
    val n = 5
    return when n {
        0..10 => 1
        5 => 2
        _ => 0
    }
}
