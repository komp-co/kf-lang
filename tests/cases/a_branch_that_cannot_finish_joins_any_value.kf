//! run: exit 0
//! deps: core
// A branch whose value is never produced, a call returning an empty enum,
// joins the other branches' type in an `if` or `when` used as a value.

import core.traits.Never

struct Pair {
    val a: int32
    val b: int32
}

fun stop(m: str): Never {
    panic(m)
}

fun code(x: int32): int32 {
    val n = when (x) {
        0 => 10
        1 => 20
        _ => stop("too big")
    }
    return n
}

fun returned(x: int32): int32 {
    return when (x) {
        0 => 5
        _ => stop("not zero")
    }
}

fun half(x: int32): int32 {
    val h = if x % 2 == 0 { x / 2 } else { stop("odd") }
    return h
}

fun pair(x: int32): Pair {
    return if x > 0 { Pair { a: x, b: 2 } } else { stop("not positive") }
}

fun main(): int32 {
    if code(1) != 20 { return 1 }
    if returned(0) != 5 { return 2 }
    if half(8) != 4 { return 3 }
    if pair(3).a != 3 { return 4 }
    return 0
}
