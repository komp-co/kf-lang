//! run: exit 0
//! deps: core
// Refcount glue is emitted under the reserved `kf__` prefix, so a method named
// `retain` does not collide with it. For an enum and a struct.

struct Point { pub var x: int32 }

enum Slot { Held(int32)  Free }

impl Point {
    pub fun retain(): int32 { return self.x + 1 }
}

impl Slot {
    pub fun retain(): int32 { return 5 }
}

fun main(): int32 {
    val p = Point { x: 1 }
    if p.retain() != 2 { return 1 }

    val s = Slot.Held(3)
    if s.retain() != 5 { return 2 }

    // A copy of an owning value runs the glue.
    val q = p
    if q.x != 1 { return 3 }
    return 0
}
