//! run: exit 0
//! deps: core, alloc
// A field read borrows the owning Bag, so passing it to Call1<T> by value
// clones it: the callable and the Bag each drop their own.

pub struct Bag<T> { pub var v: T }

impl Bag<T> {
    pub fun probe<F: Call1<T>>(f: F): F.Out { return f.call(self.v) }
}

fun main(): int32 {
    var bag = Bag<String> { v: String.from("aa") }
    if bag.probe(|s: String| s.byte_len()) != 2 { return 1 }
    return 0
}
