//! run: exit 0
//! deps: core
// `Option<Copyable>` is Clone because `Copyable` is.

@derive(Clone)
struct Copyable { pub var n: int32 }

fun dup<T: Clone>(v: &T): T { return v.clone() }

fun main(): int32 {
    val o: Option<Copyable> = Copyable { n: 4 }
    val p = dup<Option<Copyable>>(&o)
    return when p {
        Some(c) => c.n - 4
        None => 1
    }
}
