//! run: exit 42
//! deps: core
// `M: I` holds a value of whatever integer type `I` is, and each pair of
// arguments is its own instance: `Residue<int32, 7>` and `Residue<int64, -3>`.

struct Residue<I: Integer, M: I> {
    val value: I
}

impl<I: Integer, M: I> Residue<I, M> {
    fun modulus(): I { return M }
}

fun wrap<I: Integer, M: I>(v: I): Residue<I, M> {
    return Residue<I, M> { value: v % M }
}

fun main(): int32 {
    val small = wrap<int32, 7>(12)
    val negative = wrap<int64, -3>(10)
    if small.value != 5 || small.modulus() != 7 { return 1 }
    if negative.value != 1 || negative.modulus() != -3 { return 2 }
    return 42
}
