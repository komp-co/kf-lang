//! run: exit 7
// An associated type read through a borrow, on a target with instantiations
// of two traits: `&Cell<T>.Out` resolves through the enclosing impl as the
// by-value form does. An index trait needs this spelling.
pub struct Cell<T> { pub var v: T }

pub trait ByValue { type Out  fun get_val(): Out }
pub trait ByRef   { type Out  fun get_ref(): &Out }

impl ByValue for Cell<T> {
    type Out = T
    fun get_val(): T { return self.v }
}

impl ByRef for Cell<T> {
    type Out = T
    fun get_ref(): &T { return &self.v }
}

fun main(): int32 {
    var c = Cell<int32> { v: 5 }
    return c.get_val() + *c.get_ref() - 3
}
