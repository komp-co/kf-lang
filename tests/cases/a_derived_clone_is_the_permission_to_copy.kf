//! run: exit 0
//! deps: core, alloc
// `a_copy_needs_the_authors_permission` with the permission granted: the
// inserted copy is deep, and the container keeps an intact element.

import alloc.string.*

@derive(Clone)
pub struct Shared { pub var name: String }

fun consume(s: Shared): uint64 { return s.name.byte_len() }

fun main(): int32 {
    var xs = List.new<Shared>()
    xs.push(Shared { name: String.from("copy me") })

    if consume(*xs.at(0)) != 7 { return 1 }
    // The read above copied rather than moved.
    if !xs.at(0).name.as_str().equals("copy me") { return 2 }
    return 0
}
