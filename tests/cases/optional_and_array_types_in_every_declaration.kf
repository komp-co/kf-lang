//! run: exit 0
//! deps: core, alloc
// `T?` and `T[N]` written in each kind of declaration: a function, a struct,
// an enum payload, an extern, an impl, a trait and its impl.
import core.assert.assert_eq

struct Slot {
    val first: int32?
    val three: int32[3]
}

enum Found {
    Hit(int32?)
    Miss
}

extern "C" fun abs(n: int32): int32

trait Picks {
    fun pick(i: int32): int32?
}

struct Shelf {
    val items: int32[3]
}

impl Picks for Shelf {
    fun pick(i: int32): int32? {
        if i < 0 || i > 2 { return null }
        return self.items[i]
    }
}

impl Slot {
    fun first_or(fallback: int32): int32 {
        val f: int32? = self.first
        return f ?: fallback
    }
}

fun found(f: Found): int32 {
    return when (f) {
        Hit(v) => v ?: -1
        Miss => -2
    }
}

fun main(): int32 {
    val slot = Slot { first: null, three: [1, 2, 3] }
    assert_eq(slot.first_or(7), 7, "an impl method's `int32?`")
    assert_eq(slot.three[2], 3, "a struct's `int32[3]`")
    assert_eq(found(Found.Hit(4)), 4, "an enum payload's `int32?`")
    val shelf = Shelf { items: [5, 6, 7] }
    assert_eq(shelf.pick(1) ?: 0, 6, "a trait impl's `int32?`")
    assert_eq(shelf.pick(9) ?: 0, 0, "and its null")
    assert_eq(unsafe { abs(-3) }, 3, "an extern beside them")
    return 0
}
