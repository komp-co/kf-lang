//! run: exit 0
//! deps: core, alloc
// An arm binding one owning payload and declining the other: lowering names
// the declined one, so the arm's frame releases it.
import core.assert.*

pub struct Tracked {
    var counter: Ptr<int32>
}

impl Drop for Tracked {
    fun drop(): void {
        unsafe { *self.counter = *self.counter + 1 }
    }
}

pub enum Pair {
    Both(Tracked, Tracked)
    Neither
}

fun new_counter(): Ptr<int32> {
    val p: Ptr<int32> = unsafe { alloc_array<int32>(1) }
    unsafe { *p = 0 }
    return p
}

fun partial_arm(c: Ptr<int32>): void {
    val p = Pair.Both(Tracked { counter: c }, Tracked { counter: c })
    val out = when (p) {
        Both(a, _) => a
        Neither => Tracked { counter: c }
    }
}

fun main(): int32 {
    val c = new_counter()
    partial_arm(c)
    // Two Tracked went in, so exactly two drops must come out.
    assert(unsafe { *c } == 2, "both payloads dropped exactly once")
    return 0
}
