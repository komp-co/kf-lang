//! run: exit 0
//! deps: core, alloc
// `p = joined(p.as_str(), "komp")` reads `p` before replacing it, so the old
// value must not be dropped before the right-hand side runs. The leak is kept
// in preference to the use-after-free.

fun joined(a: str, b: str): String {
    var out = String.from(a)
    out.append(b)
    return out
}

fun main(): int32 {
    var p = String.from("compiler/")
    p = joined(p.as_str(), "komp")
    if !p.as_str().equals("compiler/komp") { return 1 }
    // Twice: the second overwrites a value produced by a self-reading RHS.
    p = joined(p.as_str(), "/src")
    if !p.as_str().equals("compiler/komp/src") { return 2 }
    return 0
}
