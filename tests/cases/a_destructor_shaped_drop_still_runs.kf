//! run: exit 0
//! deps: core, alloc
// A method with the destructor's shape, `fun drop(): void`, is the destructor
// and runs at scope exit. The counter is a `Ptr<int32>`, since the value is
// going away.

struct Counted { pub var counter: Ptr<int32> }

impl Counted {
    pub fun drop(): void {
        unsafe { *self.counter = *self.counter + 1 }
    }
}

fun scope(c: Ptr<int32>): void {
    val held = Counted { counter: c }
    // Read, so the binding is not pruned early.
    if unsafe { *held.counter } < 0 { return }
}

fun main(): int32 {
    val c: Ptr<int32> = unsafe { alloc<int32>() }
    unsafe { *c = 0 }
    if unsafe { *c } != 0 { return 1 }
    scope(c)
    // The destructor ran when `held` went out of scope.
    if unsafe { *c } == 0 { return 2 }
    return 0
}
