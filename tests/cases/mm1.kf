//! run: exit 0
//! deps: core, alloc
// Auto-clone: `Owned` is move-only (Drop frees its 1-byte buffer). Reading it
// through a borrow into a by-value sink is a move-out-of-borrow, repaired
// with a clone and a warning.
//
// The clone must be deep, and only the author can write it: a derived one
// would copy the `data` pointer. Reading `xs.at(0)` after the sink ran shows
// it is deep. Fields are read rather than methods on `at()` receivers.

extern "C" fun free(p: Ptr<uint8>): void
extern "C" fun runtime_println(s: str): void

pub struct Owned {
    var data: Ptr<uint8>
    var v: uint8
}

impl Owned {
    pub static fun make(v: uint8): Owned {
        val p: Ptr<uint8> = unsafe { alloc_array<uint8>(1) }
        unsafe { *(p + 0) = v }
        return Owned { data: p, v: v }
    }
}

impl Drop for Owned {
    fun drop(): void { unsafe { free(self.data) } }
}

// A `drop` freeing a raw pointer has no derivable Clone; only the author knows
// the size.
impl Clone for Owned {
    fun clone(): Owned {
        val p: Ptr<uint8> = unsafe { alloc_array<uint8>(1) }
        unsafe { *(p + 0) = *(self.data + 0) }
        return Owned { data: p, v: self.v }
    }
}

// By-value move-sink: takes ownership of `o`, drops it at scope end.
fun sink(o: Owned): uint8 { return unsafe { *(o.data + 0) } }

// Borrow sink (control): takes `&Owned`, never consumes -> no clone, no warning.
fun sink_ref(o: &Owned): uint8 { return unsafe { *((*o).data + 0) } }

fun main(): void {
    var xs = List.new<Owned>()
    xs.push(Owned.make(7))

    // A move-out-of-borrow, wrapped as sink(Owned_clone(...)).
    val r = sink(*xs.at(0))
    if r == 7 { runtime_println("sink read 7 OK") } else { runtime_println("FAIL sink-read") }

    // A borrow sink: no clone, no warning.
    val r2 = sink_ref(xs.at(0))
    if r2 == 7 { runtime_println("sink_ref read 7 OK") } else { runtime_println("FAIL ref-read") }

    runtime_println("ALL OK")
    // xs drops its own buffer; the sink dropped a clone's.
}
