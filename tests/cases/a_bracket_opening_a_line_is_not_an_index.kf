//! run: exit 0
//! deps: core, alloc
// A `[` opening a line does not subscript the line above: `parse_postfix`
// skips newlines only to reach a `.`. The `[0]` below is a list literal of
// its own; joined to the line above it would read `ys[0]`, an `int32`.


fun main(): int32 {
    var ys = List.new<int32>()
    ys.push(7)
    var a = ys
    [0]
    return a.size() as int32 - 1
}
