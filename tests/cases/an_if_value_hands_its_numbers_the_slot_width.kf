//! run: exit 0
//! deps: core
// Bare numbers in `if` branches and `when` arms stay open until the slot they
// fill picks a width: an annotation, a return type, an assignment target, or
// the other operand.

fun pick(n: int32): int64 {
    return when (n) {
        0 => 3000000000
        _ => 1
    }
}

fun main(): int32 {
    val c = true
    val x: uint64 = if c { 9223372036854775807 } else { 1 }
    val y: int64 = if c { 3000000000 } else { 2 }
    val z: int64 = when (1) {
        1 => 3000000000
        _ => 2
    }
    var r: int64 = 0
    r = if c { 3000000000 } else { 1 }
    val s = (if c { 3000000000 } else { 1 }) + r
    if x != 9223372036854775807 { return 1 }
    if y != z { return 2 }
    if pick(0) != y { return 3 }
    if s != 6000000000 { return 4 }
    return 0
}
