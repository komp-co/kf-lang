//! run: exit 42
//! deps: core, alloc
// The origin is frozen only while the borrow is actually live. Each function
// here mutates its origin, and each is legal, because nothing reads the
// borrow afterwards — a whole-scope rule would reject all three.

import alloc.list.*

fun after_last_use(): int32 {
    var text = String.from("ab")
    val view = text.as_str()
    var n = 0
    if view == "ab" { n = 20 }
    text.append("cd")
    return n + (text.len() as int32) - 4
}

fun never_read_again(): int32 {
    var text = String.from("xy")
    val _view = text.as_str()
    text.append("z")
    return (text.len() as int32) + 17
}

fun reads_only(): int32 {
    var text = String.from("hello")
    val view = text.as_str()
    val size = text.len()
    if view == "hello" { return (size as int32) - 3 }
    return 0
}

fun main(): int32 {
    return after_last_use() + never_read_again() + reads_only()
}
