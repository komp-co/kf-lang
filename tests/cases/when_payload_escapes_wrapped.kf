//! run: exit 0
//! deps: core, alloc

// A `when` payload leaving its arm wrapped consumes the subject, so the
// subject does not drop what the arm gave away. Three routes:
//
//   - an explicit `when` arm returning the payload wrapped
//   - `?:`, whose desugar makes the rest of the block the `Some` arm
//   - `?`, whose `Break` arm hands out an owning residual
//
// A `String` payload: a double free aborts, so `exit 0` is the assertion.

import core.option.*
import core.result.*

fun pick(n: int32): String? {
    if n % 2 == 0 { return Option.Some(String.from("heap payload")) }
    return null
}

// Escape through an explicit `when`.
fun via_when(n: int32): String? {
    when (pick(n)) {
        Some(s) => { return Option.Some(s) }
        None => { return null }
    }
    return null
}

// Through `?:`: the wrap happens two statements after the binder.
fun via_elvis(n: int32): String? {
    val s = pick(n) ?: return null
    return Option.Some(s)
}

// Through `?`, on a Result whose error owns heap.
fun rpick(n: int32): Result<String, String> {
    if n % 2 == 0 { return Result.Ok<String, String>(String.from("ok payload")) }
    return Result.Err<String, String>(String.from("bad"))
}

fun via_try(n: int32): Result<String, String> {
    val s = rpick(n)?
    return Result.Ok<String, String>(s)
}

fun main(): int32 {
    val a = via_when(4)
    if a.is_none() { return 1 }
    val astr: String = a.unwrap()
    if astr.byte_len() != 12 { return 2 }
    if via_when(5).is_some() { return 3 }

    val b = via_elvis(4)
    if b.is_none() { return 4 }
    val bstr: String = b.unwrap()
    if bstr.byte_len() != 12 { return 5 }
    if via_elvis(5).is_some() { return 6 }

    when (via_try(4)) {
        Ok(v) => { val vs: String = v
            if vs.byte_len() != 10 { return 7 } }
        Err(_e) => { return 8 }
    }
    // The error survives the bail intact.
    when (via_try(5)) {
        Ok(_v) => { return 9 }
        Err(e) => { val es: String = e
            if es.byte_len() != 3 { return 10 } }
    }
    return 0
}
