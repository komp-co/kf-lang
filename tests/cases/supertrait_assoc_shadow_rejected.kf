//! build: fail
//! deps: core
// Redeclaring an inherited associated type is rejected, not an override: a
// bound on Doubler would make `T.Out` name two things.

trait Producer {
    type Out
    fun make(): int32
}

trait Doubler: Producer {
    type Out
    fun twice(): int32
}

fun main(): int32 { return 0 }
