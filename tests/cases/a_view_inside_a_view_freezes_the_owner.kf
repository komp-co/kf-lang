//! build: fail
//! deps: core, alloc
// A view holding a view borrows what the inner one does.

view struct Window {
    val text: str
}

view struct Frame {
    val inner: Window
}

fun main(): int32 {
    var owned = String.from("hello")
    val w = Window { text: owned.as_str() }
    val f = Frame { inner: w }
    owned.append("!")
    return f.inner.text.byte_len() as int32
}
