// `${self}` inside `Display.display` renders the receiver by calling `display`
// itself.

struct Point { pub val x: int32 }

impl Display for Point {
    fun display(out: &var dyn Write): void { out.write_str("${self}") }
}

fun main(): int32 {
    val a = Point { x: 1 }
    println("${a}")
    return 0
}
