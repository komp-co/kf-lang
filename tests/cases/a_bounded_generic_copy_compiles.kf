//! run: exit 9
//! deps: core, alloc
// The same read with the copy allowed in the signature: a deep copy for
// `T: Clone`, a byte copy for `T: Copy`.


fun cloned_first<T: Clone>(xs: &List<T>): T {
    return *xs.at(0)
}

fun copied_first<T: Copy>(xs: &List<T>): T {
    return *xs.at(0)
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(4)
    var words = List.new<String>()
    words.push(String.from("hello"))
    return cloned_first(&xs) + (cloned_first(&words).byte_len() as int32) - copied_first(&xs) + 4
}
