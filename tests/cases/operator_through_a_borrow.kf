//! run: exit 0
//! deps: core, alloc
// An operator sees through a borrow, so two borrows compare their values, not
// their addresses.

fun eq7(n: &int32): bool { return n == 7 }
fun bump(n: &int32): int32 { return n + 1 }
fun same(a: &int32, b: &int32): bool { return a == b }
fun sum(a: &int32, b: &int32): int32 { return a + b }
fun both(a: &bool, b: bool): bool { return a && b }
fun set_to(n: &var int32): bool { return n == 7 }
// An explicit `*` still means what it always did.
fun eq7_starred(n: &int32): bool { return *n == 7 }

fun main(): int32 {
    val v: int32 = 7
    if !eq7(&v) { return 1 }
    if bump(&v) != 8 { return 2 }

    // Equal values in different variables.
    val x: int32 = 7
    val y: int32 = 7
    if !same(&x, &y) { return 3 }
    val z: int32 = 8
    if same(&x, &z) { return 4 }
    if sum(&x, &z) != 15 { return 5 }

    val t = true
    if !both(&t, true) { return 6 }

    var m: int32 = 7
    if !set_to(&var m) { return 7 }

    // A borrowed owning value is not moved out.
    val s = String.from("ab")
    if !(&s == String.from("ab")) { return 8 }
    if !(&s == String.from("ab")) { return 9 }
    if s.len() != 2 { return 10 }

    if !eq7_starred(&v) { return 11 }
    return 0
}
