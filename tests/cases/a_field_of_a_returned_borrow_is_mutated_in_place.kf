//! run: exit 0
//! deps: core, alloc
// A mutating call on a field of a borrow a call returns reaches the element's
// own field, not a copy.

struct Holder {
    pub var tags: List<String>
    pub var count: int32
}

impl Holder {
    mutating fun bump(): void { self.count = self.count + 1 }
}

struct Outer {
    pub var inner: Holder
}

fun main(): int32 {
    var hs = List.new<Holder>()
    hs.push(Holder { tags: List.new<String>(), count: 0 })
    hs.at_mut(0).tags.push(String.from("x"))
    hs.at_mut(0).tags.push(String.from("y"))
    if hs.at(0).tags.size() != 2 { return 1 }
    if !hs.at(0).tags.at(1).equals("y") { return 2 }

    // A deeper path through the same borrow.
    var os = List.new<Outer>()
    os.push(Outer { inner: Holder { tags: List.new<String>(), count: 0 } })
    os.at_mut(0).inner.bump()
    os.at_mut(0).inner.tags.push(String.from("z"))
    if os.at(0).inner.count != 1 { return 3 }
    if os.at(0).inner.tags.size() != 1 { return 4 }
    return 0
}
