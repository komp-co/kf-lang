//! run: exit 0
//! deps: core
// A bound satisfied by looking through a borrow, `same<T: Equal>` at
// `T = &int32`, adjusts the arguments as well as the receiver:
// `int32_equals(__a, (*(__b)))`. Only the explicit `&int32` type argument
// reaches `same__kf__ref__int32`; inference dissolves the borrow.

fun same<T: Equal>(a: T, b: T): bool {
    return a.equals(b)
}

fun main(): int32 {
    val x = 3
    val y = 3
    val z = 4

    if !same(&x, &y) { return 1 }
    if same(&x, &z) { return 2 }

    if !same<&int32>(&x, &y) { return 3 }
    if same<&int32>(&x, &z) { return 4 }

    return 0
}
