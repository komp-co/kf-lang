//! run: exit 42
//! deps: core, alloc
// A string literal where a `uint8` or `char` array is expected builds it: its
// UTF-8 bytes, or its characters. A `&uint8[]` argument borrows one.

fun total(bytes: &uint8[]): int32 {
    var sum = 0
    while b in bytes { sum = sum + (b as int32) }
    return sum
}

fun main(): int32 {
    val magic: uint8[] = "PNG"
    val fixed: uint8[4] = "abcd"
    val accented: uint8[] = "é"
    val letters: char[] = "héllo"
    if magic.size() != 3 || magic[0] != 80 { return 1 }
    if fixed[3] != 100 { return 2 }
    if accented.size() != 2 || accented[0] != 195 { return 3 }
    if letters.size() != 5 || letters[1] != 'é' { return 4 }
    if total("AB") != 131 { return 5 }
    val text = "plain"
    if text.byte_len() != 5 { return 6 }
    return 42
}
