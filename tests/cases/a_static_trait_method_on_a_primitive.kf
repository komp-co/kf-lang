//! run: exit 0
//! deps: core
// A static trait method on a primitive, as on a user type or type parameter.

fun largest<T: Bounded>(): T { return T.max_value() }

fun main(): int32 {
    if int32.max_value() != 2147483647 { return 1 }
    if uint8.max_value() != 255 { return 2 }
    if int32.zero() != 0 { return 3 }
    if int32.one() != 1 { return 4 }
    if largest<int32>() != int32.max_value() { return 5 }
    if float64.pi() < 3.14 { return 6 }
    return 0
}
