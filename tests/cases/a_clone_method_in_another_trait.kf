//! run: exit 42
//! deps: core
// A method named `clone` in a trait not called `Clone` is called and defined
// under one symbol, `<T>_clone__Dup`, with no `_user` tail appended.

struct Pair<A, B> { pub val a: A  pub val b: B }

trait Dup<A, B> { fun clone(): Pair<A, B> }

impl Dup for Pair<A, B> {
    fun clone(): Pair<A, B> { return Pair<A, B> { a: self.a, b: self.b } }
}

fun main(): int32 {
    val p = Pair<int32, int32> { a: 42, b: 1 }
    val q = p.clone()
    // The universal clone still works beside it: `q` is a real copy.
    if q.b != 1 { return 1 }
    if p.a != 42 { return 2 }
    return q.a
}
