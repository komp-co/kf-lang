//! run: exit 20
// A `when` assigned to an existing binding or field yields the value of an
// arm that ends in an `if`, as a `when` that initializes a binding does.

struct Counter {
    var n: int32
    var seen: int32
}

impl Counter {
    mutating fun step(): bool? {
        self.n = self.n + 10
        return true
    }
    mutating fun read(): int32 { return self.n }
}

fun main(): int32 {
    val flag: bool? = true
    var got = 0
    got = when (flag) {
        Some(ok) => if ok { 10 } else { 0 }
        None => 0
    }
    var c = Counter { n: 0, seen: 0 }
    c.seen = when (c.step()) {
        Some(ok) => if ok { c.read() } else { 0 }
        None => 0
    }
    return got + c.seen
}
