//! run: exit 0
//! deps: core, alloc

// A `when` used as a value works in any position: Lower mints a temporary and
// lifts the `when` statement above the statement it landed in, innermost
// first. `return when (...)` keeps returning from its arms.

import core.option.*

pub struct Holder { pub val text: String  pub val n: int32 }

fun twice(n: int32): int32 { return n * 2 }
fun add(a: int32, b: int32): int32 { return a + b }
fun len_of(s: String): uint64 { return s.byte_len() }

fun step(i: int32): int32? {
    if i < 3 { return Option.Some(i + 1) }
    return null
}

// A `when` value inside a call inside a `return`.
fun f(k: int32): int32 {
    return twice(when (k) {
        1 => 10
        _ => 0
    })
}

fun main(): int32 {
    val o: int32? = Option.Some(21)
    val p: int32? = null

    if f(1) != 20 { return 11 }
    if f(2) != 0 { return 12 }

    // Argument position, then two in one expression.
    if twice(when (o) { Some(v) => v  None => 0 }) != 42 { return 1 }
    if add(when (o) { Some(v) => v  None => 0 },
           when (p) { Some(v) => v  None => 5 }) != 26 { return 2 }

    // One in another's subject, as a `?.` chain has.
    val r = when (when (o) { Some(v) => Option.Some(v + 1)  None => null }) {
        Some(w) => w
        None => 0
    }
    if r != 22 { return 3 }

    // Operand of a binary operator, and an `if` condition.
    if 1 + when (o) { Some(v) => v  None => 0 } != 22 { return 4 }
    if when (o) { Some(v) => v  None => 0 } > 20 { } else { return 5 }

    // A `while` condition re-evaluates, so the hoist stays with the test.
    var i = 0
    var laps = 0
    while when (step(i)) { Some(v) => v  None => 0 } > 0 {
        i = i + 1
        laps = laps + 1
        if laps > 10 { return 6 }
    }
    if i != 3 { return 7 }

    // A move-only value handed out of an arm, in argument and field position.
    val t: String? = Option.Some(String.from("heap payload"))
    if len_of(when (t) { Some(v) => v  None => "" }) != 12 { return 8 }

    val h = Holder {
        text: when (t) { Some(v) => v  None => "" },
        n: when (o) { Some(v) => v  None => 0 }
    }
    if h.n != 21 { return 9 }
    if h.text.byte_len() != 12 { return 10 }

    return 0
}
