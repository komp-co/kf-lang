//! run: exit 3
//! deps: core
// A trait impl over a value parameter names it in its header, where the
// trait-argument and associated-type contexts check it too.

struct Row<T, N: uint64> {
    val first: T
}

impl<T, N: uint64> Index<uint64> for Row<T, N> {
    type Out = T
    fun index(k: uint64): &Self.Out { return &self.first }
}

fun main(): int32 {
    val r = Row<int32, 4> { first: 3 }
    return r[0]
}
