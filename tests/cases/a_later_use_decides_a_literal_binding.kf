//! run: exit 42
//! deps: core, alloc
// An unannotated literal binding stays open until a use needs a type of its
// own, not only its first use: `n + n` works at every width, so `wide(n)`
// decides `n`. A store decides too, and so does a later method call on a
// `List.new()` whose first use said nothing.
import alloc.list.*

fun wide(x: uint64): uint64 { return x * 2 }

fun era_of(year: int64): int64 {
    var era = 0
    era = year / 400
    return era
}

fun main(): int32 {
    val n = 3000000000
    val twice = n + n
    if wide(n) != 6000000000 { return 1 }
    if twice != 6000000000 { return 2 }
    if era_of(2000) != 5 { return 3 }
    var xs = List.new()
    val empty = xs.size()
    xs.push(7)
    if empty != 0 || xs.size() != 1 { return 4 }
    return 42
}
