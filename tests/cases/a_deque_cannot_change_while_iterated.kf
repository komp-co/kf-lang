//! build: fail
//! deps: core, alloc
// A deque's cursor is a view of its buffer: pushing while it is still used
// could move the buffer out from under it, so the push is rejected.
import alloc.deque.*

fun main(): int32 {
    var dq = Deque.new<int32>()
    dq.push_back(1)
    var cursor = dq.iter()
    dq.push_back(2)
    val next = cursor.next()
    return next!!
}
