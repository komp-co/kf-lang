//! run: exit 42
//! deps: core, alloc
// A literal where a type converting from it is expected is converted: a list
// literal through `From<T[N]>`, built as an array first, and a string literal
// through `From<str>`. Argument slots count.

struct Total {
    val sum: int64
}

impl<N: uint64> From<int64[N]> for Total {
    static fun from(items: int64[N]): Total {
        var sum: int64 = 0
        while x in &items { sum = sum + x }
        return Total { sum: sum }
    }
}

struct Name {
    val length: uint64
}

impl From<str> for Name {
    static fun from(text: str): Name { return Name { length: text.byte_len() } }
}

struct Bag<T> {
    val first: T
    val count: uint64
}

impl<T: Copy, N: uint64> From<T[N]> for Bag<T> {
    static fun from(items: T[N]): Bag<T> { return Bag<T> { first: items[0], count: N } }
}

fun weigh(t: Total): int64 { return t.sum }

fun main(): int32 {
    val a: Total = [1, 2, 3]
    val b: Name = "four"
    val c: Bag<uint8> = [7, 8]
    if a.sum != 6 { return 1 }
    if b.length != 4 { return 2 }
    if c.first != 7 || c.count != 2 { return 3 }
    if weigh([10, 20]) != 30 { return 4 }
    return 42
}
