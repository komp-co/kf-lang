//! run: exit 0
//! deps: core

// An enum with no variants, the uninhabited type, emits valid C: it need only
// be nameable, as `Option<Never>` and `Result<Never, E>` require. Not
// `Never`, which core declares.

pub enum Bottom {
}

pub enum MyRes<T, E> {
    Ok(T)
    Err(E)
}

// A Result that can only be an Err.
fun bail(e: int32): MyRes<Bottom, int32> {
    return MyRes.Err<Bottom, int32>(e)
}

fun main(): int32 {
    val r = bail(3)
    when (r) {
        Ok(_v) => { return 1 }
        Err(e) => { if e == 3 { return 0 } }
    }
    return 2
}
