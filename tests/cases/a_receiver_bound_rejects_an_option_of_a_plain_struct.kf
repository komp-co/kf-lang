//! build: fail
//! deps: core, alloc
// `List.contains` lives in `impl List<T: Equal>`, and `Option<Plain>` is
// Equal only if `Plain` is.


struct Plain { pub val n: int32 }

fun main(): int32 {
    var xs = List.new<Option<Plain>>()
    val probe: Option<Plain> = null
    if xs.contains(&probe) { return 1 }
    return 0
}
