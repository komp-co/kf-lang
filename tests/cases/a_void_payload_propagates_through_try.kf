//! run: exit 4
//! deps: core
// `?` on a `Result<void, E>`. The desugar binds the payload:
//
//     kf_unit __payload = Result__void__int32_unwrap(&(*__self));
//
// and a `void` return is C `void`, so the let evaluates the call and yields
// the unit. Decided by the slot's type, not the initializer's shape: by
// codegen the node is no longer a Call.
import core.result.*

fun inner(fail: bool): Result<void, int32> {
    if fail { return Result.Err<void, int32>(9) }
    return Result.Ok<void, int32>()
}

fun outer(fail: bool): Result<void, int32> {
    inner(fail)?
    return Result.Ok<void, int32>()
}

fun main(): int32 {
    var score: int32 = 0
    when (outer(false)) {
        Ok(_u) => { score = score + 1 }
        Err(_e) => { return 90 }
    }
    when (outer(true)) {
        Ok(_u) => { return 91 }
        Err(e) => { score = score + e - 6 }
    }
    return score
}
