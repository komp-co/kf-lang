//! run: exit 23
//! deps: core
// `Make<T[2]>` and `Make<T[3]>` are different instantiations: the length is
// part of the trait argument, in the method signature it requires and in the
// dispatch that picks the impl.

struct Bag<T> {
    val count: uint64
}

trait Make<X> {
    static fun make(value: X): Self
}

impl<T> Make<T[2]> for Bag<T> {
    static fun make(value: T[2]): Bag<T> { return Bag<T> { count: 2 } }
}

impl<T> Make<T[3]> for Bag<T> {
    static fun make(value: T[3]): Bag<T> { return Bag<T> { count: 3 } }
}

fun main(): int32 {
    val two: int64[2] = [4, 5]
    val three: int64[3] = [4, 5, 6]
    val a = Bag.make<int64>(two)
    val b = Bag.make<int64>(three)
    return (a.count * 10 + b.count) as int32
}
