//! run: exit 5
//! deps: core, alloc

// A `List<Box<T>>`'s element is a `Box`, not a struct named after its mangled
// spelling: a `Box` binder pushes onto it, and a clone of the list copies
// each pointee.

pub struct Item {
    var n: int32
}

pub enum Slot {
    Full(Box<Item>),
    Empty
}

fun make(n: int32): Slot { return Slot.Full(Box.new(Item { n: n })) }

fun collect(n: int32): List<Box<Item>> {
    var out = List.new<Box<Item>>()
    when (make(n)) {
        Full(b) => out.push(b)
        Empty => { }
    }
    return out
}

fun main(): int32 {
    val got = collect(4)
    val copy = got.clone()
    return got.size() as int32 + copy.at(0).n
}
