//! run: exit 0
//! deps: core, alloc
// Use-after-move auto-clone. `Owned` is move-only through its `Box` field.
// Rebinding it in value context twice, then thrice, clones every consume but
// the last, so each binding owns its own box, freed once.
//
// CONSTRAINT: the work runs in void functions falling off the end: drops
// after a trailing `return` would be unreachable and hide the result.
extern "C" fun runtime_println(s: str): void

pub struct Owned {
    var data: Box<uint8>
}

impl Owned {
    pub static fun make(v: uint8): Owned {
        return Owned { data: Box.new(v) }
    }
}

// Borrow sink: reads the boxed byte without consuming.
fun peek(o: &Owned): uint8 { return unsafe { *((*o).data) } }

fun two_uses(): void {
    val x = Owned.make(7)
    val a = x          // first rebind  -> auto-cloned (x reused below)
    val b = x          // second rebind -> moves the original
    val s = peek(a) + peek(b)
    if s == 14 { runtime_println("two_uses 14 OK") } else { runtime_println("FAIL two_uses") }
    // a and b drop here (deep boxes, each freed once).
}

fun three_uses(): void {
    val x = Owned.make(5)
    val a = x          // cloned
    val b = x          // cloned
    val c = x          // moves
    val s = peek(a) + peek(b) + peek(c)
    if s == 15 { runtime_println("three_uses 15 OK") } else { runtime_println("FAIL three_uses") }
    // a, b, c drop here.
}

fun main(): void {
    two_uses()
    three_uses()
    runtime_println("ALL OK")
}
