//! run: exit 0
//! deps: core, alloc

// `a ?: D`: the payload, or a default. It is
//
//     when (a) { Some(__elv0) => __elv0  None => D }
//
// in expression position; the `None` arm takes the first arm's type.

import core.option.*

fun half(n: int32): int32? {
    if n % 2 == 0 { return Option.Some(n / 2) }
    return null
}

fun fallback(): int32 { return 99 }

fun twice(n: int32): int32 { return n * 2 }

fun name_of(id: int32): String? {
    if id == 1 { return Option.Some(String.from("ada")) }
    return null
}

fun main(): int32 {
    // Present: the payload, not the default.
    val n = half(8) ?: 0
    if n != 4 { return 1 }

    // Absent: the default.
    val m = half(7) ?: 0
    if m != 0 { return 2 }

    // An expression, evaluated only when absent.
    val e = half(7) ?: fallback()
    if e != 99 { return 3 }

    // The payload type, not an Option.
    val sum = (half(8) ?: 0) + (half(7) ?: 10)
    if sum != 14 { return 4 }

    // Move-only: taken from `Some` without the subject dropping it too.
    val s = name_of(1) ?: String.from("unknown")
    if !s.as_str().equals("ada") { return 5 }
    val t = name_of(2) ?: String.from("unknown")
    if !t.as_str().equals("unknown") { return 6 }

    // `var` binds an ordinary local here.
    var v = half(8) ?: 0
    v = v + 1
    if v != 5 { return 7 }

    // Argument position.
    if twice(half(7) ?: 5) != 10 { return 8 }

    // Right-associative: `a ?: b ?: c` is `a ?: (b ?: c)`.
    val chain = half(7) ?: half(9) ?: 11
    if chain != 11 { return 9 }

    // The diverging form still binds through the arm, with no temporary.
    val d = half(6) ?: return 10
    if d != 3 { return 11 }

    return 0
}
