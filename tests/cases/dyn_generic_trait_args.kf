//! run: exit 42

trait Sink<T> {
    fun accept(value: T): int32
}

struct Receiver { pub val base: int32 }

impl Sink<int32> for Receiver {
    fun accept(value: int32): int32 { return self.base + value }
}

impl Sink<str> for Receiver {
    fun accept(value: str): int32 {
        if value.equals("ok") { return self.base + 2 }
        return 0
    }
}

fun accept_number(receiver: &dyn Sink<int32>): int32 {
    return receiver.accept(20)
}

fun accept_text(receiver: &dyn Sink<str>): int32 {
    return receiver.accept("ok")
}

fun main(): int32 {
    val receiver = Receiver { base: 10 }
    return accept_number(receiver) + accept_text(receiver)
}
