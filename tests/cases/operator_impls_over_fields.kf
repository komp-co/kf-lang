//! run: exit 0
//! deps: core, alloc
// Operators written over fields inside `equals` and friends are accepted: the
// spelling the self-recursion diagnostic recommends.

struct Point { pub val x: int32 }

// `self.p == other.p` calls `Point.equals` from `Pair.equals`: not recursion.
// A check keyed on types would reject it.
struct Pair { pub val p: Point }

impl Equal for Point {
    fun equals(other: &Point): bool { return self.x == other.x }
}

impl Compare for Point {
    fun compare(other: &Point): int32 {
        if self.x < other.x { return 0 - 1 }
        if self.x > other.x { return 1 }
        return 0
    }
}

impl Display for Point {
    fun display(out: &var dyn Write): void { out.write_str("${self.x}") }
}

impl Equal for Pair {
    fun equals(other: &Pair): bool { return self.p == other.p }
}

impl Point {
    // `self == other` outside `equals` is an ordinary call.
    pub fun same_as(other: Point): bool { return self == other }
}

fun main(): int32 {
    val a = Point { x: 1 }
    val b = Point { x: 2 }
    if a == b { return 1 }
    if !(a < b) { return 2 }
    if !"${a}".as_str().equals("1") { return 3 }
    val pa = Pair { p: a }
    val pb = Pair { p: b }
    if pa == pb { return 4 }
    if !(pa == Pair { p: Point { x: 1 } }) { return 5 }
    if a.same_as(b) { return 6 }
    if !a.same_as(Point { x: 1 }) { return 7 }
    return 0
}
