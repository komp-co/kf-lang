//! run: exit 0
//! deps: core, alloc
// Wrapping a call payload in `Option.Some` clears the payload's own callee
// annotations from the rewritten node, so it is not emitted as
// `String_from(String_from(..))`.

fun from_static_call(flag: bool): String? {
    if flag { return String.from("heap payload") }
    return null
}

fun make(): String {
    return String.from("made")
}

fun from_plain_call(flag: bool): String? {
    if flag { return make() }
    return null
}

fun from_literal(flag: bool): String? {
    if flag { return "literal" }
    return null
}

fun scalar(flag: bool): int32? {
    if flag { return 7 }
    return null
}

fun main(): int32 {
    // The payload survives the rewrite.
    when (from_static_call(true)) {
        Some(s) => { if s != "heap payload" { return 1 } }
        None => return 2
    }
    when (from_plain_call(true)) {
        Some(s) => { if s != "made" { return 3 } }
        None => return 4
    }
    when (from_literal(true)) {
        Some(s) => { if s != "literal" { return 5 } }
        None => return 6
    }
    when (scalar(true)) {
        Some(n) => { if n != 7 { return 7 } }
        None => return 8
    }

    // The None arms construct a real Option.None.
    if from_static_call(false).is_some() { return 9 }
    if scalar(false).is_some() { return 10 }
    return 0
}
