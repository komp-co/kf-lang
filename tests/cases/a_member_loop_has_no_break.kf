//! build: fail
//! deps: core, alloc
// A member loop is written out once per field, so `break` would leave
// whatever loop surrounds the template's code.

annotation first_only on struct

template first_only on struct T {
    fun T.first_name(): String {
        var out = String.from("")
        while field in T.fields {
            out = field.name
            break
        }
        return out
    }
}

@first_only
struct Pair {
    val a: int32
    val b: int32
}

fun main(): int32 { return 0 }
