//! run: exit 0
//! deps: core, alloc
// A function value's parameters keep their passing modes: a borrow stays
// borrowed, and an owned String is handed over and comes back.

fun length(s: &String): uint64 { return s.len() }
fun shout(s: String): String { return s + "!" }

fun main(): int32 {
    val measure: (&String) -> uint64 = length
    val text = String.from("abc")
    if measure(&text) != 3 { return 1 }
    if text.len() != 3 { return 2 }
    val loud: (String) -> String = shout
    val said = loud(String.from("hey"))
    if said.as_str() != "hey!" { return 3 }
    return 0
}
