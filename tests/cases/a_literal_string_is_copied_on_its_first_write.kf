//! run: exit 0
//! deps: core, alloc

// A literal kept as a `String` points at the literal until its first write,
// which copies it; reads, clones, moves and drops never touch the literal.


struct Named {
    val name: String
}

fun shout(s: String): String {
    var out = s
    out.append("!")
    return out
}

fun main(): int32 {
    val n = Named { name: "lit" }
    var s: String = "two"
    val copy = s.clone()
    s.append(" three")
    s.push('x')
    var e: String = ""
    e.append("grown")
    var c: String = "cleared"
    c.clear()
    c.append("new")
    var self_append: String = "ab"
    self_append.append(self_append.as_str())
    val loud = shout("hey")
    var names = List.new<String>()
    names.push("in a list")
    val all = "${n.name}|${s}|${copy}|${e}|${c}|${self_append}|${loud}|${names.at(0)}"
    if all != "lit|two threex|two|grown|new|abab|hey!|in a list" { return 1 }
    return 0
}
