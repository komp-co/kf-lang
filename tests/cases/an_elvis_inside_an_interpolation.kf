//! run: exit 0
//! deps: core, alloc
// `${n ?: 0}` shows the elvis's value: the whole value becomes the trait
// object, not each of its branches.

fun describe(n: uint64?): String {
    return "${n ?: 0}"
}

fun main(): int32 {
    if describe(3) != String.from("3") { return 1 }
    if describe(null) != String.from("0") { return 2 }
    return 0
}
