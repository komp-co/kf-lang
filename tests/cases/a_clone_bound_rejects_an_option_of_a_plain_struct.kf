//! build: fail
//! deps: core
// `impl Clone for Option<T: Clone>` grants nothing at `T = Unique`.
//
// CONSTRAINT: `build: fail` cannot tell a typecheck diagnostic from a C error,
// so the rule is asserted by the kf-typecheck unit test
// `an_argument_missing_the_impls_bound_fails`.

struct Unique { pub var n: int32 }

fun dup<T: Clone>(v: &T): T { return v.clone() }

fun main(): int32 {
    val o: Option<Unique> = Unique { n: 1 }
    val p = dup<Option<Unique>>(&o)
    return 0
}
