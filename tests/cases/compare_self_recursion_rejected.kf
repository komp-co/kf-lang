//! build: fail
//! deps: core
// `<` inside `Compare.compare` desugars to the method being defined, as `==`
// inside `equals` does.

struct Point { pub val x: int32 }

impl Compare for Point {
    fun compare(other: &Point): int32 {
        if self < other {
            return 0 - 1
        }
        return 1
    }
}

fun main(): int32 {
    val a = Point { x: 1 }
    val b = Point { x: 2 }
    if a < b { return 1 }
    return 0
}
