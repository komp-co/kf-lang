//! run: exit 42
//! deps: alloc, core
// The iteration protocol through the real libs: `Iterable` declares
// `type Iter: Iterator<T>` and `List` binds it to `ListIter<T>`. The binding
// specializes once per element type.

fun sum_first<C: Iterable<int32>>(items: C): int32 {
    var iter = items.iter()
    val first = iter.next()
    val second = iter.next()
    var total: int32 = 0
    when (first) {
        Some(v) => total = total + v
        _ => total = total + 0
    }
    when (second) {
        Some(v) => total = total + v
        _ => total = total + 0
    }
    return total
}

fun main(): int32 {
    var values = List.new<int32>()
    values.push(40)
    values.push(2)
    return sum_first<List<int32>>(values)
}
