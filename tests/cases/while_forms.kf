//! run: exit 0
//! deps: core, alloc
// `while` takes a condition or an iteration header, told apart by a name
// followed by `in`: `in` is reserved, so no condition begins that way.


extern "C" fun runtime_println(s: str): void

fun main(): int32 {
    // condition
    var n = 0
    while n < 3 { n = n + 1 }
    if n != 3 { return 1 }

    // range, exclusive upper bound
    var sum = 0
    while i in 0..4 { sum = sum + i }
    if sum != 6 { return 2 }

    // collection
    var xs = List.new<int32>()
    xs.push(10)
    xs.push(20)
    var total = 0
    while x in xs { total = total + x }
    if total != 30 { return 3 }
    if xs.size() != 2 { return 4 }

    // `while true`, and break out of it
    var k = 0
    while true {
        k = k + 1
        if k > 2 { break }
    }
    if k != 3 { return 5 }

    // break and continue in the range form
    var seen = 0
    while i in 0..10 {
        if i == 2 { continue }
        if i == 5 { break }
        seen = seen + i
    }
    if seen != 8 { return 6 }

    // nested forms, each with its own loop variable
    var pairs = 0
    while a in 0..3 {
        while b in 0..2 { pairs = pairs + a + b }
    }
    if pairs != 9 { return 7 }

    // an identifier starting with `in` is not an iteration header
    var index = 0
    while index < 2 { index = index + 1 }
    if index != 2 { return 8 }

    runtime_println("ok")
    return 0
}
