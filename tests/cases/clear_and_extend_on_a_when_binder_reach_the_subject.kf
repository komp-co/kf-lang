//! run: exit 0
//! deps: core, alloc

// Every `mutating` List method makes a `when` binder the payload itself,
// whichever `impl` block declares it: `clear` and `extend` as well as `push`.

pub enum Kind {
    Many(List<int32>),
    None
}

pub struct Holder {
    var kind: Kind
}

mutating fun Holder.cleared(): void {
    when (self.kind) {
        Many(xs) => xs.clear()
        None => { }
    }
}

mutating fun Holder.extended(): void {
    when (self.kind) {
        Many(xs) => xs.extend([7, 8])
        None => { }
    }
}

fun Holder.size(): uint64 {
    return when (self.kind) {
        Many(xs) => xs.size()
        None => 0
    }
}

fun main(): int32 {
    var h = Holder { kind: Kind.Many([1, 2, 3]) }
    h.cleared()
    if h.size() != 0 { return 1 }
    h.extended()
    if h.size() != 2 { return 2 }
    return 0
}
