//! run: exit 0
//! deps: core
// `(0..5).chain(8..10)` visits 0-4 and 8-9; no segment covers 6 and 7.
//
// Imports are explicit: `core.range` is auto-imported only by the `..`
// operator.

import core.range.*

fun count(c: Chain<RangeIter<int32>, RangeIter<int32>, int32>): int32 {
    var n: int32 = 0
    var guard: int32 = 0
    while _v in c {
        n = n + 1
        guard = guard + 1
        if guard > 100 { return -1 }
    }
    return n
}

fun total(c: Chain<RangeIter<int32>, RangeIter<int32>, int32>): int32 {
    var n: int32 = 0
    while v in c { n = n + v }
    return n
}

fun main(): int32 {
    // Order, position by position; a sum would pass a reversed chain.
    var i: int32 = 0
    while v in (0..3).chain(8..10) {
        if i == 0 && v != 0 { return 1 }
        if i == 2 && v != 2 { return 2 }
        if i == 3 && v != 8 { return 3 }
        if i == 4 && v != 9 { return 4 }
        i = i + 1
    }
    if i != 5 { return 5 }

    // The gap itself.
    var saw_gap: bool = false
    while v in (0..5).chain(8..10) {
        if v == 6 { saw_gap = true }
        if v == 7 { saw_gap = true }
    }
    if saw_gap { return 6 }
    if count((0..5).chain(8..10)) != 7 { return 7 }

    // Each segment keeps its own step, direction and inclusivity.
    if total((0..10).by(5).chain(range_inclusive(20, 21, 1))) != 46 { return 8 }
    if count((0..2).chain(range(9, 6, 1).down())) != 5 { return 9 }

    // An empty segment contributes nothing without stopping the other.
    if total((5..5).chain(1..4)) != 6 { return 10 }
    if total((1..4).chain(5..5)) != 6 { return 11 }
    if count((3..3).chain(3..3)) != 0 { return 12 }

    // A third segment: `Chain` nests over any two iterators.
    var outer = Chain<Chain<RangeIter<int32>, RangeIter<int32>, int32>, RangeIter<int32>, int32> {
        first: (0..3).chain(8..10), second: (15..17).iter(), on_first: true
    }
    var n: int32 = 0
    var sum: int32 = 0
    while v in outer {
        n = n + 1
        sum = sum + v
    }
    if n != 7 { return 13 }
    if sum != 51 { return 14 }
    return 0
}
