//! run: exit 0
//! deps: core
// `n..0` runs zero times; `down()` travels downward without swapping the
// endpoints, so `(0..10).down()` is empty.
//
// The last two cases count down to 0 over a `uint8`, where one step below 0
// would wrap to 255.
//
// The import is explicit: `core.range` is auto-imported only by `..`.

import core.range.*

fun descending_sum(): int32 {
    var total: int32 = 0
    while v in range(5, 0, 1).down() { total = total + v }
    return total
}

fun descending_inclusive_count(): int32 {
    var n: int32 = 0
    while _v in range_inclusive(5, 0, 1).down() { n = n + 1 }
    return n
}

fun descending_stride(): int32 {
    var total: int32 = 0
    while v in range(10, 0, 3).down() { total = total + v }
    return total
}

fun down_does_not_swap(): int32 {
    var n: int32 = 0
    while _v in range(0, 10, 1).down() { n = n + 1 }
    return n
}

fun down_to_zero_unsigned(): int32 {
    var n: int32 = 0
    while _b in range_inclusive(3 as uint8, 0 as uint8, 1 as uint8).down() {
        n = n + 1
        if n > 100 { break }
    }
    return n
}

fun down_past_zero_unsigned(): int32 {
    var n: int32 = 0
    while _b in range_inclusive(5 as uint8, 0 as uint8, 2 as uint8).down() {
        n = n + 1
        if n > 100 { break }
    }
    return n
}

fun main(): int32 {
    if descending_sum() != 15 { return 1 }            // 5 4 3 2 1
    if descending_inclusive_count() != 6 { return 2 } // 5 4 3 2 1 0
    if descending_stride() != 22 { return 3 }         // 10 7 4 1
    if down_does_not_swap() != 0 { return 4 }
    if down_to_zero_unsigned() != 4 { return 5 }      // 3 2 1 0
    if down_past_zero_unsigned() != 3 { return 6 }    // 5 3 1
    return 0
}
