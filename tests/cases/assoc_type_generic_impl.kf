//! run: exit 7
// The binding comes from a generic impl: `type Out = T` is `int32` in the
// `Wrap__int32` instance. Owner and choice are both pinned by
// materialization.
trait Producer {
    type Out
}

struct Wrap<T> { pub val v: T }

impl Producer for Wrap<T> {
    type Out = T
}

fun grab<C: Producer>(c: C): C.Out {
    return 7
}

fun main(): int32 {
    val w = Wrap<int32> { v: 1 }
    return grab<Wrap<int32>>(w)
}
