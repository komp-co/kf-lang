//! build: fail
// An instance of a generic view is a view too.

@view
struct Cursor<T> {
    val first: &T
}

struct Pair {
    var left: int32
}

impl Pair {
    fun cursor(): Cursor<int32> { return Cursor<int32> { first: &self.left } }
    mutating fun bump(): void { self.left = self.left + 1 }
}

fun main(): int32 {
    var p = Pair { left: 1 }
    val c = p.cursor()
    p.bump()
    return *c.first
}
