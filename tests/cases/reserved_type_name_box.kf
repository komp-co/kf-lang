//! build: fail
// `Box<T>` is a builtin; every annotation resolves to the owning heap pointer,
// so declaring the name is an error.
struct Box<T> { pub val v: T }

fun unwrap_it(b: Box<int32>): int32 {
    return b.v
}

fun main(): int32 {
    val b = Box<int32> { v: 7 }
    return unwrap_it(b)
}
