//! run: exit 1
//! deps: core
// A generic call whose argument has a callable's output type, `F.Out`, is
// instantiated once the callable is known.

fun smaller<K: Compare>(a: &K, b: &K): bool { return a.compare(b) < 0 }

fun first_key_smaller<F: Call1<int32>>(key: F): bool {
    val a = key.call(1)
    val b = key.call(2)
    return smaller(&a, &b)
}

fun main(): int32 {
    return if first_key_smaller(|x: int32| x * 10) { 1 } else { 0 }
}
