//! run: exit 0
//! deps: core, alloc
// A generic returning `Option<&T>` gives the `when` binder a type: the
// instance `Option__kf__ref__String` is decoded from its own mangle. A method
// call on the binder needs that type to dispatch.
//
// CONSTRAINT: nothing here writes `Option<&T>` concretely: a written type
// materializes its own layout and would pass without the decode.
import core.assert.*

pub struct Holder {
    var n: int32
}

impl Holder {
    fun value(): int32 {
        return self.n
    }
}

// `&T` under a generic container, in a return type no call site writes.
fun first_of<T>(xs: &List<T>): Option<&T> {
    if xs.size() == 0 { return Option.None }
    return Option.Some(xs.at(0))
}

// (A) A foreign payload, `String`, with `as_str`.
fun a_foreign_payload(): void {
    var xs = List.new<String>()
    xs.push(String.from("alpha"))
    when (first_of(&xs)) {
        Some(v) => assert(v.as_str().equals("alpha"), "A: read a String through the borrow")
        None => assert(false, "A: the list has an element")
    }
}

// (B) A local payload: its method is found by name and the receiver must be
// adjusted.
fun a_local_payload(): void {
    var xs = List.new<Holder>()
    xs.push(Holder { n: 7 })
    when (first_of(&xs)) {
        Some(v) => assert(v.value() == 7, "B: read a local struct through the borrow")
        None => assert(false, "B: the list has an element")
    }
}

// (C) The empty list takes the None arm.
fun no_payload_to_borrow(): void {
    val xs = List.new<String>()
    when (first_of(&xs)) {
        Some(_) => assert(false, "C: the list is empty")
        None => assert(true, "C: None on an empty list")
    }
}

fun main(): int32 {
    a_foreign_payload()
    a_local_payload()
    no_payload_to_borrow()
    return 0
}
