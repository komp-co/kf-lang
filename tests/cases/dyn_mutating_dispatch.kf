//! run: exit 42

trait Counter {
    mutating fun bump(): int32
}

struct Value { pub var amount: int32 }

impl Counter for Value {
    mutating fun bump(): int32 {
        self.amount = self.amount + 1
        return self.amount
    }
}

fun bump(value: &var dyn Counter): int32 {
    return value.bump()
}

fun main(): int32 {
    var value = Value { amount: 41 }
    return bump(value)
}
