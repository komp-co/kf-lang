//! run: exit 0
//! deps: core, alloc
// Shadowing: alpha_rename gives each shadowing binding a fresh name, so the C
// has no duplicate declarations and moves and drops are per binding. Each
// String drops once under ASan.
import alloc.list.*

fun consume(s: String): bool { return s.equals("two") }

fun main(): int32 {
    // Same-block shadow of a move-only type: two live `a`s, both dropped once.
    val a = String.from("one")
    val a = String.from("two")
    if !a.equals("two") { return 1 }

    // Cross-block shadow: the outer `n` is unaffected.
    var n = 0
    if true {
        val n = 99
        if n != 99 { return 2 }
    }
    if n != 0 { return 3 }

    // The shadowing binding moves into a sink.
    if !consume(a) { return 4 }

    return 0
}
