//! run: exit 0
//! deps: core, alloc
// `fun Receiver.name()` is called as a method of the receiver, or as a
// function taking the receiver first. Receivers may be a struct, a number,
// `str`, a specific `List<Point>`, a generic `List<T>` whose `T` the receiver
// introduces, or a bare parameter; a `mutating` one borrows mutably.


struct Point {
    val x: int32
    val y: int32
}

struct Counter {
    var n: int32
}

fun Point.sum(): int32 {
    return self.x + self.y
}

fun int32.twice(): int32 {
    return self * 2
}

fun str.shout_len(): uint64 {
    return self.byte_len() + 1
}

fun List<Point>.area(): int32 {
    var total = 0
    var i: uint64 = 0
    while i < self.size() {
        total = total + self.at(i).x * self.at(i).y
        i = i + 1
    }
    return total
}

fun <T: Copy> List<T>.second_or(fallback: T): T {
    if self.size() < 2 { return fallback }
    return *self.at(1)
}

fun T.tagged(tag: int32): int32 {
    return tag
}

mutating fun Counter.bump(by: int32): void {
    self.n = self.n + by
}

fun make_point(): Point {
    return Point { x: 1, y: 2 }
}

fun main(): int32 {
    val p = Point { x: 2, y: 3 }
    if p.sum() != 5 { return 1 }
    if 4.twice() != 8 { return 2 }
    if "abc".shout_len() != 4 { return 3 }
    var ps = List.new<Point>()
    ps.push(Point { x: 2, y: 3 })
    ps.push(Point { x: 1, y: 4 })
    if ps.area() != 10 { return 4 }
    if area(&ps) != 10 { return 5 }
    var xs = List.new<int32>()
    xs.push(7)
    xs.push(9)
    if xs.second_or(0) != 9 { return 6 }
    var c = Counter { n: 1 }
    c.bump(4)
    if c.n != 5 { return 7 }
    if make_point().sum() != 3 { return 8 }
    val r = &p
    if r.sum() != 5 { return 9 }
    if p.tagged(11) != 11 { return 10 }
    if String.from("hey").tagged(12) != 12 { return 11 }
    return 0
}
