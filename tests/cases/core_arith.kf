//! run: exit 0
//! deps: core
// A struct implementing Add/Sub/Mul/Div/Mod works with + - * / %, each
// dispatching to its impl. `(a + b) * b` takes an rvalue left operand.
// Primitives use core's impls too.
extern "C" fun runtime_println(s: str): void

pub struct V2 {
    var x: int32
    var y: int32
}

impl Add for V2 { fun add(o: &V2): V2 { return V2 { x: self.x + o.x, y: self.y + o.y } } }
impl Sub for V2 { fun sub(o: &V2): V2 { return V2 { x: self.x - o.x, y: self.y - o.y } } }
impl Mul for V2 { fun mul(o: &V2): V2 { return V2 { x: self.x * o.x, y: self.y * o.y } } }
impl Div for V2 { fun div(o: &V2): V2 { return V2 { x: self.x / o.x, y: self.y / o.y } } }
impl Mod for V2 { fun mod(o: &V2): V2 { return V2 { x: self.x % o.x, y: self.y % o.y } } }

fun ck(v: V2, ex: int32, ey: int32, m: str): void {
    if v.x == ex {
        if v.y == ey {
            runtime_println(m)
            return
        }
    }
    runtime_println("FAIL")
}

fun main(): void {
    val a = V2 { x: 10, y: 20 }
    val b = V2 { x: 3, y: 4 }
    ck(a + b, 13, 24, "add OK")
    ck(a - b, 7, 16, "sub OK")
    ck(a * b, 30, 80, "mul OK")
    ck(a / b, 3, 5, "div OK")
    ck(a % b, 1, 0, "mod OK")
    ck((a + b) * b, 39, 96, "chain OK")
    if 2 + 3 * 4 == 14 { runtime_println("prim OK") } else { runtime_println("FAIL prim") }
    runtime_println("ALL OK")
}
