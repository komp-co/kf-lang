//! run: exit 0
//! deps: core
// `@allow` is the built-in a method may carry, on an impl's method and on a
// trait's.

trait Shown {
    @allow(unused_import)
    fun show(): int32
}

struct Counter {
    val n: int32
}

impl Counter {
    @allow(unused_import)
    fun tick(): int32 { return self.n }
}

impl Shown for Counter {
    @allow(unused_import)
    fun show(): int32 { return self.n }
}

fun main(): int32 {
    val c = Counter { n: 0 }
    return c.tick() + c.show()
}
