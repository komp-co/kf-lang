//! build: fail
//! deps: core, alloc
// `any` hands each `int32` element over by value, so a parameter written
// `&int32` implements a `Call` trait the call never asks for.
//
// CONSTRAINT: `build: fail` cannot tell a typecheck diagnostic from a C error,
// so the message is asserted by the kf-typecheck unit test
// `a_written_param_the_bound_disagrees_with_is_reported`.


fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(7)
    if xs.any(|n: &int32| *n == 7) { return 0 }
    return 1
}
