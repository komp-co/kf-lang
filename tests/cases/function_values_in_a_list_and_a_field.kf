//! run: exit 0
//! deps: core, alloc
// Function values stored in a list, an optional and a struct field; a field
// holding one is called like a method.
import alloc.list.*

fun double(x: int32): int32 { return x * 2 }
fun inc(x: int32): int32 { return x + 1 }

struct Handler {
    val on: (int32) -> int32
}

fun main(): int32 {
    var ops = List.new<(int32) -> int32>()
    ops.push(double)
    ops.push(inc)
    var total = 0
    while i in 0..ops.size() {
        val op = ops.get(i)
        total = total + op(10)
    }
    if total != 31 { return 1 }
    val handler = Handler { on: double }
    if handler.on(8) != 16 { return 2 }
    val maybe: ((int32) -> int32)? = inc
    val chosen = maybe ?: double
    if chosen(1) != 2 { return 3 }
    return 0
}
