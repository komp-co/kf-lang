//! run: exit 0
//! deps: core
// A trait method returning a generic instance, dispatched dynamically: the
// vtable slot `Option__int32 (*produce)(void *)` needs the instance declared
// where the vtable struct lands.

extern "C" fun runtime_println(s: str): void

trait Producer {
    fun produce(): int32?
}

struct Empty { pub var n: int32 }
struct Full  { pub var n: int32 }

impl Producer for Empty {
    fun produce(): int32? { return null }
}

impl Producer for Full {
    fun produce(): int32? { return self.n }
}

fun total(p: &dyn Producer): int32 {
    return when (p.produce()) {
        Some(n) => n
        None    => 0
    }
}

fun main(): int32 {
    var e = Empty { n: 7 }
    var f = Full { n: 5 }
    if total(&e) != 0 { return 1 }
    if total(&f) != 5 { return 2 }
    runtime_println("ok")
    return 0
}
