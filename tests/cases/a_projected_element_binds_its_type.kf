//! run: exit 2
//! deps: core

struct Odd { }
impl Call1<int32> for Odd {
    type Out = bool
    fun call(a: int32): bool { return a % 2 == 1 }
}

struct Counter { pub var n: int32  pub var stop: int32 }
impl Iterator<int32> for Counter {
    mutating fun next(): int32? {
        if self.n >= self.stop { return null }
        self.n = self.n + 1
        return self.n
    }
}

struct MapIter<I, F> { pub var inner: I  pub var f: F }
impl Iterator<F.Out> for MapIter<I: Iterator<int32>, F: Call1<int32>> {
    mutating fun next(): F.Out? {
        val x = self.inner.next() ?: return null
        return self.f.call(x)
    }
}

impl Counter {
    pub fun map<F: Call1<int32>>(f: F): MapIter<Counter, F> { return MapIter { inner: self, f: f } }
}

fun main(): int32 {
    var m = Counter { n: 0, stop: 3 }.map(Odd { })
    var odd = 0
    while true {
        val is_odd: bool = m.next() ?: break
        if is_odd { odd = odd + 1 }
    }
    return odd
}
