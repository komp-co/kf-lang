//! run: exit 0
//! deps: core, alloc
// The accepted half of by_value_param_mutable_borrow_rejected: `&var` all the
// way down, and the caller sees the push.


fun inner(l: &var List<int32>): void {
    l.push(1)
}

fun outer(xs: &var List<int32>): void {
    inner(xs)
}

fun main(): int32 {
    var l = List.new<int32>()
    outer(&var l)
    if l.size() != 1 { return 1 }
    return 0
}
