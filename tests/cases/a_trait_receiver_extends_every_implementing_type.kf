//! run: exit 0
//! deps: core, alloc
// `fun Iterable<Point>.total_x()` extends every type implementing
// `Iterable<Point>`, and `fun Iterable<T>.count_all()` every iterable, its `T`
// read off the receiver's impl. A type-parameter value reaches extensions
// through its bounds.

import alloc.list.*

struct Point { val x: int32 }

trait Loud { fun volume(): int32 }
impl Loud for Point { fun volume(): int32 { return 4 } }

fun Iterable<Point>.total_x(): int32 {
    var t = 0
    var it = self.iter()
    while true {
        val p = it.next() ?: break
        t = t + p.x
    }
    return t
}

fun Iterable<T>.count_all(): int32 {
    var n = 0
    var it = self.iter()
    while true {
        val _item = it.next() ?: break
        n = n + 1
    }
    return n
}

// `while x in self` iterates through the bound.
fun Iterable<int32>.sum(): int32 {
    var t = 0
    while x in self { t = t + x }
    return t
}

// A trait receiver whose arguments are all types beats one generic in them.
fun Iterable<Point>.which(): int32 { return 1 }
fun Iterable<T>.which(): int32 { return 2 }

// A trait receiver beats a bare parameter.
fun Loud.twice(): int32 { return self.volume() * 2 }
fun T.twice(): int32 { return 1 }

fun T.describe(): int32 { return 10 }
fun <T: Loud> T.level(): int32 { return self.volume() }

fun wrap<U>(u: &U): int32 { return u.describe() }
fun loud<V: Loud>(v: &V): int32 { return v.level() + v.describe() }
fun sum_of<C: Iterable<Point>>(c: &C): int32 { return c.total_x() }

fun main(): int32 {
    var ps = List.new<Point>()
    ps.push(Point { x: 2 })
    ps.push(Point { x: 5 })
    var xs = List.new<int32>()
    xs.push(1)
    val p = Point { x: 1 }
    if ps.total_x() != 7 { return 1 }
    if ps.count_all() != 2 || xs.count_all() != 1 { return 2 }
    if ps.which() != 1 || xs.which() != 2 { return 3 }
    if p.twice() != 8 || 3.twice() != 1 { return 4 }
    if wrap(&p) != 10 || loud(&p) != 14 || sum_of(&ps) != 7 { return 5 }
    if total_x(&ps) != 7 { return 6 }
    xs.push(4)
    if xs.sum() != 5 { return 7 }
    return 0
}
