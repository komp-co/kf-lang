//! build: fail
//! deps: core
// `impl Show for NoSuchThing` is resolved and reported, and `impl Show for
// Other` naming a trait implements nothing and is reported. A trait impl for a
// foreign type is allowed.

trait Show { fun show(): int32 }
trait Other { fun other(): int32 }

impl Show for NoSuchThing {
    fun show(): int32 { return 1 }
}

impl Show for Other {
    fun show(): int32 { return 2 }
}

fun main(): int32 { return 0 }
