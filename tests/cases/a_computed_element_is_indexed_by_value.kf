//! run: exit 42
//! deps: core, alloc
// A type whose elements are computed implements `IndexValue`, and `a[i]` is
// the element itself: a bit has no address to lend. It reads through a borrow
// of the container too.

struct Bits {
    var words: List<uint64>
}

impl IndexValue<uint64> for Bits {
    type Out = bool
    fun index_value(k: uint64): bool {
        return ((self.words.get(k / 64) >> (k % 64)) & 1) == 1
    }
}

fun main(): int32 {
    var words = List.new<uint64>()
    words.push(5)
    val bits = Bits { words: words }
    if !bits[0] { return 1 }
    if bits[1] { return 2 }
    val third: bool = bits[2]
    if !third { return 3 }
    val borrowed = &bits
    if !borrowed[2] { return 4 }
    return 42
}
