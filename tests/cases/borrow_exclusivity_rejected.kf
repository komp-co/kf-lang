//! build: fail
//! deps: core, alloc
// One call may not lend the same place twice if either lending is mutable.
// The callee receives two references it is entitled to treat as independent,
// and writing through one while reading the other is where aliasing
// corruption comes from.
//
// Overlap is containment over access paths, so `pair` conflicts with
// `pair.left` while `pair.left` and `pair.right` are disjoint. A path reached
// through a method is the receiver's, index and all, so two elements of one
// container conflict.
//
// `disjoint_fields`, `both_shared` and `separate_owners` are the shapes that
// stay legal.


struct Pair { pub var left: String, pub var right: String }
struct Nest { pub var inner: Pair }

fun edit_both(x: &var String, y: &var String): void { x.append("a") }
fun edit_and_read(x: &var String, y: &String): void { x.append("a") }
fun read_both(x: &String, y: &String): void { }
fun edit_pair(p: &var Pair, y: &String): void { }

fun lent_mutably_twice(): int32 {
    var p = Pair { left: String.from("l"), right: String.from("r") }
    edit_both(&var p.left, &var p.left)
    return 0
}

fun written_and_read(): int32 {
    var p = Pair { left: String.from("l"), right: String.from("r") }
    edit_and_read(&var p.left, &p.left)
    return 0
}

fun whole_and_part(): int32 {
    var p = Pair { left: String.from("l"), right: String.from("r") }
    edit_pair(&var p, &p.left)
    return 0
}

fun nested_same_place(): int32 {
    var n = Nest { inner: Pair { left: String.from("l"), right: String.from("r") } }
    edit_and_read(&var n.inner.left, &n.inner.left)
    return 0
}

// Two elements of one container: indices are not compared.
fun two_elements_of_one_list(): int32 {
    var xs = List.new<String>()
    xs.push(String.from("a"))
    xs.push(String.from("b"))
    edit_and_read(xs.at_mut(0), xs.at(1))
    return 0
}

fun disjoint_fields(): int32 {
    var p = Pair { left: String.from("l"), right: String.from("r") }
    edit_both(&var p.left, &var p.right)
    return 0
}

fun both_shared(): int32 {
    var p = Pair { left: String.from("l"), right: String.from("r") }
    read_both(&p.left, &p.left)
    return 0
}

fun separate_owners(): int32 {
    var a = Pair { left: String.from("l"), right: String.from("r") }
    var b = Pair { left: String.from("l"), right: String.from("r") }
    edit_and_read(&var a.left, &b.left)
    return 0
}

fun main(): int32 {
    return 0
}
