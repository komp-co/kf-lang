//! run: exit 0
//! deps: core, alloc
// A derived enum reached through a `T: Clone` bound has a symbol to call. The
// `String` payload makes the copy deep.

import alloc.string.*

@derive(Clone)
pub enum Message {
    Text(String)
    Silence
}

fun duplicate<T: Clone>(v: &T): T { return v.clone() }

fun main(): int32 {
    val original = Message.Text(String.from("hello"))
    val copy = duplicate(&original)

    when (copy) {
        Text(s) => { if !s.as_str().equals("hello") { return 1 } }
        Silence => return 2
    }
    // The original is untouched.
    when (original) {
        Text(s) => { if !s.as_str().equals("hello") { return 3 } }
        Silence => return 4
    }
    return 0
}
