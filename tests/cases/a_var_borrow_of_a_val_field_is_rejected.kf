//! build: fail
//! deps: core
// `&var s.inner` would let `poke` write a `val` field.

struct Inner {
    var k: int32
}

struct S {
    pub val inner: Inner
}

fun make(): S {
    return S { inner: Inner { k: 1 } }
}

fun poke(i: &var Inner): void { i.k = 5 }

fun main(): int32 {
    var s = make()
    poke(&var s.inner)
    return 0
}
