//! build: fail
//! deps: core
// A reference points at a live value; a raw pointer may not. Passing one as
// the other is written `&*p` inside `unsafe`.

struct Cell {
    pub var v: int32
}

fun read(c: &Cell): int32 {
    return c.v
}

fun main(): int32 {
    val p: Ptr<Cell> = unsafe { alloc<Cell>() }
    unsafe { *p = Cell { v: 1 } }
    return read(p)
}
