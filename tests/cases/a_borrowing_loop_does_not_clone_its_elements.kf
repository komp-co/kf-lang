//! run: exit 0
//! deps: core, alloc
// `while x in &xs` binds a borrow of each element through `next_ptr()`, with
// no clone and no drop; `while x in xs` binds a deep-cloned value.

import alloc.list.*

/// The address of a `str`'s bytes: a borrowed element shares the source's
/// buffer, a cloned one has its own.
fun addr_of(s: str): uint64 {
    return unsafe { s as uint64 }
}

fun total_len(xs: &List<String>): uint64 {
    var total = 0
    while s in &xs {
        total = total + s.byte_len()
    }
    return total
}

fun main(): int32 {
    var xs = List.new<String>()
    xs.push(String.from("alpha"))
    xs.push(String.from("beta"))
    xs.push(String.from("gamma"))

    if total_len(&xs) != 14 { return 1 }

    // The binder IS the element, not a copy of it.
    val src = addr_of(xs.at(0).as_str())
    var shared = 0
    while s in &xs {
        if addr_of(s.as_str()) == src { shared = shared + 1 }
    }
    if shared != 1 { return 20 }

    // The by-value form deep-clones, so it shares nothing.
    var cloned_shared = 0
    while s in xs {
        if addr_of(s.as_str()) == src { cloned_shared = cloned_shared + 1 }
    }
    if cloned_shared != 0 { return 21 }

    // The source list still owns its elements.
    if total_len(&xs) != 14 { return 2 }
    if xs.size() != 3 { return 3 }
    if xs.at(0).byte_len() != 5 { return 4 }
    if xs.at(2).byte_len() != 5 { return 5 }

    // A method on the borrowed binder, and the binder lent onward.
    var starts = 0
    while s in &xs {
        if s.as_str().starts_with("a") { starts = starts + 1 }
    }
    if starts != 1 { return 6 }

    // Primitives take the same path.
    var ns = List.new<uint64>()
    ns.push(2)
    ns.push(40)
    var sum = 0
    while n in &ns {
        sum = sum + n
    }
    if sum != 42 { return 7 }

    // The by-value form still binds a value, and still works.
    var owned = 0
    while s in xs {
        owned = owned + s.byte_len()
    }
    if owned != 14 { return 8 }
    if xs.size() != 3 { return 9 }
    return 0
}
