//! deps: core
// A `&dyn Trait` parameter of a trait method, reached by writing `&concrete`
// at the call: dispatch accepts the unsizing coercion.

pub trait Sink {
    mutating fun write_str(s: str): void
    fun written(): uint64
}

pub trait Show {
    fun show(out: &var dyn Sink): void
    fun measure(out: &dyn Sink): uint64
}

struct Counter { pub var n: uint64 }

impl Sink for Counter {
    mutating fun write_str(s: str): void { self.n = self.n + s.byte_len() }
    fun written(): uint64 { return self.n }
}

struct Vec2 { pub val x: int32  pub val y: int32 }

impl Show for Vec2 {
    fun show(out: &var dyn Sink): void {
        out.write_str("(")
        out.write_str("12")
        out.write_str(", ")
        out.write_str("5")
        out.write_str(")")
    }
    // A shared trait object reads as a mutable one writes.
    fun measure(out: &dyn Sink): uint64 { return out.written() * 2 }
}

fun main(): int32 {
    var c = Counter { n: 0 }
    val v = Vec2 { x: 12, y: 5 }
    v.show(&var c)                      // 7 bytes: "(12, 5)"
    val doubled = v.measure(&c)         // 14
    return (c.n + doubled + 5) as int32 // 26
}
