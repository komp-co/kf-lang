//! run: exit 0

// A `static fun` declaring type parameters of its own. The type's arguments
// and the method's share one written list; the definition is
// `B_show__int32`, and unwritten parameters are inferred.

import core.display.*

struct B { pub val n: int32 }

impl B {
    // Bounded, by reference, and it uses the bound.
    pub static fun of<T: Display>(v: &T): String {
        var out = String.from("")
        v.display(&var out)
        return out
    }
    // Unbounded and by value.
    pub static fun keep<T>(v: T): int32 { return 1 }
}

struct Holder<T> { pub val item: T }

impl Holder<T> {
    // No parameters of its own.
    pub static fun wrap(v: T): Holder<T> { return Holder<T> { item: v } }
    // Both halves at once: `T` is the type's, `U` the method's.
    pub static fun tag<U: Display>(v: T, u: &U): String {
        var out = String.from("")
        u.display(&var out)
        return out
    }
}

fun main(): int32 {
    // Inferred from the argument.
    if !B.of(&(7)).as_str().equals("7") { return 1 }
    // A second instantiation of the same method.
    if !B.of(&(true)).as_str().equals("true") { return 2 }
    // Written out.
    val big: int64 = 1234567890123
    if !B.of<int64>(&big).as_str().equals("1234567890123") { return 3 }
    // Unbounded, by value, two instantiations.
    if B.keep(9) + B.keep(false) != 2 { return 4 }
    // A static on a generic type, unchanged.
    val h = Holder.wrap<int32>(41)
    if h.item != 41 { return 5 }
    // The type's parameter and the method's own, in one written list.
    if !Holder.tag<int32, bool>(1, &(false)).as_str().equals("false") { return 6 }
    return 0
}
