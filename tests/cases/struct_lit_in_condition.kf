//! run: exit 0
//! deps: core
// A struct literal inside an if/while condition: `no_struct_lit` makes the
// trailing `{` open the body, but inside parentheses a `{` can only be a
// literal.

struct Node { pub val v: int32 }

fun take_node(n: Node): int32 { return n.v }
fun wrap(n: Node): Node { return n }

fun main(): int32 {
    if take_node(Node { v: 7 }) != 7 { return 1 }
    if take_node(wrap(Node { v: 7 })) != 7 { return 2 }
    var i: int32 = 0
    while i < take_node(Node { v: 3 }) { i = i + 1 }
    if i != 3 { return 3 }
    // The flag still protects the top level of a condition.
    val cond = true
    if cond { return 0 }
    return 4
}
