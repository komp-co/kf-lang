//! run: exit 0
// An inherent method on a generic struct resolves however many type
// parameters the struct has: the receiver arrives mangled (`Pair__int32__bool`)
// while the method is registered once, under the template name.

struct Pair<A, B> {
    pub var a: A
    pub var b: B
}

impl Pair<A, B> {
    pub fun first(): &A { return &self.a }
    pub fun second(): &B { return &self.b }
    pub mutating fun replace_first(v: A): void { self.a = v }
}

fun main(): int32 {
    var p = Pair<int32, bool> { a: 7, b: true }
    if *p.first() != 7 { return 1 }
    if !*p.second() { return 2 }
    p.replace_first(9)
    if *p.first() != 9 { return 3 }

    // A nested argument stays one argument, not two.
    val q = Pair<Pair<int32, bool>, int32> { a: p, b: 4 }
    if *q.second() != 4 { return 4 }
    if *q.first().first() != 9 { return 5 }
    return 0
}
