//! run: exit 101
//! deps: core, alloc

// A field read and written through `&var Box<T>` goes through both pointers:
// the borrow, then the box.

struct Tracked {
    var n: int32
}

fun set(b: &var Box<Tracked>): void {
    val before = b.n
    b.n = before + 100
}

fun main(): int32 {
    var b = Box.new(Tracked { n: 1 })
    set(&var b)
    return b.n
}
