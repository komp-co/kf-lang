//! run: exit 0
//! deps: core, alloc

// An enum constructor's payload is a move sink. A move-only value read out of
// a struct field is cloned into it, as for a struct literal field, rather
// than the struct being partially moved.

import core.option.*

struct Leaf {
    val n: int32
    val tag: String
}

enum Holder {
    Empty
    Full(String)
}

fun main(): int32 {
    // core's Option, the shape `?.` generates.
    val l = Leaf { n: 5, tag: String.from("leaf") }
    val k: String? = Option.Some(l.tag)
    // Bound, not used as a temporary.
    val kv = k!!
    if !kv.as_str().equals("leaf") { return 1 }
    // The struct keeps its own copy.
    if !l.tag.as_str().equals("leaf") { return 2 }

    // A user enum, with no core involved.
    val l2 = Leaf { n: 6, tag: String.from("held") }
    val h = Holder.Full(l2.tag)
    when (h) {
        Full(s) => { if !s.as_str().equals("held") { return 3 } }
        Empty => return 4
    }
    if !l2.tag.as_str().equals("held") { return 5 }

    // The other sinks, so a fix breaking one fails here.
    val l3 = Leaf { n: 7, tag: String.from("third") }
    val bound = l3.tag
    if !bound.as_str().equals("third") { return 6 }

    val l4 = Leaf { n: 8, tag: String.from("fourth") }
    if takes(l4.tag) != 6 { return 7 }

    // A plain variable payload still moves rather than cloning.
    val owned = String.from("moved")
    val m: String? = Option.Some(owned)
    val mv = m!!
    if !mv.as_str().equals("moved") { return 8 }

    return 0
}

fun takes(s: String): int32 { return s.as_str().byte_len() as int32 }
