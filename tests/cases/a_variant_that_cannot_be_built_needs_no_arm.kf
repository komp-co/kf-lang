//! run: exit 7
//! deps: core
// A variant whose payload has no values cannot be built, so a `when` need
// not name it: `Ok` of a `Result<Never, E>`, or a variant holding an empty
// enum.

import core.traits.Never

enum Halt { }

enum Shape {
    Circle(int32)
    Stuck(Halt)
}

fun widen<E>(r: Result<Never, E>): Result<bool, E> {
    when (r) {
        Err(e) => { return Result.Err<bool, E>(e) }
    }
}

fun area(s: Shape): int32 {
    return when (s) {
        Circle(r) => r * r * 3
    }
}

fun main(): int32 {
    val r = widen<int32>(Result.Err<Never, int32>(4))
    val code = when (r) {
        Ok(_b) => 1
        Err(e) => e
    }
    return code + area(Shape.Circle(1))
}
