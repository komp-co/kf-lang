//! build: fail
// `Ptr<T>` is a builtin resolving to `T*`, so declaring the name is an error.
// An enum, for the other declaration form.
enum Ptr<T> {
    Here(T)
    Nowhere
}

fun main(): int32 {
    val p = Ptr.Here(1)
    when (p) {
        Here(n) => return n
        Nowhere => return 0
    }
}
