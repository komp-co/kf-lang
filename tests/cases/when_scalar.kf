//! run: exit 0
//! deps: core, alloc
// `when` over a non-enum subject: each literal arm selects its own `case`, and
// `_` catches the rest.

extern "C" fun runtime_println(s: str): void

fun pick(i: uint64): str {
    when (i) {
        0 => return "zero"
        1 => return "one"
        2 => return "two"
        _ => return "many"
    }
}

// Booleans reach codegen as the integers C compares them as.
fun answer(b: bool): str {
    when (b) {
        true => return "yes"
        false => return "no"
    }
}

fun check(got: str, want: str, label: str): void {
    if got.equals(want) { runtime_println(label) } else { runtime_println("FAIL") }
}

fun main(): void {
    check(pick(0), "zero", "case 0 OK")
    check(pick(1), "one", "case 1 OK")
    check(pick(2), "two", "case 2 OK")
    check(pick(9), "many", "default OK")
    check(answer(true), "yes", "true OK")
    check(answer(false), "no", "false OK")
    runtime_println("ALL OK")
}
