//! run: exit 0
//! deps: core, alloc
// `v.display()` with no sink renders any `Display` value as a `String`: a
// primitive, a user type, a bounded parameter. A type's own `display()` keeps
// precedence, and the trait's form still takes a sink.

struct P { val n: int32 }

impl Display for P {
    fun display(out: &var dyn Write): void { out.write_str("p") }
}

struct Q { val n: int32 }

impl Q {
    fun display(): String { return String.from("own") }
}

fun shout<T: Display>(v: T): String {
    return v.display()
}

fun main(): int32 {
    val p = P { n: 1 }
    val u: uint32 = 233
    val v: int64 = -5
    val w: uint64 = 42
    if !p.display().as_str().equals("p") { return 1 }
    if !u.display().as_str().equals("233") { return 2 }
    if !'A'.display().as_str().equals("A") { return 3 }
    if !v.display().as_str().equals("-5") { return 4 }
    if !w.display().as_str().equals("42") { return 5 }
    if !true.display().as_str().equals("true") { return 6 }
    var s = String.from("")
    p.display(&var s)
    if !s.as_str().equals("p") { return 7 }
    val q = Q { n: 1 }
    if !q.display().as_str().equals("own") { return 8 }
    if !shout(7).as_str().equals("7") { return 9 }
    return 0
}
