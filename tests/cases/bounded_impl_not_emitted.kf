//! run: exit 0
//! deps: core, alloc

// A bounded impl is emitted only for instances satisfying the bound:
// `Wrap<int32>` gets no `clone`, since `int32`'s would be undefined.

struct Wrap<T> { val v: T }

// `String` implements Clone, `int32` does not — so only one of the two
// instances below may carry this impl.
impl Clone for Wrap<T: Clone> {
    fun clone(): Wrap<T> { return Wrap<T> { v: self.v.clone() } }
}

fun main(): int32 {
    // Fails the bound: its layout is emitted, the impl is not.
    val a = Wrap<int32> { v: 5 }
    if a.v != 5 { return 1 }

    // The instance that does satisfy it.
    val b = Wrap<String> { v: String.from("ada") }
    if !b.v.as_str().equals("ada") { return 2 }

    return 0
}
