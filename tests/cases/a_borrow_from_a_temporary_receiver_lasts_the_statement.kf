//! run: exit 15
//! deps: core
// A borrow a method returns from a temporary receiver stays valid for the
// rest of the statement.

fun low(): int32[2] { return [7, 1] }

fun high(): int32[2] { return [2, 8] }

fun add(a: &int32, b: &int32): int32 { return *a + *b }

fun main(): int32 {
    return add(low().at(0), high().at(1))
}
