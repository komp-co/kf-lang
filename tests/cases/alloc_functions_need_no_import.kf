//! run: exit 0
//! deps: core, alloc
// alloc's public functions need no import, like its types. Nothing here is
// imported.

fun main(): int32 {
    val parts = "a,b,c".split(",")
    if parts.size() != 3 { return 1 }
    val joined = (&parts).join("-")
    if !joined.as_str().equals("a-b-c") { return 2 }
    val greeting = "joined ${joined.as_str()}"
    if !greeting.as_str().equals("joined a-b-c") { return 3 }
    return 0
}
