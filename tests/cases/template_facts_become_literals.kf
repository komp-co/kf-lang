//! run: exit 0
//! deps: core, alloc
// Each fact is a literal in the code a template adds, and a condition on
// facts alone keeps only the branch taken for each field.

annotation described(prefix: String) on struct
annotation hidden on field
annotation caption(text: String) on field

template described on struct T {
    fun T.describe(): String {
        var out = "${args.prefix}${T.name}/${T.fields.size()}:"
        while field in T.fields {
            if !field.has<hidden>() {
                val shown = if field.has<caption>() { field.get<caption>().text } else { field.name }
                out.append(" ${field.index}=${shown}")
            }
        }
        return out
    }

    fun T.first_value(): int32 {
        while field in T.fields {
            when field.index {
                0 => {
                    val copy: field.type = self.$field
                    return copy
                }
                _ => {}
            }
        }
        return -1
    }
}

@described("s:")
struct Secret {
    val id: int32
    @caption("who")
    val name: String
    @hidden
    val key: String
}

fun main(): int32 {
    val s = Secret { id: 7, name: "ann", key: "k" }
    if s.describe() != "s:Secret/3: 0=id 1=who" { return 1 }
    if s.first_value() != 7 { return 2 }
    return 0
}
