// A field initialized twice is an error: which wins is not the language's to
// decide, and matching fields to initializers would come up short.
pub struct Pair {
    pub val first: int32
    pub val second: int32
}

fun main(): int32 {
    val p = Pair { first: 1, first: 99, second: 2 }
    return p.first
}
