//! run: exit 0
//! deps: core, alloc
// `A | B =>` shares one body between alternatives: variants, integers, chars,
// strings and ranges, with or without a guard, as a statement or a value.

enum Op {
    Plus
    Minus
    Star
    Slash
}

// Every variant is named, so no `_` is needed.
fun precedence(op: Op): int32 {
    return when op {
        Plus | Minus => 1
        Star | Slash => 2
    }
}

fun through_borrow(op: &Op): int32 {
    when op {
        Plus | Minus => return 1
        _ => return 2
    }
    return 9
}

fun is_vowel(c: char): bool {
    return when c {
        'a' | 'e' | 'i' | 'o' | 'u' => true
        _ => false
    }
}

fun small(n: int32, loud: bool): int32 {
    return when n {
        1 | 2 | 3 if loud => 10
        1 | 2 | 3 => 1
        0..5 | 9 => 2
        _ => 3
    }
}

fun verb(s: String): int32 {
    return when s {
        "get" | "head" => 1
        "put" | "post" if s.byte_len() == 4 => 2
        "put" => 3
        _ => 0
    }
}

fun both(b: bool): int32 {
    return when b {
        true | false => 7
    }
}

fun main(): int32 {
    if precedence(Op.Minus) != 1 { return 1 }
    if precedence(Op.Slash) != 2 { return 2 }
    val star = Op.Star
    if through_borrow(&star) != 2 { return 3 }
    if !is_vowel('o') { return 4 }
    if is_vowel('x') { return 5 }
    if small(2, true) != 10 { return 6 }
    if small(2, false) != 1 { return 7 }
    if small(4, true) != 2 { return 8 }
    if small(9, false) != 2 { return 9 }
    if small(5, false) != 3 { return 10 }
    if verb(String.from("head")) != 1 { return 11 }
    if verb(String.from("post")) != 2 { return 12 }
    if verb(String.from("put")) != 3 { return 13 }
    if verb(String.from("delete")) != 0 { return 14 }
    if both(false) != 7 { return 15 }
    return 0
}
