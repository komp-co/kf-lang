//! run: exit 0
//! deps: core
// An `if` in value position takes the wider arm's type: 5000000000 is not
// narrowed by an int32 ternary.

fun pick(c: bool): uint64 {
    val big: uint64 = 5000000000
    val v = if c { 0 } else { big }
    return v as uint64
}

fun main(): int32 {
    if pick(false) != 5000000000 { return 1 }
    if pick(true) != 0 { return 2 }
    return 0
}
