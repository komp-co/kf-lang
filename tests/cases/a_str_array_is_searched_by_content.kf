//! run: exit 0
//! deps: core, alloc

// `str` meets `Equal` through the runtime comparison, so the searches over a
// slice of it are instantiated like any other element type's.

import alloc.list.*

val KEYWORDS: str[] = ["fun", "val", "var", "val"]

fun main(): int32 {
    val val_word = "val"
    val missing = "nope"
    if ["clone", "as_str"].contains(&missing) { return 1 }
    if !KEYWORDS.contains(&val_word) { return 2 }
    if (KEYWORDS.index_of(&val_word) ?: 9) != 1 { return 3 }
    if (KEYWORDS.last_index_of(&val_word) ?: 9) != 3 { return 4 }
    val head: str[] = ["fun", "val"]
    if !KEYWORDS.as_slice().starts_with(head.as_slice()) { return 5 }
    var names = List.new<str>()
    names.push("ann")
    val ann = "ann"
    if !names.contains(&ann) { return 6 }
    return 0
}
