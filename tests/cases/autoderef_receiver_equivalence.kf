//! run: exit 42
//! deps: core, alloc
// `x.m()` and `(*x).m()` are the same call and lower the same way:
//
//   - a `get()` through a borrowed receiver is a borrow, not a fresh value
//   - a `Ptr<T>` receiver is passed as the pointer, not its address
//   - consuming such a read is a move out of a borrow, so a copy is inserted

import alloc.list.*

struct Counter { pub var n: int32 }

impl Counter {
    pub mutating fun bump(): void { self.n = self.n + 1 }
    pub fun value(): int32 { return self.n }
}

/// The borrowed receiver reads an element out without taking ownership of it,
/// whichever spelling asks for it.
fun first_copy(xs: &List<String>): String {
    return xs.at(0).clone()
}

fun first_copy_explicit(xs: &List<String>): String {
    return (*xs).at(0).clone()
}

/// A mutating method through a raw pointer must reach the pointee.
fun bumped_through_pointer(): int32 {
    val p: Ptr<Counter> = unsafe { alloc<Counter>() }
    unsafe { *p = Counter { n: 0 } }
    unsafe { (*p).bump() }
    p.bump()
    return unsafe { (*p).value() }
}

/// `+` consumes its right operand, so elements read through a borrowed
/// receiver are copied.
fun joined(path: &List<String>): String {
    var out = ""
    var i: uint64 = 0
    while i < path.size() {
        out = out + *path.at(i)
        i = i + 1
    }
    return out
}

fun main(): int32 {
    var xs = List.new<String>()
    xs.push(String.from("hello"))

    val a = first_copy_explicit(&xs)
    val b = first_copy(&xs)
    // The list still owns its element after both reads.
    if xs.at(0).as_str() != "hello" { return 1 }
    if a.as_str() != "hello" { return 2 }
    if b.as_str() != "hello" { return 3 }

    if bumped_through_pointer() != 2 { return 4 }

    var path = List.new<String>()
    path.push(String.from("aa"))
    path.push(String.from("bb"))
    if joined(&path).as_str() != "aabb" { return 5 }
    // The list still owns both elements after they were joined.
    if path.at(0).as_str() != "aa" { return 6 }
    if path.at(1).as_str() != "bb" { return 7 }

    return 42
}
