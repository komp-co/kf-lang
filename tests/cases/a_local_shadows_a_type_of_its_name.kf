//! run: exit 0
//! deps: core, alloc
// A local named like a type is the local: `shown.size()` calls a method on
// the value, not a static on the struct `shown`.

struct shown {
    val n: int32
}

enum Mode {
    Fast
    Slow
}

struct Holder {
    val size: int32
}

fun main(): int32 {
    val shown = List.new<int32>()
    if shown.size() != 0 { return 1 }
    val Mode = Holder { size: 3 }
    if Mode.size != 3 { return 2 }
    return 0
}
