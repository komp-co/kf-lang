//! run: exit 0
//! deps: core, alloc
// `T` appears only in `C`'s bound; `List<Point>` implements `Iterable<Point>`,
// so `T` is `Point`. A method through the bound over a user type is
// qualified like the impl's definition, and the yielded item keeps its type.


struct Point { val x: int32 }
impl Point { fun get(): int32 { return self.x } }

fun count_all<C: Iterable<T>, T>(c: &C): int32 {
    var n = 0
    var it = c.iter()
    while true {
        val _item = it.next() ?: break
        n = n + 1
    }
    return n
}

fun total_x<C: Iterable<Point>>(c: &C): int32 {
    var t = 0
    var it = c.iter()
    while true {
        val p = it.next() ?: break
        t = t + p.get()
    }
    return t
}

fun total_len<C: Iterable<String>>(c: &C): uint64 {
    var n: uint64 = 0
    var it = c.iter()
    while true {
        val s = it.next() ?: break
        n = n + s.byte_len()
    }
    return n
}

fun main(): int32 {
    var ps = List.new<Point>()
    ps.push(Point { x: 2 })
    ps.push(Point { x: 5 })
    var xs = List.new<int32>()
    xs.push(1)
    if count_all(&ps) != 2 || count_all(&xs) != 1 { return 1 }
    if total_x(&ps) != 7 { return 2 }
    var names = List.new<String>()
    names.push(String.from("ada"))
    if total_len(&names) != 3 { return 3 }
    return 0
}
