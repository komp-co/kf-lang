//! build: fail
//! deps: core
// A value-returning function may not `return` a void call, here through a
// `?:` bail.

fun log_it(): void {
    return
}

fun use_it(o: Ptr<int32>?): int32 {
    val p = o ?: return log_it()
    return unsafe { *p }
}

fun main(): int32 {
    val none: Ptr<int32>? = null
    return use_it(none)
}
