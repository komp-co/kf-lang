//! deps: core
// `T` appears only in the bounds of `I` and `F`; `impl Iterator<int32> for
// Counter` fixes it, so the call need not spell `map<int32, Counter, Dbl>`.

struct Counter { var n: int32 }

impl Iterator<int32> for Counter {
    mutating fun next(): int32? {
        if self.n >= 3 { return null }
        self.n = self.n + 1
        return self.n
    }
}

struct Dbl { }

impl Call1<int32> for Dbl {
    type Out = int32
    fun call(x: int32): int32 { return x * 2 }
}

struct MapIter<I, F> {
    var inner: I
    val f: F
}

fun map<T, I: Iterator<T>, F: Call1<T>>(inner: I, f: F): MapIter<I, F> {
    return MapIter<I, F> { inner: inner, f: f }
}

fun main(): int32 {
    val counter = Counter { n: 0 }
    val m = map(counter, Dbl { })
    return m.f.call(21)
}
