//! run: exit 37
//! deps: core
// With no type arguments written, a static method of a generic type takes
// them from what its arguments are: an inherent one, and one a trait impl
// supplies, selected by the array's length.

struct Bag<T> {
    val count: uint64
    val first: T
}

impl<T> Bag<T> {
    static fun of(first: T): Bag<T> { return Bag<T> { count: 1, first: first } }
}

trait Make<X> {
    static fun make(value: X): Self
}

impl<T: Copy> Make<T[2]> for Bag<T> {
    static fun make(value: T[2]): Bag<T> { return Bag<T> { count: 2, first: value[0] } }
}

impl<T: Copy> Make<T[3]> for Bag<T> {
    static fun make(value: T[3]): Bag<T> { return Bag<T> { count: 3, first: value[0] } }
}

fun main(): int32 {
    val one = Bag.of(true)
    val two: int64[2] = [20, 0]
    val three: int64[3] = [10, 0, 0]
    val a = Bag.make(two)
    val b = Bag.make(three)
    val c: Bag<int64> = Bag.of(two[1])
    val flag = if one.first { 1 } else { 0 }
    return (a.first + b.first) as int32 + a.count as int32 + b.count as int32 + flag + c.first as int32 + 1
}
