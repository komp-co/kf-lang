//! run: exit 0
//! deps: core, alloc
// A struct literal binds its fields by name, not written order:
// `Pair { second: 2, first: 1 }` has `first` 1. Every literal here is out of
// declaration order.
extern "C" fun runtime_println(s: str): void

pub struct Pair {
    pub val first: int32
    pub val second: int32
}

pub struct Three {
    pub val a: int32
    pub val b: int32
    pub val c: int32
}

// A generic struct takes a different checker.
pub struct Cell<T> {
    pub val tag: int32
    pub val value: T
}

fun main(): int32 {
    val p = Pair { second: 2, first: 1 }
    if p.first != 1 { return 1 }
    if p.second != 2 { return 2 }

    // A rotation, so no two positions are merely swapped.
    val t = Three { c: 3, a: 1, b: 2 }
    if t.a != 1 { return 3 }
    if t.b != 2 { return 4 }
    if t.c != 3 { return 5 }

    val c = Cell<int32> { value: 9, tag: 4 }
    if c.tag != 4 { return 6 }
    if c.value != 9 { return 7 }

    // Declaration order still works.
    val q = Pair { first: 10, second: 20 }
    if q.first != 10 { return 8 }
    if q.second != 20 { return 9 }

    runtime_println("ok")
    return 0
}
