//! run: exit 3
//! deps: core, alloc
// A trait-bounded extension receiver (`fun <T> Iterable<T>.count_all()`)
// reaches a receiver whose Iterable argument is compound: `HashMap<K, V>`'s
// `Iterable<Entry<K, V>>` infers `T = Entry<int32, int32>`, and both type
// arguments are written back.

import core.entry.*

fun <T> Iterable<T>.count_all(): uint64 {
    var cur = self.iter()
    var n: uint64 = 0
    while true {
        when (cur.next()) {
            Some(_v) => n = n + 1
            None => return n
        }
    }
    return n
}

fun main(): int32 {
    var m = HashMap.new<int32, int32>()
    m.insert(1, 10)
    m.insert(2, 20)
    m.insert(3, 30)
    return m.count_all() as int32
}
