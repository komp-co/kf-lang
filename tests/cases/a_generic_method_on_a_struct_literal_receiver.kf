//! run: exit 0
//! deps: core
// A literal receiver mints its own instance, and nothing else here names
// `Bag<int32>`'s `dup` specialisations.

struct Bag<T> { pub var v: T }

impl Bag<T> {
    pub fun dup<U>(u: U): U { return u }
}

fun main(): int32 {
    val a = Bag<int32> { v: 1 }.dup<int32>(7)
    if a != 7 { return 1 }
    val b = Bag<bool> { v: true }.dup(9)
    if b != 9 { return 2 }
    return 0
}
