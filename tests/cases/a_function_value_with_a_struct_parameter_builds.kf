//! run: exit 0
//! deps: core, alloc
// An inferred function type spells its struct parameter with the crate's C
// name, as a written one does.

struct Counter {
    var n: int32
}

fun get(c: &Counter): int32 { return c.n }

fun main(): int32 {
    val g = get
    val c = Counter { n: 0 }
    return g(&c)
}
