//! build: fail
//! deps: core, alloc
// A receiver's arguments name types, not bounds; the diagnostic names the list
// that carries the bound.

import alloc.list.*

fun Iterable<T: Add>.total(): T {
    var sum = 0
    while _x in self { sum = sum + 1 }
    return sum
}

fun main(): int32 { return 0 }
