//! run: exit 0
//! deps: core, alloc
// `while x in xs` over a `&List<T>` looks through the borrow for `Iterable`,
// as method calls do.

import alloc.list.*

fun total(xs: &List<int32>): int32 {
    var sum: int32 = 0
    while x in xs {
        val v: int32 = x
        sum = sum + v
    }
    return sum
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(4)
    xs.push(6)
    if total(&xs) != 10 {
        return 1
    }
    return 0
}
