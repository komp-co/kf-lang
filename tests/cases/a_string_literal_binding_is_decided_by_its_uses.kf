//! run: exit 42
//! deps: core, alloc
// A string literal bound without a type is a `str` until a use needs more: a
// `String` method or slot, a slot of a type converting from `str`, or a store
// of a `String`. A `str` use first decides nothing, since a `String` serves it.
import alloc.string.*

struct Name {
    val length: uint64
}

impl From<str> for Name {
    static fun from(text: str): Name { return Name { length: text.byte_len() } }
}

fun owned_length(s: String): uint64 { return s.byte_len() }
fun name_length(n: Name): uint64 { return n.length }
fun view_length(s: str): uint64 { return s.byte_len() }

fun main(): int32 {
    var out = ""
    out.append("ab")
    val owned = "abc"
    val seen = view_length(owned)
    if owned_length(owned) != 3 || seen != 3 { return 1 }
    val name = "four"
    if name_length(name) != 4 { return 2 }
    var stored = ""
    stored = String.from("xyz")
    if out.byte_len() != 2 || stored.byte_len() != 3 { return 3 }
    return 42
}
