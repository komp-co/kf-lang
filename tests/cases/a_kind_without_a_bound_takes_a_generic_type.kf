//! run: exit 0
//! deps: core, alloc
// Without a bound there is nothing to depend on `T`, so a generic type may
// carry the annotation.

annotation shown on struct

@shown
struct Holder<T> {
    val value: T
}

fun main(): int32 {
    val h = Holder<int32> { value: 0 }
    return h.value + annotated<shown>().size() as int32 - 1
}
