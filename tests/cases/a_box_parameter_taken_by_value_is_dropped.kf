//! run: exit 1
//! deps: core, alloc

// A `Box<T>` parameter taken by value belongs to its callee, which drops the
// pointee at the end, as it would a struct.

pub struct Tracked {
    var counter: Ptr<int32>
}

impl Drop for Tracked {
    fun drop(): void {
        unsafe { *self.counter = *self.counter + 1 }
    }
}

fun consume_box(_b: Box<Tracked>): void { }

fun main(): int32 {
    val p: Ptr<int32> = unsafe { alloc_array<int32>(1) }
    unsafe { *p = 0 }
    consume_box(Box.new(Tracked { counter: p }))
    return unsafe { *p }
}
