//! run: exit 1
//! deps: core
// A failing test panics in its child, so the run continues and then exits 1.

import core.testing.run_tests

annotation check

@check
fun fails(): void { assert_eq(1, 2, "one is two") }

@check
fun passes(): void {}

fun main(): int32 {
    return run_tests(&annotated<check>())
}
