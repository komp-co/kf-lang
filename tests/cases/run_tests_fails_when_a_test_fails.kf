//! run: exit 1
//! deps: core, testing
// A failing test panics in its child, so the run continues and then exits 1.

import testing.run_tests

@test
fun fails(): void { assert_eq(1, 2, "one is two") }

@test
fun passes(): void {}

fun main(): int32 {
    return run_tests(&annotated<test>(), &annotated<disabled>())
}
