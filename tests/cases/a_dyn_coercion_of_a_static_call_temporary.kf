//! run: exit 0

// A `&dyn Trait` coercion over a borrowed temporary. The last two shapes
// fail only under separate compilation.

import core.display.*

fun shown(v: &dyn Display): String {
    return String.of(&(v))
}

fun make(): String { return String.from("zz") }

fun main(): int32 {
    // A borrowed local.
    val s = String.from("a")
    if !shown(&s).as_str().equals("a") { return 1 }
    // A borrowed call temporary.
    if !shown(&(make())).as_str().equals("zz") { return 2 }
    // A borrowed static-call temporary.
    if !shown(&(String.from("b"))).as_str().equals("b") { return 3 }
    // One built by an operator, as nested interpolation produces.
    if !shown(&(String.from("c") + String.from("d"))).as_str().equals("cd") { return 4 }
    return 0
}
