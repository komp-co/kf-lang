//! run: exit 0
//! deps: core
// With no alloc, the query is an array of view entries built from literals,
// and an annotation with no uses gives an empty one.

annotation bench(runs: int32) on () -> int32
annotation unused

@bench(2)
fun first(): int32 { return 1 }

@bench(3)
fun second(): int32 { return 10 }

fun total<A>(entries: &AnnotatedFunction<A, () -> int32>[]): int32 {
    var sum = 0
    while e in entries { sum = sum + e.function() }
    return sum
}

fun main(): int32 {
    val benches = annotated<bench>()
    if benches.size() != 2 { return 1 }
    if benches[1].name != "second" || benches[1].module != "annotated_runs_with_core_alone" { return 2 }
    if total(&benches) != 11 || benches[0].args.runs != 2 { return 3 }
    if annotated<unused>().size() != 0 { return 4 }
    var none = 0
    while _e in &annotated<unused>() { none = none + 1 }
    return none
}
