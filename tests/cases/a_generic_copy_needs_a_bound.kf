//! build: fail
//! deps: core, alloc
// Reading a `T` out of a borrow into a by-value slot copies it, and nothing in
// `first_of` says `T` may be copied; it is refused where it is written, even
// though every caller here passes an `int32`.


fun first_of<T>(xs: &List<T>): T {
    return *xs.at(0)
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(4)
    return first_of(&xs)
}
