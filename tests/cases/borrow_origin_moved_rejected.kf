//! build: fail
//! deps: core, alloc
// A borrow outliving its origin without the origin changing in place:
// `handed_away` gives the origin to a consuming parameter while the borrow is
// read; `laundered` returns a borrow of a local through an intermediate
// binding. `lent`, `settled` and `measured` stay legal.

fun consume(s: String): uint64 { return s.len() }
fun observe(s: &String): uint64 { return s.len() }

struct Sink { pub var total: uint64 }

impl Sink {
    pub fun take(s: String): uint64 { return s.len() }
    pub fun read(s: &String): uint64 { return s.len() }
}

fun handed_away(): int32 {
    var text = String.from("hello")
    val view = text.as_str()
    val n = consume(text)
    if view == "hello" { return 1 }
    return n as int32
}

// A method consumes its argument as a free function does; `self` takes no
// slot.
fun handed_to_method(): int32 {
    var text = String.from("hello")
    val view = text.as_str()
    var sink = Sink { total: 0 }
    val n = sink.take(text)
    if view == "hello" { return 1 }
    return n as int32
}

fun laundered(): str {
    var text = String.from("hello")
    val view = text.as_str()
    return view
}

fun lent(): int32 {
    var text = String.from("hello")
    val view = text.as_str()
    val n = observe(&text)
    if view == "hello" { return 1 }
    return n as int32
}

fun lent_to_method(): int32 {
    var text = String.from("hello")
    val view = text.as_str()
    var sink = Sink { total: 0 }
    val n = sink.read(&text)
    if view == "hello" { return 1 }
    return n as int32
}

fun settled(): int32 {
    var text = String.from("hello")
    val view = text.as_str()
    if view == "hello" { return 1 }
    return consume(text) as int32
}

fun measured(): uint64 {
    var text = String.from("hello")
    val view = text.as_str()
    return String.from(view).len()
}

fun main(): int32 {
    return 0
}
