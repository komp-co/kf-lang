//! run: exit 0
//! deps: core, alloc
// A name the body reads from the enclosing scope becomes a field of the
// synthesized struct, borrowed where the lambda is written.

fun apply<F: Call1<int32>>(f: F, x: int32): int32 { return f.call(x) }
fun holds<F: Call1<int32>>(f: F, x: int32): bool { return f.call(x) }

fun main(): int32 {
    val factor: int32 = 3
    if apply(|x: int32| x * factor, 5) != 15 { return 1 }

    // Two captures, and a parameter that shadows nothing.
    val bias: int32 = 1
    if apply(|x: int32| x * factor + bias, 5) != 16 { return 2 }

    // A capture reached through a method call, not just arithmetic.
    val label = String.from("hey")
    if apply(|x: int32| x + (label.len() as int32), 1) != 4 { return 3 }
    // Capturing borrows; the original is untouched.
    if label.len() != 3 { return 4 }

    if !holds(|x: int32| x < bias + 3, 2) { return 5 }
    return 0
}
