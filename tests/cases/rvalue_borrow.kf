//! run: exit 0
//! deps: core, alloc
// An rvalue (call result, container read, field of an rvalue) passed to a
// `&T` parameter is materialized as a compound literal `(&(T){ expr })`,
// living for the enclosing block.
import alloc.list.*

extern "C" fun runtime_println(s: str): void

@derive(Copy)
pub struct Pt {
    var x: int32
    var y: int32
}

fun make_pt(a: int32, b: int32): Pt { return Pt { x: a, y: b } }

// Borrow sinks — read-only, never consume.
fun pt_sum(p: &Pt): int32 { return (*p).x + (*p).y }
fun str_len(s: &String): uint64 { return unsafe { kf_str_byte_len((*s).as_str()) } }
extern "C" fun kf_str_byte_len(s: str): uint64

fun make_name(): String { return String.from("hello") }

fun main(): void {
    // 1. Call result (plain value struct) straight into &T.
    val a = pt_sum(make_pt(3, 4))
    if a == 7 { runtime_println("call-rvalue OK") } else { runtime_println("FAIL call-rvalue") }

    // 2. A container element read straight into &T.
    var xs = List.new<Pt>()
    xs.push(Pt { x: 10, y: 20 })
    val b = pt_sum(xs.get(0))
    if b == 30 { runtime_println("get-rvalue OK") } else { runtime_println("FAIL get-rvalue") }

    // 3. A move-only rvalue into &String: the temp is a view; the callee only
    //    reads.
    val c = str_len(make_name())
    if c == 5 { runtime_println("string-rvalue OK") } else { runtime_println("FAIL string-rvalue") }

    // 4. An lvalue argument takes a plain address.
    var p = Pt { x: 1, y: 2 }
    val d = pt_sum(p)
    if d == 3 { runtime_println("lvalue OK") } else { runtime_println("FAIL lvalue") }

    runtime_println("ALL OK")
}
