//! build: fail
//! deps: core, alloc
// A borrow stored through a container is stored all the same:
//
//     fun stash(): Holder {
//         val owned = String.from("hello world")
//         var vs = List.new<str>()
//         vs.push(owned.as_str())
//         return Holder { views: vs }   // `owned` drops here
//     }
//
// `Ptr` stays exempt however deep, and a container of owned values is
// untouched.

import alloc.list.*

struct Holder   { pub var views: List<str> }
struct Maybe    { pub var view: Option<str> }
struct Deep     { pub var views: List<Option<str>> }
struct Boxed    { pub var view: Box<str> }

enum Payload { Views(List<str>) }

struct Owned    { pub var names: List<String> }
struct Unsafe   { pub var views: List<Ptr<str>> }

fun main(): int32 {
    return 0
}
