//! run: exit 0
//! deps: core
// A negative integer and a char are pattern literals: `-1`'s sign folds into
// the value, and a char matches by code point.

fun direction(delta: int32): int32 {
    return when (delta) {
        -1 => 10
        0 => 20
        1 => 30
        _ => 40
    }
}

fun classify(c: char): int32 {
    return when (c) {
        'a' => 1
        'z' => 26
        '\n' => 99
        _ => 0
    }
}

fun main(): int32 {
    if direction(0 - 1) != 10 { return 1 }
    if direction(0) != 20 { return 2 }
    if direction(1) != 30 { return 3 }
    if direction(7) != 40 { return 4 }

    if classify('a') != 1 { return 5 }
    if classify('z') != 26 { return 6 }
    if classify('\n') != 99 { return 7 }
    if classify('q') != 0 { return 8 }
    return 0
}
