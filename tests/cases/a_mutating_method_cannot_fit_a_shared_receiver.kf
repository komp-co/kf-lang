//! build: fail
//! deps: core, alloc
// Under `(&Server) -> int32`, a mutating method would write through a shared
// borrow.

annotation reader on (&Server) -> int32

struct Server {
    var hits: int32
}

impl Server {
    @reader
    mutating fun bump(): int32 {
        self.hits = self.hits + 1
        return self.hits
    }
}

fun main(): int32 { return 0 }
