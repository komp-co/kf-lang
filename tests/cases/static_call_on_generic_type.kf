//! run: exit 0
//! deps: core

// A `static fun` on a generic type called with arguments,
// `Holder.of<int32>(5)`, is a static call on the instance. `empty()` covers
// the no-argument shape `List.new<int32>()` has.

pub struct Holder<T> {
    val item: T
}

impl Holder<T> {
    pub static fun of(o: T): Holder<T> {
        return Holder<T> { item: o }
    }
    pub static fun pair(a: T, _b: T): Holder<T> {
        return Holder<T> { item: a }
    }
}

pub trait Maker {
    type Output
    static fun from_output(o: Self.Output): Self
}

// A trait static on the same type.
impl Maker for Holder<T> {
    type Output = T
    static fun from_output(o: T): Holder<T> {
        return Holder<T> { item: o }
    }
}

fun main(): int32 {
    val a = Holder.of<int32>(5)
    if a.item != 5 { return 1 }
    val b = Holder.pair<int32>(6, 7)
    if b.item != 6 { return 2 }
    val c = Holder.from_output<int32>(8)
    if c.item != 8 { return 3 }
    return 0
}
