//! run: exit 0
//! deps: core

// A trait argument mentioning the impl's own parameter, reached through a
// static method: `impl Absorb<Wrap<T>> for Holder<T>` is registered under
// `Wrap__T`, and the call substitutes it (`..._Absorb__Wrap__int32`), as the
// instance path does beside it.

pub enum Wrap<A> {
    W(A)
}

pub trait Absorb<R> {
    static fun absorb(r: R): Self
    fun tag(): int32
}

pub struct Holder<T> {
    pub val v: T
}

impl Absorb<Wrap<T>> for Holder<T> {
    static fun absorb(r: Wrap<T>): Holder<T> {
        when (r) {
            W(x) => { return Holder<T> { v: x } }
        }
        return Holder<T> { v: unsafe { 0 as T } }
    }

    // The instance half of the same impl.
    fun tag(): int32 {
        return 7
    }
}

// A second instantiation: the suffix follows the type argument.
fun absorb_two_element_types(): int32 {
    val a = Holder.absorb<int32>(Wrap.W<int32>(5))
    if a.v != 5 { return 1 }
    val b = Holder.absorb<bool>(Wrap.W<bool>(true))
    if b.v != true { return 2 }
    return 0
}

// A trait argument not mentioning the impl's parameter is left alone.
pub struct Fixed<T> {
    pub val v: T
}

impl Absorb<Wrap<int32>> for Fixed<T> {
    static fun absorb(r: Wrap<int32>): Fixed<T> {
        when (r) {
            W(_x) => { }
        }
        return Fixed<T> { v: unsafe { 0 as T } }
    }

    fun tag(): int32 {
        return 9
    }
}

fun main(): int32 {
    val bad = absorb_two_element_types()
    if bad != 0 { return bad }

    val h = Holder.absorb<int32>(Wrap.W<int32>(42))
    if h.v != 42 { return 3 }
    if h.tag() != 7 { return 4 }

    val f = Fixed.absorb<int32>(Wrap.W<int32>(1))
    if f.tag() != 9 { return 5 }

    return 0
}
