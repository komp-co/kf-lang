//! run: exit 72
//! deps: core, alloc
// A method a slice has and the array or list lacks is called through the
// slice it lends: shared when the slice method reads, mutable when it writes.

fun <T> Slice<T>.middle(): &T { return self.at(self.size() / 2) }

fun main(): int32 {
    var xs: int32[5] = [9, 4, 7, 1, 3]
    xs.swap(0, 4)
    var names = List.new<String>()
    names.push(String.from("pear"))
    names.push(String.from("fig"))
    val tail = names.slice(1..2)
    return *xs.middle() * 10 + xs[0] - tail[0].byte_len() as int32 + 2
}
