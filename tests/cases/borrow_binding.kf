//! run: exit 0
//! deps: core, alloc
// `val b = &xs` binds a borrow, not a moved or cloned list; `(*b).size()`
// works too.

fun sum_through(b: &List<int32>): int32 {
    var total: int32 = 0
    var i: uint64 = 0
    while i < (*b).size() {
        total = total + (*b).get(i)
        i = i + 1
    }
    return total
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    xs.push(3)

    // shared borrow: method call, explicit deref, and passing it on
    val b = &xs
    val n: uint64 = b.size()
    val d: uint64 = (*b).size()
    val t: int32 = sum_through(b)

    // mutable borrow: the mutation lands on the owner
    var ys = List.new<int32>()
    val m = &var ys
    (*m).push(9)

    // borrowing does not consume: the owner is still usable afterwards
    xs.push(4)

    var s = String.from("owned")
    val sb = &s
    val slen: uint64 = (*sb).len()

    if n != 3 { return 1 }
    if d != 3 { return 2 }
    if t != 6 { return 3 }
    if ys.size() != 1 { return 4 }
    if xs.size() != 4 { return 5 }
    if slen != 5 { return 6 }
    return 0
}
