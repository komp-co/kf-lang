//! run: exit 0
//! deps: core, alloc
// A lambda parameter's type comes from the `Call` bound of the parameter it is
// passed to, before the lambda is checked. The bound names the type, is
// pinned by another argument, or by a generic receiver (`List.map`).


// The bound names the type literally.
fun apply_int<F: Call1<int32>>(f: F, x: int32): int32 { return f.call(x) }

// The bound uses a parameter another argument pins.
fun apply<A, F: Call1<A>>(f: F, x: A): F.Out { return f.call(x) }

fun main(): int32 {
    if apply_int(|x| x * 2, 3) != 6 { return 1 }
    if apply(|x| x * 3, 4) != 12 { return 2 }

    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    xs.push(3)

    val doubled = xs.clone().map(|x| x * 2)
    if doubled.get(2) != 6 { return 3 }

    // The body decides the element type: a List<bool>.
    val odds = xs.clone().map(|x| x % 2 == 1)
    if odds.get(0) != true { return 4 }
    if odds.get(1) != false { return 5 }

    // An inferred parameter and a capture together.
    val factor: int32 = 10
    val scaled = xs.clone().map(|x| x * factor)
    if scaled.get(2) != 30 { return 6 }
    return 0
}
