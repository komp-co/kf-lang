//! run: exit 0
//! deps: core, alloc
// A name in an annotation's target that is not a type is a type parameter,
// bound by each use. Pinning every parameter in the query keeps the uses
// binding them and makes the entries callable; without pins they are listed
// by name.

struct Request {
    val path: String
}

struct Server {
    var hits: int32
}

struct Proxy {
    var calls: int32
}

trait Shown {
    fun show(): int32
}

impl Shown for Server {
    fun show(): int32 { return self.hits }
}

annotation handler on (&var S, Request) -> int32
annotation same on (T, T) -> T
annotation <T: Shown> shown on (&T) -> int32

impl Server {
    @handler
    mutating fun login(r: Request): int32 {
        self.hits = self.hits + 1
        return 10
    }

    @handler
    fun users(r: Request): int32 { return 20 + self.hits }
}

impl Proxy {
    @handler
    fun forward(r: Request): int32 { return 99 }
}

@same
fun add(a: int32, b: int32): int32 { return a + b }

@same
fun pick(a: bool, b: bool): bool { return a }

@shown
fun peek(s: &Server): int32 { return s.show() }

fun main(): int32 {
    var s = Server { hits: 0 }
    var total = 0
    while h in &annotated<handler<Server>>() {
        total = total + h.function(&var s, Request { path: "/" })
    }
    if total != 31 { return 1 }
    if annotated<handler>().size() != 3 { return 2 }
    if annotated<same>().size() != 2 { return 3 }
    val adders = annotated<same<int32>>()
    if adders.size() != 1 || adders.at(0).function(2, 3) != 5 { return 4 }
    if annotated<shown<Server>>().at(0).function(&s) != 1 { return 5 }
    return 0
}
