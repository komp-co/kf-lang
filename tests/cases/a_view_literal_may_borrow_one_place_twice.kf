//! run: exit 4
//! deps: core, alloc
// Two fields lent from the same binding still borrow from one place.

view struct Pair {
    val a: str
    val b: str
}

fun main(): int32 {
    val x = String.from("ab")
    val p = Pair { a: x.as_str(), b: x.as_str() }
    return (p.a.byte_len() + p.b.byte_len()) as int32
}
