//! build: fail
//! deps: core
// A bare identifier in a pattern binds, so this arm is irrefutable whatever
// `b` is. Reported; prefix with `_` to bind deliberately.

fun classify(b: uint8, end_byte: uint8): int32 {
    return when b {
        end_byte => 111
    }
}

fun main(): int32 { return classify(10, 99) }
