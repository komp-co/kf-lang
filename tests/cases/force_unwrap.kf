//! run: exit 0
//! deps: core

// `a!!`: the payload, or a controlled abort. Sugar for `.unwrap()`, so the
// method must exist on the receiver.

import core.option.*
import core.result.*

fun half(n: int32): int32? {
    if n % 2 == 0 { return Option.Some(n / 2) }
    return null
}

fun main(): int32 {
    if half(8)!! != 4 { return 1 }

    // Without spaces: `c=half(12)!!` and `half(8)!! != 4`, with `!=` intact.
    var c = 0
    c=half(12)!!
    if c != 6 { return 2 }

    // On a Result, whose `unwrap` is a different method.
    val r: Result<int32, int32> = Result.Ok<int32, int32>(9)
    if r!! != 9 { return 3 }

    // Chains with the rest of the postfix run.
    val n: int32? = Option.Some(0 - 5)
    if n!! != 0 - 5 { return 4 }
    return 0
}
