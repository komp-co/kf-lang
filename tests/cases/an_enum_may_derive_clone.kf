//! run: exit 0
//! deps: core, alloc
// An enum derives `Clone`, satisfying a `T: Clone` bound; the glue walks each
// variant's payload.

import alloc.string.*

@derive(Clone)
pub enum Shape {
    Named(String)
    Blank
}

fun needs_clone<T: Clone>(v: T): T { return v }

fun main(): int32 {
    val named = Shape.Named(String.from("hexagon"))
    val copied = needs_clone(named)
    when (copied) {
        Named(s) => { if !s.as_str().equals("hexagon") { return 1 } }
        Blank => return 2
    }

    // A payload-free variant travels the same path.
    when (needs_clone(Shape.Blank)) {
        Named(_s) => return 3
        Blank => { }
    }
    return 0
}
