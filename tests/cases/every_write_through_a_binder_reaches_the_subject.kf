//! run: exit 0
//! deps: core, alloc
// Writes through a binder reach the subject whatever their shape: a field
// store, a `&var` borrow, a guarded arm, a field path, and a `when` value.
// Over a temporary the binder stays a copy.

struct Counter {
    var n: int32
    var name: String
}

impl Counter {
    mutating fun bump(): int32 {
        self.n = self.n + 1
        return self.n
    }
}

struct Pair {
    var inner: Counter
}

enum Slot {
    Empty
    Full(Counter)
    Nested(Pair)
}

fun poke(c: &var Counter): void { c.n = c.n + 10 }

fun make(): Counter? { return Option.Some(Counter { n: 0, name: String.from("t") }) }

fun main(): int32 {
    var s = Slot.Full(Counter { n: 0, name: String.from("a") })
    when (s) {
        Full(c) => { c.n = 5 }
        _ => {}
    }
    when (s) {
        Full(c) => poke(&var c)
        _ => {}
    }
    val got = when (s) {
        Full(c) if c.n > 0 => c.bump()
        _ => -1
    }
    if got != 16 { return 1 }
    var p = Slot.Nested(Pair { inner: Counter { n: 1, name: String.from("b") } })
    when (p) {
        Nested(q) => { q.inner.bump() }
        _ => {}
    }
    val after = when (p) {
        Nested(q) => q.inner.n
        _ => 0
    }
    if after != 2 { return 2 }
    val t = when (make()) {
        Some(c) => c.bump()
        None => 0
    }
    if t != 1 { return 3 }
    return 0
}
