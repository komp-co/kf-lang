//! run: exit 9
// `c.make()` through `C: Producer` is typed `C.Out`, an inferred projection
// with no TypeRef, carried until Mono pins the owner. The choice is a struct:
// a primitive matches the checker's fallback and would pass unresolved.
struct Cursor { pub val n: int32 }

trait Producer {
    type Out
    fun make(): Self.Out
}

struct Widget { pub val v: int32 }

impl Producer for Widget {
    type Out = Cursor
    fun make(): Self.Out { return Cursor { n: 9 } }
}

fun run<C: Producer>(c: C): int32 {
    val out = c.make()
    return out.n
}

fun main(): int32 {
    val w = Widget { v: 1 }
    return run<Widget>(w)
}
