//! run: exit 4
// A method on a value typed `C.Out` resolves through the bound
// `type Out: Stepper`, translating the trait's signature positionally into
// the caller's parameters.
trait Stepper {
    fun step(): int32
}

struct Cursor { pub val n: int32 }

impl Stepper for Cursor {
    fun step(): int32 { return self.n }
}

trait Producer {
    type Out: Stepper
    fun make(): Self.Out
}

struct Widget { pub val v: int32 }

impl Producer for Widget {
    type Out = Cursor
    fun make(): Self.Out { return Cursor { n: 4 } }
}

fun run<C: Producer>(c: C): int32 {
    val out = c.make()
    return out.step()
}

fun main(): int32 {
    val w = Widget { v: 1 }
    return run<Widget>(w)
}
