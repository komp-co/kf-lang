//! run: exit 0
//! deps: core

// A trait impl whose target is an enum. `Tagged` is not `Clone`, `Drop` or
// `Equal`, whose methods carry no trait suffix; the struct case is the
// control.

pub trait Tagged {
    fun tag(): int32
}

pub struct Pair<A> {
    val left: A
}

impl Tagged for Pair<A> {
    fun tag(): int32 { return 7 }
}

pub enum Plain {
    A
    B
}

impl Tagged for Plain {
    fun tag(): int32 { return 5 }
}

pub enum Single<T> {
    Only(T)
}

impl Tagged for Single<T> {
    fun tag(): int32 { return 9 }
}

fun main(): int32 {
    val p = Pair<int32> { left: 1 }
    if p.tag() != 7 { return 1 }
    val q = Plain.A
    if q.tag() != 5 { return 2 }
    val o = Single.Only<int32>(3)
    if o.tag() != 9 { return 3 }
    return 0
}
