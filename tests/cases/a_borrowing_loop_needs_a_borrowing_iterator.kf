//! build: fail
//! deps: core, alloc
// `while v in &c` needs `next_ptr()`, and a type with only `next()` lacks it.
//
// CONSTRAINT: `build: fail` cannot tell a typecheck diagnostic from a C error,
// so the message is asserted by the kf-typecheck unit tests
// `a_type_without_next_ptr_has_no_borrowing_iterator` and its positive twin.

struct Counter { pub var n: int32 }
struct CountIter { pub var i: int32, pub var n: int32 }

impl Iterable<int32> for Counter {
    type Iter = CountIter
    fun iter(): CountIter { return CountIter { i: 0, n: self.n } }
}

impl Iterator<int32> for CountIter {
    mutating fun next(): int32? {
        if self.i >= self.n { return null }
        val v = self.i
        self.i = self.i + 1
        return Option.Some(v)
    }
}

fun main(): int32 {
    val c = Counter { n: 3 }
    var t = 0
    while v in &c {
        t = t + v
    }
    return t - 3
}
