//! build: fail
//! deps: core
// `==` on `Option<Message>` needs `Message: Equal`, the bound on `Option`'s `Equal` impl.

struct Message { val id: int32 }

fun main(): int32 {
    val a: Message? = Option.Some(Message { id: 1 })
    val b: Message? = Option.Some(Message { id: 1 })
    if a == b { return 1 }
    return 0
}
