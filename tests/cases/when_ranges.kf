//! run: exit 0
//! deps: core
// A range arm matches every value in it: `..` stops before its upper bound,
// `..=` includes it, over integers (negative too) and chars.

fun escape_class(byte: uint8): int32 {
    return when byte {
        34 => 1
        92 => 2
        0..32 => 3
        127..=255 => 4
        _ => 0
    }
}

fun sign(n: int64): int32 {
    return when n {
        -1000..0 => -1
        0 => 0
        1..=1000 => 1
        _ => 9
    }
}

fun letter(c: char): int32 {
    return when c {
        'a'..='z' => 1
        'A'..='Z' => 2
        '0'..='9' if c != '0' => 3
        _ => 0
    }
}

fun main(): int32 {
    if escape_class(34) != 1 { return 1 }
    if escape_class(0) != 3 { return 2 }
    if escape_class(31) != 3 { return 3 }
    if escape_class(32) != 0 { return 4 }
    if escape_class(127) != 4 { return 5 }
    if escape_class(255) != 4 { return 6 }
    if sign(-1000) != -1 { return 7 }
    if sign(-1) != -1 { return 8 }
    if sign(0) != 0 { return 9 }
    if sign(1000) != 1 { return 10 }
    if sign(1001) != 9 { return 11 }
    if letter('q') != 1 { return 12 }
    if letter('Q') != 2 { return 13 }
    if letter('7') != 3 { return 14 }
    if letter('0') != 0 { return 15 }
    return 0
}
