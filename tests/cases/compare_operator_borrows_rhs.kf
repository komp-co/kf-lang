//! run: exit 0
//! deps: core, alloc
// `p < q` is `p.compare(q) < 0`, and neither form moves its operand. A
// regression shows as a double free. Uses core's `impl Compare for String`.

fun main(): int32 {
    val a = String.from("apple")
    val b = String.from("pear")
    if !(a < b) {
        return 1
    }
    val c = String.from("zebra")
    val d = String.from("ant")
    if c < d {
        return 2
    }
    return 0
}
