//! run: exit 0
//! deps: core, alloc
// `"a ${x} b"` expands in the lexer to
// `(String.from("a ") + String.of(&(x)) + String.from(" b"))`, so a slot holds
// any expression.


import core.display.*

struct Node { pub val v: int32 }
fun unwrap_v(nd: Node): int32 { return nd.v }

fun main(): int32 {
    val name = String.from("world")
    val n: int32 = 3

    if !"hello ${name}, ${n} times".as_str().equals("hello world, 3 times") { return 1 }

    // a slot alone, and adjacent slots
    if !"${n}".as_str().equals("3") { return 2 }
    if !"${n}${n}".as_str().equals("33") { return 3 }

    // no slots: unchanged
    if !"plain".as_str().equals("plain") { return 4 }

    // an arbitrary expression, including one with braces of its own
    if !"sum=${n + 1}".as_str().equals("sum=4") { return 5 }
    if !"v=${unwrap_v(Node { v: 9 })}".as_str().equals("v=9") { return 6 }

    // a nested string literal inside a slot
    if !"b=${String.from("in")}".as_str().equals("b=in") { return 7 }

    // A slot holding an interpolation, and one holding an operator's String:
    // both render a temporary.
    if !"n=${"in${n}ner"}".as_str().equals("n=in3ner") { return 13 }
    if !"c=${String.from("x") + String.from("y")}".as_str().equals("c=xy") { return 14 }

    // a method call in a slot
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    if !"size=${xs.size()}".as_str().equals("size=2") { return 8 }

    // `\$` is a literal dollar, so this opens no slot
    if !"cost \${5}".as_str().equals("cost \${5}") { return 9 }

    // A `str` slot, through `impl Display for str`.
    val raw: str = "raw"
    if !"r=${raw}".as_str().equals("r=raw") { return 12 }

    // unsigned and bool slots reach their Display impls
    val u: uint64 = 18446744073709551615
    if !"u=${u}".as_str().equals("u=18446744073709551615") { return 10 }
    val flag: bool = false
    if !"f=${flag}".as_str().equals("f=false") { return 11 }

    return 0
}
