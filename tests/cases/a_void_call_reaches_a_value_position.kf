//! run: exit 3
// A `void`-typed call where a value is required is evaluated and yields the
// unit: as a constructor payload and at a unit-typed parameter. Only calls
// are wrapped; a unit-typed binder stays a place.
pub struct Counter { pub var n: int32 }

pub enum Holder<T> {
    Full(T)
    Empty
}

fun bump(c: &var Counter): void { c.n = c.n + 1 }
fun swallow(u: void): int32 { return 1 }

fun main(): int32 {
    var c = Counter { n: 0 }

    // A unit-typed value as the argument.
    val u: void = bump(&var c)
    val a: Holder<void> = Holder.Full<void>(u)

    // A constructor payload and an ordinary argument, both calls.
    val b: Holder<void> = Holder.Full<void>(bump(&var c))
    val got = swallow(bump(&var c))

    // Every bump ran: dropping the call would compile and lose the effect.
    return c.n + got - 1
}
