//! run: exit 0
//! deps: core, alloc
// A function target marks methods as functions whose first parameter is the
// receiver. Under `&var Server`, a method taking `&Server`, and a free
// function taking one, fit too.

struct Request {
    val path: String
}

struct Server {
    var hits: int32
}

trait Pinged {
    fun ping(r: Request): int32
}

annotation handler(path: String) on (&var Server, Request) -> int32

impl Server {
    @handler("/users")
    fun users(r: Request): int32 { return 10 + self.hits }

    @handler("/login")
    mutating fun login(r: Request): int32 {
        self.hits = self.hits + 1
        return 20
    }
}

impl Pinged for Server {
    @handler("/ping")
    fun ping(r: Request): int32 { return 30 }
}

@handler("/free")
fun free(s: &Server, r: Request): int32 { return 40 }

fun serve(s: &var Server, r: Request): int32 {
    while h in &annotated<handler>() {
        if h.args.path == r.path { return h.function(s, r) }
    }
    return -1
}

fun main(): int32 {
    var s = Server { hits: 0 }
    val login = serve(&var s, Request { path: "/login" })
    val users = serve(&var s, Request { path: "/users" })
    val ping = serve(&var s, Request { path: "/ping" })
    val free = serve(&var s, Request { path: "/free" })
    if annotated<handler>().at(0).name != "Server.users" { return 1 }
    return login + users + ping + free - 101
}
