//! run: exit 0
//! deps: core, alloc
// The accepted half of val_field_mutable_borrow_rejected.


struct S {
    pub var xs: List<int32>
}

fun add(l: &var List<int32>): void {
    l.push(1)
}

fun main(): int32 {
    var s = S { xs: List.new<int32>() }
    add(&var s.xs)
    if s.xs.size() != 1 { return 1 }
    return 0
}
