//! build: fail
//! deps: core, alloc
// Assigning a captured variable makes the lambda `CallMut0`, so it does not
// satisfy a `Call0` bound.

fun run<F: Call0>(f: F): int32 { return f.call() }

fun main(): int32 {
    var calls = 0
    val got = run(|| {
        calls = calls + 1
        0
    })
    return got + calls
}
