//! run: exit 0
//! deps: core, alloc
extern "C" fun runtime_println(s: str): void
extern "C" fun kf_str_byte_len(s: str): uint64

pub struct Cell {
    var value: int32
}

fun read_cell(cell: &Cell): int32 { return (*cell).value }

fun increment(cell: &var Cell): void {
    (*cell).value = (*cell).value + 1
}

fun string_len(value: &String): uint64 {
    return unsafe { kf_str_byte_len((*value).as_str()) }
}

fun main(): void {
    var cell = Cell { value: 40 }
    increment(cell)
    increment(cell)
    val shared = read_cell(cell)

    val text = String.from("safe")
    val first = string_len(text)
    val second = string_len(text)
    val temporary = string_len(String.from("borrowed"))

    if shared == 42 && first == 4 && second == 4 && temporary == 8 {
        runtime_println("MM1B OK")
    } else {
        runtime_println("MM1B FAIL")
    }
}
