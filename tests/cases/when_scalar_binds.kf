//! run: exit 0
//! deps: core
// A whole-subject binder over a non-enum subject, through a block-scoped
// subject temp.

fun rank(n: int32): int32 {
    when (n) {
        1 => { return 10 }
        other => { return other + 1 }
    }
    return 0
}

fun main(): int32 {
    if rank(1) != 10 { return 1 }
    if rank(5) != 6 { return 2 }
    return 0
}
