//! run: exit 0

// A trait's default method, called on a concrete receiver and through a
// trait object.

trait Answer {
    fun base(): int32
    fun answer(): int32 { return self.base() + 1 }
}

struct Value {
    pub val amount: int32
}

impl Answer for Value {
    fun base(): int32 { return self.amount }
}

fun read(a: &dyn Answer): int32 {
    return a.answer()
}

// A second trait covers the override; two impls of one trait sharing a
// default body is a separate defect.
trait Label {
    fun mark(): int32 { return 7 }
}

struct Plain { val n: int32 }
impl Label for Plain { }

struct Custom { val n: int32 }
impl Label for Custom {
    fun mark(): int32 { return 100 }
}

fun main(): int32 {
    val v = Value { amount: 41 }
    // On a concrete receiver.
    if v.answer() != 42 { return 1 }
    // Through a trait object.
    if read(&v) != 42 { return 2 }
    // A default taken as written, on a concrete receiver.
    val p = Plain { n: 0 }
    if p.mark() != 7 { return 3 }
    // An impl's own body wins.
    val c = Custom { n: 0 }
    if c.mark() != 100 { return 4 }
    return 0
}
