//! build: fail
//! deps: core
// A `mutating` method reached through a bound needs a mutable receiver, as it
// does on a concrete type.

trait Bump {
    mutating fun bump(): void
}

struct C {
    pub var n: int32
}

impl Bump for C {
    mutating fun bump(): void {
        self.n = self.n + 1
    }
}

fun go<T: Bump>(x: T): void {
    val y = x
    y.bump()
}

fun main(): int32 {
    go<C>(C { n: 1 })
    return 0
}
