//! run: exit 0
//! deps: core, alloc
// Kotlin's scope functions are core extensions on a bare type parameter, so
// they apply to every type, the receiver borrowed. A bound on that parameter
// narrows which types an extension applies to, and a bounded one beats an
// unbounded one.

trait Loud {
    fun volume(): int32
}

struct Point {
    var x: int32
}

struct Horn {
    val x: int32
}

impl Loud for Horn {
    fun volume(): int32 { return 9 }
}

fun <T: Loud> T.level(): int32 { return self.volume() }
fun U.level(): int32 { return 1 }

fun main(): int32 {
    val p = Point { x: 5 }
    if p.let(|q| q.x + 1) != 6 { return 1 }
    if p.also(|q| { val _seen = q.x }).x != 5 { return 2 }
    if (7.take_if(|x| *x > 3) ?: 0) != 7 { return 3 }
    if (1.take_if(|x| *x > 3) ?: 0) != 0 { return 4 }
    if (1.take_unless(|x| *x > 3) ?: 0) != 1 { return 5 }

    var m = Point { x: 0 }
    m.apply(|q| { q.x = 8 })
    if m.x != 8 { return 6 }

    val s = String.from("komp")
    if s.let(|v| v.byte_len()) != 4 { return 7 }
    val kept = s.take_if(|v| v.byte_len() > 2) ?: String.from("none")
    if !kept.as_str().equals("komp") { return 8 }
    if 3.let(|v| *v * 2).let(|v| *v + 1) != 7 { return 9 }

    val horn = Horn { x: 0 }
    if horn.level() != 9 { return 10 }
    if p.level() != 1 { return 11 }
    return 0
}
