//! run: exit 0
//! deps: core
// A bound on the subtrait carries the supertrait's methods: `T: Ord2` implies
// `T: Eq2`, which every impl of Ord2 already satisfies. `eq2` is called for
// its value, so a same-shaped wrong method would fail.

trait Eq2 { fun eq2(other: Self): bool }
trait Ord2: Eq2 { fun ord2(other: Self): int32 }

struct Point { var x: int32 }

impl Eq2 for Point { fun eq2(other: Point): bool { return self.x == other.x } }
impl Ord2 for Point { fun ord2(other: Point): int32 { return 0 } }

fun same<T: Ord2>(a: T, b: T): bool { return a.eq2(b) }

fun main(): int32 {
    val p = Point { x: 1 }
    val q = Point { x: 2 }
    if same(p, p) && !same(p, q) { return 0 }
    return 1
}
