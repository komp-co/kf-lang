//! run: exit 0
//! deps: core, alloc
// Inside `impl Holder<T>`, a method calling another that takes a `T` names
// the same symbol a call from outside does; the impl's `T` is not the
// callee's own type parameter. The same holds in a trait impl calling the
// type's own method.

import alloc.list.*

pub struct Holder<T> { pub var item: T }

impl Holder<T> {
    pub mutating fun put(x: T): void { self.item = x }
    pub mutating fun put_via(x: T): void { self.put(x) }
}

trait Sink<T> {
    mutating fun push(item: T): void
}

struct Counter<T> {
    pub var items: List<T>
    pub var own_calls: int32
}

impl Counter<T> {
    pub static fun new(): Counter<T> { return Counter<T> { items: List.new<T>(), own_calls: 0 } }
    pub mutating fun push(item: T): void {
        self.items.push(item)
        self.own_calls = self.own_calls + 1
    }
}

impl Sink<T> for Counter<T> {
    mutating fun push(item: T): void { self.push(item) }
}

fun main(): int32 {
    var h = Holder<String> { item: String.from("a") }
    h.put_via(String.from("bc"))
    if h.item.len() != 2 { return 1 }
    var counter = Counter.new<int32>()
    counter.push(1)
    counter.push(2)
    if counter.own_calls != 2 { return 2 }
    return 0
}
