//! run: exit 0
//! deps: core
// `name = value` binds by name: positional arguments come first, and the
// named ones follow in any order, leaving any defaulted parameter out.

fun window(width: int32, height: int32 = 10, depth: int32 = 1, scale: int32 = 1): int32 {
    return (width * height * depth) * scale
}

fun main(): int32 {
    if window(2, depth = 3) != 60 { return 1 }
    if window(scale = 2, width = 1) != 20 { return 2 }
    if window(width = 1, height = 1, depth = 1, scale = 5) != 5 { return 3 }
    return 0
}
