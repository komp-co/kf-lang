//! run: exit 0
//! deps: core, alloc
// `Type.method` names a method as a value, its receiver first: `&Counter`,
// or `&var Counter` for a mutating method. A static method takes none, and a
// trait impl's method is named the same way.

struct Counter {
    var n: int32
}

trait Shown {
    fun show(): int32
}

impl Counter {
    static fun make(): Counter { return Counter { n: 1 } }
    fun get(): int32 { return self.n }
    mutating fun bump(by: int32): void { self.n = self.n + by }
}

impl Shown for Counter {
    fun show(): int32 { return self.n * 10 }
}

fun main(): int32 {
    val make: () -> Counter = Counter.make
    var c = make()
    val bump: (&var Counter, int32) -> void = Counter.bump
    bump(&var c, 4)
    val get = Counter.get
    val show = Counter.show
    return get(&c) + show(&c) - 55
}
