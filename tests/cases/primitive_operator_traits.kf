//! run: exit 0
//! deps: core

fun main(): int32 {
    val i8a: int8 = 6 as int8
    val i8b: int8 = 3 as int8
    if (i8a & i8b) != (2 as int8) { return 1 }

    val i16a: int16 = 8 as int16
    val i16b: int16 = 1 as int16
    if (i16a >> i16b) != (4 as int16) { return 2 }

    val i32a: int32 = 5
    val i32b: int32 = 7
    if i32a + i32b != 12 { return 3 }

    val i64a: int64 = 3 as int64
    val i64b: int64 = 4 as int64
    if (i64a << i64b) != (48 as int64) { return 4 }

    val u8a: uint8 = 12 as uint8
    val u8b: uint8 = 5 as uint8
    if (u8a ^ u8b) != (9 as uint8) { return 5 }

    val u16a: uint16 = 8 as uint16
    val u16b: uint16 = 1 as uint16
    if (u16a | u16b) != (9 as uint16) { return 6 }

    val u32a: uint32 = 10 as uint32
    val u32b: uint32 = 3 as uint32
    if u32a / u32b != (3 as uint32) { return 7 }

    val u64a: uint64 = 9 as uint64
    val u64b: uint64 = 4 as uint64
    if u64a % u64b != (1 as uint64) { return 8 }

    val f32a: float32 = 8 as float32
    val f32b: float32 = 2 as float32
    if f32a / f32b != (4 as float32) { return 9 }

    val f64a: float64 = 3 as float64
    val f64b: float64 = 2 as float64
    if !(f64a < f64b * (2 as float64)) { return 10 }

    val ca: char = 65 as char
    val cb: char = 66 as char
    if !(ca < cb) { return 11 }
    if true != true { return 12 }
    return 0
}
