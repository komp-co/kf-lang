//! run: exit 42

trait Score {
    fun score(): int32
}

struct Left { pub val value: int32 }
struct Right { pub val value: int32 }

impl Score for Left {
    fun score(): int32 { return self.value }
}

impl Score for Right {
    fun score(): int32 { return self.value }
}

fun read_score(value: &dyn Score): int32 {
    return value.score()
}

fun main(): int32 {
    val left = Left { value: 19 }
    val right = Right { value: 23 }
    return read_score(left) + read_score(right)
}
