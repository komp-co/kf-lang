// `Float` is sealed: a bound on it promises `float32` or `float64`, so no
// other crate may implement it.

struct Fixed {
    val raw: int64
}

impl Float for Fixed {
    static fun pi(): Fixed { return Fixed { raw: 3 } }
    static fun e(): Fixed { return Fixed { raw: 2 } }
    static fun epsilon(): Fixed { return Fixed { raw: 1 } }
}

