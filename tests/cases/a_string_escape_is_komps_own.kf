//! run: exit 21
//! deps: core, alloc
// String and char literals share one escape language, decoded by komp.
//
// komp's `\x` takes exactly two digits; C's is greedy:
//
//     "\x41B".byte_len()      // 2 in komp
//
// Octal is bounded at three digits; `\033` is the renderer's ANSI escape.
// `\0` is the one-digit octal case.
import core.text.*

fun main(): int32 {
    val hexed = "\x41B"                  // A then B, two bytes
    if hexed.byte_len() != 2 { return 90 }
    if hexed.byte_at(0) != 65 { return 91 }
    if hexed.byte_at(1) != 66 { return 92 }

    // Octal, and the ESC the renderer depends on.
    val esc = "\033[1;31mred\033[0m"
    if esc.byte_len() != 14 { return 93 }
    if esc.byte_at(0) != 27 { return 94 }

    // `\0` is not asserted: an embedded NUL does not survive `String.from`.

    // The set a string and a char share.
    if '\x41' != 'A' { return 97 }
    if '\n' != '\012' { return 98 }
    if '\t' != '\011' { return 99 }
    if '\\' != '\134' { return 100 }

    // A char accepts what a string does, and the other way round.
    val named = "\a\b\f\v\r\n\t"
    if named.byte_len() != 7 { return 101 }
    if named.byte_at(0) != 7 { return 102 }
    if named.byte_at(3) != 11 { return 103 }

    // A literal reaches C in C's spelling of the same bytes.
    val quoted = "a\"b\\c"
    if quoted.byte_len() != 5 { return 104 }

    // A control byte before a hex digit: codegen must not spell it `\x`,
    // which C would read greedily. Three-digit octal cannot absorb it.
    val adjacent = "\033abc"
    if adjacent.byte_len() != 4 { return 105 }
    if adjacent.byte_at(0) != 27 { return 106 }
    if adjacent.byte_at(1) != 97 { return 107 }

    return (hexed.byte_len() as int32) + (esc.byte_len() as int32)
         + (named.byte_len() as int32) + (adjacent.byte_len() as int32) - 6
}
