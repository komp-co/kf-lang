//! run: exit 7
//! deps: core

// A function that cannot return satisfies all-paths-return by its type, not
// its name: `panic` is typed `Never`, and `die` returns an enum with no
// variants. `two()` returns an inhabited enum and does not close a function.

import core.panic.*

enum Halt { }

enum Two { A, B }

fun die(m: str): Halt {
    panic(m)
}

fun two(): Two {
    return Two.A
}

/// Closed by `die`, whose return type is uninhabited.
fun pick(n: int32): int32 {
    if n > 0 { return n }
    die("not positive")
}

/// Closed by `panic` directly.
fun must_be_positive(n: int32): int32 {
    if n > 0 { return n }
    panic("not positive")
}

fun main(): int32 {
    // `two` is compiled as the control.
    when (two()) {
        A => { }
        B => { return 99 }
    }
    if must_be_positive(7) != 7 { return 98 }
    return pick(7)
}
