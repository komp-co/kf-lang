//! run: exit 0
//! deps: core, alloc
// Binding `&var local` to a `Ptr<T>` val takes the address, as passing it to a
// `Ptr<T>` parameter does.
extern "C" fun runtime_println(s: str): void

pub struct Node { var v: int32 }

fun get_v(p: Ptr<Node>): int32 { return unsafe { (*p).v } }

fun main(): void {
    var n = Node { v: 42 }
    val p: Ptr<Node> = unsafe { &var n }   // binding position (was rejected)
    val a = get_v(p)
    val b = get_v(unsafe { &var n })        // argument position (already worked)
    if a == 42 {
        if b == 42 { runtime_println("ptr_bind OK") } else { runtime_println("FAIL b") }
    } else { runtime_println("FAIL a") }
}
