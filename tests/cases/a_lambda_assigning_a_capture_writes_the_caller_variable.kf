//! run: exit 22
//! deps: core, alloc

// A lambda that assigns a captured variable borrows it mutably, so the
// caller's variable changes, `String`s included, and the lambda implements
// `CallMut`.

fun twice<F: CallMut0>(f: F): void {
    f()
    f()
}

fun main(): int32 {
    var calls = 0
    var log = String.from("")
    twice(|| {
        calls = calls + 1
        log = log + "x"
        if calls > 1 { calls = calls * 10 }
    })
    return calls + log.byte_len() as int32
}
