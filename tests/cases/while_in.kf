//! run: exit 0
//! deps: core, alloc
// `while x in collection` borrows the container, so `xs` stays usable.
// Move-only elements are yielded as owned copies, clean under ASan.
import alloc.list.*

extern "C" fun runtime_println(s: str): void

fun main(): void {
    var xs = List.new<int32>()
    xs.push(10)
    xs.push(20)
    xs.push(30)

    // basic accumulation
    var sum = 0
    while x in xs {
        sum = sum + x
    }
    if sum == 60 { runtime_println("sum OK") } else { runtime_println("FAIL sum") }

    // break
    var seen = 0
    while x in xs {
        if x == 20 { break }
        seen = seen + 1
    }
    if seen == 1 { runtime_println("break OK") } else { runtime_println("FAIL break") }

    // continue
    var kept = 0
    while x in xs {
        if x == 20 { continue }
        kept = kept + x
    }
    if kept == 40 { runtime_println("continue OK") } else { runtime_println("FAIL continue") }

    // Nested loops.
    var pairs = 0
    while a in xs {
        while b in xs {
            pairs = pairs + 1
        }
    }
    if pairs == 9 { runtime_println("nested OK") } else { runtime_println("FAIL nested") }

    // The iteration borrowed.
    if xs.size() == 3 { runtime_println("borrow OK") } else { runtime_println("FAIL borrow") }

    // Yielded copies are independently owned.
    var names = List.new<String>()
    names.push(String.from("a"))
    names.push(String.from("b"))
    var n = 0
    while s in names {
        n = n + 1
    }
    if n == 2 { runtime_println("move-only OK") } else { runtime_println("FAIL move-only") }
    if names.at(0).as_str().equals("a") { runtime_println("owner-intact OK") } else { runtime_println("FAIL owner-intact") }

    runtime_println("ALL OK")
}
