// Exhaustiveness reaches a borrowed subject's layout.

enum Shape {
    Circle(int32)
    Square(int32)
    Empty
}

fun area(s: &Shape): int32 {
    when (s) {
        Circle(r) => { return r }
        Square(w) => { return w }
    }
    return 0
}

fun main(): int32 {
    val c = Shape.Circle(3)
    return area(&c)
}
