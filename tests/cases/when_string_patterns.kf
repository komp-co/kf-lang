//! run: exit 0
//! deps: core, alloc
// A string literal arm compares by value, over a `str`, a `String`, or a
// borrow of one, and may carry its own guard.

fun of_str(s: str): int32 {
    return when s {
        "get" => 1
        "put" => 2
        _ => 0
    }
}

fun of_string(s: String): int32 {
    return when s {
        "get" => 1
        "" => 3
        other => other.byte_len() as int32 + 10
    }
}

fun of_borrow(s: &String, loud: bool): int32 {
    when s {
        "get" if loud => return 4
        "get" => return 1
        _ => return 0
    }
    return 9
}

fun main(): int32 {
    if of_str("get") != 1 { return 1 }
    if of_str("put") != 2 { return 2 }
    if of_str("ge") != 0 { return 3 }
    if of_str("gets") != 0 { return 4 }
    if of_string(String.from("get")) != 1 { return 5 }
    if of_string(String.from("")) != 3 { return 6 }
    if of_string(String.from("abcd")) != 14 { return 7 }
    val owned = String.from("get")
    if of_borrow(&owned, true) != 4 { return 8 }
    if of_borrow(&owned, false) != 1 { return 9 }
    if owned.byte_len() != 3 { return 10 }
    return 0
}
