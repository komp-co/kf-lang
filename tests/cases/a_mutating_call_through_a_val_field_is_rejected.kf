//! build: fail
//! deps: core
// A `val` field is not a mutable receiver, whatever its owner: `s` is `var`,
// but `inner` is not.

struct Inner {
    var k: int32
}

impl Inner {
    mutating fun bump(): void { self.k = self.k + 1 }
}

struct S {
    pub val inner: Inner
}

fun main(): int32 {
    var s = S { inner: Inner { k: 1 } }
    s.inner.bump()
    return 0
}
