//! run: exit 0
//! deps: core, alloc
// Every slot giving `null` a type keeps working: an annotation in either
// direction, a reassignment, an argument and a return.

fun optional_arg(v: int32?): int32 {
    if v.is_none() { return 0 }
    return 1
}

fun optional_return(): String? {
    return null
}

fun main(): int32 {
    val a: int32? = null
    if !a.is_none() { return 1 }

    var b: int32? = null
    b = 5
    b = null
    if !b.is_none() { return 2 }

    if optional_arg(null) != 0 { return 3 }
    if !optional_return().is_none() { return 4 }
    return 0
}
