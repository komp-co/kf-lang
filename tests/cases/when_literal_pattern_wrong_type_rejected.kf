//! build: fail
// An integer pattern cannot compare against a `str`.
//
// CONSTRAINT: `build: fail` cannot tell a typecheck diagnostic from a C error,
// so the message is asserted by the kf-typecheck unit test
// `an_integer_pattern_on_a_str_is_rejected`.

fun main(): int32 {
    val s = "abc"
    return when s {
        1 => 5
        _ => 0
    }
}
