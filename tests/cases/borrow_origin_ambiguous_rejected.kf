//! build: fail
// A returned borrow's origin is one parameter, read off the signature. With
// two candidates it cannot be written, so the signature is rejected: `pick`
// is, though its body only returns `a`. `first` returns an owned value and is
// unaffected.

struct Value { pub val amount: int32 }

fun pick(a: &Value, b: &Value): &Value {
    return a
}

fun first(a: &Value, b: &Value): int32 {
    return (*a).amount
}

fun main(): int32 {
    return 0
}
