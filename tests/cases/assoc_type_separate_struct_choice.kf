//! run: exit 9
// An associated type bound to a struct, through a generic owner: the choice
// is crate-qualified like any struct. A primitive is spelled the same in every
// crate and would not catch this.
struct Cursor { pub val n: int32 }

trait Producer {
    type Out
}

struct Widget { pub val v: int32 }

impl Producer for Widget {
    type Out = Cursor
}

fun grab<C: Producer>(c: C): C.Out {
    return Cursor { n: 9 }
}

fun main(): int32 {
    val w = Widget { v: 1 }
    val c = grab<Widget>(w)
    return c.n
}
