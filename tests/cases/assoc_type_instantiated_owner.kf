//! run: exit 5
// An owner written with its type arguments keys the instance, `Wrap__int32`,
// not the template, whose `type Out = T` would put a bare `T` in C.
trait Producer {
    type Out
}

struct Wrap<T> { pub val v: T }

impl Producer for Wrap<T> {
    type Out = T
}

fun direct(w: Wrap<int32>): Wrap<int32>.Out {
    return 5
}

fun main(): int32 {
    val w = Wrap<int32> { v: 1 }
    return direct(w)
}
