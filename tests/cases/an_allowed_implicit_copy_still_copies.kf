//! run: exit 0
//! deps: core, alloc
// `@allow(implicit_copy)` silences the advisory; the copy is still inserted,
// so the container keeps its element.

import alloc.string.*

@derive(Clone)
pub struct Tag { pub var name: String }

fun length_of(t: Tag): uint64 { return t.name.byte_len() }

@allow(implicit_copy)
fun read_twice(tags: &List<Tag>): uint64 {
    // Each is a move-out-of-borrow into a by-value sink.
    val first = length_of(*tags.at(0))
    val second = length_of(*tags.at(0))
    return first + second
}

fun main(): int32 {
    var tags = List.new<Tag>()
    tags.push(Tag { name: String.from("komp") })

    if read_twice(&tags) != 8 { return 1 }

    // The reads above copied.
    if tags.at(0).name.byte_len() != 4 { return 2 }
    if !tags.at(0).name.as_str().equals("komp") { return 3 }
    return 0
}
