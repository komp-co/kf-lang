//! run: exit 0
//! deps: core
// A local function shadows a core one of the same name, so adding to core
// never breaks a program already using the name.

// Same name as core's, different arity and meaning.
fun clamp(v: int32): int32 {
    if v > 100 { return 100 }
    return v
}

// The same arity as core's, so the definition must win, not argument counting.
fun lerp(a: float64, b: float64, t: float64): float64 {
    return 42.0
}

fun main(): int32 {
    // The local one, not core's.
    if clamp(250) != 100 { return 1 }
    if clamp(7) != 7 { return 2 }
    if lerp(0.0, 10.0, 0.5) != 42.0 { return 3 }

    // A core function not defined here is still reachable.
    if max<int32>(3, 7) != 7 { return 4 }
    if abs(-2.5) != 2.5 { return 5 }
    if round(2.5) != 3.0 { return 6 }

    // Core's own callers still get core's.
    if min<int32>(4, 9) != 4 { return 7 }
    return 0
}
