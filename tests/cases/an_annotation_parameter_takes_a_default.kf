//! run: exit 0
//! deps: core, alloc
// A use leaves out any annotation parameter with a default; the query's
// `args` holds the default there.

annotation bench(iterations: int32 = 100, label: String = "bench")

@bench
fun quick(): void {}

@bench(label = "slow")
fun slow(): void {}

@bench(5)
fun five(): void {}

fun main(): int32 {
    val all = annotated<bench>()
    if all[0].args.iterations != 100 || all[0].args.label != "bench" { return 1 }
    if all[1].args.iterations != 100 || all[1].args.label != "slow" { return 2 }
    if all[2].args.iterations != 5 { return 3 }
    return 0
}
