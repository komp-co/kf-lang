//! run: exit 7
//! deps: core
// `Self { ... }` inside an impl names the crate-qualified struct under
// separate compilation. Only a real build sees it.

pub struct P { pub val x: int32 }

impl P {
    pub fun with_self(v: int32): Self { return Self { x: v } }
    pub fun with_name(v: int32): P    { return P { x: v } }
}

fun main(): int32 {
    val seed = P { x: 0 }
    val a = seed.with_self(3)
    val b = seed.with_name(4)
    return a.x + b.x
}
