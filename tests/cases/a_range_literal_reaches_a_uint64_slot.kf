//! run: exit 31
//! deps: core, alloc
// A range literal is typed by the slot it flows into, not by its
// integer-literal endpoints:
//
//   * `total(0..4)`: expected-type propagation into a parameter.
//   * `b[0..2]`: instance dispatch, arriving as `b.index(range(0, 2, 1))`
//     with the argument already typed; `Index<Range<uint64>>` must apply.
//   * `Measure.of(0..5)`: static trait dispatch, a separate path.
import core.range.*
import alloc.list.*

struct Bag { pub var xs: List<int32> }

impl Index<uint64> for Bag {
    type Out = int32
    fun index(k: uint64): &Self.Out { return self.xs.at(k) }
}

impl Index<Range<uint64>> for Bag {
    type Out = List<int32>
    fun index(k: Range<uint64>): &Self.Out { return &self.xs }
}

pub trait Span { static fun of(r: Range<uint64>): uint64 }

pub struct Measure { pub var n: uint64 }

impl Span for Measure {
    static fun of(r: Range<uint64>): uint64 {
        var sum: uint64 = 0
        while i in r { sum = sum + i }
        return sum
    }
}

fun total(r: Range<uint64>): uint64 {
    var sum: uint64 = 0
    while i in r { sum = sum + i }
    return sum
}

fun main(): int32 {
    var b = Bag { xs: List.new<int32>() }
    b.xs.push(7)
    b.xs.push(8)
    val one: int32 = b[0]
    val whole: List<int32> = b[0..2]
    val a = total(0..4)                  // 0+1+2+3   = 6
    val c = total(1..=3)                 // 1+2+3     = 6, and inclusive too
    val d = Measure.of(0..5)             // 0+1+2+3+4 = 10
    //     7  +  2  +  6 + 6  +  10 = 31
    return one + (whole.size() as int32) + ((a + c + d) as int32)
}
