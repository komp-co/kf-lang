//! run: exit 0
//! deps: core

// `void` is a type with exactly one value: a payload keeps its slot and holds
// a unit. Return position erases it, as Rust does with `()`.

pub struct Counter {
    pub var n: int32
}

pub enum Holder<T> {
    Full(T)
    Empty
}

impl Holder<T> {
    // A generic body reading its payload; at `T = void` the binder holds the
    // unit.
    pub fun read_payload(): int32 {
        when (self) {
            Full(v) => {
                val _x = v
                return 1
            }
            Empty => { }
        }
        return 0
    }

    // A binder may be omitted, so `Result<void, E>` writes `Ok =>`.
    pub fun read_without_binder(): int32 {
        when (self) {
            Full => { return 1 }
            Empty => { }
        }
        return 0
    }
}

fun bump(c: &var Counter): void {
    c.n = c.n + 1
}

fun main(): int32 {
    // The call happens; the unit is what it yields.
    var c = Counter { n: 0 }
    val _u: void = bump(&var c)
    if c.n != 1 { return 1 }

    // The `Full` arm is reachable at `void`.
    val full: Holder<void> = Holder.Full<void>(_u)
    if full.read_payload() != 1 { return 3 }
    if full.read_without_binder() != 1 { return 4 }

    val empty: Holder<void> = Holder.Empty
    if empty.read_payload() != 0 { return 5 }

    // The same template at a normal payload type still works.
    val n: Holder<int32> = Holder.Full<int32>(7)
    if n.read_payload() != 1 { return 6 }

    return 0
}
