//! build: fail
//! deps: core
// Nothing says what `Bag.make()` is over: no type argument, no value argument
// and no slot. The same call with a slot is
// `an_empty_generic_static_call_takes_its_type_from_its_slot.kf`.
//
// CONSTRAINT: `build: fail` cannot tell a typecheck diagnostic from a C error,
// so the message is asserted by `an_open_generic_static_call_is_reported` in
// kf-typecheck.

struct Bag<T> {
    pub var n: uint64
}

impl Bag<T> {
    static fun make(): Bag<T> {
        return Bag<T> { n: 0 }
    }
}

fun main(): int32 {
    val b = Bag.make()
    if b.n != 0 { return 1 }
    return 0
}
