//! run: exit 0
//! deps: core, alloc, std

// A String smoke test returning the number of the first failing check.

fun main(): int32 {
    // from / append / equals
    var b = String.from("foo")
    b.append("bar")
    if !b.equals("foobar") { return 1 }

    // `clone()` re-allocates: mutating the source leaves the copy.
    var f = String.from("orig")
    val g = f.clone()
    f.append("X")
    if !g.equals("orig") { return 2 }
    if !f.equals("origX") { return 3 }

    // Repeated append, through realloc.
    var grow = ""
    var i: uint64 = 0
    while i < 100 {
        grow.append("ab")
        i = i + 1
    }
    if grow.len() != 200 { return 4 }

    // The empty String: valid, drop-safe, `as_str()` is "".
    val empty = ""
    if empty.len() != 0 { return 5 }
    if !empty.equals("") { return 6 }

    // `+` builds a fresh owned String from borrows.
    val cc = String.from("ab") + String.from("cd")
    if !cc.equals("abcd") { return 7 }
    val base = String.from("x")
    val ch = base + String.from("yz")
    if !ch.equals("xyz") { return 8 }

    // List<String>: push, size, and a method on the borrowed element.
    var xs = List.new<String>()
    xs.push(String.from("a"))
    xs.push(String.from("b"))
    if xs.size() != 2 { return 9 }
    val el = xs.at(1)
    if !el.equals("b") { return 10 }

    // A missing file gives an empty owned String, not a null box.
    val content = File.read("tests/cases/string_value.kf").unwrap_or("")
    if content.len() == 0 { return 11 }
    val missing = File.read("no/such/file").unwrap_or("")
    if missing.len() != 0 { return 12 }

    return 0
}
