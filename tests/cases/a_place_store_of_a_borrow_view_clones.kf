//! run: exit 0
//! deps: core, alloc
// `*xs.at_mut(0) = *xs.at(1)` reads a view the list still owns. Stored without
// a clone both slots name one buffer and the list's drop frees it twice.

import core.display.*

fun main(): int32 {
    var names = List.new<String>()
    names.push(String.from("aaaaaaaaaaaaaaaaaaaa"))
    names.push(String.from("bbb"))
    *(names.at_mut(0)) = *(names.at(1))
    if !names.at(0).as_str().equals("bbb") { return 1 }
    if !names.at(1).as_str().equals("bbb") { return 2 }
    return 0
}
