//! run: exit 6
//! deps: core, alloc
// Once the extension's borrow is no longer read, its receiver may change.

fun String.peek(): str { return self.as_str() }

fun main(): int32 {
    var owned = String.from("hello")
    val v = owned.peek()
    val n = v.byte_len()
    owned.append("!")
    return owned.byte_len() as int32 + (n - n) as int32
}
