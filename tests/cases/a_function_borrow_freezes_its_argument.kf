//! build: fail
//! deps: core, alloc
// A free function returning a borrow borrows its one borrow argument.

fun first_word(text: &String): str { return text.as_str() }

fun main(): int32 {
    var owned = String.from("hello")
    val v = first_word(&owned)
    owned.append("!")
    return v.byte_len() as int32
}
