//! run: exit 0
//! deps: core
// Stores the field's type accepts: a payload wrapped in `Some`, `null`, a
// literal at the field's width, and a store through a pointer.

struct Inner {
    pub var n: int64
}

struct Holder {
    pub var maybe: int32?
    pub var wide: int64
    pub var inner: Inner
}

fun main(): int32 {
    var h = Holder { maybe: null, wide: 0, inner: Inner { n: 0 } }
    h.maybe = 5
    h.wide = 3000000000
    h.inner.n = 6000000000
    val p: Ptr<int64> = unsafe { alloc<int64>() }
    unsafe { *p = h.wide }
    if unsafe { *p } != 3000000000 { return 1 }
    if h.maybe != 5 { return 2 }
    h.maybe = null
    if h.maybe != null { return 3 }
    if h.inner.n != 6000000000 { return 4 }
    return 0
}
