//! run: exit 2
//! deps: core

trait Bump {
    mutating fun bump(): void
    fun value(): int32
}

struct C {
    pub var n: int32
}

impl Bump for C {
    mutating fun bump(): void {
        self.n = self.n + 1
    }

    fun value(): int32 {
        return self.n
    }
}

fun go<T: Bump>(x: T): int32 {
    var y = x
    y.bump()
    return y.value()
}

fun main(): int32 {
    return go<C>(C { n: 1 })
}
