//! run: exit 42
// Every placement a `&dyn Trait` is allowed in: a local annotation, a
// parameter, a return, and the arms of a conditional. A struct field is not;
// borrow_not_storable.kf asserts that.

trait Score { fun score(): int32 }

struct Value { pub val amount: int32 }
impl Score for Value { fun score(): int32 { return self.amount } }

fun borrow(value: &Value): &dyn Score { return value }
fun read(value: &dyn Score): int32 { return value.score() }

fun main(): int32 {
    val left = Value { amount: 20 }
    val right = Value { amount: 22 }
    val local: &dyn Score = left
    val returned = borrow(right)
    val chosen: &dyn Score = if true { local } else { returned }
    return read(chosen) + returned.score()
}
