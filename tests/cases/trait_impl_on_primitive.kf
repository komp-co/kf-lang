//! run: exit 0
//! deps: core
// A trait method dispatched on a primitive receiver inside a generic body
// calls the impl's symbol: `int32_twin__Twin` with no crate prefix, and
// `int32_clone_user` with its type prefix.
import core.assert.*

pub trait Twin {
    fun twin(): Self
}

impl Twin for int32 {
    fun twin(): int32 {
        return self
    }
}

// `copy_of(&9)` below reaches core's `impl Clone for int32`.

pub struct Holder {
    pub val n: int32
}

impl Clone for Holder {
    fun clone(): Holder {
        return Holder { n: self.n }
    }
}

fun twin_of<T: Twin>(v: &T): T {
    return v.twin()
}

fun copy_of<T: Clone>(v: &T): T {
    return v.clone()
}

fun main(): int32 {
    assert(twin_of(&7) == 7, "a custom trait on a primitive dispatches")
    assert(copy_of(&9) == 9, "and so does Clone, whose name codegen reserves")
    assert(copy_of(&Holder { n: 4 }).n == 4, "the struct route still works")
    return 0
}
