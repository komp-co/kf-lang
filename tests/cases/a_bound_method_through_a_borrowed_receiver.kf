//! run: exit 30
//! deps: core
// A trait method reached through a `<W: Sink>` bound when the receiver is a
// borrow, `&W`: the call must use the trait-suffixed symbol.

pub trait Sink {
    fun width(): uint64
    mutating fun bump(k: uint64): void
}

struct Counter { pub var n: uint64 }

impl Sink for Counter {
    fun width(): uint64 { return self.n + 3 }
    mutating fun bump(k: uint64): void { self.n = self.n + k }
}

fun shared<W: Sink>(out: &W): uint64 { return out.width() }

fun mutable<W: Sink>(out: &var W): uint64 {
    out.bump(4)
    return out.width()
}

fun by_value<W: Sink>(out: W): uint64 { return out.width() }

fun main(): int32 {
    var c = Counter { n: 0 }
    val a = shared(&c)          // 3
    val b = mutable(&var c)     // n = 4, so 7
    val d = by_value(c)         // 7
    val e = shared(&c)          // 7
    return (a + b + d + e + 6) as int32   // 30
}
