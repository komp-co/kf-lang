//! run: exit 0
//! deps: core
import core.assert.*

@derive(Equal)
enum Token {
    End
    Pair(int32, int32)
    Flag(bool)
}

fun main(): void {
    assert_eq(Token.End == Token.End, true, "derived equality matches payload-free variants")
    assert_eq(Token.Pair(1, 2) == Token.Pair(1, 2), true, "derived equality compares every payload")
    assert_eq(Token.Pair(1, 2) != Token.Pair(1, 3), true, "derived equality rejects a mismatched payload")
    assert_eq(Token.Pair(1, 2) != Token.Flag(true), true, "derived equality rejects different variants")
}
