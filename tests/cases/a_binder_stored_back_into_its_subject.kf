//! run: exit 3
//! deps: core, alloc
// Growing a binder in place and storing it back into its own subject, as
// code written for copying binders does, keeps one list and frees it once.

import alloc.list.*

enum Kind {
    Items(List<String>)
    Nothing
}

struct Node {
    var kind: Kind
}

fun grow(xs: &var List<String>): void { xs.push(String.from("more")) }

impl Node {
    mutating fun fill(): void {
        when (self.kind) {
            Items(xs) => {
                grow(&var xs)
                self.kind = Kind.Items(xs)
            }
            Nothing => {}
        }
    }
}

fun main(): int32 {
    var items = List.new<String>()
    items.push(String.from("one"))
    var n = Node { kind: Kind.Items(items) }
    n.fill()
    n.fill()
    return when (n.kind) {
        Items(xs) => xs.size() as int32
        Nothing => 0
    }
}
