//! run: exit 8
//! deps: core, alloc
// A receiver introduces its type parameters, and a list before the receiver
// bounds them: `fun <T: Add> Iterable<T>.sum()`.


trait Loud { fun volume(): int32 }

struct Horn { val x: int32 }

impl Loud for Horn {
    fun volume(): int32 { return 3 }
}

fun <T: Add> Iterable<T>.total(zero: T): T {
    var sum = zero
    while x in self {
        sum = sum + x
    }
    return sum
}

fun <T: Loud> T.level(): int32 { return self.volume() }

// The receiver's parameter and the function's own, each in its own list.
fun <T: Clone> List<T>.first_or<U>(fallback: T, marker: U): T {
    val _m = marker
    while x in self { return x.clone() }
    return fallback
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(3)
    val horn = Horn { x: 0 }
    return xs.total(0) + horn.level() + xs.first_or(0, true)
}
