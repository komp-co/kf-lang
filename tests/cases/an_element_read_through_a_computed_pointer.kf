//! run: exit 0
//! deps: core, alloc
// A by-value read through a computed pointer is a read through a borrow, as
// `*p` is: returning one copies it, so the caller and the owner each free
// their own buffer. A missed copy is a double free, which aborts.

import alloc.string.*
import alloc.list.*

struct Bag {
    pub var data: Ptr<String>
    pub var len: uint64
}

impl Bag {
    fun fetch(i: uint64): String {
        return unsafe { *(self.data + i) }
    }
    fun peek(i: uint64): &String {
        return unsafe { &*(self.data + i) }
    }
}

fun main(): int32 {
    var xs = List.new<String>()
    xs.push(String.from("a-string-long-enough-to-own-its-buffer"))

    val bag = Bag { data: xs.at(0) as Ptr<String>, len: 1 }

    val owned = bag.fetch(0)
    if !owned.as_str().equals("a-string-long-enough-to-own-its-buffer") { return 1 }

    val borrowed = bag.peek(0)
    if !borrowed.as_str().equals("a-string-long-enough-to-own-its-buffer") { return 2 }

    if !xs.at(0).as_str().equals("a-string-long-enough-to-own-its-buffer") { return 3 }
    return 0
}
