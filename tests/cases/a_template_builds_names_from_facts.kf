//! run: exit 0
//! deps: core
// A name written with `${...}` is built from facts, so what a template adds
// is named after the struct it marks, and two marked structs do not collide.

annotation summarized(verb: str) on struct

template summarized on struct T {
    struct ${T.name}Summary {
        val count: int64
    }

    fun T.${args.verb}_summary(): ${T.name}Summary {
        var total: int64 = 0
        while field in T.fields {
            val ${field.name}_seen: int64 = 1
            total = total + ${field.name}_seen
        }
        return ${T.name}Summary { count: total }
    }
}

@summarized("make")
struct Point {
    val x: int32
    val y: int32
}

@summarized("take")
struct Size {
    val width: int32
    val height: int32
    val depth: int32
}

fun main(): int32 {
    val p: PointSummary = Point { x: 1, y: 2 }.make_summary()
    val s: SizeSummary = Size { width: 1, height: 2, depth: 3 }.take_summary()
    return (p.count + s.count - 5) as int32
}
