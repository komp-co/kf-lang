//! run: exit 0
//! deps: core
// A generic ctor's type arguments come from the expected type. It resolves
// against the template first, where the payload checks stay silent.

enum Res<T> {
    Ok(T)
    Bad
}

fun unwrap_it(r: Res<int32>): int32 {
    when (r) {
        Ok(v) => { return v }
        Bad => { return -1 }
    }
    return 0
}

fun main(): int32 {
    val a: Res<int32> = Res.Ok(7)
    if unwrap_it(a) != 7 { return 1 }
    val b: Res<int32> = Res.Bad
    if unwrap_it(b) != -1 { return 2 }
    return 0
}
