//! run: exit 9
// A `when` whose only arm is the catch-all discriminates nothing: the arm runs
// with no switch emitted. For an enum and a struct subject. Happens while
// editing a `when` down to one arm.
enum Shape {
    Dot
    Line(int32)
}

struct Point { pub var x: int32 }

fun describe(s: Shape): int32 {
    when (s) {
        _ => { return 4 }
    }
    return 0
}

fun whole(s: Shape): int32 {
    // A whole-subject binder still needs the subject named.
    when (s) {
        other => {
            when (other) {
                Line(n) => { return n }
                _ => { return 2 }
            }
        }
    }
    return 0
}

fun anything(p: Point): int32 {
    when (p) {
        _ => { return 3 }
    }
    return 0
}

fun main(): int32 {
    return describe(Shape.Dot) + whole(Shape.Line(2)) + anything(Point { x: 0 })
}
