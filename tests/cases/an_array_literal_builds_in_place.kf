//! run: exit 0
//! deps: core, alloc
// `[...]` where an `Array<T, N>` is expected builds the array in place, its
// elements checked against `T`; where `Array<T, N>?` is, it is wrapped too.

fun first(xs: &Array<String, 2>): String { return xs[0].clone() }

fun main(): int32 {
    val nums: Array<int32, 3> = [1, 2, 3]
    val words: Array<String, 2> = [String.from("a"), String.from("b")]
    val maybe: Array<int32, 2>? = [4, 5]
    if nums[0] + nums[2] != 4 { return 1 }
    if first(&words) != String.from("a") { return 2 }
    if (maybe ?: [0, 0])[1] != 5 { return 3 }
    return 0
}
