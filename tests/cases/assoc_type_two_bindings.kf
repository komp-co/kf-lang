//! run: exit 3
// Two impls each binding an associated type: a binding emits no C, so two
// cannot collide.
trait Producer {
    type Out
}

struct A { pub val v: int32 }
struct B { pub val v: int32 }

impl Producer for A {
    type Out = int32
}

impl Producer for B {
    type Out = int32
}

fun main(): int32 {
    val a = A { v: 1 }
    val b = B { v: 2 }
    return a.v + b.v
}
