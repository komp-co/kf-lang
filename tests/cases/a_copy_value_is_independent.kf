//! run: exit 12
//! deps: core
// A `Copy` value read out of a place leaves the place intact.

@derive(Copy)
struct Point { pub var x: int32, pub var y: int32 }

fun shifted(p: Point): Point {
    var q = p
    q.x = q.x + 1
    return q
}

fun main(): int32 {
    val p = Point { x: 1, y: 2 }
    val q = shifted(p)
    return p.x * 10 + q.x
}
