//! run: exit 42
//! deps: core
// The Call trait family's shape in miniature: `Out` is declared on the
// required trait and named through the requiring trait's bound, as `F.Out`
// and as `Self.Out` in the subtrait's signature. Not `Call1`, which core
// declares.

trait ApplyMut1<A> {
    type Out
    mutating fun apply_mut(a: A): Self.Out
}

trait Apply1<A>: ApplyMut1<A> {
    fun apply(a: A): Self.Out
}

struct Doubler { val k: int32 }

impl ApplyMut1<int32> for Doubler {
    type Out = int32
    mutating fun apply_mut(a: int32): Self.Out { return a * self.k }
}

impl Apply1<int32> for Doubler {
    fun apply(a: int32): Self.Out { return a * self.k }
}

fun run<F: Apply1<int32>>(f: F, x: int32): F.Out {
    return f.apply(x)
}

fun main(): int32 {
    val d = Doubler { k: 3 }
    return run(d, 14)
}
