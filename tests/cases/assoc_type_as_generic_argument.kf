//! run: exit 0
//! deps: core

// An associated type as a generic argument, `Wrap<Self.Out>`, is read through
// the impl's binding: the projection folded into the instance name is
// unfolded. `take` covers a parameter position.

pub struct Wrap<O> {
    val item: O
}

trait Producer {
    type Out
    fun make(): Wrap<Self.Out>
    fun take(w: Wrap<Self.Out>): int32
}

struct Counter {
    val n: int32
}

impl Producer for Counter {
    type Out = int32
    fun make(): Wrap<int32> {
        return Wrap<int32> { item: self.n + 1 }
    }
    fun take(w: Wrap<int32>): int32 {
        return w.item
    }
}

fun main(): int32 {
    val c = Counter { n: 41 }
    val w = c.make()
    if c.take(w) == 42 { return 0 }
    return 1
}
