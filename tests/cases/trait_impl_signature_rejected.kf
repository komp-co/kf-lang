//! build: fail
//! deps: core
// An impl's method must have the trait's signature, not just its name and
// arity: the dyn adapter converts silently where they disagree. `Good`,
// `Spelled` and `Renamed` stay legal, including an associated type spelled
// the trait's way or the impl's.

trait Score {
    fun value(n: int32): int32
}

struct WrongParam { pub var n: int32 }
struct WrongReturn { pub var n: int32 }
struct WrongBoth { pub var n: int32 }
struct Good { pub var n: int32 }

impl Score for WrongParam {
    fun value(n: bool): int32 { return 1 }
}

impl Score for WrongReturn {
    fun value(n: int32): bool { return true }
}

impl Score for WrongBoth {
    fun value(n: int64): int64 { return n }
}

impl Score for Good {
    fun value(n: int32): int32 { return n + self.n }
}

// An associated type is one type with two spellings, and both are accepted.
struct Cursor { pub val n: int32 }

trait Producer {
    type Out
    fun make(): Self.Out
}

struct Spelled { pub val v: int32 }
struct Renamed { pub val v: int32 }

impl Producer for Spelled {
    type Out = Cursor
    fun make(): Self.Out { return Cursor { n: 1 } }
}

impl Producer for Renamed {
    type Out = Cursor
    fun make(): Cursor { return Cursor { n: 2 } }
}

fun main(): int32 {
    return 0
}
