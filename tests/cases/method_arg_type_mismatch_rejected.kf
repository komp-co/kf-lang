//! deps: core

struct Alpha { pub val value: int32 }
struct Beta { pub val value: int32 }
struct Holder { pub var value: int32 }

impl Holder {
    pub mutating fun set(value: Beta): void { self.value = value.value }
}

fun main(): int32 {
    var holder = Holder { value: 0 }
    holder.set(Alpha { value: 1 })
    return 0
}
