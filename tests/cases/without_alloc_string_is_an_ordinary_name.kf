//! run: exit 0
//! deps: core
// The language's string is the type marked `@lang("string")`; without alloc,
// a program may declare its own `String`.

struct String {
    pub val units: int32
}

fun main(): int32 {
    val s = String { units: 3 }
    if s.units != 3 { return 1 }
    // A bare literal stays `str`.
    val t = "abc"
    if t.byte_len() != 3 { return 2 }
    return 0
}
