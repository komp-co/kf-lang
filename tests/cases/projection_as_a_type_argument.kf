//! run: exit 0
//! deps: core, alloc
// A projection as a type argument, `List<F.Out>` and `F.Out?`; two calls at
// impls choosing different members do not collide.

import alloc.list.*

struct Inc { }
impl Call1<int32> for Inc {
    type Out = int32
    fun call(a: int32): int32 { return a + 1 }
}

struct Odd { }
impl Call1<int32> for Odd {
    type Out = bool
    fun call(a: int32): bool { return a % 2 == 1 }
}

fun wrap<A, F: Call1<A>>(f: F, x: A): List<F.Out> {
    var out = List.new<F.Out>()
    out.push(f.call(x))
    return out
}

fun maybe<A, F: Call1<A>>(f: F, x: A): F.Out? {
    return Option.Some<F.Out>(f.call(x))
}

fun main(): int32 {
    val a = wrap<int32, Inc>(Inc { }, 4)
    if a.get(0) != 5 { return 1 }
    val b = wrap<int32, Odd>(Odd { }, 7)
    if !b.get(0) { return 2 }
    when (maybe<int32, Inc>(Inc { }, 9)) {
      Some(v) => { if v != 10 { return 3 } }
      None => return 4
    }
    return 0
}
