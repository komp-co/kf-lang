//! build: fail
//! deps: core, alloc
// While `view` is read, `out` is frozen: appending may reallocate the buffer
// `view` points into, and reassigning drops it. The window runs from binding
// to last use, so `settled` is accepted.

fun reallocated(): int32 {
    var out = String.from("a")
    val view = out.as_str()
    out.append("bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    if view == "a" { return 1 }
    return 0
}

fun replaced(): int32 {
    var out = String.from("a")
    val view = out.as_str()
    out = String.from("b")
    if view == "a" { return 1 }
    return 0
}

fun settled(): int32 {
    var tail = String.from("a")
    val peek = tail.as_str()
    if peek == "a" {
        tail.append("done")
    }
    return 0
}

fun main(): int32 {
    return reallocated() + replaced() + settled()
}
