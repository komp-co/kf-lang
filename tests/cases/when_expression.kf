//! run: exit 0
//! deps: core, alloc
// `when` as a value, end to end: as the whole operand of a `return` and as
// the whole initializer of a binding, over an enum with payloads, over a
// scalar, and at a heap type whose temporary must not be released twice.

extern "C" fun runtime_println(s: str): void

enum Shape { Circle(int32)
             Square(int32) }

fun area(s: Shape): int32 {
    return when (s) {
        Circle(r) => r * 3
        Square(w) => w * w
    }
}

fun rank(k: int32): int32 {
    val r = when (k) {
        1 => 10
        2 => 20
        _ => 0
    }
    return r
}

// The synthesized temporary holds a String before the binding takes it. Only
// the binding carries the release, so a double free would show up here.
fun name(k: int32): String {
    val s = when (k) {
        0 => String.from("zero")
        _ => String.from("other")
    }
    return s
}

fun check(got: int32, want: int32, label: str): void {
    if got == want { runtime_println(label) } else { runtime_println("FAIL") }
}

fun main(): void {
    check(area(Shape.Circle(2)), 6, "payload arm OK")
    check(area(Shape.Square(4)), 16, "second payload arm OK")
    check(rank(1), 10, "scalar arm OK")
    check(rank(9), 0, "scalar default OK")
    var total: int32 = 0
    while i in 0..3 {
        val v = when (i) {
            0 => 1
            _ => 10
        }
        total = total + v
    }
    check(total, 21, "when value in a loop OK")
    runtime_println(name(0).as_str())
    runtime_println(name(5).as_str())
    runtime_println("ALL OK")
}
