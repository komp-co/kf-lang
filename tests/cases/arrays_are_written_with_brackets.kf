//! run: exit 0
//! deps: core, alloc
// `T[N]` is `Array<T, N>`, `T[]` takes its length from its initializer, and
// a function generic over the length takes an array of any length.

import alloc.list.*

@derive(Copy)
struct Pixel {
    val rgb: uint8[3]
}

fun total<N: uint64>(xs: &int32[N]): int32 {
    var sum = 0
    while x in xs { sum = sum + x }
    return sum
}

fun fill<N: uint64>(xs: &var int32[N], value: int32): void {
    while i in 0..xs.size() { xs[i] = value }
}

fun main(): int32 {
    val xs: int32[3] = [1, 2, 3]
    val ys: Array<int32, 3> = xs
    val zs: float64[] = [1.5, 2.5]
    val copied: int32[] = xs
    var grid: int32[2][3] = [[1, 2], [3, 4], [5, 6]]
    grid[2][1] = 7
    var four: int32[4] = [0, 0, 0, 0]
    fill(&var four, 2)
    val p = Pixel { rgb: [1, 2, 3] }
    val q = p
    var rows = List.new<int32[2]>()
    rows.push([5, 6])
    val maybe: int32[2]? = [8, 9]
    if total(&ys) != 6 || zs.size() != 2 || copied[2] != 3 { return 1 }
    if grid[2][1] != 7 || grid.size() != 3 || total(&four) != 8 { return 2 }
    if q.rgb[2] != 3 || rows[0][1] != 6 || (maybe ?: [0, 0])[1] != 9 { return 3 }
    return 0
}
