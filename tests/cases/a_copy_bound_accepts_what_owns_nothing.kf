//! run: exit 9
//! deps: core
// Primitives, raw pointers, a derived Copy enum, and an Option or Result over
// Copy payloads all satisfy `T: Copy`.

@derive(Copy)
enum Dir { North  South }

fun dup<T: Copy>(v: T): T { return v }

fun main(): int32 {
    val n = dup<int32>(2)
    val p: Ptr<int32> = unsafe { 0 as Ptr<int32> }
    val q = dup<Ptr<int32>>(p)
    val d = dup<Dir>(Dir.South)
    val o: Option<int32> = 3
    val a = dup<Option<int32>>(o) ?: 0
    val r = dup<Result<int32, bool>>(Result.Ok<int32, bool>(4))
    val b = when (r) { Ok(v) => v  Err(_) => 0 }
    val s = when (d) { North => 0  South => 0 }
    return n + a + b + s
}
