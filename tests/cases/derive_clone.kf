//! run: exit 0
//! deps: core, alloc

@derive(Clone)
struct Holder { var name: String }

fun duplicate<T: Clone>(value: T): T {
    return value.clone()
}

fun main(): int32 {
    var original = Holder { name: String.from("deep") }
    val copy = duplicate(original)
    original.name.append(" copy")
    if copy.name.equals("deep") { return 0 }
    return 1
}
