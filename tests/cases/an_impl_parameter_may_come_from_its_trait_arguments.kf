//! run: exit 79
//! deps: core
// `N` appears only in the trait's arguments, so each length is its own
// instantiation of the impl: one `from` per array length passed, and one
// `absorb` per length absorbed.

struct Row<T> {
    var data: Ptr<T>
    var len: uint64
}

impl<T, N: uint64> From<T[N]> for Row<T> {
    static fun from(items: T[N]): Row<T> {
        val data = unsafe { alloc_array<T>(N) }
        unsafe { *(data as Ptr<T[N]>) = items }
        return Row<T> { data: data, len: N }
    }
}

struct Tally {
    var total: int64
}

trait Absorb<X> {
    mutating fun absorb(items: X): void
}

impl<N: uint64> Absorb<int64[N]> for Tally {
    mutating fun absorb(items: int64[N]): void {
        while x in items { self.total = self.total + x }
    }
}

fun main(): int32 {
    val three: int64[3] = [1, 2, 3]
    val row = Row.from(three)
    val pair: int32[2] = [7, 8]
    val other: Row<int32> = Row.from(pair)
    var t = Tally { total: 0 }
    val a: int64[2] = [1, 2]
    val b: int64[3] = [10, 20, 30]
    t.absorb(a)
    t.absorb(b)
    val last = unsafe { *(row.data + 2) } as int32 + unsafe { *(other.data + 1) }
    return last + row.len as int32 + other.len as int32 + t.total as int32
}
