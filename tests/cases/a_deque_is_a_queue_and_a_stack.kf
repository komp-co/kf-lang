//! run: exit 12
//! deps: core, alloc
// One deque serves as a queue (push at the back, pop at the front) and a
// stack (push and pop at the back), owning elements of any type.

fun main(): int32 {
    var queue = Deque.new<String>()
    queue.push_back(String.from("a"))
    queue.push_back(String.from("bb"))
    queue.push_back(String.from("ccc"))
    val first = queue.pop_front()!!
    var stack = Deque.new<int32>()
    while i in 0..20 { stack.push_back(i) }
    val top = stack.pop_back()!!
    return first.byte_len() as int32 * 10 + queue.size() as int32 + top - 19
}
