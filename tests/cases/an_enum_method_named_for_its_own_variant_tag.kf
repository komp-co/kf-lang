//! run: exit 0
//! deps: core
// Variant constants are emitted under the reserved `kf__` prefix, so a method
// named `Tag_<V>` does not collide with them.

pub enum Holder { Full(int32)  Empty }

impl Holder {
    pub fun Tag_Full(): int32 { return 7 }
    pub fun Tag_Empty(): int32 { return 9 }
}

fun payload(h: Holder): int32 {
    return when (h) {
        Full(n) => n
        Empty => 0
    }
}

fun main(): int32 {
    val full = Holder.Full(1)
    // The method with the enumerator's old spelling.
    if full.Tag_Full() != 7 { return 1 }
    if full.Tag_Empty() != 9 { return 2 }
    // The construction and the `when` reading the tag back.
    if payload(full) != 1 { return 3 }
    if payload(Holder.Empty) != 0 { return 4 }
    return 0
}
