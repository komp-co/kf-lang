//! run: exit 0
//! deps: core, alloc
// An unannotated literal takes its type from its first use, when that use has
// one: `i` compares with `xs.size()` as a uint64.

fun wide(n: uint64): uint64 {
    return n
}

fun main(): int32 {
    var xs = List.new<uint64>()
    xs.push(1)
    xs.push(2)
    xs.push(3)

    var i = 0
    var total: uint64 = 0
    while i < xs.size() {
        total = total + xs.get(i)
        i = i + 1
    }
    if total != 6 { return 1 }

    // A call argument chooses it too.
    val big = 5000000000
    if wide(big) != 5000000000 { return 2 }

    // A first use with no type of its own leaves the default.
    val small = 7
    val next = small + 1
    if next != 8 { return 3 }
    return 0
}
