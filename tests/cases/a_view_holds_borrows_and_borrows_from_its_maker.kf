//! run: exit 4
//! deps: core, alloc
// A `view struct` may hold borrows, and a method returns one borrowing from
// its receiver, as it would a `str`.

view struct Window {
    val text: str
    val from: uint64
}

impl Window {
    fun length(): uint64 { return self.text.byte_len() - self.from }
}

struct Text {
    var bytes: String
}

impl Text {
    fun window(from: uint64): Window { return Window { text: self.bytes.as_str(), from: from } }
}

fun main(): int32 {
    val text = Text { bytes: String.from("hello") }
    val w = text.window(1)
    return w.length() as int32
}
