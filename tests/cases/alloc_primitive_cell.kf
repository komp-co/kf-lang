//! run: exit 0
//! deps: core, alloc
// `alloc<T>` and `sizeof<T>` emit T's C name, not its KFlat one. `bool` is
// spelled the same in both, so it would pass by coincidence.
extern "C" fun runtime_println(s: str): void
extern "C" fun kf_free(p: Ptr<void>): void

fun main(): int32 {
    val p: Ptr<int32> = unsafe { alloc<int32>() }
    unsafe { *p = 7 }
    if unsafe { *p } != 7 { return 1 }

    val d: Ptr<float64> = unsafe { alloc<float64>() }
    unsafe { *d = 2.5 }
    if unsafe { *d } != 2.5 { return 2 }

    val u: Ptr<uint64> = unsafe { alloc<uint64>() }
    unsafe { *u = 9 }
    if unsafe { *u } != 9 { return 3 }

    // Spelled the same in both languages.
    val b: Ptr<bool> = unsafe { alloc<bool>() }
    unsafe { *b = true }
    if !unsafe { *b } { return 4 }

    // sizeof<T> reads the same fragment the same way.
    if sizeof<int32>() != 4 { return 5 }
    if sizeof<float64>() != 8 { return 6 }

    runtime_println("ok")
    return 0
}
