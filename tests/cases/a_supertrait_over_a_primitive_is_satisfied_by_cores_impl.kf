//! run: exit 29
//! deps: core, alloc
// core's `impl Add for int32` satisfies a supertrait obligation written here,
// and an operator sees its trait through a bound's supertrait: an umbrella
// trait stands for a list of bounds.

import alloc.list.*

// Declared here, so a user's trait is tested rather than core's umbrella.
pub trait Seed { static fun seed(): Self }
pub trait Unit { static fun unit(): Self }

impl Seed for int32 { static fun seed(): int32 { return 0 } }
impl Unit for int32 { static fun unit(): int32 { return 1 } }

pub trait Arith: Add + Mul + Seed + Unit {
}

impl Arith for int32 {
}

fun <T: Arith> Iterable<T>.total(): T {
    var acc = T.seed()
    while x in self {
        acc = acc + x
    }
    return acc
}

fun <T: Arith> Iterable<T>.product_of(): T {
    var acc = T.unit()
    while x in self {
        acc = acc * x
    }
    return acc
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(4)
    xs.push(5)
    return xs.total() + xs.product_of()
}
