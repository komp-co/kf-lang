//! build: fail
// A trailing `if` with no `else` is not a value: its false path yields
// nothing, and the binding would read an unassigned temporary. Three checks
// reject it independently.
fun bad(c: bool): int32 {
    val v = if c {
        val a = 1
        if c { a + 1 }
    } else { 0 }
    return v
}

fun main(): int32 {
    return bad(true)
}
