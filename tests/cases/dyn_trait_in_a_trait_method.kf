//! run: exit 0

// A trait method naming a `dyn AnotherTrait` declared below it: registration
// does not depend on declaration or file order.

trait Render {
    fun render_to(sink: &var dyn Sink): void
}

trait Sink {
    mutating fun put(n: int32): void
}

struct Total {
    var sum: int32
}

impl Sink for Total {
    mutating fun put(n: int32): void {
        self.sum = self.sum + n
    }
}

struct Pair {
    val a: int32
    val b: int32
}

impl Render for Pair {
    fun render_to(sink: &var dyn Sink): void {
        sink.put(self.a)
        sink.put(self.b)
    }
}

fun main(): int32 {
    var total = Total { sum: 0 }
    val p = Pair { a: 12, b: 30 }
    p.render_to(&var total)
    if total.sum != 42 { return 1 }
    return 0
}
