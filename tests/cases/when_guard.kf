//! run: exit 0
//! deps: core
// A false guard falls to the next matching arm, so a guarded `when` is an
// if/else chain, not C `case` labels.

enum Color { Red
             Green }

enum Shape { Circle(int32)
             Square(int32) }

// A scalar subject: the guard is the only thing separating the two arms.
fun choose(value: int32, enabled: bool): int32 {
    when (value) {
        0 if enabled => return 1
        _ => return 2
    }
    return 9
}

// A guarded variant followed by an unguarded arm for the same variant.
fun colour_rank(c: Color, enabled: bool): int32 {
    return when (c) {
        Red if enabled => 1
        Red => 2
        Green => 3
    }
}

// The guard reads the arm's own payload binder.
fun area(s: Shape): int32 {
    return when (s) {
        Circle(r) if r > 10 => 999
        Circle(r) => r * 3
        Square(w) if w == 0 => 0
        Square(w) => w * w
    }
}

// A whole-subject binder is visible to the guard too.
fun clamp(v: int32): int32 {
    return when (v) {
        n if n > 100 => 100
        n => n
    }
}

fun main(): int32 {
    if choose(0, false) != 2 { return 1 }
    if choose(0, true) != 1 { return 2 }
    if choose(5, true) != 2 { return 3 }

    if colour_rank(Color.Red, true) != 1 { return 4 }
    if colour_rank(Color.Red, false) != 2 { return 5 }
    if colour_rank(Color.Green, true) != 3 { return 6 }

    if area(Shape.Circle(20)) != 999 { return 7 }
    if area(Shape.Circle(2)) != 6 { return 8 }
    if area(Shape.Square(0)) != 0 { return 9 }
    if area(Shape.Square(4)) != 16 { return 10 }

    if clamp(250) != 100 { return 11 }
    if clamp(7) != 7 { return 12 }
    return 0
}
