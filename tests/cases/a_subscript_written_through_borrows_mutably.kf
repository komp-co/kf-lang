//! run: exit 0
//! deps: core, alloc
// A subscript used as a mutable place borrows through `IndexMut`: the
// receiver of a `mutating` method, the base of a field store, a `&var`
// argument, and an explicit `&var xs[i]`.


struct Counter {
    pub var count: int32
    pub var tags: List<String>
}

impl Counter {
    mutating fun bump(): void { self.count = self.count + 1 }
}

fun add_one(c: &var Counter): void {
    c.count = c.count + 1
}

fun main(): int32 {
    var cs = List.new<Counter>()
    cs.push(Counter { count: 0, tags: List.new<String>() })
    cs[0].bump()
    cs[0].count = cs[0].count + 10
    cs[0].tags.push(String.from("x"))
    add_one(&var cs[0])
    val c = &var cs[0]
    c.count = c.count + 100
    if cs[0].count != 112 { return 1 }
    if cs[0].tags.size() != 1 { return 2 }
    return 0
}
