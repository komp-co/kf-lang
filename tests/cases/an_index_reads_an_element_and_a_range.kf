//! run: exit 9
//! deps: core, alloc
// `Index` at two key types on one container, each binding `Out` differently:
// `xs[0..n]` needs no separate `slice` method. The endpoints are `uint64`
// locals to keep this about the two impls; the literal form is
// `a_range_literal_reaches_a_uint64_slot`.
import core.range.*
import alloc.list.*

struct Bag {
    pub var xs: List<int32>
}

impl Index<uint64> for Bag {
    type Out = int32
    fun index(k: uint64): &Self.Out { return self.xs.at(k) }
}

impl Index<Range<uint64>> for Bag {
    type Out = List<int32>
    fun index(k: Range<uint64>): &Self.Out { return &self.xs }
}

fun main(): int32 {
    var b = Bag { xs: List.new<int32>() }
    b.xs.push(7)
    b.xs.push(8)
    val one: int32 = b[0]
    val lo: uint64 = 0
    val hi: uint64 = 2
    val whole: List<int32> = b[lo..hi]
    return one + (whole.size() as int32)
}
