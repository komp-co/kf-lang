//! run: exit 0
//! deps: core, alloc
// A receiver satisfying the bound keeps its methods, and an unbounded impl
// block on the same type is callable at every instantiation.

trait Copyable { }
impl Copyable for int32 { }

struct Holder<T> { pub var v: T }

impl Holder<T: Copyable + Copy> {
    fun take(): T { return self.v }
}

impl Holder<T> {
    fun peek(): &T { return &self.v }
}

fun main(): int32 {
    val n = Holder<int32> { v: 7 }
    if n.take() != 7 { return 1 }
    if *n.peek() != 7 { return 2 }

    // No bound on `peek`, so a String element still reaches it.
    val s = Holder<String> { v: String.from("hello") }
    if !s.peek().as_str().equals("hello") { return 3 }
    return 0
}
