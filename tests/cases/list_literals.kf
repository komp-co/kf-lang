//! run: exit 0
//! deps: core, alloc
// `[a, b, c]`: a List unless the slot wants another collection, which it
// builds through `FromElements`; an empty `[]` is typed by its first use.

import alloc.list.*

// A collection of the program's own.
struct Bag {
    pub var total: int32
    pub var count: int32
}

impl FromElements<int32> for Bag {
    static fun new(): Bag { return Bag { total: 0, count: 0 } }
    mutating fun push(item: int32): void {
        self.total = self.total + item
        self.count = self.count + 1
    }
}

// A generic one with a `push` of its own, which its FromElements impl calls.
struct Ring<T> {
    pub var items: List<T>
    pub var pushes: int32
}

impl Ring<T> {
    pub static fun new(): Ring<T> { return Ring<T> { items: List.new<T>(), pushes: 0 } }
    pub mutating fun push(item: T): void {
        self.items.push(item)
        self.pushes = self.pushes + 1
    }
}

impl FromElements<T> for Ring<T> {
    static fun new(): Ring<T> { return Ring.new<T>() }
    mutating fun push(item: T): void { self.push(item) }
}

struct Holder { pub var items: List<int64> }

fun sum(xs: List<int32>): int32 {
    var total = 0
    while i in 0..xs.size() { total = total + xs.get(i) }
    return total
}

fun bag_total(bag: Bag): int32 { return bag.total }

fun main(): int32 {
    // Defaults to a List.
    val xs = [1, 2, 3]
    if sum(xs) != 6 { return 1 }
    // Retargeted by the slot.
    val wide: List<int64> = [1, 2]
    if wide.get(1) != 2 { return 2 }
    val bag: Bag = [4, 5, 6]
    if bag.total != 15 || bag.count != 3 { return 3 }
    if bag_total([10, 20]) != 30 { return 4 }
    val ring: Ring<int32> = [7, 8]
    if ring.pushes != 2 || ring.items.get(1) != 8 { return 5 }
    // Written pushes still count once each.
    var direct = Ring.new<int32>()
    direct.push(1)
    if direct.pushes != 1 { return 16 }
    val h = Holder { items: [1, 2] }
    if h.items.get(1) != 2 { return 6 }
    // Empty: typed by the slot or by the first push.
    var empty = []
    empty.push(7)
    if empty.size() != 1 { return 7 }
    val typed_empty: List<uint8> = []
    if typed_empty.size() != 0 { return 8 }
    if sum([]) != 0 { return 9 }
    // Anywhere an expression goes.
    val nested = [[1, 2], [3]]
    if nested.at(1).size() != 1 { return 10 }
    if [1, 2, 3].size() != 3 { return 11 }
    var i = 0
    while i < [1, 2, 3, 4].size() { i = i + 1 }
    if i != 4 { return 12 }
    var total = 0
    while x in [1, 2, 3] { total = total + x }
    if total != 6 { return 13 }
    var assigned = [1]
    assigned = [4, 5]
    if assigned.get(0) != 4 { return 14 }
    val names = [
        String.from("ada"),
        String.from("grace"),
    ]
    if names.at(1).len() != 5 { return 15 }
    return 0
}
