//! run: exit 0
//! deps: core
// A lambda whose `Call` bound is instantiated at a local struct puts it in the
// header, and the C file must not define it again: C23 allows the
// redefinition, the standard the gate pins does not.
import core.traits.call.*

struct P { val x: int32 }

fun apply<T, F: Call1<T>>(v: T, f: F): bool { return f.call(v) }

fun main(): int32 {
    if !apply(P { x: 7 }, |p| p.x == 7) { return 1 }
    return 0
}
