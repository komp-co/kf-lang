//! run: exit 0
//! deps: core, alloc
// `xs[i] = v` is `*(xs.index_mut(i)) = v`. The overwritten element is dropped,
// and a borrowed right-hand side is copied, so `names[0] = names[1]` leaves two
// independent strings.


fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(10)
    xs.push(20)
    xs[0] = 5
    if xs[0] != 5 { return 1 }

    var names = List.new<String>()
    names.push(String.from("aaa"))
    names.push(String.from("bbb"))
    names[0] = String.from("ccc")
    if !names[0].equals("ccc") { return 2 }
    names[0] = names[1]
    names[1].append("!")
    if !names[0].equals("bbb") { return 3 }
    if !names[1].equals("bbb!") { return 4 }
    return 0
}
