//! run: exit 85
//! deps: core, alloc
// `&T[]` takes any length: an array of each length, a list, a borrow of
// either, and a literal, which builds an array in place.

fun total(xs: &int32[]): int32 {
    var sum = 0
    while x in &xs { sum = sum + x }
    return sum
}

fun main(): int32 {
    val two: int32[2] = [1, 2]
    val three: int32[3] = [3, 4, 5]
    var list = List.new<int32>()
    list.push(10)
    list.push(20)
    return total(two) + total(&three) + total(list) + total(&list) + total([4, 6])
}
