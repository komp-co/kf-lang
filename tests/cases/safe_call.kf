//! run: exit 0
//! deps: core, alloc

// Safe call `?.`: the member, or `None`. `a?.b` is
//
//     when (a) { Some(__sc_N) => Option.Some(__sc_N.b)  None => null }
//
// so `a?.b?.c` is a `when` in another `when`'s subject.

import core.option.*

@derive(Clone)
struct Leaf {
    val n: int32
    val tag: String
}

struct Node {
    val leaf: Leaf
    val maybe: int32?
}

fun leaf_of(n: int32): Leaf {
    return Leaf { n: n, tag: String.from("leaf") }
}

fun node(present: bool): Node? {
    if present { return Option.Some(Node { leaf: leaf_of(7), maybe: Option.Some(3) }) }
    return null
}

fun leaf(present: bool): Leaf? {
    if present { return Option.Some(leaf_of(5)) }
    return null
}

// `!!` on a `None` aborts, so reaching this proves the argument was evaluated.
fun boom(): int32 {
    val z: int32? = null
    return z!!
}

fun named(present: bool): String? {
    if present { return Option.Some(String.from("leaf")) }
    return null
}

impl Leaf {
    fun scale(by: int32): int32 { return self.n * by }
}

fun main(): int32 {
    // Present: the member, wrapped.
    val a: int32? = leaf(true)?.n
    if a!! != 5 { return 1 }

    // Absent: `None`, and the member is never read.
    val b: int32? = leaf(false)?.n
    if b.is_some() { return 2 }

    // A chain short-circuits at the first `None`.
    val c: int32? = node(false)?.leaf?.n
    if c.is_some() { return 3 }

    // The same chain, present the whole way.
    val d: int32? = node(true)?.leaf?.n
    if d!! != 7 { return 4 }

    // A method call through `?.`.
    val e: int32? = leaf(true)?.scale(3)
    if e!! != 15 { return 5 }

    // Arguments evaluate only when the receiver is present.
    val f: int32? = leaf(false)?.scale(boom())
    if f.is_some() { return 6 }

    // Flattening: `node(true)?.maybe` is `int32?`, not `int32??`; the written
    // type is the assertion.
    val g: int32? = node(true)?.maybe
    if g!! != 3 { return 7 }

    val h: int32? = node(false)?.maybe
    if h.is_some() { return 8 }

    // Safe call, then a default.
    val i = leaf(false)?.n ?: 42
    if i != 42 { return 9 }

    val j = leaf(true)?.n ?: 42
    if j != 5 { return 10 }

    // A move-only receiver payload is dropped once on either path; the method
    // only borrows it.
    val m: uint64? = named(true)?.byte_len()
    if m!! != 4 { return 11 }

    val n: uint64? = named(false)?.byte_len()
    if n.is_some() { return 12 }

    return 0
}
