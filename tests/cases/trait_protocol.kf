//! run: exit 42
//! deps: alloc, core
// A generic algorithm over the static iteration protocols. The cursor type is
// the impl's associated `Iter`, so a foreign cursor cannot be passed.
import alloc.list.*

fun first<T, C: Iterable<T>>(items: C): int32 {
    var iter = items.iter()
    val item = iter.next()
    when (item) {
        Some(value) => return value
        None => return 0
    }
}

fun main(): int32 {
    var values = List.new<int32>()
    values.push(42)
    return first<int32, List<int32>>(values)
}
