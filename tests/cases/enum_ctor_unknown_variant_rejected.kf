//! build: fail
//! deps: core
// A misspelled variant on the CONSTRUCTOR side. The pattern side of this typo
// is covered by when_variant_typo_rejected.

enum Holder {
    Wrap(int32)
    Nop
}

fun main(): int32 {
    val h = Holder.Wrpa(1)
    when (h) {
        Wrap(a) => { return a }
        Nop => { return 0 }
    }
    return 0
}
