//! run: exit 0
//! deps: core, alloc
// `String` implements `Compare`, byte-wise: it agrees with `Equal`, and a
// prefix sorts before its extension.

fun main(): int32 {
    val a = String.from("apple")
    val b = String.from("pear")
    if a.compare(b) >= 0 {
        return 1
    }
    // Equal bytes compare equal, agreeing with `Equal`.
    val c = String.from("apple")
    val d = String.from("apple")
    if c.compare(d) != 0 {
        return 2
    }
    // A prefix sorts before the string that extends it.
    val e = String.from("app")
    val f = String.from("apple")
    if e.compare(f) >= 0 {
        return 3
    }
    return 0
}
