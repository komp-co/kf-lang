//! build: fail
// A method name written twice in one impl block is reported at the duplicate.
// The message is asserted in kf-typecheck's unit tests.
struct Bag {
    pub val n: int32
}

impl Bag {
    pub fun get(): int32 { return self.n }
    pub fun get(): bool { return true }
}

fun main(): int32 {
    val b = Bag { n: 0 }
    return b.get()
}
