//! run: exit 0
//! deps: core, alloc
// A generic call returns an instance whose field is another instance; that
// inner instance's own fields are typed on first read.

struct Residue<I: Integer, M: I> {
    val value: I
}

struct Pair<I: Integer, M: I> {
    val left: Residue<I, M>
    val right: Residue<I, M>
}

fun wrap<I: Integer, M: I>(v: I): Residue<I, M> {
    return Residue<I, M> { value: v % M }
}

fun twice<I: Integer, M: I>(v: I): Pair<I, M> {
    return Pair<I, M> { left: wrap<I, M>(v), right: wrap<I, M>(v + v) }
}

fun main(): int32 {
    val p = twice<uint8, 5>(4)
    if "${p.left.value} ${p.right.value}" != "4 3" { return 1 }
    if p.left.value + p.right.value != 7 { return 2 }
    return 0
}
