//! build: fail
//! deps: core
// val_field_assignment_rejected with `s` bound from a call: the owner's type
// carries its canonical identity, and the field is still found `val`.

struct S {
    pub val n: int32
}

fun make(): S {
    return S { n: 1 }
}

fun main(): int32 {
    var s = make()
    s.n = 2
    return 0
}
