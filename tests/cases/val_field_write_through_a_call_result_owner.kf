//! build: fail
//! deps: core
//! broken: #74 — the field check is skipped when the owner came from a call
// val_field_assignment_rejected with `s` bound from a call: the owner's type
// is missing, so the check answers permissively. Assignment, a mutating method
// and a `&var` borrow all miss it; the root-binding check is unaffected.

struct S {
    pub val n: int32
}

fun make(): S {
    return S { n: 1 }
}

fun main(): int32 {
    var s = make()
    s.n = 2
    return 0
}
