//! build: fail
//! deps: core, alloc
// A by-value parameter is not a mutable receiver.
//
// CONSTRAINT: a by-value `List` shares its heap buffer with the caller, so a
// `push` would write through. Mutation is spelled `&var` in the type. The
// diagnostic names that repair, since a parameter has no `var` form.

import alloc.list.*

fun add(xs: List<int32>): void {
    xs.push(1)
}

fun main(): int32 {
    var l = List.new<int32>()
    add(l)
    return 0
}
