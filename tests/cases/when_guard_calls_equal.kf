//! run: exit 0
//! deps: core
// A guard is an ordinary typed expression: `==` on a struct dispatches to its
// `Equal`, a method call reads the arm's binder at the subject's type, and a
// generic called only from a guard is instantiated.

struct Point {
    val x: int32
    val y: int32
}

impl Equal for Point {
    fun equals(other: &Point): bool { return self.x == other.x }
}

fun Point.is_origin(): bool { return self.x == 0 && self.y == 0 }

fun far<T: Equal>(a: &T, b: &T): bool { return !a.equals(b) }

fun classify(p: Point, target: &Point): int32 {
    return when p {
        v if v == *target => 1
        v if v.is_origin() => 2
        v if v.equals(target) => 3
        v if far(&v, target) && v.y == 5 => 5
        _ => 4
    }
}

fun main(): int32 {
    val target = Point { x: 1, y: 2 }
    if classify(Point { x: 1, y: 9 }, &target) != 1 { return 1 }
    if classify(Point { x: 0, y: 0 }, &target) != 2 { return 2 }
    if classify(Point { x: 5, y: 5 }, &target) != 5 { return 3 }
    if classify(Point { x: 5, y: 6 }, &target) != 4 { return 4 }
    return 0
}
