//! run: exit 0
//! deps: core, alloc
// `..` is a binary operator producing a `core.Range` value: bind it, pass it,
// return it. Writing `..` imports `core.range`.

import alloc.list.*

extern "C" fun runtime_println(s: str): void

fun sum_of(r: Range<int32>): int32 {
    var total = 0
    while v in r { total = total + v }
    return total
}

fun first_three(): Range<int32> {
    return 0..3
}

fun main(): int32 {
    // bound to a name
    val r = 0..4
    if sum_of(r) != 6 { return 1 }

    // returned from a function
    if sum_of(first_three()) != 3 { return 2 }

    // passed straight in
    if sum_of(0..5) != 10 { return 3 }

    // Endpoints are whole expressions: `2..6`, not `1 + (1..2) * 3`.
    var t = 0
    while v in 1 + 1..2 * 3 { t = t + v }
    if t != 14 { return 4 }

    // The loop variable takes the endpoints' type, so a uint64 range indexes
    // a List without a cast.
    var xs = List.new<int32>()
    xs.push(10)
    xs.push(20)
    var total = 0
    while i in 0..xs.size() { total = total + xs.get(i) }
    if total != 30 { return 5 }

    // an empty range yields nothing
    var n = 0
    while v in 3..3 { n = n + 1 }
    if n != 0 { return 6 }

    // A reversed range yields nothing.
    var m = 0
    while v in 5..2 { m = m + 1 }
    if m != 0 { return 7 }

    // `iter()` builds a fresh cursor; the Range is never consumed.
    val twice = 0..3
    var a = 0
    while v in twice { a = a + v }
    var b = 0
    while v in twice { b = b + v }
    if a != 3 { return 8 }
    if b != 3 { return 9 }

    runtime_println("ok")
    return 0
}
