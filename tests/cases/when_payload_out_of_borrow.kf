//! run: exit 0
//! deps: core, alloc
// A move-only payload read out of a borrowed subject is copied, since nothing
// moves out of a borrow. Shape B is `Option.unwrap()`'s.

extern "C" fun runtime_println(s: str): void

// (A) An explicit `&` parameter; the payload leaves through the return.
fun take_payload(o: &Option<String>): String {
    return when (o) {
        Some(v) => v
        None => String.from("absent")
    }
}

// (B) A method reading through `self`; the value outlives the receiver.
pub struct Wrapper {
    pub val inner: Option<String>
}

impl Wrapper {
    pub fun get(): String {
        return when (self.inner) {
            Some(v) => v
            None => String.from("absent")
        }
    }
}

fun escaping_accessor(): String {
    val hold = Wrapper { inner: Option.Some(String.from("held")) }
    return hold.get()
}

fun main(): int32 {
    val s: String? = Option.Some(String.from("borrowed"))
    val a = take_payload(&s)
    // Distinct exit codes: a report-and-return does not fit on one line.
    if !a.as_str().equals("borrowed") { return 1 }

    // The borrow's owner keeps its own copy.
    val still_there = when (s) {
        Some(v) => v.as_str().equals("borrowed")
        None => false
    }
    if !still_there { return 2 }

    // Twice, so a stolen payload shows.
    val a2 = take_payload(&s)
    if !a2.as_str().equals("borrowed") { return 3 }

    val b = escaping_accessor()
    if !b.as_str().equals("held") { return 4 }

    runtime_println("ok")
    // Each drops its own bytes.
    return 0
}
