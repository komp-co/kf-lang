//! run: exit 0
//! deps: core, alloc
// A generic receiver and a method's own parameter each supply an Option
// payload type a following `when` binder keeps. The receiver is borrowed, so
// its field is not moved into the Option.

struct Box2<T> { pub var value: T }

impl Box2<T: Copy> {
    pub fun peek(): T? {
        return Option.Some<T>(self.value)
    }
}

struct Holder<A> { pub var value: A }

impl Holder<A> {
    pub fun replace<T>(value: T): T? {
        return Option.Some<T>(value)
    }
}

fun main(): int32 {
    var box = Box2<int32> { value: 2 }
    when (box.peek()) {
      Some(value) => { if value != 2 { return 1 } }
      None => return 2
    }

    var holder = Holder<String> { value: String.from("holder") }
    when (holder.replace<int32>(3)) {
      Some(value) => { if value != 3 { return 3 } }
      None => return 4
    }
    return 0
}
