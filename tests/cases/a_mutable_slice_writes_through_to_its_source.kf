//! run: exit 43
//! deps: core, alloc
// `&var T[]` writes through to the array or list it views.
import alloc.list.*

fun bump(xs: &var int32[]): void {
    while i in 0..xs.size() { xs[i] = xs[i] + 1 }
}

fun main(): int32 {
    var grid: int32[3] = [1, 2, 3]
    bump(grid)
    bump(&var grid)
    var list = List.new<int32>()
    list.push(30)
    bump(list)
    return grid[0] + grid[1] + grid[2] + list[0]
}
