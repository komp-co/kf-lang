//! run: exit 0
//! deps: core, alloc

// `Option` and `Result` implement the derivable traits, bounded on the
// target's parameter: an `Option<T>` is comparable when its payload is.

import core.option.*
import core.result.*

// A half-edge mesh with an optional twin.
@derive(Equal)
struct Edge {
    val twin: int32?
    val next: int32
}

@derive(Equal)
struct Outcome {
    val step: Result<int32, int32>
}

fun main(): int32 {
    // Equal for Option, through a derive.
    val a = Edge { twin: Option.Some(1), next: 2 }
    val b = Edge { twin: Option.Some(1), next: 2 }
    val c = Edge { twin: null, next: 2 }
    val d = Edge { twin: null, next: 2 }
    if !(a == b) { return 1 }
    if a == c { return 2 }
    // Two absent values are equal to each other.
    if !(c == d) { return 3 }
    // A different payload is not equal.
    val e = Edge { twin: Option.Some(9), next: 2 }
    if a == e { return 4 }

    // Equal for Result, both arms.
    val ok1 = Outcome { step: Result.Ok<int32, int32>(1) }
    val ok2 = Outcome { step: Result.Ok<int32, int32>(1) }
    val err = Outcome { step: Result.Err<int32, int32>(1) }
    if !(ok1 == ok2) { return 5 }
    // Ok(1) and Err(1) differ.
    if ok1 == err { return 6 }

    // Clone through the impl, which `String` and the primitives satisfy.
    val cs: String? = Option.Some(String.from("ada"))
    val cs2 = cs.clone()
    val cs2v = cs2 ?: return 11
    if !cs2v.as_str().equals("ada") { return 12 }
    // The original survives its clone.
    val csv = cs ?: return 13
    if !csv.as_str().equals("ada") { return 14 }

    val cn: int32? = Option.Some(7)
    val cnv = cn.clone() ?: return 15
    if cnv != 7 { return 16 }

    // None clones to None.
    val cnone: String? = null
    if cnone.clone().is_some() { return 17 }

    // `Some(x)` does not collide with a bare `x`.
    val h1: int32? = Option.Some(7)
    val bare: uint64 = 7
    if h1.hash() == bare.hash() { return 8 }
    // None hashes to 0, and two Nones agree.
    val n1: int32? = null
    val n2: int32? = null
    if n1.hash() != n2.hash() { return 9 }

    // Option's default is None; Result has none.
    val dflt = Option.default<int32>()
    if dflt.is_some() { return 10 }

    return 0
}
