//! run: exit 0
//! deps: core, alloc
// A trait impl for `String` is allowed; only re-declaring `String` is not.

trait Chatty {
    fun shout(): String
    fun width(): uint64
}

impl Chatty for String {
    fun shout(): String {
        var out = self.clone()
        out.append("!")
        return out
    }
    fun width(): uint64 { return self.byte_len() }
}

// The same trait for another type, so this is dispatch and not a coincidence.
impl Chatty for int32 {
    fun shout(): String { return String.from("int") }
    fun width(): uint64 { return 4 }
}

fun loudest<T: Chatty>(v: T): uint64 { return v.width() }

fun main(): int32 {
    val greeting = String.from("hi")
    if !greeting.shout().as_str().equals("hi!") { return 1 }
    if greeting.width() != 2 { return 2 }

    // Through a bound.
    if loudest<String>(String.from("abcd")) != 4 { return 3 }
    if loudest<int32>(7) != 4 { return 4 }

    // Declaring another String is still rejected, in a negative case.
    return 0
}
