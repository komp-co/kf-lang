//! run: exit 0
//! deps: core, alloc
// An annotation named in snake case names its argument struct the same way,
// and `annotated` builds a list of it. The static call making that list was
// rebuilt around the argument's name cut at its first `_`.

annotation is_shown on struct
annotation my_bench

@is_shown
struct Point {
    val x: int32
}

@my_bench
fun run(): void {}

fun main(): int32 {
    return annotated<is_shown>().size() as int32 + annotated<my_bench>().size() as int32 - 2
}
