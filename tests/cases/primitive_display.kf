//! run: exit 0
//! deps: core, alloc
// A trait implemented for a primitive is reachable through method syntax.

import core.display.*

extern "C" fun kf_str_byte_len(s: str): uint64

fun same(a: String, b: str): bool {
    return a.as_str().equals(b)
}

fun main(): int32 {
    val a: int32 = -42
    if !same(String.of(&(a)), "-42") { return 1 }

    val b: int8 = 7
    if !same(String.of(&(b)), "7") { return 2 }

    val c: uint32 = 4000000000
    if !same(String.of(&(c)), "4000000000") { return 3 }

    // Above INT64_MAX the unsigned renderer is needed.
    val d: uint64 = 18446744073709551615
    if !same(String.of(&(d)), "18446744073709551615") { return 4 }

    val e: bool = true
    if !same(String.of(&(e)), "true") { return 5 }
    val f: bool = false
    if !same(String.of(&(f)), "false") { return 6 }

    val st: str = "raw"
    if !same(String.of(&(st)), "raw") { return 12 }

    // Types with a route of their own.
    val g = String.from("s")
    if !same(String.of(&(g)), "s") { return 7 }
    val h: int64 = 900
    if !same(String.of(&(h)), "900") { return 8 }

    return 0
}
