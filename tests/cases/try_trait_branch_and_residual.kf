//! run: exit 0
//! deps: core

// `Try` from outside core: `branch` splits a value into the two-way choice and
// `from_residual` rebuilds from the bail. The residual is a wrapper, so an
// error crosses to another success type: `Result<int32, int32>` to
// `Result<bool, int32>`.

import core.option.*
import core.result.*

fun option_continues(): bool {
    val a: int32? = Option.Some(5)
    when (a.branch()) {
        Continue(v) => { return v == 5 }
        Break(_r) => { return false }
    }
    return false
}

fun option_breaks_and_rebuilds(): bool {
    val a: int32? = null
    when (a.branch()) {
        Continue(_v) => { return false }
        Break(r) => {
            val rebuilt: int32? = Option.from_residual<int32>(r)
            return rebuilt.is_none()
        }
    }
    return false
}

// The error survives a change of success type: `Result<int32, int32>`'s
// residual rebuilds a `Result<bool, int32>` still carrying 9.
fun result_error_crosses_to_another_success_type(): bool {
    val a: Result<int32, int32> = Result.Err<int32, int32>(9)
    when (a.branch()) {
        Continue(_v) => { return false }
        Break(r) => {
            val back: Result<bool, int32> = Result.from_residual<bool, int32>(r)
            when (back) {
                Ok(_b) => { return false }
                Err(e) => { return e == 9 }
            }
        }
    }
    return false
}

fun main(): int32 {
    if !option_continues() { return 1 }
    if !option_breaks_and_rebuilds() { return 2 }
    if !result_error_crosses_to_another_success_type() { return 3 }
    if !Option.from_output<int32>(3).is_some() { return 4 }
    if !Result.from_output<int32, int32>(4).is_ok() { return 5 }
    return 0
}
