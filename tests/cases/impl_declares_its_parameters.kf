//! run: exit 0
//! deps: core
// `impl<...>` declares the parameters a trait impl and an inherent impl then
// use in their targets, with their bounds.

trait Show { fun show(): int32 }

struct Pair<A, B> {
    pub val a: A
    pub val b: B
}

struct Cell<T> { pub val it: T }

impl<A: Show, B> Show for Pair<A, B> {
    fun show(): int32 { return self.a.show() + 1 }
}

impl<T: Copy> Cell<T> {
    fun get(): T { return self.it }
}

impl Show for int32 {
    fun show(): int32 { return self }
}

fun main(): int32 {
    val p = Pair<int32, bool> { a: 41, b: true }
    if p.show() != 42 { return 1 }
    val c = Cell<int32> { it: 7 }
    if c.get() != 7 { return 2 }
    return 0
}
