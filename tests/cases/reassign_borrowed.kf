//! run: exit 0
//! deps: core, alloc
// Reassignment clears borrow status: `var t = *xs.at(0)` binds a borrow, and
// `t = String.from(..)` rebinds an owned value, so moving `t` into a sink is a
// move, not a move-out-of-borrow to be cloned. Clean under ASan: "elem" drops
// with `xs`, "own" inside `sink_val`.

fun sink_val(s: String): bool {
    return s.equals("own")
}

fun f(xs: List<String>): bool {
    var t = *xs.at(0)           // t: borrowed-not-owned
    t = String.from("own")      // rebind to a fresh owned value
    return sink_val(t)              // legal move of the owned value (no clone)
}

fun main(): int32 {
    var xs = List.new<String>()
    xs.push(String.from("elem"))
    if f(xs) { return 0 }
    return 1
}
