//! run: exit 0
// A bound on an impl block's type parameter provides its trait's methods to
// every method body in that block. `S` belongs to the struct, so the bound
// cannot be moved onto `step` instead.

trait Src { mutating fun pull(): int32 }

struct Counter { pub var n: int32 }

impl Src for Counter {
    mutating fun pull(): int32 {
        self.n = self.n + 1
        return self.n
    }
}

struct Boxed<S> { pub var inner: S }

impl Boxed<S: Src> {
    pub mutating fun step(): int32 { return self.inner.pull() }
}

fun main(): int32 {
    var b = Boxed<Counter> { inner: Counter { n: 0 } }
    if b.step() != 1 { return 1 }
    if b.step() != 2 { return 2 }
    return 0
}
