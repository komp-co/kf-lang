//! build: fail
//! deps: core, alloc
// A view built in place borrows what its fields were lent, as one returned by
// a method does.

view struct Window {
    val text: str
}

fun main(): int32 {
    var owned = String.from("hello")
    val w = Window { text: owned.as_str() }
    owned.append("!")
    return w.text.byte_len() as int32
}
