//! build: fail
//! deps: core, alloc
// `while x in &...` walks with `next_ptr()`, which no trait declares, so a
// value known only by its `Iterable` bound is iterated by value.


fun Iterable<String>.total_len(): uint64 {
    var n: uint64 = 0
    while s in &self { n = n + s.byte_len() }
    return n
}

fun main(): int32 {
    val names = List.new<String>()
    return names.total_len() as int32
}
