//! build: fail
//! deps: core

trait Accepts { fun accept(value: int32): int32 }

struct Boxed { pub val value: int32 }

impl Accepts for Boxed {
    fun accept(value: int32): int32 { return value }
}

fun apply<T: Accepts>(value: T): int32 {
    return value.accept("not an integer")
}

fun main(): int32 { return apply(Boxed { value: 0 }) }
