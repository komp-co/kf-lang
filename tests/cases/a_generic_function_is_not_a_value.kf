//! build: fail
//! deps: core
// A function value has one type, so a generic function cannot be one.
//
// CONSTRAINT: `build: fail` cannot tell a typecheck diagnostic from a C error,
// so the message is asserted by the kf-typecheck unit test
// `a_generic_function_is_not_a_value`.

fun id<T>(x: T): T { return x }

fun main(): int32 {
    val f = id
    return 0
}
