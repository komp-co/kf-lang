//! run: exit 42
//! deps: core, alloc
// `[a, b]` is an array until a slot or a use of its binding needs a list:
// `push` is List's, a `List` slot converts through `From<T[N]>`, and `[]`
// is typed by its slot or its uses.
import alloc.list.*

fun total(xs: List<int32>): int32 {
    var sum = 0
    while x in &xs { sum = sum + x }
    return sum
}

fun main(): int32 {
    val xs = [1, 2, 3] // int32[3]
    var grows = [1, 2]
    grows.push(3) // push is List's, so grows is a List<int32>
    val wide: List<int64> = [1, 2] // the slot's element type
    val t = total([10, 20]) // total(xs: List<int32>)
    val none: List<uint8> = []
    var later = []
    later.push(7) // a List<int32>
    val rgb: Array<uint8, 3> = [255, 128, 0]
    if xs.size() != 3 || grows.size() != 3 || wide.size() != 2 || t != 30 { return 1 }
    if none.size() != 0 || later.size() != 1 || rgb[0] != 255 { return 2 }
    return 42
}
