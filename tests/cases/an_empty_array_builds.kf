//! run: exit 0
//! deps: core, alloc
// `T[0]` has no storage: it builds from `[]`, copies, iterates no element and
// lends an empty slice.

fun total(xs: &int32[]): int32 {
    var sum = 0
    while x in xs { sum = sum + x }
    return sum
}

fun main(): int32 {
    val names: String[0] = []
    var count = 0
    while _s in &names { count = count + 1 }
    val none: int32[0] = []
    val copy = none
    return count + names.size() as int32 + total(&none) + copy.size() as int32
}
