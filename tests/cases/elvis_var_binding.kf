//! run: exit 0
//! deps: core, alloc

// The bailing `?:` may bind with `var`. `val` binds the arm's binder
// directly; `var` binds a temp and opens the arm with
//
//     var NAME = __elvbail_N
//
// a move out of the arm, which then declines to drop it.

import core.option.*

fun half(n: int32): int32? {
    if n % 2 == 0 { return Option.Some(n / 2) }
    return null
}

fun named(present: bool): String? {
    if present { return Option.Some(String.from("ada")) }
    return null
}

fun mutate(n: int32): int32 {
    var v = half(n) ?: return 0 - 1
    // The whole point: the binding is assignable.
    v = v + 10
    return v
}

fun grow(present: bool): String {
    var s = named(present) ?: return String.from("absent")
    // Move-only, mutated through the `var`: one owner, dropped once.
    s.append("!")
    return s
}

fun main(): int32 {
    if mutate(8) != 14 { return 1 }
    if mutate(7) != 0 - 1 { return 2 }

    val a = grow(true)
    if !a.as_str().equals("ada!") { return 3 }

    val b = grow(false)
    if !b.as_str().equals("absent") { return 4 }

    // `val` still binds the arm's binder.
    val c = half(6) ?: return 5
    if c != 3 { return 6 }

    // The defaulting form takes `var` too.
    var d = half(7) ?: 21
    d = d + 1
    if d != 22 { return 7 }

    return 0
}
