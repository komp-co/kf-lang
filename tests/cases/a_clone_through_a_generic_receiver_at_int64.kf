//! run: exit 12
//! deps: core
// `self.clone()` inside a generic extension passes self the same way at every
// width, `int64` included.

fun <T: Clone> T.copy_of(): T { return self.clone() }

fun main(): int32 {
    val n: int64 = 7
    val m: int32 = 5
    return (n.copy_of() as int32) + m.copy_of()
}
