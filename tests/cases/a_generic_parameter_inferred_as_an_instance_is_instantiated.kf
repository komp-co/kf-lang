//! run: exit 0
//! deps: core, alloc
// A type parameter inferred as a generic instance (`C = Wrap<int32>`,
// `C = List<int32>`, `C = Option<int32>`) is written back onto the call, so
// mono mints the instance.


struct Wrap<T> { val v: T }
struct Point { val x: int32 }

fun by_ref<C>(c: &C): int32 { return 3 }
fun by_value<C>(c: C): int32 { return 4 }
fun bounded<C: Iterable<int32>>(c: &C): int32 { return 5 }
fun pair<A, B>(a: &A, b: &B): int32 { return 1 }
fun T.describe(): int32 { return 10 }

fun main(): int32 {
    val w = Wrap<int32> { v: 1 }
    val o: int32? = 5
    var xs = List.new<int32>()
    xs.push(2)
    val ps = List.new<Point>()
    val nested = Wrap<Wrap<Point>> { v: Wrap<Point> { v: Point { x: 1 } } }
    if by_ref(&w) + by_ref(&o) + by_ref(&xs) + by_ref(&nested) != 12 { return 1 }
    if by_value(Wrap<int32> { v: 2 }) != 4 { return 2 }
    if bounded(&xs) != 5 { return 3 }
    if pair(&xs, &ps) != 1 { return 4 }
    if xs.describe() + o.describe() + ps.describe() != 30 { return 5 }
    return 0
}
