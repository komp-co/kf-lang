//! build: fail
//! deps: core
// `<` on `Wrap<Message>` needs `Message: Compare`, the bound on `Wrap`'s `Compare` impl.

struct Message { val id: int32 }

struct Wrap<T> { pub val v: T }

impl Compare for Wrap<T: Compare> {
    fun compare(other: &Wrap<T>): int32 { return self.v.compare(&other.v) }
}

fun main(): int32 {
    val a = Wrap<Message> { v: Message { id: 1 } }
    val b = Wrap<Message> { v: Message { id: 2 } }
    if a < b { return 1 }
    return 0
}
