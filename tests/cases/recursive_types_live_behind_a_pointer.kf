//! run: exit 42
//! deps: core, alloc
// Recursion behind a Box, a List or an optional Box is not held by value.

import alloc.list.*

enum Expr {
    Num(int32)
    Add(Box<Expr>, Box<Expr>)
}

struct Node {
    val value: int32
    val children: List<Node>
    val next: Box<Node>?
}

fun eval(e: &Expr): int32 {
    return when (e) {
        Num(n) => n
        Add(a, b) => eval(a) + eval(b)
    }
}

fun main(): int32 {
    val e = Expr.Add(Box.new(Expr.Num(40)), Box.new(Expr.Num(1)))
    var kids = List.new<Node>()
    kids.push(Node { value: 1, children: List.new<Node>(), next: null })
    val root = Node { value: 2, children: kids, next: null }
    return eval(&e) + root.children.size() as int32
}
