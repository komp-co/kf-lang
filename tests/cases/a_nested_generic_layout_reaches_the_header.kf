//! run: exit 3
//! deps: core, alloc
// `List<List<uint32>>` in a public field: the inner layout, behind a pointer,
// reaches the header too.

pub struct Holder {
    var rows: List<List<uint32>>
}

pub fun make(): Holder {
    var rows = List.new<List<uint32>>()
    var inner = List.new<uint32>()
    inner.push(3)
    rows.push(inner)
    return Holder { rows: rows }
}

fun main(): int32 {
    val h = make()
    return h.rows.at(0).get(0) as int32
}
