//! build: fail
//! deps: core, alloc

annotation caption(text: String) on field
annotation shown on struct

template shown on struct T {
    fun T.first_caption(): String {
        while field in T.fields {
            return field.get<caption>().text
        }
        return ""
    }
}

@shown
struct Plain {
    val a: int32
}

fun main(): int32 { return 0 }
