//! build: fail
//! deps: core, alloc
// While a slice of a list is still used, the list may not grow: growing
// may move the elements the slice points at.
import alloc.list.*

fun main(): int32 {
    var list = List.new<int32>()
    list.push(1)
    val view: &int32[] = list
    list.push(2)
    return view[0]
}
