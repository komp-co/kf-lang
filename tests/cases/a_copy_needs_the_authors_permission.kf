//! build: fail
//! deps: core, alloc
// The compiler repairs a move-out-of-borrow with a deep copy only when the
// type permits it by `impl Clone`, written or derived. Without it the copy is
// refused, so a type can be unique.

import alloc.string.*
import alloc.list.*

pub struct Unique { pub var name: String }

fun consume(u: Unique): uint64 { return u.name.byte_len() }

fun main(): int32 {
    var xs = List.new<Unique>()
    xs.push(Unique { name: String.from("only") })
    // Duplicates a value that never agreed to be duplicated.
    return consume(*xs.at(0)) as int32
}
