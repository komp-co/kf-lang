//! run: exit 0
//! deps: core, alloc
// A function named where a value is wanted: bound to a local, passed as an
// argument, returned, and called through each.

fun double(x: int32): int32 { return x * 2 }
fun inc(x: int32): int32 { return x + 1 }

fun apply(f: (int32) -> int32, x: int32): int32 { return f(x) }

fun pick(big: bool): (int32) -> int32 {
    if big { return double }
    return inc
}

fun main(): int32 {
    val f: (int32) -> int32 = double
    if f(4) != 8 { return 1 }
    if apply(inc, 4) != 5 { return 2 }
    if pick(true)(5) != 10 { return 3 }
    val g = pick(false)
    if g(5) != 6 { return 4 }
    return 0
}
