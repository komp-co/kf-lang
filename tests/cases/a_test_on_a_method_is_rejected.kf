//! build: fail
//! deps: core, testing
// `@test` marks `() -> void` functions; a method takes `self`, so it is not
// one, and `komp test` would never run it.

import testing.test

struct Counter {
    val n: int32
}

impl Counter {
    @test
    fun tick(): void {}
}

fun main(): int32 { return 0 }
