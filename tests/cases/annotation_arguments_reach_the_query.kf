//! run: exit 0
//! deps: core, alloc
// Each use's arguments, positional or named in any order, come back typed as
// the entry's `args`, the struct the annotation's parameters declare.

enum Level {
    Low
    High
}

annotation bench(iterations: int32, ratio: float64, label: String, level: Level, quick: bool, mark: char)

@bench(1000, 0.5, "sort", Level.High, false, 's')
fun sort_a_thousand(): void {}

@bench(mark = 'p', quick = true, level = Level.Low, label = "parse", ratio = -2.0, iterations = -10)
fun parse_a_file(): void {}

fun main(): int32 {
    val benches = annotated<bench>()
    val sort = benches.at(0).args
    if sort.iterations != 1000 { return 1 }
    if sort.label != "sort" { return 2 }
    if sort.quick { return 3 }
    if sort.mark != 's' { return 4 }
    val parse = benches.at(1).args
    if parse.iterations != -10 { return 5 }
    if parse.ratio > 0.0 { return 6 }
    val high = when (sort.level) {
        High => true
        Low => false
    }
    if !high { return 7 }
    return 0
}
