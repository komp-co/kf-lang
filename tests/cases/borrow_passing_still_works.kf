//! run: exit 42
//! deps: core, alloc
// The other side of the storability rule: a borrow may be passed down as far
// as it likes, and a container of owned values holding borrowed-from data is
// untouched. Only escape upward or sideways is closed.


fun width(text: str): uint64 {
    val owned = String.from(text)
    return owned.len()
}

fun bump(slot: &var int32): void {
    unsafe { *slot = *slot + 1 }
}

fun total(xs: &List<int32>): int32 {
    var sum = 0
    var i: uint64 = 0
    while i < (*xs).size() {
        sum = sum + (*xs).get(i)
        i = i + 1
    }
    return sum
}

fun main(): int32 {
    val owned = String.from("hello")
    var counter = 5
    bump(&var counter)

    var xs = List.new<int32>()
    xs.push(30)
    xs.push(1)

    return (width(owned.as_str()) as int32) + counter + total(&xs)
}
