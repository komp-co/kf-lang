//! build: fail
//! deps: core
// `+` on `Wrap<Message>` needs `Message: Add`, the bound on `Wrap`'s `Add` impl.

struct Message { val id: int32 }

struct Wrap<T> { pub val v: T }

impl Add for Wrap<T: Add> {
    fun add(other: &Wrap<T>): Wrap<T> { return Wrap<T> { v: self.v + other.v } }
}

fun main(): int32 {
    val a = Wrap<Message> { v: Message { id: 1 } }
    val b = Wrap<Message> { v: Message { id: 2 } }
    val c = a + b
    return 0
}
