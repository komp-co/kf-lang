//! build: fail
//! deps: core
// Matching a primitive by name keeps the obligation check: `int32` implements
// `Add`, and no `Shiny`.

pub trait Shiny { fun shine(): int32 }

// Not `Num`, which core declares.
pub trait Ornate: Add + Shiny {
}

impl Ornate for int32 {
}

fun main(): int32 { return 0 }
