//! run: exit 7
//! deps: core
// A signature naming a type whose parameter is bounded checks the argument
// against the enclosing declaration's own bounds, in a function, a method
// and a field alike.

struct Tally<T: Num> {
    val total: T
}

struct Ledger<T: Num> {
    val tally: Tally<T>
}

fun start<T: Num>(first: T): Tally<T> {
    return Tally<T> { total: first }
}

impl<T: Num> Tally<T> {
    fun plus(more: T): Tally<T> { return Tally<T> { total: self.total + more } }
}

fun main(): int32 {
    val ledger = Ledger<int32> { tally: start(3).plus(4) }
    return ledger.tally.total
}
