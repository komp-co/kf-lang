//! build: fail
//! deps: core, alloc
// Whether `Holder<T>` meets a bound can depend on `T`, so a generic type
// cannot carry an annotation whose kind has a bound.

trait Shown {
    fun show(): int32
}

annotation shown on struct: Shown

@shown
struct Holder<T> {
    val value: T
}

fun main(): int32 { return 0 }
