// A borrow may not be stored. Its validity is bounded by the call that made
// it, and a field or a payload outlives that call — proving they do not is
// exactly the job regions exist for. Every declaration below is rejected;
// passing a borrow down, as `accepts` does, stays legal.
//
// `&dyn Trait` is not special here: it is legal in every placement a borrow
// is legal in (dyn_placements.kf) and rejected in the one it is not.

struct Named {
    val label: str
}

struct Counted {
    val slot: &int32
}

trait Score { fun score(): int32 }

struct Holder {
    val value: &dyn Score
}

enum Held {
    Text(str)
    Number(int32)
}

fun accepts(text: str, count: &int32, scored: &dyn Score): int32 {
    return 0
}

fun main(): int32 {
    return 0
}
