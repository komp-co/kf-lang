//! build: fail
//! deps: core
// An argument of the wrong type, with no coercion komp performs, is komp's
// diagnostic. An owned value where a borrow is declared is a real coercion,
// so both directions appear.

struct Holder { pub val n: int32 }

fun takes_value(h: Holder): int32 { return h.n }
fun takes_borrow(h: &Holder): int32 { return h.n }
fun takes_wide(n: uint64): int32 { return n as int32 }

fun main(): int32 {
    val h = Holder { n: 7 }
    val r: &Holder = &h

    // Legal: auto-borrow of an owned value, and int-width flow.
    val ok1 = takes_borrow(h)
    val ok2 = takes_wide(3)

    // Rejected: a borrow does not satisfy a by-value parameter.
    val bad = takes_value(r)
    return ok1 + ok2 + bad
}
