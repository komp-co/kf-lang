//! run: exit 42
// A method call on a returned trait object evaluates the receiver once.

trait Score {
    fun score(): int32
}

struct Value { pub val amount: int32 }

impl Score for Value {
    fun score(): int32 { return self.amount }
}

struct Holder {
    pub val value: Value
    pub var calls: int32
}

fun counted(holder: &var Holder): &dyn Score {
    (*holder).calls = (*holder).calls + 1
    return (*holder).value
}

fun main(): int32 {
    var holder = Holder { value: Value { amount: 41 }, calls: 0 }
    val result = counted(&var holder).score()
    return result + holder.calls
}
