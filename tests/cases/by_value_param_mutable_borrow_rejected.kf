//! build: fail
//! deps: core, alloc
// A by-value parameter may not be handed on as `&var`: `outer` takes its list
// by value and `inner` mutates it.

import alloc.list.*

fun inner(l: &var List<int32>): void {
    l.push(1)
}

fun outer(xs: List<int32>): void {
    inner(&var xs)
}

fun main(): int32 {
    var l = List.new<int32>()
    outer(l)
    return 0
}
