//! run: exit 0
//! deps: core, alloc
// An `Option<T>` inside a generic whose parameter is also `T` has its
// methods: `Option__T` is spelled like the template row. `Holder<T>` is that
// shape; `Keeper<E>` is the control.

struct Holder<T> { var v: T? }

impl Holder<T> {
    fun filled(): bool { return self.v.is_some() }
    fun empty(): bool { return self.v.is_none() }
    fun payload(): T { return self.v.unwrap() }
}

struct Keeper<E> { var v: E? }

impl Keeper<E> {
    fun filled(): bool { return self.v.is_some() }
}

// The extension form reaches the same lookup by a different route.
fun <T> Holder<T>.filled_ext(): bool { return self.v.is_some() }

fun main(): int32 {
    val some = Holder<int32> { v: Option.Some(3) }
    if !some.filled() { return 1 }
    if some.empty() { return 2 }
    if some.payload() != 3 { return 3 }
    if !some.filled_ext() { return 4 }

    val none = Holder<int32> { v: null }
    if none.filled() { return 5 }
    if !none.empty() { return 6 }
    if none.filled_ext() { return 7 }

    // A parameter named anything else.
    val k = Keeper<int32> { v: Option.Some(1) }
    if !k.filled() { return 8 }

    // A payload owning heap.
    val owned = Holder<String> { v: Option.Some(String.from("x")) }
    if !owned.filled() { return 9 }

    return 0
}
