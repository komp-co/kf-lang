//! run: exit 9
//! deps: core, alloc
// The counterpart of a_list_get_needs_a_copy_element: an int32, and a struct
// that derives Copy, are read out by value, and the list is left intact.

import alloc.list.*

@derive(Copy)
struct Point { pub var x: int32, pub var y: int32 }

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(2)
    var ps = List.new<Point>()
    ps.push(Point { x: 3, y: 4 })
    var p = ps.get(0)
    p.x = 100
    return xs.get(0) + ps.get(0).x + ps.get(0).y
}
