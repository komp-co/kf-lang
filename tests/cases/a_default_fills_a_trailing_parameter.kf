//! run: exit 0
//! deps: core, alloc
// A parameter's default stands in for an argument the call leaves out: a
// literal, a negated number, `null`, `[]`, an enum variant or a top-level
// `val`.

val DEFAULT_RETRIES: int32 = 3

@derive(Equal)
enum Mode {
    Plain
    Secure
}

fun connect(host: str, port: int32 = 80, retries: int32 = DEFAULT_RETRIES, offset: int32 = -2,
    mode: Mode = Mode.Plain, backup: int32? = null, tags: List<String> = []): int32 {
    val secure = if mode == Mode.Secure { 1000 } else { 0 }
    val spare = backup ?: 0
    return host.byte_len() as int32 + port + retries * 10 + offset + secure + spare + tags.size() as int32
}

fun main(): int32 {
    if connect("ab") != 110 { return 1 }
    if connect("ab", 8) != 38 { return 2 }
    if connect("ab", 8, 0, 0, Mode.Secure, 5, ["x"]) != 1016 { return 3 }
    return 0
}
