//! run: exit 13
// A struct field named for a C keyword. Field names are emitted as written,
// so a colliding one is rewritten; others are unchanged.
struct Padded {
    pub val signed: int32
    pub val inline: int32
    pub var default: int32
}

fun main(): int32 {
    var p = Padded { signed: 6, inline: 7, default: 0 }
    p.default = p.signed + p.inline
    return p.default
}
