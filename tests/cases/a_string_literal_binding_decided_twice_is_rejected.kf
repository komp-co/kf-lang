//! build: fail
//! deps: core, alloc
// `owned_length(s)` decides `s` as a `String`, so `name_length(s)` cannot
// have it as a `Name`.
import alloc.string.*

struct Name {
    val length: uint64
}

impl From<str> for Name {
    static fun from(text: str): Name { return Name { length: text.byte_len() } }
}

fun owned_length(s: String): uint64 { return s.byte_len() }
fun name_length(n: Name): uint64 { return n.length }

fun main(): int32 {
    val s = "abc"
    val _a = owned_length(s)
    val _b = name_length(s)
    return 0
}
