//! run: exit 0
//! deps: core, testing
// `@disabled` keeps a test checked but out of the run: this one would fail,
// and the run still passes.

import testing.run_tests

@test
@disabled("waiting on a fix")
fun would_fail(): void { assert_eq(1, 2, "one is two") }

@test
fun passes(): void {}

fun main(): int32 {
    return run_tests(&annotated<test>(), &annotated<disabled>())
}
