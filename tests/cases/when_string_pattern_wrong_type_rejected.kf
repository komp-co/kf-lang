//! build: fail
// A string pattern cannot compare against an integer.
//
// CONSTRAINT: `build: fail` cannot tell a typecheck diagnostic from a C error,
// so the message is asserted by the kf-typecheck unit test
// `a_string_pattern_on_an_integer_is_rejected`.

fun main(): int32 {
    val n = 3
    return when n {
        "three" => 1
        _ => 0
    }
}
