//! run: exit 0
//! deps: core, alloc
// A borrow as a trait's type argument, `Call1<&T>`, so a callable reads an
// element without owning it. The key `kf__ref__T` survives the impl's
// signature check, the bound check, and an unannotated lambda's parameter.

import alloc.list.*

fun any_ref<T, F: Call1<&T>>(xs: &List<T>, pred: F): bool {
    var i: uint64 = 0
    while i < xs.size() {
        if pred.call(xs.at(i)) { return true }
        i = i + 1
    }
    return false
}

fun count_ref<T, F: Call1<&T>>(xs: &List<T>, pred: F): uint64 {
    var n: uint64 = 0
    var i: uint64 = 0
    while i < xs.size() {
        if pred.call(xs.at(i)) { n = n + 1 }
        i = i + 1
    }
    return n
}

// A borrowed argument spelled concretely.
fun longer_than<F: Call1<&String>>(xs: &List<String>, pred: F): uint64 {
    return count_ref(xs, pred)
}

fun main(): int32 {
    var xs = List.new<String>()
    xs.push(String.from("a"))
    xs.push(String.from("bb"))
    xs.push(String.from("ccc"))

    // `s` is a `&String` from the bound.
    if !any_ref(&xs, |s| s.len() == 2) { return 1 }
    if any_ref(&xs, |s| s.len() == 9) { return 2 }
    if count_ref(&xs, |s| s.len() > 1) != 2 { return 3 }
    if longer_than(&xs, |s| s.len() > 2) != 1 { return 4 }

    // A written annotation agrees with the inferred one.
    if !any_ref(&xs, |s: &String| s.len() == 3) { return 5 }

    // The list still owns all three.
    if xs.size() != 3 { return 6 }
    if xs.at(2).len() != 3 { return 7 }
    return 0
}
