//! run: exit 12
//! deps: core, alloc
// A cursor returned from an extension (`chars()`) finds its `Iterable` impl,
// though it arrives with its canonical `crate::module::Name`.

fun main(): int32 {
    var chars = 0
    while c in "héllo".chars() { chars = chars + 1 }

    // All multi-byte: a byte loop counts nine, this counts three.
    var wide = 0
    while c in "日本語".chars() { wide = wide + 1 }

    // A literal-built cursor, so fixing one form by breaking the other fails.
    var again = 0
    val cursor = "abcd".chars()
    while c in cursor { again = again + 1 }

    return chars + wide + again
}
