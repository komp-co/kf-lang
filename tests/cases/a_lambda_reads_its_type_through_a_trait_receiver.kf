//! run: exit 0
//! deps: core

// An extension on `Iterable<T>` binds `T` from the receiver's impl, and the
// lambda passed to it takes its parameter type from there; a `char` element
// binds like any other.

fun <T> Iterable<T>.first_match<F: Call1<T>>(pred: F): uint64? {
    var i: uint64 = 0
    while x in self {
        if pred.call(x) { return i }
        i = i + 1
    }
    return null
}

fun main(): int32 {
    if ((10..20).first_match(|x| x % 7 == 0) ?: 99) != 4 { return 1 }
    if (1..5).any(|x| x > 4) { return 2 }
    if (1..5).count(|x| x % 2 == 0) != 2 { return 3 }
    val letters: char[3] = ['a', 'b', 'c']
    val b = 'b'
    if !letters.any(|c| c == 'c') || !letters.contains(&b) { return 4 }
    return 0
}
