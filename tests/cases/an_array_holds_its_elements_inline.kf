//! run: exit 0
//! deps: core, alloc
// `Array<T, N>` from core: N elements inline, indexed and iterated through
// core's methods, copied when its elements are and moved otherwise.

struct Rgb {
    val channels: Array<uint8, 3>
}

fun total(xs: &Array<int32, 4>): int32 {
    var sum = 0
    while x in xs {
        sum = sum + x
    }
    return sum
}

fun main(): int32 {
    var nums = Array<int32, 4> {}
    nums[0] = 1
    nums[3] = 4
    if total(&nums) != 5 || nums.size() != 4 { return 1 }
    val copy = nums
    nums[0] = 9
    if copy[0] != 1 { return 2 }
    var words = Array<String, 2> {}
    words[0] = String.from("hello")
    words[1] = String.from("world")
    if "${words[0]} ${words[1]}" != "hello world" { return 3 }
    val c = Rgb { channels: Array<uint8, 3> {} }
    if c.channels.size() != 3 { return 4 }
    return 0
}
