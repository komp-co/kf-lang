//! run: exit 0
//! deps: core
// A lazy adapter whose element type is chosen by the function it holds: the
// projection is the trait's type argument and appears in the `Option` its
// method returns.


struct Inc { }
impl Call1<int32> for Inc {
    type Out = int32
    fun call(a: int32): int32 { return a + 1 }
}

struct Counter { pub var n: int32  pub val stop: int32 }
impl Iterator<int32> for Counter {
    mutating fun next(): int32? {
        if self.n >= self.stop { return Option.None<int32>() }
        self.n = self.n + 1
        return Option.Some<int32>(self.n)
    }
}

struct MapIter<I, F> { pub var inner: I  pub var f: F }
impl Iterator<F.Out> for MapIter<I: Iterator<int32>, F: Call1<int32>> {
    mutating fun next(): F.Out? {
        when (self.inner.next()) {
          Some(v) => return Option.Some<F.Out>(self.f.call(v))
          None => return Option.None<F.Out>()
        }
    }
}

// Through a function, so the receiver's type arrives by substitution.
fun map<I: Iterator<int32>, F: Call1<int32>>(inner: I, f: F): MapIter<I, F> {
    return MapIter<I, F> { inner: inner, f: f }
}

fun main(): int32 {
    var m = map<Counter, Inc>(Counter { n: 0, stop: 3 }, Inc { })
    var total: int32 = 0
    while true {
        when (m.next()) {
          Some(v) => total = total + v
          None => break
        }
    }
    // 1, 2, 3 each mapped through `+ 1`.
    if total != 9 { return 1 }
    return 0
}
