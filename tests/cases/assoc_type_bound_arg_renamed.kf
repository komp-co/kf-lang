//! run: exit 8
// `type Out: Sink<P>` in `Producer<P>`, used through `C: Producer<Q>`: the
// bound is `Sink<Q>`, found by pairing parameters positionally. The names
// differ so a same-spelling coincidence cannot pass.
trait Sink<S> {
    fun feed(v: S): int32
}

struct Cursor { pub val n: int32 }

impl Sink<int32> for Cursor {
    fun feed(v: int32): int32 { return self.n + v }
}

trait Producer<P> {
    type Out: Sink<P>
    fun make(): Self.Out
}

struct Widget { pub val v: int32 }

impl Producer<int32> for Widget {
    type Out = Cursor
    fun make(): Self.Out { return Cursor { n: 5 } }
}

fun run<Q, C: Producer<Q>>(c: C, extra: Q): int32 {
    val out = c.make()
    return out.feed(extra)
}

fun main(): int32 {
    val w = Widget { v: 1 }
    return run<int32, Widget>(w, 3)
}
