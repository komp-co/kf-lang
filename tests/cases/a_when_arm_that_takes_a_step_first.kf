//! run: exit 0
//! deps: core
// A `when` arm's value is the last statement of its body; the statements
// before it are steps that survive lowering. Both value shapes, as a return
// operand and bound to a name, lower separately.

struct Cursor {
    pub var position: int32
    pub var steps: int32
}

impl Cursor {
    // `when` as a return operand: each arm returns directly.
    pub mutating fun advance(tag: int32): int32 {
        return when (tag) {
            0 => {
                self.position = self.position + 10
                self.steps = self.steps + 1
                100
            }
            1 => {
                self.position = self.position + 20
                200
            }
            _ => 300
        }
    }

    // `when` bound to a name: each arm assigns a temporary.
    pub mutating fun weigh(tag: int32): int32 {
        val w = when (tag) {
            0 => {
                self.steps = self.steps + 5
                7
            }
            _ => 9
        }
        return w + 1
    }
}

fun main(): int32 {
    var c = Cursor { position: 0, steps: 0 }

    // The arm's value arrives.
    if (c.advance(0) != 100) return 1
    // And its steps ran.
    if (c.position != 10) return 2
    if (c.steps != 1) return 3

    if (c.advance(1) != 200) return 4
    if (c.position != 30) return 5
    // The second arm has one step; the first arm's did not leak.
    if (c.steps != 1) return 6

    // An arm with no steps still works.
    if (c.advance(9) != 300) return 7
    if (c.position != 30) return 8

    // The assigning lowering keeps its steps too.
    if (c.weigh(0) != 8) return 9
    if (c.steps != 6) return 10

    if (c.weigh(3) != 10) return 11
    if (c.steps != 6) return 12

    return 0
}
