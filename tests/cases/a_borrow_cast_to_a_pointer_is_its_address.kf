//! run: exit 42
//! deps: core
// `(&x) as Ptr<T>` is x's address, as `&x` passed to a `&T` parameter is.

struct Cell {
    val value: int32
}

impl Cell {
    fun address(): Ptr<int32> {
        return unsafe { (&self) as Ptr<int32> }
    }
}

fun main(): int32 {
    val x = 41
    val p = unsafe { (&x) as Ptr<int32> }
    val c = Cell { value: 1 }
    return unsafe { *p } + unsafe { *c.address() }
}
