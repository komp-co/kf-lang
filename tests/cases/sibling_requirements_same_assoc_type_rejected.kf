//! build: fail
//! deps: core
//! broken: #21 — two requirements may each declare the same associated type, and the trait requiring both is accepted
// Redeclaring an inherited associated type is rejected:
//
//     trait Producer { type Out  fun make(): Self.Out }
//     trait Doubler: Producer { type Out  fun twice(): Self.Out }
//     error: trait Doubler redeclares associated type Out, already declared
//            by Producer
//
// Two sibling requirements declaring the same one should be too: `T: Both`
// makes `T.Out` reach two declarations. The enclosing-impl disambiguation
// covers only `Self.Out` inside an impl.

trait Left {
    type Out
    fun l(): Self.Out
}

trait Right {
    type Out
    fun r(): Self.Out
}

trait Both: Left + Right {
    fun b(): int32
}

fun main(): int32 { return 0 }
