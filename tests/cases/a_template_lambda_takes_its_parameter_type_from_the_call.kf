//! run: exit 0
//! deps: core
// A lambda in a template's code may leave its parameter's type out, as
// anywhere: the `Call` bound it is passed to gives it one.

annotation positive on struct

template positive on struct T {
    fun T.all_positive(): bool {
        return T.fields.map(|field| field.of(self) as int64).all(|value| value > 0)
    }
}

@positive
struct Pair {
    val a: int32
    val b: int64
}

fun main(): int32 {
    if !(Pair { a: 1, b: 2 }).all_positive() { return 1 }
    if (Pair { a: 1, b: 0 }).all_positive() { return 2 }
    return 0
}
