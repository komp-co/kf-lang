//! run: exit 5
//! deps: core, alloc
// A default method's body calls a sibling, `self.name()`, and each of two
// implementors gets its own callee.

trait Greeter {
    fun name(): int32
    fun greeting(): int32 { return self.name() + 1 }
}

struct Ann { pub val id: int32 }
impl Greeter for Ann { fun name(): int32 { return self.id } }

struct Bo { pub val id: int32 }
impl Greeter for Bo { fun name(): int32 { return self.id } }

fun greet<T: Greeter>(g: T): int32 { return g.greeting() }

fun main(): int32 {
    val a = Ann { id: 1 }
    val b = Bo { id: 2 }
    return greet<Ann>(a) + greet<Bo>(b)
}
