//! run: exit 0
//! deps: core
// A type instantiating a generic declared later in the file: `Holder`'s
// `Maybe<int32>` is instantiated before `Maybe`'s layout is registered, or
// the `No` arm below becomes a catch-all binding.

enum Holder {
    Wrap(Maybe<int32>)
    Nop
}

enum Maybe<T> {
    Yes(T)
    No
}

fun unwrap_or(h: Holder, fallback: int32): int32 {
    when (h) {
        Wrap(m) => {
            when (m) {
                Yes(v) => { return v }
                No => { return fallback }
            }
        }
        Nop => { return fallback }
    }
    return fallback
}

fun main(): int32 {
    val present = Holder.Wrap(Maybe.Yes(7))
    if unwrap_or(present, 0) != 7 { return 1 }

    val absent = Holder.Wrap(Maybe.No)
    if unwrap_or(absent, 5) != 5 { return 2 }

    if unwrap_or(Holder.Nop, 9) != 9 { return 3 }
    return 0
}
