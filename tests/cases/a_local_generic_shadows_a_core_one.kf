//! run: exit 0
//! deps: core
// A local generic function or extension named like one of core's shadows it
// at the caller, and core's own generic callers still reach core's: each
// crate's instances get their own C names.

fun max<T: Compare>(a: T, b: T): T {
    if a.compare(b) >= 0 { return b }
    return a
}

fun <T: Clone> T.take_if<F: Call1<&T>>(keep: F): T? {
    if keep(self) { return null }
    return self.clone()
}

fun main(): int32 {
    // This file's `max` answers the smaller.
    if max<int32>(3, 7) != 3 { return 1 }
    // core's `clamp` calls core's `max`.
    if 15.clamp(0, 10) != 10 { return 2 }
    // This file's `take_if` is inverted.
    if (7.take_if(|x| *x > 3) ?: 0) != 0 { return 3 }
    if (1.take_if(|x| *x > 3) ?: 0) != 1 { return 4 }
    return 0
}
