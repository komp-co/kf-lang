//! run: exit 0
//! deps: core, alloc
// A method declaring type parameters of its own on a generic instance: the
// method stays a template after its impl is pinned, and a call on `self`
// dispatches against the instance.


struct Pair<A, B> { pub var a: A  pub var b: B }

impl Pair<A: Copy, B> {
    // Neither bounded nor inferred.
    pub fun with<C>(c: C): C {
        return c
    }
    pub fun first(): A {
        return self.a
    }
    // A call on `self` inside a generic impl block.
    pub fun first_twice(): A {
        val once = self.first()
        return once
    }
}

struct Dbl { }
impl Call1<int32> for Dbl {
    type Out = int32
    fun call(a: int32): int32 { return a * 2 }
}

// Declared here, since an inherent impl belongs to its target's crate.
struct Bag<T> { pub var items: List<T> }

impl Bag<T> {
    // The method's parameter is bound, and the bound names the impl's.
    pub fun map_with<F: Call1<T>>(f: F): List<F.Out> {
        var out = List.new<F.Out>()
        var i: uint64 = 0
        while i < self.items.size() {
            out.push(f.call(*self.items.at(i)))
            i = i + 1
        }
        return out
    }
}

fun main(): int32 {
    var p = Pair<int32, int32> { a: 7, b: 9 }
    // Two instantiations of one method on one receiver get two symbols.
    val z = p.with<int32>(1)
    val w = p.with<bool>(true)
    if z != 1 { return 1 }
    if w != true { return 2 }
    if p.first_twice() != 7 { return 3 }

    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    var bag = Bag<int32> { items: xs }
    // Inferred, with the element type from the callable's associated type.
    val ys = bag.map_with(Dbl { })
    if ys.size() != 2 { return 4 }
    if ys.get(1) != 4 { return 5 }
    return 0
}
