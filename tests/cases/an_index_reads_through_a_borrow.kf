//! run: exit 0
//! deps: core, alloc
// `xs[i]` is `*(xs.index(i))`, borrowing the element in place rather than
// bit-copying it out as `get(i)` does.

import alloc.list.*

fun borrowed_len(s: &String): uint64 {
    return s.len()
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(10)
    xs.push(20)
    xs.push(30)
    if xs[0] != 10 { return 1 }
    if xs[0] + xs[2] != 40 { return 2 }

    // A computed index, and a nested one.
    var ix = List.new<uint64>()
    ix.push(2)
    if xs[ix[0]] != 30 { return 3 }
    var k: uint64 = 1
    if xs[k] != 20 { return 4 }

    // An element owning memory, read every way a read happens; none may copy
    // the buffer out.
    var names = List.new<String>()
    names.push(String.from("aaa"))
    names.push(String.from("bbbbb"))
    if !(names[0] == "aaa") { return 5 }
    val n = names[1]
    if !(n == "bbbbb") { return 6 }
    if borrowed_len(&names[1]) != 5 { return 7 }

    // The index walk this is all for.
    var total: uint64 = 0
    while i in 0..names.size() {
        total = total + names[i].len()
    }
    if total != 8 { return 8 }
    return 0
}
