//! run: exit 0
//! deps: core, testing
// core's test entry point runs every test in its own child process and
// reports; a crate whose tests all pass exits 0.

import testing.run_tests

@test
fun adds(): void { assert_eq(1 + 1, 2, "one and one") }

@test(name = "three is more than two")
fun compares(): void { assert(3 > 2, "three is more") }

fun main(): int32 {
    return run_tests(&annotated<test>(), &annotated<disabled>())
}
