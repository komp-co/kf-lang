//! run: exit 3
//! deps: core, alloc
// A trait method called through a field from another generic struct's method:
// the trait's type argument in the suffix is substituted too
// (`List__int32_iter__Iterable__int32`).


struct Wrapper<K> {
    var xs: List<K>
}

impl Wrapper<K> {
    fun cursor(): ListIter<K> { return self.xs.iter() }
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    val w = Wrapper<int32> { xs: xs }
    var sum = 0
    while x in w.cursor() { sum = sum + x }
    return sum
}
