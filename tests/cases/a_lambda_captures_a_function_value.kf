//! run: exit 0
//! deps: core, alloc
// A function value held in a local is captured by a lambda that calls it.
import core.traits.call.*

fun inc(x: int32): int32 { return x + 1 }

fun apply<F: Call1<int32>>(f: F, x: int32): F.Out { return f(x) }

fun main(): int32 {
    val step: (int32) -> int32 = inc
    val offset = 100
    if apply(|x: int32| step(x) + offset, 1) != 102 { return 1 }
    return 0
}
