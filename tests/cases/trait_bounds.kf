//! run: exit 0
//! deps: core, alloc
extern "C" fun runtime_println(s: str): void

trait Show {
    fun show(): String
}

// `Self` in a trait signature resolves to the bounded parameter at each use.
trait Eq {
    fun same(other: Self): bool
}

pub struct Pt { var x: int32 }
pub struct Tag { var n: int32 }

impl Show for Pt {
    fun show(): String { return String.from("Pt!") }
}

impl Show for Tag {
    fun show(): String { return String.from("Tag!") }
}

impl Eq for Pt {
    fun same(other: Pt): bool { return self.x == other.x }
}

impl Eq for Tag {
    fun same(other: Tag): bool { return self.n == other.n }
}

// A generic fn calling a trait method on bounded T.
fun render<T: Show>(v: T): String {
    return v.show()
}

// `other` types as T.
fun both_same<T: Eq>(a: T, b: T): bool {
    return a.same(b)
}

// U carries Eq, so forwarding into both_same's bounded T is legal.
fun outer<U: Eq>(a: U, b: U): bool {
    return both_same(a, b)
}

// Two generics inferred and written back: pair_desc__Pt__Tag.
fun pair_desc<A: Eq, B: Eq>(a1: A, a2: A, b1: B, b2: B): int32 {
    var n = 0
    if both_same(a1, a2) { n = n + 1 }
    if both_same(b1, b2) { n = n + 1 }
    return n
}

fun main(): void {
    val p = Pt { x: 1 }
    val t = Tag { n: 2 }
    runtime_println(render(p).as_str())
    runtime_println(render(t).as_str())

    val a = Pt { x: 1 }
    val b = Pt { x: 1 }
    val c = Pt { x: 2 }
    if both_same(a, b) { runtime_println("self-arg same OK") } else { runtime_println("FAIL self-arg") }
    if !both_same(a, c) { runtime_println("self-arg differ OK") } else { runtime_println("FAIL self-differ") }
    if outer(a, b) { runtime_println("propagation OK") } else { runtime_println("FAIL propagation") }
    val t1 = Tag { n: 5 }
    val t2 = Tag { n: 5 }
    if pair_desc(a, b, t1, t2) == 2 { runtime_println("two-generic OK") } else { runtime_println("FAIL two-generic") }
    runtime_println("ALL OK")
}
