//! run: exit 0
//! deps: core
// A lower_snake_case name in a pattern binds the subject as a catch-all; only
// an uppercase one names a variant.

enum Colour {
    Red
    Green
    Blue
}

fun rank(c: Colour): int32 {
    when (c) {
        Red => { return 1 }
        other => {
            when (other) {
                Green => { return 2 }
                Blue => { return 3 }
                Red => { return 9 }
            }
        }
    }
    return 0
}

fun main(): int32 {
    if rank(Colour.Red) != 1 { return 1 }
    if rank(Colour.Green) != 2 { return 2 }
    if rank(Colour.Blue) != 3 { return 3 }
    return 0
}
