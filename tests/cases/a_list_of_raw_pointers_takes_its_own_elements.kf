//! run: exit 42
//! deps: core, alloc

// A `List<Ptr<T>>` element is a `Ptr`, both pushed and read back.

fun main(): int32 {
    var items = List.new<Ptr<int32>>()
    var value = 41
    val p: Ptr<int32> = unsafe { &var value as Ptr<int32> }
    items.push(p)
    val back: Ptr<int32> = *items.at(0)
    return unsafe { *back } + 1
}
