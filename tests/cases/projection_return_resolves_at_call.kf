//! run: exit 0
//! deps: core
// A projection in a return type resolves where the call is checked, so the
// result can be used in the same body.


struct Inc { }
impl Call1<int32> for Inc {
    type Out = int32
    fun call(a: int32): int32 { return a + 1 }
}

fun call_it<F: Call1<int32>>(f: F, x: int32): F.Out { return f.call(x) }

fun main(): int32 {
    val a = call_it<Inc>(Inc { }, 4)
    if a != 5 { return 1 }
    // With a lambda's synthesized impl.
    val b = call_it(|x: int32| x * 3, 4)
    if b != 12 { return 2 }
    return 0
}
