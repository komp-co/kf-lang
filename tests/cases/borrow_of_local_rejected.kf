//! build: fail
//! deps: core, alloc
// A returned borrow may not read out of a binding this function owns: it is
// dropped at the return. A local that is itself a borrow is fine, as
// `forwarded` shows.

fun built(): str {
    val owned = String.from("abc")
    return owned.as_str()
}

fun addressed(): &int32 {
    val n = 42
    return n
}

fun forwarded(text: str): str {
    val same = text
    return same
}

fun main(): int32 {
    return 0
}
