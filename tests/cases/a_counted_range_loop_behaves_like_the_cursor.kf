//! run: exit 0
//! deps: core, alloc
// `while i in a..b` over integers compiles to a counted loop and must behave
// as the `RangeIter` cursor does. The counter advances before the body, so
// `continue` cannot skip it.

fun calls(counter: &var int32): int32 {
    *counter = *counter + 1
    return 5
}

fun main(): int32 {
    // The ordinary walk.
    var sum = 0
    while i in 0..5 { sum = sum + i }
    if sum != 10 { return 1 }

    // An empty range runs the body no times.
    var never = 0
    while i in 3..3 { never = never + 1 }
    if never != 0 { return 2 }

    // A backwards range is empty rather than infinite.
    var backwards = 0
    while i in 5..2 { backwards = backwards + 1 }
    if backwards != 0 { return 3 }

    // `continue` skips the rest of the body and still advances.
    var odds = 0
    while i in 0..10 {
        if i % 2 == 0 { continue }
        odds = odds + i
    }
    if odds != 25 { return 4 }

    // `break` leaves at the right element.
    var stopped = 0
    while i in 0..100 {
        if i == 4 { break }
        stopped = stopped + 1
    }
    if stopped != 4 { return 5 }

    // Nested loops keep their own counters.
    var pairs = 0
    while i in 0..3 {
        while j in 0..4 { pairs = pairs + 1 }
    }
    if pairs != 12 { return 6 }

    // The endpoint is evaluated once.
    var times = 0
    var total = 0
    while i in 0..calls(&var times) { total = total + i }
    if times != 1 { return 7 }
    if total != 10 { return 8 }

    // The widths the counted form is allowed to take.
    var wide: int64 = 0
    val end64: int64 = 4
    while i in 0..end64 { wide = wide + i }
    if wide != 6 { return 9 }

    var unsigned: uint64 = 0
    val endu: uint64 = 4
    while i in 0..endu { unsigned = unsigned + i }
    if unsigned != 6 { return 10 }

    // An inclusive range keeps the cursor and its `done` latch.
    var inclusive = 0
    while i in 0..=4 { inclusive = inclusive + i }
    if inclusive != 10 { return 11 }

    var saturating: int32 = 0
    val top: uint8 = 255
    while b in 253..=top { saturating = saturating + 1 }
    if saturating != 3 { return 12 }

    // `by`, `down` and `rev` keep the general path.
    var stepped = 0
    while i in (0..10).by(3) { stepped = stepped + i }
    if stepped != 18 { return 13 }

    var descending = 0
    while i in (5..0).down() { descending = descending + i }
    if descending != 15 { return 14 }

    return 0
}
