//! run: exit 0
//! deps: core, alloc
// `HashMap.get` lends, `Option<&V>`, so the caller is never a second owner.
// Counted by drops, the one measure telling a loan from a copy: each scenario
// demands exactly one drop per value, 0 a leak and 2 a double free.
import core.assert.*
import alloc.hash_map.*

pub struct Tracked {
    var counter: Ptr<int32>
}

impl Drop for Tracked {
    fun drop(): void {
        unsafe { *self.counter = *self.counter + 1 }
    }
}

impl Tracked {
    fun drops_seen(): int32 {
        return unsafe { *self.counter }
    }
}

fun new_counter(): Ptr<int32> {
    val p: Ptr<int32> = unsafe { alloc_array<int32>(1) }
    unsafe { *p = 0 }
    return p
}

fun count(p: Ptr<int32>): int32 {
    return unsafe { *p }
}

// (A) Reading through the loan makes no second owner; nothing drops until
// the map does.
fun the_map_lends_its_value(c: Ptr<int32>): void {
    var m = HashMap.new<String, Tracked>()
    m.insert(String.from("k"), Tracked { counter: c })
    val k = String.from("k")
    when (m.get(&k)) {
        Some(v) => assert(v.drops_seen() == 0, "A: the map's value is readable")
        None => assert(false, "A: the key was inserted")
    }
    assert(count(c) == 0, "A: the borrow dropped nothing the map owns")
}

// (B) Two borrows of one value are not two owners.
fun two_loans_of_one_value(c: Ptr<int32>): void {
    var m = HashMap.new<String, Tracked>()
    m.insert(String.from("k"), Tracked { counter: c })
    val k = String.from("k")
    when (m.get(&k)) {
        Some(v) => assert(v.drops_seen() == 0, "B: first loan")
        None => assert(false, "B: the key was inserted")
    }
    when (m.get(&k)) {
        Some(v) => assert(v.drops_seen() == 0, "B: second loan")
        None => assert(false, "B: the key was inserted")
    }
    assert(count(c) == 0, "B: two loans are still zero owners")
}

// (C) `remove` owns: it drops the removed entry while the map is alive.
fun removing_drops_the_value(c: Ptr<int32>): void {
    var m = HashMap.new<String, Tracked>()
    m.insert(String.from("k"), Tracked { counter: c })
    val k = String.from("k")
    assert(m.remove(&k), "C: the key was there to remove")
    assert(count(c) == 1, "C: remove dropped the value it took out")
    when (m.get(&k)) {
        Some(_) => assert(false, "C: the entry is gone")
        None => assert(true, "C: None after remove")
    }
}

// (D) Replacing a key drops the displaced value once; the second is dropped
// at scope end.
fun replacing_drops_the_old_value(c: Ptr<int32>): void {
    var m = HashMap.new<String, Tracked>()
    m.insert(String.from("k"), Tracked { counter: c })
    m.insert(String.from("k"), Tracked { counter: c })
    assert(m.size() == 1, "D: replaced, not appended")
    assert(count(c) == 1, "D: the displaced value dropped exactly once")
}

fun main(): int32 {
    val a = new_counter()
    the_map_lends_its_value(a)
    assert(count(a) == 1, "A: the map dropped its value exactly once")

    val b = new_counter()
    two_loans_of_one_value(b)
    assert(count(b) == 1, "B: two loans, still exactly one drop")

    val c = new_counter()
    removing_drops_the_value(c)
    assert(count(c) == 1, "C: nothing dropped a second time after remove")

    val d = new_counter()
    replacing_drops_the_old_value(d)
    assert(count(d) == 2, "D: both values dropped exactly once each")

    return 0
}
