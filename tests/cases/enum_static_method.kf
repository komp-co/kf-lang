//! run: exit 0
//! deps: core

// A `static fun` on an enum is not taken for a variant; the same declaration
// on a struct is the control. A variant still wins a shared name:
// `Shape.Round` names the variant beside a `static fun Round`.

pub enum Colour {
    Red
    Blue
}

impl Colour {
    pub static fun preferred(): Colour {
        return Colour.Blue
    }
}

pub struct Shade {
    val n: int32
}

impl Shade {
    pub static fun preferred(): Shade {
        return Shade { n: 1 }
    }
}

pub enum Shape {
    Round
    Flat
}

impl Shape {
    pub static fun Round(): int32 {
        return 99
    }
}

fun main(): int32 {
    val s = Shade.preferred()
    if s.n != 1 { return 1 }

    val c = Colour.preferred()
    when (c) {
        Red => { return 2 }
        Blue => { }
    }

    // The variant, not the static that shares its name.
    val r = Shape.Round
    when (r) {
        Round => { }
        Flat => { return 3 }
    }
    return 0
}
