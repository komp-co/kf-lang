//! run: exit 0
//! deps: core, alloc
// A borrow's mangle lives in the reserved `kf__` space, so `&String` and a
// declared `Ref<String>` stay distinct in one compilation. A guard, not a
// reproduction: the fragments are asserted in `type_mangle_frag_test.kf` and
// `decl_generics_test.kf`.
//
// `Ptr` and `Box` are reserved builtin names and need no such marker.
import core.assert.*

// The declared generic.
pub struct Ref<T> {
    pub val inner: T
}

impl Ref<T> {
    fun get(): &T {
        return &self.inner
    }
}

// A generic return mentioning `&T`, whose suffix is decoded.
fun first_of<T>(xs: &List<T>): Option<&T> {
    if xs.size() == 0 { return Option.None }
    return Option.Some(xs.at(0))
}

// (A) `Option<&String>` must not resolve through the `Ref<T>` above.
fun a_borrowed_payload(): void {
    var xs = List.new<String>()
    xs.push(String.from("alpha"))
    when (first_of(&xs)) {
        Some(v) => assert(v.as_str().equals("alpha"), "A: read a String through the borrow")
        None => assert(false, "A: the list has an element")
    }
}

// (B) `Ref<String>` is an ordinary generic instance.
fun a_declared_ref(): void {
    val r = Ref<String> { inner: String.from("beta") }
    assert(r.get().as_str().equals("beta"), "B: read a String out of Ref<String>")
}

// (C) `&Ref<String>`: the outer borrow and the inner `Ref` stay
// distinguishable.
fun a_borrow_of_the_declared_ref(): void {
    val r = Ref<String> { inner: String.from("gamma") }
    val br: &Ref<String> = &r
    assert(br.get().as_str().equals("gamma"), "C: read through a borrow of Ref<String>")
}

fun main(): int32 {
    a_borrowed_payload()
    a_declared_ref()
    a_borrow_of_the_declared_ref()
    return 0
}
