// A trait with a supertrait is rejected in dyn position: its vtable layout and
// upcast are not designed. Static bounds are unaffected.

trait Eq2 { fun eq2(other: Self): bool }
trait Ord2: Eq2 { fun ord2(other: Self): int32 }

fun accept(x: &dyn Ord2): int32 { return 0 }

fun main(): int32 { return 0 }
