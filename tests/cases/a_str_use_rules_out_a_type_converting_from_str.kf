//! build: fail
//! deps: core, alloc
// `view_length(name)` needs a `str`, which a `Name` is not, so the later
// `name_length(name)` cannot make `name` one; the error names both uses.

struct Name {
    val length: uint64
}

impl From<str> for Name {
    static fun from(text: str): Name { return Name { length: text.byte_len() } }
}

fun view_length(s: str): uint64 { return s.byte_len() }
fun name_length(n: Name): uint64 { return n.length }

fun main(): int32 {
    val name = "four"
    val _a = view_length(name)
    val _b = name_length(name)
    return 0
}
