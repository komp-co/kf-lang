//! run: exit 0
//! deps: core, alloc
// A string literal fills a `str`, an owning `String` or a shared-borrow slot
// unconverted: the slot chooses its representation, as it chooses an integer
// literal's width. A `str` value needs `String.from`.

fun takes_str(s: str): uint64 { return s.byte_len() }
fun takes_string(s: String): uint64 { return s.byte_len() }
fun takes_borrowed(s: &String): uint64 { return s.byte_len() }

fun main(): int32 {
    if takes_str("komp") != 4 { return 1 }
    if takes_string("komp") != 4 { return 2 }
    if takes_borrowed("komp") != 4 { return 3 }

    val typed: String = "komp"
    if typed.byte_len() != 4 { return 4 }

    // An integer literal likewise, with no `From` impl.
    val narrow: uint8 = 7
    if narrow != (7 as uint8) { return 5 }

    // The written conversion a `str` value needs.
    val view: str = "komp"
    if takes_string(String.from(view)) != 4 { return 6 }
    if takes_borrowed(&String.from(view)) != 4 { return 7 }

    return 0
}
