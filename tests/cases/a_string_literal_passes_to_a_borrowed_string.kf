//! run: exit 0
//! deps: core, alloc
// A string literal passes where a `&String` is expected, as an owned
// `String.from(...)` borrowed for the call.
fun same(a: &String, b: &String): bool { return a.as_str().equals(b.as_str()) }

fun main(): int32 {
    val owned = String.from("komp")
    if !same(&owned, "komp") { return 1 }
    if same(&owned, "kflat") { return 2 }
    return 0
}
