//! run: exit 0
//! deps: core, alloc
// A payload bound in a `when` arm and let out is a move. Each scenario counts
// drops and demands exactly one: 0 is a leak, 2 a double free.
import core.assert.*

pub struct Tracked {
    var counter: Ptr<int32>
}

impl Drop for Tracked {
    fun drop(): void {
        unsafe { *self.counter = *self.counter + 1 }
    }
}

fun new_counter(): Ptr<int32> {
    val p: Ptr<int32> = unsafe { alloc_array<int32>(1) }
    unsafe { *p = 0 }
    return p
}

fun count(p: Ptr<int32>): int32 {
    return unsafe { *p }
}

// (A) The payload escapes the arm.
fun payload_escapes(c: Ptr<int32>): void {
    val o: Tracked? = Option.Some(Tracked { counter: c })
    val out = when (o) {
        Some(v) => v
        None => Tracked { counter: c }
    }
    assert(count(c) == 0, "nothing dropped while the payload is still held")
    // Exactly one of `out` and `o` owns the Tracked.
}

// (B) The payload is only read; the subject drops it.
fun payload_stays_in_arm(c: Ptr<int32>): void {
    val o: Tracked? = Option.Some(Tracked { counter: c })
    when (o) {
        Some(v) => { assert(count(v.counter) == 0, "payload readable in the arm") }
        None => {}
    }
}

// (C) A wildcard arm matched a variant with a payload, which must be dropped.
fun wildcard_arm_matched_a_payload(c: Ptr<int32>): void {
    val r: Result<int32, Tracked> = Result.Err(Tracked { counter: c })
    val out = when (r) {
        Ok(v) => v
        _ => 0
    }
    assert(out == 0, "the Err branch was the one taken")
}

// (D) A `_` payload binder still drops what it declines to name.
fun underscore_binder_still_drops(c: Ptr<int32>): void {
    val o: Tracked? = Option.Some(Tracked { counter: c })
    when (o) {
        Some(_) => {}
        None => {}
    }
}

// (E) An owning payload escapes elsewhere, consuming the subject, and the arm
// that runs is a wildcard: it must drop the subject's Err payload.
fun wildcard_arm_after_an_owning_escape(c: Ptr<int32>): void {
    val r: Result<Tracked, Tracked> = Result.Err(Tracked { counter: c })
    val out = when (r) {
        Ok(v) => v
        _ => Tracked { counter: c }
    }
    // Two Tracked existed, so two drops.
}

// (F) The arm hands its binder to a borrow parameter: the subject still owns
// it and drops it once.
fun borrows_it(t: &Tracked): int32 {
    return count(t.counter)
}

fun payload_passed_to_a_borrow(c: Ptr<int32>): void {
    val o: Tracked? = Option.Some(Tracked { counter: c })
    when (o) {
        Some(v) => {
            val n = borrows_it(&v)
            assert(n == 0, "the payload is readable through the borrow")
        }
        None => {}
    }
}

// (G) A named, owning, unmoved payload is dropped by its arm's frame. Two
// Tracked in, two drops out.
pub enum Pair {
    Both(Tracked, Tracked)
    Neither
}

fun named_payload_not_moved_out(c: Ptr<int32>): void {
    val p = Pair.Both(Tracked { counter: c }, Tracked { counter: c })
    val out = when (p) {
        Both(a, b) => a
        Neither => Tracked { counter: c }
    }
}

fun main(): int32 {
    val a = new_counter()
    payload_escapes(a)
    assert(count(a) == 1, "A: escaped payload dropped exactly once")

    val b = new_counter()
    payload_stays_in_arm(b)
    assert(count(b) == 1, "B: payload that stayed in the arm dropped exactly once")

    val c = new_counter()
    wildcard_arm_matched_a_payload(c)
    assert(count(c) == 1, "C: the payload a wildcard arm matched dropped exactly once")

    val d = new_counter()
    underscore_binder_still_drops(d)
    assert(count(d) == 1, "D: a discarded payload dropped exactly once")

    val e = new_counter()
    wildcard_arm_after_an_owning_escape(e)
    assert(count(e) == 2, "E: the wildcard arm dropped what it matched")

    val f = new_counter()
    payload_passed_to_a_borrow(f)
    assert(count(f) == 1, "F: a payload only borrowed dropped exactly once")

    val g = new_counter()
    named_payload_not_moved_out(g)
    assert(count(g) == 2, "G: the named payload the arm kept dropped exactly once")

    return 0
}
