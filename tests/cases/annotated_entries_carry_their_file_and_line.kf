//! run: exit 0
//! deps: core
// Each entry says where its declaration is written: the file relative to
// the crate root, and the line of its name.

annotation check

@check
fun first(): void {}

@check
fun second(): void {}

fun main(): int32 {
    val all = annotated<check>()
    if !all[0].file.starts_with("src/") || !all[0].file.ends_with(".kf") { return 1 }
    if all[0].line != 9 { return 2 }
    if all[1].line != 12 { return 3 }
    return 0
}
