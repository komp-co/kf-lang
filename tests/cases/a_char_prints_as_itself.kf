//! run: exit 0
//! deps: core, alloc
// A `char` renders as its UTF-8 encoding, across all four widths.

import core.display.*

fun main(): int32 {
    // The character, not the number.
    if !(String.of(&('A')) == "A") { return 1 }
    if !(String.of(&('é')) == "é") { return 2 }
    if !(String.of(&('€')) == "€") { return 3 }
    if !(String.of(&('😀')) == "😀") { return 4 }

    // Rendered as UTF-8, so the length is the encoded width.
    if String.of(&('A')).byte_len() != 1 { return 5 }
    if String.of(&('é')).byte_len() != 2 { return 6 }
    if String.of(&('€')).byte_len() != 3 { return 7 }
    if String.of(&('😀')).byte_len() != 4 { return 8 }

    // The code point is a different question, and still answerable.
    if !(String.of(&(('é' as uint32))) == "233") { return 9 }

    // Reaching Display through a bound is what `print` does.
    if !(shown('k') == "k") { return 10 }
    if !(shown('€') == "€") { return 11 }

    // A surrogate cannot be encoded and renders as nothing.
    val surrogate: char = 55296 as char
    if String.of(&(surrogate)).byte_len() != 0 { return 12 }
    return 0
}

fun shown<T: Display>(v: T): String {
    var out = String.from("")
    v.display(&var out)
    return out
}
