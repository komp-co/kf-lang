//! run: exit 0
//! deps: core, alloc
// A method call on a non-generic enum is typed by the method's return type.
// A generic enum, materialized as a Struct, is the control.

extern "C" fun runtime_println(s: str): void

pub enum Plain {
    A
    B
}

impl Plain {
    pub fun as_text(): String { return String.from("text") }
    // `int32_t f = <bool>` is valid C, so a wrong type here would run.
    pub fun flag(): bool { return true }
    // int32 is the fallback type, so this would pass by accident.
    pub fun num(): int32 { return 7 }
}

// A generic enum, the control.
pub enum Gen<T> {
    Wrap(T)
    Nothing
}

impl Gen<T> {
    pub fun as_text(): String { return String.from("gen") }
}

fun main(): int32 {
    val p = Plain.A

    val t = p.as_text()
    if !t.as_str().equals("text") { return 1 }

    val f = p.flag()
    if !f { return 2 }

    val n = p.num()
    if n != 7 { return 3 }

    val g: Gen<int32> = Gen.Nothing
    val gt = g.as_text()
    if !gt.as_str().equals("gen") { return 4 }

    runtime_println("ok")
    return 0
}
