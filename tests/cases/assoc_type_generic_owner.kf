//! run: exit 42
// A projection whose owner is a type parameter, resolved by Mono at
// `C = Widget`.
trait Producer {
    type Out
}

struct Widget { pub val v: int32 }

impl Producer for Widget {
    type Out = int32
}

fun grab<C: Producer>(c: C): C.Out {
    return 42
}

fun main(): int32 {
    val w = Widget { v: 1 }
    return grab<Widget>(w)
}
