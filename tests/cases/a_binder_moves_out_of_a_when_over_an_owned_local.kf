//! run: exit 0
//! deps: core, alloc

// A `when` over a local or parameter it owns, with an arm that moves a
// payload out, consumes the local: the payload moves, `Box` and owned struct
// alike, with no copy.

pub struct Item {
    var n: String
}

pub enum Slot {
    Full(Item)
    Boxed(Box<Item>)
    Empty
}

fun items(slot: Slot): List<Item> {
    var out = List.new<Item>()
    when (slot) {
        Full(b) => out.push(b)
        _ => { }
    }
    return out
}

fun boxes(slot: Slot): List<Box<Item>> {
    var out = List.new<Box<Item>>()
    when (slot) {
        Boxed(b) => out.push(b)
        _ => { }
    }
    return out
}

fun main(): int32 {
    val a = items(Slot.Full(Item { n: String.from("kf") }))
    val local = Slot.Boxed(Box.new(Item { n: String.from("boxed") }))
    val b = boxes(local)
    val c = items(Slot.Empty)
    if a.size() != 1 || c.size() != 0 { return 1 }
    if b.at(0).n != "boxed" { return 2 }
    return 0
}
