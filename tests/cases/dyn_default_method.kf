//! run: exit 42

trait Answer {
    fun base(): int32
    fun answer(): int32 { return self.base() + 1 }
}

struct Value { pub val amount: int32 }

impl Answer for Value {
    fun base(): int32 { return self.amount }
}

fun read(value: &dyn Answer): int32 {
    return value.answer()
}

fun main(): int32 {
    val value = Value { amount: 41 }
    return read(value)
}
