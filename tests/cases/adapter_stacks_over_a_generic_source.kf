//! run: exit 0
// A generic struct holding a source and a callable is a source in turn;
// stacked, each layer's receiver is a distinct monomorphization.

trait Src { mutating fun pull(): int32 }
trait Fn1 { fun apply(x: int32): int32 }

struct Counter { pub var n: int32 }

impl Src for Counter {
    mutating fun pull(): int32 {
        self.n = self.n + 1
        return self.n
    }
}

struct Double { }

impl Fn1 for Double {
    fun apply(x: int32): int32 { return x * 2 }
}

struct AddTen { }

impl Fn1 for AddTen {
    fun apply(x: int32): int32 { return x + 10 }
}

struct MapSrc<S, F> {
    pub var inner: S
    pub var f: F
}

impl Src for MapSrc<S: Src, F: Fn1> {
    mutating fun pull(): int32 { return self.f.apply(self.inner.pull()) }
}

fun main(): int32 {
    var m = MapSrc<Counter, Double> { inner: Counter { n: 0 }, f: Double { } }
    if m.pull() != 2 { return 1 }
    if m.pull() != 4 { return 2 }

    var s = MapSrc<MapSrc<Counter, Double>, AddTen> {
        inner: MapSrc<Counter, Double> { inner: Counter { n: 0 }, f: Double { } },
        f: AddTen { }
    }
    if s.pull() != 12 { return 3 }
    if s.pull() != 14 { return 4 }
    return 0
}
