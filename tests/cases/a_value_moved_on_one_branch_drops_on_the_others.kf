//! run: exit 0
//! deps: core, alloc
// A value one branch moves and another keeps is dropped once whichever runs.
// Each scenario counts drops and demands one per value made.
import core.assert.assert_eq

pub struct Tracked {
    var counter: Ptr<int32>
}

impl Drop for Tracked {
    fun drop(): void {
        unsafe { *self.counter = *self.counter + 1 }
    }
}

fun new_counter(): Ptr<int32> {
    val p: Ptr<int32> = unsafe { alloc_array<int32>(1) }
    unsafe { *p = 0 }
    return p
}

fun count(p: Ptr<int32>): int32 {
    return unsafe { *p }
}

fun consume(t: Tracked): void { }

pub enum Pick {
    First,
    Second,
    Third
}

// (A) Moved in `then`, no `else`.
fun moved_in_then(c: Ptr<int32>, which: bool): void {
    val t = Tracked { counter: c }
    if which { consume(t) }
}

// (B) Moved in `else`.
fun moved_in_else(c: Ptr<int32>, which: bool): void {
    val t = Tracked { counter: c }
    if which { } else { consume(t) }
}

// (C) Moved in a nested `if`.
fun moved_in_nested(c: Ptr<int32>, outer: bool, inner: bool): void {
    val t = Tracked { counter: c }
    if outer {
        if inner { consume(t) }
    }
}

// (D) Moved in one arm of a `when`.
fun moved_in_one_arm(c: Ptr<int32>, pick: Pick): void {
    val t = Tracked { counter: c }
    when (pick) {
        First => consume(t)
        Second => { }
        Third => { }
    }
}

// (E) A branch that returns early drops it there.
fun returned_from_the_other(c: Ptr<int32>, which: bool): int32 {
    val t = Tracked { counter: c }
    if which {
        consume(t)
    } else {
        return 1
    }
    return 0
}

impl Clone for Tracked {
    fun clone(): Tracked { return Tracked { counter: self.counter } }
}

pub enum Shape {
    Boxed(Box<Tracked>),
    Empty
}

pub struct Holder {
    var shape: Shape
}

// (G) A binder over a field is a view: moving it out copies, and the holder
// keeps its payload, so both drop.
fun moved_from_a_field(h: Holder, which: bool): void {
    when (h.shape) {
        Boxed(b) => {
            if which { consume(*b) }
        }
        Empty => { }
    }
}

// (F) Assigned again after a move, in one branch: the new value is owned.
fun assigned_again(c: Ptr<int32>, which: bool): Tracked {
    var t = Tracked { counter: c }
    if which {
        consume(t)
        t = Tracked { counter: c }
    }
    return t
}

fun once(label: str, c: Ptr<int32>): void {
    assert_eq(count(c), 1, label)
}

fun each_way(which: bool): void {
    val a = new_counter()
    moved_in_then(a, which)
    once("moved in then", a)
    val b = new_counter()
    moved_in_else(b, which)
    once("moved in else", b)
    val e = new_counter()
    val _r = returned_from_the_other(e, which)
    once("returned from the other branch", e)
    val n = new_counter()
    moved_in_nested(n, which, true)
    once("moved in a nested if", n)
    val m = new_counter()
    moved_in_nested(m, which, false)
    once("kept by a nested if", m)
    val g = new_counter()
    moved_from_a_field(Holder { shape: Shape.Boxed(Box.new(Tracked { counter: g })) }, which)
    assert_eq(count(g), if which { 2 } else { 1 }, "moved from a field")
    val f = new_counter()
    if true { val _kept = assigned_again(f, which) }
    assert_eq(count(f), if which { 2 } else { 1 }, "assigned again after a move")
}

fun each_arm(pick: Pick): void {
    val d = new_counter()
    moved_in_one_arm(d, pick)
    once("moved in one arm", d)
}

fun main(): int32 {
    each_way(true)
    each_way(false)
    each_arm(Pick.First)
    each_arm(Pick.Second)
    each_arm(Pick.Third)
    return 0
}
