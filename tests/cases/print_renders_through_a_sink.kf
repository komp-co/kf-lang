//! run: exit 0
//! deps: core, alloc

// `print` renders through the stdout sink without allocating; `arg_count`
// reads argv.

import core.display.*

struct Tag { pub val n: int32 }

impl Display for Tag {
    fun display(out: &var dyn Write): void {
        out.write_str("<")
        self.n.display(out)
        out.write_str(">")
    }
}

fun main(): int32 {
    // Rendered straight out, in three writes and no String.
    print(Tag { n: 7 })
    println("")
    // A value can still be collected when a caller wants one.
    if !String.of(&(Tag { n: 7 })).as_str().equals("<7>") { return 1 }
    // The case runner passes no arguments, and reading past the end is "".
    if Args.count() != 0 { return 2 }
    if !Args.at(0).equals("") { return 3 }
    return 0
}
