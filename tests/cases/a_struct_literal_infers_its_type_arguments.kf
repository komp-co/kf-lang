//! run: exit 37
// A generic struct literal reads its type arguments off its fields, through
// `Ptr<T>` and a nested instance as well as a bare `T`.

struct Wrap<T> {
    val v: T
}

struct Cursor<T> {
    val first: Ptr<T>
    val length: uint64
}

struct Pair<A, B> {
    val a: A
    val b: Wrap<B>
}

fun main(): int32 {
    val w = Wrap { v: 5 }
    var x: int32 = 30
    val c = Cursor { first: unsafe { (&var x) as Ptr<int32> }, length: 1 }
    val p = Pair { a: 2, b: Wrap { v: true } }
    val read = unsafe { *c.first }
    if p.b.v { return w.v + read + p.a }
    return 0
}
