//! build: fail
//! deps: core
// A field is a slot like an annotated binding: an `Option<Ptr<int32>>` does not
// fit a `Box<int32>?` field, and the checker says so rather than cc.

struct Holder {
    pub var item: Box<int32>?
}

fun main(): int32 {
    var h = Holder { item: null }
    val raw: Ptr<int32> = unsafe { alloc<int32>() }
    unsafe { *raw = 7 }
    h.item = Option.Some<Ptr<int32>>(raw)
    return 0
}
