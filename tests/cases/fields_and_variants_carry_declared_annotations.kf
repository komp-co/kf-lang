//! run: exit 0
//! deps: core, alloc

annotation skip on field
annotation rename(name: String) on field
annotation tag(code: int32) on variant
annotation either on <field, variant>

struct User {
    @rename("id")
    val user_id: int64
    @skip
    @either
    val password: String
}

enum Shape {
    @tag(-1)
    Circle(float64)
    @either Square
}

fun main(): int32 {
    val user = User { user_id: 7, password: "hunter2" }
    val shape = Shape.Circle(1.5)
    if user.user_id != 7 { return 1 }
    return when (shape) {
        Circle(_r) => 0
        Square => 2
    }
}
