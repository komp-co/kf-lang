//! run: exit 7
//! deps: core, alloc
// A public struct holding `List<Hidden>` with `Hidden` private: the header
// declares `Hidden` though only a pointer field reaches it.
import alloc.list.*

struct Hidden {
    val a: uint64
}

pub struct Holder {
    var rows: List<Hidden>
}

pub fun make(): Holder {
    var rows = List.new<Hidden>()
    rows.push(Hidden { a: 7 })
    return Holder { rows: rows }
}

fun main(): int32 {
    val h = make()
    return h.rows.at(0).a as int32
}
