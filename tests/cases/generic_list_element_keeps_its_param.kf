//! run: exit 0
//! deps: core, alloc
// An element read out of a `List<T>` in a generic scope has type `T`:
//
//     fun pick<T: Copy>(xs: List<T>): T { return *xs.at(0) }

struct Wrap<T> {
    pub var xs: List<T>
}

impl Wrap<T: Copy> {
    // The method form.
    pub fun first(): T { return *self.xs.at(0) }
    // `at` yields `&T`.
    pub fun first_borrowed(): bool { return same<T>(self.xs.at(0), self.xs.at(0)) }
    // Into an Option slot.
    pub fun try_first(): T? {
        if self.xs.size() == 0 { return null }
        return *self.xs.at(0)
    }
}

// A `&T` sink, checking the borrow against a written `&T`.
fun same<T>(a: &T, b: &T): bool { return true }

// The free-function form.
fun pick<T: Copy>(xs: List<T>): T {
    return *xs.at(0)
}

// A borrowed container.
fun pick_ref<T: Copy>(xs: &List<T>): T {
    return *xs.at(0)
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(5)
    if pick<int32>(xs) != 5 { return 1 }

    var ys = List.new<int32>()
    ys.push(6)
    if pick_ref<int32>(&ys) != 6 { return 2 }

    var w = Wrap<int32> { xs: List.new<int32>() }
    w.xs.push(7)
    if w.first() != 7 { return 3 }
    if !w.first_borrowed() { return 4 }

    when (w.try_first()) {
        Some(v) => { if v != 7 { return 5 } }
        None    => return 6
    }

    // A second instance.
    var b = Wrap<bool> { xs: List.new<bool>() }
    b.xs.push(true)
    if !b.first() { return 7 }

    // An empty container reports absence.
    val e = Wrap<int32> { xs: List.new<int32>() }
    when (e.try_first()) {
        Some(_) => return 8
        None    => { }
    }
    return 0
}
