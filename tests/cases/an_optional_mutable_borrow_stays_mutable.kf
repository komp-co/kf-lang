//! run: exit 0
//! deps: core, alloc
// `Option<&T>` and `Option<&var T>` are distinct instances, and a generic
// return decoded from its mangled suffix keeps the borrow's mutability.
//
// CONSTRAINT: nothing here writes `Option<&var Cell>` concretely: a written
// type materializes its own layout and would pass without the decode.
import core.assert.*
import alloc.list.*

pub struct Cell {
    pub var n: int32
}

// A mutable borrow under a generic container, in a return type no call site
// writes.
fun first_mut<T>(xs: &var List<T>): Option<&var T> {
    if xs.size() == 0 { return Option.None }
    return Option.Some(xs.at_mut(0))
}

// The shared form beside it, in one compilation.
fun first_shared<T>(xs: &List<T>): Option<&T> {
    if xs.size() == 0 { return Option.None }
    return Option.Some(xs.at(0))
}

fun main(): int32 {
    var xs = List.new<Cell>()
    xs.push(Cell { n: 1 })

    // (A) The write the signature permits.
    when (first_mut(&var xs)) {
        Some(c) => { c.n = 5 }
        None => assert(false, "A: the list has an element")
    }
    assert(xs.at(0).n == 5, "A: the write reached the element")

    // (B) The shared borrow reads, as a different instance.
    when (first_shared(&xs)) {
        Some(c) => assert(c.n == 5, "B: read through the shared borrow")
        None => assert(false, "B: the list has an element")
    }

    // (C) The empty list takes None either way.
    var empty = List.new<Cell>()
    when (first_mut(&var empty)) {
        Some(_) => assert(false, "C: the list is empty")
        None => assert(true, "C: None on an empty list")
    }
    return 0
}
