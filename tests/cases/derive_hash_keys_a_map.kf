//! run: exit 0
//! deps: core, alloc
// `@derive(Hash)` combines the fields' hashes. With `@derive(Equal)` over the
// same fields, equal values hash equally, so the struct keys a `HashMap`.

import core.hash.*

@derive(Hash, Equal)
struct Point {
    pub var x: int32
    pub var y: int32
}

@derive(Hash, Equal)
struct Tagged {
    pub var name: String
    pub var n: uint64
}

fun main(): int32 {
    // Equal values hash equally.
    val a = Point { x: 3, y: 4 }
    val b = Point { x: 3, y: 4 }
    if a.hash() != b.hash() { return 1 }

    // The fields participate: different values need not collide.
    val c = Point { x: 4, y: 3 }
    if a.hash() == c.hash() { return 2 }

    // An owning field reaches its own impl.
    val t1 = Tagged { name: String.from("k"), n: 1 }
    val t2 = Tagged { name: String.from("k"), n: 1 }
    if t1.hash() != t2.hash() { return 3 }
    val t3 = Tagged { name: String.from("j"), n: 1 }
    if t1.hash() == t3.hash() { return 4 }

    // A derived struct keys a map.
    var m = HashMap.new<Point, int32>()
    m.insert(Point { x: 1, y: 2 }, 12)
    m.insert(Point { x: 3, y: 4 }, 34)
    val probe = Point { x: 3, y: 4 }
    when (m.get(&probe)) {
        Some(v) => { if v != 34 { return 5 } }
        None => return 6
    }
    val absent = Point { x: 9, y: 9 }
    if m.contains(&absent) { return 7 }
    if m.size() != 2 { return 8 }
    return 0
}
