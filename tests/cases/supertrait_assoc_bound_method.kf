//! run: exit 42
//! deps: core
// An associated type declared by a supertrait, reached through the subtrait's
// bound: `it` is typed `C.It`, whose methods come from the bound on `type It`
// in `Iterable2`. A struct choice, since a primitive matches the checker's
// fallback.

trait Stepper { fun step(): int32 }

trait Iterable2 {
    type It: Stepper
    fun iter(): Self.It
}

trait Collection: Iterable2 {
    fun size2(): int32
}

struct Cursor { pub val n: int32 }
impl Stepper for Cursor { fun step(): int32 { return self.n } }

struct Bag { pub val v: int32 }

impl Iterable2 for Bag {
    type It = Cursor
    fun iter(): Self.It { return Cursor { n: 42 } }
}

impl Collection for Bag {
    fun size2(): int32 { return 1 }
}

fun run<C: Collection>(c: C): int32 {
    val it = c.iter()
    return it.step()
}

fun main(): int32 {
    val b = Bag { v: 1 }
    return run<Bag>(b)
}
