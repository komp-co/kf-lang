//! build: fail
//! deps: core
// A method on a raw-pointer receiver is checked: `Ptr<uint8>` autoderefs to
// `uint8`, and an unknown method on a primitive is reported. `equals`,
// `compare` and `display` are satisfied intrinsically.

fun main(): int32 {
    val p = unsafe { 0 as Ptr<uint8> }
    if p.no_such_method_at_all() { return 0 }
    return 1
}
