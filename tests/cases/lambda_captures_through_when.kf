//! run: exit 0
//! deps: core, alloc
// A lambda captures what a `when` inside it reads: its subject, its guards
// and its arms, in the expression form and the statement form alike.

fun apply<F: Call1<int32>>(f: F, x: int32): int32 { return f.call(x) }

fun main(): int32 {
    val limit: int32 = 10
    val bonus: int32 = 5
    val expression = apply(|x: int32| when x + bonus {
        v if v > limit => v - limit
        _ => bonus
    }, 12)
    if expression != 7 { return 1 }

    val statement = apply(|x: int32| {
        var out = 0
        when x {
            v if v > limit => out = 1
            _ => out = bonus
        }
        out
    }, 3)
    if statement != 5 { return 2 }

    val name = String.from("get")
    val through_method = apply(|x: int32| when x {
        v if v == name.byte_len() as int32 => 1
        _ => 0
    }, 3)
    if through_method != 1 { return 3 }
    if name.byte_len() != 3 { return 4 }
    return 0
}
