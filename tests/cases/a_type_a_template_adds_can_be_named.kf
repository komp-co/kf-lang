//! run: exit 0
//! deps: core
// A type a template adds is declared like one written by hand, so a
// signature can name it, in the template and outside it.

annotation summarized on struct

template summarized on struct T {
    struct Summary {
        val count: int64
    }

    fun T.summary(): Summary {
        return Summary { count: T.fields.size() as int64 }
    }
}

@summarized
struct Point {
    val x: int32
    val y: int32
}

fun count_of(s: Summary): int64 { return s.count }

fun main(): int32 {
    return count_of(Point { x: 1, y: 2 }.summary()) as int32 - 2
}
