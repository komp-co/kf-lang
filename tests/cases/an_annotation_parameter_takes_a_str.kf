//! run: exit 0
//! deps: core
// A `str` parameter takes a string literal, so a crate on core alone can
// give an annotation text; the arguments' struct is then a view.

annotation skip(reason: str, owner: str = "nobody") on () -> void

@skip("waiting on a fix")
fun later(): void {}

@skip(owner = "parser", reason = "flaky")
fun flaky(): void {}

fun main(): int32 {
    val all = annotated<skip>()
    if all[0].args.reason != "waiting on a fix" || all[0].args.owner != "nobody" { return 1 }
    if all[1].args.reason != "flaky" || all[1].args.owner != "parser" { return 2 }
    return 0
}
