//! run: exit 0
//! deps: core, alloc
// `outer` declares `T: Compare` and hands T to `inner`, which asks for the
// same bound, with T nested: `List<T>`, `&List<T>`, `Wrap<T>` and `T?`. An
// unbounded caller parameter is rejected, which `check_bounds` covers.

import alloc.list.*

fun inner<T: Compare>(xs: &List<T>): uint64 {
    return xs.size()
}

fun outer<T: Compare>(xs: &List<T>): uint64 {
    return inner(xs)
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(3)
    xs.push(7)
    if outer<int32>(&xs) != 2 {
        return 1
    }
    return 0
}
