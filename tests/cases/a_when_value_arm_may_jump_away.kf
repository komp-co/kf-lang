//! run: exit 0
//! deps: core, alloc
// An arm or branch ending in `return`, `break` or `continue` never yields,
// so a `when` or `if` used as a value accepts it.


fun halves_of_evens(xs: &List<int32>): int32 {
    var total = 0
    while x in &xs {
        val half = when (x % 2) {
            0 => x / 2
            _ => continue
        }
        total = total + half
    }
    return total
}

fun until_negative(xs: &List<int32>): int32 {
    var total = 0
    while x in &xs {
        val v = if x >= 0 { x } else { break }
        total = total + v
    }
    return total
}

fun label(x: int32): String {
    val word = when (x) {
        0 => String.from("zero")
        1 => { String.from("one") }
        _ => return String.from("many")
    }
    return word + "!"
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(4)
    xs.push(3)
    xs.push(8)
    xs.push(-1)
    xs.push(6)
    if halves_of_evens(&xs) != 9 { return 1 }
    if until_negative(&xs) != 15 { return 2 }
    if label(0) != "zero!" { return 3 }
    if label(1) != "one!" { return 4 }
    if label(5) != "many" { return 5 }
    return 0
}
