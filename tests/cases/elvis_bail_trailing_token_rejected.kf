// Trailing tokens after an unbraced `?:` right-hand side are reported, as
// they are after any statement:
//
//     error: expected end of line after this statement, found an integer
//            literal
//
// `parse_elvis_bail` calls `parse_stmt` outside the block loop.

import core.option.*

fun pick(): int32? { return Option.Some(7) }

fun main(): int32 {
    val z = 5
    val v = pick() ?: return z 12345
    return v - 7
}
