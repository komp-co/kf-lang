//! run: exit 0
//! deps: core, alloc

fun identity(value: String): String {
    return value
}

fun main(): int32 {
    val raw: str = "raw"
    if !raw.equals("raw") { return 1 }

    val left: String = "left"
    val suffix: String = "-right"
    val joined = left + suffix
    if joined != "left-right" { return 2 }

    if suffix != "-right" { return 3 }

    val copied = identity("owned")
    if copied != "owned" { return 4 }
    return 0
}
