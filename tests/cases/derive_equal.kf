//! run: exit 0
//! deps: core
import core.assert.*

@derive(Equal)
struct Point { val x: int32, val y: int32 }

@derive(Equal)
struct Segment { val start: Point, val end: Point }

fun main(): void {
    val a = Segment { start: Point { x: 1, y: 2 }, end: Point { x: 3, y: 4 } }
    val b = Segment { start: Point { x: 1, y: 2 }, end: Point { x: 3, y: 4 } }
    val c = Segment { start: Point { x: 1, y: 2 }, end: Point { x: 3, y: 5 } }
    assert_eq(a == b, true, "derived equality compares every matching field")
    assert_eq(a != c, true, "derived equality rejects a mismatched nested field")
}
