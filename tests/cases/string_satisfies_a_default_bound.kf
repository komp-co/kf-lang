//! run: exit 0
//! deps: core, alloc
// `String` implements `Default`, satisfying a bound, and a derived default
// gives a `String` field "" through that impl.
fun make<T: Default>(): T { return T.default() }

@derive(Default)
pub struct Named {
    var name: String
}

fun main(): int32 {
    val s = make<String>()
    if !s.as_str().equals("") { return 1 }
    val n = Named.default()
    if !n.name.as_str().equals("") { return 2 }
    return 0
}
