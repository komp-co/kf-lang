//! run: exit 0
//! deps: core

// Postfix `?`: carry on with the payload, or return the bail out of the
// function. It calls `Try.branch` and rebuilds through `FromResidual`, so any
// type can opt in. The parser parks the subject, so `?` sits anywhere:
// `add(half(a)?, half(b)?)` parks two, evaluated left to right.

import core.option.*
import core.result.*

fun half(n: int32): int32? {
    if n % 2 == 0 { return Option.Some(n / 2) }
    return null
}

fun add(a: int32, b: int32): int32 { return a + b }

// In a binding initializer, twice, with the second reading the first.
fun quarter(n: int32): int32? {
    val h = half(n)?
    val q = half(h)?
    return Option.Some(q)
}

// In argument position, twice in one expression.
fun sum_of_halves(a: int32, b: int32): int32? {
    return Option.Some(add(half(a)?, half(b)?))
}

// Inside a nested block: the `when` wraps the rest of that block only.
fun nested(n: int32): int32? {
    var acc = 0
    if n > 0 {
        val h = half(n)?
        acc = h
    }
    return Option.Some(acc + 1)
}

fun rhalf(n: int32): Result<int32, int32> {
    if n % 2 == 0 { return Result.Ok<int32, int32>(n / 2) }
    return Result.Err<int32, int32>(n)
}

// On a Result, and chained: the inner `?` feeds the outer call.
fun rquarter(n: int32): Result<int32, int32> {
    val q = rhalf(rhalf(n)?)?
    return Result.Ok<int32, int32>(q)
}

fun main(): int32 {
    if quarter(8).unwrap() != 2 { return 1 }
    if quarter(6).is_some() { return 2 }
    if quarter(7).is_some() { return 3 }

    if sum_of_halves(4, 6).unwrap() != 5 { return 4 }
    if sum_of_halves(3, 6).is_some() { return 5 }
    if sum_of_halves(4, 7).is_some() { return 6 }

    if nested(8).unwrap() != 5 { return 7 }
    if nested(7).is_some() { return 8 }

    when (rquarter(8)) {
        Ok(v) => { if v != 2 { return 9 } }
        Err(_e) => { return 10 }
    }
    // The bail carries the inner call's error out through both `?`.
    when (rquarter(6)) {
        Ok(_v) => { return 11 }
        Err(e) => { if e != 3 { return 12 } }
    }
    return 0
}
