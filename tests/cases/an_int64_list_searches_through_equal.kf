//! run: exit 0
//! deps: core, alloc
// `contains`, `index_of` and `last_index_of` reach `int64`'s `Equal` through a
// generic body, which passes self by pointer as it does at every width.

fun main(): int32 {
    var xs = List.new<int64>()
    val v: int64 = 5
    val w: int64 = -9
    xs.push(w)
    xs.push(v)
    if !xs.contains(&v) { return 1 }
    if xs.index_of(&v) != 1 { return 2 }
    if xs.last_index_of(&w) != 0 { return 3 }
    if !v.display().as_str().equals("5") { return 4 }
    return 0
}
