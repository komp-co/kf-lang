//! run: exit 0
//! deps: core
// `rev()` yields a range's elements backwards; `down()` travels between the
// endpoints as written:
//
//     range(0, 10, 3)          is 0, 3, 6, 9
//     range(0, 10, 3).rev()    is 9, 6, 3, 0      - the same elements
//     range(10, 0, 3).down()   is 10, 7, 4, 1     - a different sequence
//
// The import is explicit: `core.range` is auto-imported only by `..`.

import core.range.*

fun first(r: Range<int32>): int32 {
    while v in r { return v }
    return -1
}

fun total(r: Range<int32>): int32 {
    var n: int32 = 0
    var guard: int32 = 0
    while v in r {
        n = n + v
        guard = guard + 1
        if guard > 100 { return -1 }
    }
    return n
}

fun count(r: Range<int32>): int32 {
    var n: int32 = 0
    while _v in r { n = n + 1 }
    return n
}

fun main(): int32 {
    // The index walk: n-1 down to 0, with no underflow for the caller.
    if first(range(0, 5, 1).rev()) != 4 { return 1 }
    if total(range(0, 5, 1).rev()) != 10 { return 2 }
    if count(range(0, 5, 1).rev()) != 5 { return 3 }

    // Stepped: rev starts at the last ELEMENT, down() at the endpoint.
    if first(range(0, 10, 3).rev()) != 9 { return 4 }
    if first(range(10, 0, 3).down()) != 10 { return 5 }
    if total(range(0, 10, 3).rev()) != 18 { return 6 }

    // A step that divides the span exactly.
    if first(range(0, 9, 3).rev()) != 6 { return 7 }
    if first(range_inclusive(0, 9, 3).rev()) != 9 { return 8 }

    // Empty stays empty, and reversing twice is the original.
    if count(range(0, 0, 1).rev()) != 0 { return 9 }
    if first(range(0, 5, 1).rev().rev()) != 0 { return 10 }
    return 0
}
