//! build: fail
//! deps: core, alloc
// A view borrows from one place; fields lent from two bindings are rejected.

view struct Pair {
    val a: str
    val b: str
}

fun main(): int32 {
    val x = String.from("ab")
    val y = String.from("cde")
    val p = Pair { a: x.as_str(), b: y.as_str() }
    return (p.a.byte_len() + p.b.byte_len()) as int32
}
