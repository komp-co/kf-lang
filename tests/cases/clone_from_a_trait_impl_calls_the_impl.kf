//! run: exit 19
//! deps: core, alloc
// `.clone()` on a type whose `Clone` comes from a trait impl calls the impl's
// method. `Tag`'s clone returns `n + 1`, so the body is shown to run, not
// just link.
import core.option.*

pub struct Tag { pub var n: int32 }

impl Clone for Tag {
    fun clone(): Tag { return Tag { n: self.n + 1 } }
}

fun main(): int32 {
    val t = Tag { n: 4 }
    val t2 = t.clone()                       // a user trait impl:   5
    val s: String? = Option.Some(String.from("ada"))
    val s2 = s.clone()                       // core's Clone for Option: 3
    val o: Tag? = Option.Some(Tag { n: 10 })
    val o2 = o.clone()                       // both at once:        11
    var total: int32 = t2.n
    when (s2) { Some(v) => { total = total + (v.byte_len() as int32) }  None => { return 1 } }
    when (o2) { Some(v) => { total = total + v.n }  None => { return 2 } }
    return total
}
