//! run: exit 0
//! deps: core, alloc

// A generic function instantiated at a borrow. The inferred binding is
// written back as an explicit type argument, so the instance is minted.
//
// `a.equals(b)` on a `&int32` auto-derefs to `int32`'s impl, whose `other:
// Self` is by value, so the argument is dereferenced too, but only when it
// mangles as the receiver's type. A parameter that is a borrow in its own
// right keeps its pointer; `borrowed_param_is_untouched` holds that.


fun same<T: Equal>(a: T, b: T): bool {
    return a.equals(b)
}

fun bigger<T: Compare>(a: T, b: T): bool {
    return a.compare(b) > 0
}

struct Key { val n: int32 }

// A `&Key` parameter not shaped like the receiver keeps its pointer.
impl Key {
    fun matches(other: &Key): bool { return self.n == other.n }
}

fun main(): int32 {
    var xs = List.new<int32>()
    xs.push(7)
    xs.push(9)

    // Both arguments are borrows, one taken from a container.
    val borrowed = xs.at(0)
    val other = xs.at(1)
    if !same(borrowed, borrowed) { return 1 }
    if same(borrowed, other) { return 2 }

    // A second trait.
    if !bigger(other, borrowed) { return 3 }
    if bigger(borrowed, other) { return 4 }

    // A borrowed receiver whose method takes a genuine `&Key`.
    var keys = List.new<Key>()
    keys.push(Key { n: 3 })
    val k = keys.at(0)
    if !k.matches(k) { return 5 }

    return 0
}
