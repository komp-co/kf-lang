//! run: exit 0
//! deps: core, alloc
// `_` stands for any one type, `&_` for a borrow of any type, and a trailing
// `..` for any further parameters, none included. Entries name each function
// without a value to call.

struct Server {
    var hits: int32
}

annotation flag on (bool, ..) -> bool
annotation pair on (bool, _) -> bool
annotation any_result on (int32) -> _
annotation hook on (&_, bool) -> bool
annotation logged on (..) -> _

@flag
@logged
fun one(a: bool): bool { return a }

@flag
@pair
fun two(a: bool, n: int32): bool { return a }

@flag
@pair
fun three(a: bool, s: String): bool { return a }

@any_result
fun named(n: int32): String { return "x" }

@any_result
@logged
fun counted(n: int32): Server { return Server { hits: n } }

impl Server {
    @hook
    fun check(on: bool): bool { return on }
}

fun main(): int32 {
    val flags = annotated<flag>()
    if flags.size() != 3 || flags.at(2).name != "three" { return 1 }
    if annotated<pair>().size() != 2 { return 2 }
    if annotated<any_result>().size() != 2 { return 3 }
    if annotated<hook>().at(0).name != "Server.check" { return 4 }
    if annotated<logged>().size() != 2 || annotated<logged>().at(0).kind != AnnotatedKind.Function { return 5 }
    return 0
}
