//! build: fail
//! deps: core


struct Counter { var value: int32 }

impl Counter {
    mutating fun bump(): int32 {
        self.value = self.value + 1
        return self.value
    }
}

fun main(): int32 {
    var counter = Counter { value: 0 }
    val next = || counter.bump()
    return next()
}
