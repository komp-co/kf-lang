//! run: exit 2
//! deps: core
// `Pair<int32, B>` in a scope whose own parameter is also named `B` is an
// instance of `Pair`, not its template, so its methods are found.

struct Pair<A, B> {
    val a: A
}

impl<A, B> Pair<A, B> {
    fun tag(): int32 { return 1 }
}

fun full<A, B>(p: &Pair<A, B>): int32 { return p.tag() }

fun partial<B>(p: &Pair<int32, B>): int32 { return p.tag() }

fun main(): int32 {
    val p = Pair<int32, bool> { a: 1 }
    return full(&p) + partial(&p)
}
