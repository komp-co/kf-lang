//! run: exit 0
//! deps: core
// An enum method called `tag` compiles: the tag typedef is `kf__tag__<Enum>`,
// a reserved prefix no method mangle produces.

pub enum Holder<T> { Full(T)  Empty }

impl Holder<T> {
    pub fun tag(): int32 {
        return when (self) { Full(_v) => 1   Empty => 0 }
    }
}

fun main(): int32 {
    val full: Holder<int32> = Holder.Full(1)
    if full.tag() != 1 { return 1 }
    val empty: Holder<int32> = Holder.Empty
    if empty.tag() != 0 { return 2 }
    return 0
}
