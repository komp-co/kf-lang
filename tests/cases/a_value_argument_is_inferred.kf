//! run: exit 16
//! deps: core
// A value argument is inferred like a type argument: from the declared type
// of the result, or from an argument.

struct Residue<I: Integer, M: I> {
    val value: I
}

fun wrap<I: Integer, M: I>(v: I): Residue<I, M> {
    return Residue<I, M> { value: v % M }
}

fun modulus_of<I: Integer, M: I>(r: &Residue<I, M>): I { return M }

fun main(): int32 {
    val x: Residue<int32, 9> = wrap(16)
    return x.value + modulus_of(&x)
}
