//! run: exit 0
//! deps: core
// A lambda is a struct with a Call impl, so a Call-bounded generic takes one
// directly and monomorphizes per lambda.


fun run0<F: Call0>(f: F): int32 { return f() }
fun apply_twice<F: Call1<int32>>(f: F, x: int32): int32 { return f(f(x)) }
fun run2<F: Call2<int32, int32>>(f: F, a: int32, b: int32): int32 { return f(a, b) }
fun holds<F: Call1<int32>>(f: F, x: int32): bool { return f(x) }

fun main(): int32 {
    if run0(|| 7) != 7 { return 1 }
    if apply_twice(|x: int32| x * 2, 3) != 12 { return 2 }
    if run2(|a: int32, b: int32| a + b, 20, 3) != 23 { return 3 }
    if !holds(|x: int32| x > 5, 9) { return 4 }
    // Two lambdas of one shape are distinct types.
    if apply_twice(|x: int32| x + 1, 0) != 2 { return 5 }
    return 0
}
