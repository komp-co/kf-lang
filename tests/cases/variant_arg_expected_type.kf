//! run: exit 0
//! deps: core
// A variant's payload type is a slot: a bare `Option.None` as a constructor
// argument takes its instance from the declaration.
import core.option.*

pub enum Step {
    Ret(int32?)
    Stop
}

pub enum Inner { B(int32?) }
pub enum Outer { A(Inner) }

fun value_of(s: Step): int32 {
    when (s) {
        Ret(m) => {
            val v = m ?: return -1
            return v
        }
        Stop => return -2
    }
    return -3
}

fun nested_is_none(): bool {
    val o = Outer.A(Inner.B(Option.None))
    when (o) {
        A(i) => {
            when (i) {
                B(m) => return m.is_none()
            }
        }
    }
    return false
}

fun main(): int32 {
    // Inferable from the payload.
    if value_of(Step.Ret(Option.Some(5))) != 5 { return 1 }
    // Not inferable: from the declaration.
    if value_of(Step.Ret(Option.None)) != -1 { return 2 }
    if value_of(Step.Stop) != -2 { return 3 }
    // One level down.
    if !nested_is_none() { return 4 }
    return 0
}
