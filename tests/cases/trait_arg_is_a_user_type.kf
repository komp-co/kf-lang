//! run: exit 0
//! deps: core, alloc
// A trait argument written as a literal user type reaches the impl methods'
// dispatch suffix crate-qualified, agreeing with the call sites. A primitive
// carries no qualifier and would not show it.


struct Point { pub var x: int32 }

struct GetX { }
impl Call1<Point> for GetX {
    type Out = int32
    fun call(p: Point): int32 { return p.x }
}

// The free-function and method forms both land on the same symbol.
fun map_free<T, F: Call1<T>>(xs: List<T>, f: F): List<F.Out> {
    var out = List.new<F.Out>()
    var i: uint64 = 0
    while i < xs.size() {
        out.push(f.call(*xs.at(i)))
        i = i + 1
    }
    return out
}

// Declared here, since an inherent impl belongs to its target's crate.
struct Seq<T> { pub var items: List<T> }

impl Seq<T> {
    pub fun map_local<F: Call1<T>>(f: F): List<F.Out> {
        var out = List.new<F.Out>()
        var i: uint64 = 0
        while i < self.items.size() {
            out.push(f.call(*self.items.at(i)))
            i = i + 1
        }
        return out
    }
}

fun main(): int32 {
    var ps = List.new<Point>()
    ps.push(Point { x: 5 })
    ps.push(Point { x: 9 })

    val a = map_free(ps.clone(), GetX { })
    if a.size() != 2 { return 1 }
    if a.get(1) != 9 { return 2 }

    var seq = Seq<Point> { items: ps.clone() }
    val b = seq.map_local(GetX { })
    if b.get(0) != 5 { return 3 }
    return 0
}
