//! build: fail
//! deps: core
// `self == other` inside `equals` calls `equals` and would recurse until the
// stack runs out. Syntactic only: it does not see through a helper.

struct Point { pub val x: int32 }

impl Equal for Point {
    fun equals(other: &Point): bool { return self == other }
}

fun main(): int32 {
    val a = Point { x: 1 }
    val b = Point { x: 2 }
    if a == b { return 1 }
    return 0
}
