//! run: exit 0
//! deps: core
// core's public functions need no import, like its types. Nothing here is
// imported.

fun main(): int32 {
    println("core needs no import")
    if max<int32>(3, 7) != 7 { return 1 }
    if !"komp".contains("om") { return 2 }
    if Args.count() != 0 { return 3 }
    assert_eq(abs(-2), 2, "abs")
    return 0
}
