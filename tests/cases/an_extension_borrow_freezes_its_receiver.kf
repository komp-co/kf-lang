//! build: fail
//! deps: core, alloc
// A borrow an extension returns borrows its receiver, as a method's does.

fun String.peek(): str { return self.as_str() }

fun main(): int32 {
    var owned = String.from("hello")
    val v = owned.peek()
    owned.append("!")
    return v.byte_len() as int32
}
