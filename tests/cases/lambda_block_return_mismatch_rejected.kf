// A `return` inside a block body must agree with the trailing expression the
// lambda's type is inferred from.


fun apply<F: Call1<int32>>(f: F, x: int32): int32 { return f.call(x) }

fun main(): int32 {
    return apply(|x| {
        if x > 2 { return true }
        0
    }, 5)
}
