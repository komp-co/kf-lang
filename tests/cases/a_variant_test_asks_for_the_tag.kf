//! run: exit 27
//! deps: core, alloc

// `x is V` tests the variant alone: a bare payload variant matches any
// payload, a written pattern its own, and `is` stays usable as a name.

enum Shape {
    Circle(int32)
    Rect(int32, int32)
    Empty
}

fun make(n: int32): Shape {
    if n == 0 { return Shape.Empty }
    if n == 1 { return Shape.Circle(2) }
    return Shape.Rect(2, 3)
}

fun main(): int32 {
    val a = make(1) is Circle
    val b = make(2) is Rect && make(0) is Empty
    val c = make(2) is Circle || make(0) is Rect(_, _)
    val d = make(2) is Rect(2, 3)
    val is = 4
    val e: int32? = Option.Some(is)
    val f = e is Some
    var n = 0
    if a { n = n + 1 }
    if b { n = n + 2 }
    if c { n = n + 4 }
    if d { n = n + 8 }
    if f { n = n + 16 }
    return n
}
