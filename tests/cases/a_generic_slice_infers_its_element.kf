//! run: exit 13
//! deps: core, alloc
// A slice's element is inferred from the array or list passed for it.
import alloc.list.*

fun count<T>(xs: &T[]): uint64 { return xs.size() }

fun first<T: Copy>(xs: &T[]): T { return xs[0] }

fun main(): int32 {
    val wide: int64[4] = [9, 2, 3, 4]
    var flags = List.new<bool>()
    flags.push(true)
    val n = count(wide) + count(flags)
    return n as int32 + first(&wide) as int32 - 1
}
