//! run: exit 0
//! deps: core
// A generic enum value whose type argument comes only from the payload,
// `val a = Res.Ok(7)`, mints `Res__int32`. core's Option is the same shape:
// `val found = Option.Some(42)`.

enum Res<T> {
    Ok(T)
    Bad
}

fun main(): int32 {
    // Inferred from the payload.
    val a = Res.Ok(7)
    when (a) {
        Ok(v) => { if v != 7 { return 1 } }
        Bad => return 2
    }

    // A second instance of the same enum.
    val b = Res.Ok(true)
    when (b) {
        Ok(v) => { if !v { return 3 } }
        Bad => return 4
    }

    // The explicit form.
    val c = Res.Ok<int32>(9)
    when (c) {
        Ok(v) => { if v != 9 { return 5 } }
        Bad => return 6
    }

    // core's Option, through a dependency.
    val found = Option.Some(42)
    if found.is_none() { return 7 }
    return 0
}
