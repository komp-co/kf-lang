//! run: exit 0
//! deps: core, alloc
// A trait method whose parameter is `&Self`, called directly, borrows a value
// argument: a literal, a local and a struct built in place alike.
struct V { val x: int32 }

impl Equal for V {
    fun equals(other: &V): bool { return self.x == other.x }
}

fun main(): int32 {
    if !(5).equals(5) { return 1 }
    val n = 7
    if (5).equals(n) { return 2 }
    if (5).compare(n) >= 0 { return 5 }
    if (5).add(n) != 12 { return 6 }
    val v = V { x: 3 }
    if !v.equals(V { x: 3 }) { return 3 }
    if v.equals(V { x: 4 }) { return 4 }
    return 0
}
