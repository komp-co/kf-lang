//! run: exit 0
//! deps: core, alloc
// `List.new()` takes its type argument from the slot it flows into.


fun empty(): List<int32> {
    // A return type is a slot.
    return List.new()
}

fun count(xs: List<int32>): uint64 {
    return xs.size()
}

// A generic function's own parameter works too: mono substitutes `List<T>`.
fun empty_of<T>(): List<T> {
    return List.new()
}

fun main(): int32 {
    // An annotation.
    val a: List<int32> = List.new()
    if a.size() != 0 { return 1 }

    if empty().size() != 0 { return 2 }

    // A parameter.
    if count(List.new()) != 0 { return 3 }

    val g: List<int32> = empty_of<int32>()
    if g.size() != 0 { return 4 }

    // Written type arguments outrank everything; inference off a value
    // argument still works.
    var w = List.new<int32>()
    w.push(7)
    if w.get(0) != 7 { return 5 }
    val b = Box.new(5 as int32)
    if *b != 5 { return 6 }
    return 0
}
