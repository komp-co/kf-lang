//! run: exit 0
//! deps: core, alloc
// The eager adapters on List. `Call1<T>` takes its argument by value, so each
// element handed to a callable is a copy and the source survives intact.


fun ints(n: uint64): List<int32> {
    var out = List.new<int32>()
    var i: uint64 = 0
    while i < n {
        out.push((i as int32) + 1)
        i = i + 1
    }
    return out
}

fun words(): List<String> {
    var out = List.new<String>()
    out.push(String.from("aa"))
    out.push(String.from("bbb"))
    out.push(String.from("cc"))
    return out
}

fun main(): int32 {
    if ints(3).map(|x| x * 2).get(2) != 6 { return 1 }
    // The body decides the element type: a List<bool>.
    if ints(3).map(|x| x % 2 == 1).get(0) != true { return 2 }

    if ints(4).filter(|x| x > 2).size() != 2 { return 3 }
    if ints(4).filter(|x| x > 2).get(0) != 3 { return 4 }
    if ints(0).filter(|x| x > 0).size() != 0 { return 5 }

    if ints(4).fold(0, |a, x| a + x) != 10 { return 6 }
    if ints(0).fold(7, |a, x| a + x) != 7 { return 7 }

    if ints(3).any(|x| x == 2) != true { return 8 }
    if ints(3).any(|x| x == 9) != false { return 9 }
    if ints(0).any(|x| x == 1) != false { return 10 }

    if ints(3).all(|x| x > 0) != true { return 11 }
    if ints(3).all(|x| x > 1) != false { return 12 }
    if ints(0).all(|x| x > 99) != true { return 13 }

    if ints(4).count(|x| x > 2) != 2 { return 14 }
    if ints(4).count(|x| x > 9) != 0 { return 15 }

    when (ints(4).position(|x| x > 2)) {
      Some(p) => { if p != 2 { return 16 } }
      None => { return 17 }
    }
    when (ints(3).position(|x| x > 9)) {
      Some(_p) => { return 18 }
      None => { }
    }

    // Chaining.
    if ints(5).filter(|x| x % 2 == 1).map(|x| x * 10).fold(0, |a, x| a + x) != 90 { return 19 }

    // An owning element type, with the source read again afterwards.
    var ws = words()
    if ws.count(|s| s.byte_len() == 2) != 2 { return 20 }
    if ws.any(|s| s.byte_len() == 3) != true { return 21 }
    if ws.all(|s| s.byte_len() > 1) != true { return 22 }
    if ws.map(|s| s.byte_len()).get(1) != 3 { return 23 }
    if ws.filter(|s| s.byte_len() == 2).size() != 2 { return 24 }
    if ws.size() != 3 { return 25 }
    if ws.at(0).byte_len() != 2 { return 26 }
    return 0
}
