//! build: fail
//! deps: core, alloc
// A view of a binding the function owns would outlive it.

view struct Window {
    val text: str
}

struct Text {
    var bytes: String
}

impl Text {
    fun window(): Window { return Window { text: self.bytes.as_str() } }
}

fun made(): Window {
    val text = Text { bytes: String.from("hi") }
    return text.window()
}

fun main(): int32 { return made().text.byte_len() as int32 }
