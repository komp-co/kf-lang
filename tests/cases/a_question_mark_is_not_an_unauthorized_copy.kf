//! run: exit 0
//! deps: core, alloc
// `?` on a `Result` goes through `Result<Never, E>`, and the copy the move
// checker inserts is the compiler's, not reported against the author.
// `Never` derives `Clone` vacuously for this.

import alloc.string.*

fun inner(ok: bool): Result<String, String> {
    if ok { return Result.Ok(String.from("payload")) }
    return Result.Err(String.from("boom"))
}

fun outer(ok: bool): Result<String, String> {
    val v = inner(ok)?
    return Result.Ok(v)
}

fun main(): int32 {
    when (outer(true)) {
        Ok(s) => { if !s.as_str().equals("payload") { return 1 } }
        Err(_e) => return 2
    }
    // The bail-out arm takes the same path.
    when (outer(false)) {
        Ok(_s) => return 3
        Err(e) => { if !e.as_str().equals("boom") { return 4 } }
    }
    return 0
}
