//! run: exit 0
//! deps: core
// A program's own type shadows a core type of the same name, whatever kind
// each is. `Duration` is a struct in core and an enum here; `Stdout` a struct
// in both; `Range` generic in core and plain here, so arity comes from here.

pub enum Duration {
    Tick
    Tock
}

pub struct Stdout {
    pub val depth: int32
}

pub struct Range {
    pub val lo: int32
    pub val hi: int32
}

fun ticks(d: Duration): int32 {
    return when (d) {
        Tick => 1
        Tock => 2
    }
}

fun main(): int32 {
    if ticks(Duration.Tick) != 1 { return 1 }
    if ticks(Duration.Tock) != 2 { return 2 }
    val out = Stdout { depth: 3 }
    if out.depth != 3 { return 3 }
    val r = Range { lo: 1, hi: 5 }
    if r.hi - r.lo != 4 { return 4 }
    return 0
}
