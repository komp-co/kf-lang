//! run: exit 0
//! deps: core, alloc
// Core's Equal, Compare, Display and Clone are implementable and usable
// through bounds and through their operators.
import core.display.*
import core.assert.*

extern "C" fun runtime_println(s: str): void

pub struct Pt { var x: int32 }

impl Equal for Pt {
    fun equals(other: &Pt): bool { return self.x == other.x }
}
impl Compare for Pt {
    fun compare(other: &Pt): int32 { return self.x - other.x }
}
impl Display for Pt {
    fun display(out: &var dyn Write): void { out.write_str("Pt") }
}

fun same<T: Equal>(a: T, b: T): bool { return a.equals(b) }
fun cmp<T: Compare>(a: T, b: T): int32 { return a.compare(b) }
// Through the bound: a bound type parameter does not coerce to its own trait
// object.
fun show<T: Display>(v: T): String {
    var out = String.from("")
    v.display(&var out)
    return out
}

fun main(): void {
    val p = Pt { x: 5 }
    val q = Pt { x: 5 }
    val r = Pt { x: 9 }
    if same(p, q) { runtime_println("equal OK") } else { runtime_println("FAIL equal") }
    if !same(p, r) { runtime_println("unequal OK") } else { runtime_println("FAIL unequal") }
    // `==` and `!=` dispatch to the Equal impl.
    if p == q { runtime_println("op== OK") } else { runtime_println("FAIL op==") }
    if p != r { runtime_println("op!= OK") } else { runtime_println("FAIL op!=") }
    if cmp(p, r) < 0 { runtime_println("compare OK") } else { runtime_println("FAIL compare") }
    runtime_println(show(p).as_str())
    // The generic assert_eq dispatches `==` through Equal.
    assert_eq(p, q, "assert_eq struct")
    assert_eq(5, 5, "assert_eq int")
    // `<` and `>` dispatch to Compare.
    if p < r { runtime_println("op< OK") } else { runtime_println("FAIL op<") }
    if r > p { runtime_println("op> OK") } else { runtime_println("FAIL op>") }
    if p <= q { runtime_println("op<= OK") } else { runtime_println("FAIL op<=") }
    if r >= p { runtime_println("op>= OK") } else { runtime_println("FAIL op>=") }
    // Generic print over any T: Display.
    print(p)
    runtime_println("ALL OK")
}
