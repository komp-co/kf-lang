//! run: exit 0
//! deps: core, alloc
// `"""..."""` is raw and multiline: newlines are content and no escape is
// interpreted. The exception is `${`, which opens a slot as in the single-line
// form, so `\$` is a literal dollar.

extern "C" fun kf_str_byte_len(s: str): uint64
extern "C" fun kf_str_byte_at(s: str, i: uint64): uint8

fun main(): int32 {
    val two_lines = """ab
cd"""
    // a b \n c d
    if unsafe { kf_str_byte_len(two_lines.as_str()) } != 5 { return 1 }
    if unsafe { kf_str_byte_at(two_lines.as_str(), 2) } != 10 { return 2 }

    // A run of four quotes ends with the delimiter, so this holds `say "hi"`.
    val quoted = """say "hi""""
    if unsafe { kf_str_byte_len(quoted.as_str()) } != 8 { return 3 }
    if unsafe { kf_str_byte_at(quoted.as_str(), 7) } != 34 { return 9 }

    // Raw: this is a backslash followed by `n`, not a newline.
    val raw = """x\ny"""
    if unsafe { kf_str_byte_len(raw.as_str()) } != 4 { return 4 }
    if unsafe { kf_str_byte_at(raw.as_str(), 1) } != 92 { return 5 }

    val empty = """"""
    if unsafe { kf_str_byte_len(empty.as_str()) } != 0 { return 6 }

    // A slot expands, and the rest of the content stays raw around it.
    val who = "world"
    val greet = """hi ${who}
x\ny"""
    // h i space w o r l d <newline> x backslash n y
    if unsafe { kf_str_byte_len(greet.as_str()) } != 13 { return 10 }
    if unsafe { kf_str_byte_at(greet.as_str(), 8) } != 10 { return 11 }
    if unsafe { kf_str_byte_at(greet.as_str(), 10) } != 92 { return 12 }

    // `\$` is a literal dollar, whether or not another slot opens.
    val esc = """\${who} and ${who}"""
    if unsafe { kf_str_byte_len(esc.as_str()) } != 16 { return 13 }
    if unsafe { kf_str_byte_at(esc.as_str(), 0) } != 36 { return 14 }

    val esc_only = """\${who}"""
    if unsafe { kf_str_byte_len(esc_only.as_str()) } != 6 { return 15 }

    // The single-line form is untouched, escapes and all.
    val single = "x\ny"
    if unsafe { kf_str_byte_len(single.as_str()) } != 3 { return 7 }
    if unsafe { kf_str_byte_at(single.as_str(), 1) } != 10 { return 8 }

    return 0
}
