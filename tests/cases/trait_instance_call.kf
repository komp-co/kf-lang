//! run: exit 41
// A trait-impl method called directly, `w.make()`, with no bound or
// qualification, is crate-qualified like its definition. `trait_qualified`
// and `core_traits` cover the other paths. The exit code comes through the
// method.
trait Producer { fun make(): int32 }

struct Item { pub val value: int32 }

impl Producer for Item {
    fun make(): int32 { return self.value }
}

fun main(): int32 {
    val item = Item { value: 41 }
    return item.make()
}
