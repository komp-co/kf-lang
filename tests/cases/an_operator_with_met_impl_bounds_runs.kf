//! run: exit 0
//! deps: core
// With the impls' bounds met, the operators dispatch as their methods do.

struct Wrap<T> { pub val v: T }

impl Equal for Wrap<T: Equal> {
    fun equals(other: &Wrap<T>): bool { return self.v == other.v }
}

impl Add for Wrap<T: Add> {
    fun add(other: &Wrap<T>): Wrap<T> { return Wrap<T> { v: self.v + other.v } }
}

fun main(): int32 {
    val a = Wrap<int32> { v: 1 }
    val b = Wrap<int32> { v: 2 }
    val c = a + b
    if c.v != 3 { return 1 }
    if a == b { return 2 }
    val n: int32? = 4
    if n != Option.Some(4) { return 3 }
    return 0
}
