//! run: exit 0
//! deps: core, alloc
// A `when` arm whose value is an `if` or another `when` takes the optional
// return type in each branch, like a plain arm does.

enum Shape {
    Circle(int32)
    Square(int32)
}

fun label(s: Shape): String? {
    return when (s) {
        Circle(r) => if r > 0 { String.from("circle") } else { String.from("dot") }
        _ => String.from("other")
    }
}

fun side(s: Shape): int32? {
    return when (s) {
        Square(n) => when (n) {
            0 => 1
            _ => n
        }
        _ => null
    }
}

fun main(): int32 {
    val a = label(Shape.Circle(2)) ?: String.from("none")
    if a != String.from("circle") { return 1 }
    if (side(Shape.Square(4)) ?: 0) != 4 { return 2 }
    if side(Shape.Circle(1)) != null { return 3 }
    return 0
}
