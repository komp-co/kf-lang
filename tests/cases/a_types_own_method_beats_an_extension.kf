//! run: exit 0
//! deps: core, alloc
// Which method a call gets: the type's own, then a trait method, then an
// extension. Among extensions, a specific type beats one generic in its
// arguments, which beats a bare parameter.


struct Point {
    val x: int32
}

impl Point {
    fun label(): int32 { return 100 }
}

trait Named {
    fun name(): int32
}

impl Named for Point {
    fun name(): int32 { return 200 }
}

fun Point.label(): int32 { return 1 }
fun Point.name(): int32 { return 2 }

fun List<T>.kind(): int32 { return 3 }
fun List<Point>.kind(): int32 { return 4 }
fun T.kind(): int32 { return 5 }

fun main(): int32 {
    val p = Point { x: 1 }
    if p.label() != 100 { return 1 }
    if p.name() != 200 { return 2 }
    var ints = List.new<int32>()
    if ints.kind() != 3 { return 3 }
    var points = List.new<Point>()
    if points.kind() != 4 { return 4 }
    if p.kind() != 5 { return 5 }
    return 0
}
