//! run: exit 0
//! deps: core
// if_expr_arms_join_to_the_wider, through `when`.

fun pick(c: bool): uint64 {
    val big: uint64 = 5000000000
    val v = when c {
        true => 0
        _ => big
    }
    return v as uint64
}

fun main(): int32 {
    if pick(false) != 5000000000 { return 1 }
    if pick(true) != 0 { return 2 }
    return 0
}
