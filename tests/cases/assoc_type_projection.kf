//! run: exit 42
// An associated type end to end: the trait declares `type Out`, the impl
// chooses `int32`, and a signature is written as `Widget.Out`.
trait Producer {
    type Out
    fun make(): int32
}

struct Widget { pub val v: int32 }

impl Producer for Widget {
    type Out = int32
    fun make(): int32 { return self.v }
}

fun produce(w: Widget): Widget.Out {
    return w.v
}

fun main(): int32 {
    val w = Widget { v: 42 }
    return produce(w)
}
