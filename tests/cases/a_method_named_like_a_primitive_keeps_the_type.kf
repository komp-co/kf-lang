//! run: exit 0
//! deps: core, alloc
// A method named `uint64` or `bool` renames only the method: the fields,
// parameters and locals of those types keep them.

struct Counter {
    var count: uint64
    var on: bool
    var names: List<String>
}

impl Counter {
    pub fun uint64(): uint64 { return self.count }
    pub fun bool(): bool { return self.on }
}

fun main(): int32 {
    var names = List.new<String>()
    names.push(String.from("a"))
    val c = Counter { count: 7, on: true, names: names }
    val n: uint64 = c.uint64()
    if n != 7 { return 1 }
    if !c.bool() { return 2 }
    if c.names.size() != 1 { return 4 }
    return 0
}
