//! run: exit 0
//! deps: core
// `annotation check(...)` declares a struct `check`, which a signature may
// name like any other type.

annotation check(label: str = "plain") on () -> void

@check
fun first(): void {}

@check(label = "second")
fun second(): void {}

fun label_of(entry: &AnnotatedFunction<check, () -> void>): str {
    return entry.args.label
}

fun count(entries: &AnnotatedFunction<check, () -> void>[]): uint64 {
    return entries.size()
}

fun main(): int32 {
    val all = annotated<check>()
    if count(&all) != 2 { return 1 }
    if label_of(&all[0]) != "plain" || label_of(&all[1]) != "second" { return 2 }
    return 0
}
