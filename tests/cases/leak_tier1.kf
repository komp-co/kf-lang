//! run: exit 0
//! deps: core, alloc
extern "C" fun runtime_println(s: str): void

// Leak patterns, one per fn; clean under ASan.

// Returning a fresh concat: the params drop after it evaluates.
fun make_line(prefix: String, msg: String): String {
    return prefix + msg
}

// A by-value String param is dropped by the callee.
fun emit_line(line: String): void {
    runtime_println(line.as_str())
}

fun main(): int32 {
    // A concat bound to a local drops at scope exit.
    val a = String.from("hello, ")
    val b = String.from("world")
    val m = a + b
    runtime_println(m.as_str())

    // Fresh value moved into a callee that drops it.
    emit_line(String.from("callee owns this"))

    // Pass-then-reuse: an auto-clone keeps the second use valid.
    val twice = String.from("used twice")
    emit_line(twice)
    emit_line(twice)

    // The helper's params drop inside it.
    val line = make_line(String.from("a"), String.from("b"))
    runtime_println(line.as_str())

    // A discarded fresh result is bound and dropped.
    make_line(String.from("dis"), String.from("carded"))

    return 0
}
