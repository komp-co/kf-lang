//! run: exit 0
//! deps: core, alloc
// A float in generic code is the primitive, not a would-be user struct named
// `float64` with retain/drop glue. Two paths name it: a generic instantiated
// at a float, and an element read out of a `List<float64>`.

import core.display.*
import core.math.*

fun first_of<T: Copy>(xs: List<T>): T { return *xs.at(0) }

fun main(): int32 {
    // A generic instantiated at a float, with a local of type T.
    if abs<float64>(-2.5) != 2.5 { return 1 }
    if abs<float32>(-1.5 as float32) != (1.5 as float32) { return 2 }
    if min<float64>(1.5, 2.5) != 1.5 { return 3 }

    // Integer instances; `abs` is an extension, so the receiver carries the
    // width.
    val wide: int64 = 0 - 7
    if wide.abs() != 7 { return 4 }
    if (-7).abs() != 7 { return 5 }
    val unsigned: uint32 = 9
    if unsigned.abs() != 9 { return 6 }

    // A float element read out of a container.
    var xs = List.new<float64>()
    xs.push(3.25)
    if xs.get(0) != 3.25 { return 7 }
    if xs.at(0) != 3.25 { return 8 }

    // Through a generic function.
    if first_of<float64>(xs) != 3.25 { return 9 }

    // Not truncated.
    if String.of(&((0.5))).as_str() != "0.5" { return 10 }
    return 0
}
