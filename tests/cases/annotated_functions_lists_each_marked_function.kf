//! run: exit 0
//! deps: core, alloc
// The query lists every function carrying the annotation, in declaration
// order, and nothing else; each annotation is its own list.

annotation bench
annotation slow

@bench
fun first(): void {}

fun unmarked(): void {}

@bench
@slow
fun second(): void {}

annotation unused

fun main(): int32 {
    val benches = annotated_functions<bench>()
    if benches.size() != 2 { return 1 }
    if benches.at(0).name != "first" { return 2 }
    if benches.at(1).name != "second" { return 3 }
    if annotated_functions<slow>().size() != 1 { return 4 }
    if annotated_functions<unused>().size() != 0 { return 5 }
    return 0
}
