//! run: exit 0
//! deps: core
// A literal never defaults to a type its crate cannot see: `String` is
// alloc's, so with core alone a bare string literal stays `str`.

import core.text.*

fun main(): int32 {
    val s = "aé€😀z"
    if s.byte_len() != 11 { return 1 }
    // A `str` parameter, which is what the binding is.
    val d = s.decode_at(1)
    if d.width != 2 { return 2 }
    if (d.scalar as uint32) != 233 { return 3 }

    // A `var` takes the same default, and a later store keeps it.
    var t = "abc"
    t = "de"
    if t.byte_len() != 2 { return 4 }
    return 0
}
