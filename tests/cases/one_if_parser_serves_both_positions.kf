//! run: exit 40
// One `if` parser for both positions; value position wraps what the statement
// parser produced:
//
//   a branch of one expression  ->  that bare expression (the C ternary)
//   an `else` of one `if`       ->  a nested if-expression (the chain)
//   anything longer             ->  a block, whose value is its tail

fun guard(c: bool): int32 {
    // The statement-only guard shape.
    if (c) return 5
    return 1
}

fun bare_stmt(c: bool): int32 {
    var n: int32 = 0
    if c { n = n + 2 }
    if c { n = n + 1 } else { n = n + 7 }
    return n
}

fun ternary(c: bool): int32 {
    val v = if c { 3 } else { 4 }
    return v
}

fun chain(k: int32): int32 {
    val v = if k == 0 { 10 } else if k == 1 { 20 } else { 30 }
    return v
}

fun blocky(c: bool): int32 {
    val v = if c {
        val a = 6
        a + 1
    } else { 0 }
    return v
}

fun main(): int32 {
    var acc: int32 = 0
    acc = acc + guard(true) + guard(false)  // 6
    acc = acc + bare_stmt(true)             // 3  -> 9
    acc = acc + ternary(false)              // 4  -> 13
    acc = acc + chain(1)                    // 20 -> 33
    acc = acc + blocky(true)                // 7  -> 40
    return acc
}
