//! run: exit 0
//! deps: core, alloc
// `swap` exchanges two slots in place, which get/set cannot do for an element
// that owns memory: `get` exists only for a Copy element.

import alloc.list.*

fun main(): int32 {
    var xs = List.new<String>()
    xs.push(String.from("aaa"))
    xs.push(String.from("bbb"))

    xs.swap(0, 1)

    if !xs.at(0).as_str().equals("bbb") {
        return 1
    }
    if !xs.at(1).as_str().equals("aaa") {
        return 2
    }
    // Out of range on either index is a no-op.
    xs.swap(0, 99)
    if !xs.at(0).as_str().equals("bbb") {
        return 3
    }
    return 0
}
