//! run: exit 1
//! deps: core, testing
// A test that should panic fails when it returns instead.

import testing.disabled
import testing.run_tests
import testing.test

@test(panics = FaultKind.AnyFault)
fun returns(): void {}

fun main(): int32 {
    return run_tests(&annotated<test>(), &annotated<disabled>())
}
