//! build: fail
//! deps: core, alloc
// A `str` value in a `String` slot copies onto the heap, so it is written,
// not silent. Every slot applying an expected type is covered.

fun takes_string(s: String): uint64 { return s.byte_len() }
fun takes_borrowed(s: &String): uint64 { return s.byte_len() }

fun main(): int32 {
    val view: str = "komp"

    // An argument slot.
    val a = takes_string(view)

    // A shared-borrow slot, which reaches the same conversion.
    val b = takes_borrowed(view)

    // A typed let.
    val c: String = view

    return (a + b + c.byte_len()) as int32
}
