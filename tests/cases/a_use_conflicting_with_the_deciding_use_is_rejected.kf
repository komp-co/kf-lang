//! build: fail
//! deps: core, alloc
// `wide(n)` decides `n` as a `uint64`, so `narrow(n)` cannot also have it as
// an `int8`; the error names the use that decided.

fun wide(x: uint64): uint64 { return x }
fun narrow(x: int8): int8 { return x }

fun main(): int32 {
    val n = 5
    val _a = wide(n)
    val _b = narrow(n)
    return 0
}
