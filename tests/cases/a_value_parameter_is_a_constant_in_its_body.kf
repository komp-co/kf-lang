//! run: exit 5
//! deps: core
// `M` is a value: the body reads it as a constant of its type.

struct Residue<M: uint64> {
    val value: uint64
}

fun wrap<M: uint64>(v: uint64): Residue<M> {
    return Residue<M> { value: v % M }
}

fun main(): int32 {
    val x: Residue<7> = wrap<7>(12)
    return x.value as int32
}
