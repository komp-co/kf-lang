//! build: fail
//! deps: core, alloc
// A bound on an impl block's target is the receiver's to satisfy, for the
// inherent impl and for the trait impl. Two violations, so a fix reaching one
// dispatch path still fails.

trait Copyable { }
impl Copyable for int32 { }

trait Tag { fun tag(): uint64 }

struct Holder<T> { pub var v: T }

impl Holder<T: Copyable> {
    fun take(): T { return self.v }
}

impl Tag for Holder<T: Copyable> {
    fun tag(): uint64 { return 1 }
}

fun main(): int32 {
    val ok = Holder<int32> { v: 7 }
    if ok.take() != 7 { return 1 }
    if ok.tag() != 1 { return 2 }

    val bad = Holder<String> { v: String.from("x") }
    if bad.take().as_str().equals("x") { return 3 }
    if bad.tag() != 1 { return 4 }
    return 0
}
