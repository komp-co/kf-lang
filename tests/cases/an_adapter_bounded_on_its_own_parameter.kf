//! run: exit 0
//! deps: core
// An impl whose self type is bounded on another of its own parameters,
// `Rev<I: DoubleEnded<T>, T>`, is materialized: the bound check substitutes
// the trait's arguments. Every iterator adapter has this shape.

import core.option.*

pub trait DoubleEnded<T>: Iterator<T> {
    mutating fun next_back(): T?
}

pub struct Counter { pub var lo: uint64, pub var hi: uint64 }

impl Iterator<uint64> for Counter {
    mutating fun next(): uint64? {
        if self.lo >= self.hi { return null }
        val v = self.lo
        self.lo = self.lo + 1
        return v
    }
}

impl DoubleEnded<uint64> for Counter {
    mutating fun next_back(): uint64? {
        if self.lo >= self.hi { return null }
        self.hi = self.hi - 1
        return self.hi
    }
}

pub struct Rev<I, T> { pub var inner: I }

impl Iterator<T> for Rev<I: DoubleEnded<T>, T> {
    mutating fun next(): T? { return self.inner.next_back() }
}

impl Iterable<T> for Rev<I: DoubleEnded<T>, T> {
    type Iter = Rev<I, T>
    fun iter(): Rev<I, T> { return Rev<I, T> { inner: self.inner } }
}

fun main(): int32 {
    var r = Rev<Counter, uint64> { inner: Counter { lo: 0, hi: 4 } }
    // Reversed: 3, 2, 1, 0.
    var first: uint64 = 99
    var n: uint64 = 0
    var total: uint64 = 0
    while v in r {
        if n == 0 { first = v }
        total = total + v
        n = n + 1
        if n > 50 { return 1 }
    }
    if n != 4 { return 2 }
    if first != 3 { return 3 }
    if total != 6 { return 4 }
    return 0
}
