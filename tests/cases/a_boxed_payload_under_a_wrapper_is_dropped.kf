//! run: exit 0
//! deps: core
// A Box reached through a wrapper payload (`Opt(Box<Node>?)`) is dropped
// through the wrapper's glue.

struct Node { pub val v: int32 }

enum Holder {
    Plain(Box<Node>)
    Opt(Box<Node>?)
}

fun make_plain(v: int32): Holder { return Holder.Plain(Box.new(Node { v: v })) }
fun make_opt(v: int32): Holder   { return Holder.Opt(Box.new(Node { v: v })) }

fun read_plain(h: Holder): int32 {
    when (h) {
        Plain(b) => { return (*b).v }
        Opt(_o) => { return 0 }
    }
    return 0
}

fun read_opt(h: Holder): int32 {
    var out: int32 = 0
    when (h) {
        Plain(_b) => { out = 0 }
        Opt(o) => {
            when (o) {
                Some(b) => { out = (*b).v }
                None => { out = 0 }
            }
        }
    }
    return out
}

fun main(): int32 {
    var i: int32 = 0
    while i < 10 {
        if read_plain(make_plain(1)) != 1 { return 1 }
        if read_opt(make_opt(3)) != 3 { return 3 }
        i = i + 1
    }
    return 0
}
