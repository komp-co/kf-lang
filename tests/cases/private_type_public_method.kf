//! run: exit 6
//! deps: core
// A public method on a crate-private type is usable in its crate, and the
// public C header does not mention the private receiver.

struct Widget {
    pub val value: int32
}

impl Widget {
    pub fun get(): int32 {
        return self.value
    }
}

fun main(): int32 {
    val widget = Widget { value: 6 }
    return widget.get()
}
