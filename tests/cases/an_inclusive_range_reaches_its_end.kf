//! run: exit 0
//! deps: core
// `0..=n` includes `n`: a `..=` token, a desugar to `range_inclusive`, and a
// cursor stopping after the endpoint.
//
// `250..=255` over `uint8` has no value after its last, so `RangeIter`
// latches `done`. The `break` guards turn a hang into a wrong exit code.

fun sum_exclusive(): int32 {
    var total: int32 = 0
    while i in 1..5 { total = total + i }
    return total
}

fun sum_inclusive(): int32 {
    var total: int32 = 0
    while i in 1..=5 { total = total + i }
    return total
}

fun single_value_range(): int32 {
    var n: int32 = 0
    while _i in 3..=3 { n = n + 1 }
    return n
}

fun empty_range(): int32 {
    var n: int32 = 0
    while _i in 3..3 { n = n + 1 }
    return n
}

fun count_to_the_type_maximum(): int32 {
    val lo: uint8 = 250
    val hi: uint8 = 255
    var n: int32 = 0
    while _b in lo..=hi {
        n = n + 1
        if n > 100 { break }
    }
    return n
}

// A step that walks OVER the end still stops: 0, 3, 6, 9, then 12 > 10.
fun stepped_inclusive(): int32 {
    var total: int32 = 0
    while v in range_inclusive(0, 10, 3) { total = total + v }
    return total
}

fun main(): int32 {
    if sum_exclusive() != 10 { return 1 }
    if sum_inclusive() != 15 { return 2 }
    if single_value_range() != 1 { return 3 }
    if empty_range() != 0 { return 4 }
    if count_to_the_type_maximum() != 6 { return 5 }
    if stepped_inclusive() != 18 { return 6 }
    return 0
}
