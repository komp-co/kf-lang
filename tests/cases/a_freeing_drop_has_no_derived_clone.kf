//! build: fail
//! deps: core
// A derived clone copies a `Ptr<T>`, not its buffer; with a `drop` freeing the
// field that is a double free. Only the author knows how much to copy, so
// `impl Clone` is required. mm1.kf writes that impl; a drop writing through a
// borrowed pointer is in when_payload_ownership.kf.

extern "C" fun free(p: Ptr<uint8>): void

pub struct Owned {
    var data: Ptr<uint8>
}

impl Drop for Owned {
    fun drop(): void { unsafe { free(self.data) } }
}

fun main(): int32 {
    val p: Ptr<uint8> = unsafe { alloc_array<uint8>(1) }
    unsafe { *(p + 0) = 7 }
    val o = Owned { data: p, }
    return unsafe { *(o.data + 0) } as int32 - 7
}
