//! build: fail
// An associated type bound to a type not satisfying its declared bound. The
// unit tests cover the diagnostic; this covers the real pipeline, which
// deep-clones every module before typecheck.
trait Marker { fun mark(): int32 }

trait Producer { type Item: Marker }

struct Plain { pub val v: int32 }

struct Widget { pub val v: int32 }

impl Producer for Widget {
    type Item = Plain
}

fun main(): int32 {
    return 0
}
