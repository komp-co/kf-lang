//! run: exit 3
//! deps: core
// `&*p` and `&var *p` inside `unsafe` turn a raw pointer into a reference:
// accepted as an argument, returned, and bound.

struct Cell {
    pub var v: int32
}

fun read(c: &Cell): int32 {
    return c.v
}

fun bump(c: &var Cell): void {
    c.v = c.v + 1
}

fun nth(p: Ptr<Cell>, i: uint64): &var Cell {
    return unsafe { &var *(p + i) }
}

fun main(): int32 {
    val p: Ptr<Cell> = unsafe { alloc<Cell>() }
    unsafe { *p = Cell { v: 1 } }
    bump(unsafe { &var *p })
    val r = unsafe { &*p }
    bump(nth(p, 0))
    return read(r)
}
