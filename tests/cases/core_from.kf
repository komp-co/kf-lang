//! run: exit 0
//! deps: core
// `impl From<int32> for Cel` gives `Cel.from(n)`; a generic bounded on
// `From<int32>` calls `T.from(n)`. The bound carries the source type, so
// `From<int32>` is distinct from `From<str>`.
extern "C" fun runtime_println(s: str): void

pub struct Cel { var v: int32 }

impl From<int32> for Cel {
    static fun from(value: int32): Cel { return Cel { v: value } }
}

fun make<T: From<int32>>(n: int32): T {
    return T.from(n)
}

fun main(): void {
    val a = Cel.from(42)          // direct static conversion
    if a.v == 42 { runtime_println("direct OK") } else { runtime_println("FAIL direct") }
    val c = make<Cel>(7)          // generic dispatch + bound check
    if c.v == 7 { runtime_println("generic OK") } else { runtime_println("FAIL generic") }
    runtime_println("ALL OK")
}
