//! run: exit 0
//! deps: core, alloc

// A bare value assigned to an optional field, `s.f = v`, is wrapped, as in a
// struct literal or a local assignment.

import core.option.*

struct S {
    var d: int32?
    var name: String?
}

fun main(): int32 {
    // The struct literal.
    var s = S { d: null, name: null }
    if s.d.is_some() { return 1 }

    // The field assignment.
    val v: int32 = 7
    s.d = v
    val got = s.d ?: return 2
    if got != 7 { return 3 }

    // `null` through the same path.
    s.d = null
    if s.d.is_some() { return 4 }

    // A move-only payload, so the wrap is not just an integer coincidence.
    s.name = String.from("ada")
    val n = s.name ?: return 5
    if !n.as_str().equals("ada") { return 6 }

    // A local assignment.
    var o: int32? = null
    o = 9
    val ov = o ?: return 7
    if ov != 9 { return 8 }

    return 0
}
