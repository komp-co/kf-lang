//! run: exit 52
//! deps: core
// `slice(range)` views part of the same elements; a mutable slice narrows
// with `slice_mut`, and `swap` and `set` write through.

fun main(): int32 {
    var xs: int32[5] = [1, 2, 3, 4, 5]
    var all = xs.as_slice_mut()
    var tail = all.slice_mut(2..5)
    tail.swap(0, 2)
    tail.set(1, 40)
    val middle = xs.as_slice().slice(1..=3)
    return middle[0] + middle[1] + middle[2] + middle.size() as int32 + xs[4] - 1
}
