//! build: fail
//! deps: core
// `drop` is the destructor hook, keyed on the method name, since mono erases
// the trait ref. A `drop` without the destructor's shape is rejected, as a
// mismatched `clone` is.

struct Point { pub var x: int32 }

impl Point {
    // Not `fun drop(): void`.
    pub fun drop(): int32 { return 1 }
}

fun main(): int32 {
    val p = Point { x: 1 }
    return p.drop() - 1
}
