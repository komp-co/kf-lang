//! run: exit 0
//! deps: core, alloc
// core's slice algorithms, called straight on arrays and lists.

struct Job {
    val priority: int32
    val id: int32
}

fun main(): int32 {
    var xs: int32[6] = [7, 3, 9, 3, 1, 8]
    xs.sort()
    if xs.binary_search(&8).unwrap() != 4 { return 1 }
    var jobs = List.new<Job>()
    while i in 0..20 { jobs.push(Job { priority: (i * 3) % 4, id: i }) }
    jobs.sort_by_key(|j: &Job| j.priority)
    while i in 1..20 {
        val a = jobs.at(i - 1)
        val b = jobs.at(i)
        if a.priority == b.priority && a.id > b.id { return 2 }
    }
    var runs = 0
    while run in jobs.chunks(6) { runs = runs + 1 }
    if runs != 4 { return 3 }
    xs.rotate_left(1)
    if xs[5] != 1 { return 4 }
    return 0
}
