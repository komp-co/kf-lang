//! run: exit 42
//! deps: core

trait Score { fun score(): int32 }
struct Value { pub val amount: int32 }
impl Score for Value { fun score(): int32 { return self.amount } }

fun main(): int32 {
    val value = Value { amount: 42 }
    val absent: Option<&dyn Score> = null
    if absent.is_some() { return 1 }
    val present: Option<&dyn Score> = value
    val object = present ?: return 2
    return object.score()
}
