//! run: exit 0
//! deps: core
// Locals are emitted with a `__` prefix, and `__signed` is a GCC keyword, so
// a colliding name is escaped. Covered: a binding, a function parameter, and
// a `when` binder. Fields are emitted bare and collide differently.

enum Sign { Plus(int32)  Minus(int32) }

fun widen(volatile: int32, restrict: int32): int32 {
    return volatile + restrict
}

fun magnitude(s: Sign): int32 {
    return when (s) {
        Plus(const) => const
        Minus(typeof) => 0 - typeof
    }
}

fun main(): int32 {
    // A binding, assigned and read back.
    var signed = 1
    signed = signed + 1
    if signed != 2 { return 1 }

    // `__signed__` is `signed` too: a trailing `__` is stripped before the
    // lookup.
    val signed__ = 3
    if signed__ != 3 { return 2 }

    // Parameters.
    if widen(4, 5) != 9 { return 3 }

    // `when` binders.
    if magnitude(Sign.Plus(8)) != 8 { return 4 }
    if magnitude(Sign.Minus(9)) != -9 { return 5 }
    return 0
}
