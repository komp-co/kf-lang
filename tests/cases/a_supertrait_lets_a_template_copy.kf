//! run: exit 9
//! deps: core
// `trait Whole: Copy` makes `T: Whole` copyable, so a template may read a `T`
// out through a borrow without a written `Copy` bound.

trait Whole: Copy {
}

impl Whole for int32 { }

struct Cell<T: Whole> {
    val value: T
}

fun read<T: Whole>(cell: &Cell<T>): T {
    return cell.value
}

fun main(): int32 {
    val cell = Cell<int32> { value: 9 }
    return read(&cell)
}
