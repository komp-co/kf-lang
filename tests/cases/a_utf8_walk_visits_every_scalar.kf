//! run: exit 0
//! deps: core, alloc
// `core.utf8` decodes text; a walk advancing by the reported width traverses
// a mixed-width string.

import core.text.*

fun main(): int32 {
    // 1 + 2 + 3 + 4 + 1 bytes, five scalars.
    val s = "aé€😀z"
    if s.byte_len() != 11 { return 1 }

    var i: uint64 = 0
    var n: int32 = 0
    var guard: int32 = 0
    while i < s.byte_len() {
        val d = s.as_str().decode_at(i)
        if d.width == 0 { return 2 }
        if !d.well_formed { return 3 }
        i = i + d.width
        n = n + 1
        guard = guard + 1
        if guard > 50 { return 4 }
    }
    if n != 5 { return 5 }
    if i != 11 { return 6 }

    // Each width, at its own offset.
    if s.as_str().decode_at(0).width != 1 { return 7 }
    if s.as_str().decode_at(1).width != 2 { return 8 }
    if s.as_str().decode_at(3).width != 3 { return 9 }
    if s.as_str().decode_at(6).width != 4 { return 10 }

    // And the scalars themselves.
    if (s.as_str().decode_at(1).scalar as uint32) != 233 { return 11 }
    if (s.as_str().decode_at(6).scalar as uint32) != 128512 { return 12 }

    // Past the end is the one zero width, so the loop above cannot spin.
    if s.as_str().decode_at(11).width != 0 { return 13 }

    // Malformed input built from bytes: C's `\x` is greedy.
    var bad = String.from("")
    bad.push_byte(226)
    bad.push_byte(130)
    bad.push_byte(65)
    val d0 = bad.as_str().decode_at(0)
    if d0.well_formed { return 14 }
    if d0.width != 2 { return 15 }
    // The walk resumes on the byte that broke the sequence, not past it.
    if (bad.as_str().decode_at(2).scalar as uint32) != 65 { return 16 }
    return 0
}
