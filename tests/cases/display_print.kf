//! run: exit 0
//! deps: core, alloc

import core.display.*

pub struct Label {}

impl Display for Label {
    fun display(out: &var dyn Write): void { out.write_str("label") }
}

fun main(): void {
    val value = Label {}
    print(value)
    println(value)
    println(String.from("string"))
    println(42)
}
