//! build: fail
//! deps: core
// A `mutating` extension borrows its receiver with `&var`, so the receiver
// has to be writable, as for a `mutating` method.

struct Counter {
    var n: int32
}

mutating fun Counter.bump(): void {
    self.n = self.n + 1
}

fun main(): int32 {
    val c = Counter { n: 0 }
    c.bump()
    return c.n
}
