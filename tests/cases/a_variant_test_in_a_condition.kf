//! run: exit 7
//! deps: core, alloc

// `is` in `if` and `while` conditions, under `!`, and over a field: the brace
// after the variant opens the body, not a struct pattern.

enum Shape {
    Circle(int32)
    Empty
}

struct Holder {
    val shape: Shape
}

fun Holder.round(): bool {
    return self.shape is Circle
}

fun main(): int32 {
    val h = Holder { shape: Shape.Circle(1) }
    var n = 0
    if h.shape is Circle {
        n = n + 1
    }
    if !(h.shape is Empty) { n = n + 2 }
    while h.shape is Empty { n = 100 }
    if h.round() { n = n + 4 }
    return n
}
