//! build: fail
//! deps: core
// A wrong-typed constructor payload is reported by komp, not as C errors on
// generated names.

struct Payload { pub val v: int32 }

enum Holder {
    Wrap(Payload)
    Nop
}

fun main(): int32 {
    val h = Holder.Wrap(7)
    when (h) {
        Wrap(p) => { return p.v }
        Nop => { return 0 }
    }
    return 0
}
