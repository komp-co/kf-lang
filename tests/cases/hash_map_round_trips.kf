//! run: exit 0
//! deps: core, alloc
// `alloc.HashMap` from a consumer crate, through separate compilation and the
// crate interface. Most failures lose an entry rather than crash.

import core.hash.*

fun main(): int32 {
    var m = HashMap.new<int32, int32>()

    // Absent before, present after.
    if m.contains(&1) { return 1 }
    m.insert(1, 100)
    if !m.contains(&1) { return 2 }
    when (m.get(&1)) {
        Some(v) => { if v != 100 { return 3 } }
        None => return 4
    }

    // Re-inserting replaces and does not grow.
    m.insert(1, 111)
    if m.size() != 1 { return 5 }
    when (m.get(&1)) {
        Some(v) => { if v != 111 { return 6 } }
        None => return 7
    }

    // Several rehashes; every key survives.
    var i: int32 = 0
    while i < 100 {
        m.insert(i, i * 3)
        i = i + 1
    }
    if m.size() != 100 { return 8 }
    i = 0
    while i < 100 {
        when (m.get(&i)) {
            Some(v) => { if v != i * 3 { return 9 } }
            None => return 10
        }
        i = i + 1
    }

    // Removal repoints the moved entry's chain link.
    i = 0
    while i < 100 {
        if !m.remove(&i) { return 11 }
        i = i + 2
    }
    if m.size() != 50 { return 12 }
    i = 0
    while i < 100 {
        val gone = i % 2 == 0
        if gone && m.contains(&i) { return 13 }
        if !gone && !m.contains(&i) { return 14 }
        i = i + 1
    }
    if m.remove(&0) { return 15 }

    // Owning keys and values.
    var s = HashMap.new<String, String>()
    val key = String.from("alpha")
    s.insert(key.clone(), String.from("one"))
    s.insert(key.clone(), String.from("uno"))
    if s.size() != 1 { return 16 }
    when (s.get(&key)) {
        // `v` is the `&String` the map lends.
        Some(v) => { if !v.as_str().equals("uno") { return 17 } }
        None => return 18
    }
    if !s.remove(&key) { return 19 }
    if !s.is_empty() { return 20 }
    return 0
}
