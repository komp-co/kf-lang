//! run: exit 0
//! deps: core, alloc
// A loop over a value nothing else owns drops it once the loop ends. Each
// scenario counts drops and demands exactly one per element.
import core.assert.*
import alloc.list.*

pub struct Tracked {
    var counter: Ptr<int32>
}

impl Drop for Tracked {
    fun drop(): void {
        unsafe { *self.counter = *self.counter + 1 }
    }
}

fun new_counter(): Ptr<int32> {
    val p: Ptr<int32> = unsafe { alloc_array<int32>(1) }
    unsafe { *p = 0 }
    return p
}

fun count(p: Ptr<int32>): int32 {
    return unsafe { *p }
}

fun two(c: Ptr<int32>): List<Tracked> {
    var xs = List.new<Tracked>()
    xs.push(Tracked { counter: c })
    xs.push(Tracked { counter: c })
    return xs
}

pub struct Holder {
    val c: Ptr<int32>
}

impl Holder {
    fun made(): List<Tracked> {
        return two(self.c)
    }
}

// (A) Borrowing a call's result.
fun borrowed_call(c: Ptr<int32>): int32 {
    var seen = 0
    while t in &two(c) {
        if count(t.counter) == 0 { seen = seen + 1 }
    }
    return seen
}

// (B) Borrowing a method call's result.
fun borrowed_method(c: Ptr<int32>): void {
    val h = Holder { c: c }
    while _t in &h.made() { }
}

// (C) A loop left early still drops it.
fun borrowed_then_break(c: Ptr<int32>): void {
    while _t in &two(c) { break }
}

// (D) Borrowing a local leaves it to its owner.
fun borrowed_local(c: Ptr<int32>): int32 {
    val xs = two(c)
    while _t in &xs { }
    return count(c)
}

fun main(): int32 {
    val a = new_counter()
    assert_eq(borrowed_call(a), 2, "the elements are alive inside the loop")
    assert_eq(count(a), 2, "a borrowed call's result is dropped after the loop")
    val b = new_counter()
    borrowed_method(b)
    assert_eq(count(b), 2, "a borrowed method call's result is dropped after the loop")
    val d = new_counter()
    borrowed_then_break(d)
    assert_eq(count(d), 2, "breaking out still drops it")
    val e = new_counter()
    assert_eq(borrowed_local(e), 0, "a borrowed local is not dropped by the loop")
    assert_eq(count(e), 2, "its owner drops it")
    return 0
}
