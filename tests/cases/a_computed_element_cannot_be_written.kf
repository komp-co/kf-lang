//! build: fail
//! deps: core, alloc
// An element computed by `IndexValue` has no place, so nothing can be written
// through its subscript.

struct Bits {
    var word: uint64
}

impl IndexValue<uint64> for Bits {
    type Out = bool
    fun index_value(k: uint64): bool { return ((self.word >> k) & 1) == 1 }
}

fun main(): int32 {
    var bits = Bits { word: 0 }
    bits[3] = true
    return 0
}
