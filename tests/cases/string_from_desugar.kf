//! run: exit 0
//! deps: core, alloc

extern "C" fun runtime_println(s: str): void

struct Label { val text: String }

fun echo(value: String): String { return value }

fun returned(): String { return "return" }

fun main(): void {
    val inferred = "inferred"
    val annotated: String = "annotated"
    val argument = echo("argument")
    val label = Label { text: "field" }
    runtime_println(inferred.as_str())
    runtime_println(annotated.as_str())
    runtime_println(argument.as_str())
    runtime_println(label.text.as_str())
    runtime_println(returned().as_str())
}
