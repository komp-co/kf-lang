//! build: fail
//! deps: core, alloc
// A template only adds: the struct's own `impl Equal` is not replaced.

annotation equal_fields on struct

template equal_fields on struct T {
    impl Equal for T {
        fun equals(other: &T): bool { return true }
    }
}

@equal_fields
struct Twice {
    val n: int32
}

impl Equal for Twice {
    fun equals(other: &Twice): bool { return self.n == other.n }
}

fun main(): int32 { return 0 }
