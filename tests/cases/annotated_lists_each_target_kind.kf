//! run: exit 0
//! deps: core, alloc
// A function target lists each function as a value of the target type; a
// kind target lists each declaration by name, with its module and kind.

trait Plugin {
    fun start(): int32
}

struct Request {
    val body: String
}

annotation route(path: String) on (Request) -> int32
annotation plugin(order: int32) on struct: Plugin
annotation mode on enum
annotation shown on struct, enum

@route("/len")
fun length(r: Request): int32 { return r.body.byte_len() as int32 }

@plugin(3)
@shown
struct Logger {
    val level: int32
}

impl Plugin for Logger {
    fun start(): int32 { return self.level }
}

@mode
@shown
enum Speed {
    Fast
    Slow
}

fun main(): int32 {
    val routes = annotated<route>()
    if routes.at(0).args.path != "/len" { return 1 }
    if routes.at(0).function(Request { body: "abcd" }) != 4 { return 2 }
    val plugins = annotated<plugin>()
    if plugins.at(0).name != "Logger" || plugins.at(0).args.order != 3 { return 3 }
    if annotated<mode>().at(0).name != "Speed" { return 4 }
    val shown = annotated<shown>()
    if shown.size() != 2 { return 5 }
    if shown.at(0).module != "annotated_lists_each_target_kind" { return 6 }
    if shown.at(0).kind != AnnotatedKind.Struct || shown.at(1).kind != AnnotatedKind.Enum { return 7 }
    return 0
}
