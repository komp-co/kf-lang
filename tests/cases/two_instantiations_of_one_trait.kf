//! run: exit 7
// One type implementing one trait at two type arguments, binding `Out`
// differently: `Self.Out` in each impl is not ambiguous. `Index<uint64>` and
// `Index<Range<uint64>>` need this. The choices differ, so a wrong pick is a
// type error.
trait Pick<K> {
    type Out
    fun pick(k: K): Self.Out
}

struct Bag {
    pub val n: int32
    pub val flag: bool
}

impl Pick<int32> for Bag {
    type Out = int32
    fun pick(k: int32): Self.Out { return self.n + k }
}

impl Pick<bool> for Bag {
    type Out = bool
    fun pick(k: bool): Self.Out { return self.flag && k }
}

fun main(): int32 {
    val b = Bag { n: 4, flag: true }
    val n: int32 = b.pick(3)
    val f: bool = b.pick(true)
    if f { return n }
    return 0
}
