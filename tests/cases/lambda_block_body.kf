//! run: exit 0
//! deps: core, alloc
// A lambda body may be a braced block, whose value is its last statement. A
// block local is not a capture, even when the enclosing scope has the name.


fun apply<F: Call1<int32>>(f: F, x: int32): int32 { return f.call(x) }

fun main(): int32 {
    // A local binding and a trailing expression.
    if apply(|x: int32| {
        val doubled = x * 2
        doubled + 1
    }, 3) != 7 { return 1 }

    // The parameter type still comes from the bound.
    if apply(|x| {
        val a = x + 1
        a * 2
    }, 4) != 10 { return 2 }

    // A bare expression is unchanged.
    if apply(|x| x * 3, 5) != 15 { return 3 }

    // A block local shadows an enclosing name, which is then not captured.
    val n: int32 = 999
    if apply(|x| {
        val n = x + 1
        n * 2
    }, 3) != 8 { return 4 }
    if n != 999 { return 5 }

    // An unshadowed enclosing name still captures.
    val base: int32 = 10
    if apply(|x| {
        val sum = x + base
        sum
    }, 5) != 15 { return 6 }

    // Control flow inside the block.
    if apply(|x| {
        var acc: int32 = 0
        var i: int32 = 0
        while i < x {
            acc = acc + i
            i = i + 1
        }
        acc
    }, 4) != 6 { return 7 }

    // An early `return` answers the value itself.
    if apply(|x| {
        if x > 2 { return 42 }
        0
    }, 5) != 42 { return 8 }
    if apply(|x| {
        if x > 2 { return 42 }
        0
    }, 1) != 0 { return 9 }

    // A block over an adapter, with a capture.
    val bump: int32 = 100
    var xs = List.new<int32>()
    xs.push(1)
    xs.push(2)
    val ys = xs.map(|v| {
        val scaled = v * 10
        scaled + bump
    })
    if ys.get(1) != 120 { return 10 }
    return 0
}
