//! build: fail
//! deps: core, alloc
// `[]` on a type implementing both `Index` and `IndexValue` would have two
// meanings, so it is rejected.

struct Twice {
    val base: int32
}

impl Index<uint64> for Twice {
    type Out = int32
    fun index(k: uint64): &int32 { return &self.base }
}

impl IndexValue<uint64> for Twice {
    type Out = int32
    fun index_value(k: uint64): int32 { return self.base * 2 }
}

fun main(): int32 {
    val t = Twice { base: 4 }
    return t[0]
}
