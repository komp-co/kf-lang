//! run: exit 0
//! deps: core, testing
// `@test(panics = ...)` passes when the test panics with that kind, or with
// any kind for `AnyFault`.

import testing.run_tests
import testing.test

@test(panics = FaultKind.IndexOutOfBounds)
fun indexes_past_the_end(): void {
    val xs = [1, 2]
    val _x = xs[5]
}

@test(panics = FaultKind.AnyFault)
fun asserts_falsely(): void { assert(false, "never true") }

fun main(): int32 {
    return run_tests(&annotated<test>(), &annotated<disabled>())
}
