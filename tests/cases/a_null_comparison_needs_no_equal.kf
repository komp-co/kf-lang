//! run: exit 0
//! deps: core, alloc
// `== null` and `!= null` test the tag, so the payload needs no `Equal`: a
// borrowed optional, a field, a call result and a generic `T?` all compare.

struct Message {
    val id: String?
}

fun parse(text: str): Message? {
    if text.is_empty() { return null }
    return Option.Some(Message { id: null })
}

fun missing(m: &Message?): bool { return m == null }

fun absent<T>(x: T?): bool { return x == null }

fun main(): int32 {
    val found = parse("x")
    if found == null { return 1 }
    if !(found != null) { return 2 }
    if parse("") != null { return 3 }
    if !missing(&parse("")) { return 4 }
    if missing(&found) { return 5 }
    val m = Message { id: null }
    if m.id != null { return 6 }
    if !absent(parse("")) { return 7 }
    val n: int32? = 4
    if n == null { return 8 }
    if n != 4 { return 9 }
    return 0
}
