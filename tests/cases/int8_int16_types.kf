//! run: exit 0
//! deps: core
// `int8` and `int16` map to their C types in a field, a parameter and a local.

struct Small {
    pub val a: int8
    pub val b: int16
}

fun widen(x: int8, y: int16): int32 {
    return (x as int32) + (y as int32)
}

fun main(): int32 {
    val s = Small { a: 3, b: 4 }
    if widen(s.a, s.b) != 7 { return 1 }

    val n: int8 = 127
    val m: int16 = 32767
    if (n as int32) != 127 { return 2 }
    if (m as int32) != 32767 { return 3 }
    return 0
}
