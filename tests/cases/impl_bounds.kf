//! run: exit 42
//! deps: core
// An inherent generic impl may require capabilities of its type parameter.

struct Wrap<T> { pub val value: T }

impl Wrap<T: Equal + Copy> {
    fun get(): T { return self.value }
}

fun main(): int32 {
    val value = Wrap<int32> { value: 42 }
    return value.get()
}
