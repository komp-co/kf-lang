//! run: exit 0
//! deps: core

// A trait method returning a container of two associated types, implemented
// for a generic enum: the shape `trait Try` needs. Not `Branch`, which core
// declares.

pub enum Choice<O, R> {
    Continue(O)
    Break(R)
}

pub trait Tryable {
    type Output
    type Residual
    fun branch(): Choice<Self.Output, Self.Residual>
}

pub enum MyRes<T, E> {
    Ok(T)
    Err(E)
}

impl Tryable for MyRes<T, E> {
    type Output = T
    type Residual = E
    fun branch(): Choice<T, E> {
        when (self) {
            Ok(v) => { return Choice.Continue<T, E>(v) }
            Err(e) => { return Choice.Break<T, E>(e) }
        }
    }
}

fun main(): int32 {
    val ok = MyRes.Ok<int32, int32>(42)
    when (ok.branch()) {
        Continue(v) => { if v == 42 { return 0 } }
        Break(_e) => { return 2 }
    }
    return 1
}
