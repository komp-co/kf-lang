//! run: exit 0
//! deps: core, alloc
import alloc.list.*

// Copying a Holder deep-copies its String field, or the two share a buffer
// and double-free.
struct Holder {
    var name: String
}

fun main(): int32 {
    // `val h2 = h` moves, then using `h` again auto-clones through
    // Holder_clone, which deep-copies the field.
    var h = Holder { name: String.from("orig") }
    val h2 = h
    h.name.append("X")
    if !h2.name.equals("orig") { return 1 }   // clone untouched by the mutation
    if !h.name.equals("origX") { return 2 }

    // Explicit `.clone()`: String_clone delegates to String_clone_user.
    var s = String.from("abc")
    val s2 = s.clone()
    s.append("d")
    if !s2.equals("abc") { return 3 }
    if !s.equals("abcd") { return 4 }

    // Explicit `.clone()` on a struct with no user clone reaches the default
    // by-pointer Holder_clone_user, which delegates to the deep Holder_clone.
    var h3 = Holder { name: String.from("deep") }
    val h4 = h3.clone()
    h3.name.append("Z")
    if !h4.name.equals("deep") { return 5 }   // clone independent of the mutation
    if !h3.name.equals("deepZ") { return 6 }

    // Each drop frees a distinct buffer.
    return 0
}
