//! run: exit 0
//! deps: core
// Static functions, methods and extensions take defaults and named
// arguments as free functions do; the receiver is never named.

struct Server {
    val base: int32
}

impl Server {
    static fun open(port: int32 = 80, backlog: int32 = 10): Server { return Server { base: port + backlog } }
    fun send(bytes: int32, retries: int32 = 1): int32 { return self.base + bytes * retries }
}

fun Server.scaled(by: int32 = 2, plus: int32 = 0): int32 { return self.base * by + plus }

fun main(): int32 {
    val server = Server.open()
    if server.base != 90 { return 1 }
    if Server.open(backlog = 0).base != 80 { return 2 }
    if server.send(3) != 93 { return 3 }
    if server.send(retries = 2, bytes = 1) != 92 { return 4 }
    if server.scaled() != 180 { return 5 }
    if server.scaled(plus = 1) != 181 { return 6 }
    return 0
}
