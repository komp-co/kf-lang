//! run: exit 0
//! deps: core, alloc
// `on any` marks functions of any signature, structs, enums and traits, and
// each entry's `kind` says which.

annotation deprecated(since: String) on any

@deprecated("0.3")
fun add(a: int32, b: int32): int32 { return a + b }

@deprecated("0.4")
struct Point {
    val x: int32
}

@deprecated("0.5")
enum Speed {
    Fast
    Slow
}

@deprecated("0.6")
trait Shown {
    fun show(): int32
}

fun main(): int32 {
    val entries = annotated<deprecated>()
    if entries.size() != 4 { return 1 }
    if entries.at(0).kind != AnnotatedKind.Function { return 2 }
    if entries.at(3).kind != AnnotatedKind.Trait || entries.at(3).name != "Shown" { return 3 }
    var traits = 0
    while entry in &entries {
        if entry.kind == AnnotatedKind.Trait { traits = traits + 1 }
    }
    return traits - 1 + add(0, 0) + Point { x: 0 }.x
}
