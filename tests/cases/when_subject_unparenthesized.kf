//! run: exit 0
//! deps: core
// `when` takes its subject as `if` takes a condition: struct literals are off,
// so the `{` opens the arms. Parenthesized is the same grammar.

struct Point { pub val x: int32 }

enum Shape { Circle(int32)
             Square(int32) }

fun bare(s: Shape): int32 {
    return when s {
        Circle(r) => r * 3
        Square(w) => w * w
    }
}

fun parenthesized(s: Shape): int32 {
    return when (s) {
        Circle(r) => r
        Square(w) => w
    }
}

// The subject is a field access, so the `{` cannot be a struct-literal body.
fun from_field(p: Point): int32 {
    when p.x {
        1 => return 10
        _ => return 20
    }
}

fun main(): int32 {
    if bare(Shape.Circle(2)) != 6 { return 1 }
    if bare(Shape.Square(3)) != 9 { return 2 }
    if parenthesized(Shape.Square(5)) != 5 { return 3 }
    if from_field(Point { x: 1 }) != 10 { return 4 }
    if from_field(Point { x: 9 }) != 20 { return 5 }
    return 0
}
