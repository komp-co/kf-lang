//! run: exit 0
//! deps: core, alloc
// `Equal` and `Hash` written as templates behave as `@derive` does on a
// struct with the same fields.

annotation equal_fields on struct
annotation hash_fields on struct

template equal_fields on struct T {
    impl Equal for T {
        fun equals(other: &T): bool {
            while field in T.fields {
                if field.of(self) != field.of(other) { return false }
            }
            return true
        }
    }
}

template hash_fields on struct T {
    impl Hash for T {
        fun hash(): uint64 {
            var h: uint64 = 0
            while field in T.fields {
                if field.index == 0 {
                    h = field.of(self).hash()
                } else {
                    h = h * 31 + field.of(self).hash()
                }
            }
            return h
        }
    }
}

@equal_fields
@hash_fields
struct Templated {
    val id: int64
    val name: String
    val ok: bool
}

@derive(Equal, Hash)
struct Derived {
    val id: int64
    val name: String
    val ok: bool
}

fun main(): int32 {
    val a = Templated { id: 4, name: "ann", ok: true }
    val b = Templated { id: 4, name: "ann", ok: true }
    val c = Templated { id: 4, name: "bob", ok: true }
    val d = Derived { id: 4, name: "ann", ok: true }
    val e = Derived { id: 4, name: "bob", ok: true }
    if a != b { return 1 }
    if a == c { return 2 }
    if a.hash() != d.hash() { return 3 }
    if c.hash() != e.hash() { return 4 }
    if a.hash() == c.hash() { return 5 }
    return 0
}
