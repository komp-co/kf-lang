//! run: exit 1
//! deps: core
// The arm that cannot finish still runs: here it panics.

import core.traits.Never

fun stop(m: str): Never {
    panic(m)
}

fun code(x: int32): int32 {
    val n = when (x) {
        0 => 10
        _ => stop("too big")
    }
    return n
}

fun main(): int32 {
    return code(7)
}
