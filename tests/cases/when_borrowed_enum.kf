//! run: exit 0
//! deps: core
// A `when` whose subject is `&Enum` matches through the borrow.

enum Shape {
    Circle(int32)
    Square(int32)
    Empty
}

fun area(s: &Shape): int32 {
    when (s) {
        Circle(r) => { return r * 3 }
        Square(w) => { return w * w }
        Empty => { return 0 }
    }
    return -1
}

fun main(): int32 {
    val c = Shape.Circle(4)
    if area(&c) != 12 { return 1 }
    val q = Shape.Square(5)
    if area(&q) != 25 { return 2 }
    val e = Shape.Empty
    if area(&e) != 0 { return 3 }
    return 0
}
