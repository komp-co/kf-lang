//! deps: core
// A generic requirement is satisfied by an impl at the same argument.
// `Sink<A>: Drain<A>` at A = int32 needs `impl Drain<int32>`, not merely
// some impl of Drain.

trait Drain<A> { fun drain(a: A): int32 }
trait Sink<A>: Drain<A> { fun sink(a: A): int32 }

struct Bin { var n: int32 }

impl Drain<int32> for Bin { fun drain(a: int32): int32 { return a } }
impl Sink<int32> for Bin { fun sink(a: int32): int32 { return a * 2 } }

fun main(): int32 { return 0 }
