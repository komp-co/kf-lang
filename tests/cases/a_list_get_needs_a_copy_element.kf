//! build: fail
//! deps: core, alloc
// `get` copies an element out, so it exists only for a Copy element. For a
// String it would hand back a view of the list's own buffer, and the swap
// below would free what `tmp` still points at.

import alloc.list.*

fun main(): int32 {
    var xs = List.new<String>()
    xs.push(String.from("a"))
    xs.push(String.from("b"))
    val tmp = xs.get(0)
    xs.set(0, xs.get(1))
    xs.set(1, tmp)
    return 0
}
