trait Counter { mutating fun bump(): int32 }
struct Value { pub var amount: int32 }
impl Counter for Value {
    mutating fun bump(): int32 {
        self.amount = self.amount + 1
        return self.amount
    }
}

fun invalid(value: &dyn Counter): int32 { return value.bump() }
