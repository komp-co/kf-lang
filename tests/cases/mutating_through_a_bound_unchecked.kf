//! build: fail
//! deps: core
//! broken: #4 — a mutating method reached through a generic bound is not checked
// A `mutating` method reached through a bound on a `val` local, or a by-value
// parameter, is not rejected: the receiver is a type parameter and dispatch
// has not happened. `receiver_mutates` should read the trait requirement's
// `mutating` flag.

trait Bump {
    mutating fun bump(): void
}

struct C {
    pub var n: int32
}

impl Bump for C {
    mutating fun bump(): void {
        self.n = self.n + 1
    }
}

fun go<T: Bump>(x: T): void {
    val y = x
    y.bump()
}

fun main(): int32 {
    go<C>(C { n: 1 })
    return 0
}
