//! build: fail
// `Self.Out` resolves inside each of `impl Left for Bag` and `impl Right for
// Bag`; `Bag.Out` outside both names two bindings and is rejected, not
// first-match. The message is asserted in kf-typecheck's unit tests.
trait Left {
    type Out
    fun l(): Self.Out
}

trait Right {
    type Out
    fun r(): Self.Out
}

struct Bag {
    pub val n: int32
}

impl Left for Bag {
    type Out = int32
    fun l(): Self.Out { return self.n }
}

impl Right for Bag {
    type Out = bool
    fun r(): Self.Out { return true }
}

fun outside(): Bag.Out { return 1 }

fun main(): int32 {
    val b = Bag { n: 1 }
    return outside()
}
