//! run: exit 0
//! deps: core, alloc

// An `if` whose branches build `String`s, passed where a `str` is taken, views
// the chosen `String` for the call. It is not lent branch by branch through
// `Deref`, which would view a temporary already dropped.

fun flatten(path: str): String {
    var out = ""
    var i: uint64 = 0
    while i < path.byte_len() {
        val keep = path.byte_at(i) != '/' as uint8
        out.append(if keep { path.substring(i, i + 1) } else { String.from("_") })
        i = i + 1
    }
    return out
}

fun main(): int32 {
    if flatten("a/bc/d") != "a_bc_d" { return 1 }
    return 0
}
