//! build: fail
//! deps: core, alloc

// A field access is checked against the struct's fields. A method read without
// parentheses, `xs.size`, is named as a method.
//
// CONSTRAINT: `build: fail` passes on a gcc failure too; the message is
// asserted in `check_method_test.kf`.

import alloc.list.*

pub struct Bag {
    pub val n: int32
}

impl Bag {
    pub fun total(): int32 {
        return self.n
    }
}

fun main(): int32 {
    val b = Bag { n: 1 }

    // A method read as a field: the parentheses are missing, not the name.
    val t = b.total

    // A name that is neither field nor method.
    val q = b.nope

    // The same slip on a monomorphized receiver from another crate, resolved
    // through the base name: `List_size` for `List__int32`.
    val xs = List.new<int32>()
    val n = xs.size

    return 0
}
