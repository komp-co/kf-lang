//! build: fail
//! deps: core, alloc
// `first(xs)` needs `xs` as an `int32[2]`, which a list is not, so the later
// `push` cannot make it one; the error names both uses.

fun first(xs: int32[2]): int32 { return xs[0] }

fun main(): int32 {
    var xs = [1, 2]
    val head = first(xs)
    xs.push(3)
    return head
}
