//! run: exit 2
//! deps: core, alloc
// A binder the arm writes through is its payload, not a copy: the second
// `bump` sees the first.

struct Counter {
    var n: int32
}

impl Counter {
    mutating fun bump(): int32 {
        self.n = self.n + 1
        return self.n
    }
}

struct Holder {
    var counter: Counter?
}

impl Holder {
    mutating fun bump(): int32 {
        return when (self.counter) {
            Some(c) => c.bump()
            None => -1
        }
    }
}

fun main(): int32 {
    var h = Holder { counter: Option.Some(Counter { n: 0 }) }
    val _a = h.bump()
    val b = h.bump()
    return b
}
