//! run: exit 69
// A `when` used as a value whose arms end in an `if`: an arm's value is walked
// as a block's tail is. The plain arm keeps the single-expression path.

fun arm_ends_in_if(k: int32, c: bool): int32 {
    val v = when (k) {
        1 => {
            val a = 10
            if c { a + 1 } else { a + 2 }
        }
        2 => { 5 }
        _ => { 0 }
    }
    return v
}

fun arm_ends_in_when(k: int32, j: int32): int32 {
    val v = when (k) {
        1 => {
            when (j) {
                7 => { 70 }
                _ => { 71 }
            }
        }
        _ => { 0 }
    }
    return v
}

fun plain(k: int32): int32 {
    val v = when (k) {
        1 => { 100 }
        _ => { 200 }
    }
    return v
}

fun main(): int32 {
    var acc: int32 = 0
    acc = acc + arm_ends_in_if(1, true)     // 11
    acc = acc + arm_ends_in_if(1, false)    // 12  -> 23
    acc = acc + arm_ends_in_if(2, true)     // 5   -> 28
    acc = acc + arm_ends_in_when(1, 7)      // 70  -> 98
    acc = acc + arm_ends_in_when(1, 8)      // 71  -> 169
    acc = acc + plain(1)                    // 100 -> 269
    return acc - 200
}
