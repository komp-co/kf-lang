//! asan: clean
// `== null` on a call's result tests the tag of a temporary, which is then
// dropped with its payload.

struct Message {
    pub val id: String
}

fun parse(text: str): Message? {
    return Option.Some(Message { id: String.from(text) })
}

fun main(): int32 {
    if parse("seven") == null { return 1 }
    return 0
}
