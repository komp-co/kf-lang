//! asan: clean
// A field given a moved local frees the list it held.


struct Holder {
    pub var items: List<String>
}

fun main(): int32 {
    var first = List.new<String>()
    first.push(String.from("first value"))
    var h = Holder { items: first }
    var second = List.new<String>()
    second.push(String.from("second value"))
    h.items = second
    return 0
}
