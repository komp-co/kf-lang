//! asan: clean
//! broken: #5 — a method call on an rvalue receiver leaks the temporary
// The receiver temp is never dropped. Hoisting it to a scope-dropped local
// would make `return n` hand the caller a dangling view.
import alloc.string.*

fun make_name(): String { return String.from("hello world") }

fun main(): int32 {
    val n = make_name().as_str()
    if !n.equals("hello world") { return 1 }
    return 0
}
