//! asan: clean
// `var f = *frames.at(0)` copies the element, so growing `f` leaves the
// list's element untouched and both are freed once.


@derive(Clone)
struct Frame {
    pub var names: List<String>
}

fun main(): int32 {
    var frames = List.new<Frame>()
    var first = List.new<String>()
    first.push(String.from("already here"))
    frames.push(Frame { names: first })
    var f = *frames.at(0)
    f.names.push(String.from("added to the copy"))
    return 0
}
