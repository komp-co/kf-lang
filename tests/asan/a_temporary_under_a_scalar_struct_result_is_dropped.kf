//! asan: clean
// A call returning a struct of scalars cannot hold the borrow it was given.

struct Id {
    pub val raw: uint32
}

fun make(): String { return String.from("hello world") }

fun id_of(s: str): Id { return Id { raw: s.byte_len() as uint32 } }

fun main(): int32 {
    val i = id_of(make().as_str())
    return 0
}
