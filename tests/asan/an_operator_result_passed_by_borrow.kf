//! asan: clean
// An operator result passed by borrow gets a compound-literal address and must
// still get an owner.

fun len_of(s: &String): uint64 { return s.byte_len() }

fun arg_sum(a: &String): uint64 {
    return len_of(&(a + String.from("xyz")))
}

fun main(): int32 {
    val a = String.from("abc")
    if arg_sum(&a) != 6 { return 1 }
    return 0
}
