//! asan: clean
// `take_last() ?:` hands the element to its binder, which moves it into
// the other list; nothing is copied or left behind.

import alloc.list.*

fun main(): int32 {
    var from = List.new<String>()
    from.push(String.from("the first element"))
    from.push(String.from("the second element"))
    var to = List.new<String>()
    while !from.is_empty() {
        val s = from.take_last() ?: return 1
        to.push(s)
    }
    return 0
}
