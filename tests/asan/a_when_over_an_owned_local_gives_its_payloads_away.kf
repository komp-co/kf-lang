//! asan: clean
// A `when` over an owned local or parameter that moves a payload out consumes
// it: each payload is freed once, by whoever it moved to.
pub struct Item {
    var n: String
}

pub enum Slot {
    Full(Item)
    Boxed(Box<Item>)
    Empty
}

fun collect(slot: Slot): List<Item> {
    var out = List.new<Item>()
    when (slot) {
        Full(b) => out.push(b)
        Boxed(b) => out.push(Item { n: b.n.clone() })
        Empty => { }
    }
    return out
}

fun boxes(slot: Slot): List<Box<Item>> {
    var out = List.new<Box<Item>>()
    when (slot) {
        Boxed(b) => out.push(b)
        _ => { }
    }
    return out
}

fun main(): int32 {
    val a = collect(Slot.Full(Item { n: String.from("kf") }))
    val local = Slot.Boxed(Box.new(Item { n: String.from("boxed") }))
    val b = boxes(local)
    val c = collect(Slot.Empty)
    return (a.size() + b.size() * 10 + c.size() * 100) as int32 + b.at(0).n.byte_len() as int32 * 1000
}
