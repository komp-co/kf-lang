//! asan: clean
// `v == "get"` converts the literal to a `String`; the guard owns that
// temporary and drops it, whichever arm runs.

fun code(s: String): int32 {
    return when s {
        v if v == "get" => 1
        _ => 0
    }
}

fun main(): int32 {
    return code(String.from("get")) + code(String.from("put"))
}
