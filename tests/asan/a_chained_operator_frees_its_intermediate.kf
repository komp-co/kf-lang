//! asan: clean
// `a + b + c` is `(a + b) + c`: the intermediate is the left operand of the
// second `+`, borrowed and never dropped.

fun joined(a: &String, b: &String, c: &String): uint64 {
    val s = a + b + c
    return s.byte_len()
}

fun main(): int32 {
    val a = String.from("ab")
    val b = String.from("cd")
    val c = String.from("ef")
    if joined(&a, &b, &c) != 6 { return 1 }
    return 0
}
