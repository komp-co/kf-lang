//! asan: clean
// A mutating call on a field of a returned borrow runs on the field itself,
// not a bit copy of it.

struct Holder {
    pub var tags: List<String>
}

fun main(): int32 {
    var hs = List.new<Holder>()
    hs.push(Holder { tags: List.new<String>() })
    hs.at_mut(0).tags.push(String.from("x"))
    hs.at_mut(0).tags.push(String.from("y"))
    return 0
}
