//! asan: clean
//! deps: core, alloc
// A `when` value whose arm returns early: the value another arm built, and
// the one returned, are each freed once.

fun label(x: int32): String {
    val word = when (x) {
        0 => String.from("zero")
        _ => return String.from("many")
    }
    return word + "!"
}

fun main(): int32 {
    val a = label(0)
    val b = label(5)
    return 0
}
