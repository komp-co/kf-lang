//! asan: clean
// A list literal in a slot implementing `From<T[N]>` is built as an array and
// handed to `from`: each String is freed once, by the collection.
import alloc.string.*

struct Row<T> {
    var data: Ptr<T>
    var len: uint64
}

impl<T> Row<T> {
    fun at(i: uint64): &T { return unsafe { &*(self.data + i) } }
}

impl<T, N: uint64> From<T[N]> for Row<T> {
    static fun from(items: T[N]): Row<T> {
        val data = unsafe { alloc_array<T>(N) }
        unsafe { *(data as Ptr<T[N]>) = items }
        return Row<T> { data: data, len: N }
    }
}

impl<T> Drop for Row<T> {
    fun drop(): void {
        while i in 0..self.len { unsafe { drop_in_place<T>(self.data + i) } }
        unsafe { dealloc<T>(self.data) }
    }
}

fun longest(row: Row<String>): uint64 {
    var most: uint64 = 0
    while i in 0..row.len {
        if row.at(i).byte_len() > most { most = row.at(i).byte_len() }
    }
    return most
}

fun main(): int32 {
    val row: Row<String> = [String.from("ab"), String.from("cde")]
    if row.at(1).byte_len() != 3 { return 1 }
    if longest([String.from("x"), String.from("yz")]) != 2 { return 2 }
    return 0
}
