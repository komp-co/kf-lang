//! asan: clean
// `"n=${n}!"` expands to `(String.from("n=") + String.of(&(n))) + String.from("!")`.
// Both left operands are fresh values the operator only borrows, and both
// must be dropped.

fun label(n: int32): uint64 {
    val s = "n=${n}!"
    return s.byte_len()
}

fun main(): int32 {
    if label(7) != 4 { return 1 }
    return 0
}
