//! asan: clean
// `self.items = kept` inside a mutating method frees the list it replaces.

import alloc.list.*

struct Holder {
    pub var items: List<String>
}

mutating fun Holder.keep_all(): void {
    var kept = List.new<String>()
    while item in &self.items { kept.push(item) }
    self.items = kept
}

fun main(): int32 {
    var first = List.new<String>()
    first.push(String.from("first value"))
    var h = Holder { items: first }
    h.keep_all()
    return 0
}
