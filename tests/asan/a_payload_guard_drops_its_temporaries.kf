//! asan: clean
// A guard over a payload binder owns one temporary per comparison it runs.

fun label(o: String?): int32 {
    return when o {
        Some(v) if v == "a" || v == "b" => 1
        Some(_) => 2
        None => 3
    }
}

fun main(): int32 {
    return label(Option.Some<String>(String.from("b"))) + label(Option.Some<String>(String.from("z"))) + label(null)
}
