//! asan: clean
// Each element of an array of strings is freed once, after the array moves.

fun keep(words: Array<String, 2>): uint64 {
    return words.size()
}

fun main(): int32 {
    var words = Array<String, 2> {}
    words[0] = String.from("first element")
    words[1] = String.from("second element")
    val moved = words
    return keep(moved) as int32
}
