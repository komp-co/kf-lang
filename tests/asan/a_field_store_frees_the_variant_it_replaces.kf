//! asan: clean
// A field given a variant built from fresh parts frees the old variant.

enum Kind {
    Leaf(String)
    Empty
}

struct Holder {
    pub var kind: Kind
    pub var name: String?
}

fun main(): int32 {
    var h = Holder { kind: Kind.Leaf(String.from("first value")), name: Option.Some(String.from("first name")) }
    h.kind = Kind.Leaf(String.from("second value"))
    h.name = Option.Some(String.from("second name"))
    return 0
}
