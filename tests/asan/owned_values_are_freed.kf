//! asan: clean
// The positive control: correct ownership comes back clean, or the gate is not
// looking.
import alloc.string.*

struct Holder { pub var items: List<String> }

fun longest(h: &Holder): uint64 {
    var best = 0
    var i = 0
    while i < h.items.size() {
        val n = h.items.at(i).byte_len()
        if n > best { best = n }
        i = i + 1
    }
    return best
}

fun consume(h: Holder): uint64 { return h.items.size() }

fun main(): int32 {
    var l = List.new<String>()
    l.push(String.from("alpha"))
    l.push(String.from("bravo-longer"))
    var h = Holder { items: l }
    if longest(&h) != 12 { return 1 }
    if consume(h) != 2 { return 2 }
    return 0
}
