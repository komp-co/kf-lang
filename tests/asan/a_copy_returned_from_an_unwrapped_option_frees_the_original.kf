//! asan: clean
// The binder `?:` unwraps is copied into the result; the copy holds nothing
// of it, so the payload is still dropped.


@derive(Clone)
struct Sig {
    pub var name: String
}

struct Site {
    pub var sig: Sig
}

fun find(xs: &List<Sig>): Sig? {
    return Option.Some(*xs.at(0))
}

fun site(xs: &List<Sig>): Site? {
    val sig = find(xs) ?: return null
    return Site { sig: sig }
}

fun main(): int32 {
    var xs = List.new<Sig>()
    xs.push(Sig { name: String.from("a signature") })
    val s = site(&xs)
    return 0
}
