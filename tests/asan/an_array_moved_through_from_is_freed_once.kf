//! asan: clean
// An array passed to a `From<T[N]>` impl gives its elements up in one raw
// store: each String is freed once, by the collection, and never by the
// array it left.
import alloc.string.*

struct Row<T> {
    var data: Ptr<T>
    var len: uint64
}

impl<T> Row<T> {
    fun at(i: uint64): &T { return unsafe { &*(self.data + i) } }
}

impl<T, N: uint64> From<T[N]> for Row<T> {
    static fun from(items: T[N]): Row<T> {
        val data = unsafe { alloc_array<T>(N) }
        unsafe { *(data as Ptr<T[N]>) = items }
        return Row<T> { data: data, len: N }
    }
}

impl<T> Drop for Row<T> {
    fun drop(): void {
        while i in 0..self.len { unsafe { drop_in_place<T>(self.data + i) } }
        unsafe { dealloc<T>(self.data) }
    }
}

fun main(): int32 {
    val names: String[2] = [String.from("ab"), String.from("cde")]
    val row = Row.from(names)
    if row.at(1).byte_len() != 3 { return 1 }
    return 0
}
