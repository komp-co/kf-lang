//! asan: clean
// A value that cannot hold a borrow keeps no local alive: `scratch` is lent
// to the call and dropped once the result exists.


struct Holder {
    pub var items: List<String>
}

fun count_into(h: Holder, extra: &var List<String>): Holder {
    return h
}

fun make(): Holder {
    var scratch = List.new<String>()
    scratch.push(String.from("scratch"))
    val h = Holder { items: List.new<String>() }
    return count_into(h, &var scratch)
}

fun main(): int32 {
    val h = make()
    return 0
}
