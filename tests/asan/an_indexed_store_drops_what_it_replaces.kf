//! asan: clean
// `names[0] = ...` drops the element it overwrites, and `names[0] = names[1]`
// copies rather than aliasing the other slot.

fun main(): int32 {
    var names = List.new<String>()
    names.push(String.from("oooooooooooooooooooo"))
    names.push(String.from("bbb"))
    names[0] = String.from("z")
    names[0] = names[1]
    return 0
}
