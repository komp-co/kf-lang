//! asan: clean
// A temporary borrowed inside a struct literal's field is consumed there.

struct Holder {
    pub val n: uint64
}

fun make(): String { return String.from("hello world") }

fun takes(s: str): uint64 { return s.byte_len() }

fun main(): int32 {
    val h = Holder { n: takes(make().as_str()) }
    return 0
}
