//! asan: clean
// Storing back a variant rebuilt from the field's own binder neither leaks
// nor frees it twice.

enum Kind {
    Leaf(String)
    Empty
}

struct Holder {
    pub var kind: Kind
}

fun main(): int32 {
    var h = Holder { kind: Kind.Leaf(String.from("leaf")) }
    when (h.kind) {
        Leaf(s) => { h.kind = Kind.Leaf(s) }
        Empty => { }
    }
    return 0
}
