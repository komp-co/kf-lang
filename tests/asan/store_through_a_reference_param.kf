//! asan: clean
// A store through a `&var` parameter, to a field and to the whole value, drops
// what it overwrites.

struct Holder {
    pub var name: String
}

fun rename(h: &var Holder): void {
    h.name = String.from("renamed")
}

fun replace(h: &var Holder): void {
    *h = Holder { name: String.from("replaced") }
}

fun main(): int32 {
    var h = Holder { name: String.from("original") }
    rename(&var h)
    replace(&var h)
    return 0
}
