//! asan: clean
// Scope functions borrow an owning receiver: `let` and `also` read it in
// place, `take_if` copies it once, and the original is dropped once.
fun main(): int32 {
    val s = String.from("komp")
    val n = s.let(|v| v.byte_len())
    val same = s.also(|v| { val _k = v.byte_len() })
    val kept = s.take_if(|v| v.byte_len() > 2) ?: String.from("none")
    val gone = s.take_unless(|v| v.byte_len() > 2) ?: String.from("none")
    return (n + same.byte_len() + kept.byte_len() + gone.byte_len()) as int32 - 16
}
