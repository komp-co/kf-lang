//! asan: clean
// A local struct's move-only field passed to an enum constructor that is
// itself a call argument must not be owned by both.

struct Tail { val name: String }
struct Decl { val kind: Kind }
enum Kind { Fn(String) }

fun wrap(k: Kind): Decl { return Decl { kind: k } }

fun main(): int32 {
    val tail = Tail { name: String.from("x") }
    val d = wrap(Kind.Fn(tail.name))
    return 0
}
