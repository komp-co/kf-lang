//! asan: clean
// One by-value parameter consumed by two callees in one call, one needing a
// temp for `.as_str()`: the hoist runs the second consume first. Both copy,
// and the original is dropped once in `outer`.
import alloc.string.*

struct Holder { pub var items: List<String> }

fun names_of(h: Holder): List<String> {
    var out = List.new<String>()
    var i = 0
    while i < h.items.size() {
        out.push(h.items.at(i).clone())
        i = i + 1
    }
    return out
}

fun key_of(h: Holder): String {
    var s = String.from("k:")
    if h.items.size() > 0 { s.append(h.items.at(0).as_str()) }
    return s
}

fun use_both(names: List<String>, key: str): int32 {
    if names.size() == 0 { return 1 }
    if key.equals("") { return 2 }
    return 0
}

fun outer(h: Holder): int32 {
    return use_both(names_of(h), key_of(h).as_str())
}

fun main(): int32 {
    var l = List.new<String>()
    l.push(String.from("aaa"))
    return outer(Holder { items: l })
}
