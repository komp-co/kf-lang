//! asan: clean
//! broken: #484 — a store through a borrow keeps the old value when the new one reads it
// A lambda assigning a captured `String` replaces the caller's, freeing the
// old text once, each call.
fun twice<F: CallMut0>(f: F): void {
    f()
    f()
}

fun main(): int32 {
    var log = String.from("start")
    twice(|| { log = log + "x" })
    return log.byte_len() as int32 - 7
}
