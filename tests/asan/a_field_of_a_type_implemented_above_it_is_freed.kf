//! asan: clean
// An impl block written above its type comes first under the same name; the
// outer drop still frees the field.

impl Inner {
    pub fun first(): str {
        return self.text.as_str()
    }
}

struct Inner {
    pub var text: String
}

struct Outer {
    pub var inner: Inner
}

fun main(): int32 {
    val o = Outer { inner: Inner { text: String.from("owned by the inner struct") } }
    return 0
}
