//! asan: clean
// Storing through `at_mut` replaces the slot, and the value it held is dropped
// after the store.
import alloc.string.*

fun main(): int32 {
    var names = List.new<String>()
    names.push(String.from("oooooooooooooooooooo"))
    *(names.at_mut(0)) = String.from("z")
    return 0
}
