//! asan: clean
// A later use of a local a `when` consumed keeps it alive by handing the
// `when` a clone; the clone and the local are each freed once.
pub struct Item {
    var n: String
}

pub enum Slot {
    Full(Item)
    Empty
}

fun main(): int32 {
    var out = List.new<Item>()
    val slot = Slot.Full(Item { n: String.from("kf") })
    when (slot) {
        Full(b) => out.push(b)
        Empty => { }
    }
    val after = slot is Full
    if after && out.size() == 1 { return 0 }
    return 1
}
