//! asan: clean
// A by-value `Box` parameter is freed by its callee, and a `List<Box<T>>`
// frees, and clones, each pointee.
pub struct Item {
    var name: String
}

fun consume(_b: Box<Item>): void { }

fun main(): int32 {
    consume(Box.new(Item { name: String.from("gone") }))
    var items = List.new<Box<Item>>()
    items.push(Box.new(Item { name: String.from("kept") }))
    val copy = items.clone()
    return copy.size() as int32 - 1
}
