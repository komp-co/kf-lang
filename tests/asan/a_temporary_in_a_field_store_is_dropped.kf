//! asan: clean
// A temporary borrowed inside the value stored to a field is consumed there.

struct Holder {
    pub var n: uint64
}

fun make(): String { return String.from("hello world") }

fun takes(s: str): uint64 { return s.byte_len() }

fun main(): int32 {
    var h = Holder { n: 0 }
    h.n = takes(make().as_str())
    return 0
}
