//! asan: clean
// `is` over a fresh value with an owned payload drops it, and over a place
// leaves it to its owner.
enum Named {
    Some(String)
    Nothing
}

fun make(on: bool): Named {
    if on { return Named.Some(String.from("kf")) }
    return Named.Nothing
}

fun main(): int32 {
    val kept = make(true)
    val a = make(true) is Some
    val b = kept is Nothing
    if a && !b { return 0 }
    return 1
}
