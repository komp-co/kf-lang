//! asan: clean
// Each combinator over an owned payload, both arms: what it hands on is freed
// once, and what it drops is freed.
fun named(on: bool): String? {
    if on { return Option.Some(String.from("kf")) }
    return null
}

fun outcome(on: bool): Result<String, String> {
    if on { return Result.Ok(String.from("ok")) }
    return Result.Err(String.from("no"))
}

fun kept(s: String): String? { return Option.Some(s) }

fun main(): int32 {
    val a = named(true).map(|s| s.byte_len())
    val b = named(false).unwrap_or(String.from("anonymous"))
    val c = named(true).unwrap_or_else(|| String.from("x"))
    val d = named(true).and_then(|s| kept(s))
    val e = named(false).or_else(|| named(true))
    val f = named(true).filter(|s| s.byte_len() > 5)
    val g = named(true).ok_or(String.from("none"))
    val h = outcome(false).map_err(|e| e.byte_len())
    val i = outcome(false).or_else(|_e| outcome(true))
    val j = outcome(true).and_then(|s| outcome(s.byte_len() > 1))
    val k = outcome(true).ok()
    val l = outcome(false).err()
    val m = outcome(false).unwrap_or_else(|e| e)
    return 0
}
