//! asan: clean
// An extension borrows its receiver: a named one is still usable afterwards
// and dropped once, a temporary one is dropped after the call, and a
// `mutating` one is changed in place.

import alloc.list.*

fun String.twice_len(): uint64 {
    return self.byte_len() * 2
}

fun <T: Clone> List<T>.first_or(fallback: T): T {
    if self.size() == 0 { return fallback }
    return *self.at(0)
}

mutating fun List<String>.add_greeting(): void {
    self.push(String.from("hello"))
}

fun main(): int32 {
    val s = String.from("abc")
    val _a = s.twice_len()
    val _b = s.byte_len()
    val _c = String.from("xy").twice_len()
    var names = List.new<String>()
    names.add_greeting()
    val _first = names.first_or(String.from("none"))
    val _d = twice_len(&s)
    return 0
}
