//! asan: clean
// A fresh owned rvalue passed to a `&T` parameter: the compound-literal temp
// giving the borrow an address is dropped.
import alloc.string.*

fun make_name(): String { return String.from("hello world") }

fun len_of(s: &String): uint64 { return s.byte_len() }

fun main(): int32 {
    if len_of(&make_name()) != 11 { return 1 }
    return 0
}
