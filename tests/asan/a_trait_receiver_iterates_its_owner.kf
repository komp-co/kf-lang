//! asan: clean
// An extension on a trait receiver walks an owning collection through the
// trait's iterator: the strings are borrowed, never dropped by the walk, and
// the list is dropped once.


fun Iterable<String>.total_len(): uint64 {
    var n: uint64 = 0
    while s in self {
        n = n + s.byte_len()
    }
    return n
}

fun Iterable<T>.count_all(): int32 {
    var n = 0
    var it = self.iter()
    while true {
        val _item = it.next() ?: break
        n = n + 1
    }
    return n
}

fun main(): int32 {
    var names = List.new<String>()
    names.push(String.from("ada"))
    names.push(String.from("grace"))
    val _a = names.total_len()
    val _b = names.count_all()
    val _c = names.total_len()
    return 0
}
