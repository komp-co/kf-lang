//! asan: clean
// Each of these moves an owning element from one slot to another, or out of
// the list; none may copy it, so a copy shows up as a leak.
import alloc.string.*

fun words(): List<String> {
    var xs = List.new<String>()
    xs.push(String.from("alpha-long-enough-to-own-a-buffer"))
    xs.push(String.from("bravo-long-enough-to-own-a-buffer"))
    xs.push(String.from("charlie-long-enough-to-own-a-buffer"))
    return xs
}

fun main(): int32 {
    var a = words()
    a.swap(0, 2)
    val last = a.take_last()
    a.swap_remove(0)
    var b = words()
    val removed = b.remove(1)
    b.insert(0, String.from("delta-long-enough-to-own-a-buffer"))
    b.extend(words())
    return 0
}
