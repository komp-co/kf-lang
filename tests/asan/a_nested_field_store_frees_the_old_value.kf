//! asan: clean
// `h.inner.items = ...` frees the list it replaces, as `h.items = ...` does.


struct Inner {
    pub var items: List<String>
}

struct Holder {
    pub var inner: Inner
}

fun main(): int32 {
    var first = List.new<String>()
    first.push(String.from("first value"))
    var h = Holder { inner: Inner { items: first } }
    h.inner.items = List.new<String>()
    return 0
}
