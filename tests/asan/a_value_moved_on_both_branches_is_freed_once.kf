//! asan: clean
// Each branch moves `names` into a call that drops it; only one branch runs,
// so neither takes a copy and nothing is left behind.

import alloc.list.*

fun first_count(names: List<String>): uint64 {
    return names.size()
}

fun second_count(names: List<String>): uint64 {
    return names.size() + 1
}

fun main(): int32 {
    var names = List.new<String>()
    names.push(String.from("only one branch takes this"))
    var n: uint64 = 0
    if names.size() > 0 {
        n = first_count(names)
    } else {
        n = second_count(names)
    }
    return 0
}
