//! asan: clean
// A string arm binds the subject to compare it; an owned `String` subject is
// dropped once, whichever arm runs.

fun code(s: String): int32 {
    return when s {
        "get" => 1
        _ => 0
    }
}

fun main(): int32 {
    return code(String.from("get")) + code(String.from("put"))
}
