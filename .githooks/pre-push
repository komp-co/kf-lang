#!/bin/sh
# Block direct pushes to development and main — changes go through a PR.
#
# The local mirror of GitHub's branch protection, so the refusal arrives
# before the round trip. Enable it once per clone with:
#
#     git config core.hooksPath .githooks
#
# Emergency bypass (use sparingly): git push --no-verify
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/development|refs/heads/main)
            echo "✗ Direct push to '${remote_ref#refs/heads/}' is blocked — open a PR from a feature branch."
            echo "  Branch convention: <type>/<issue#>-<slug>  (e.g. fix/5-unresolved-dep-error)"
            echo "  Emergency bypass:  git push --no-verify"
            exit 1
            ;;
    esac
done
exit 0
