#!/bin/sh
# Refuse a commit whose staged .kf files are not formatted, or whose crates
# do not lint clean, as CI would: `scripts/preflight.sh --staged`. Formatting
# is skipped when komp-fmt is not installed (`komp tool install komp_fmt`),
# and the lints when no komp is found (see the script).
#
# Bypass: git commit --no-verify
exec sh "$(git rev-parse --show-toplevel)/scripts/preflight.sh" --staged
