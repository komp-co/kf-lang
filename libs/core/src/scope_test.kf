import core.assert.assert_eq

struct ScopeProbe { var n: int32 }

@test fun let_answers_what_the_lambda_answers(): void {
    assert_eq(20.let(|v: &int32| *v + 1), 21, "let")
}

@test fun let_changes_the_type(): void {
    assert_eq(7.let(|v: &int32| *v > 3), true, "an int in, a bool out")
}

@test fun also_hands_the_receiver_back(): void {
    val c = ScopeProbe { n: 4 }
    assert_eq(c.also(|v: &ScopeProbe| { val _seen = v.n }).n, 4, "the same value")
}

@test fun apply_mutates_the_receiver(): void {
    var c = ScopeProbe { n: 1 }
    c.apply(|v: &var ScopeProbe| { v.n = 9 })
    assert_eq(c.n, 9, "changed in place")
}

@test fun take_if_keeps_an_accepted_value(): void {
    assert_eq(7.take_if(|v: &int32| *v > 3) ?: 0, 7, "kept")
}

@test fun take_if_drops_a_refused_value(): void {
    assert_eq(1.take_if(|v: &int32| *v > 3) ?: 0, 0, "refused")
}

@test fun take_unless_is_the_inverse(): void {
    assert_eq(1.take_unless(|v: &int32| *v > 3) ?: 0, 1, "kept")
}
