// The process's arguments, each a borrow of argv, so nothing is allocated.

extern "C" fun kf_arg_count(): int32
extern "C" fun kf_arg_get(i: int32): str

/// Not counting the program name.
@prelude
pub fun arg_count(): uint64 {
    val n = unsafe { kf_arg_count() }
    if n < 0 { return 0 as uint64 }
    return n as uint64
}

/// Counting from the first after the program name.
///
/// CONSTRAINT: borrows argv, valid for the whole program. Out of range gives
/// `""`.
@prelude
pub fun arg_at(i: uint64): str {
    if i >= arg_count() { return "" }
    return unsafe { kf_arg_get(i as int32) }
}
