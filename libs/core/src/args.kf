// The process's arguments, each a borrow of argv, so nothing is allocated.

extern "C" fun kf_arg_count(): int32
extern "C" fun kf_arg_get(i: int32): str
extern "C" fun kf_program_name(): str

/// The arguments this process was run with.
pub struct Args { }

impl Args {
    /// Not counting the program name.
    pub static fun count(): uint64 {
        val n = kf_arg_count()
        return if n < 0 { 0 } else { n as uint64 }
    }

    /// Counting from the first after the program name.
    ///
    /// CONSTRAINT: borrows argv, valid for the whole program. Out of range
    /// gives `""`.
    pub static fun at(i: uint64): str {
        if i >= Args.count() { return "" }
        return kf_arg_get(i as int32)
    }

    /// The program's name as it was run: argv[0], "" when there is none. A
    /// program that answers to several names, through links, tells them
    /// apart by it.
    pub static fun program_name(): str {
        return kf_program_name()
    }
}
