// What went wrong when a library call cannot continue. A fault renders
// without a heap, so it can be reported where nothing can be allocated.

import core.traits.Never

/// The ways `core` and `alloc` stop. `panic_with` prints one as
/// `panic[<code>]: <message>`.
pub enum Fault {
    /// An index at or past the end: the index, then the length.
    IndexOutOfBounds(uint64, uint64)
    /// A position past the end: the position, then the length.
    PositionOutOfBounds(uint64, uint64)
    /// A range reaching past the end: its start, its end, then the length.
    RangeOutOfBounds(uint64, uint64, uint64)
    /// Two lengths that must agree: the one wanted, then the one found.
    LengthMismatch(uint64, uint64)
    /// `unwrap` on a `None`.
    UnwrapNone
    /// `unwrap` on an `Err`.
    UnwrapErr
    /// `unwrap_err` on an `Ok`.
    UnwrapOk
    /// A size past what `uint64` holds.
    CapacityOverflow
    /// A range stepping other than up by one, where only that will do.
    RangeNotAscending
    /// A width of zero, for chunks or windows.
    ZeroWidth
    /// A failed assertion; its message is printed first.
    AssertionFailed
}

impl Fault {
    /// The kind, as `panic[<code>]` prints it.
    pub fun code(): str {
        return self.kind().code()
    }

    /// The kind, without its values.
    pub fun kind(): FaultKind {
        return when (self) {
            IndexOutOfBounds(_i, _n) => FaultKind.IndexOutOfBounds
            PositionOutOfBounds(_p, _n) => FaultKind.PositionOutOfBounds
            RangeOutOfBounds(_s, _e, _n) => FaultKind.RangeOutOfBounds
            LengthMismatch(_w, _f) => FaultKind.LengthMismatch
            UnwrapNone => FaultKind.UnwrapNone
            UnwrapErr => FaultKind.UnwrapErr
            UnwrapOk => FaultKind.UnwrapOk
            CapacityOverflow => FaultKind.CapacityOverflow
            RangeNotAscending => FaultKind.RangeNotAscending
            ZeroWidth => FaultKind.ZeroWidth
            AssertionFailed => FaultKind.AssertionFailed
        }
    }
}

/// What `@test(panics = ...)` expects: a `Fault`'s kind without its values,
/// `AnyFault` for any panic, and `NoFault` for none.
@derive(Copy, Equal)
pub enum FaultKind {
    NoFault
    AnyFault
    IndexOutOfBounds
    PositionOutOfBounds
    RangeOutOfBounds
    LengthMismatch
    UnwrapNone
    UnwrapErr
    UnwrapOk
    CapacityOverflow
    RangeNotAscending
    ZeroWidth
    AssertionFailed
}

impl FaultKind {
    /// The code `panic[<code>]` prints; `any` for `AnyFault`, "" for `NoFault`.
    pub fun code(): str {
        return when (self) {
            NoFault => ""
            AnyFault => "any"
            IndexOutOfBounds => "index_out_of_bounds"
            PositionOutOfBounds => "position_out_of_bounds"
            RangeOutOfBounds => "range_out_of_bounds"
            LengthMismatch => "length_mismatch"
            UnwrapNone => "unwrap_none"
            UnwrapErr => "unwrap_err"
            UnwrapOk => "unwrap_ok"
            CapacityOverflow => "capacity_overflow"
            RangeNotAscending => "range_not_ascending"
            ZeroWidth => "zero_width"
            AssertionFailed => "assertion_failed"
        }
    }
}

impl Fault {
    /// The message, without the code, into `text`.
    fun write_message(text: &var FaultText): void {
        when (self) {
            IndexOutOfBounds(i, n) => {
                text.put("index ")
                text.put_number(i)
                text.put(" out of bounds for length ")
                text.put_number(n)
            }
            PositionOutOfBounds(p, n) => {
                text.put("position ")
                text.put_number(p)
                text.put(" past the end of length ")
                text.put_number(n)
            }
            RangeOutOfBounds(s, e, n) => {
                text.put("range ")
                text.put_number(s)
                text.put("..")
                text.put_number(e)
                text.put(" out of bounds for length ")
                text.put_number(n)
            }
            LengthMismatch(w, f) => {
                text.put("length ")
                text.put_number(f)
                text.put(" where ")
                text.put_number(w)
                text.put(" was wanted")
            }
            UnwrapNone => text.put("unwrap on a None")
            UnwrapErr => text.put("unwrap on an Err")
            UnwrapOk => text.put("unwrap_err on an Ok")
            CapacityOverflow => text.put("capacity overflow")
            RangeNotAscending => text.put("a range here must ascend by one")
            ZeroWidth => text.put("a width of zero")
            AssertionFailed => text.put("assertion failed")
        }
    }
}

impl Display for Fault {
    fun display(out: &var dyn Write): void {
        var text = new_fault_text()
        self.write_message(&var text)
        out.write_str(text.as_str())
    }
}

/// Room for the line `panic_with` prints, NUL-terminated for `panic`; a
/// longer one is cut short.
///
/// CONSTRAINT: written to through its own methods, never as a `dyn Write`.
/// A live `dyn Write` emits every `Write` and `Display` impl, and with them
/// the printing a freestanding program does not have.
struct FaultText {
    var bytes: Array<uint8, 256>
    var len: uint64
}

fun new_fault_text(): FaultText {
    return FaultText { bytes: Array<uint8, 256> {}, len: 0 }
}

impl FaultText {
    mutating fun put(s: str): void {
        var i: uint64 = 0
        while i < s.byte_len() {
            self.put_byte(s.byte_at(i))
            i = i + 1
        }
    }

    mutating fun put_number(v: uint64): void {
        if v >= 10 { self.put_number(v / 10) }
        self.put_byte((48 + v % 10) as uint8)
    }

    mutating fun put_byte(b: uint8): void {
        if self.len + 1 >= 256 { return }
        *self.bytes.at_mut(self.len) = b
        self.len = self.len + 1
    }

    fun as_str(): str {
        return unsafe { (&self.bytes) as Ptr<uint8> as str }
    }
}

/// Prints `panic[<code>]: <message>` and stops, as `panic` does.
@prelude
pub fun panic_with(fault: Fault): Never {
    var text = new_fault_text()
    text.put("panic[")
    text.put(fault.code())
    text.put("]: ")
    fault.write_message(&var text)
    panic(text.as_str())
}

/// `i`, when it indexes a run of `len` elements; otherwise a panic.
@prelude
pub fun checked_index(i: uint64, len: uint64): uint64 {
    if i >= len { panic_with(Fault.IndexOutOfBounds(i, len)) }
    return i
}
