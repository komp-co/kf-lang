import core.assert.*

fun digits(): int32[5] { return [1, 2, 3, 4, 5] }

@test
fun a_slice_of_an_array_has_its_length(): void {
    val xs = digits()
    assert_eq(xs.as_slice().size(), 5, "every element is viewed")
}

@test
fun a_slice_indexes_its_source(): void {
    val xs = digits()
    val s = xs.as_slice()
    assert_eq(s[3], 4, "element 3 of the array")
}

@test
fun a_slice_range_starts_where_asked(): void {
    val xs = digits()
    val s = xs.as_slice().slice(1..4)
    assert_eq(s[0], 2, "the range starts at element 1")
}

@test
fun a_slice_range_is_half_open(): void {
    val xs = digits()
    assert_eq(xs.as_slice().slice(1..4).size(), 3, "`1..4` holds three")
}

@test
fun an_inclusive_slice_range_holds_its_end(): void {
    val xs = digits()
    assert_eq(xs.as_slice().slice(1..=4).size(), 4, "`1..=4` holds four")
}

@test
fun an_empty_slice_range_is_empty(): void {
    val xs = digits()
    assert(xs.as_slice().slice(5..5).is_empty(), "`5..5` holds none")
}

@test
fun a_slice_iterates_in_order(): void {
    val xs = digits()
    var seen = 0
    while x in &xs.as_slice() { seen = seen * 10 + x }
    assert_eq(seen, 12345, "first to last")
}

@test
fun a_mutable_slice_writes_through(): void {
    var xs = digits()
    val s = xs.as_slice_mut()
    s.set(0, 9)
    assert_eq(xs[0], 9, "the array sees the store")
}

@test
fun a_mutable_slice_swaps_elements(): void {
    var xs = digits()
    val s = xs.as_slice_mut()
    s.swap(0, 4)
    assert_eq(xs[0] * 10 + xs[4], 51, "the ends exchanged")
}

@test
fun a_narrowed_mutable_slice_writes_into_its_range(): void {
    var xs = digits()
    var s = xs.as_slice_mut()
    var tail = s.slice_mut(3..5)
    tail[0] = 7
    assert_eq(xs[3], 7, "element 0 of the tail is element 3")
}

@test
fun a_mutable_slice_lends_a_shared_one(): void {
    var xs = digits()
    val s = xs.as_slice_mut()
    assert_eq(s.as_slice().size(), 5, "the same elements")
}
