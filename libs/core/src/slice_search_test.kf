import core.assert.*

fun odds(): int32[5] { return [1, 3, 5, 7, 9] }

@test
fun binary_search_finds_a_present_element(): void {
    val xs = odds()
    assert_eq(xs.binary_search(&7).unwrap(), 3, "7 is at 3")
}

@test
fun binary_search_names_where_a_missing_element_goes(): void {
    val xs = odds()
    val at = when (xs.binary_search(&4)) {
        Ok(_) => 99
        Err(place) => place
    }
    assert_eq(at, 2, "4 goes between 3 and 5")
}

@test
fun binary_search_by_reads_the_callable(): void {
    val xs = odds()
    assert_eq(xs.binary_search_by(|x: &int32| x.compare(&9)).unwrap(), 4, "9 is last")
}

@test
fun contains_sees_a_member(): void {
    assert(odds().contains(&5), "5 is odd")
}

@test
fun contains_misses_a_stranger(): void {
    assert(!odds().contains(&4), "4 is not")
}

@test
fun last_index_of_takes_the_last(): void {
    val xs: int32[4] = [2, 1, 2, 1]
    assert_eq(xs.last_index_of(&2)!!, 2, "the second 2")
}

@test
fun starts_with_its_first_elements(): void {
    assert(odds().starts_with([1, 3]), "1, 3 lead")
}

@test
fun ends_with_rejects_another_tail(): void {
    assert(!odds().ends_with([7]), "9 ends it")
}

@test
fun min_is_a_copy_of_the_smallest(): void {
    val xs: int32[4] = [4, 2, 8, 6]
    assert_eq(xs.min()!!, 2, "2 is smallest")
}

@test
fun max_of_an_empty_slice_is_null(): void {
    val xs = odds()
    assert(xs.as_slice().slice(2..2).max() == null, "nothing to compare")
}

@test
fun max_by_key_takes_the_first_largest_key(): void {
    val xs: int32[4] = [12, 7, 22, 17]
    assert_eq(xs.max_by_key(|x: &int32| *x % 10)!!, 7, "7 and 17 tie; 7 comes first")
}

@test
fun last_is_a_copy_of_the_last(): void {
    assert_eq(odds().last()!!, 9, "9 ends it")
}
