// The test program's entry point. The generated main hands it every test of
// the crate, and the hosted runtime runs each in a child process.

extern "C" fun kf_test_report(passed: int32, failed: int32): void
extern "C" fun kf_test_queue(name: str): void
extern "C" fun kf_test_run_queued(): int32
extern "C" fun kf_test_queued_count(): int32

/// `--run-test <name>` runs that one test in this process. Otherwise each
/// test whose name contains `--filter <substring>` runs in its own child, and
/// the report follows. Returns the program's exit code.
pub fun run_tests<A>(tests: &AnnotatedFunction<A, () -> void>[]): int32 {
    val one = flag_value("--run-test")
    if one.byte_len() > 0 { return run_one(tests, one) }
    val filter = flag_value("--filter")
    print(&"running ")
    print(&tests.size())
    println(&" tests")
    while test in tests {
        if test.name.contains(filter) { queue_test(test.name) }
    }
    return run_queued(filter)
}

/// CONSTRAINT: the runtime is reached only from non-generic functions, which
/// core compiles; an instance of `run_tests` lives in the test's crate.
fun queue_test(name: str): void {
    unsafe { kf_test_queue(name) }
}

/// Runs what was queued, prints the report and returns the exit code.
fun run_queued(filter: str): int32 {
    val failed = unsafe { kf_test_run_queued() }
    val ran = unsafe { kf_test_queued_count() } - failed
    println(&"")
    if filter.byte_len() > 0 && ran == 0 && failed == 0 {
        println(&"test result: FAILED — the filter matched no test")
        return 1
    }
    unsafe { kf_test_report(ran, failed) }
    return if failed > 0 { 1 } else { 0 }
}

/// The child's half: the parent reads the exit code.
fun run_one<A>(tests: &AnnotatedFunction<A, () -> void>[], name: str): int32 {
    while test in tests {
        if test.name == name {
            test.function()
            return 0
        }
    }
    println(&"test result: FAILED — no such test")
    return 1
}

/// The argument after `flag`, or `""`.
fun flag_value(flag: str): str {
    while i in 0..arg_count() {
        if arg_at(i) == flag { return arg_at(i + 1) }
    }
    return ""
}
