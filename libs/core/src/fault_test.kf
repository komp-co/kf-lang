import core.assert.*

@test
fun an_index_fault_names_the_index_and_the_length(): void {
    val f = Fault.IndexOutOfBounds(5, 3)
    assert_eq(renders_as(&f, "index 5 out of bounds for length 3"), true, "index and length")
}

@test
fun an_index_fault_has_its_code(): void {
    assert_eq(Fault.IndexOutOfBounds(5, 3).code(), "index_out_of_bounds", "the code")
}

@test
fun a_range_fault_names_both_ends(): void {
    val f = Fault.RangeOutOfBounds(2, 7, 3)
    assert_eq(renders_as(&f, "range 2..7 out of bounds for length 3"), true, "both ends")
}

@test
fun a_length_mismatch_names_what_was_found_first(): void {
    val f = Fault.LengthMismatch(4, 2)
    assert_eq(renders_as(&f, "length 2 where 4 was wanted"), true, "found, then wanted")
}

@test
fun an_unwrap_fault_has_its_code(): void {
    assert_eq(Fault.UnwrapNone.code(), "unwrap_none", "the code")
}

@test
fun checked_index_passes_an_index_in_range(): void {
    assert_eq(checked_index(2, 3), 2, "in range")
}

@test
fun fault_text_stops_short_of_its_capacity(): void {
    var text = new_fault_text()
    var i = 0
    while i < 30 {
        text.put("0123456789")
        i = i + 1
    }
    assert_eq(text.len, 255, "one byte is kept for the terminator")
}

@test
fun fault_text_writes_a_number_digit_by_digit(): void {
    var text = new_fault_text()
    text.put_number(1907)
    assert_eq(text.as_str(), "1907", "every digit, most significant first")
}

@test
fun fault_text_writes_zero(): void {
    var text = new_fault_text()
    text.put_number(0)
    assert_eq(text.as_str(), "0", "a lone zero")
}
