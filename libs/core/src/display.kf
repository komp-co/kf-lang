// Rendering, apart from collecting and emitting: `Display` writes into a
// `Write`; `String.of` collects and `Stdout` emits. A sink needs no heap.

/// Somewhere rendered text goes.
pub trait Write {
    mutating fun write_str(s: str): void
}

/// CONSTRAINT: the sink is `&var dyn Write`, not `<W: Write>`: a bound would
/// make `Display` unusable as `&dyn Display`, which `String.of` and `print`
/// take.
///
/// The language finds the rendering trait by key, not name.
@lang("display")
pub trait Display {
    fun display(out: &var dyn Write): void
}

extern "C" fun runtime_print(s: str): void

/// The process's standard output, as a sink.
pub struct Stdout { }

impl Write for Stdout {
    mutating fun write_str(s: str): void { runtime_print(s) }
}

/// Print any `Display` value without adding a newline.
///
/// CONSTRAINT: renders through the sink, not into a `String`, which is
/// alloc's.
@prelude
pub fun print(v: &dyn Display): void {
    var out = Stdout { }
    v.display(&var out)
}

/// Print any `Display` value followed by exactly one newline.
@prelude
pub fun println(v: &dyn Display): void {
    var out = Stdout { }
    v.display(&var out)
    runtime_print("\n")
}
