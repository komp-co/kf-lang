// A slice's sub-ranges as views of the same elements: two halves, or a lazy
// walk over runs of them.

/// A slice cut in two at one place.
pub view struct SliceSplit<T> {
    pub val left: Slice<T>
    pub val right: Slice<T>
}

/// The slice in runs of `width`, front to back; the last may be shorter.
pub view struct Chunks<T> {
    var data: Ptr<T>
    var left: uint64
    val width: uint64
}

/// Every run of `width` consecutive elements, front to back; none when the
/// slice is shorter.
pub view struct Windows<T> {
    var data: Ptr<T>
    var left: uint64
    val width: uint64
}

impl Slice<T> {
    /// `[0, at)` and `[at, size)`; `at` past the length panics.
    pub fun split_at(at: uint64): SliceSplit<T> {
        if at > self.len { panic_with(Fault.PositionOutOfBounds(at, self.len)) }
        val left = unsafe { Slice.from_raw<T>(self.data, at) }
        val right = unsafe { Slice.from_raw<T>(self.data + at, self.len - at) }
        return SliceSplit<T> { left: left, right: right }
    }

    /// A width of zero panics.
    pub fun chunks(width: uint64): Chunks<T> {
        if width == 0 { panic_with(Fault.ZeroWidth) }
        return Chunks<T> { data: self.data, left: self.len, width: width }
    }

    /// A width of zero panics.
    pub fun windows(width: uint64): Windows<T> {
        if width == 0 { panic_with(Fault.ZeroWidth) }
        return Windows<T> { data: self.data, left: self.len, width: width }
    }
}

impl<T> Iterator<Slice<T>> for Chunks<T> {
    mutating fun next(): Slice<T>? {
        if self.left == 0 { return null }
        val n = if self.left < self.width { self.left } else { self.width }
        val run = unsafe { Slice.from_raw<T>(self.data, n) }
        self.data = self.data + n
        self.left = self.left - n
        return run
    }
}

impl<T> Iterable<Slice<T>> for Chunks<T> {
    type Iter = Chunks<T>
    fun iter(): Chunks<T> {
        return Chunks<T> { data: self.data, left: self.left, width: self.width }
    }
}

impl<T> Iterator<Slice<T>> for Windows<T> {
    mutating fun next(): Slice<T>? {
        if self.left < self.width { return null }
        val run = unsafe { Slice.from_raw<T>(self.data, self.width) }
        self.data = self.data + 1
        self.left = self.left - 1
        return run
    }
}

impl<T> Iterable<Slice<T>> for Windows<T> {
    type Iter = Windows<T>
    fun iter(): Windows<T> {
        return Windows<T> { data: self.data, left: self.left, width: self.width }
    }
}
