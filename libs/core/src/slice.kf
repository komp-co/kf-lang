// `Slice<T>`, written `&T[]`: a shared view of elements laid out in a row,
// with its length known at run time.

/// Borrows what it views, as `&T` does: an array or a list lends itself as
/// one, and it cannot outlive its source. Copy, like a shared borrow.
@lang("slice")
pub view struct Slice<T> {
    val data: Ptr<T>
    val len: uint64
}

impl<T> Slice<T> {
    pub fun size(): uint64 { return self.len }

    pub fun is_empty(): bool { return self.len == 0 }

    /// A shared borrow of element `i`; out of range panics.
    pub fun at(i: uint64): &T {
        return unsafe { &*(self.data + checked_index(i, self.len)) }
    }

    /// The elements in `range`, viewing the same source; a range past the
    /// end, or not ascending by one, panics.
    pub fun slice(range: Range<uint64>): Slice<T> {
        val bounds = slice_bounds(range, self.len)
        return Slice<T> { data: self.data + bounds.start, len: bounds.end - bounds.start }
    }

    /// A cursor over the elements, valid while the source is.
    pub fun iter(): ArrayIter<T> {
        return ArrayIter<T> { data: self.data, len: self.len, index: 0 }
    }

    /// The first element's address.
    pub unsafe fun as_ptr(): Ptr<T> { return self.data }

    /// A view of `len` elements from `data`. The caller vouches that they
    /// stay alive and unmoved for as long as the view is used.
    pub unsafe static fun from_raw(data: Ptr<T>, len: uint64): Slice<T> {
        return Slice<T> { data: data, len: len }
    }
}

impl<T> Clone for Slice<T> {
    fun clone(): Slice<T> {
        return Slice<T> { data: self.data, len: self.len }
    }
}

impl<T> Copy for Slice<T> { }

impl<T> Index<uint64> for Slice<T> {
    type Out = T
    fun index(k: uint64): &Self.Out {
        return self.at(k)
    }
}

impl<T> Iterable<T> for Slice<T> {
    type Iter = ArrayIter<T>
    fun iter(): ArrayIter<T> {
        return ArrayIter<T> { data: self.data, len: self.len, index: 0 }
    }
}

/// `start..end` of a slice, as indices into a source of `len` elements.
fun slice_bounds(range: Range<uint64>, len: uint64): Range<uint64> {
    if range.descending || range.step != 1 { panic("a slice range ascends by one") }
    val end = if range.inclusive { range.end + 1 } else { range.end }
    if range.start > end || end > len { panic("slice range out of bounds") }
    return range.start..end
}
