import core.assert.assert_eq

@test fun any_finds_a_match(): void {
    assert_eq((1..5).any(|x| x == 3), true, "3 is in 1..5")
}

@test fun any_of_nothing_is_false(): void {
    assert_eq((3..3).any(|x| x == 3), false, "an empty range has no match")
}

@test fun all_holds_for_every_element(): void {
    assert_eq((1..5).all(|x| x > 0), true, "every element is positive")
}

@test fun all_fails_on_one_miss(): void {
    assert_eq((1..5).all(|x| x < 4), false, "4 is not below 4")
}

@test fun all_of_nothing_is_true(): void {
    assert_eq((3..3).all(|x| x > 100), true, "vacuously true")
}

@test fun count_counts_matches(): void {
    assert_eq((1..10).count(|x| x % 3 == 0), 3, "3, 6 and 9")
}

@test fun position_is_the_first_match_index(): void {
    assert_eq((10..20).position(|x| x % 4 == 0), 2, "12 is the third element")
}

@test fun position_without_a_match_is_null(): void {
    assert_eq((1..3).position(|x| x > 5), null, "nothing matches")
}

@test fun find_yields_the_first_match(): void {
    assert_eq((1..10).find(|x| *x > 6), 7, "7 is the first above 6")
}

@test fun fold_combines_left_to_right(): void {
    assert_eq((1..4).fold(10, |acc, x| acc - x), 4, "10 - 1 - 2 - 3")
}

@test fun contains_finds_an_equal_element(): void {
    assert_eq((1..5).contains(&4), true, "4 is in 1..5")
}

@test fun contains_misses_an_absent_element(): void {
    assert_eq((1..5).contains(&5), false, "the end is excluded")
}
