// `SliceMut<T>`, written `&var T[]`: a mutable view of elements laid out in
// a row, with its length known at run time.

/// Borrows what it views, as `&var T` does: while it is in use nothing else
/// reaches the source. Moves rather than copies; `as_slice()` lends a shared
/// view of it.
@lang("slice_mut")
pub view struct SliceMut<T> {
    val data: Ptr<T>
    val len: uint64
}

impl<T> SliceMut<T> {
    pub fun size(): uint64 { return self.len }

    pub fun is_empty(): bool { return self.len == 0 }

    /// A shared borrow of element `i`; out of range panics.
    pub fun at(i: uint64): &T {
        return unsafe { &*(self.data + checked_index(i, self.len)) }
    }

    /// A mutable borrow of element `i`; out of range panics.
    pub fun at_mut(i: uint64): &var T {
        return unsafe { &var *(self.data + checked_index(i, self.len)) }
    }

    /// Drops element `i` and moves `item` in; out of range panics.
    pub fun set(i: uint64, item: T): void {
        val p = self.data + checked_index(i, self.len)
        unsafe { drop_in_place<T>(p) }
        unsafe { *p = item }
    }

    /// Exchanges elements `i` and `j`; out of range panics.
    pub fun swap(i: uint64, j: uint64): void {
        val a = self.data + checked_index(i, self.len)
        val b = self.data + checked_index(j, self.len)
        val held = unsafe { ptr_read<T>(a) }
        unsafe { *a = ptr_read<T>(b) }
        unsafe { *b = held }
    }

    /// The elements in `range`, mutably; a range past the end, or not
    /// ascending by one, panics.
    pub mutating fun slice_mut(range: Range<uint64>): SliceMut<T> {
        val bounds = slice_bounds(range, self.len)
        return SliceMut<T> { data: self.data + bounds.start, len: bounds.end - bounds.start }
    }

    /// The elements in `range`, shared.
    pub fun slice(range: Range<uint64>): Slice<T> {
        return self.as_slice().slice(range)
    }

    /// A shared view of the same elements.
    pub fun as_slice(): Slice<T> {
        return unsafe { Slice.from_raw<T>(self.data, self.len) }
    }

    /// A cursor over the elements, valid while the source is.
    pub fun iter(): ArrayIter<T> {
        return ArrayIter<T> { data: self.data, len: self.len, index: 0 }
    }

    /// The first element's address.
    pub unsafe fun as_ptr(): Ptr<T> { return self.data }

    /// A mutable view of `len` elements from `data`. The caller vouches that
    /// they stay alive and unmoved, and reached by nothing else, for as long
    /// as the view is used.
    pub unsafe static fun from_raw(data: Ptr<T>, len: uint64): SliceMut<T> {
        return SliceMut<T> { data: data, len: len }
    }
}

impl<T> Index<uint64> for SliceMut<T> {
    type Out = T
    fun index(k: uint64): &Self.Out {
        return self.at(k)
    }
}

impl<T> IndexMut<uint64> for SliceMut<T> {
    mutating fun index_mut(k: uint64): &var Self.Out {
        return self.at_mut(k)
    }
}

impl<T> Iterable<T> for SliceMut<T> {
    type Iter = ArrayIter<T>
    fun iter(): ArrayIter<T> {
        return ArrayIter<T> { data: self.data, len: self.len, index: 0 }
    }
}

/// A mutable view reads as a shared one.
impl<T> Deref for SliceMut<T> {
    type Target = Slice<T>
    fun deref(): Slice<T> { return self.as_slice() }
}
