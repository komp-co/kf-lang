import core.assert.assert_eq
import core.assert.renders_as
import core.display.assert_eq
import core.display.renders_as
import core.time.*

@test fun constructors_agree_on_a_common_unit(): void {
    assert_eq(Duration.from_seconds(1).as_nanos(), 1000000000, "seconds")
    assert_eq(Duration.from_millis(1).as_nanos(), 1000000, "millis")
    assert_eq(Duration.from_micros(1).as_nanos(), 1000, "micros")
    assert_eq(Duration.from_minutes(1).as_seconds(), 60, "minutes")
    assert_eq(Duration.from_hours(1).as_seconds(), 3600, "hours")
    assert_eq(Duration.zero().is_zero(), true, "zero")
}

// Nearly a millisecond is not one.
@test fun conversions_truncate_rather_than_round(): void {
    assert_eq(Duration.from_nanos(1999999).as_millis(), 1, "just under two")
    assert_eq(Duration.from_nanos(999999).as_millis(), 0, "just under one")
    assert_eq(Duration.from_nanos(-1999999).as_millis(), -1, "and toward zero when negative")
}

@test fun fractional_seconds(): void {
    assert_eq(Duration.from_millis(1500).as_seconds(), 1, "whole seconds truncate")
    assert_eq(Duration.from_millis(1500).as_seconds_f() == 1.5, true, "the fraction is kept")
    assert_eq(Duration.from_millis(1500).subsec_nanos(), 500000000, "leftover nanos")
}

@test fun durations_can_be_negative(): void {
    val d = Duration.from_millis(500).minus(Duration.from_seconds(2))
    assert_eq(d.as_millis(), -1500, "difference")
    assert_eq(d.is_negative(), true, "negative")
    assert_eq(d.magnitude().as_millis(), 1500, "magnitude")
    assert_eq(d.negated().as_millis(), 1500, "negated")
}

@test fun arithmetic(): void {
    assert_eq(Duration.from_seconds(1).plus(Duration.from_millis(500)).as_millis(), 1500, "plus")
    assert_eq(Duration.from_seconds(2).minus(Duration.from_seconds(1)).as_seconds(), 1, "minus")
    assert_eq(Duration.from_seconds(2).scaled(3).as_seconds(), 6, "scaled")
}

@test fun comparison_and_equality(): void {
    assert_eq(Duration.from_seconds(1).equals(Duration.from_millis(1000)), true, "equal across units")
    assert_eq(Duration.from_seconds(1).compare(Duration.from_seconds(2)), -1, "less")
    assert_eq(Duration.from_seconds(2).compare(Duration.from_seconds(1)), 1, "greater")
    assert_eq(Duration.from_seconds(1).compare(Duration.from_seconds(1)), 0, "same")
}

@test fun display_picks_a_readable_unit(): void {
    assert_eq(renders_as(&(Duration.from_seconds(2)), "2s"), true, "seconds")
    assert_eq(renders_as(&(Duration.from_millis(1500)), "1500ms"), true, "millis when seconds would lose it")
    assert_eq(renders_as(&(Duration.from_micros(250)), "250us"), true, "micros")
    assert_eq(renders_as(&(Duration.from_nanos(7)), "7ns"), true, "nanos")
    assert_eq(renders_as(&(Duration.zero()), "0s"), true, "zero")
    assert_eq(renders_as(&(Duration.from_seconds(-2)), "-2s"), true, "negative")
}
