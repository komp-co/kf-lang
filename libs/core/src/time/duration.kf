// A span of time as a signed nanosecond count, since a difference can go
// either way; about 292 years either side of zero.

import core.math.abs

val NANOS_PER_MICRO: int64 = 1000
val NANOS_PER_MILLI: int64 = 1000000
val NANOS_PER_SECOND: int64 = 1000000000
val SECONDS_PER_MINUTE: int64 = 60
val SECONDS_PER_HOUR: int64 = 3600
val SECONDS_PER_DAY: int64 = 86400

pub struct Duration {
    pub val nanos: int64
}

impl Duration {
    pub static fun from_nanos(n: int64): Duration { return Duration { nanos: n } }
    pub static fun from_micros(n: int64): Duration { return Duration { nanos: n * NANOS_PER_MICRO } }
    pub static fun from_millis(n: int64): Duration { return Duration { nanos: n * NANOS_PER_MILLI } }
    pub static fun from_seconds(n: int64): Duration { return Duration { nanos: n * NANOS_PER_SECOND } }
    pub static fun from_minutes(n: int64): Duration { return Duration { nanos: n * SECONDS_PER_MINUTE * NANOS_PER_SECOND } }
    pub static fun from_hours(n: int64): Duration { return Duration { nanos: n * SECONDS_PER_HOUR * NANOS_PER_SECOND } }
    pub static fun zero(): Duration { return Duration { nanos: 0 } }

    pub fun as_nanos(): int64 { return self.nanos }

    // Truncating toward zero: 1_999_999 ns is 1 ms.
    pub fun as_micros(): int64 { return self.nanos / NANOS_PER_MICRO }
    pub fun as_millis(): int64 { return self.nanos / NANOS_PER_MILLI }
    pub fun as_seconds(): int64 { return self.nanos / NANOS_PER_SECOND }

    /// Seconds with the fraction kept, for arithmetic that wants it.
    pub fun as_seconds_f(): float64 {
        return (self.nanos as float64) / (NANOS_PER_SECOND as float64)
    }

    /// The nanoseconds left over after the whole seconds.
    pub fun subsec_nanos(): int64 { return self.nanos % NANOS_PER_SECOND }

    pub fun plus(other: Duration): Duration { return Duration { nanos: self.nanos + other.nanos } }
    pub fun minus(other: Duration): Duration { return Duration { nanos: self.nanos - other.nanos } }
    pub fun scaled(factor: int64): Duration { return Duration { nanos: self.nanos * factor } }
    pub fun negated(): Duration { return Duration { nanos: 0 - self.nanos } }
    pub fun magnitude(): Duration { return Duration { nanos: abs(self.nanos) } }

    pub fun is_zero(): bool { return self.nanos == 0 }
    pub fun is_negative(): bool { return self.nanos < 0 }
}

impl Equal for Duration {
    fun equals(other: &Duration): bool { return self.nanos == other.nanos }
}

impl Compare for Duration {
    fun compare(other: &Duration): int32 {
        if self.nanos < other.nanos { return -1 }
        if self.nanos > other.nanos { return 1 }
        return 0
    }
}

// In the largest unit leaving a whole number, always with the unit: "1500ms",
// "2s".
impl Display for Duration {
    fun display(out: &var dyn Write): void {
        if self.nanos == 0 {
            out.write_str("0s")
            return
        }
        val n = self.nanos
        if n % NANOS_PER_SECOND == 0 {
            (n / NANOS_PER_SECOND).display(out)
            out.write_str("s")
            return
        }
        if n % NANOS_PER_MILLI == 0 {
            (n / NANOS_PER_MILLI).display(out)
            out.write_str("ms")
            return
        }
        if n % NANOS_PER_MICRO == 0 {
            (n / NANOS_PER_MICRO).display(out)
            out.write_str("us")
            return
        }
        n.display(out)
        out.write_str("ns")
    }
}
