// What a lambda implements: `|a| body` becomes a struct of its captures plus
// the trait for its arity, so a higher-order function monomorphizes per
// lambda. One trait per arity, up to 3.
pub trait Call0 {
    type Out
    fun call(): Out
}

pub trait Call1<A> {
    type Out
    fun call(a: A): Out
}

pub trait Call2<A, B> {
    type Out
    fun call(a: A, b: B): Out
}

pub trait Call3<A, B, C> {
    type Out
    fun call(a: A, b: B, c: C): Out
}

pub trait CallMut0 {
    type Out
    mutating fun call(): Out
}

pub trait CallMut1<A> {
    type Out
    mutating fun call(a: A): Out
}

pub trait CallMut2<A, B> {
    type Out
    mutating fun call(a: A, b: B): Out
}

pub trait CallMut3<A, B, C> {
    type Out
    mutating fun call(a: A, b: B, c: C): Out
}
