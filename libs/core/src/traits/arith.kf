// Arithmetic operator traits: `a + b` dispatches to `a.add(b)`, and so on.
// Each returns `Self`. Core implements them for every numeric primitive.
@lang("add")
pub trait Add {
    fun add(other: &Self): Self
}

@lang("sub")
pub trait Sub {
    fun sub(other: &Self): Self
}

@lang("mul")
pub trait Mul {
    fun mul(other: &Self): Self
}

@lang("div")
pub trait Div {
    fun div(other: &Self): Self
}

pub trait Mod {
    fun mod(other: &Self): Self
}

/// The additive identity: `x + T.zero()` is `x`. Static, so a bound reaches
/// it: `var acc = T.zero()`.
pub trait Zero {
    static fun zero(): Self
}

/// The multiplicative identity: `x * T.one()` is `x`.
pub trait One {
    static fun one(): Self
}

/// Everything a number does, as one bound. It declares nothing; implement it
/// with `impl Num for X { }` once the six are in place.
pub trait Num: Add + Sub + Mul + Div + Zero + One {
}

/// A whole number: the eight primitive integer types, and only they. Sealed,
/// so a bound on it promises a primitive integer.
pub sealed trait Integer: Num + Equal + Compare + Mod + Copy {
}
