// A type that lends its methods through a view of itself: a `String` reads as
// the `str` it holds, a list as the slice of its elements. When `x` has no
// method `m`, `x.m()` calls `m` on `x.deref()`, or on `x.deref_mut()` when
// `m` changes its receiver; an argument whose slot is the target lends the
// same way.

/// The shared view `deref` lends.
@lang("deref")
pub trait Deref {
    type Target
    fun deref(): Self.Target
}

/// The mutable view `deref_mut` lends, for a method that changes it.
@lang("deref_mut")
pub trait DerefMut {
    type TargetMut
    mutating fun deref_mut(): Self.TargetMut
}
