// What `a[i]` and `a[i] = v` mean.

/// Shared access to the element at `k`. `a[i]` is `*(a.index(i))`.
///
/// Indexing yields a borrow, never a copy. `Out` is chosen by the impl.
pub trait Index<K> {
    type Out
    fun index(k: K): &Out
}

/// Mutable access to the element at `k`, borrowed wherever `a[i]` is written
/// through: `a[i] = v`, a `mutating` method, `a[i].f = v`, and `&var a[i]`.
pub trait IndexMut<K>: Index<K> {
    mutating fun index_mut(k: K): &var Self.Out
}

/// Indexing that produces its element rather than lending it, for a sequence
/// whose elements are computed: a bit has no address to borrow. `a[i]` is
/// `a.index_value(i)` on a type implementing this and not `Index`; a type may
/// not implement both. Nothing can be written through it.
pub trait IndexValue<K> {
    type Out
    fun index_value(k: K): Out
}
