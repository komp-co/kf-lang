// Sorting in place. Elements move only through `swap`, so nothing is cloned
// or dropped and nothing is allocated.
//
// `sort`, `sort_by` and `sort_by_key` are stable: a merge sort whose merges
// rotate rather than copy, O(n log² n). `sort_unstable` is a heapsort,
// O(n log n), and may reorder equal elements.

impl<T: Compare> SliceMut<T> {
    /// Ascending by the element's `Compare`, equal elements kept in order.
    pub fun sort(): void {
        self.whole().sort_by<ByCompare<T>>(ByCompare<T> {})
    }

    /// Ascending by `Compare`, equal elements in any order.
    pub fun sort_unstable(): void {
        val n = self.len
        if n < 2 { return }
        var i: uint64 = n / 2
        while i > 0 {
            i = i - 1
            self.sift_down(i, n)
        }
        var end: uint64 = n
        while end > 1 {
            end = end - 1
            self.swap(0, end)
            self.sift_down(0, end)
        }
    }

    /// Sifts `root` down within the heap over `[0, end)`.
    fun sift_down(root: uint64, end: uint64): void {
        var at = root
        while at * 2 + 1 < end {
            val left = at * 2 + 1
            val right = left + 1
            val big = if right < end && self.at(left).compare(self.at(right)) < 0 { right } else { left }
            if self.at(at).compare(self.at(big)) >= 0 { return }
            self.swap(at, big)
            at = big
        }
    }
}

impl<T> SliceMut<T> {
    /// Ascending by `order(a, b)`, negative when `a` goes first, equal
    /// elements kept in order.
    pub fun sort_by<F: Call2<&T, &T>>(order: F): void {
        merge_sort(&self.whole(), 0, self.len, &order)
    }

    /// Ascending by the key `key` gives each element, equal keys kept in
    /// order. The key is computed at each comparison.
    pub fun sort_by_key<F: Call1<&T>>(key: F): void {
        self.whole().sort_by<ByKey<T, F>>(ByKey<T, F> { key: key })
    }

    /// The same elements, as a view the sort's functions take.
    fun whole(): SliceMut<T> {
        return unsafe { SliceMut.from_raw<T>(self.data, self.len) }
    }
}

impl<T: Compare> Slice<T> {
    /// Each element no greater than the next. O(n).
    pub fun is_sorted(): bool {
        if self.len < 2 { return true }
        while i in 1..self.len {
            if self.at(i - 1).compare(self.at(i)) > 0 { return false }
        }
        return true
    }
}

fun merge_sort<T, F: Call2<&T, &T>>(s: &SliceMut<T>, lo: uint64, hi: uint64, order: &F): void {
    if hi - lo <= 12 {
        insertion_sort(s, lo, hi, order)
        return
    }
    val mid = lo + (hi - lo) / 2
    merge_sort(s, lo, mid, order)
    merge_sort(s, mid, hi, order)
    val c: int32 = order.call(s.at(mid - 1), s.at(mid))
    if c > 0 { merge(s, lo, mid, hi, order) }
}

fun insertion_sort<T, F: Call2<&T, &T>>(s: &SliceMut<T>, lo: uint64, hi: uint64, order: &F): void {
    if hi - lo < 2 { return }
    while i in lo + 1..hi {
        var j = i
        while j > lo {
            val c: int32 = order.call(s.at(j - 1), s.at(j))
            if c <= 0 { break }
            s.swap(j - 1, j)
            j = j - 1
        }
    }
}

/// Merges the sorted runs `[lo, mid)` and `[mid, hi)`: the longer run is cut
/// in half, the other at the matching place, the middle parts exchanged by a
/// rotation, and each side merged again.
fun merge<T, F: Call2<&T, &T>>(s: &SliceMut<T>, lo: uint64, mid: uint64, hi: uint64, order: &F): void {
    if lo == mid || mid == hi { return }
    if hi - lo == 2 {
        val c: int32 = order.call(s.at(lo), s.at(mid))
        if c > 0 { s.swap(lo, mid) }
        return
    }
    var left_cut = lo
    var right_cut = mid
    if mid - lo > hi - mid {
        left_cut = lo + (mid - lo) / 2
        right_cut = first_not_before(s, mid, hi, left_cut, order)
    } else {
        right_cut = mid + (hi - mid) / 2
        left_cut = first_after(s, lo, mid, right_cut, order)
    }
    s.rotate_range(left_cut, mid, right_cut)
    val new_mid = left_cut + (right_cut - mid)
    merge(s, lo, left_cut, new_mid, order)
    merge(s, new_mid, right_cut, hi, order)
}

/// The first index in `[lo, hi)` whose element does not go before element
/// `pivot`.
fun first_not_before<T, F: Call2<&T, &T>>(s: &SliceMut<T>, lo: uint64, hi: uint64, pivot: uint64, order: &F): uint64 {
    var low = lo
    var high = hi
    while low < high {
        val probe = low + (high - low) / 2
        val c: int32 = order.call(s.at(probe), s.at(pivot))
        if c < 0 { low = probe + 1 } else { high = probe }
    }
    return low
}

/// The first index in `[lo, hi)` whose element goes after element `pivot`.
fun first_after<T, F: Call2<&T, &T>>(s: &SliceMut<T>, lo: uint64, hi: uint64, pivot: uint64, order: &F): uint64 {
    var low = lo
    var high = hi
    while low < high {
        val probe = low + (high - low) / 2
        val c: int32 = order.call(s.at(probe), s.at(pivot))
        if c <= 0 { low = probe + 1 } else { high = probe }
    }
    return low
}

/// `a.compare(b)`, for keys whose type the compiler learns from a callable.
fun compare_keys<K: Compare>(a: &K, b: &K): int32 {
    return a.compare(b)
}

/// The order `Compare` gives.
struct ByCompare<T> {
}

impl<T: Compare> Call2<&T, &T> for ByCompare<T> {
    type Out = int32
    fun call(a: &T, b: &T): int32 { return a.compare(b) }
}

/// The order of the keys `key` gives.
struct ByKey<T, F> {
    val key: F
}

impl<T, F: Call1<&T>> Call2<&T, &T> for ByKey<T, F> {
    type Out = int32
    fun call(a: &T, b: &T): int32 { return compare_keys(&self.key.call(a), &self.key.call(b)) }
}
