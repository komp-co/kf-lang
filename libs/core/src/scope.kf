// Kotlin's scope functions, as extensions on every type. Each borrows its
// receiver, so none copies it.

/// `f` applied to the receiver: `xs.let(|v| v.size() * 2)`.
@prelude
pub fun T.let<F: Call1<&T>>(f: F): F.Out {
    return f(self)
}

/// Runs `f` on the receiver for its effect, then hands the receiver back:
/// `list.also(|v| log(v.size()))`.
@prelude
pub fun T.also<F: Call1<&T>>(f: F): &T {
    f(self)
    return self
}

/// Runs `f` with the receiver mutably borrowed, then hands it back:
/// `config.apply(|c| { c.verbose = true })`.
@prelude
pub mutating fun T.apply<F: Call1<&var T>>(f: F): &T {
    f(self)
    return self
}

/// A copy of the receiver when `keep` accepts it, else `None`.
@prelude
pub fun <T: Clone> T.take_if<F: Call1<&T>>(keep: F): T? {
    if keep(self) { return self.clone() }
    return null
}

/// A copy of the receiver when `reject` refuses it, else `None`.
@prelude
pub fun <T: Clone> T.take_unless<F: Call1<&T>>(reject: F): T? {
    if reject(self) { return null }
    return self.clone()
}
