// Rearranging a mutable slice in place: elements move only through `swap`.

impl SliceMut<T> {
    /// Last element first.
    pub fun reverse(): void {
        self.reverse_range(0, self.len)
    }

    /// Moves every element `k` places towards the front, the first `k`
    /// wrapping round to the end. `k` past the length panics.
    pub fun rotate_left(k: uint64): void {
        if k > self.len { panic("rotate_left past the slice's length") }
        self.rotate_range(0, k, self.len)
    }

    /// Moves every element `k` places towards the back, the last `k` wrapping
    /// round to the front. `k` past the length panics.
    pub fun rotate_right(k: uint64): void {
        if k > self.len { panic("rotate_right past the slice's length") }
        self.rotate_range(0, self.len - k, self.len)
    }

    fun reverse_range(lo: uint64, hi: uint64): void {
        var low = lo
        var high = hi
        while low + 1 < high {
            high = high - 1
            self.swap(low, high)
            low = low + 1
        }
    }

    /// Exchanges `[lo, mid)` with `[mid, hi)`, each keeping its order.
    fun rotate_range(lo: uint64, mid: uint64, hi: uint64): void {
        if lo == mid || mid == hi { return }
        self.reverse_range(lo, mid)
        self.reverse_range(mid, hi)
        self.reverse_range(lo, hi)
    }
}

impl SliceMut<T: Clone> {
    /// Every element replaced by a copy of `item`.
    pub fun fill(item: T): void {
        while i in 0..self.len { self.set(i, item.clone()) }
    }

    /// Every element replaced by a copy of the one at the same place in
    /// `source`; a `source` of another length panics.
    pub fun copy_from(source: Slice<T>): void {
        if source.size() != self.len { panic("copy_from a slice of another length") }
        while i in 0..self.len { self.set(i, source.at(i).clone()) }
    }
}
