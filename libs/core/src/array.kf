// `Array<T, N>`, written `T[N]`: N elements held inline, with no allocation.

/// The compiler lays it out as `T items[N]` and builds it from a literal:
/// `val xs: int32[3] = [1, 2, 3]`. Copy when `T` is; otherwise it moves, and
/// dropping it drops each element.
@lang("array")
pub struct Array<T, N: uint64> {
}

impl<T, N: uint64> Array<T, N> {
    pub fun size(): uint64 { return N }

    /// A shared borrow of element `i`; out of range panics.
    pub fun at(i: uint64): &T {
        return unsafe { &*(self.items() + checked_index(i, N)) }
    }

    /// A mutable borrow of element `i`; out of range panics.
    pub mutating fun at_mut(i: uint64): &var T {
        return unsafe { &var *(self.items() + checked_index(i, N)) }
    }

    /// A cursor over the elements, valid while the array is alive and unmoved.
    pub fun iter(): ArrayIter<T> {
        return ArrayIter<T> { data: self.items(), len: N, index: 0 }
    }

    /// A shared view of every element, borrowing the array.
    pub fun as_slice(): Slice<T> {
        return unsafe { Slice.from_raw<T>(self.items(), N) }
    }

    /// A mutable view of every element, borrowing the array.
    pub mutating fun as_slice_mut(): SliceMut<T> {
        return unsafe { SliceMut.from_raw<T>(self.items(), N) }
    }

    /// The first element's address: the array is its elements.
    fun items(): Ptr<T> {
        return unsafe { (&self) as Ptr<T> }
    }
}

fun checked_index(i: uint64, n: uint64): uint64 {
    if i >= n { panic("array index out of bounds") }
    return i
}

/// Each element cloned into a new array.
impl<T: Clone, N: uint64> Clone for Array<T, N> {
    fun clone(): Array<T, N> {
        var out = Array<T, N> {}
        while i in 0..N {
            // A raw store: the zeroed slot holds nothing to drop.
            unsafe { *(out.items() + i) = clone_place<T>(self.items() + i) }
        }
        return out
    }
}

/// An array of `Copy` elements copies with them.
impl<T: Copy, N: uint64> Copy for Array<T, N> { }

impl<T, N: uint64> Index<uint64> for Array<T, N> {
    type Out = T
    fun index(k: uint64): &Self.Out {
        return self.at(k)
    }
}

impl<T, N: uint64> IndexMut<uint64> for Array<T, N> {
    mutating fun index_mut(k: uint64): &var Self.Out {
        return self.at_mut(k)
    }
}

impl<T, N: uint64> Iterable<T> for Array<T, N> {
    type Iter = ArrayIter<T>
    fun iter(): ArrayIter<T> {
        return ArrayIter<T> { data: self.items(), len: N, index: 0 }
    }
}

/// A forward cursor over an array's elements. Not owning: valid only while
/// the array is alive and unmoved.
pub struct ArrayIter<T> {
    var data: Ptr<T>
    var len: uint64
    var index: uint64
}

impl ArrayIter<T> {
    /// The next element's address, or null once exhausted; what
    /// `while x in &xs` desugars against.
    pub mutating fun next_ptr(): Ptr<T> {
        if self.index >= self.len { return ptr_null<T>() }
        val p: Ptr<T> = self.data + self.index
        self.index = self.index + 1
        return p
    }
}

impl Iterator<T> for ArrayIter<T> {
    /// An owned copy of the next element, deep for one that owns heap.
    mutating fun next(): T? {
        if self.index >= self.len { return null }
        val item: T = unsafe { clone_place<T>(self.data + self.index) }
        self.index = self.index + 1
        return item
    }
}

/// Its own cursor, so `while x in xs.iter()` works.
impl Iterable<T> for ArrayIter<T> {
    type Iter = ArrayIter<T>
    fun iter(): ArrayIter<T> {
        return ArrayIter<T> { data: self.data, len: self.len, index: self.index }
    }
}
