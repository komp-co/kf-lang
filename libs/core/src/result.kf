import core.panic.*

// For operations that can return a typed error.
pub enum Result<T, E> {
    Ok(T)
    Err(E)
}

// The predicates match `Ok` without a binder: `Result<void, E>.Ok` carries
// nothing.
impl Result<T, E> {
    pub fun is_ok(): bool {
        return when (self) {
            Ok => true
            Err(_e) => false
        }
    }

    pub fun is_err(): bool {
        return when (self) {
            Ok => false
            Err(_e) => true
        }
    }

    /// The success payload, or a controlled abort on an `Err`, whose message
    /// omits the error.
    pub fun unwrap(): T {
        when (self) {
            Ok(v) => { return v }
            Err(_e) => {}
        }
        panic_with(Fault.UnwrapErr)
    }

    /// The error, or a controlled abort; what `Try.branch` reads the bail out
    /// of. Copies out of the borrowed `self`.
    pub fun unwrap_err(): E {
        when (self) {
            Ok(_v) => {}
            Err(e) => { return e }
        }
        panic_with(Fault.UnwrapOk)
    }

    /// The success payload, or `default` on an `Err`.
    pub fun unwrap_or(default: T): T {
        when (self) {
            Ok(v) => { return v }
            Err(_e) => {}
        }
        return default
    }

    /// The success payload, or what `f` makes of the error; `f` runs only on
    /// an `Err`.
    pub fun unwrap_or_else<F: Call1<E>>(f: F): T {
        when (self) {
            Ok(v) => { return v }
            Err(e) => { return f.call(e) }
        }
        return self.unwrap()
    }

    /// `f` applied to the success payload; an `Err` passes through.
    pub fun map<F: Call1<T>>(f: F): Result<F.Out, E> {
        when (self) {
            Ok(v) => { return Result.Ok<F.Out, E>(f.call(v)) }
            Err(e) => { return Result.Err<F.Out, E>(e) }
        }
        return Result.Err<F.Out, E>(self.unwrap_err())
    }

    /// `f` applied to the error; an `Ok` passes through.
    pub fun map_err<F: Call1<E>>(f: F): Result<T, F.Out> {
        when (self) {
            Ok(v) => { return Result.Ok<T, F.Out>(v) }
            Err(e) => { return Result.Err<T, F.Out>(f.call(e)) }
        }
        return Result.Ok<T, F.Out>(self.unwrap())
    }

    /// `f`, itself returning a `Result` with this error type, applied to the
    /// success payload; an `Err` passes through.
    pub fun and_then<F: Call1<T>>(f: F): F.Out {
        when (self) {
            Ok(v) => { return f.call(v) }
            Err(e) => { return residual_as<F.Out, Result<Never, E>>(Result.Err<Never, E>(e)) }
        }
        return f.call(self.unwrap())
    }

    /// `f`, itself returning a `Result` with this success type, applied to
    /// the error; an `Ok` passes through.
    pub fun or_else<F: Call1<E>>(f: F): F.Out {
        when (self) {
            Ok(v) => { return output_as<F.Out, T>(v) }
            Err(e) => { return f.call(e) }
        }
        return f.call(self.unwrap_err())
    }

    /// The success payload, dropping the error.
    pub fun ok(): Option<T> {
        when (self) {
            Ok(v) => { return Option.Some<T>(v) }
            Err(_e) => {}
        }
        return Option.None<T>()
    }

    /// The error, dropping the success payload.
    pub fun err(): Option<E> {
        when (self) {
            Ok(_v) => {}
            Err(e) => { return Option.Some<E>(e) }
        }
        return Option.None<E>()
    }
}

// Comparable when both arms are. No `Default`: neither `Ok` nor `Err` is a
// defensible one.

impl Equal for Result<T: Equal, E: Equal> {
    fun equals(other: &Result<T, E>): bool {
        when (self) {
            Ok(a) => {
                when (other) {
                    Ok(b) => { return a == b }
                    Err(_e) => { return false }
                }
            }
            Err(a) => {
                when (other) {
                    Ok(_b) => { return false }
                    Err(b) => { return a == b }
                }
            }
        }
        return false
    }
}

impl Copy for Result<T: Copy, E: Copy> { }

impl Clone for Result<T: Clone, E: Clone> {
    fun clone(): Result<T, E> {
        when (self) {
            Ok(v) => { return Result.Ok<T, E>(v.clone()) }
            Err(e) => { return Result.Err<T, E>(e.clone()) }
        }
        return Result.Err<T, E>(self.unwrap_err())
    }
}

// The error side is mixed again, so the arms do not collide.
impl Hash for Result<T: Hash, E: Hash> {
    fun hash(): uint64 {
        when (self) {
            Ok(v) => { return mix_uint64(v.hash()) }
            Err(e) => { return mix_uint64(mix_uint64(e.hash())) }
        }
        return 0
    }
}

impl Try for Result<T, E> {
    type Output = T
    type Residual = Result<Never, E>

    fun branch(): Branch<T, Result<Never, E>> {
        if self.is_err() {
            val err: E = self.unwrap_err()
            val residual: Result<Never, E> = Result.Err<Never, E>(err)
            return Branch.Break<T, Result<Never, E>>(residual)
        }
        val payload: T = self.unwrap()
        return Branch.Continue<T, Result<Never, E>>(payload)
    }

    static fun from_output(o: T): Result<T, E> {
        return Result.Ok<T, E>(o)
    }
}

impl FromResidual<Result<Never, E>> for Result<T, E> {
    // Carries the error across to a different success type.
    static fun from_residual(r: Result<Never, E>): Result<T, E> {
        when (r) {
            Ok => { }
            Err(e) => { return Result.Err<T, E>(e) }
        }
        // Unreachable, but the checker does not reason about `Never`.
        unsafe { panic("a Result residual cannot be Ok: Never is uninhabited") }
    }
}
