import core.assert.*
import core.option.*

@test
fun option_some_is_some(): void {
    val a: int32? = Option.Some(5)
    assert_eq(a.is_some(), true, "Some is_some")
    assert_eq(a.is_none(), false, "Some is not none")
}

@test
fun option_none_is_none(): void {
    val a: int32? = null
    assert_eq(a.is_none(), true, "None is_none")
    assert_eq(a.is_some(), false, "None is not some")
}

// A second element type must not collide with the first.
struct OptTestPoint { pub val x: int32 }

@test
fun option_predicates_monomorphize_per_element_type(): void {
    val p: OptTestPoint? = Option.Some(OptTestPoint { x: 7 })
    val q: OptTestPoint? = null
    assert_eq(p.is_some(), true, "struct payload is_some")
    assert_eq(q.is_none(), true, "struct payload is_none")
}

// Guard, bail, then use the value.
fun opt_test_lookup(found: bool): int32? {
    if found { return 42 }
    return null
}

@test
fun option_predicates_guard_a_returned_optional(): void {
    assert_eq(opt_test_lookup(true).is_some(), true, "hit is_some")
    assert_eq(opt_test_lookup(false).is_none(), true, "miss is_none")
}

// The `None` abort is exercised by a driver case, not here.
@test
fun option_unwrap_returns_the_payload(): void {
    val a: int32? = Option.Some(5)
    assert_eq(a.unwrap(), 5, "unwrap hands back what Some holds")
}

@test
fun option_unwrap_monomorphizes_per_payload_type(): void {
    val p: OptTestPoint? = Option.Some(OptTestPoint { x: 7 })
    assert_eq(p.unwrap().x, 7, "struct payload comes back whole")
}
