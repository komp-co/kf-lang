// Raw pointers at the C boundary.
//
// LIMITATION: komp's own unity bootstrap cannot use these: an inferred
// generic argument at a user type reaches codegen as `crate::module::Name`.

import core.option.*

/// The null pointer for a `T`.
@prelude
pub fun ptr_null<T>(): Ptr<T> {
    return unsafe { 0 as Ptr<T> }
}

/// C's `p == NULL`.
@prelude
pub fun ptr_is_null<T>(p: Ptr<T>): bool {
    return unsafe { p as uint64 } == 0
}

/// Null becomes `None`, anything else `Some`.
///
/// Use this for every fallible C call: `Option` has no niche, so a pointer
/// assigned into `Ptr<T>?` wraps null as `Some(null)`.
@prelude
pub fun ptr_as_option<T>(p: Ptr<T>): Ptr<T>? {
    if ptr_is_null(p) { return null }
    return Option.Some(p)
}
