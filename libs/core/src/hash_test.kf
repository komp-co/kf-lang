// Equal values must hash equally; unequal ones should differ enough to catch
// an impl ignoring its input.

import core.assert.*
import core.hash.*

@test
fun equal_values_hash_equally(): void {
    assert_eq((7).hash() == (7).hash(), true, "int32")
    assert_eq("abc".hash() == "abc".hash(), true, "str")
    assert_eq(true.hash() == true.hash(), true, "bool")
}

@test
fun different_values_do_not_collide(): void {
    assert_eq((7).hash() == (8).hash(), false, "int32")
    assert_eq("abc".hash() == "abd".hash(), false, "str")
    assert_eq(true.hash() == false.hash(), false, "bool")
}

// Consecutive keys must not stay consecutive under `hash % n`.
@test
fun consecutive_integers_are_scattered(): void {
    assert_eq((0).hash() == 0, false, "0 does not hash to itself")
    assert_eq((1).hash() == 1, false, "1 does not hash to itself")
    val a = (1).hash() % 8
    val b = (2).hash() % 8
    val c = (3).hash() % 8
    assert_eq(a == 1 && b == 2 && c == 3, false, "buckets are not the keys")
}

// `true` and `false` must not be 1 and 0.
@test
fun booleans_are_mixed_not_zero_and_one(): void {
    assert_eq(false.hash() == 0, false, "false")
    assert_eq(true.hash() == 1, false, "true")
}

@test
fun the_empty_string_hashes(): void {
    assert_eq("".hash() == "".hash(), true, "empty agrees")
    assert_eq("".hash() == "a".hash(), false, "empty differs from non-empty")
}

// -0.0 == 0.0, so they hash equally though their sign bits differ.
@test
fun negative_zero_hashes_as_zero(): void {
    val neg: float64 = 0.0 - 0.0
    val pos: float64 = 0.0
    assert_eq(neg == pos, true, "IEEE says the two zeros are equal")
    assert_eq(neg.hash() == pos.hash(), true, "so they must hash equally")
    val neg32: float32 = (0.0 - 0.0) as float32
    val pos32: float32 = 0.0
    assert_eq(neg32.hash() == pos32.hash(), true, "float32 likewise")
}

@test
fun equal_floats_hash_equally(): void {
    assert_eq((1.5).hash() == (1.5).hash(), true, "float64")
    val a: float32 = 2.25
    val b: float32 = 2.25
    assert_eq(a.hash() == b.hash(), true, "float32")
}

@test
fun different_floats_hash_differently(): void {
    assert_eq((1.5).hash() == (2.5).hash(), false, "float64 distinguishes")
    val a: float32 = 1.5
    val b: float32 = 2.5
    assert_eq(a.hash() == b.hash(), false, "float32 distinguishes")
}

// A zero hash for a non-zero input means the mixer dropped it.
@test
fun a_float_does_not_hash_to_zero(): void {
    assert_eq((0.0).hash() == 0, false, "0.0 still mixes to something")
    assert_eq((1.0).hash() == 0, false, "1.0 mixes to something")
}

// @derive(Hash) over float fields.
@derive(Hash)
pub struct HashTestPoint {
    pub val x: float64
    pub val y: float64
}

@test
fun derive_hash_works_over_float_fields(): void {
    val a = HashTestPoint { x: 1.0, y: 2.0 }
    val b = HashTestPoint { x: 1.0, y: 2.0 }
    val c = HashTestPoint { x: 2.0, y: 1.0 }
    assert_eq(a.hash() == b.hash(), true, "equal points hash equally")
    assert_eq(a.hash() == c.hash(), false, "the field order is not lost")
}
