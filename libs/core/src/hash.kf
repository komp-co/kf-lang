// Hashing for keyed containers.
//
//   - equal values MUST hash equally: `a == b` implies `a.hash() == b.hash()`
//   - unequal values SHOULD hash differently, but need not
//
// Inconsistent `Hash` and `Equal` make lookups miss. Freestanding.

@lang("hash")
pub trait Hash {
    fun hash(): uint64
}

extern "C" fun kf_str_byte_len(s: str): uint64
extern "C" fun kf_str_byte_at(s: str, i: uint64): uint8

/// Murmur3's 64-bit finalizer over a golden-ratio-shifted input, so
/// sequential keys land far apart under `hash % n`.
@prelude
pub fun mix_uint64(value: uint64): uint64 {
    // The finalizer alone maps 0 to 0.
    var x = value + 0x9e3779b97f4a7c15
    x = x ^ (x >> 33)
    x = x * 0xff51afd7ed558ccd
    x = x ^ (x >> 33)
    x = x * 0xc4ceb9fe1a85ec53
    x = x ^ (x >> 33)
    return x
}

/// FNV-1a over the bytes of `s`: no allocation, no libc, and `str` and
/// `String` agree.
@prelude
pub fun hash_bytes(s: str): uint64 {
    var h: uint64 = 0xcbf29ce484222325
    val n = unsafe { kf_str_byte_len(s) }
    var i = 0
    while i < n {
        h = h ^ (unsafe { kf_str_byte_at(s, i) } as uint64)
        h = h * 0x100000001b3
        i = i + 1
    }
    return h
}
