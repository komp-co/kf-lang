import core.assert.*

/// Sorted by `key`, with `tag` recording where each started.
struct Tagged {
    val key: int32
    val tag: int32
}

fun shuffled(): int32[9] { return [5, 3, 9, 1, 3, 8, 2, 7, 0] }

@test
fun sort_puts_an_array_in_ascending_order(): void {
    var xs = shuffled()
    xs.sort()
    assert(xs.is_sorted(), "every element is no greater than the next")
}

@test
fun sort_keeps_every_element(): void {
    var xs = shuffled()
    xs.sort()
    assert_eq(xs[0] + xs[8] * 10, 90, "the smallest first, the largest last")
}

fun tagged(key: int32, tag: int32): Tagged { return Tagged { key: key, tag: tag } }

/// Longer than one insertion-sorted run, so runs are merged.
fun many_tagged(): Tagged[16] {
    return [
        tagged(0, 0), tagged(2, 1), tagged(4, 2), tagged(1, 3),
        tagged(3, 4), tagged(0, 5), tagged(2, 6), tagged(4, 7),
        tagged(1, 8), tagged(3, 9), tagged(0, 10), tagged(2, 11),
        tagged(4, 12), tagged(1, 13), tagged(3, 14), tagged(0, 15)
    ]
}

fun stays_in_order(xs: &Tagged[]): bool {
    while i in 1..xs.size() {
        val a = xs[i - 1]
        val b = xs[i]
        if a.key > b.key || (a.key == b.key && a.tag > b.tag) { return false }
    }
    return true
}

@test
fun sort_by_key_keeps_equal_keys_in_order(): void {
    var xs = many_tagged()
    xs.sort_by_key(|t: &Tagged| t.key)
    assert(stays_in_order(xs), "ascending keys, ties in their first order")
}

@test
fun sort_by_orders_by_the_callable(): void {
    var xs = shuffled()
    xs.sort_by(|a: &int32, b: &int32| b.compare(a))
    assert_eq(xs[0], 9, "descending, so the largest first")
}

@test
fun sort_unstable_puts_an_array_in_ascending_order(): void {
    var xs = shuffled()
    xs.sort_unstable()
    assert(xs.is_sorted(), "a heapsort orders too")
}

@test
fun sort_of_an_empty_slice_does_nothing(): void {
    var xs = shuffled()
    var whole = xs.as_slice_mut()
    whole.slice_mut(4..4).sort()
    assert_eq(xs[4], 3, "nothing to order, nothing moved")
}

@test
fun is_sorted_sees_one_element_out_of_place(): void {
    val xs: int32[4] = [1, 2, 4, 3]
    assert(!xs.is_sorted(), "4 before 3")
}
