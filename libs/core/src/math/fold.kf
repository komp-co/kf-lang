// Folds starting from an identity: `Zero` and `One` name the value a generic
// fold cannot write as a literal.

/// Everything the iterable yields, added together; zero when it yields
/// nothing.
@prelude
pub fun <T: Add + Zero> Iterable<T>.sum(): T {
    var total = T.zero()
    while x in self {
        total = total + x
    }
    return total
}

/// Everything the iterable yields, multiplied together; one when it yields
/// nothing.
@prelude
pub fun <T: Mul + One> Iterable<T>.product(): T {
    var total = T.one()
    while x in self {
        total = total * x
    }
    return total
}
