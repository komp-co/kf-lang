// The math needing libm: roots, powers, logarithms, trigonometry, declared
// against libm directly. Importing this module states libm is present;
// core.math does not need it.
//
// Extensions on `float64`: `(16.0).sqrt()`. Each shares its C name with the
// extern beside it; a method and an extern do not share a namespace.

import core.math.*

extern "C" fun sqrt(x: float64): float64
extern "C" fun cbrt(x: float64): float64
extern "C" fun pow(base: float64, exponent: float64): float64
extern "C" fun exp(x: float64): float64
extern "C" fun log(x: float64): float64
extern "C" fun log2(x: float64): float64
extern "C" fun log10(x: float64): float64
extern "C" fun sin(x: float64): float64
extern "C" fun cos(x: float64): float64
extern "C" fun tan(x: float64): float64
extern "C" fun asin(x: float64): float64
extern "C" fun acos(x: float64): float64
extern "C" fun atan(x: float64): float64
extern "C" fun atan2(y: float64, x: float64): float64
extern "C" fun fmod(x: float64, y: float64): float64
extern "C" fun hypot(x: float64, y: float64): float64

/// Square root. Negative input gives NaN, as it does in C.
pub fun float64.sqrt(): float64 { return unsafe { sqrt(self) } }

/// Cube root. Unlike `self.pow(1.0/3.0)` this handles negative input.
pub fun float64.cbrt(): float64 { return unsafe { cbrt(self) } }

/// `self` raised to `exponent`.
pub fun float64.pow(exponent: float64): float64 { return unsafe { pow(self, exponent) } }

/// e raised to `self`.
pub fun float64.exp(): float64 { return unsafe { exp(self) } }

/// Natural logarithm -- base e, not base 10.
pub fun float64.ln(): float64 { return unsafe { log(self) } }

pub fun float64.log2(): float64 { return unsafe { log2(self) } }
pub fun float64.log10(): float64 { return unsafe { log10(self) } }

pub fun float64.sin(): float64 { return unsafe { sin(self) } }
pub fun float64.cos(): float64 { return unsafe { cos(self) } }
pub fun float64.tan(): float64 { return unsafe { tan(self) } }
pub fun float64.asin(): float64 { return unsafe { asin(self) } }
pub fun float64.acos(): float64 { return unsafe { acos(self) } }
pub fun float64.atan(): float64 { return unsafe { atan(self) } }

/// The angle of the point (x, self) from the positive x axis, in radians,
/// with the quadrant resolved. The receiver is y: `y.atan2(x)`, as in C.
pub fun float64.atan2(x: float64): float64 { return unsafe { atan2(self, x) } }

/// The floating-point remainder of `self / y`, keeping `self`'s sign.
pub fun float64.fmod(y: float64): float64 { return unsafe { fmod(self, y) } }

/// Without overflowing through `x*x + y*y`.
pub fun float64.hypot(y: float64): float64 { return unsafe { hypot(self, y) } }

/// `self` read as degrees, in radians.
pub fun float64.to_radians(): float64 { return self * float64.pi() / 180.0 }

/// `self` read as radians, in degrees.
pub fun float64.to_degrees(): float64 { return self * 180.0 / float64.pi() }
