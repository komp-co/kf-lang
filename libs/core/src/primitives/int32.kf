// Everything `int32` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_int32_add(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_sub(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_mul(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_div(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_mod(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_bit_and(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_bit_or(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_bit_xor(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_shl(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_shr(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_compare(left: int32, right: int32): int32
extern "C" fun kf_prim_int32_equals(left: int32, right: int32): bool

impl Add for int32 { fun add(other: &int32): int32 { return kf_prim_int32_add(self as int32, *other) } }

impl Sub for int32 { fun sub(other: &int32): int32 { return kf_prim_int32_sub(self as int32, *other) } }

impl Mul for int32 { fun mul(other: &int32): int32 { return kf_prim_int32_mul(self as int32, *other) } }

impl Div for int32 { fun div(other: &int32): int32 { return kf_prim_int32_div(self as int32, *other) } }

impl Mod for int32 { fun mod(other: &int32): int32 { return kf_prim_int32_mod(self as int32, *other) } }

impl BitAnd for int32 { fun bit_and(other: &int32): int32 { return kf_prim_int32_bit_and(self as int32, *other) } }

impl BitOr for int32 { fun bit_or(other: &int32): int32 { return kf_prim_int32_bit_or(self as int32, *other) } }

impl BitXor for int32 { fun bit_xor(other: &int32): int32 { return kf_prim_int32_bit_xor(self as int32, *other) } }

impl Shl for int32 { fun shl(other: &int32): int32 { return kf_prim_int32_shl(self as int32, *other) } }

impl Shr for int32 { fun shr(other: &int32): int32 { return kf_prim_int32_shr(self as int32, *other) } }

impl Clone for int32 { fun clone(): int32 { return self as int32 } }

impl Copy for int32 { }

impl Compare for int32 { fun compare(other: &int32): int32 { return kf_prim_int32_compare(self as int32, *other) } }

impl Equal for int32 { fun equals(other: &int32): bool { return kf_prim_int32_equals(self as int32, *other) } }

impl Display for int32 {
    fun display(out: &var dyn Write): void { write_int64(out, self as int64) }
}

impl Hash for int32 { fun hash(): uint64 { return mix_uint64(self as uint64) } }

impl Zero for int32 { static fun zero(): int32 { return 0 } }

impl One for int32 { static fun one(): int32 { return 1 } }

impl Num for int32 { }

impl Integer for int32 { }

impl Bounded for int32 {
    static fun min_value(): int32 { return 0 - 2147483647 - 1 }
    static fun max_value(): int32 { return 2147483647 }
}
