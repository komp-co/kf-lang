// Everything `char` implements.

import core.hash.mix_uint64
import core.display.mix_uint64

extern "C" fun kf_prim_char_compare(left: char, right: char): int32
extern "C" fun kf_prim_char_equals(left: char, right: char): bool

impl Clone for char { fun clone(): char { return self as char } }

impl Copy for char { }

impl Compare for char { fun compare(other: &char): int32 { return kf_prim_char_compare(self as char, *other) } }

impl Equal for char { fun equals(other: &char): bool { return kf_prim_char_equals(self as char, *other) } }

impl Hash for char { fun hash(): uint64 { return mix_uint64(self as uint64) } }

/// The character as UTF-8, not its number: `print('A')` writes `A`;
/// `print(c as uint32)` writes the code point. A scalar UTF-8 cannot encode
/// renders as empty.
impl Display for char {
    fun display(out: &var dyn Write): void {
        val e = (self as char).encode_utf8()
        out.write_str(e.as_str())
    }
}
