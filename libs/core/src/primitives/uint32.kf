// Everything `uint32` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_uint32_add(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_sub(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_mul(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_div(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_mod(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_bit_and(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_bit_or(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_bit_xor(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_shl(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_shr(left: uint32, right: uint32): uint32
extern "C" fun kf_prim_uint32_compare(left: uint32, right: uint32): int32
extern "C" fun kf_prim_uint32_equals(left: uint32, right: uint32): bool

impl Add for uint32 { fun add(other: &uint32): uint32 { return kf_prim_uint32_add(self as uint32, *other) } }

impl Sub for uint32 { fun sub(other: &uint32): uint32 { return kf_prim_uint32_sub(self as uint32, *other) } }

impl Mul for uint32 { fun mul(other: &uint32): uint32 { return kf_prim_uint32_mul(self as uint32, *other) } }

impl Div for uint32 { fun div(other: &uint32): uint32 { return kf_prim_uint32_div(self as uint32, *other) } }

impl Mod for uint32 { fun mod(other: &uint32): uint32 { return kf_prim_uint32_mod(self as uint32, *other) } }

impl BitAnd for uint32 { fun bit_and(other: &uint32): uint32 { return kf_prim_uint32_bit_and(self as uint32, *other) } }

impl BitOr for uint32 { fun bit_or(other: &uint32): uint32 { return kf_prim_uint32_bit_or(self as uint32, *other) } }

impl BitXor for uint32 { fun bit_xor(other: &uint32): uint32 { return kf_prim_uint32_bit_xor(self as uint32, *other) } }

impl Shl for uint32 { fun shl(other: &uint32): uint32 { return kf_prim_uint32_shl(self as uint32, *other) } }

impl Shr for uint32 { fun shr(other: &uint32): uint32 { return kf_prim_uint32_shr(self as uint32, *other) } }

impl Clone for uint32 { fun clone(): uint32 { return self as uint32 } }

impl Copy for uint32 { }

impl Compare for uint32 { fun compare(other: &uint32): int32 { return kf_prim_uint32_compare(self as uint32, *other) } }

impl Equal for uint32 { fun equals(other: &uint32): bool { return kf_prim_uint32_equals(self as uint32, *other) } }

impl Display for uint32 {
    fun display(out: &var dyn Write): void { write_uint64(out, self as uint64) }
}

impl Hash for uint32 { fun hash(): uint64 { return mix_uint64(self as uint64) } }

impl Zero for uint32 { static fun zero(): uint32 { return 0 } }

impl One for uint32 { static fun one(): uint32 { return 1 } }

impl Num for uint32 { }

impl Bounded for uint32 {
    static fun min_value(): uint32 { return 0 }
    static fun max_value(): uint32 { return 4294967295 }
}
