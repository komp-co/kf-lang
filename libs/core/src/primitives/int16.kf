// Everything `int16` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_int16_add(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_sub(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_mul(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_div(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_mod(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_bit_and(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_bit_or(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_bit_xor(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_shl(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_shr(left: int16, right: int16): int16
extern "C" fun kf_prim_int16_compare(left: int16, right: int16): int32
extern "C" fun kf_prim_int16_equals(left: int16, right: int16): bool

impl Add for int16 { fun add(other: &int16): int16 { return kf_prim_int16_add(self as int16, *other) } }

impl Sub for int16 { fun sub(other: &int16): int16 { return kf_prim_int16_sub(self as int16, *other) } }

impl Mul for int16 { fun mul(other: &int16): int16 { return kf_prim_int16_mul(self as int16, *other) } }

impl Div for int16 { fun div(other: &int16): int16 { return kf_prim_int16_div(self as int16, *other) } }

impl Mod for int16 { fun mod(other: &int16): int16 { return kf_prim_int16_mod(self as int16, *other) } }

impl BitAnd for int16 { fun bit_and(other: &int16): int16 { return kf_prim_int16_bit_and(self as int16, *other) } }

impl BitOr for int16 { fun bit_or(other: &int16): int16 { return kf_prim_int16_bit_or(self as int16, *other) } }

impl BitXor for int16 { fun bit_xor(other: &int16): int16 { return kf_prim_int16_bit_xor(self as int16, *other) } }

impl Shl for int16 { fun shl(other: &int16): int16 { return kf_prim_int16_shl(self as int16, *other) } }

impl Shr for int16 { fun shr(other: &int16): int16 { return kf_prim_int16_shr(self as int16, *other) } }

impl Clone for int16 { fun clone(): int16 { return self as int16 } }

impl Copy for int16 { }

impl Compare for int16 { fun compare(other: &int16): int32 { return kf_prim_int16_compare(self as int16, *other) } }

impl Equal for int16 { fun equals(other: &int16): bool { return kf_prim_int16_equals(self as int16, *other) } }

impl Display for int16 {
    fun display(out: &var dyn Write): void { write_int64(out, self as int64) }
}

impl Hash for int16 { fun hash(): uint64 { return mix_uint64(self as uint64) } }

impl Zero for int16 { static fun zero(): int16 { return 0 } }

impl One for int16 { static fun one(): int16 { return 1 } }

impl Num for int16 { }

impl Integer for int16 { }

impl Bounded for int16 {
    static fun min_value(): int16 { return -32767 - 1 }
    static fun max_value(): int16 { return 32767 }
}

impl Default for int16 { static fun default(): int16 { return 0 } }
