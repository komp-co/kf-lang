// Everything `uint64` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_uint64_add(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_sub(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_mul(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_div(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_mod(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_bit_and(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_bit_or(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_bit_xor(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_shl(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_shr(left: uint64, right: uint64): uint64
extern "C" fun kf_prim_uint64_compare(left: uint64, right: uint64): int32
extern "C" fun kf_prim_uint64_equals(left: uint64, right: uint64): bool

impl Add for uint64 { fun add(other: &uint64): uint64 { return kf_prim_uint64_add(self as uint64, *other) } }

impl Sub for uint64 { fun sub(other: &uint64): uint64 { return kf_prim_uint64_sub(self as uint64, *other) } }

impl Mul for uint64 { fun mul(other: &uint64): uint64 { return kf_prim_uint64_mul(self as uint64, *other) } }

impl Div for uint64 { fun div(other: &uint64): uint64 { return kf_prim_uint64_div(self as uint64, *other) } }

impl Mod for uint64 { fun mod(other: &uint64): uint64 { return kf_prim_uint64_mod(self as uint64, *other) } }

impl BitAnd for uint64 { fun bit_and(other: &uint64): uint64 { return kf_prim_uint64_bit_and(self as uint64, *other) } }

impl BitOr for uint64 { fun bit_or(other: &uint64): uint64 { return kf_prim_uint64_bit_or(self as uint64, *other) } }

impl BitXor for uint64 { fun bit_xor(other: &uint64): uint64 { return kf_prim_uint64_bit_xor(self as uint64, *other) } }

impl Shl for uint64 { fun shl(other: &uint64): uint64 { return kf_prim_uint64_shl(self as uint64, *other) } }

impl Shr for uint64 { fun shr(other: &uint64): uint64 { return kf_prim_uint64_shr(self as uint64, *other) } }

impl Clone for uint64 { fun clone(): uint64 { return self as uint64 } }

impl Copy for uint64 { }

impl Compare for uint64 { fun compare(other: &uint64): int32 { return kf_prim_uint64_compare(self as uint64, *other) } }

impl Equal for uint64 { fun equals(other: &uint64): bool { return kf_prim_uint64_equals(self as uint64, *other) } }

impl Display for uint64 {
    fun display(out: &var dyn Write): void { write_uint64(out, self as uint64) }
}

impl Hash for uint64 { fun hash(): uint64 { return mix_uint64(self) } }

impl Zero for uint64 { static fun zero(): uint64 { return 0 } }

impl One for uint64 { static fun one(): uint64 { return 1 } }

impl Num for uint64 { }

impl Integer for uint64 { }

impl Bounded for uint64 {
    static fun min_value(): uint64 { return 0 }
    static fun max_value(): uint64 { return 18446744073709551615 }
}
