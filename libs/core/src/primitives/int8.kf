// Everything `int8` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_int8_add(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_sub(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_mul(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_div(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_mod(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_bit_and(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_bit_or(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_bit_xor(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_shl(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_shr(left: int8, right: int8): int8
extern "C" fun kf_prim_int8_compare(left: int8, right: int8): int32
extern "C" fun kf_prim_int8_equals(left: int8, right: int8): bool

impl Add for int8 { fun add(other: &int8): int8 { return kf_prim_int8_add(self as int8, *other) } }

impl Sub for int8 { fun sub(other: &int8): int8 { return kf_prim_int8_sub(self as int8, *other) } }

impl Mul for int8 { fun mul(other: &int8): int8 { return kf_prim_int8_mul(self as int8, *other) } }

impl Div for int8 { fun div(other: &int8): int8 { return kf_prim_int8_div(self as int8, *other) } }

impl Mod for int8 { fun mod(other: &int8): int8 { return kf_prim_int8_mod(self as int8, *other) } }

impl BitAnd for int8 { fun bit_and(other: &int8): int8 { return kf_prim_int8_bit_and(self as int8, *other) } }

impl BitOr for int8 { fun bit_or(other: &int8): int8 { return kf_prim_int8_bit_or(self as int8, *other) } }

impl BitXor for int8 { fun bit_xor(other: &int8): int8 { return kf_prim_int8_bit_xor(self as int8, *other) } }

impl Shl for int8 { fun shl(other: &int8): int8 { return kf_prim_int8_shl(self as int8, *other) } }

impl Shr for int8 { fun shr(other: &int8): int8 { return kf_prim_int8_shr(self as int8, *other) } }

impl Clone for int8 { fun clone(): int8 { return self as int8 } }

impl Copy for int8 { }

impl Compare for int8 { fun compare(other: &int8): int32 { return kf_prim_int8_compare(self as int8, *other) } }

impl Equal for int8 { fun equals(other: &int8): bool { return kf_prim_int8_equals(self as int8, *other) } }

impl Display for int8 {
    fun display(out: &var dyn Write): void { write_int64(out, self as int64) }
}

impl Hash for int8 { fun hash(): uint64 { return mix_uint64(self as uint64) } }

impl Zero for int8 { static fun zero(): int8 { return 0 } }

impl One for int8 { static fun one(): int8 { return 1 } }

impl Num for int8 { }

impl Integer for int8 { }

impl Bounded for int8 {
    static fun min_value(): int8 { return 0 - 127 - 1 }
    static fun max_value(): int8 { return 127 }
}

impl Default for int8 { static fun default(): int8 { return 0 } }
