// Numbers rendered into a sink.
//
// CONSTRAINT: allocates nothing.

/// Write `v` in base ten, in one write.
@prelude
pub fun write_uint64(out: &var dyn Write, v: uint64): void {
    // 20 digits hold every `uint64`; the last byte stays the terminator.
    var digits = Array<uint8, 21> {}
    var start: uint64 = 20
    var rest = v
    while true {
        start = start - 1
        *digits.at_mut(start) = ('0' as uint64 + rest % 10) as uint8
        rest = rest / 10
        if rest == 0 { break }
    }
    out.write_str(unsafe { ((&digits) as Ptr<uint8> + start) as str })
}

/// Write `v` in base ten, with a leading `-` when it is negative.
@prelude
pub fun write_int64(out: &var dyn Write, v: int64): void {
    if v < 0 {
        out.write_str("-")
        // In uint64: the most negative int64 has no positive counterpart.
        write_uint64(out, 0 - (v as uint64))
        return
    }
    write_uint64(out, v as uint64)
}
