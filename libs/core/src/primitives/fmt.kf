// Numbers rendered into a sink.
//
// CONSTRAINT: allocates nothing.

/// Write `v` in base ten, in one write.
@prelude
pub fun write_uint64(out: &var dyn Write, v: uint64): void {
    v.write_radix(out, 10, 0)
}

/// `self` in `radix`, 2 to 36, with lowercase letters past 9, and zeros in
/// front up to `width` digits, in one write after the zeros.
@prelude
pub fun uint64.write_radix(out: &var dyn Write, radix: uint32, width: uint64): void {
    if radix < 2 || radix > 36 { panic("a radix is 2 to 36") }
    val base = radix as uint64
    // 64 binary digits hold every `uint64`; the last byte stays the terminator.
    var digits = Array<uint8, 65> {}
    var start: uint64 = 64
    var rest = self
    while true {
        start = start - 1
        *digits.at_mut(start) = (rest % base).radix_digit()
        rest = rest / base
        if rest == 0 { break }
    }
    val count = 64 - start
    if width > count {
        while _ in count..width { out.write_str("0") }
    }
    out.write_str(unsafe { ((&digits) as Ptr<uint8> + start) as str })
}

/// As `uint64.write_radix`, with a `-` before the zeros when negative.
@prelude
pub fun int64.write_radix(out: &var dyn Write, radix: uint32, width: uint64): void {
    if self >= 0 {
        (self as uint64).write_radix(out, radix, width)
        return
    }
    out.write_str("-")
    // In uint64: the most negative int64 has no positive counterpart.
    (0 - (self as uint64)).write_radix(out, radix, width)
}

/// The digit naming `self`, below 36.
fun uint64.radix_digit(): uint8 {
    if self < 10 { return ('0' as uint64 + self) as uint8 }
    return ('a' as uint64 + self - 10) as uint8
}

/// Write `v` in base ten, with a leading `-` when it is negative.
@prelude
pub fun write_int64(out: &var dyn Write, v: int64): void {
    if v < 0 {
        out.write_str("-")
        // In uint64: the most negative int64 has no positive counterpart.
        write_uint64(out, 0 - (v as uint64))
        return
    }
    write_uint64(out, v as uint64)
}
