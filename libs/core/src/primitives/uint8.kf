// Everything `uint8` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_uint8_add(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_sub(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_mul(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_div(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_mod(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_bit_and(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_bit_or(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_bit_xor(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_shl(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_shr(left: uint8, right: uint8): uint8
extern "C" fun kf_prim_uint8_compare(left: uint8, right: uint8): int32
extern "C" fun kf_prim_uint8_equals(left: uint8, right: uint8): bool

impl Add for uint8 { fun add(other: &uint8): uint8 { return kf_prim_uint8_add(self as uint8, *other) } }

impl Sub for uint8 { fun sub(other: &uint8): uint8 { return kf_prim_uint8_sub(self as uint8, *other) } }

impl Mul for uint8 { fun mul(other: &uint8): uint8 { return kf_prim_uint8_mul(self as uint8, *other) } }

impl Div for uint8 { fun div(other: &uint8): uint8 { return kf_prim_uint8_div(self as uint8, *other) } }

impl Mod for uint8 { fun mod(other: &uint8): uint8 { return kf_prim_uint8_mod(self as uint8, *other) } }

impl BitAnd for uint8 { fun bit_and(other: &uint8): uint8 { return kf_prim_uint8_bit_and(self as uint8, *other) } }

impl BitOr for uint8 { fun bit_or(other: &uint8): uint8 { return kf_prim_uint8_bit_or(self as uint8, *other) } }

impl BitXor for uint8 { fun bit_xor(other: &uint8): uint8 { return kf_prim_uint8_bit_xor(self as uint8, *other) } }

impl Shl for uint8 { fun shl(other: &uint8): uint8 { return kf_prim_uint8_shl(self as uint8, *other) } }

impl Shr for uint8 { fun shr(other: &uint8): uint8 { return kf_prim_uint8_shr(self as uint8, *other) } }

impl Clone for uint8 { fun clone(): uint8 { return self as uint8 } }

impl Copy for uint8 { }

impl Compare for uint8 { fun compare(other: &uint8): int32 { return kf_prim_uint8_compare(self as uint8, *other) } }

impl Equal for uint8 { fun equals(other: &uint8): bool { return kf_prim_uint8_equals(self as uint8, *other) } }

impl Display for uint8 {
    fun display(out: &var dyn Write): void { write_uint64(out, self as uint64) }
}

impl Hash for uint8 { fun hash(): uint64 { return mix_uint64(self as uint64) } }

impl Zero for uint8 { static fun zero(): uint8 { return 0 } }

impl One for uint8 { static fun one(): uint8 { return 1 } }

impl Num for uint8 { }

impl Integer for uint8 { }

impl Bounded for uint8 {
    static fun min_value(): uint8 { return 0 }
    static fun max_value(): uint8 { return 255 }
}
