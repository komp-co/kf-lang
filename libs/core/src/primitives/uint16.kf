// Everything `uint16` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_uint16_add(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_sub(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_mul(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_div(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_mod(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_bit_and(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_bit_or(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_bit_xor(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_shl(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_shr(left: uint16, right: uint16): uint16
extern "C" fun kf_prim_uint16_compare(left: uint16, right: uint16): int32
extern "C" fun kf_prim_uint16_equals(left: uint16, right: uint16): bool

impl Add for uint16 { fun add(other: &uint16): uint16 { return kf_prim_uint16_add(self as uint16, *other) } }

impl Sub for uint16 { fun sub(other: &uint16): uint16 { return kf_prim_uint16_sub(self as uint16, *other) } }

impl Mul for uint16 { fun mul(other: &uint16): uint16 { return kf_prim_uint16_mul(self as uint16, *other) } }

impl Div for uint16 { fun div(other: &uint16): uint16 { return kf_prim_uint16_div(self as uint16, *other) } }

impl Mod for uint16 { fun mod(other: &uint16): uint16 { return kf_prim_uint16_mod(self as uint16, *other) } }

impl BitAnd for uint16 { fun bit_and(other: &uint16): uint16 { return kf_prim_uint16_bit_and(self as uint16, *other) } }

impl BitOr for uint16 { fun bit_or(other: &uint16): uint16 { return kf_prim_uint16_bit_or(self as uint16, *other) } }

impl BitXor for uint16 { fun bit_xor(other: &uint16): uint16 { return kf_prim_uint16_bit_xor(self as uint16, *other) } }

impl Shl for uint16 { fun shl(other: &uint16): uint16 { return kf_prim_uint16_shl(self as uint16, *other) } }

impl Shr for uint16 { fun shr(other: &uint16): uint16 { return kf_prim_uint16_shr(self as uint16, *other) } }

impl Clone for uint16 { fun clone(): uint16 { return self as uint16 } }

impl Copy for uint16 { }

impl Compare for uint16 { fun compare(other: &uint16): int32 { return kf_prim_uint16_compare(self as uint16, *other) } }

impl Equal for uint16 { fun equals(other: &uint16): bool { return kf_prim_uint16_equals(self as uint16, *other) } }

impl Display for uint16 {
    fun display(out: &var dyn Write): void { write_uint64(out, self as uint64) }
}

impl Hash for uint16 { fun hash(): uint64 { return mix_uint64(self as uint64) } }

impl Zero for uint16 { static fun zero(): uint16 { return 0 } }

impl One for uint16 { static fun one(): uint16 { return 1 } }

impl Num for uint16 { }

impl Integer for uint16 { }

impl Bounded for uint16 {
    static fun min_value(): uint16 { return 0 }
    static fun max_value(): uint16 { return 65535 }
}
