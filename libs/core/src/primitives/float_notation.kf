// A float written with a chosen number of decimals, rather than the shortest
// form that reads back the same.

extern "C" fun kf_float64_fixed_str(value: float64, decimals: uint32): str
extern "C" fun kf_float64_exponential_str(value: float64, decimals: uint32): str

/// `decimals` digits after the point, rounded: `(2.0 / 3.0)` with 2 writes
/// `0.67`. At most 100 decimals.
@prelude
pub fun float64.write_fixed(out: &var dyn Write, decimals: uint32): void {
    out.write_str(unsafe { kf_float64_fixed_str(self, decimals) })
}

/// One digit before the point, `decimals` after it, then the power of ten:
/// `1234.5` with 2 writes `1.23e+03`. At most 100 decimals.
@prelude
pub fun float64.write_exponential(out: &var dyn Write, decimals: uint32): void {
    out.write_str(unsafe { kf_float64_exponential_str(self, decimals) })
}
