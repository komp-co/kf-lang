// Everything `float32` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_float32_add(left: float32, right: float32): float32
extern "C" fun kf_prim_float32_sub(left: float32, right: float32): float32
extern "C" fun kf_prim_float32_mul(left: float32, right: float32): float32
extern "C" fun kf_prim_float32_div(left: float32, right: float32): float32
extern "C" fun kf_prim_float32_compare(left: float32, right: float32): int32
extern "C" fun kf_prim_float32_equals(left: float32, right: float32): bool
extern "C" fun float32_display_str(value: float32): str
extern "C" fun kf_float32_bits(v: float32): uint32

impl Add for float32 { fun add(other: &float32): float32 { return kf_prim_float32_add(self as float32, *other) } }

impl Sub for float32 { fun sub(other: &float32): float32 { return kf_prim_float32_sub(self as float32, *other) } }

impl Mul for float32 { fun mul(other: &float32): float32 { return kf_prim_float32_mul(self as float32, *other) } }

impl Div for float32 { fun div(other: &float32): float32 { return kf_prim_float32_div(self as float32, *other) } }

impl Clone for float32 { fun clone(): float32 { return self as float32 } }

impl Copy for float32 { }

impl Compare for float32 { fun compare(other: &float32): int32 { return kf_prim_float32_compare(self as float32, *other) } }

impl Equal for float32 { fun equals(other: &float32): bool { return kf_prim_float32_equals(self as float32, *other) } }

/// The fewest digits that read back as the same value: "0.1" for 0.1, and
/// "0.30000000000000004" for 0.1 + 0.2.
impl Display for float32 {
    fun display(out: &var dyn Write): void { out.write_str(float32_display_str(self as float32)) }
}

/// Hashes the bits, as `float64` does.
impl Hash for float32 {
    fun hash(): uint64 {
        if self == 0.0 { return mix_uint64(0) }
        return mix_uint64(unsafe { kf_float32_bits(self) } as uint64)
    }
}

impl Zero for float32 { static fun zero(): float32 { return 0.0 } }

impl One for float32 { static fun one(): float32 { return 1.0 } }

impl Num for float32 { }

impl Float for float32 {
    static fun pi(): float32 { return 3.14159265 }
    static fun e(): float32 { return 2.71828183 }
    static fun epsilon(): float32 { return 0.00000011920929 }
}
