// Everything `int64` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_int64_add(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_sub(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_mul(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_div(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_mod(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_bit_and(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_bit_or(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_bit_xor(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_shl(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_shr(left: int64, right: int64): int64
extern "C" fun kf_prim_int64_compare(left: int64, right: int64): int32
extern "C" fun kf_prim_int64_equals(left: int64, right: int64): bool

impl Add for int64 { fun add(other: &int64): int64 { return kf_prim_int64_add(self as int64, *other) } }

impl Sub for int64 { fun sub(other: &int64): int64 { return kf_prim_int64_sub(self as int64, *other) } }

impl Mul for int64 { fun mul(other: &int64): int64 { return kf_prim_int64_mul(self as int64, *other) } }

impl Div for int64 { fun div(other: &int64): int64 { return kf_prim_int64_div(self as int64, *other) } }

impl Mod for int64 { fun mod(other: &int64): int64 { return kf_prim_int64_mod(self as int64, *other) } }

impl BitAnd for int64 { fun bit_and(other: &int64): int64 { return kf_prim_int64_bit_and(self as int64, *other) } }

impl BitOr for int64 { fun bit_or(other: &int64): int64 { return kf_prim_int64_bit_or(self as int64, *other) } }

impl BitXor for int64 { fun bit_xor(other: &int64): int64 { return kf_prim_int64_bit_xor(self as int64, *other) } }

impl Shl for int64 { fun shl(other: &int64): int64 { return kf_prim_int64_shl(self as int64, *other) } }

impl Shr for int64 { fun shr(other: &int64): int64 { return kf_prim_int64_shr(self as int64, *other) } }

impl Clone for int64 { fun clone(): int64 { return self as int64 } }

impl Copy for int64 { }

impl Compare for int64 { fun compare(other: &int64): int32 { return kf_prim_int64_compare(self as int64, *other) } }

impl Equal for int64 { fun equals(other: &int64): bool { return kf_prim_int64_equals(self as int64, *other) } }

impl Display for int64 {
    fun display(out: &var dyn Write): void { write_int64(out, self as int64) }
}

impl Hash for int64 { fun hash(): uint64 { return mix_uint64(self as uint64) } }

impl Zero for int64 { static fun zero(): int64 { return 0 } }

impl One for int64 { static fun one(): int64 { return 1 } }

impl Num for int64 { }

impl Integer for int64 { }

impl Bounded for int64 {
    static fun min_value(): int64 {
        // Named: a literal inside an expression takes int32.
        val most: int64 = 9223372036854775807
        return 0 - most - 1
    }
    static fun max_value(): int64 { return 9223372036854775807 }
}

impl Default for int64 { static fun default(): int64 { return 0 } }
