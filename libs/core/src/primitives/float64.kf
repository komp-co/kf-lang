// Everything `float64` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_float64_add(left: float64, right: float64): float64
extern "C" fun kf_prim_float64_sub(left: float64, right: float64): float64
extern "C" fun kf_prim_float64_mul(left: float64, right: float64): float64
extern "C" fun kf_prim_float64_div(left: float64, right: float64): float64
extern "C" fun kf_prim_float64_compare(left: float64, right: float64): int32
extern "C" fun kf_prim_float64_equals(left: float64, right: float64): bool
extern "C" fun float64_display_str(value: float64): str
extern "C" fun kf_float64_bits(v: float64): uint64

impl Add for float64 { fun add(other: &float64): float64 { return kf_prim_float64_add(self as float64, *other) } }

impl Sub for float64 { fun sub(other: &float64): float64 { return kf_prim_float64_sub(self as float64, *other) } }

impl Mul for float64 { fun mul(other: &float64): float64 { return kf_prim_float64_mul(self as float64, *other) } }

impl Div for float64 { fun div(other: &float64): float64 { return kf_prim_float64_div(self as float64, *other) } }

impl Clone for float64 { fun clone(): float64 { return self as float64 } }

impl Copy for float64 { }

impl Compare for float64 { fun compare(other: &float64): int32 { return kf_prim_float64_compare(self as float64, *other) } }

impl Equal for float64 { fun equals(other: &float64): bool { return kf_prim_float64_equals(self as float64, *other) } }

/// The fewest digits that read back as the same value: "0.1" for 0.1, and
/// "0.30000000000000004" for 0.1 + 0.2.
impl Display for float64 {
    fun display(out: &var dyn Write): void { out.write_str(float64_display_str(self as float64)) }
}

/// Hashes the bits, not a truncating cast.
///
/// CONSTRAINT: -0.0 and 0.0 are `==` and must hash equally, though their sign
/// bits differ.
///
/// A NaN key is never found again: NaN is unequal to itself.
impl Hash for float64 {
    fun hash(): uint64 {
        if self == 0.0 { return mix_uint64(0) }
        return mix_uint64(unsafe { kf_float64_bits(self) })
    }
}

impl Zero for float64 { static fun zero(): float64 { return 0.0 } }

impl One for float64 { static fun one(): float64 { return 1.0 } }

impl Num for float64 { }

impl Float for float64 {
    static fun pi(): float64 { return 3.141592653589793 }
    static fun e(): float64 { return 2.718281828459045 }
    static fun epsilon(): float64 { return 0.0000000000000002220446049250313 }
}

impl Default for float64 { static fun default(): float64 { return 0.0 } }
