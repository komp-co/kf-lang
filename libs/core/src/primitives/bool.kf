// Everything `bool` implements.

import core.display.mix_uint64
import core.hash.mix_uint64

extern "C" fun kf_prim_bool_compare(left: bool, right: bool): int32
extern "C" fun kf_prim_bool_equals(left: bool, right: bool): bool

impl Clone for bool { fun clone(): bool { return self as bool } }

impl Copy for bool { }

impl Compare for bool { fun compare(other: &bool): int32 { return kf_prim_bool_compare(self as bool, *other) } }

impl Equal for bool { fun equals(other: &bool): bool { return kf_prim_bool_equals(self as bool, *other) } }

impl Display for bool {
    fun display(out: &var dyn Write): void {
        if self { out.write_str("true") } else { out.write_str("false") }
    }
}

// `true` and `false` must not hash to 1 and 0.
impl Hash for bool {
    fun hash(): uint64 {
        if self { return mix_uint64(1) }
        return mix_uint64(0)
    }
}
