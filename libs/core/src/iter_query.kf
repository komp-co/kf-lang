// Questions asked of everything an iterable yields. Each walks the elements in
// order and stops as soon as the answer is known.

/// True when `pred` holds for some element; stops at the first.
@prelude
pub fun <T> Iterable<T>.any<F: Call1<T>>(pred: F): bool {
    while x in self {
        if pred.call(x) { return true }
    }
    return false
}

/// True when `pred` holds for every element, and for none at all.
@prelude
pub fun <T> Iterable<T>.all<F: Call1<T>>(pred: F): bool {
    while x in self {
        if !pred.call(x) { return false }
    }
    return true
}

/// How many elements `pred` holds for.
@prelude
pub fun <T> Iterable<T>.count<F: Call1<T>>(pred: F): uint64 {
    var n: uint64 = 0
    while x in self {
        if pred.call(x) { n = n + 1 }
    }
    return n
}

/// The index of the first element `pred` holds for.
@prelude
pub fun <T> Iterable<T>.position<F: Call1<T>>(pred: F): uint64? {
    var i: uint64 = 0
    while x in self {
        if pred.call(x) { return i }
        i = i + 1
    }
    return null
}

/// The first element `pred` holds for.
@prelude
pub fun <T> Iterable<T>.find<F: Call1<&T>>(pred: F): T? {
    while x in self {
        if pred.call(&x) { return x }
    }
    return null
}

/// Left to right: `xs.fold(0, |a, x| a + x)` sums.
@prelude
pub fun <T> Iterable<T>.fold<A, F: Call2<A, T>>(init: A, f: F): A {
    var acc = init
    while x in self {
        acc = f.call(acc, x)
    }
    return acc
}

/// True when some element equals `item`.
@prelude
pub fun <T: Equal> Iterable<T>.contains(item: &T): bool {
    while x in self {
        if x == *item { return true }
    }
    return false
}
