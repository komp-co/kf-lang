// `T?` is sugar for `Option<T>`.
/// The language finds the optional type by key, not name.
@lang("option")
pub enum Option<T> {
    Some(T)
    None
}

impl Option<T> {
    pub fun is_some(): bool {
        return when (self) {
            Some(_v) => true
            None => false
        }
    }

    pub fun is_none(): bool {
        return when (self) {
            Some(_v) => false
            None => true
        }
    }

    /// The payload, or a controlled abort. `!!` desugars to this; prefer `?:`
    /// where a default will do.
    ///
    /// Copies out of the borrowed `self`, so the option stays usable.
    pub fun unwrap(): T {
        when (self) {
            Some(v) => { return v }
            None => {}
        }
        panic_with(Fault.UnwrapNone)
    }

    /// The payload, or `default` when there is none.
    pub fun unwrap_or(default: T): T {
        when (self) {
            Some(v) => { return v }
            None => {}
        }
        return default
    }

    /// The payload, or what `f` makes; `f` runs only for a `None`.
    pub fun unwrap_or_else<F: Call0>(f: F): T {
        when (self) {
            Some(v) => { return v }
            None => {}
        }
        return f.call()
    }

    /// `f` applied to the payload: `Some(2).map(|x| x + 1)` is `Some(3)`.
    pub fun map<F: Call1<T>>(f: F): Option<F.Out> {
        when (self) {
            Some(v) => { return Option.Some<F.Out>(f.call(v)) }
            None => {}
        }
        return Option.None<F.Out>()
    }

    /// `f`, itself returning an option, applied to the payload; where `map`
    /// would nest one option in another, this does not.
    pub fun and_then<F: Call1<T>>(f: F): F.Out {
        when (self) {
            Some(v) => { return f.call(v) }
            None => {}
        }
        return residual_as<F.Out, Option<Never>>(Option.None<Never>())
    }

    /// This option when it holds a payload, else the option `f` makes.
    pub fun or_else<F: Call0>(f: F): F.Out {
        when (self) {
            Some(v) => { return output_as<F.Out, T>(v) }
            None => {}
        }
        return f.call()
    }

    /// This option when `keep` holds for its payload, else `None`.
    pub fun filter<F: Call1<&T>>(keep: F): Option<T> {
        when (self) {
            Some(v) => {
                if keep.call(&v) { return Option.Some<T>(v) }
            }
            None => {}
        }
        return Option.None<T>()
    }

    /// True when there is a payload and `p` holds for it.
    pub fun is_some_and<F: Call1<&T>>(p: F): bool {
        when (self) {
            Some(v) => { return p.call(&v) }
            None => {}
        }
        return false
    }

    /// The payload as an `Ok`, or `err` as the `Err`.
    pub fun ok_or<E>(err: E): Result<T, E> {
        when (self) {
            Some(v) => { return Result.Ok<T, E>(v) }
            None => {}
        }
        return Result.Err<T, E>(err)
    }
}

// An `Option<T>` is comparable exactly when its payload is.

impl Equal for Option<T: Equal> {
    fun equals(other: &Option<T>): bool {
        when (self) {
            Some(a) => {
                when (other) {
                    Some(b) => { return a == b }
                    None => { return false }
                }
            }
            None => {
                when (other) {
                    Some(_b) => { return false }
                    None => { return true }
                }
            }
        }
        return false
    }
}

impl Copy for Option<T: Copy> { }

impl Clone for Option<T: Clone> {
    fun clone(): Option<T> {
        when (self) {
            Some(v) => { return Option.Some<T>(v.clone()) }
            None => { return Option.None<T>() }
        }
        return Option.None<T>()
    }
}

// `None` hashes to 0; `Some(v)` remixes the payload's hash, so `Some(x)` and
// `x` differ.
impl Hash for Option<T: Hash> {
    fun hash(): uint64 {
        when (self) {
            Some(v) => { return mix_uint64(v.hash()) }
            None => { return 0 }
        }
        return 0
    }
}

impl Default for Option<T> {
    static fun default(): Option<T> {
        return Option.None<T>()
    }
}

impl Try for Option<T> {
    type Output = T
    type Residual = Option<Never>

    fun branch(): Branch<T, Option<Never>> {
        if self.is_none() {
            return Branch.Break<T, Option<Never>>(Option.None<Never>())
        }
        // CONSTRAINT: through a typed local: a call argument is a borrow
        // position, and the option would drop the aliased payload too.
        val payload: T = self.unwrap()
        return Branch.Continue<T, Option<Never>>(payload)
    }

    static fun from_output(o: T): Option<T> {
        return Option.Some<T>(o)
    }
}

impl FromResidual<Option<Never>> for Option<T> {
    // A `None` is a `None` at every payload type.
    static fun from_residual(_r: Option<Never>): Option<T> {
        return Option.None<T>()
    }
}
