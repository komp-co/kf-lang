// `FromText` for the float types: decimal digits with an optional fraction and
// exponent, or `inf`, `infinity` or `nan` in any case, after an optional sign.
// The C library reads the value, so it is rounded correctly.

extern "C" fun kf_float_text_prefix(text: str): uint64
extern "C" fun kf_float64_from_text(text: str): float64
extern "C" fun kf_float32_from_text(text: str): float32

/// Ok when the whole text is one float.
fun str.is_float_text(): Result<void, ParseError> {
    val n = self.byte_len()
    if n == 0 { return Result.Err(ParseError.Empty) }
    val read = unsafe { kf_float_text_prefix(self) }
    if read < n { return Result.Err(ParseError.InvalidDigit(read)) }
    return Result.Ok()
}

impl FromText for float64 {
    static fun from_text(text: str): Result<float64, ParseError> {
        text.is_float_text()?
        return Result.Ok(unsafe { kf_float64_from_text(text) })
    }
}

impl FromText for float32 {
    static fun from_text(text: str): Result<float32, ParseError> {
        text.is_float_text()?
        return Result.Ok(unsafe { kf_float32_from_text(text) })
    }
}
