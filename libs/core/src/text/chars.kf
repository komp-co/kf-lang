// Character-level access to `str`, beside the byte axis. Bytes are right for
// searching and slicing, since a byte match lands on a character boundary;
// characters for counting, classifying and iterating. Every name says its
// unit.
//
// Scalars, not user-perceived characters: an accented `e` may be one scalar
// or two. No grapheme clustering.
//
// Cost is in the name: reaching the i-th character decodes the ones before
// it, so `char_at` is a scan, `chars()` walks, and there is no `s[i]`.

import core.option.*

/// A cursor over the characters of a `str`. Holds the view, so it must not
/// outlive the string.
pub struct CharIter {
    /// A `str` cannot be stored in a struct, and copying needs an allocator.
    val data: Ptr<uint8>
    /// Measured once; `byte_len` is a scan.
    val len: uint64
    /// The byte offset of the next character.
    pub var at: uint64
}

impl Iterator<char> for CharIter {
    mutating fun next(): char? {
        if self.at >= self.len { return null }
        val d = decode_in(unsafe { self.data as str }, self.at, self.len)
        // `width` is at least 1 inside the string, so a walk always advances.
        self.at = self.at + d.width
        return Option.Some(d.scalar)
    }
}

/// Its own cursor, so `while c in s.chars()` works.
impl Iterable<char> for CharIter {
    type Iter = CharIter
    fun iter(): CharIter {
        return CharIter { data: self.data, len: self.len, at: self.at }
    }
}

/// Every character, in order, in one O(n) pass.
///
///     while c in s.chars() {
///         if c == '/' { ... }
///     }
@prelude
pub fun str.chars(): CharIter {
    return CharIter { data: unsafe { self as Ptr<uint8> }, len: self.byte_len(), at: 0 }
}

/// How many characters: `"héllo".byte_len()` is 6 and this is 5. Counts lead
/// bytes, so malformed input is counted as the decoder reads it.
@prelude
pub fun str.char_count(): uint64 {
    var n: uint64 = 0
    var i: uint64 = 0
    val end = self.byte_len()
    while i < end {
        i = i + decode_in(self, i, end).width
        n = n + 1
    }
    return n
}

/// The `i`-th character, not the one at byte offset `i`. O(n): use `chars()`
/// to walk.
///
/// 0 past the end, which is also a real scalar; check `char_count()` to tell
/// them apart.
@prelude
pub fun str.char_at(i: uint64): char {
    var seen: uint64 = 0
    var at: uint64 = 0
    val end = self.byte_len()
    while at < end {
        val d = decode_in(self, at, end)
        if seen == i { return d.scalar }
        seen = seen + 1
        at = at + d.width
    }
    return 0 as char
}
