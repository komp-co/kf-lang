// UTF-8 decoding and encoding, where bytes become scalars (not user-perceived
// characters; no grapheme clustering or normalization). Freestanding.

extern "C" fun kf_str_byte_len(s: str): uint64
extern "C" fun kf_str_byte_at(s: str, i: uint64): uint8

/// One decoded scalar and what it cost.
pub struct Utf8Scalar {
    /// On malformed input, what could be read: the offending byte, or the bits
    /// before the sequence broke. Never a substitution.
    pub val scalar: char
    /// Bytes consumed, which a walk advances by. At least 1 inside the
    /// string, so a malformed byte never spins; 0 only past the end.
    pub val width: uint64
    /// Well-formed: the promised continuations, not overlong, not a
    /// surrogate, inside the code space. When false, `scalar` and `width`
    /// stay usable.
    pub val well_formed: bool
}

/// The scalar beginning at byte `i`, and how many bytes it occupied.
///
///     var i: uint64 = 0
///     while i < s.byte_len() {
///         val d = s.decode_at(i)
///         ...
///         i = i + d.width
///     }
///
/// A byte offset, as `index_of` answers in, which makes this O(1).
@prelude
pub fun str.decode_at(i: uint64): Utf8Scalar {
    return decode_in(self, i, unsafe { kf_str_byte_len(self) })
}

/// For a caller knowing the length; re-measuring per character is quadratic.
fun decode_in(self: str, i: uint64, n: uint64): Utf8Scalar {
    if i >= n {
        return Utf8Scalar { scalar: 0 as char, width: 0, well_formed: false }
    }
    val lead: uint8 = unsafe { kf_str_byte_at(self, i) }
    if lead < 128 {
        return Utf8Scalar { scalar: lead as char, width: 1, well_formed: true }
    }
    // A continuation byte where a lead belongs, or a lead no sequence has:
    // one byte consumed, so the walk steps over it.
    if lead < 192 || lead >= 248 {
        return Utf8Scalar { scalar: lead as char, width: 1, well_formed: false }
    }
    // The continuation count, the lead's bits, and the smallest scalar this
    // width may carry, which detects an overlong encoding.
    var extra = 0
    var scalar: uint32 = 0
    var lowest: uint32 = 0
    if lead >= 240 {
        extra = 3
        scalar = (lead - 240) as uint32
        lowest = 65536
    } else if lead >= 224 {
        extra = 2
        scalar = (lead - 224) as uint32
        lowest = 2048
    } else {
        extra = 1
        scalar = (lead - 192) as uint32
        lowest = 128
    }
    var consumed: uint64 = 1
    var k: uint64 = 0
    while k < extra {
        if i + consumed >= n {
            // Truncated: the string ended mid-sequence.
            return Utf8Scalar { scalar: scalar as char, width: consumed, well_formed: false }
        }
        val cont: uint8 = unsafe { kf_str_byte_at(self, i + consumed) }
        if cont < 128 || cont >= 192 {
            // Stop before it: it may be a valid lead.
            return Utf8Scalar { scalar: scalar as char, width: consumed, well_formed: false }
        }
        scalar = scalar * 64 + ((cont - 128) as uint32)
        consumed = consumed + 1
        k = k + 1
    }
    // Complete, but still invalid if overlong, a surrogate, or past the last
    // code point.
    var ok: bool = true
    if scalar < lowest { ok = false }
    if scalar >= 55296 && scalar <= 57343 { ok = false }
    if scalar > 1114111 { ok = false }
    return Utf8Scalar { scalar: scalar as char, width: consumed, well_formed: ok }
}

/// A fixed four bytes; the caller reads `width` of them.
pub struct Utf8Bytes {
    pub val b0: uint8
    pub val b1: uint8
    pub val b2: uint8
    pub val b3: uint8
    /// 1 to 4, or 0 for a surrogate or a value past the last code point.
    pub val width: uint64
}

/// Encode `c` as UTF-8, the inverse of `decode_at`. No `String`, which
/// imports this module. An unencodable scalar yields `width: 0`.
@prelude
pub fun char.encode_utf8(): Utf8Bytes {
    val v: uint32 = self as uint32
    if v < 128 {
        return Utf8Bytes { b0: v as uint8, b1: 0, b2: 0, b3: 0, width: 1 }
    }
    if v < 2048 {
        return Utf8Bytes {
            b0: (192 + (v / 64)) as uint8,
            b1: (128 + (v % 64)) as uint8,
            b2: 0, b3: 0, width: 2
        }
    }
    // Before the three-byte case, the range surrogates fall in.
    if v >= 55296 && v <= 57343 {
        return Utf8Bytes { b0: 0, b1: 0, b2: 0, b3: 0, width: 0 }
    }
    if v > 1114111 {
        return Utf8Bytes { b0: 0, b1: 0, b2: 0, b3: 0, width: 0 }
    }
    if v < 65536 {
        return Utf8Bytes {
            b0: (224 + (v / 4096)) as uint8,
            b1: (128 + ((v / 64) % 64)) as uint8,
            b2: (128 + (v % 64)) as uint8,
            b3: 0, width: 3
        }
    }
    return Utf8Bytes {
        b0: (240 + (v / 262144)) as uint8,
        b1: (128 + ((v / 4096) % 64)) as uint8,
        b2: (128 + ((v / 64) % 64)) as uint8,
        b3: (128 + (v % 64)) as uint8,
        width: 4
    }
}
