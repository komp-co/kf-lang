// Numbers read out of text: `"42".parse<int32>()`. Nothing is allocated, and
// a failure says why.

/// Why text did not read as a number.
@derive(Copy, Equal)
pub enum ParseError {
    /// There was no text to read.
    Empty
    /// The byte at this index cannot appear there.
    InvalidDigit(uint64)
    /// The text names a value the type cannot hold.
    Overflow
}

impl Display for ParseError {
    fun display(out: &var dyn Write): void {
        when (self) {
            Empty => out.write_str("no number in empty text")
            InvalidDigit(at) => {
                out.write_str("invalid digit at byte ")
                write_uint64(out, at)
            }
            Overflow => out.write_str("number too large for its type")
        }
    }
}

/// A type read out of text.
pub trait FromText {
    static fun from_text(text: str): Result<Self, ParseError>
}

/// A whole-number type read out of text in any radix from 2 to 36.
pub trait FromTextRadix {
    static fun from_text_radix(text: str, radix: uint32): Result<Self, ParseError>
}

/// `text` read as a `T`: `"42".parse<int32>()`.
@prelude
pub fun str.parse<T: FromText>(): Result<T, ParseError> {
    return T.from_text(self)
}

/// The digits of `radix` from `start` on, as one value no larger than
/// `limit`.
fun str.digits_up_to(start: uint64, radix: uint32, limit: uint64): Result<uint64, ParseError> {
    if radix < 2 || radix > 36 { panic("a radix is 2 to 36") }
    val n = self.byte_len()
    if n == 0 { return Result.Err(ParseError.Empty) }
    if start == n { return Result.Err(ParseError.InvalidDigit(start)) }
    val base = radix as uint64
    var value: uint64 = 0
    while i in start..n {
        val digit = (self.byte_at(i) as char).digit_in(radix) ?: return Result.Err(ParseError.InvalidDigit(i))
        val d = digit as uint64
        if value > (limit - d) / base { return Result.Err(ParseError.Overflow) }
        value = value * base + d
    }
    return Result.Ok(value)
}

/// A whole number of `radix` no larger than `max`, after an optional `+`.
fun str.unsigned_up_to(radix: uint32, max: uint64): Result<uint64, ParseError> {
    val start: uint64 = if self.byte_len() > 0 && self.byte_at(0) == '+' as uint8 { 1 } else { 0 }
    return self.digits_up_to(start, radix, max)
}

/// A whole number of `radix` from `-(max + 1)` to `max`, after an optional
/// sign.
fun str.signed_up_to(radix: uint32, max: uint64): Result<int64, ParseError> {
    val first = if self.byte_len() > 0 { self.byte_at(0) } else { 0 as uint8 }
    if first != '-' as uint8 {
        return Result.Ok(self.unsigned_up_to(radix, max)? as int64)
    }
    val magnitude = self.digits_up_to(1, radix, max + 1)?
    return Result.Ok((0 - magnitude) as int64)
}
