import core.assert.assert_eq
import core.text.*

fun scalar_of(s: str, i: uint64): uint32 {
    return s.decode_at(i).scalar as uint32
}

fun width_of(s: str, i: uint64): uint64 {
    return s.decode_at(i).width
}

fun formed(s: str, i: uint64): bool {
    return s.decode_at(i).well_formed
}

@test fun ascii_decodes_one_byte_at_a_time(): void {
    assert_eq(scalar_of("A", 0), 65 as uint32, "`A`")
    assert_eq(width_of("A", 0), 1 as uint64, "one byte")
    assert_eq(formed("A", 0), true, "well-formed")
    assert_eq(scalar_of("hi", 1), 105 as uint32, "the second byte is its own scalar")
}

@test fun multi_byte_sequences_decode_with_their_widths(): void {
    assert_eq(scalar_of("é", 0), 233 as uint32, "U+00E9, two bytes")
    assert_eq(width_of("é", 0), 2 as uint64, "two")
    assert_eq(scalar_of("€", 0), 8364 as uint32, "U+20AC, three bytes")
    assert_eq(width_of("€", 0), 3 as uint64, "three")
    assert_eq(scalar_of("😀", 0), 128512 as uint32, "U+1F600, four bytes")
    assert_eq(width_of("😀", 0), 4 as uint64, "four")
    assert_eq(formed("😀", 0), true, "and all well-formed")
}

@test fun a_walk_visits_every_scalar_once(): void {
    val s = "aé€😀z"
    var i: uint64 = 0
    var n: uint64 = 0
    var last: uint32 = 0
    while i < 11 {
        val d = s.decode_at(i)
        assert_eq(d.width > 0, true, "a walk inside the string always advances")
        last = d.scalar as uint32
        i = i + d.width
        n = n + 1
    }
    assert_eq(n, 5 as uint64, "five scalars in eleven bytes")
    assert_eq(i, 11 as uint64, "the widths sum to the byte length")
    assert_eq(last, 122 as uint32, "ending on `z`")
}

// Past the end is the only zero width.
@test fun past_the_end_yields_nothing(): void {
    assert_eq(width_of("ab", 2), 0 as uint64, "no bytes to read")
    assert_eq(formed("ab", 2), false, "and nothing well-formed about it")
    assert_eq(width_of("ab", 99), 0 as uint64, "far past the end too")
}

// Written from the other end, so paired errors cannot hide each other.
@test fun encoding_produces_the_expected_bytes(): void {
    val a = (65 as char).encode_utf8()
    assert_eq(a.width, 1 as uint64, "`A` is one byte")
    assert_eq(a.b0, 65 as uint8, "which is its scalar")

    val e = (233 as char).encode_utf8()
    assert_eq(e.width, 2 as uint64, "U+00E9 is two")
    assert_eq(e.b0, 195 as uint8, "0xC3")
    assert_eq(e.b1, 169 as uint8, "0xA9")

    val eur = (8364 as char).encode_utf8()
    assert_eq(eur.width, 3 as uint64, "U+20AC is three")
    assert_eq(eur.b0, 226 as uint8, "0xE2")
    assert_eq(eur.b1, 130 as uint8, "0x82")
    assert_eq(eur.b2, 172 as uint8, "0xAC")

    val g = (128512 as char).encode_utf8()
    assert_eq(g.width, 4 as uint64, "U+1F600 is four")
    assert_eq(g.b0, 240 as uint8, "0xF0")
    assert_eq(g.b1, 159 as uint8, "0x9F")
    assert_eq(g.b2, 152 as uint8, "0x98")
    assert_eq(g.b3, 128 as uint8, "0x80")
}

// Where the width changes.
@test fun encoding_switches_width_at_the_boundaries(): void {
    assert_eq((127 as char).encode_utf8().width, 1 as uint64, "last one-byte scalar")
    assert_eq((128 as char).encode_utf8().width, 2 as uint64, "first two-byte")
    assert_eq((2047 as char).encode_utf8().width, 2 as uint64, "last two-byte")
    assert_eq((2048 as char).encode_utf8().width, 3 as uint64, "first three-byte")
    assert_eq((65535 as char).encode_utf8().width, 3 as uint64, "last three-byte")
    assert_eq((65536 as char).encode_utf8().width, 4 as uint64, "first four-byte")
    assert_eq((1114111 as char).encode_utf8().width, 4 as uint64, "the last code point")
}

@test fun what_utf8_cannot_encode_reports_zero_width(): void {
    assert_eq((55296 as char).encode_utf8().width, 0 as uint64, "U+D800, a surrogate")
    assert_eq((57343 as char).encode_utf8().width, 0 as uint64, "U+DFFF, the last one")
    assert_eq((1114112 as char).encode_utf8().width, 0 as uint64, "past the last code point")
}
