// Searching and predicates over `str`, byte-wise: a byte match lands on a
// character boundary. core.utf8 counts characters.
//
// Extensions, so `path.ends_with(".kf")` and `ends_with(path, ".kf")` both
// resolve without an import.
//
// Each search has an `_in` form taking the haystack's length, so a `String`
// hands over the length it stores instead of rescanning.

import core.option.*

extern "C" fun kf_str_byte_len(s: str): uint64
extern "C" fun kf_str_byte_at(s: str, i: uint64): uint8

/// Not its length in characters.
@prelude
pub fun str.byte_len(): uint64 {
    return unsafe { kf_str_byte_len(self) }
}

@prelude
pub fun str.is_empty(): bool {
    return unsafe { kf_str_byte_len(self) } == 0
}

/// Byte `i`, or 0 past the end, which is also a real byte value.
@prelude
pub fun str.byte_at(i: uint64): uint8 {
    return self.byte_at_in(unsafe { kf_str_byte_len(self) }, i)
}

/// Of a string known to be `n` bytes long.
pub fun str.byte_at_in(n: uint64, i: uint64): uint8 {
    if i >= n { return 0 as uint8 }
    return unsafe { kf_str_byte_at(self, i) }
}

/// `byte_at` under the dissolved `Text` trait's name, for a sibling crate not
/// yet moved across.
@prelude
pub fun str.byte(i: uint64): uint8 {
    return self.byte_at(i)
}

/// The empty prefix always matches.
@prelude
pub fun str.starts_with(prefix: str): bool {
    return self.starts_with_in(unsafe { kf_str_byte_len(self) }, prefix)
}

/// For a caller knowing `self` is `n` bytes.
pub fun str.starts_with_in(n: uint64, prefix: str): bool {
    val pn = unsafe { kf_str_byte_len(prefix) }
    if pn > n { return false }
    var i = 0
    while i < pn {
        if unsafe { kf_str_byte_at(self, i) } != unsafe { kf_str_byte_at(prefix, i) } { return false }
        i = i + 1
    }
    return true
}

/// The empty suffix always matches.
@prelude
pub fun str.ends_with(suffix: str): bool {
    return self.ends_with_in(unsafe { kf_str_byte_len(self) }, suffix)
}

/// For a caller knowing `self` is `n` bytes.
pub fun str.ends_with_in(n: uint64, suffix: str): bool {
    val sn = unsafe { kf_str_byte_len(suffix) }
    if sn > n { return false }
    val base = n - sn
    var i = 0
    while i < sn {
        if unsafe { kf_str_byte_at(self, base + i) } != unsafe { kf_str_byte_at(suffix, i) } { return false }
        i = i + 1
    }
    return true
}

/// The offset of the first occurrence of `needle`, or None. An empty needle
/// is found at 0.
@prelude
pub fun str.index_of(needle: str): uint64? {
    return self.index_of_from_in(unsafe { kf_str_byte_len(self) }, needle, 0)
}

/// The first occurrence at or after `from`, or None.
@prelude
pub fun str.index_of_from(needle: str, from: uint64): uint64? {
    return self.index_of_from_in(unsafe { kf_str_byte_len(self) }, needle, from)
}

/// For a caller knowing `self` is `n` bytes.
pub fun str.index_of_from_in(n: uint64, needle: str, from: uint64): uint64? {
    val nn = unsafe { kf_str_byte_len(needle) }
    if nn == 0 {
        if from > n { return null }
        return from
    }
    if nn > n { return null }
    var i = from
    while i + nn <= n {
        var j = 0
        var same = true
        while j < nn {
            if unsafe { kf_str_byte_at(self, i + j) } != unsafe { kf_str_byte_at(needle, j) } {
                same = false
                j = nn
            } else {
                j = j + 1
            }
        }
        if same { return i }
        i = i + 1
    }
    return null
}

/// The offset of the LAST occurrence of `needle`, or None.
pub fun str.last_index_of(needle: str): uint64? {
    return self.last_index_of_in(unsafe { kf_str_byte_len(self) }, needle)
}

/// For a caller knowing `self` is `n` bytes.
pub fun str.last_index_of_in(n: uint64, needle: str): uint64? {
    val nn = unsafe { kf_str_byte_len(needle) }
    if nn == 0 { return n }
    if nn > n { return null }
    // Downward from the last possible start.
    var i = n - nn
    var searching = true
    while searching {
        var j = 0
        var same = true
        while j < nn {
            if unsafe { kf_str_byte_at(self, i + j) } != unsafe { kf_str_byte_at(needle, j) } {
                same = false
                j = nn
            } else {
                j = j + 1
            }
        }
        if same { return i }
        if i == 0 { searching = false } else { i = i - 1 }
    }
    return null
}

/// Non-overlapping. An empty needle counts 0.
pub fun str.count_of(needle: str): uint64 {
    return self.count_of_in(unsafe { kf_str_byte_len(self) }, needle)
}

/// For a caller knowing `self` is `n` bytes.
pub fun str.count_of_in(n: uint64, needle: str): uint64 {
    val nn = unsafe { kf_str_byte_len(needle) }
    if nn == 0 { return 0 }
    var found = 0
    var at = 0
    var scanning = true
    while scanning {
        when (self.index_of_from_in(n, needle, at)) {
            Some(i) => { found = found + 1
                at = i + nn }
            None => scanning = false
        }
    }
    return found
}

/// Space, tab, newline and carriage return; not Unicode whitespace.
@prelude
pub fun uint8.is_space(): bool {
    return self == 32 || self == 9 || self == 10 || self == 13
}

/// Empty or entirely whitespace, scanned without trimming.
pub fun str.is_blank(): bool {
    return self.is_blank_in(unsafe { kf_str_byte_len(self) })
}

/// For a caller knowing `self` is `n` bytes.
pub fun str.is_blank_in(n: uint64): bool {
    var i = 0
    while i < n {
        if !unsafe { kf_str_byte_at(self, i) }.is_space() { return false }
        i = i + 1
    }
    return true
}

/// Byte-wise, so a multi-byte character matches only whole. The empty needle
/// is in everything.
@prelude
pub fun str.contains(needle: str): bool {
    return self.contains_in(unsafe { kf_str_byte_len(self) }, needle)
}

/// For a caller knowing `self` is `n` bytes.
pub fun str.contains_in(hn: uint64, needle: str): bool {
    val nn: uint64 = unsafe { kf_str_byte_len(needle) }
    if nn == 0 { return true }
    if hn < nn { return false }
    var i = 0
    while i + nn <= hn {
        var j = 0
        var same = true
        while j < nn {
            if unsafe { kf_str_byte_at(self, i + j) } != unsafe { kf_str_byte_at(needle, j) } {
                same = false
                j = nn
            } else {
                j = j + 1
            }
        }
        if same { return true }
        i = i + 1
    }
    return false
}
