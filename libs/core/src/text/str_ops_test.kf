// Edge cases: the empty needle and haystack, matches at the very start and
// end.

import core.assert.*
import core.option.*
import core.text.*

fun found_at(o: uint64?, want: uint64, m: str): void {
    when (o) {
        Some(i) => assert_eq(i, want, m)
        None => assert_eq(true, false, m)
    }
}

fun found_nothing(o: uint64?, m: str): void {
    when (o) {
        Some(_) => assert_eq(true, false, m)
        None => { }
    }
}

@test fun starts_and_ends(): void {
    assert_eq("hello".starts_with("he"), true, "prefix")
    assert_eq("hello".starts_with("hello"), true, "whole string is a prefix")
    assert_eq("he".starts_with("hello"), false, "longer than the string")
    assert_eq("hello".ends_with("lo"), true, "suffix")
    assert_eq("hello".ends_with("hello"), true, "whole string is a suffix")
    assert_eq("lo".ends_with("hello"), false, "longer than the string")
}

// The empty needle is contained and found at the start; if the two disagree a
// split loops forever.
@test fun the_empty_needle(): void {
    assert_eq("abc".starts_with(""), true, "empty prefix")
    assert_eq("abc".ends_with(""), true, "empty suffix")
    assert_eq("".starts_with(""), true, "empty in empty")
    found_at("abc".index_of(""), 0, "empty needle is at 0")
    assert_eq("abc".count_of(""), 0, "but is not counted infinitely often")
}

@test fun searching_finds_first_and_last(): void {
    found_at("hello world".index_of("o"), 4, "first o")
    found_at("hello world".last_index_of("o"), 7, "last o")
    found_at("aaa".index_of("aa"), 0, "overlapping match takes the first")
    found_at("aaa".last_index_of("aa"), 1, "and the last")
    found_nothing("abc".index_of("z"), "absent")
    found_nothing("abc".last_index_of("z"), "absent, backwards")
    found_nothing("ab".index_of("abc"), "needle longer than haystack")
}

@test fun counting_is_non_overlapping(): void {
    assert_eq("a,b,c".count_of(","), 2, "separators")
    // "aaaa" holds two non-overlapping "aa", not three overlapping ones.
    assert_eq("aaaa".count_of("aa"), 2, "non-overlapping")
    assert_eq("abc".count_of("z"), 0, "absent")
}

// Decided by scanning, not by trimming.
@test fun blankness_is_decided_without_building_anything(): void {
    assert_eq("".is_blank(), true, "empty")
    assert_eq("   ".is_blank(), true, "spaces")
    assert_eq(("\t\n \r").is_blank(), true, "the other whitespace")
    assert_eq(" x ".is_blank(), false, "one character is enough")
    assert_eq("x".is_blank(), false, "no whitespace at all")
    assert_eq("  x".is_blank(), false, "trailing content")
}

@test fun the_trait_agrees_with_the_free_functions(): void {
    assert_eq("some/path/file.kf".ends_with(".kf"), "some/path/file.kf".ends_with(".kf"), "ends_with")
    assert_eq("some/path/file.kf".count_of("/"), 2, "count through the trait")
    assert_eq("abc".byte_len(), 3, "byte_len on a literal")
    assert_eq("   ".is_blank(), true, "blank")
    assert_eq(" x ".is_blank(), false, "not blank")
    assert_eq("abc".byte_at(1), 98, "byte at")
    assert_eq("abc".byte_at(99), 0, "byte past the end")
}

@test
fun str_contains_finds_an_interior_match(): void {
    assert_eq("hello world".contains("lo wo"), true, "the needle spans the middle")
    assert_eq("hello".contains("hello"), true, "a whole-string match counts")
    assert_eq("hello".contains("hell"), true, "a prefix counts")
    assert_eq("hello".contains("ello"), true, "a suffix counts")
}

@test
fun str_contains_rejects_what_is_absent(): void {
    assert_eq("hello".contains("world"), false, "nothing in common")
    assert_eq("hell".contains("hello"), false, "a needle longer than the haystack")
    assert_eq("ababab".contains("abb"), false, "a partial run is not a match")
}

@test
fun str_contains_accepts_the_empty_needle(): void {
    assert_eq("hello".contains(""), true, "an empty needle matches at position 0")
    assert_eq("".contains(""), true, "including in an empty haystack")
    assert_eq("".contains("x"), false, "an empty haystack holds nothing else")
}

// Each known-length form answers as its measuring form, at the edges a wrong
// `n` would slip past: the empty string, an index past the end, a start on a
// match.
fun agree_for(s: str, needle: str): void {
    val n = s.byte_len()
    assert_eq(s.starts_with_in(n, needle), s.starts_with(needle), "starts_with agrees")
    assert_eq(s.ends_with_in(n, needle), s.ends_with(needle), "ends_with agrees")
    assert_eq(s.contains_in(n, needle), s.contains(needle), "contains agrees")
    assert_eq(s.count_of_in(n, needle), s.count_of(needle), "count_of agrees")
    assert_eq(s.last_index_of_in(n, needle) == s.last_index_of(needle), true, "last_index_of agrees")
    var from = 0
    while from <= n {
        assert_eq(s.index_of_from_in(n, needle, from) == s.index_of_from(needle, from), true,
            "index_of_from agrees at every start")
        from = from + 1
    }
}

fun agree_over(s: str): void {
    val n = s.byte_len()
    assert_eq(s.is_blank_in(n), s.is_blank(), "is_blank agrees")
    var i = 0
    while i <= n {
        assert_eq(s.byte_at_in(n, i), s.byte_at(i), "byte_at agrees, in range and one past the end")
        i = i + 1
    }
    agree_for(s, "")
    agree_for(s, "a")
    agree_for(s, "ab")
    agree_for(s, "hello")
    agree_for(s, "x")
    agree_for(s, "aa")
}

@test
fun the_known_length_forms_agree_with_the_measuring_ones(): void {
    agree_over("")
    agree_over("a")
    agree_over("hello")
    agree_over("ababab")
    agree_over("  \t\n  ")
    agree_over("aaaa")
}
