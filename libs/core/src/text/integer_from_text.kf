impl FromTextRadix for uint8 {
    static fun from_text_radix(text: str, radix: uint32): Result<uint8, ParseError> {
        return Result.Ok(text.unsigned_up_to(radix, uint8.max_value() as uint64)? as uint8)
    }
}

impl FromText for uint16 {
    static fun from_text(text: str): Result<uint16, ParseError> { return uint16.from_text_radix(text, 10) }
