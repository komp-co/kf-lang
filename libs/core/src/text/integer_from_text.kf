        return Result.Ok(text.unsigned_up_to(radix, uint32.max_value() as uint64)? as uint32)
    }
}

impl FromText for uint64 {
    static fun from_text(text: str): Result<uint64, ParseError> { return uint64.from_text_radix(text, 10) }
}

impl FromTextRadix for uint64 {
    static fun from_text_radix(text: str, radix: uint32): Result<uint64, ParseError> {
        return Result.Ok(text.unsigned_up_to(radix, uint64.max_value())?)
    }
}
