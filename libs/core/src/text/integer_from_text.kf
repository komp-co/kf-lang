// `FromText` and `FromTextRadix` for each whole-number type, through the
// shared digit reader and each type's own limits.

impl FromText for int8 {
    static fun from_text(text: str): Result<int8, ParseError> { return int8.from_text_radix(text, 10) }
}

impl FromTextRadix for int8 {
    static fun from_text_radix(text: str, radix: uint32): Result<int8, ParseError> {
        return Result.Ok(text.signed_up_to(radix, int8.max_value() as uint64)? as int8)
    }
}

impl FromText for int16 {
    static fun from_text(text: str): Result<int16, ParseError> { return int16.from_text_radix(text, 10) }
}

impl FromTextRadix for int16 {
    static fun from_text_radix(text: str, radix: uint32): Result<int16, ParseError> {
        return Result.Ok(text.signed_up_to(radix, int16.max_value() as uint64)? as int16)
    }
}

impl FromText for int32 {
    static fun from_text(text: str): Result<int32, ParseError> { return int32.from_text_radix(text, 10) }
}

impl FromTextRadix for int32 {
    static fun from_text_radix(text: str, radix: uint32): Result<int32, ParseError> {
        return Result.Ok(text.signed_up_to(radix, int32.max_value() as uint64)? as int32)
    }
}

impl FromText for int64 {
    static fun from_text(text: str): Result<int64, ParseError> { return int64.from_text_radix(text, 10) }
}

impl FromTextRadix for int64 {
