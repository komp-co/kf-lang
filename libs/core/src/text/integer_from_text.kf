impl FromTextRadix for uint16 {
    static fun from_text_radix(text: str, radix: uint32): Result<uint16, ParseError> {
        return Result.Ok(text.unsigned_up_to(radix, uint16.max_value() as uint64)? as uint16)
    }
}

impl FromText for uint32 {
    static fun from_text(text: str): Result<uint32, ParseError> { return uint32.from_text_radix(text, 10) }
}

impl FromTextRadix for uint32 {
