// What a character is, rather than which number encodes it.
//
// ASCII only: a non-ASCII scalar answers `false` to every predicate and
// passes through both mappings unchanged.

import core.option.*

/// `0` through `9`.
@prelude
pub fun char.is_digit(): bool {
    val v: uint32 = self as uint32
    return v >= 48 && v <= 57
}

/// `A` through `Z` or `a` through `z`.
@prelude
pub fun char.is_alpha(): bool {
    return self.is_upper() || self.is_lower()
}

/// A letter or a digit.
@prelude
pub fun char.is_alnum(): bool {
    return self.is_alpha() || self.is_digit()
}

/// Space, tab, newline, carriage return, form feed or vertical tab; not
/// Unicode whitespace.
@prelude
pub fun char.is_space(): bool {
    val v: uint32 = self as uint32
    return v == 32 || (v >= 9 && v <= 13)
}

@prelude
pub fun char.is_upper(): bool {
    val v: uint32 = self as uint32
    return v >= 65 && v <= 90
}

@prelude
pub fun char.is_lower(): bool {
    val v: uint32 = self as uint32
    return v >= 97 && v <= 122
}

/// The upper-case form, or `self` when there is none in ASCII.
@prelude
pub fun char.to_upper(): char {
    if self.is_lower() { return ((self as uint32) - 32) as char }
    return self
}

/// The lower-case form, or `self` when there is none in ASCII.
@prelude
pub fun char.to_lower(): char {
    if self.is_upper() { return ((self as uint32) + 32) as char }
    return self
}

/// The value of a decimal digit, or None.
@prelude
pub fun char.digit_value(): uint32? {
    if !self.is_digit() { return null }
    return (self as uint32) - 48
}

/// The value of a digit of `radix`, 2 to 36: `0` to `9`, then `a` to `z` in
/// either case. None for anything else, or a digit past the radix.
@prelude
pub fun char.digit_in(radix: uint32): uint32? {
    val code = self as uint32
    var value: uint32 = radix
    if self.is_digit() { value = code - ('0' as uint32) }
    if self.is_lower() { value = code - ('a' as uint32) + 10 }
    if self.is_upper() { value = code - ('A' as uint32) + 10 }
    if value >= radix { return null }
    return value
}
