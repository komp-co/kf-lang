// Searching a shared slice: membership, binary search, and the extremes.

impl Slice<T: Equal> {
    /// O(n).
    pub fun contains(item: &T): bool {
        return self.index_of(item) != null
    }

    /// The first place `item` is found. O(n).
    pub fun index_of(item: &T): uint64? {
        while i in 0..self.len {
            if self.at(i).equals(item) { return i }
        }
        return null
    }

    /// The last place `item` is found. O(n).
    pub fun last_index_of(item: &T): uint64? {
        var i = self.len
        while i > 0 {
            i = i - 1
            if self.at(i).equals(item) { return i }
        }
        return null
    }

    /// The first elements are `prefix`'s.
    pub fun starts_with(prefix: Slice<T>): bool {
        if prefix.size() > self.len { return false }
        return self.slice(0..prefix.size()).equals_slice(prefix)
    }

    /// The last elements are `suffix`'s.
    pub fun ends_with(suffix: Slice<T>): bool {
        if suffix.size() > self.len { return false }
        return self.slice(self.len - suffix.size()..self.len).equals_slice(suffix)
    }

    fun equals_slice(other: Slice<T>): bool {
        if other.size() != self.len { return false }
        while i in 0..self.len {
            if !self.at(i).equals(other.at(i)) { return false }
        }
        return true
    }
}

impl Slice<T: Compare> {
    /// In an ascending slice: `Ok` with a place holding `item`, or `Err` with
    /// the place it would be inserted to keep the order. O(log n).
    pub fun binary_search(item: &T): Result<uint64, uint64> {
        var low: uint64 = 0
        var high = self.len
        while low < high {
            val probe = low + (high - low) / 2
            val c = self.at(probe).compare(item)
            if c == 0 { return Result.Ok<uint64, uint64>(probe) }
            if c < 0 { low = probe + 1 } else { high = probe }
        }
        return Result.Err<uint64, uint64>(low)
    }
}

impl Slice<T> {
    /// `binary_search` where `place(x)` tells where `x` stands against what
    /// is sought: negative before it, zero at it, positive after it.
    pub fun binary_search_by<F: Call1<&T>>(place: F): Result<uint64, uint64> {
        var low: uint64 = 0
        var high = self.len
        while low < high {
            val probe = low + (high - low) / 2
            val c: int32 = place.call(self.at(probe))
            if c == 0 { return Result.Ok<uint64, uint64>(probe) }
            if c < 0 { low = probe + 1 } else { high = probe }
        }
        return Result.Err<uint64, uint64>(low)
    }
}

impl Slice<T: Compare + Clone> {
    /// A copy of the first smallest element, or null when empty.
    pub fun min(): T? {
        val at = self.place_of_extreme(true) ?: return null
        return self.at(at).clone()
    }

    /// A copy of the first largest element, or null when empty.
    pub fun max(): T? {
        val at = self.place_of_extreme(false) ?: return null
        return self.at(at).clone()
    }

    /// The first smallest element's place, or the first largest's.
    fun place_of_extreme(smallest: bool): uint64? {
        if self.len == 0 { return null }
        var best: uint64 = 0
        while i in 1..self.len {
            if beats(self.at(i).compare(self.at(best)), smallest) { best = i }
        }
        return best
    }
}

impl Slice<T: Clone> {
    /// A copy of the first element with the smallest key, or null when empty.
    /// The key is computed at each comparison.
    pub fun min_by_key<F: Call1<&T>>(key: F): T? {
        val at = self.place_of_extreme_key(&key, true) ?: return null
        return self.at(at).clone()
    }

    /// A copy of the first element with the largest key, or null when empty.
    pub fun max_by_key<F: Call1<&T>>(key: F): T? {
        val at = self.place_of_extreme_key(&key, false) ?: return null
        return self.at(at).clone()
    }

    fun place_of_extreme_key<F: Call1<&T>>(key: &F, smallest: bool): uint64? {
        if self.len == 0 { return null }
        var best: uint64 = 0
        while i in 1..self.len {
            if beats(compare_keys(&key.call(self.at(i)), &key.call(self.at(best))), smallest) { best = i }
        }
        return best
    }

    /// A copy of the first element, or null when empty.
    pub fun first(): T? {
        if self.len == 0 { return null }
        return self.at(0).clone()
    }

    /// A copy of the last element, or null when empty.
    pub fun last(): T? {
        if self.len == 0 { return null }
        return self.at(self.len - 1).clone()
    }
}

/// A comparison that makes a new smallest, or a new largest.
fun beats(order: int32, smallest: bool): bool {
    return if smallest { order < 0 } else { order > 0 }
}
