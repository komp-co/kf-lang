import core.assert.*

fun one_to_five(): int32[5] { return [1, 2, 3, 4, 5] }

@test
fun split_at_cuts_before_the_place(): void {
    val xs = one_to_five()
    val halves = xs.split_at(2)
    assert_eq(halves.left.size() * 10 + halves.right.size(), 23, "two, then three")
}

@test
fun chunks_end_with_a_short_one(): void {
    val xs = one_to_five()
    var sizes: uint64 = 0
    while run in xs.chunks(2) { sizes = sizes * 10 + run.size() }
    assert_eq(sizes, 221, "two, two, then one")
}

@test
fun windows_slide_by_one(): void {
    val xs = one_to_five()
    var firsts: int32 = 0
    while run in xs.windows(3) { firsts = firsts * 10 + run[0] }
    assert_eq(firsts, 123, "three windows of three")
}

@test
fun windows_wider_than_the_slice_are_none(): void {
    val xs = one_to_five()
    var seen = 0
    while _run in xs.windows(6) { seen = seen + 1 }
    assert_eq(seen, 0, "no run of six in five")
}
