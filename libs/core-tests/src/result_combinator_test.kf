import core.assert.*
import testing.test

fun ok(x: int32): Result<int32, bool> { return Result.Ok(x) }

fun err(e: bool): Result<int32, bool> { return Result.Err(e) }

fun positive(x: int32): Result<int32, bool> {
    if x > 0 { return Result.Ok(x) }
    return Result.Err(false)
}

@test fun result_unwrap_or_takes_the_payload(): void {
    assert_eq(ok(4).unwrap_or(0), 4, "Ok wins")
}

@test fun result_unwrap_or_falls_back_on_err(): void {
    assert_eq(err(true).unwrap_or(7), 7, "the default")
}

@test fun result_unwrap_or_else_reads_the_error(): void {
    assert_eq(err(true).unwrap_or_else(|e| if e { 1 } else { 2 }), 1, "made from the error")
}

@test fun result_map_applies_to_ok(): void {
    assert_eq(ok(2).map(|x| x * 10), Result.Ok<int32, bool>(20), "2 * 10")
}

@test fun result_map_passes_an_err_through(): void {
    assert_eq(err(true).map(|x| x * 10), Result.Err<int32, bool>(true), "untouched")
}

@test fun map_err_applies_to_the_error(): void {
    assert_eq(err(true).map_err(|e| if e { 5 } else { 6 }), Result.Err<int32, int32>(5), "bool to int32")
}

@test fun map_err_passes_ok_through(): void {
    assert_eq(ok(3).map_err(|e| if e { 5 } else { 6 }), Result.Ok<int32, int32>(3), "untouched")
}

@test fun result_and_then_chains(): void {
    assert_eq(ok(3).and_then(|x| positive(x - 1)), Result.Ok<int32, bool>(2), "3 - 1 is positive")
}

@test fun result_and_then_takes_the_inner_error(): void {
    assert_eq(ok(1).and_then(|x| positive(x - 1)), Result.Err<int32, bool>(false), "0 is not positive")
}

@test fun result_and_then_passes_an_err_through(): void {
    assert_eq(err(true).and_then(|x| positive(x)), Result.Err<int32, bool>(true), "the first error")
}

@test fun result_or_else_recovers(): void {
    assert_eq(err(true).or_else(|_e| positive(9)), Result.Ok<int32, bool>(9), "recovered")
}

@test fun result_or_else_keeps_ok(): void {
    assert_eq(ok(1).or_else(|_e| positive(9)), Result.Ok<int32, bool>(1), "untouched")
}

@test fun ok_keeps_the_payload(): void {
    assert_eq(ok(1).ok(), Option.Some(1), "Some")
}

@test fun ok_of_an_err_is_none(): void {
    assert_eq(err(true).ok(), null, "dropped")
}

@test fun err_keeps_the_error(): void {
    assert_eq(err(true).err(), Option.Some(true), "Some")
}

@test fun err_of_ok_is_none(): void {
    assert_eq(ok(1).err(), null, "dropped")
}

@test fun a_parse_falls_back_through_ok(): void {
    assert_eq("x".parse<int32>().ok() ?: 0, 0, "the reading the issue wanted")
}

fun attempt_void(n: int32): Result<void, int32> {
    if n < 0 { return Result.Err(n) }
    return Result.Ok()
}

@test fun a_void_result_maps_its_error(): void {
    assert_eq(attempt_void(-2).map_err(|e| e * 2).is_err(), true, "Result<void, E> takes the combinators")
}
