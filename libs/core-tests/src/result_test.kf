import core.assert.*
import core.result.*

// Succeeding with nothing to hand back: the `try_` mutator signature.
fun attempt(n: int32): Result<void, int32> {
    if n < 0 { return Result.Err(n) }
    return Result.Ok()
}

@test
fun a_fallible_operation_can_succeed_with_no_value(): void {
    val got = when (attempt(1)) {
        Ok => 1
        Err(_e) => 0
    }
    assert_eq(got, 1, "Ok carries nothing and is still Ok")
}

@test
fun a_fallible_operation_can_still_fail(): void {
    val got = when (attempt(-3)) {
        Ok => 0
        Err(e) => e
    }
    assert_eq(got, -3, "Err keeps its payload alongside an empty Ok")
}

// The payload-carrying form is untouched.
fun attempt_value(n: int32): Result<int32, int32> {
    if n < 0 { return Result.Err(n) }
    return Result.Ok(n * 2)
}

@test
fun a_result_that_does_carry_a_value_is_unchanged(): void {
    val got = when (attempt_value(21)) {
        Ok(v) => v
        Err(_e) => 0
    }
    assert_eq(got, 42, "a real payload still arrives")
}

// A binder is checked against the variant: `Ok` has no payload at `void`.

// An enum declared in a `_test.kf`, reached only as a type argument.
pub enum ResultTestError { Refused }

fun attempt_enum(n: int32): Result<void, ResultTestError> {
    if n < 0 { return Result.Err(ResultTestError.Refused) }
    return Result.Ok()
}

@test
fun a_void_ok_works_with_a_real_error_enum(): void {
    val ok = when (attempt_enum(1)) {
        Ok => 1
        Err(_e) => 0
    }
    assert_eq(ok, 1, "success with nothing to hand back")
    val bad = when (attempt_enum(-1)) {
        Ok => 1
        Err(_e) => 0
    }
    assert_eq(bad, 0, "and the enum error still arrives")
}

// `void` carries nothing in any generic enum, including a generic body
// written against the payload.
fun nothing_or(n: int32): Option<void> {
    if n < 0 { return null }
    return Option.Some()
}

@test
fun an_option_of_void_is_presence_without_a_value(): void {
    assert_eq(nothing_or(1).is_some(), true, "present, carrying nothing")
    assert_eq(nothing_or(-1).is_none(), true, "absent")
}

// The predicates borrow, so the Result stays usable.
@test
fun result_ok_is_ok(): void {
    val r = attempt_value(21)
    assert_eq(r.is_ok(), true, "Ok is_ok")
    assert_eq(r.is_err(), false, "Ok is not err")
}

@test
fun result_err_is_err(): void {
    val r = attempt_value(-3)
    assert_eq(r.is_err(), true, "Err is_err")
    assert_eq(r.is_ok(), false, "Err is not ok")
}

@test
fun result_predicates_do_not_consume_the_receiver(): void {
    val r = attempt_value(1)
    assert_eq(r.is_ok(), true, "first read")
    assert_eq(r.is_ok(), true, "receiver still readable after the first call")
}

// Results differing only in `E` are distinct instantiations.
@test
fun result_methods_monomorphize_on_both_parameters(): void {
    val a = attempt_value(1)
    val b = attempt_enum(1)
    assert_eq(a.is_ok(), true, "Result<int32, int32> is_ok")
    assert_eq(b.is_ok(), true, "Result<void, ResultTestError> is_ok")
}

@test
fun result_unwrap_returns_the_ok_payload(): void {
    assert_eq(attempt_value(21).unwrap(), 42, "unwrap hands back what Ok holds")
}

// `Result<void, E>` instantiates `unwrap` though nothing calls it.
@test
fun result_unwrap_instantiates_at_a_void_ok(): void {
    assert_eq(attempt(1).is_ok(), true, "Result<void, int32> still compiles with unwrap present")
}
