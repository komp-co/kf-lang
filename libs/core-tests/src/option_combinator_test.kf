import core.assert.*
import testing.test

fun half_of_even(x: int32): int32? {
    if x % 2 == 0 { return x / 2 }
    return null
}

fun some(x: int32): int32? { return Option.Some(x) }

fun none(): int32? { return null }

@test fun unwrap_or_takes_the_payload(): void {
    assert_eq(some(4).unwrap_or(0), 4, "a payload wins")
}

@test fun unwrap_or_falls_back_on_none(): void {
    assert_eq(none().unwrap_or(7), 7, "the default")
}

@test fun unwrap_or_else_makes_the_fallback(): void {
    assert_eq(none().unwrap_or_else(|| 3 * 3), 9, "made on demand")
}

fun never_called(): int32 { panic("the fallback ran") }

@test fun unwrap_or_else_leaves_a_payload(): void {
    assert_eq(some(1).unwrap_or_else(|| never_called()), 1, "the lambda does not run")
}

@test fun map_applies_to_the_payload(): void {
    assert_eq(some(2).map(|x| x + 1), Option.Some(3), "2 + 1")
}

@test fun map_can_change_the_type(): void {
    assert_eq(some(2).map(|x| x > 1), Option.Some(true), "an int32? becomes a bool?")
}

@test fun map_of_none_is_none(): void {
    assert_eq(none().map(|x| x + 1), null, "nothing to map")
}

@test fun and_then_chains_without_nesting(): void {
    assert_eq(some(8).and_then(|x| half_of_even(x)).and_then(|x| half_of_even(x)), Option.Some(2), "8 / 2 / 2")
}

@test fun and_then_stops_at_the_first_none(): void {
    assert_eq(some(6).and_then(|x| half_of_even(x)).and_then(|x| half_of_even(x)), null, "3 is odd")
}

@test fun and_then_of_none_is_none(): void {
    assert_eq(none().and_then(|x| half_of_even(x)), null, "nothing to chain")
}

@test fun or_else_keeps_a_payload(): void {
    assert_eq(some(1).or_else(|| some(2)), Option.Some(1), "the first wins")
}

@test fun or_else_tries_the_alternative(): void {
    assert_eq(none().or_else(|| some(2)), Option.Some(2), "the alternative")
}

@test fun filter_keeps_a_match(): void {
    assert_eq(some(4).filter(|x| *x > 3), Option.Some(4), "4 > 3")
}

@test fun filter_drops_a_miss(): void {
    assert_eq(some(2).filter(|x| *x > 3), null, "2 is not > 3")
}

@test fun is_some_and_tests_the_payload(): void {
    assert_eq(some(5).is_some_and(|x| *x == 5), true, "5 is 5")
}

@test fun is_some_and_of_none_is_false(): void {
    assert_eq(none().is_some_and(|x| *x == 5), false, "no payload")
}

@test fun ok_or_turns_a_payload_into_ok(): void {
    assert_eq(some(1).ok_or(false), Result.Ok<int32, bool>(1), "Ok")
}

@test fun ok_or_turns_none_into_the_error(): void {
    assert_eq(none().ok_or(false), Result.Err<int32, bool>(false), "Err")
}

fun first_or<T>(x: T?, fallback: T): T {
    return x.unwrap_or(fallback)
}

@test fun a_generic_reaches_the_combinators(): void {
    assert_eq(first_or(none(), 11), 11, "an Option over a type parameter")
}

struct Probe { pub val x: int32 }

@test fun a_struct_payload_maps(): void {
    val p: Probe? = Option.Some(Probe { x: 4 })
    assert_eq(p.map(|q| q.x * 2), Option.Some(8), "a field of the payload")
}
