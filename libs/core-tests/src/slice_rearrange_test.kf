import core.assert.*

fun counting(): int32[5] { return [1, 2, 3, 4, 5] }

@test
fun reverse_puts_the_last_first(): void {
    var xs = counting()
    xs.reverse()
    assert_eq(xs[0] * 10 + xs[4], 51, "5 first, 1 last")
}

@test
fun rotate_left_wraps_the_front_to_the_back(): void {
    var xs = counting()
    xs.rotate_left(2)
    assert_eq(xs[0] * 10 + xs[4], 32, "3 first, 2 last")
}

@test
fun rotate_right_wraps_the_back_to_the_front(): void {
    var xs = counting()
    xs.rotate_right(2)
    assert_eq(xs[0] * 10 + xs[4], 43, "4 first, 3 last")
}

@test
fun fill_copies_one_value_everywhere(): void {
    var xs = counting()
    xs.fill(7)
    assert_eq(xs[0] + xs[4], 14, "every element is 7")
}

@test
fun copy_from_takes_each_element_in_place(): void {
    var xs = counting()
    xs.copy_from([9, 8, 7, 6, 5])
    assert_eq(xs[1], 8, "element 1 of the source")
}

@test
fun swap_exchanges_two_elements(): void {
    var xs = counting()
    xs.swap(0, 4)
    assert_eq(xs[0], 5, "the last came first")
}
