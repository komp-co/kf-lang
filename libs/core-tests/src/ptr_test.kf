import core.assert.*
import core.option.*
import core.ptr.*
import testing.test

extern "C" fun kf_alloc(size: uint64): Ptr<uint8>
extern "C" fun kf_free(p: Ptr<void>): void

@test
fun a_null_pointer_is_null(): void {
    assert_eq(ptr_is_null(ptr_null<uint8>()), true, "the null pointer is null")
}

@test
fun a_real_allocation_is_not_null(): void {
    val p = unsafe { kf_alloc(16) }
    assert_eq(ptr_is_null(p), false, "an allocation that succeeded is not null")
    unsafe { kf_free(p as Ptr<void>) }
}

// Coerced straight into `Option<Ptr<T>>`, null is a `Some`.
@test
fun a_null_pointer_coerced_into_an_option_is_still_some(): void {
    val zero = ptr_null<uint8>()
    val wrapped: Ptr<uint8>? = zero
    assert_eq(wrapped.is_some(), true, "`Some(null)` is a distinct inhabitant, not absence")
}

@test
fun ptr_as_option_turns_null_into_absence(): void {
    val absent = ptr_as_option(ptr_null<uint8>())
    assert_eq(absent.is_none(), true, "null crosses the boundary as None")
}

@test
fun ptr_as_option_keeps_a_real_pointer(): void {
    val p = unsafe { kf_alloc(16) }
    val present = ptr_as_option(p)
    assert_eq(present.is_some(), true, "a non-null pointer crosses as Some")
    unsafe { kf_free(p as Ptr<void>) }
}

// A second pointee type must not collide with the first.
@test
fun the_vocabulary_is_generic_over_the_pointee(): void {
    assert_eq(ptr_is_null(ptr_null<uint32>()), true, "uint32 pointee")
    assert_eq(ptr_is_null(ptr_null<uint8>()), true, "uint8 pointee")
}

// A `pub` type from a `_test.kf`, reached only as a pointee and a type
// argument, must be declared in the test TU.
pub struct PtrTestCell { pub val n: int32 }

@test
fun the_vocabulary_works_at_a_user_defined_pointee(): void {
    assert_eq(ptr_is_null(ptr_null<PtrTestCell>()), true, "a struct pointee")
    val live = unsafe { kf_alloc(16) as Ptr<PtrTestCell> }
    assert_eq(ptr_as_option(live).is_some(), true, "a live struct pointer is present")
    unsafe { kf_free(live as Ptr<void>) }
}
