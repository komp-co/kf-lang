import core.assert.*
import core.option.*
import core.result.*

@test
fun try_option_some_branches_to_continue(): void {
    val a: int32? = Option.Some(5)
    when (a.branch()) {
        Continue(v) => { assert_eq(v, 5, "Some branches to Continue carrying the payload") }
        Break(_r) => { fail("Some must not break") }
    }
}

@test
fun try_option_none_branches_to_break(): void {
    val a: int32? = null
    when (a.branch()) {
        Continue(_v) => { fail("None must not continue") }
        Break(_r) => { }
    }
}

@test
fun try_result_ok_branches_to_continue(): void {
    val a: Result<int32, int32> = Result.Ok<int32, int32>(7)
    when (a.branch()) {
        Continue(v) => { assert_eq(v, 7, "Ok branches to Continue carrying the payload") }
        Break(_r) => { fail("Ok must not break") }
    }
}

@test
fun try_result_err_branches_to_break(): void {
    val a: Result<int32, int32> = Result.Err<int32, int32>(9)
    when (a.branch()) {
        Continue(_v) => { fail("Err must not continue") }
        Break(_r) => { }
    }
}

@test
fun try_option_from_output_rebuilds_a_some(): void {
    val a: int32? = Option.from_output<int32>(3)
    assert_eq(a.is_some(), true, "from_output builds a Some")
    assert_eq(a.unwrap(), 3, "from_output keeps the payload")
}

@test
fun try_result_from_output_rebuilds_an_ok(): void {
    val a: Result<int32, int32> = Result.from_output<int32, int32>(4)
    assert_eq(a.is_ok(), true, "from_output builds an Ok")
    assert_eq(a.unwrap(), 4, "from_output keeps the payload")
}

// `Option`'s residual is `Option<Never>`, `Result`'s is `Result<Never, E>`.

@test
fun try_option_residual_rebuilds_a_none(): void {
    val a: int32? = null
    when (a.branch()) {
        Continue(_v) => { fail("None must not continue") }
        Break(r) => {
            val rebuilt: int32? = Option.from_residual<int32>(r)
            assert_eq(rebuilt.is_none(), true, "an Option residual rebuilds a None")
        }
    }
}

@test
fun try_result_residual_carries_the_error_across(): void {
    val a: Result<int32, int32> = Result.Err<int32, int32>(11)
    when (a.branch()) {
        Continue(_v) => { fail("Err must not continue") }
        Break(r) => {
            val rebuilt: Result<int32, int32> = Result.from_residual<int32, int32>(r)
            assert_eq(rebuilt.is_err(), true, "a Result residual rebuilds an Err")
            when (rebuilt) {
                Ok(_v) => { fail("rebuilt must not be Ok") }
                Err(e) => { assert_eq(e, 11, "the error survives the round trip") }
            }
        }
    }
}
