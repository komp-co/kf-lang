import core.assert.assert_eq
import testing.test

fun unordered_float64(): float64 {
    val zero: float64 = 0 as float64
    return zero / zero
}

@test fun float64_nan_sorts_after_a_number(): void {
    assert_eq(unordered_float64() > (1 as float64), true, "NaN sorts after a number")
}

@test fun float64_number_sorts_before_nan(): void {
    assert_eq((1 as float64) < unordered_float64(), true, "a number sorts before NaN")
}

@test fun float64_nan_is_not_less_than_or_equal_to_a_number(): void {
    assert_eq(unordered_float64() <= (1 as float64), false, "NaN is not before a number")
}

@test fun float64_number_is_not_greater_than_or_equal_to_nan(): void {
    assert_eq((1 as float64) >= unordered_float64(), false, "a number is not after NaN")
}

// A comparison operator on a bounded type parameter consults the bound.

fun ge_through_a_bound<T: Compare>(a: T, b: T): bool {
    return a >= b
}

fun lt_through_a_bound<T: Compare>(a: T, b: T): bool {
    return a < b
}

@test fun an_operator_resolves_through_a_type_parameter_bound(): void {
    val big: uint64 = 7
    val small: uint64 = 3
    assert_eq(ge_through_a_bound<uint64>(big, small), true, "7 >= 3 through a bound")
    assert_eq(ge_through_a_bound<uint64>(small, big), false, "3 is not >= 7 through a bound")
    // The equal case separates `>=` from `>`.
    assert_eq(ge_through_a_bound<uint64>(big, big), true, "7 >= 7 through a bound")
}

@test fun an_operator_through_a_bound_agrees_with_the_explicit_call(): void {
    val a: int32 = -4
    val b: int32 = 9
    assert_eq(lt_through_a_bound<int32>(a, b), a.compare(b) < 0, "`<` and `compare` agree")
    assert_eq(lt_through_a_bound<int32>(b, a), b.compare(a) < 0, "and agree the other way")
    assert_eq(lt_through_a_bound<int32>(a, a), false, "a value is not `<` itself")
}
