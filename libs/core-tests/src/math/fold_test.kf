// The empty case is the one worth pinning.

import core.assert.assert_eq
import testing.test

@test fun sum_adds_everything_a_range_yields(): void {
    assert_eq((1..5).sum(), 10, "1 + 2 + 3 + 4")
}

@test fun sum_of_nothing_is_zero(): void {
    assert_eq((3..3).sum(), 0, "the additive identity, not an error")
}

@test fun product_multiplies_everything_a_range_yields(): void {
    assert_eq((2..5).product(), 24, "2 * 3 * 4")
}

@test fun product_of_nothing_is_one(): void {
    assert_eq((3..3).product(), 1, "the multiplicative identity")
}
