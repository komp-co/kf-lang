// Rounding's cases: negatives, exact halves, values already whole. The libm
// functions are checked for wiring and conventions, not arithmetic.

import core.assert.assert_eq
import core.display.assert_eq
import core.math.*
import core_tests.renders_as
import testing.test

fun eq(a: float64, b: float64, m: str): void {
    assert_eq(close_to(a, b, 0.000000001), true, m)
}

@test fun truncation_goes_toward_zero(): void {
    eq((2.7).trunc(), 2.0, "positive")
    eq((-2.7).trunc(), -2.0, "negative goes toward zero, not down")
    eq((2.0).trunc(), 2.0, "already integral")
    eq((0.0).trunc(), 0.0, "zero")
}

@test fun floor_goes_down_and_ceil_goes_up(): void {
    eq((2.7).floor(), 2.0, "floor positive")
    eq((-2.7).floor(), -3.0, "floor negative")
    eq((2.0).floor(), 2.0, "floor of an integer is itself")
    eq((2.1).ceil(), 3.0, "ceil positive")
    eq((-2.1).ceil(), -2.0, "ceil negative")
    eq((2.0).ceil(), 2.0, "ceil of an integer is itself")
}

// Halves go AWAY from zero, so (-x).round() == -(x).round().
@test fun rounding_takes_halves_away_from_zero(): void {
    eq((2.5).round(), 3.0, "positive half")
    eq((-2.5).round(), -3.0, "negative half")
    eq((2.4).round(), 2.0, "below the half")
    eq((2.6).round(), 3.0, "above the half")
    eq((-2.4).round(), -2.0, "negative below")
    eq((0.0).round(), 0.0, "zero")
}

@test fun absolute_value_and_sign(): void {
    eq((-3.5).abs(), 3.5, "negative")
    eq((3.5).abs(), 3.5, "positive")
    eq((0.0).abs(), 0.0, "zero")
    // One `abs`; the width comes from the value.
    assert_eq((-7).abs(), 7, "int32")
    val wide: int64 = 0 - 7
    assert_eq(wide.abs(), 7, "int64")
    val small: int8 = 0 - 3
    assert_eq(small.abs(), 3, "int8")
    val short: int16 = 0 - 4
    assert_eq(short.abs(), 4, "int16")
    // Unsigned gets the identity.
    val positive: uint32 = 9
    assert_eq(positive.abs(), 9, "uint32")
    eq((-9.0).sign(), -1.0, "negative")
    eq((9.0).sign(), 1.0, "positive")
    // Zero has no sign.
    eq((0.0).sign(), 0.0, "zero")
}

@test fun min_max_and_clamp_are_generic(): void {
    assert_eq(min<int32>(3, 7), 3, "int min")
    assert_eq(max<int32>(3, 7), 7, "int max")
    assert_eq(min<int32>(4, 4), 4, "equal")
    eq(min<float64>(1.5, 2.5), 1.5, "float min")
    assert_eq(clamp<int32>(99, 0, 10), 10, "above")
    assert_eq(clamp<int32>(-5, 0, 10), 0, "below")
    assert_eq(clamp<int32>(5, 0, 10), 5, "inside")
}

@test fun interpolation(): void {
    eq(lerp(0.0, 10.0, 0.0), 0.0, "at a")
    eq(lerp(0.0, 10.0, 1.0), 10.0, "at b")
    eq(lerp(0.0, 10.0, 0.25), 2.5, "quarter")
    eq(lerp(0.0, 10.0, 2.0), 20.0, "extrapolates past b")
}

@test fun close_to_handles_what_equality_cannot(): void {
    assert_eq(0.1 + 0.2 == 0.3, false, "exact equality fails here")
    assert_eq(close_to(0.1 + 0.2, 0.3, 0.000000001), true, "close_to does not")
    assert_eq(close_to(1.0, 2.0, 0.5), false, "and still says no when it should")
}

@test fun roots_and_powers(): void {
    eq((16.0).sqrt(), 4.0, "sqrt")
    eq((0.0).sqrt(), 0.0, "sqrt of zero")
    eq((2.0).pow(10.0), 1024.0, "pow")
    eq((9.0).pow(0.5), 3.0, "fractional exponent")
    // cbrt handles negatives.
    eq((-27.0).cbrt(), -3.0, "cube root of a negative")
}

// `ln` is base e and `log10` base 10.
@test fun logarithms_state_their_base(): void {
    eq(float64.e().ln(), 1.0, "natural log of e")
    eq((1.0).ln(), 0.0, "natural log of 1")
    eq((1024.0).log2(), 10.0, "base 2")
    eq((1000.0).log10(), 3.0, "base 10")
    eq((0.0).exp(), 1.0, "exp of zero")
    eq((2.5).exp().ln(), 2.5, "exp and ln invert")
}

@test fun trigonometry_and_angle_conversion(): void {
    eq(float64.pi().to_degrees(), 180.0, "radians to degrees")
    eq((180.0).to_radians(), float64.pi(), "degrees to radians")
    eq((0.0).sin(), 0.0, "sin of zero")
    eq((90.0).to_radians().sin(), 1.0, "sin of a right angle")
    eq((0.0).cos(), 1.0, "cos of zero")
    // atan2 resolves the quadrant; the receiver is y.
    eq((1.0).atan2(1.0), float64.pi() / 4.0, "first quadrant")
    eq((1.0).atan2(-1.0), float64.pi() * 3.0 / 4.0, "second quadrant")
}

@test fun remainder_and_hypotenuse(): void {
    eq((7.5).fmod(2.0), 1.5, "remainder")
    eq((-7.5).fmod(2.0), -1.5, "keeps the dividend's sign")
    eq((3.0).hypot(4.0), 5.0, "hypotenuse")
}

// Floats print with the fewest digits that read back as the same value.
@test fun floats_display_exactly_but_briefly(): void {
    assert_eq(renders_as(&((0.1)), "0.1"), true, "short when short is honest")
    assert_eq(renders_as(&((0.1 + 0.2)), "0.30000000000000004"), true, "exact when it is not")
    assert_eq(renders_as(&((2.0)), "2"), true, "an integral float")
    assert_eq(renders_as(&((-3.75)), "-3.75"), true, "negative")
    assert_eq(renders_as(&((0.0)), "0"), true, "zero")
}
