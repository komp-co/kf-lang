import core.assert.*
import core.range.*
import testing.test

fun sum_i32(r: Range<int32>): int32 {
    var total = 0
    while v in r { total = total + v }
    return total
}

fun count_i32(r: Range<int32>): int32 {
    var n = 0
    while _v in r { n = n + 1 }
    return n
}

/// -1 when it yields none.
fun first_i32(r: Range<int32>): int32 {
    while v in r { return v }
    return -1
}

@test fun a_range_yields_its_start_and_stops_before_its_end(): void {
    assert_eq(sum_i32(range(0, 4, 1)), 6, "0 + 1 + 2 + 3")
}

@test fun a_range_of_one_yields_one_value(): void {
    assert_eq(count_i32(range(7, 8, 1)), 1, "just 7")
}

@test fun an_empty_range_yields_nothing(): void {
    assert_eq(count_i32(range(3, 3, 1)), 0, "start meets end immediately")
}

// A reversed range is empty, not unbounded.
@test fun a_reversed_range_yields_nothing(): void {
    assert_eq(count_i32(range(5, 2, 1)), 0, "end is already behind start")
}

@test fun a_step_advances_by_more_than_one(): void {
    assert_eq(sum_i32(range(0, 10, 3)), 18, "0 + 3 + 6 + 9")
}

// `iter()` borrows the Range, so one range drives many loops.
@test fun a_range_can_be_iterated_more_than_once(): void {
    val r = range(0, 3, 1)
    assert_eq(sum_i32(r), 3, "first pass")
    assert_eq(sum_i32(r), 3, "second pass sees the same values")
}

@test fun a_range_keeps_its_endpoints(): void {
    val r = range(2, 9, 1)
    assert_eq(r.start, 2, "start")
    assert_eq(r.end, 9, "end")
    assert_eq(r.step, 1, "step")
}

@test fun a_range_carries_its_element_type(): void {
    val r = range(0 as uint64, 3 as uint64, 1 as uint64)
    var n: uint64 = 0
    while v in r { n = n + v }
    assert_eq(n, 3 as uint64, "0 + 1 + 2 at uint64")
}

@test fun an_inclusive_range_yields_its_end(): void {
    assert_eq(sum_i32(range_inclusive(0, 4, 1)), 10, "0 + 1 + 2 + 3 + 4")
}

@test fun an_inclusive_range_is_one_longer_than_the_exclusive_one(): void {
    assert_eq(count_i32(range(0, 4, 1)), 4, "0..4 is four values")
    assert_eq(count_i32(range_inclusive(0, 4, 1)), 5, "0..=4 is five")
}

// Inclusivity is read at the end.
@test fun an_empty_range_becomes_one_value_when_inclusive(): void {
    assert_eq(count_i32(range(3, 3, 1)), 0, "3..3 is empty")
    assert_eq(count_i32(range_inclusive(3, 3, 1)), 1, "3..=3 is one value")
}

@test fun an_inclusive_range_whose_step_passes_the_end_stops(): void {
    assert_eq(sum_i32(range_inclusive(0, 10, 3)), 18, "0 + 3 + 6 + 9")
    assert_eq(count_i32(range_inclusive(0, 9, 3)), 4, "0, 3, 6, 9 — 9 is hit exactly")
}

// `end + 1` is not a `uint8`: the `done` latch ends the loop. The `break`
// makes a regression fail instead of hang.
@test fun an_inclusive_range_ending_at_the_type_maximum_terminates(): void {
    val lo: uint8 = 250
    val hi: uint8 = 255
    var n: uint64 = 0
    var last: uint8 = 0
    while b in range_inclusive(lo, hi, 1 as uint8) {
        n = n + 1
        last = b
        if n > 100 { break }
    }
    assert_eq(n, 6 as uint64, "250 through 255 is six values")
    assert_eq(last, 255 as uint8, "and the last one is the maximum")
}

@test fun an_inclusive_range_reports_itself_as_inclusive(): void {
    assert_eq(range(2, 9, 1).inclusive, false, "`..` is exclusive")
    assert_eq(range_inclusive(2, 9, 1).inclusive, true, "`..=` is not")
}

// Stepping over the maximum: 250, 252, 254, then 256 is not a `uint8`.
@test fun an_inclusive_range_that_steps_over_the_maximum_terminates(): void {
    var n: uint64 = 0
    var last: uint8 = 0
    while b in range_inclusive(250 as uint8, 255 as uint8, 2 as uint8) {
        n = n + 1
        last = b
        if n > 100 { break }
    }
    assert_eq(n, 3 as uint64, "250, 252, 254")
    assert_eq(last, 254 as uint8, "and it stops below the maximum")
}

// The exclusive form: 260 would wrap to 4.
@test fun an_exclusive_range_that_steps_over_the_maximum_terminates(): void {
    var n: uint64 = 0
    while _b in range(250 as uint8, 255 as uint8, 10 as uint8) {
        n = n + 1
        if n > 100 { break }
    }
    assert_eq(n, 1 as uint64, "250 alone — one step further is out of the type")
}

@test fun a_stepped_exclusive_range_is_unchanged(): void {
    assert_eq(sum_i32(range(0, 10, 3)), 18, "0 + 3 + 6 + 9")
    assert_eq(count_i32(range(0, 9, 3)), 3, "0, 3, 6 — 9 is the excluded end")
}

@test fun a_descending_range_counts_down(): void {
    assert_eq(sum_i32(range(5, 0, 1).down()), 15, "5 + 4 + 3 + 2 + 1")
    assert_eq(count_i32(range(5, 0, 1).down()), 5, "0 is the excluded end")
}

@test fun a_descending_inclusive_range_reaches_its_end(): void {
    assert_eq(count_i32(range_inclusive(5, 0, 1).down()), 6, "5 through 0")
    assert_eq(sum_i32(range_inclusive(5, 0, 1).down()), 15, "adding 0 changes no sum")
}

@test fun a_descending_range_strides(): void {
    assert_eq(sum_i32(range(10, 0, 3).down()), 22, "10 + 7 + 4 + 1")
}

// `down()` on an ascending pair is empty, not reversed.
@test fun down_does_not_swap_the_endpoints(): void {
    assert_eq(count_i32(range(0, 10, 1).down()), 0, "0 is already below 10")
    assert_eq(count_i32(range(0, 10, 1)), 10, "and upward it is unchanged")
}

// Counting down to 0 over an unsigned type: one below 0 wraps to 255.
@test fun a_descending_range_ending_at_zero_terminates_on_an_unsigned_type(): void {
    var n: uint64 = 0
    var last: uint8 = 9
    while b in range_inclusive(3 as uint8, 0 as uint8, 1 as uint8).down() {
        n = n + 1
        last = b
        if n > 100 { break }
    }
    assert_eq(n, 4 as uint64, "3, 2, 1, 0")
    assert_eq(last, 0 as uint8, "and it stops at zero")
}

// A step passing zero rather than landing on it.
@test fun a_descending_range_that_steps_past_zero_terminates(): void {
    var n: uint64 = 0
    while _b in range_inclusive(5 as uint8, 0 as uint8, 2 as uint8).down() {
        n = n + 1
        if n > 100 { break }
    }
    assert_eq(n, 3 as uint64, "5, 3, 1 — one more step is not a uint8")
}

@test fun a_range_reports_its_direction(): void {
    assert_eq(range(5, 0, 1).descending, false, "`..` travels upward")
    assert_eq(range(5, 0, 1).down().descending, true, "`down()` does not")
    assert_eq(range_inclusive(5, 0, 1).down().inclusive, true, "and keeps its inclusivity")
}

// Indices backwards: `(0..n).rev()` is `n-1 ... 0`, with no `n == 0`
// underflow.
@test fun reversing_a_range_walks_it_backwards(): void {
    assert_eq(count_i32(range(0, 5, 1).rev()), 5, "five values either way")
    assert_eq(sum_i32(range(0, 5, 1).rev()), 10, "0 + 1 + 2 + 3 + 4")
    assert_eq(first_i32(range(0, 5, 1).rev()), 4, "starts at n - 1, not at n")
}

@test fun reversing_an_inclusive_range_starts_at_its_end(): void {
    assert_eq(first_i32(range_inclusive(0, 5, 1).rev()), 5, "0..=5 ends at 5")
    assert_eq(count_i32(range_inclusive(0, 5, 1).rev()), 6, "six values")
}

// `range(0, 10, 3)` reversed starts at 9; downward from 10 gives 10, 7, 4, 1.
@test fun reversing_a_stepped_range_starts_at_its_last_element(): void {
    assert_eq(first_i32(range(0, 10, 3).rev()), 9, "the last element, not the endpoint")
    assert_eq(first_i32(range(10, 0, 3).down()), 10, "down() starts at the endpoint")
    assert_eq(sum_i32(range(0, 10, 3).rev()), 18, "same elements: 9 + 6 + 3 + 0")
    assert_eq(sum_i32(range(0, 10, 3)), 18, "as forwards")
}

// 0..9 by 3 is 0, 3, 6: the last element is 6, not 9.
@test fun reversing_a_range_whose_step_divides_the_span(): void {
    assert_eq(first_i32(range(0, 9, 3).rev()), 6, "9 is the excluded end")
    assert_eq(count_i32(range(0, 9, 3).rev()), 3, "0, 3, 6")
    assert_eq(first_i32(range_inclusive(0, 9, 3).rev()), 9, "but inclusive it is reached")
}

@test fun reversing_a_descending_range_ascends(): void {
    assert_eq(first_i32(range(10, 0, 3).down().rev()), 1, "10, 7, 4, 1 backwards starts at 1")
    assert_eq(sum_i32(range(10, 0, 3).down().rev()), 22, "same elements")
}

@test fun reversing_an_empty_range_is_empty(): void {
    assert_eq(count_i32(range(0, 0, 1).rev()), 0, "nothing to reverse")
    assert_eq(count_i32(range(5, 0, 1).rev()), 0, "n..0 is empty, so is its reverse")
}

@test fun reversing_twice_is_the_original(): void {
    assert_eq(sum_i32(range(0, 5, 1).rev().rev()), 10, "same sum")
    assert_eq(first_i32(range(0, 5, 1).rev().rev()), 0, "and the same first element")
    assert_eq(first_i32(range(0, 10, 3).rev().rev()), 0, "stepped too")
}

@test fun is_empty_agrees_with_iterating(): void {
    assert_eq(range(0, 0, 1).is_empty(), true, "0..0")
    assert_eq(range_inclusive(0, 0, 1).is_empty(), false, "0..=0 yields one")
    assert_eq(range(5, 0, 1).is_empty(), true, "n..0 ascending")
    assert_eq(range(5, 0, 1).down().is_empty(), false, "but not going down")
}

@test fun by_strides_the_interval(): void {
    assert_eq(sum_i32(range(0, 10, 1).by(3)), 18, "0 + 3 + 6 + 9")
    assert_eq(count_i32(range(0, 10, 1).by(2)), 5, "0, 2, 4, 6, 8")
}

@test fun by_keeps_inclusivity_and_direction(): void {
    assert_eq(count_i32(range_inclusive(0, 10, 1).by(5)), 3, "0, 5, 10")
    assert_eq(first_i32(range(10, 0, 1).down().by(4)), 10, "still descending")
    assert_eq(sum_i32(range(10, 0, 1).down().by(4)), 18, "10 + 6 + 2")
}

// A zero step gives an empty range, as `n..0` does.
@test fun a_zero_step_yields_nothing_rather_than_looping(): void {
    var n: uint64 = 0
    while _v in range(0, 10, 1).by(0) {
        n = n + 1
        if n > 100 { break }
    }
    assert_eq(n, 0 as uint64, "a zero step describes no elements")
    assert_eq(range(0, 10, 1).by(0).is_empty(), true, "and says so")
}

@test fun by_composes_with_rev(): void {
    assert_eq(first_i32(range(0, 10, 1).by(3).rev()), 9, "0, 3, 6, 9 backwards")
    assert_eq(sum_i32(range(0, 10, 1).by(3).rev()), 18, "same elements")
}
