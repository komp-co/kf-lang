import core.assert.*
import core.display.*

@test fun a_char_displays_as_itself(): void {
    assert_eq(renders_as(&('A'), "A"), true, "one byte")
    assert_eq(renders_as(&('é'), "é"), true, "two bytes, one character")
    assert_eq(renders_as(&('€'), "€"), true, "three")
    assert_eq(renders_as(&('😀'), "😀"), true, "four")
}

// As long as the UTF-8 encoding.
@test fun a_char_renders_its_encoding_not_its_number(): void {
    assert_eq(rendered_len(&('A')), 1 as uint64, "`A` is one byte")
    assert_eq(rendered_len(&('é')), 2 as uint64, "U+00E9 is two")
    assert_eq(rendered_len(&('€')), 3 as uint64, "U+20AC is three")
    assert_eq(rendered_len(&('😀')), 4 as uint64, "U+1F600 is four")
    assert_eq(renders_as(&(('é' as uint32)), "233"), true, "the code point, when asked for")
}

// A surrogate renders as nothing, not U+FFFD.
@test fun an_unencodable_scalar_renders_empty(): void {
    val surrogate: char = 55296 as char
    assert_eq(rendered_len(&(surrogate)), 0 as uint64, "U+D800 encodes to nothing")
    val past_end: char = 1114112 as char
    assert_eq(rendered_len(&(past_end)), 0 as uint64, "and so does a value past the last code point")
}

/// Through the bound, as generic code renders.
fun shown_as<T: Display>(v: T, expected: str): bool {
    var d = new_render_digest()
    v.display(&var d)
    return digest_matches(&d, expected)
}

@test fun a_char_satisfies_the_display_bound(): void {
    assert_eq(shown_as('k', "k"), true, "generic code can render a char")
    assert_eq(shown_as('€', "€"), true, "at any width")
}
