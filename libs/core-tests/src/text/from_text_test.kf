import core.assert.assert_eq
import core.renders_as

@test fun a_decimal_reads_as_its_value(): void {
    assert_eq("42".parse<int32>(), Result.Ok(42), "plain digits")
}

@test fun a_plus_sign_is_accepted(): void {
    assert_eq("+7".parse<int32>(), Result.Ok(7), "an explicit positive sign")
}

@test fun a_minus_sign_negates(): void {
    assert_eq("-128".parse<int8>(), Result.Ok(-128 as int8), "the most negative int8")
}

@test fun the_largest_value_fits(): void {
    assert_eq("18446744073709551615".parse<uint64>(), Result.Ok(18446744073709551615 as uint64), "uint64 max")
}

@test fun the_most_negative_int64_fits(): void {
    val min = (-9223372036854775807 as int64) - 1
    assert_eq("-9223372036854775808".parse<int64>(), Result.Ok(min), "int64 min has no positive twin")
}

@test fun one_past_the_largest_overflows(): void {
    assert_eq("256".parse<uint8>(), Result.Err<uint8, ParseError>(ParseError.Overflow), "uint8 holds 255")
}

@test fun one_past_the_smallest_overflows(): void {
    assert_eq("-129".parse<int8>(), Result.Err<int8, ParseError>(ParseError.Overflow), "int8 holds -128")
}

@test fun an_unsigned_type_refuses_a_minus_sign(): void {
    assert_eq("-1".parse<uint32>(), Result.Err<uint32, ParseError>(ParseError.InvalidDigit(0)), "no negative uint")
}

@test fun empty_text_is_empty(): void {
    assert_eq("".parse<int32>(), Result.Err<int32, ParseError>(ParseError.Empty), "nothing to read")
}

@test fun a_sign_alone_is_an_invalid_digit(): void {
    assert_eq("-".parse<int32>(), Result.Err<int32, ParseError>(ParseError.InvalidDigit(1)), "a digit was due")
}

@test fun a_stray_byte_is_found_by_index(): void {
    assert_eq("12a4".parse<int32>(), Result.Err<int32, ParseError>(ParseError.InvalidDigit(2)), "the `a`")
}

@test fun space_is_not_a_digit(): void {
    assert_eq(" 1".parse<int32>(), Result.Err<int32, ParseError>(ParseError.InvalidDigit(0)), "no trimming")
}

@test fun hex_reads_in_radix_sixteen(): void {
    assert_eq(uint32.from_text_radix("fF", 16), Result.Ok(255 as uint32), "either case")
}

@test fun binary_reads_in_radix_two(): void {
    assert_eq(int32.from_text_radix("-101", 2), Result.Ok(-5), "a sign works in any radix")
}

@test fun a_digit_past_the_radix_is_invalid(): void {
    val no_nine = Result.Err<uint8, ParseError>(ParseError.InvalidDigit(1))
    assert_eq(uint8.from_text_radix("19", 8), no_nine, "no 9 in octal")
}

@test fun a_float_reads_its_fraction(): void {
    assert_eq("2.5".parse<float64>(), Result.Ok(2.5), "a decimal fraction")
}

@test fun a_float_reads_its_exponent(): void {
    assert_eq("-1.5e3".parse<float64>(), Result.Ok(-1500.0), "an exponent")
}

@test fun a_float32_reads_too(): void {
    assert_eq("0.5".parse<float32>(), Result.Ok(0.5 as float32), "float32")
}

@test fun infinity_is_a_float(): void {
    assert_eq("inf".parse<float64>().unwrap() > 1.0e308, true, "inf reads as infinity")
}

@test fun a_float_with_trailing_text_is_invalid(): void {
    assert_eq("1.5x".parse<float64>(), Result.Err<float64, ParseError>(ParseError.InvalidDigit(3)), "the `x`")
}

@test fun a_hex_float_is_refused(): void {
    assert_eq("0x1p3".parse<float64>(), Result.Err<float64, ParseError>(ParseError.InvalidDigit(1)), "decimal only")
}

@test fun empty_text_is_no_float(): void {
    assert_eq("".parse<float64>(), Result.Err<float64, ParseError>(ParseError.Empty), "nothing to read")
}

@test fun a_parse_error_says_where(): void {
    assert_eq(renders_as(&ParseError.InvalidDigit(3), "invalid digit at byte 3"), true, "the index is named")
}
