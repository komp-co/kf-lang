// What a `Display` renders, checked without a `String`: the sink hashes the
// bytes as `hash_bytes` does and counts them.

pub struct RenderDigest {
    pub var hash: uint64
    pub var len: uint64
}

impl Write for RenderDigest {
    mutating fun write_str(s: str): void {
        var i: uint64 = 0
        while i < s.byte_len() {
            self.hash = self.hash ^ (s.byte_at(i) as uint64)
            self.hash = self.hash * 0x100000001b3
            i = i + 1
        }
        self.len = self.len + s.byte_len()
    }
}

pub fun new_render_digest(): RenderDigest {
    return RenderDigest { hash: 0xcbf29ce484222325, len: 0 }
}

/// Whether the text written into `d` is exactly `expected`.
pub fun digest_matches(d: &RenderDigest, expected: str): bool {
    return d.len == expected.byte_len() && d.hash == hash_bytes(expected)
}

/// Whether `v` renders exactly as `expected`.
pub fun renders_as(v: &dyn Display, expected: str): bool {
    var d = new_render_digest()
    v.display(&var d)
    return digest_matches(&d, expected)
}

/// How many bytes `v` renders to.
pub fun rendered_len(v: &dyn Display): uint64 {
    var d = new_render_digest()
    v.display(&var d)
    return d.len
}
