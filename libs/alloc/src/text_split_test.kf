// Split and join are inverses: empty pieces are kept, the ends included.

import core.assert.assert_eq
import alloc.text_split.*
import testing.test

fun piece(parts: &List<String>, i: uint64): str {
    return parts.at(i).as_str()
}

@test fun splitting_keeps_empty_pieces(): void {
    val p = "a,b,,c".split(",")
    assert_eq(p.size(), 4, "count")
    assert_eq(piece(&p, 0), "a", "first")
    assert_eq(piece(&p, 2), "", "the empty piece between two separators")
    assert_eq(piece(&p, 3), "c", "last")
}

@test fun leading_and_trailing_separators_make_empty_ends(): void {
    val p = ",a,".split(",")
    assert_eq(p.size(), 3, "count")
    assert_eq(piece(&p, 0), "", "leading")
    assert_eq(piece(&p, 1), "a", "middle")
    assert_eq(piece(&p, 2), "", "trailing")
}

@test fun splitting_and_joining_round_trip(): void {
    val original = "a,b,,c,"
    assert_eq((&original.split(",")).join(",").as_str(), original, "round trip")
}

@test fun a_string_without_the_separator_is_one_piece(): void {
    val p = "abc".split(",")
    assert_eq(p.size(), 1, "count")
    assert_eq(piece(&p, 0), "abc", "the whole string")
}

@test fun an_empty_separator_yields_the_whole_string(): void {
    val p = "abc".split("")
    assert_eq(p.size(), 1, "count")
    assert_eq(piece(&p, 0), "abc", "whole")
}

@test fun a_multi_byte_separator_works(): void {
    val p = "a::b::c".split("::")
    assert_eq(p.size(), 3, "count")
    assert_eq(piece(&p, 1), "b", "middle")
}

// A trailing newline adds no empty line.
@test fun lines_do_not_gain_a_trailing_empty(): void {
    val l = ("one\ntwo\n").lines()
    assert_eq(l.size(), 2, "count")
    assert_eq(piece(&l, 1), "two", "last")
}

@test fun lines_strip_carriage_returns(): void {
    val l = ("one\r\ntwo\r\n").lines()
    assert_eq(l.size(), 2, "count")
    assert_eq(piece(&l, 0), "one", "CR removed")
    assert_eq(piece(&l, 1), "two", "CR removed at the end")
}

@test fun a_blank_line_in_the_middle_is_kept(): void {
    val l = ("one\n\nthree\n").lines()
    assert_eq(l.size(), 3, "count")
    assert_eq(piece(&l, 1), "", "the blank line")
}

@test fun no_lines_in_an_empty_string(): void {
    assert_eq("".lines().size(), 0, "empty")
}

@test fun a_last_line_without_a_newline_still_counts(): void {
    val l = ("one\ntwo").lines()
    assert_eq(l.size(), 2, "count")
    assert_eq(piece(&l, 1), "two", "unterminated last line")
}

// The difference from split(" "): runs collapse and the ends are dropped.
@test fun whitespace_splitting_drops_empty_runs(): void {
    val w = "  the   quick brown  ".split_whitespace()
    assert_eq(w.size(), 3, "count")
    assert_eq(piece(&w, 0), "the", "first")
    assert_eq(piece(&w, 2), "brown", "last")
    assert_eq("   ".split_whitespace().size(), 0, "all whitespace")
    assert_eq("".split_whitespace().size(), 0, "empty")
}

@test fun joining_an_empty_list_is_empty(): void {
    val none = List.new<String>()
    assert_eq((&none).join(",").as_str(), "", "nothing to join")
}

@test fun the_trait_reaches_the_same_code(): void {
    assert_eq("a,b".split(",").size(), "a,b".split(",").size(), "split")
    assert_eq("a\nb".lines().size(), ("a\nb").lines().size(), "lines")
}

// An owned String gets the same methods.
@test fun an_owned_string_splits_too(): void {
    val path = String.from("a/b/c")
    val parts = path.split("/")
    assert_eq(parts.size(), 3, "count")
    assert_eq(piece(&parts, 0), "a", "first")
    assert_eq(piece(&parts, 2), "c", "last")
    assert_eq(String.from("one\ntwo").lines().size(), 2, "lines")
    assert_eq(String.from("  x  y ").split_whitespace().size(), 2, "words")
    // And agrees with its view.
    assert_eq(path.split("/").size(), path.split("/").size(), "String and str agree")
}
