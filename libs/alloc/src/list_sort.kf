// Ordering a list: forwards to its slice, so a list sorts as an array does.

impl List<T: Compare> {
    /// Ascending by the element's `Compare`, equal elements kept in order.
    pub mutating fun sort(): void {
        self.as_slice_mut().sort()
    }

    /// O(n).
    pub fun is_sorted(): bool {
        return self.as_slice().is_sorted()
    }
}
