// Eager adapters over a List: each walks the list now and builds a new one.
// The questions (`any`, `count`, `fold`, ...) are core's, on any `Iterable`.
//
// COST: each element handed to a callable is an owned copy, since `Call1<T>`
// takes its argument by value; a kept element is copied again.

impl List<T> {
    /// `xs.map(|x| x % 2 == 1)` is a `List<bool>`.
    pub fun map<F: Call1<T>>(f: F): List<F.Out> {
        var out = List.new<F.Out>()
        var i = 0
        while i < self.size() {
            out.push(f.call(unsafe { clone_place<T>(self.data + i) }))
            i = i + 1
        }
        return out
    }

    /// Kept elements are owned copies.
    pub fun filter<F: Call1<T>>(keep: F): List<T> {
        var out = List.new<T>()
        var i = 0
        while i < self.size() {
            if keep.call(unsafe { clone_place<T>(self.data + i) }) {
                out.push(unsafe { clone_place<T>(self.data + i) })
            }
            i = i + 1
        }
        return out
    }
}
