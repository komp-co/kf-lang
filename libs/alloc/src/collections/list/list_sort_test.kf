import core.assert.assert
import testing.test

struct Ranked {
    val key: int32
    val order: int32
}

impl Compare for Ranked {
    fun compare(other: &Ranked): int32 { return self.key.compare(&other.key) }
}

@test
fun sort_keeps_equal_elements_in_the_order_they_came(): void {
    var xs = List.new<Ranked>()
    while i in 0..30 { xs.push(Ranked { key: (i * 7) % 3, order: i }) }
    xs.sort()
    var kept = true
    while i in 1..30 {
        val a = xs.at(i - 1)
        val b = xs.at(i)
        if a.key == b.key && a.order > b.order { kept = false }
    }
    assert(kept, "a stable sort leaves ties as they were")
}
