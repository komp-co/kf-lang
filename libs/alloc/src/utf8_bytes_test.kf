// core.utf8 over bytes a literal cannot spell, and the encode-decode round
// trip. Both build their input byte by byte, which takes a `String`.

import core.assert.assert_eq

fun utf8_scalar_of(s: str, i: uint64): uint32 {
    return s.decode_at(i).scalar as uint32
}

fun utf8_width_of(s: str, i: uint64): uint64 {
    return s.decode_at(i).width
}

fun utf8_formed(s: str, i: uint64): bool {
    return s.decode_at(i).well_formed
}

/// Built byte by byte: C's `\x` escape is greedy, so `"\xE2\x82A"` is two
/// bytes.
fun utf8_bytes(b0: uint8, b1: uint8, b2: uint8, n: uint64): String {
    var out = String.from("")
    if n > 0 { out.push_byte(b0) }
    if n > 1 { out.push_byte(b1) }
    if n > 2 { out.push_byte(b2) }
    return out
}

// Decoding steps over a stray continuation byte instead of stalling.
@test fun a_stray_continuation_byte_is_stepped_over(): void {
    val s = utf8_bytes(128, 0, 0, 1)
    assert_eq(utf8_formed(s.as_str(), 0), false, "not well-formed")
    assert_eq(utf8_width_of(s.as_str(), 0), 1 as uint64, "consumes exactly the bad byte")
    assert_eq(utf8_scalar_of(s.as_str(), 0), 128 as uint32, "and hands back the raw byte")
}

// The width covers what was read, so the walk resumes at the breaking byte.
@test fun a_truncated_sequence_stops_before_the_bad_byte(): void {
    // 0xE2 promises two continuations; one follows, then `A`.
    val s = utf8_bytes(226, 130, 65, 3)
    assert_eq(utf8_formed(s.as_str(), 0), false, "not well-formed")
    assert_eq(utf8_width_of(s.as_str(), 0), 2 as uint64, "the lead and the one good continuation")
    assert_eq(utf8_scalar_of(s.as_str(), 2), 65 as uint32, "so the walk resumes on `A`")
}

// Structurally fine, still not UTF-8.
@test fun an_overlong_encoding_is_rejected(): void {
    // 0xC0 0x80 encodes U+0000 in two bytes; one byte would do.
    val s = utf8_bytes(192, 128, 0, 2)
    assert_eq(utf8_scalar_of(s.as_str(), 0), 0 as uint32, "it decodes to NUL")
    assert_eq(utf8_width_of(s.as_str(), 0), 2 as uint64, "and consumes both bytes")
    assert_eq(utf8_formed(s.as_str(), 0), false, "but a shorter sequence could carry it")
}

@test fun a_surrogate_is_rejected(): void {
    // 0xED 0xA0 0x80 is U+D800, which UTF-8 may not encode.
    val s = utf8_bytes(237, 160, 128, 3)
    assert_eq(utf8_scalar_of(s.as_str(), 0), 55296 as uint32, "U+D800 decodes")
    assert_eq(utf8_formed(s.as_str(), 0), false, "and is still not encodable")
}

@test fun an_impossible_lead_byte_is_rejected(): void {
    // 0xF8 begins no UTF-8 sequence.
    val s = utf8_bytes(248, 0, 0, 1)
    assert_eq(utf8_formed(s.as_str(), 0), false, "not a lead byte")
    assert_eq(utf8_width_of(s.as_str(), 0), 1 as uint64, "consumes one byte, so a walk advances")
}

/// Encode a scalar, write it into a String, decode it back. Returns the
/// scalar read, or a sentinel that no scalar can be.
fun utf8_round_trip(v: uint32): uint32 {
    val e = (v as char).encode_utf8()
    if e.width == 0 { return 4294967295 as uint32 }
    var s = String.from("")
    s.append(e.as_str())
    val d = s.as_str().decode_at(0)
    if !d.well_formed { return 4294967294 as uint32 }
    if d.width != e.width { return 4294967293 as uint32 }
    return d.scalar as uint32
}

// Every encodable scalar decodes to itself at the same width; a sweep, since
// the two directions share no code.
@test fun every_encodable_scalar_round_trips(): void {
    // From 1: a `String` with an interior NUL loses it through `as_str()`,
    // pinned below.
    var v: uint32 = 1
    var checked: uint32 = 0
    while v < 2500 {
        assert_eq(utf8_round_trip(v), v, "round trip below U+09C4")
        checked = checked + 1
        v = v + 1
    }
    assert_eq(checked, 2499 as uint32, "the sweep really ran")
    // Either side of the surrogate hole and at the top.
    assert_eq(utf8_round_trip(55295), 55295 as uint32, "just below the surrogates")
    assert_eq(utf8_round_trip(57344), 57344 as uint32, "just above them")
    assert_eq(utf8_round_trip(65535), 65535 as uint32, "the last three-byte scalar")
    assert_eq(utf8_round_trip(65536), 65536 as uint32, "the first four-byte one")
    assert_eq(utf8_round_trip(128512), 128512 as uint32, "an emoji")
    assert_eq(utf8_round_trip(1114111), 1114111 as uint32, "the last code point")
}

// U+0000 round-trips, but a length-prefixed `String` truncates at `as_str()`.
@test fun nul_encodes_and_decodes_but_does_not_survive_a_str(): void {
    val e = (0 as char).encode_utf8()
    assert_eq(e.width, 1 as uint64, "U+0000 is one byte")
    assert_eq(e.bytes[0], 0 as uint8, "and that byte is zero")

    var s = String.from("")
    s.push_byte(0)
    s.push_byte(65)
    assert_eq(s.byte_len(), 2 as uint64, "the String holds both bytes")
    // The same String seen as a `str` holds none of them.
    assert_eq(s.as_str().decode_at(0).width, 0 as uint64,
        "so the conversion, not the codec, is where U+0000 is lost")
}
