import core.assert.*
import alloc.deque.*
import testing.test

fun counted(n: int32): Deque<int32> {
    var dq = Deque.new<int32>()
    while i in 0..n { dq.push_back(i) }
    return dq
}

@test
fun a_new_deque_is_empty(): void {
    val dq = Deque.new<int32>()
    assert(dq.is_empty(), "nothing pushed")
}

@test
fun pop_front_takes_the_first_pushed_back(): void {
    var dq = counted(3)
    assert_eq(dq.pop_front()!!, 0, "a queue: first in, first out")
}

@test
fun pop_back_takes_the_last_pushed_back(): void {
    var dq = counted(3)
    assert_eq(dq.pop_back()!!, 2, "a stack: last in, first out")
}

@test
fun push_front_puts_an_element_first(): void {
    var dq = counted(3)
    dq.push_front(-1)
    assert_eq(dq[0], -1, "in front of 0")
}

@test
fun popping_an_empty_deque_is_null(): void {
    var dq = Deque.new<int32>()
    assert(dq.pop_front() == null, "nothing to take")
}

@test
fun growing_keeps_the_order(): void {
    var dq = counted(10)
    assert_eq(dq[9], 9, "the buffer grew past four and eight")
}

/// Pops from the front and pushes at the back, so the elements wrap round
/// the end of the buffer before it grows.
fun wrapped(): Deque<int32> {
    var dq = counted(4)
    dq.pop_front()
    dq.pop_front()
    dq.push_back(4)
    dq.push_back(5)
    dq.push_back(6)
    return dq
}

@test
fun a_wrapped_deque_reads_front_to_back(): void {
    val dq = wrapped()
    var seen: int32 = 0
    while x in &dq { seen = seen * 10 + x }
    assert_eq(seen, 23456, "2 through 6, in order across the wrap")
}

@test
fun push_front_wraps_below_the_start(): void {
    var dq = Deque.new<int32>()
    dq.push_front(1)
    dq.push_front(0)
    dq.push_back(2)
    assert_eq(dq[0] * 100 + dq[1] * 10 + dq[2], 12, "0, 1, 2")
}

@test
fun front_and_back_are_copies_of_the_ends(): void {
    val dq = wrapped()
    assert_eq(dq.front()!! * 10 + dq.back()!!, 26, "2 first, 6 last")
}

@test
fun a_clone_is_independent(): void {
    var dq = counted(3)
    val copy = dq.clone()
    dq.pop_front()
    assert_eq(copy.size(), 3, "the copy keeps all three")
}

@test
fun owning_elements_move_out_whole(): void {
    var dq = Deque.new<String>()
    dq.push_back(String.from("first"))
    dq.push_front(String.from("zeroth"))
    dq.push_back(String.from("second"))
    val taken = dq.pop_front()!!
    assert(taken.equals("zeroth"), "the front, moved out")
}

@test
fun at_mut_writes_in_place(): void {
    var dq = counted(3)
    dq[1] = 7
    assert_eq(dq[1], 7, "written through the index")
}

@test
fun clear_empties_and_keeps_working(): void {
    var dq = wrapped()
    dq.clear()
    dq.push_back(9)
    assert_eq(dq.pop_front()!!, 9, "usable after clearing")
}
