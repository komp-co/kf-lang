// `List.from(xs)` for an array: what a list literal in a `List` slot becomes.

/// The elements move into one allocation of exactly `N`, in a single store,
/// so the array gives them up rather than dropping them.
impl<T, N: uint64> From<T[N]> for List<T> {
    static fun from(items: T[N]): List<T> {
        if N == 0 { return List.new<T>() }
        val data = unsafe { alloc_array<T>(N) }
        unsafe { *(data as Ptr<T[N]>) = items }
        return List<T> { data: data, len: N, cap: N }
    }
}
