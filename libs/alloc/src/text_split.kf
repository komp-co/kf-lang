// Splitting text into a `List<String>`.

import core.text.*
import alloc.list.*

/// Adjacent separators give empty pieces, the ends included, so
/// `",a,".split(",")` is `["", "a", ""]`: always `count_of(sep) + 1` pieces,
/// round-tripping through `join`. An empty separator gives the whole string.
@prelude
pub fun str.split(sep: str): List<String> {
    var out = List.new<String>()
    val sep_len = sep.byte_len()
    if sep_len == 0 {
        out.push(String.from(self))
        return out
    }
    // Measured once; the measuring forms would make this quadratic.
    val n = self.byte_len()
    var at = 0
    var scanning = true
    while scanning {
        when (self.index_of_from_in(n, sep, at)) {
            Some(i) => {
                out.push(self.substring_in(n, at, i))
                at = i + sep_len
            }
            None => scanning = false
        }
    }
    out.push(self.substring_in(n, at, n))
    return out
}

/// Drops a "\r" before each "\n". A trailing newline adds no empty line.
@prelude
pub fun str.lines(): List<String> {
    var out = List.new<String>()
    val n = self.byte_len()
    if n == 0 { return out }
    var start = 0
    var i = 0
    while i < n {
        if self.byte_at_in(n, i) == 10 {
            var end = i
            if end > start && self.byte_at_in(n, end - 1) == 13 { end = end - 1 }
            out.push(self.substring_in(n, start, end))
            start = i + 1
        }
        i = i + 1
    }
    // Whatever follows the last newline, unless the string ended on one.
    if start < n {
        var end = n
        if end > start && self.byte_at_in(n, end - 1) == 13 { end = end - 1 }
        out.push(self.substring_in(n, start, end))
    }
    return out
}

/// Runs of non-whitespace; empty runs are dropped, unlike `split(" ")`.
@prelude
pub fun str.split_whitespace(): List<String> {
    var out = List.new<String>()
    val n = self.byte_len()
    var i = 0
    while i < n {
        while i < n && self.byte_at_in(n, i).is_space() { i = i + 1 }
        if i < n {
            val start = i
            while i < n && !self.byte_at_in(n, i).is_space() { i = i + 1 }
            out.push(self.substring_in(n, start, i))
        }
    }
    return out
}

/// The same surface on the owning type.
@prelude
pub fun String.split(sep: str): List<String> { return self.as_str().split(sep) }
@prelude
pub fun String.lines(): List<String> { return self.as_str().lines() }
@prelude
pub fun String.split_whitespace(): List<String> { return self.as_str().split_whitespace() }

/// The inverse of `split`, read in order: `s.split(",").join(";")`. The list
/// is taken by pointer.
@prelude
pub fun List<String>.join(sep: str): String {
    return self.as_slice().join(sep)
}
