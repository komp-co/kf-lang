// A slice's texts joined into one, and its lists into one.

/// The texts in order, `sep` between each two: `["a", "b"].join(", ")`.
@prelude
pub fun Slice<String>.join(sep: str): String {
    var out = ""
    while i in 0..self.size() {
        if i > 0 { out.append(sep) }
        out.append(self.at(i).as_str())
    }
    return out
}

@prelude
pub fun Slice<str>.join(sep: str): String {
    var out = ""
    while i in 0..self.size() {
        if i > 0 { out.append(sep) }
        out.append(*self.at(i))
    }
    return out
}

/// The texts in order, nothing between them.
@prelude
pub fun Slice<String>.concat(): String {
    return self.join("")
}

/// Copies of every list's elements, in order.
@prelude
pub fun <T: Clone> Slice<List<T>>.concat(): List<T> {
    var out = List.new<T>()
    while i in 0..self.size() {
        val part = self.at(i)
        while j in 0..part.size() { out.push(part.at(j).clone()) }
    }
    return out
}
