import core.assert.assert_eq
import testing.test

@test fun to_fixed_rounds_to_its_decimals(): void {
    assert_eq((2.0 / 3.0).to_fixed(2) == "0.67", true, "two decimals")
}

@test fun to_exponential_writes_the_power(): void {
    assert_eq((1234.5).to_exponential(2) == "1.23e+03", true, "scientific form")
}

@test fun to_radix_writes_hex(): void {
    assert_eq((255 as uint64).to_radix(16) == "ff", true, "lowercase hex")
}

@test fun to_radix_signs_a_negative(): void {
    assert_eq((-5 as int64).to_radix(2) == "-101", true, "binary with a sign")
}
