import core.assert.*
import alloc.list.*
import testing.test

@test
fun join_puts_the_separator_between_texts(): void {
    val words: str[3] = ["a", "b", "c"]
    assert(words.join(", ").equals("a, b, c"), "one separator between each two")
}

@test
fun join_of_one_text_has_no_separator(): void {
    val words: str[1] = ["solo"]
    assert(words.join(", ").equals("solo"), "nothing to separate")
}

@test
fun a_list_of_strings_joins_through_its_slice(): void {
    var words = List.new<String>()
    words.push(String.from("x"))
    words.push(String.from("y"))
    assert(words.join("-").equals("x-y"), "the list joins as its slice does")
}

@test
fun concat_of_strings_has_nothing_between(): void {
    var words = List.new<String>()
    words.push(String.from("x"))
    words.push(String.from("y"))
    assert(words.as_slice().concat().equals("xy"), "glued")
}

@test
fun concat_of_lists_keeps_every_element_in_order(): void {
    var first = List.new<int32>()
    first.push(1)
    var second = List.new<int32>()
    second.push(2)
    second.push(3)
    var lists = List.new<List<int32>>()
    lists.push(first)
    lists.push(second)
    val flat = lists.concat()
    assert_eq(flat.size() * 10 + (*flat.at(2)) as uint64, 33, "three elements, 3 last")
}
