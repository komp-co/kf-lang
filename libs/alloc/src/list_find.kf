// Searching a list, and the ends: forwards to its slice.

impl List<T: Equal> {
    /// O(n).
    pub fun contains(x: &T): bool {
        return self.as_slice().contains(x)
    }

    pub fun index_of(x: &T): uint64? {
        return self.as_slice().index_of(x)
    }

    pub fun last_index_of(x: &T): uint64? {
        return self.as_slice().last_index_of(x)
    }
}

// The ends are copies: an Option cannot hold a borrow.
impl List<T: Clone> {
    pub fun first(): T? {
        return self.as_slice().first()
    }

    /// Does not remove it; `take_last` does.
    pub fun last(): T? {
        return self.as_slice().last()
    }
}
