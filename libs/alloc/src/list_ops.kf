// Order-preserving edits. Everything goes through `swap` and raw slot moves:
// a `get` view freed by a later `set` is a use-after-free.

impl List<T> {
    /// Drops every element and keeps the buffer.
    pub mutating fun clear(): void {
        var i: uint64 = 0
        while i < self.len {
            unsafe { drop_in_place<T>(self.data + i) }
            i = i + 1
        }
        self.len = 0
    }

    pub mutating fun reverse(): void {
        if self.len < 2 { return }
        var i: uint64 = 0
        var j: uint64 = self.len - 1
        while i < j {
            self.swap(i, j)
            i = i + 1
            j = j - 1
        }
    }

    /// O(n), shifting the rest right. An `i` past the end appends.
    pub mutating fun insert(i: uint64, item: T): void {
        // Placed last and swapped down into position.
        //
        // CONSTRAINT: through `reserve_one`, not `push`: a self-call to a
        // method taking the impl's type parameter does not link.
        self.reserve_one()
        unsafe { *(self.data + self.len) = item }
        self.len = self.len + 1
        if i + 1 >= self.len { return }
        var at: uint64 = self.len - 1
        while at > i {
            self.swap(at, at - 1)
            at = at - 1
        }
    }

    /// O(n) and order-preserving, unlike `swap_remove`. None past the end.
    pub mutating fun remove(i: uint64): T? {
        if i >= self.len { return null }
        // Swapped to the end, then forgotten rather than dropped.
        var at: uint64 = i
        while at + 1 < self.len {
            self.swap(at, at + 1)
            at = at + 1
        }
        return self.take_last()
    }

    /// Drains `other`, taken by value, so no element is copied.
    pub mutating fun extend(other: List<T>): void {
        var taken = other
        var i: uint64 = 0
        while i < taken.len {
            self.reserve_one()
            unsafe { *(self.data + self.len) = ptr_read<T>(taken.data + i) }
            self.len = self.len + 1
            i = i + 1
        }
        // The elements now live here; `taken` frees only its buffer.
        taken.len = 0
    }
}
