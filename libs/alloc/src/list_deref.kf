// A list lends its elements as a slice, so what a slice does a list does:
// `xs.sort()`, `xs.binary_search(&x)`, and a `List<T>` where a `Slice<T>` is
// taken.

impl<T> Deref for List<T> {
    type Target = Slice<T>
    fun deref(): Slice<T> { return self.as_slice() }
}

impl<T> DerefMut for List<T> {
    type TargetMut = SliceMut<T>
    mutating fun deref_mut(): SliceMut<T> { return self.as_slice_mut() }
}
