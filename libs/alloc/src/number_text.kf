// A number written in a chosen form into a new `String`; core's writers do
// the same into any sink.

/// `decimals` digits after the point, rounded: `(2.0 / 3.0).to_fixed(2)` is
/// `"0.67"`.
@prelude
pub fun float64.to_fixed(decimals: uint32): String {
    var out = String.from("")
    self.write_fixed(&var out, decimals)
    return out
}

/// One digit before the point, `decimals` after it, then the power of ten:
/// `(1234.5).to_exponential(2)` is `"1.23e+03"`.
@prelude
pub fun float64.to_exponential(decimals: uint32): String {
    var out = String.from("")
    self.write_exponential(&var out, decimals)
    return out
}

/// `self` in `radix`, 2 to 36: `(255 as uint64).to_radix(16)` is `"ff"`.
@prelude
pub fun uint64.to_radix(radix: uint32): String {
    var out = String.from("")
    self.write_radix(&var out, radix, 0)
    return out
}

/// `self` in `radix`, 2 to 36, with a `-` when negative.
@prelude
pub fun int64.to_radix(radix: uint32): String {
    var out = String.from("")
    self.write_radix(&var out, radix, 0)
    return out
}
