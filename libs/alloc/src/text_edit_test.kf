// Mostly edge cases: the empty needle, out-of-range slices, and input that
// must pass through untouched.

import core.assert.assert_eq
import core.option.assert_eq

import alloc.text_edit.*

@test fun substring_clamps_rather_than_failing(): void {
    assert_eq("hello".substring(1, 3).as_str(), "el", "interior")
    assert_eq("hello".substring(0, 99).as_str(), "hello", "end past the end")
    assert_eq("hello".substring(3, 1).as_str(), "", "start after end")
    assert_eq("hello".substring(99, 99).as_str(), "", "wholly past the end")
    assert_eq("hello".slice_from(3).as_str(), "lo", "from")
    assert_eq("hello".take_bytes(2).as_str(), "he", "take")
    assert_eq("he".take_bytes(99).as_str(), "he", "take more than there is")
}

@test fun trimming(): void {
    assert_eq("  padded  ".trim().as_str(), "padded", "both ends")
    assert_eq("  padded  ".trim_start().as_str(), "padded  ", "start only")
    assert_eq("  padded  ".trim_end().as_str(), "  padded", "end only")
    assert_eq(("\t\n mixed \r\n").trim().as_str(), "mixed", "tabs and newlines")
    assert_eq("   ".trim().as_str(), "", "all whitespace")
    assert_eq("".trim().as_str(), "", "empty")
    assert_eq("none".trim().as_str(), "none", "nothing to trim")
}

@test fun case_conversion_is_ascii_only(): void {
    assert_eq("MiXed 123!".to_upper().as_str(), "MIXED 123!", "upper")
    assert_eq("MiXed 123!".to_lower().as_str(), "mixed 123!", "lower")
    assert_eq("".to_upper().as_str(), "", "empty")
    // A two-byte character passes through whole.
    assert_eq("é".to_upper().as_str(), "é", "non-ASCII passes through")
}

@test fun replacing(): void {
    assert_eq("a,b,c".replace(",", "-").as_str(), "a-b-c", "each occurrence")
    assert_eq("aaa".replace("a", "bb").as_str(), "bbbbbb", "growing replacement")
    assert_eq("abc".replace("z", "-").as_str(), "abc", "absent needle")
    assert_eq("abc".replace("", "-").as_str(), "abc", "empty needle copies")
    assert_eq("a,b".replace(",", "").as_str(), "ab", "empty replacement deletes")
}

@test fun repeating(): void {
    assert_eq("ab".repeat(3).as_str(), "ababab", "three times")
    assert_eq("ab".repeat(0).as_str(), "", "zero times")
    assert_eq("".repeat(5).as_str(), "", "empty input")
}

// `str` and `String` answer the same.
@test fun the_trait_agrees_with_the_free_functions(): void {
    val owned = String.from("some/path/file.kf")
    assert_eq(owned.substring(5, 9).as_str(), owned.as_str().substring(5, 9).as_str(), "substring")
    assert_eq(owned.to_upper().as_str(), owned.as_str().to_upper().as_str(), "to_upper")
    assert_eq("  x  ".trim().as_str(), "x", "trait on a literal")
    assert_eq("ab".repeat(2).as_str(), "abab", "repeat on a literal")
}
