import core.assert.*

// Anything moving elements is tested over `String` too: an owning element is
// where a double free shows.

fun ints(): List<int32> {
    var xs = List.new<int32>()
    xs.push(3)
    xs.push(1)
    xs.push(2)
    return xs
}

fun words(): List<String> {
    var xs = List.new<String>()
    xs.push(String.from("pear"))
    xs.push(String.from("apple"))
    xs.push(String.from("fig"))
    return xs
}

@test fun clear_drops_every_element_and_keeps_the_buffer(): void {
    var xs = words()
    xs.clear()
    assert_eq(xs.size(), 0 as uint64, "empty after clear")
    assert_eq(xs.is_empty(), true, "and says so")
    xs.push(String.from("again"))
    assert_eq(xs.size(), 1 as uint64, "and is still usable")
}

@test fun reverse_turns_the_list_around(): void {
    var xs = ints()
    xs.reverse()
    assert_eq(xs.get(0), 2, "last becomes first")
    assert_eq(xs.get(2), 3, "first becomes last")

    // Odd and even lengths take different paths through the midpoint.
    var one = List.new<int32>()
    one.push(9)
    one.reverse()
    assert_eq(one.get(0), 9, "a single element is its own reverse")

    var none = List.new<int32>()
    none.reverse()
    assert_eq(none.size(), 0 as uint64, "an empty list reverses to itself")
}

@test fun reverse_moves_owning_elements_without_copying_them(): void {
    var xs = words()
    xs.reverse()
    assert_eq(xs.at(0).as_str().equals("fig"), true, "owned last is now first")
    assert_eq(xs.at(2).as_str().equals("pear"), true, "owned first is now last")
}

@test fun insert_places_at_the_index_and_shifts_the_rest(): void {
    var xs = ints()
    xs.insert(1, 99)
    assert_eq(xs.size(), 4 as uint64, "one longer")
    assert_eq(xs.get(0), 3, "before is untouched")
    assert_eq(xs.get(1), 99, "the new element sits where asked")
    assert_eq(xs.get(2), 1, "the rest shifted right")
    assert_eq(xs.get(3), 2, "including the tail")

    xs.insert(0, 7)
    assert_eq(xs.get(0), 7, "inserting at the front works")

    // Past the end appends rather than leaving a hole.
    var ys = ints()
    ys.insert(99, 42)
    assert_eq(ys.get(3), 42, "an index past the end appends")
}

@test fun insert_shifts_owning_elements_safely(): void {
    var xs = words()
    xs.insert(1, String.from("plum"))
    assert_eq(xs.at(0).as_str().equals("pear"), true, "before is intact")
    assert_eq(xs.at(1).as_str().equals("plum"), true, "inserted")
    assert_eq(xs.at(3).as_str().equals("fig"), true, "the tail survived the shift")
}

@test fun remove_hands_back_the_element_and_keeps_order(): void {
    var xs = ints()
    when (xs.remove(1)) {
        Some(v) => { assert_eq(v, 1, "the removed element comes back") }
        None => { assert_eq(true, false, "expected an element") }
    }
    assert_eq(xs.size(), 2 as uint64, "one shorter")
    assert_eq(xs.get(0), 3, "order is preserved")
    assert_eq(xs.get(1), 2, "the tail closed up")

    assert_eq(xs.remove(99).is_none(), true, "past the end is None, not a panic")
}

@test fun remove_gives_back_an_owning_element_intact(): void {
    var xs = words()
    when (xs.remove(0)) {
        Some(s) => { assert_eq(s.as_str().equals("pear"), true, "the String survived being removed") }
        None => { assert_eq(true, false, "expected an element") }
    }
    assert_eq(xs.size(), 2 as uint64, "one shorter")
    assert_eq(xs.at(0).as_str().equals("apple"), true, "the rest shifted down")
}

@test fun extend_drains_the_other_list(): void {
    var xs = ints()
    var ys = List.new<int32>()
    ys.push(8)
    ys.push(9)
    xs.extend(ys)
    assert_eq(xs.size(), 5 as uint64, "both lists' elements")
    assert_eq(xs.get(3), 8, "appended in order")
    assert_eq(xs.get(4), 9, "and the second")
}

@test fun extend_moves_owning_elements_rather_than_copying_them(): void {
    var xs = words()
    var ys = List.new<String>()
    ys.push(String.from("kiwi"))
    xs.extend(ys)
    assert_eq(xs.size(), 4 as uint64, "one longer")
    assert_eq(xs.at(3).as_str().equals("kiwi"), true, "the moved String is intact")
}

@test fun contains_and_index_of_find_what_is_there(): void {
    val xs = ints()
    assert_eq(xs.contains(&2), true, "present")
    assert_eq(xs.contains(&42), false, "absent")
    assert_eq(xs.index_of(&1) == Option.Some(1 as uint64), true, "the first match's index")
    assert_eq(xs.index_of(&42).is_none(), true, "absent is None")

    var dupes = List.new<int32>()
    dupes.push(5)
    dupes.push(6)
    dupes.push(5)
    assert_eq(dupes.index_of(&5) == Option.Some(0 as uint64), true, "index_of takes the first")
    assert_eq(dupes.last_index_of(&5) == Option.Some(2 as uint64), true, "last_index_of takes the last")
}

@test fun contains_compares_owning_elements_by_value(): void {
    val xs = words()
    assert_eq(xs.contains(&String.from("apple")), true, "equal by bytes, not by address")
    assert_eq(xs.contains(&String.from("durian")), false, "absent")
}

@test fun first_and_last_answer_the_ends(): void {
    val xs = ints()
    assert_eq(xs.first() == Option.Some(3), true, "first")
    assert_eq(xs.last() == Option.Some(2), true, "last")

    val none = List.new<int32>()
    assert_eq(none.first().is_none(), true, "an empty list has no first")
    assert_eq(none.last().is_none(), true, "nor a last")
}

// `last` copies rather than removing, so the list still owns its element
// afterwards -- the difference from `take_last`.
@test fun last_leaves_the_element_in_the_list(): void {
    val xs = words()
    when (xs.last()) {
        Some(s) => { assert_eq(s.as_str().equals("fig"), true, "a copy of the last") }
        None => { assert_eq(true, false, "expected an element") }
    }
    assert_eq(xs.size(), 3 as uint64, "and the list is unchanged")
    assert_eq(xs.at(2).as_str().equals("fig"), true, "its element still there")
}

@test fun sort_orders_ascending(): void {
    var xs = ints()
    xs.sort()
    assert_eq(xs.is_sorted(), true, "sorted")
    assert_eq(xs.get(0), 1, "smallest first")
    assert_eq(xs.get(2), 3, "largest last")
}

// The sizes where a heap sort gets its indices wrong if it is going to:
// empty, one, two, and a length that is not a power of two.
@test fun sort_handles_every_awkward_length(): void {
    var none = List.new<int32>()
    none.sort()
    assert_eq(none.size(), 0 as uint64, "an empty list sorts to itself")

    var one = List.new<int32>()
    one.push(4)
    one.sort()
    assert_eq(one.get(0), 4, "one element")

    var two = List.new<int32>()
    two.push(2)
    two.push(1)
    two.sort()
    assert_eq(two.get(0), 1, "two elements swap")

    var many = List.new<int32>()
    var i = 0
    while i < 17 {
        many.push((17 - i) * 7 % 23)
        i = i + 1
    }
    many.sort()
    assert_eq(many.is_sorted(), true, "seventeen elements come out ordered")
    assert_eq(many.size(), 17 as uint64, "and none were lost")
}

@test fun sort_is_idempotent_and_keeps_every_element(): void {
    var xs = List.new<int32>()
    xs.push(5)
    xs.push(5)
    xs.push(1)
    xs.push(9)
    xs.push(1)
    xs.sort()
    assert_eq(xs.is_sorted(), true, "sorted")
    assert_eq(xs.size(), 5 as uint64, "duplicates are all still there")
    assert_eq(xs.get(0), 1, "both 1s at the front")
    assert_eq(xs.get(1), 1, "the second one too")
    xs.sort()
    assert_eq(xs.is_sorted(), true, "sorting an already-sorted list changes nothing")
    assert_eq(xs.get(4), 9, "largest still last")
}

@test fun sort_moves_owning_elements_without_freeing_them(): void {
    var xs = words()
    xs.sort()
    assert_eq(xs.is_sorted(), true, "sorted by String's Compare")
    assert_eq(xs.at(0).as_str().equals("apple"), true, "alphabetical")
    assert_eq(xs.at(1).as_str().equals("fig"), true, "second")
    assert_eq(xs.at(2).as_str().equals("pear"), true, "third")
}
