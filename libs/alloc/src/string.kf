import core.fault.*
import core.display.*
import core.hash.*
import core.text.*

extern "C" fun kf_free(p: Ptr<void>): void
extern "C" fun kf_str_byte_len(s: str): uint64
extern "C" fun kf_str_byte_at(s: str, i: uint64): uint8

/// An owning, move-only UTF-8 byte buffer. Named `String` in C as well, where
/// alloc's native code takes and returns it.
///
/// `cap == 0` means the bytes are not its own: a `String` made from a literal
/// points at the literal, frees nothing, and copies the bytes into a buffer of
/// its own on its first write.
///
/// `@lang("string")` makes it the language's string: what a literal becomes,
/// what `${...}` renders into, and what a `str` converts up into.
@no_mangle
@lang("string")
pub struct String {
    var data: Ptr<uint8>
    var len: uint64
    var cap: uint64
}

impl From<str> for String {
    static fun from(s: str): String {
        val len: uint64 = unsafe { kf_str_byte_len(s) }
        val cap: uint64 = len + 1
        if cap == 0 { panic_with(Fault.CapacityOverflow) }
        val data = unsafe { alloc_array<uint8>(cap) }
        var i = 0
        while i < len {
            unsafe { *(data + i) = kf_str_byte_at(s, i) }
            i = i + 1
        }
        unsafe { *(data + len) = 0 as uint8 }
        return String { data: data, len: len, cap: cap }
    }
}

impl String {
    /// Points at `s` and owns nothing; what a string literal in a `String`
    /// slot becomes.
    ///
    /// CONSTRAINT: `s` outlives the `String` and every clone of it, which a
    /// literal does.
    pub static fun from_literal(s: str): String {
        return String { data: unsafe { s as Ptr<uint8> }, len: unsafe { kf_str_byte_len(s) }, cap: 0 }
    }

    /// What `"${v}"` expands to.
    ///
    /// CONSTRAINT: static, so interpolation needs no import. CONSTRAINT:
    /// `&dyn Display`, not `<T: Display>`: a generic method in an impl block
    /// does not survive the crate boundary.
    pub static fun of(v: &dyn Display): String {
        var out = String.from("")
        v.display(&var out)
        return out
    }

    pub fun as_str(): str {
        return unsafe { self.data as str }
    }

    pub fun byte_len(): uint64 {
        return self.len
    }

    pub fun len(): uint64 {
        return self.len
    }

    pub fun is_empty(): bool {
        return self.len == 0
    }

    // Room for `needed` bytes with the terminator; doubling, or exact on
    // overflow.
    mutating fun reserve_total(needed: uint64): void {
        if needed == 0 { panic_with(Fault.CapacityOverflow) }
        if needed <= self.cap { return }
        if self.cap == 0 {
            self.own_bytes(needed)
            return
        }
        var next_cap: uint64 = self.cap
        if next_cap == 0 { next_cap = 1 }
        while next_cap < needed {
            val doubled: uint64 = next_cap * 2
            if doubled <= next_cap {
                next_cap = needed
            } else {
                next_cap = doubled
            }
        }
        self.data = unsafe { realloc_array<uint8>(self.data, next_cap) }
        self.cap = next_cap
    }

    pub mutating fun append(s: str): void {
        val add_len: uint64 = unsafe { kf_str_byte_len(s) }
        val combined: uint64 = self.len + add_len
        if combined < self.len { panic_with(Fault.CapacityOverflow) }
        if combined + 1 > self.cap && self.holds(s) {
            // Copied first, so `text.append(text.as_str())` is safe across the
            // realloc.
            val suffix = String.from(s)
            self.reserve_total(combined + 1)
            while i in 0..add_len {
                unsafe { *(self.data + self.len + i) = *(suffix.data + i) }
            }
        } else {
            // Within capacity, a suffix inside this buffer lies before `len`,
            // where nothing is written.
            self.reserve_total(combined + 1)
            while i in 0..add_len {
                unsafe { *(self.data + self.len + i) = kf_str_byte_at(s, i) }
            }
        }
        self.len = combined
        unsafe { *(self.data + self.len) = 0 as uint8 }
    }

    /// Not checked for UTF-8: a multi-byte character is assembled a byte at a
    /// time.
    pub mutating fun push_byte(b: uint8): void {
        val combined: uint64 = self.len + 1
        if combined < self.len { panic_with(Fault.CapacityOverflow) }
        self.reserve_total(combined + 1)
        unsafe { *(self.data + self.len) = b }
        self.len = combined
        unsafe { *(self.data + self.len) = 0 as uint8 }
    }

    /// Keeps the buffer.
    pub mutating fun clear(): void {
        self.len = 0
        if self.cap > 0 {
            unsafe { *(self.data) = 0 as uint8 }
        } else {
            self.data = unsafe { "" as Ptr<uint8> }
        }
    }

    /// The borrowed bytes copied into a buffer of `cap` bytes, at least the
    /// text and its terminator.
    /// Whether `s` points into this string's own buffer.
    fun holds(s: str): bool {
        if self.cap == 0 { return false }
        val at = unsafe { s as Ptr<uint8> as uint64 }
        val start = unsafe { self.data as uint64 }
        return at >= start && at < start + self.cap
    }

    mutating fun own_bytes(cap: uint64): void {
        val data = unsafe { alloc_array<uint8>(cap) }
        while i in 0..self.len {
            unsafe { *(data + i) = *(self.data + i) }
        }
        unsafe { *(data + self.len) = 0 as uint8 }
        self.data = data
        self.cap = cap
    }
}

/// A `String` reads as its text: every `str` method is a `String` method.
impl Deref for String {
    type Target = str
    fun deref(): str { return self.as_str() }
}

impl Drop for String {
    fun drop(): void {
        if self.cap > 0 {
            unsafe { kf_free(self.data as Ptr<void>) }
        }
    }
}

impl Add for String {
    fun add(other: &String): String {
        var out = self.clone()
        out.append(other)
        return out
    }
}

impl Equal for String {
    fun equals(other: &String): bool {
        return self.as_str().equals(other)
    }
}

/// By byte, agreeing with `Equal`. UTF-8 byte order is code point order; this
/// is not a locale collation.
impl Compare for String {
    fun compare(other: &String): int32 {
        val a = self.as_str()
        val b = other.as_str()
        val an = unsafe { kf_str_byte_len(a) }
        val bn = unsafe { kf_str_byte_len(b) }
        var n = an
        if bn < n { n = bn }
        var i = 0
        while i < n {
            val x = unsafe { kf_str_byte_at(a, i) }
            val y = unsafe { kf_str_byte_at(b, i) }
            if x < y { return -1 }
            if x > y { return 1 }
            i = i + 1
        }
        // A prefix sorts before the string that extends it.
        if an < bn { return -1 }
        if an > bn { return 1 }
        return 0
    }
}

// As a trait impl, so `String` satisfies a `Clone` bound.
impl Clone for String {
    fun clone(): String {
        if self.cap == 0 { return String { data: self.data, len: self.len, cap: 0 } }
        return String.from(self.as_str())
    }
}

/// The empty string, which is what `@derive(Default)` gives a `String` field.
impl Default for String {
    static fun default(): String { return String.from("") }
}

// CONSTRAINT: `self.as_str()` until the seed compiler lends a trait impl's
// `self` as a `str` (#189); this crate is built by it. `Hash` below too.
impl Display for String {
    @allow(needless_deref)
    fun display(out: &var dyn Write): void { out.write_str(self.as_str()) }
}

/// The sink `String.of` collects into.
impl Write for String {
    mutating fun write_str(s: str): void { self.append(s) }
}

// The same bytes as `str`, so a `String` key and its `str` spelling agree.
impl Hash for String {
    @allow(needless_deref)
    fun hash(): uint64 { return hash_bytes(self.as_str()) }
}

// The core text surface on the owning type, delegating to core's known-length
// forms: one implementation, and no `strlen`.
@prelude
pub fun String.is_blank(): bool { return self.is_blank_in(self.byte_len()) }
@prelude
pub fun String.byte_at(i: uint64): uint8 { return self.byte_at_in(self.byte_len(), i) }

@prelude
pub fun String.starts_with(prefix: str): bool {
    return self.starts_with_in(self.byte_len(), prefix)
}
@prelude
pub fun String.ends_with(suffix: str): bool {
    return self.ends_with_in(self.byte_len(), suffix)
}
@prelude
pub fun String.contains(needle: str): bool {
    return self.contains_in(self.byte_len(), needle)
}
@prelude
pub fun String.index_of(needle: str): uint64? {
    return self.index_of_from_in(self.byte_len(), needle, 0)
}
@prelude
pub fun String.index_of_from(needle: str, from: uint64): uint64? {
    return self.index_of_from_in(self.byte_len(), needle, from)
}
pub fun String.last_index_of(needle: str): uint64? {
    return self.last_index_of_in(self.byte_len(), needle)
}
pub fun String.count_of(needle: str): uint64 {
    return self.count_of_in(self.byte_len(), needle)
}

/// `byte_at` under the dissolved `Text` trait's name, for a sibling crate not
/// yet moved across.
@prelude
pub fun String.byte(i: uint64): uint8 { return self.byte_at_in(self.byte_len(), i) }

/// Appends one character as UTF-8. A scalar UTF-8 cannot represent appends
/// nothing, not U+FFFD.
@prelude
pub mutating fun String.push(c: char): void {
    val e = c.encode_utf8()
    while i in 0..e.width { self.push_byte(e.bytes[i]) }
}
