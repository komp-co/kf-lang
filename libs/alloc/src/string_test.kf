import core.assert.assert_eq

@test
fun string_from_round_trips_input(): void {
    val text = String.from("hello")
    assert_eq(text.as_str(), "hello", "String preserves input bytes")
}

@test
fun string_append_grows_the_owned_buffer(): void {
    var text = String.from("a")
    text.append("bcdef")
    assert_eq(text.as_str(), "abcdef", "String append preserves both byte ranges")
}

@test
fun string_append_accepts_a_view_of_itself(): void {
    var text = String.from("abcdefghijklmnopqrstuvwxyz")
    text.append(text.as_str())
    assert_eq(text.as_str(), "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz", "String append preserves an aliased source view")
}

@test
fun string_clone_owns_independent_bytes(): void {
    var original = String.from("left")
    val copied = original.clone()
    original.append("-right")
    assert_eq(copied.as_str(), "left", "String clone is independent of source mutation")
}

@test
fun string_add_builds_an_independent_value(): void {
    val joined: String = String.from("left") + String.from("-right")
    assert_eq(joined.as_str(), "left-right", "String addition supports mechanical text migration")
}

@test
fun an_owned_string_hashes_as_its_bytes(): void {
    val owned = String.from("hello")
    assert_eq(owned.hash() == "hello".hash(), true, "String agrees with str")
    assert_eq(owned.hash() == "hellp".hash(), false, "and is content-sensitive")
}

// The `Text` trait must answer for a `String` exactly as for its bytes.
@test
fun string_answers_the_text_trait_like_its_bytes(): void {
    val owned = String.from("some/path/file.kf")
    assert_eq(owned.ends_with(".kf"), owned.as_str().ends_with(".kf"), "ends_with")
    assert_eq(owned.count_of("/"), 2, "count through the trait")
    assert_eq(owned.is_blank(), false, "is_blank through the trait")
}
