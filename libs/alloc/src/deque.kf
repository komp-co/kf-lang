extern "C" fun kf_free(p: Ptr<void>): void

/// A growable ring buffer: pushing and popping at either end is O(1)
/// amortized, so it is the queue and the stack both. `val b = a` moves.
///
/// Element `i` lives at slot `(head + i) % cap`; the slots outside the `len`
/// from `head` hold nothing.
pub struct Deque<T> {
    var data: Ptr<T>
    var head: uint64
    var len: uint64
    var cap: uint64
}

impl Deque<T> {
    /// No allocation until the first push.
    pub static fun new(): Deque<T> {
        return Deque<T> { data: unsafe { 0 as Ptr<T> }, head: 0, len: 0, cap: 0 }
    }

    pub fun size(): uint64 { return self.len }

    pub fun is_empty(): bool { return self.len == 0 }

    /// The deque now owns `item`, last.
    pub mutating fun push_back(item: T): void {
        self.reserve_one()
        unsafe { *(self.data + self.slot(self.len)) = item }
        self.len = self.len + 1
    }

    /// The deque now owns `item`, first.
    pub mutating fun push_front(item: T): void {
        self.reserve_one()
        self.head = (self.head + self.cap - 1) % self.cap
        unsafe { *(self.data + self.head) = item }
        self.len = self.len + 1
    }

    /// Moves the first element out, or null when empty.
    pub mutating fun pop_front(): T? {
        if self.len == 0 { return null }
        val item: T = unsafe { ptr_read<T>(self.data + self.head) }
        self.head = (self.head + 1) % self.cap
        self.len = self.len - 1
        return item
    }

    /// Moves the last element out, or null when empty.
    pub mutating fun pop_back(): T? {
        if self.len == 0 { return null }
        self.len = self.len - 1
        val item: T = unsafe { ptr_read<T>(self.data + self.slot(self.len)) }
        return item
    }

    /// A shared borrow of element `i`, counted from the front; out of range
    /// panics.
    pub fun at(i: uint64): &T {
        if i >= self.len { panic("deque index out of bounds") }
        return unsafe { &*(self.data + self.slot(i)) }
    }

    /// A mutable borrow of element `i`; out of range panics.
    pub mutating fun at_mut(i: uint64): &var T {
        if i >= self.len { panic("deque index out of bounds") }
        return unsafe { &var *(self.data + self.slot(i)) }
    }

    /// Drops every element and keeps the buffer.
    pub mutating fun clear(): void {
        while i in 0..self.len { unsafe { drop_in_place<T>(self.data + self.slot(i)) } }
        self.head = 0
        self.len = 0
    }

    /// Independently owned buffer and elements, in the same order.
    pub fun clone(): Deque<T> {
        var out = Deque.new<T>()
        while i in 0..self.len {
            out.push_back(unsafe { clone_place<T>(self.data + self.slot(i)) })
        }
        return out
    }

    /// A cursor front to back, which borrows the deque: it cannot change
    /// while the cursor is in use.
    pub fun iter(): DequeIter<T> {
        return DequeIter<T> { data: self.data, head: self.head, len: self.len, cap: self.cap, index: 0 }
    }

    fun slot(i: uint64): uint64 { return (self.head + i) % self.cap }

    /// Room for one more element. A full buffer is copied, front first, into
    /// one twice its size.
    ///
    /// CONSTRAINT: takes no `T`: a self-call to a method taking the impl's
    /// type parameter mangles with the type appended and does not link.
    mutating fun reserve_one(): void {
        if self.len < self.cap { return }
        val grown = if self.cap == 0 { 4 } else { self.cap * 2 }
        val moved: Ptr<T> = unsafe { alloc_array<T>(grown) }
        while i in 0..self.len {
            unsafe { *(moved + i) = ptr_read<T>(self.data + self.slot(i)) }
        }
        if self.cap > 0 { unsafe { kf_free(self.data as Ptr<void>) } }
        self.data = moved
        self.head = 0
        self.cap = grown
    }
}

impl Deque<T: Clone> {
    /// A copy of the first element, or null when empty.
    pub fun front(): T? {
        if self.len == 0 { return null }
        return self.at(0).clone()
    }

    /// A copy of the last element, or null when empty.
    pub fun back(): T? {
        if self.len == 0 { return null }
        return self.at(self.len - 1).clone()
    }
}

impl Drop for Deque<T> {
    fun drop(): void {
        while i in 0..self.len { unsafe { drop_in_place<T>(self.data + self.slot(i)) } }
        if self.cap > 0 { unsafe { kf_free(self.data as Ptr<void>) } }
    }
}

impl Index<uint64> for Deque<T> {
    type Out = T
    fun index(k: uint64): &Self.Out {
        return self.at(k)
    }
}

impl IndexMut<uint64> for Deque<T> {
    mutating fun index_mut(k: uint64): &var Self.Out {
        return self.at_mut(k)
    }
}

impl Iterable<T> for Deque<T> {
    type Iter = DequeIter<T>
    fun iter(): DequeIter<T> {
        return DequeIter<T> { data: self.data, head: self.head, len: self.len, cap: self.cap, index: 0 }
    }
}

/// A forward cursor over a deque, front to back. A view: it borrows the
/// deque's buffer, so the deque cannot change while it is used.
pub view struct DequeIter<T> {
    var data: Ptr<T>
    val head: uint64
    val len: uint64
    val cap: uint64
    var index: uint64
}

impl DequeIter<T> {
    /// The next element's address, or null once exhausted; what
    /// `while x in &dq` desugars against.
    pub mutating fun next_ptr(): Ptr<T> {
        if self.index >= self.len { return ptr_null<T>() }
        val p: Ptr<T> = self.data + (self.head + self.index) % self.cap
        self.index = self.index + 1
        return p
    }
}

impl Iterator<T> for DequeIter<T> {
    /// An owned copy of the next element.
    mutating fun next(): T? {
        if self.index >= self.len { return null }
        val item: T = unsafe { clone_place<T>(self.data + (self.head + self.index) % self.cap) }
        self.index = self.index + 1
        return item
    }
}

impl Iterable<T> for DequeIter<T> {
    type Iter = DequeIter<T>
    fun iter(): DequeIter<T> {
        return DequeIter<T> { data: self.data, head: self.head, len: self.len, cap: self.cap, index: self.index }
    }
}
