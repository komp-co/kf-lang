// An owned filesystem path that keeps its input spelling until `normalized`
// is asked for. Lexical only: nothing here reads the filesystem.

pub struct Path {
    pub val raw: String
}

impl Path {
    pub static fun new(value: str): Path {
        return Path { raw: String.from(value) }
    }

    pub fun as_str(): str {
        return self.raw
    }

    pub fun is_empty(): bool {
        return self.raw.as_str() == ""
    }

    pub fun is_absolute(): bool {
        return self.raw.starts_with("/")
    }

    /// `part` alone when it is absolute, as the path it names.
    pub fun join(part: str): Path {
        if self.raw.as_str() == "" || part.starts_with("/") { return Path.new(part) }
        if part == "" { return Path { raw: self.raw.clone() } }
        val n = unsafe { kf_str_byte_len(self.raw.as_str()) }
        val last = unsafe { kf_str_byte_at(self.raw.as_str(), n - 1) }
        if last == 47 {
            return Path { raw: self.raw.clone() + String.from(part) }
        }
        return Path { raw: self.raw.clone() + String.from("/") + String.from(part) }
    }

    /// "" for an empty path.
    pub fun file_name(): String {
        val text = self.raw.as_str()
        val n = unsafe { kf_str_byte_len(text) }
        var start = 0
        while i in 0..n {
            if unsafe { kf_str_byte_at(text, i) } == 47 { start = i + 1 }
        }
        return unsafe { kf_str_slice_to_string(text, start, n) }
    }

    /// `.` for a relative single component; `/` is its own parent.
    pub fun parent(): Path {
        val text = self.raw.as_str()
        val n = unsafe { kf_str_byte_len(text) }
        if n == 0 { return Path.new(".") }
        var i = n
        while i > 0 {
            i = i - 1
            if unsafe { kf_str_byte_at(text, i) } == 47 {
                if i == 0 { return Path.new("/") }
                val value = unsafe { kf_str_slice_to_string(text, 0, i) }
                return Path.new(value.as_str())
            }
        }
        return Path.new(".")
    }

    /// `.` and `name/..` collapsed, and repeated separators. A `..` past the
    /// root of an absolute path is dropped; a relative path keeps its leading
    /// ones. An empty result is `.`, or `/` for an absolute path.
    pub fun normalized(): Path {
        val text = self.raw.as_str()
        val absolute = self.is_absolute()
        var kept = List.new<String>()
        while part in &text.split("/") {
            val name = part.as_str()
            if name == "" || name == "." { continue }
            val climbs = kept.size() > 0 && kept.at(kept.size() - 1).as_str() != ".."
            if name == ".." && climbs {
                val _dropped = kept.pop()
            } else if name != ".." || !absolute {
                kept.push(part.clone())
            }
        }
        val joined = kept.join("/")
        if absolute { return Path { raw: "/${joined}" } }
        return Path.new(if joined.is_empty() { "." } else { joined })
    }

    /// Whether `prefix` is this path or one of its ancestors, compared as
    /// written: `/a/lib` is not a prefix of `/a/library`.
    pub fun starts_with(prefix: &Path): bool {
        val text = self.raw.as_str()
        val head = prefix.raw.as_str()
        if !text.starts_with(head) { return false }
        if text.byte_len() == head.byte_len() || head.ends_with("/") { return true }
        return text.byte_at(head.byte_len()) == 47
    }
}
