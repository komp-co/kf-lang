// An owned filesystem path that keeps its input spelling; normalization
// belongs in std.fs.
pub struct Path {
    pub val raw: String
}

impl Path {
    pub static fun new(value: str): Path {
        return Path { raw: String.from(value) }
    }

    pub fun as_str(): str {
        return self.raw.as_str()
    }

    pub fun is_empty(): bool {
        return self.raw.as_str() == ""
    }

    pub fun join(part: str): Path {
        if self.raw.as_str() == "" { return Path.new(part) }
        if part == "" { return Path { raw: self.raw.clone() } }
        val n = unsafe { kf_str_byte_len(self.raw.as_str()) }
        val last = unsafe { kf_str_byte_at(self.raw.as_str(), n - 1) }
        if last == 47 {
            return Path { raw: self.raw.clone() + String.from(part) }
        }
        return Path { raw: self.raw.clone() + String.from("/") + String.from(part) }
    }

    /// "" for an empty path.
    pub fun file_name(): String {
        val text = self.raw.as_str()
        val n = unsafe { kf_str_byte_len(text) }
        var start = 0
        var i = 0
        while i < n {
            if unsafe { kf_str_byte_at(text, i) } == 47 { start = i + 1 }
            i = i + 1
        }
        return unsafe { kf_str_slice_to_string(text, start, n) }
    }

    /// `.` for a relative single component; `/` is its own parent.
    pub fun parent(): Path {
        val text = self.raw.as_str()
        val n = unsafe { kf_str_byte_len(text) }
        if n == 0 { return Path.new(".") }
        var i = n
        while i > 0 {
            i = i - 1
            if unsafe { kf_str_byte_at(text, i) } == 47 {
                if i == 0 { return Path.new("/") }
                val value = unsafe { kf_str_slice_to_string(text, 0, i) }
                return Path.new(value.as_str())
            }
        }
        return Path.new(".")
    }
}
