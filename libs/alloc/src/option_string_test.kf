import core.assert.*

fun named(on: bool): String? {
    if on { return Option.Some(String.from("kf")) }
    return null
}

fun outcome(on: bool): Result<String, String> {
    if on { return Result.Ok(String.from("ok")) }
    return Result.Err(String.from("no"))
}

@test fun an_owned_payload_maps(): void {
    assert_eq(named(true).map(|s| s.byte_len()), Option.Some(2 as uint64), "the String's length")
}

@test fun an_owned_fallback_is_taken(): void {
    assert_eq(named(false).unwrap_or(String.from("anonymous")) == "anonymous", true, "the default")
}

@test fun an_owned_payload_wins_over_the_fallback(): void {
    assert_eq(named(true).unwrap_or_else(|| String.from("x")) == "kf", true, "the payload")
}

fun longer_than_one(s: String): String? {
    if s.byte_len() > 1 { return Option.Some(s) }
    return null
}

@test fun an_owned_payload_chains(): void {
    val got = named(true).and_then(|s| longer_than_one(s))
    assert_eq(got.is_some(), true, "kept")
}

@test fun an_owned_payload_filters(): void {
    assert_eq(named(true).filter(|s| s.byte_len() > 5), null, "too short")
}

@test fun an_owned_error_maps(): void {
    assert_eq(outcome(false).map_err(|e| e.byte_len()), Result.Err<String, uint64>(2), "the error's length")
}

@test fun an_owned_error_recovers(): void {
    assert_eq(outcome(false).or_else(|_e| outcome(true)).is_ok(), true, "recovered")
}

@test fun an_owned_ok_becomes_an_option(): void {
    assert_eq(outcome(true).ok().is_some(), true, "Some")
}
