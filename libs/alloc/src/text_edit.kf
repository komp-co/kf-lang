// Transformations over `str`, each returning a fresh `String`: a substring of
// a NUL-terminated view needs its own buffer. Searching stays in core.text.
//
// Case conversion is ASCII-only; other bytes pass through.

import core.text.index_of_from_in

extern "C" fun kf_str_byte_len(self: str): uint64
extern "C" fun kf_str_byte_at(self: str, i: uint64): uint8
extern "C" fun kf_str_slice_to_string(self: str, start: uint64, end: uint64): String

/// `[start, end)` as an owned String, clamped: `end` past the end means to
/// the end, and `start >= end` gives "".
@prelude
pub fun str.substring(start: uint64, end: uint64): String {
    return self.substring_in(unsafe { kf_str_byte_len(self) }, start, end)
}

/// For a caller knowing `self` is `n` bytes; a loop slicing through the
/// measuring form is quadratic.
pub fun str.substring_in(n: uint64, start: uint64, end: uint64): String {
    var lo = start
    var hi = end
    if hi > n { hi = n }
    if lo > hi { lo = hi }
    return unsafe { kf_str_slice_to_string(self, lo, hi) }
}

@prelude
pub fun str.slice_from(start: uint64): String {
    val n = unsafe { kf_str_byte_len(self) }
    return self.substring_in(n, start, n)
}

/// Fewer if the string is shorter.
@prelude
pub fun str.take_bytes(n: uint64): String {
    return self.substring(0, n)
}

@prelude
pub fun str.trim_start(): String {
    val n = unsafe { kf_str_byte_len(self) }
    var lo = 0
    while lo < n && (unsafe { kf_str_byte_at(self, lo) }).is_space() { lo = lo + 1 }
    return self.substring(lo, n)
}

@prelude
pub fun str.trim_end(): String {
    val n = unsafe { kf_str_byte_len(self) }
    var hi = n
    while hi > 0 && (unsafe { kf_str_byte_at(self, hi - 1) }).is_space() { hi = hi - 1 }
    return self.substring(0, hi)
}

/// Whitespace removed from both ends.
@prelude
pub fun str.trim(): String {
    val n = unsafe { kf_str_byte_len(self) }
    var lo = 0
    while lo < n && (unsafe { kf_str_byte_at(self, lo) }).is_space() { lo = lo + 1 }
    var hi = n
    while hi > lo && (unsafe { kf_str_byte_at(self, hi - 1) }).is_space() { hi = hi - 1 }
    return self.substring(lo, hi)
}

/// ASCII upper-case. Bytes outside a-z are unchanged.
@prelude
pub fun str.to_upper(): String {
    return str_map_case(self, 97, 122, "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
}

/// ASCII lower-case. Bytes outside A-Z are unchanged.
@prelude
pub fun str.to_lower(): String {
    return str_map_case(self, 65, 90, "abcdefghijklmnopqrstuvwxyz")
}

// Bytes in `[lo, hi]` become the matching byte of `table`; others are copied.
// A table, since a String appends a `str`, not a computed byte.
fun str_map_case(self: str, lo: uint8, hi: uint8, table: str): String {
    val n = unsafe { kf_str_byte_len(self) }
    var out = ""
    var i = 0
    while i < n {
        val b = unsafe { kf_str_byte_at(self, i) }
        if b >= lo && b <= hi {
            val at = (b - lo) as uint64
            out.append(unsafe { kf_str_slice_to_string(table, at, at + 1) }.as_str())
        } else {
            out.append(self.substring_in(n, i, i + 1).as_str())
        }
        i = i + 1
    }
    return out
}

/// "" when `n` is 0.
pub fun str.repeat(n: uint64): String {
    var out = ""
    var i = 0
    while i < n {
        out.append(self)
        i = i + 1
    }
    return out
}

/// Non-overlapping. An empty `from` returns a copy.
pub fun str.replace(from: str, to: str): String {
    val fn_len = unsafe { kf_str_byte_len(from) }
    if fn_len == 0 { return String.from(self) }
    val n = unsafe { kf_str_byte_len(self) }
    var out = ""
    var at = 0
    var scanning = true
    while scanning {
        when (self.index_of_from_in(n, from, at)) {
            Some(i) => {
                out.append(self.substring_in(n, at, i).as_str())
                out.append(to)
                at = i + fn_len
            }
            None => scanning = false
        }
    }
    out.append(self.substring_in(n, at, n).as_str())
    return out
}

/// The same surface on the owning type, delegating through `as_str()`.
@prelude
pub fun String.substring(start: uint64, end: uint64): String {
    return self.as_str().substring_in(self.byte_len(), start, end)
}
@prelude
pub fun String.slice_from(start: uint64): String {
    return self.as_str().substring_in(self.byte_len(), start, self.byte_len())
}
@prelude
pub fun String.take_bytes(n: uint64): String { return self.as_str().take_bytes(n) }

@prelude
pub fun String.trim(): String { return self.as_str().trim() }
@prelude
pub fun String.trim_start(): String { return self.as_str().trim_start() }
@prelude
pub fun String.trim_end(): String { return self.as_str().trim_end() }

@prelude
pub fun String.to_upper(): String { return self.as_str().to_upper() }
@prelude
pub fun String.to_lower(): String { return self.as_str().to_lower() }
pub fun String.repeat(n: uint64): String { return self.as_str().repeat(n) }
pub fun String.replace(from: str, to: str): String { return self.as_str().replace(from, to) }
