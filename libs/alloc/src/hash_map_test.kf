// The index bookkeeping: a mistake shows up as a lost entry, not a crash.

import core.assert.assert_eq
import core.assert.assert
import core.hash.assert_eq
import core.hash.assert
import alloc.list.*
import alloc.hash_map.*

@test
fun a_new_map_is_empty(): void {
    val m = HashMap.new<int32, int32>()
    assert_eq(m.size(), 0, "size")
    assert_eq(m.is_empty(), true, "is_empty")
}

@test
fun a_value_comes_back_out(): void {
    var m = HashMap.new<int32, int32>()
    m.insert(7, 42)
    when (m.get(&7)) {
        // `assert`, not `assert_eq`: `v` is a `&int32`, and a generic cannot
        // be instantiated at a borrow yet.
        Some(v) => assert(v == 42, "value")
        None => assert_eq(true, false, "the key was inserted")
    }
}

@test
fun a_missing_key_is_none(): void {
    var m = HashMap.new<int32, int32>()
    m.insert(7, 42)
    assert_eq(m.contains(&8), false, "absent key")
    when (m.get(&8)) {
        Some(_) => assert_eq(true, false, "absent key answered Some")
        None => { }
    }
}

@test
fun inserting_the_same_key_replaces_rather_than_grows(): void {
    var m = HashMap.new<int32, int32>()
    m.insert(1, 10)
    m.insert(1, 20)
    assert_eq(m.size(), 1, "size after replace")
    when (m.get(&1)) {
        Some(v) => assert(v == 20, "replaced value")
        None => assert_eq(true, false, "key vanished")
    }
}

// Past the 3/4 load factor, every key survives the rehash.
@test
fun every_key_survives_several_rehashes(): void {
    var m = HashMap.new<int32, int32>()
    var i: int32 = 0
    while i < 100 {
        m.insert(i, i * 3)
        i = i + 1
    }
    assert_eq(m.size(), 100, "size after growth")
    i = 0
    while i < 100 {
        when (m.get(&i)) {
            Some(v) => assert(v == i * 3, "value survived rehash")
            None => assert_eq(true, false, "key lost in rehash")
        }
        i = i + 1
    }
}

@test
fun removing_reports_whether_there_was_an_entry(): void {
    var m = HashMap.new<int32, int32>()
    m.insert(1, 10)
    assert_eq(m.remove(&1), true, "removing a present key")
    assert_eq(m.remove(&1), false, "removing it twice")
    assert_eq(m.size(), 0, "size after remove")
}

// A wrong swap_remove fix-up loses some other key, not the removed one.
@test
fun removing_one_key_does_not_lose_the_others(): void {
    var m = HashMap.new<int32, int32>()
    var i: int32 = 0
    while i < 50 {
        m.insert(i, i)
        i = i + 1
    }
    i = 0
    while i < 50 {
        m.remove(&i)
        i = i + 2
    }
    assert_eq(m.size(), 25, "half remain")
    i = 1
    while i < 50 {
        assert_eq(m.contains(&i), true, "an odd key survived")
        i = i + 2
    }
    i = 0
    while i < 50 {
        assert_eq(m.contains(&i), false, "an even key is gone")
        i = i + 2
    }
}

@test
fun owning_keys_and_values_work(): void {
    var m = HashMap.new<String, String>()
    val k = String.from("alpha")
    m.insert(k.clone(), String.from("one"))
    m.insert(k.clone(), String.from("uno"))
    assert_eq(m.size(), 1, "replaced, not appended")
    when (m.get(&k)) {
        Some(v) => assert_eq(v.as_str(), "uno", "owning value")
        None => assert_eq(true, false, "owning key vanished")
    }
    assert_eq(m.remove(&k), true, "removing an owning key")
}

@test
fun a_string_key_agrees_with_its_str_spelling(): void {
    val owned = String.from("beta")
    assert_eq(owned.hash() == "beta".hash(), true, "String and str hash alike")
}

@test
fun keys_walks_every_key(): void {
    var m = HashMap.new<int32, int32>()
    m.insert(1, 10)
    m.insert(2, 20)
    m.insert(3, 30)
    var sum = 0
    while k in m.keys() { sum = sum + k }
    assert_eq(sum, 6, "every key visited once")
}

@test
fun values_walks_every_value(): void {
    var m = HashMap.new<int32, int32>()
    m.insert(1, 10)
    m.insert(2, 20)
    m.insert(3, 30)
    var sum = 0
    while v in m.values() { sum = sum + v }
    assert_eq(sum, 60, "every value visited once")
}

// The pairwise sum holds only when index i's key lines up with its value.
@test
fun entries_pairs_each_key_with_its_own_value(): void {
    var m = HashMap.new<int32, int32>()
    m.insert(1, 10)
    m.insert(2, 20)
    m.insert(3, 30)
    var sum = 0
    while e in m.entries() { sum = sum + e.key + e.value }
    assert_eq(sum, 66, "every key and its own value")
}

@test
fun a_map_is_iterable_over_its_entries(): void {
    var m = HashMap.new<int32, int32>()
    m.insert(1, 10)
    m.insert(2, 20)
    var sum = 0
    while e in m { sum = sum + e.key + e.value }
    assert_eq(sum, 33, "bare iteration walks entries")
}
