// The runtime's String-returning entry points, declared beside `String` so
// their prototypes land in `alloc.h` with the complete type; nothing imports
// this module.

/// Called by every crate that writes a string literal.
pub extern "C" fun __kf_v2_str_from_cstr(s: str): String
pub extern "C" fun __kf_v2_str_concat(a: String, b: String): String
pub extern "C" fun __kf_v2_string_drop(s: String): void
pub extern "C" fun __kf_v2_int32_to_str(v: int32): String
pub extern "C" fun int64_display(v: int64): String
pub extern "C" fun uint64_display(v: uint64): String
pub extern "C" fun kf_str_slice_to_string(s: str, start: uint64, end: uint64): String
