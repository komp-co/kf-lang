import core.assert.assert_eq
import alloc.path.*
import testing.test

@test
fun path_join_adds_separator(): void {
    val p = Path.new("target").join("komp.c")
    assert_eq(p.as_str(), "target/komp.c", "join separates path components")
}

@test
fun path_file_name_returns_last_component(): void {
    val p = Path.new("target/komp.c")
    assert_eq(p.file_name(), "komp.c", "file_name returns final component")
}

@test
fun path_parent_returns_containing_directory(): void {
    val path = Path.new("/tmp/project/kf.toml")
    assert_eq(path.parent().as_str(), "/tmp/project", "parent path")
}

@test
fun relative_file_parent_is_current_directory(): void {
    val path = Path.new("kf.toml")
    assert_eq(path.parent().as_str(), ".", "relative parent")
}

@test
fun a_path_from_the_root_is_absolute(): void {
    assert_eq(Path.new("/tmp").is_absolute(), true, "a leading `/`")
}

@test
fun a_relative_path_is_not_absolute(): void {
    assert_eq(Path.new("tmp/x").is_absolute(), false, "no leading `/`")
}

@test
fun joining_an_absolute_part_gives_that_part(): void {
    assert_eq(Path.new("/work").join("/etc/kf.toml").as_str(), "/etc/kf.toml", "the part names its own path")
}

@test
fun normalizing_collapses_dots_and_parents(): void {
    assert_eq(Path.new("/a/./b/../c//d").normalized().as_str(), "/a/c/d", "`.`, `b/..` and `//` collapse")
}

@test
fun normalizing_stops_at_the_root(): void {
    assert_eq(Path.new("/a/../../b").normalized().as_str(), "/b", "nothing is above `/`")
}

@test
fun normalizing_keeps_a_relative_paths_leading_parents(): void {
    assert_eq(Path.new("../a/../../b").normalized().as_str(), "../../b", "they name directories above the start")
}

@test
fun normalizing_the_current_directory_gives_a_dot(): void {
    assert_eq(Path.new("a/..").normalized().as_str(), ".", "not the empty path")
}

@test
fun normalizing_the_root_gives_the_root(): void {
    assert_eq(Path.new("/a/..").normalized().as_str(), "/", "the root stays")
}

@test
fun a_path_starts_with_its_ancestor(): void {
    assert_eq(Path.new("/a/lib/src/x.kf").starts_with(&Path.new("/a/lib")), true, "a parent directory")
}

@test
fun a_path_starts_with_itself(): void {
    assert_eq(Path.new("/a/lib").starts_with(&Path.new("/a/lib")), true, "the same path")
}

@test
fun a_shared_spelling_is_not_an_ancestor(): void {
    assert_eq(Path.new("/a/library").starts_with(&Path.new("/a/lib")), false, "only at a separator")
}

@test
fun every_absolute_path_starts_with_the_root(): void {
    assert_eq(Path.new("/a").starts_with(&Path.new("/")), true, "the root is everyone's ancestor")
}
