import core.assert.assert_eq

@test fun a_list_from_an_array_holds_its_elements_in_order(): void {
    val items: int32[3] = [4, 5, 6]
    val xs = List.from(items)
    assert_eq(*xs.at(2), 6, "the last element")
}

@test fun a_list_from_an_array_reserves_exactly_its_length(): void {
    val items: int32[3] = [4, 5, 6]
    val xs = List.from(items)
    assert_eq(xs.cap, 3 as uint64, "one allocation of N")
}

@test fun a_list_from_an_empty_array_allocates_nothing(): void {
    val items: int32[0] = []
    val xs = List.from(items)
    assert_eq(xs.cap, 0 as uint64, "no allocation")
}
