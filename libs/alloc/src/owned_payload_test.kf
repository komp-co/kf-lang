// `Option` and `Result` over a `String` payload.

import core.assert.*
import testing.test

// The predicates borrow, so the payload stays usable.
@test
fun option_predicate_does_not_consume_a_move_only_payload(): void {
    val s: String? = Option.Some(String.from("hello"))
    assert_eq(s.is_some(), true, "String payload is_some")
    assert_eq(s.is_some(), true, "receiver still readable after the first call")
}

// A move-only payload read through a borrow is copied; both copies are freed
// once.
@test
fun option_unwrap_yields_an_owned_move_only_payload(): void {
    val s: String? = Option.Some(String.from("hello"))
    val out = s.unwrap()
    assert_eq(out.as_str(), "hello", "the String survives the unwrap intact")
    assert_eq(s.is_some(), true, "the option still holds its own copy")
    assert_eq(s.unwrap().as_str(), "hello", "so unwrapping again still works")
}

fun owned_attempt_string(n: int32): Result<String, int32> {
    if n < 0 { return Result.Err(n) }
    return Result.Ok(String.from("hello"))
}

@test
fun result_unwrap_yields_an_owned_move_only_payload(): void {
    val out = owned_attempt_string(1).unwrap()
    assert_eq(out.as_str(), "hello", "the String survives the unwrap intact")
}
