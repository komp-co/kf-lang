// Clock properties rather than values: this century, monotonic, and a sleep
// sleeps.

import core.assert.assert_eq
import core.time.*
import testing.test

@test fun the_wall_clock_is_plausible(): void {
    val seconds = Clock.unix_seconds()
    // 2020-01-01 to 2100-01-01: catches a clock answering 0 or nanoseconds.
    assert_eq(seconds > 1577836800, true, "after 2020")
    assert_eq(seconds < 4102444800, true, "before 2100")
    assert_eq(Clock.now().date.year >= 2020, true, "and the date agrees")
}

@test fun nanos_and_seconds_agree(): void {
    val nanos = Clock.unix_nanos()
    val seconds = Clock.unix_seconds()
    // A moment apart, so at most a second.
    val from_nanos = nanos / 1000000000
    assert_eq(from_nanos - seconds <= 1 && seconds - from_nanos <= 1, true, "same instant")
}

@test fun the_monotonic_clock_never_goes_backwards(): void {
    val first = Instant.now()
    val second = Instant.now()
    assert_eq(second.since(first).as_nanos() >= 0, true, "not backwards")
    assert_eq(first.elapsed().is_negative(), false, "elapsed is never negative")
}

@test fun sleeping_takes_at_least_as_long_as_asked(): void {
    val start = Instant.now()
    Clock.sleep(Duration.from_millis(20))
    val took = start.elapsed()
    assert_eq(took.as_millis() >= 18, true, "slept about long enough")
    // Only that sleep returns, not that it is precise.
    assert_eq(took.as_seconds() < 5, true, "and returned")
}

@test fun sleeping_for_nothing_returns_at_once(): void {
    val start = Instant.now()
    Clock.sleep(Duration.zero())
    Clock.sleep(Duration.from_millis(-5))
    assert_eq(start.elapsed().as_seconds() < 2, true, "no wait for a non-positive duration")
}
