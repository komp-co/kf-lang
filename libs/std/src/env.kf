extern "C" fun kf_env_is_set(name: str): bool
extern "C" fun kf_env_get(name: str): str
extern "C" fun kf_env_set(name: str, value: str): void

/// The environment variables of this process.
pub struct Env { }

impl Env {
    /// The variable's value, or null when it is not set; set and empty is
    /// `""`.
    pub static fun get(name: str): String? {
        if !kf_env_is_set(name) { return null }
        return String.from(kf_env_get(name))
    }

    /// Sets the variable for this process and every process it starts
    /// afterwards.
    pub static fun set(name: str, value: str): void {
        kf_env_set(name, value)
    }
}
