// Reading the clocks; calendar and span types are in core. `Clock` is the
// wall clock; `Instant` reads the monotonic one, which only moves forward:
// measure with it.

import core.time.*

extern "C" fun kf_time_unix_seconds(): int64
extern "C" fun kf_time_unix_nanos(): int64
extern "C" fun kf_time_monotonic_nanos(): int64
extern "C" fun kf_time_sleep_nanos(nanos: int64): void

/// The wall clock, which can jump when it is corrected.
pub struct Clock { }

impl Clock {
    /// The current UTC date and time.
    pub static fun now(): DateTime { return DateTime.from_unix(kf_time_unix_seconds()) }

    /// Seconds since the Unix epoch, UTC.
    pub static fun unix_seconds(): int64 { return kf_time_unix_seconds() }

    /// Nanoseconds since the Unix epoch, UTC.
    pub static fun unix_nanos(): int64 { return kf_time_unix_nanos() }

    /// Blocks for at least `d`. A negative or zero duration returns at once.
    pub static fun sleep(d: Duration): void { kf_time_sleep_nanos(d.as_nanos()) }
}

/// A point on the monotonic clock. Only differences mean anything; it cannot
/// become a DateTime.
pub struct Instant {
    pub val nanos: int64
}

impl Instant {
    pub static fun now(): Instant {
        return Instant { nanos: kf_time_monotonic_nanos() }
    }

    /// Never negative.
    pub fun elapsed(): Duration {
        return Duration.from_nanos(kf_time_monotonic_nanos() - self.nanos)
    }

    /// The span from `earlier` to this.
    pub fun since(earlier: Instant): Duration {
        return Duration.from_nanos(self.nanos - earlier.nanos)
    }
}
