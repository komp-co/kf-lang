// Reading the clock; calendar and span types are in core.
//
// `now()` reads the wall clock, which can jump when corrected. `Instant`
// reads the monotonic clock, which only moves forward: measure with it.

import core.time.*

extern "C" fun kf_time_unix_seconds(): int64
extern "C" fun kf_time_unix_nanos(): int64
extern "C" fun kf_time_monotonic_nanos(): int64
extern "C" fun kf_time_sleep_nanos(nanos: int64): void

/// Seconds since the Unix epoch, UTC.
pub fun unix_seconds(): int64 { return unsafe { kf_time_unix_seconds() } }

/// Nanoseconds since the Unix epoch, UTC.
pub fun unix_nanos(): int64 { return unsafe { kf_time_unix_nanos() } }

/// The current UTC date and time.
pub fun now(): DateTime { return DateTime.from_unix(unsafe { kf_time_unix_seconds() }) }

/// Block for at least `d`. A negative or zero duration returns immediately.
pub fun sleep(d: Duration): void { unsafe { kf_time_sleep_nanos(d.as_nanos()) } }

/// A point on the monotonic clock. Only differences mean anything; it cannot
/// become a DateTime.
pub struct Instant {
    pub val nanos: int64
}

impl Instant {
    pub static fun now(): Instant {
        return Instant { nanos: unsafe { kf_time_monotonic_nanos() } }
    }

    /// Never negative.
    pub fun elapsed(): Duration {
        return Duration.from_nanos(unsafe { kf_time_monotonic_nanos() } - self.nanos)
    }

    /// The span from `earlier` to this.
    pub fun since(earlier: Instant): Duration {
        return Duration.from_nanos(self.nanos - earlier.nanos)
    }
}
